---
import type { HTMLAttributes } from 'astro/types';
/**
 * FloatingPreviewCard: frame for a small floating product-UI preview laid over photography
 * (a booking summary, a lesson slot, a schedule). It shows no status badge or tag unless one is put in the `badge`
 * slot (owner direction 2026-11-19: no Sample, Proposal or planned tags on public sections).
 * The title is a plain label, not a heading, so previews do not enter the page outline.
 *
 * Usage:
 *   <FloatingPreviewCard title="Next lesson" class="absolute end-6 bottom-6 w-72">
 *     <p class="text-small">Piano · Thursday 4:30 pm</p>
 *   </FloatingPreviewCard>
 *
 * Slots: title (overrides `title`), badge (empty by default), default (preview body).
 */
interface Props extends Omit<HTMLAttributes<'div'>, 'class' | 'title'> {
  title?: string;
  /** light (default) uses the raised surface; dark switches to dark colour roles. */
  tone?: 'light' | 'dark';
  as?: 'div' | 'aside' | 'figure';
  class?: string;
}
const { title, tone = 'light', as: Tag = 'div', class: className, ...rest } = Astro.props;
const hasTitle = Boolean(title) || Astro.slots.has('title');
---

<Tag
  {...rest}
  class:list={[
    'flex min-w-0 flex-col gap-4 rounded-card border border-border bg-surface-raised p-5 text-fg shadow-raised',
    className,
  ]}
  data-tone={tone}
  data-surface={tone === 'dark' ? 'dark' : undefined}
>
  <div class="flex min-w-0 items-center justify-between gap-3">
    {hasTitle && (
      <p class="min-w-0 text-small font-semibold">
        <slot name="title">{title}</slot>
      </p>
    )}
    {Astro.slots.has('badge') && (
      <div class="ms-auto flex shrink-0 gap-2">
        <slot name="badge" />
      </div>
    )}
  </div>
  <slot />
</Tag>
