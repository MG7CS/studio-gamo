---
import type { HTMLAttributes } from 'astro/types';
/**
 * SplitHero: copy and media side by side once the hero's container is ≥ 48rem; stacked in narrower containers
 * (phone and iPad) with the media first, then the heading, text and buttons. The copy slot is free-form: on a landing page put the page's
 * single <h1> in it; when used lower on a page use an <h2>.
 *
 * Usage:
 *   <SplitHero mediaSide="start" tone="dark">
 *     <h1 class="display-xl">Learn to Play the Instrument You Love</h1>
 *     <p>Lessons for students and families.</p>
 *     <ButtonLink href="/enroll">Enroll</ButtonLink>
 *     <Frame slot="media" photo="boyGuitar" ratio="portrait" sizes="half" alt="Smiling boy learning guitar" priority />
 *   </SplitHero>
 *
 * mediaWidth="wide" gives the media seven twelfths instead of half, for a PhotoGrid mosaic that needs
 * a wide column (the trio/quad mosaics start at 40rem/48rem of the grid's own width).
 *
 * Slots: default (copy), media.
 */
import Container from '../layout/Container.astro';
import { titleCaseHeadingsIn } from '../../lib/title-case';

type Tone = 'default' | 'raised' | 'inset' | 'dark';
type Spacing = 'hero' | 'section' | 'none';
interface Props extends Omit<HTMLAttributes<'section'>, 'class'> {
  /** Which side the media takes in wide containers. Default end. */
  mediaSide?: 'start' | 'end';
  /** default keeps the parent surface; raised lifts it; inset and dark switch colour roles. */
  tone?: Tone;
  width?: 'page' | 'narrow';
  /** hero clears the site header (page-intro rhythm), section uses the section rhythm. */
  spacing?: Spacing;
  /** half (default) or wide: the media takes 7/12 of the width and the copy 5/12. */
  mediaWidth?: 'half' | 'wide';
  as?: 'header' | 'section' | 'div';
  class?: string;
}
const {
  mediaSide = 'end',
  tone = 'default',
  width = 'page',
  spacing = 'hero',
  mediaWidth = 'half',
  as: Tag = 'header',
  class: className,
  ...rest
} = Astro.props;
// The copy slot is free-form: headings typed in it are title-cased here, so a page never wraps them.
const copyHtml = titleCaseHeadingsIn(await Astro.slots.render('default'));
const spacingClass: Record<Spacing, string> = {
  hero: 'page-intro-space',
  section: 'section-space',
  none: '',
};
---

<Tag
  {...rest}
  class:list={[
    'text-fg',
    tone === 'raised' ? 'bg-surface-raised' : tone !== 'default' && 'bg-surface',
    spacingClass[spacing],
    className,
  ]}
  data-band
  data-tone={tone}
  data-media-side={mediaSide}
  data-surface={tone === 'default' || tone === 'raised' ? undefined : tone}
>
  <Container width={width} class="@container">
    <div
      class="split-hero__grid grid gap-10 @3xl:items-center @3xl:gap-16"
      data-media-width={mediaWidth}
      data-media-side={mediaSide}
    >
      <div class="flex min-w-0 flex-col items-start gap-5">
        <Fragment set:html={copyHtml} />
      </div>
      {Astro.slots.has('media') && (
        <div class:list={['min-w-0 order-first', mediaSide === 'end' && '@3xl:order-last']}>
          <slot name="media" />
        </div>
      )}
    </div>
  </Container>
</Tag>

<style>
  @container (min-width: 48rem) {
    .split-hero__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .split-hero__grid[data-media-width='wide'] {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .split-hero__grid[data-media-width='wide'][data-media-side='start'] {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
