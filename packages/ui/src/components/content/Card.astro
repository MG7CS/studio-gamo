---
import type { HTMLAttributes } from 'astro/types';
/**
 * Card: rounded surface for grouped content. Content-agnostic; put headings, text and actions in
 * the default slot. For a card that is one link use LinkCard; for a photo card use MediaCard.
 *
 * Usage:
 *   <Card tone="raised" padding="lg" as="article"><h3>…</h3><p>…</p></Card>
 *   <FeatureGrid as="ul">{items.map((i) => <Card as="li">…</Card>)}</FeatureGrid>
 *
 * A `Frame` inside a padded Card gets the nested radius automatically: the card sets `--frame-radius`
 * to its own radius minus its padding (never below 0), so inner and outer corners stay concentric.
 */
import { cardPaddingClass, cardSurface, cardToneClass, type CardPadding, type CardTone } from './card-tone';

interface Props extends Omit<HTMLAttributes<'div'>, 'class' | 'title'> {
  /** raised (default), inset (sand well), dark (ink), outline (hairline only). */
  tone?: CardTone;
  /** none, sm, md (default), lg. */
  padding?: CardPadding;
  as?: 'div' | 'article' | 'li' | 'section' | 'aside';
  class?: string;
}
const { tone = 'raised', padding = 'md', as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag
  {...rest}
  class:list={[
    'relative flex min-w-0 flex-col rounded-card',
    cardToneClass[tone],
    cardPaddingClass[padding],
    className,
  ]}
  data-tone={tone}
  data-padding={padding}
  data-surface={cardSurface(tone)}
>
  <slot />
</Tag>

<style>
  /* Nested radius = outer radius − padding (clamped at 0), read by Frame. */
  [data-padding='sm'] {
    --frame-radius: max(0rem, calc(var(--radius-card) - 1.25rem));
  }
  [data-padding='md'] {
    --frame-radius: max(0rem, calc(var(--radius-card) - 1.5rem));
  }
  [data-padding='lg'] {
    --frame-radius: max(0rem, calc(var(--radius-card) - 2rem));
  }
</style>
