---
/**
 * Card: rounded surface for grouped content. Content-agnostic; put headings, text and actions in
 * the default slot. For a card that is one link use LinkCard; for a photo card use MediaCard.
 *
 * Usage:
 *   <Card tone="raised" padding="lg" as="article"><h3>…</h3><p>…</p></Card>
 *   <FeatureGrid as="ul">{items.map((i) => <Card as="li">…</Card>)}</FeatureGrid>
 */
import { cardPaddingClass, cardSurface, cardToneClass, type CardPadding, type CardTone } from './card-tone';

interface Props {
  /** raised (default), inset (sand well), dark (ink), outline (hairline only). */
  tone?: CardTone;
  /** none, sm, md (default), lg. */
  padding?: CardPadding;
  as?: 'div' | 'article' | 'li' | 'section' | 'aside';
  class?: string;
}
const { tone = 'raised', padding = 'md', as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  class:list={[
    'relative flex min-w-0 flex-col rounded-card',
    cardToneClass[tone],
    cardPaddingClass[padding],
    className,
  ]}
  data-tone={tone}
  data-padding={padding}
  data-surface={cardSurface(tone)}
>
  <slot />
</Tag>
