---
/**
 * List of the legal documents with title, one-line summary and version. Props:
 * - documents: { title, summary, href, version }[] (from the terms registry).
 */
interface LegalIndexItem {
  title: string;
  summary: string;
  href: string;
  version: string;
}
interface Props {
  documents: readonly LegalIndexItem[];
}
const { documents } = Astro.props;
---

<ul class="mt-10 grid gap-4 md:grid-cols-2" data-legal-index>
  {documents.map((doc) => (
    <li class="rounded-2xl border border-sand bg-white p-6">
      <h2 class="text-lg font-semibold text-ink">
        <a
          href={doc.href}
          class="inline-flex min-h-11 items-center text-ink underline-offset-4 hover:text-terracotta hover:underline"
        >
          {doc.title}
        </a>
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">{doc.summary}</p>
      <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-terracotta-deep">
        Draft · <span class="break-all normal-case">{doc.version}</span>
      </p>
    </li>
  ))}
</ul>
