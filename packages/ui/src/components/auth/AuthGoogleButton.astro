---
/**
 * "Continue with Google" — rendered only when this product's own Clerk application is configured AND
 * `CLERK_GOOGLE_ENABLED_<APP>=true` (decided by GamoAuthExperience). A button, not a link: the auth client
 * starts Clerk's `authenticateWithRedirect`, and the redirect ends on this product's `/account/sso-callback`.
 */
interface Props {
  mode: 'signin' | 'signup';
}
const { mode } = Astro.props;
---

<div class="space-y-4 pt-3" data-social-auth>
  <div class="relative flex items-center py-1" aria-hidden="true">
    <div class="flex-grow border-t border-sand"></div>
    <span class="mx-3 shrink text-[13px] text-muted">or</span>
    <div class="flex-grow border-t border-sand"></div>
  </div>
  <button
    type="button"
    data-google-auth
    class="inline-flex min-h-11 w-full items-center justify-center gap-2.5 rounded-full border border-ink/40 bg-white px-4 py-2.5 text-[14px] font-semibold text-ink transition-colors hover:bg-cream focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2 disabled:opacity-60"
  >
    {mode === 'signup' ? 'Sign up with Google' : 'Continue with Google'}
  </button>
</div>
