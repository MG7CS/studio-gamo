---
interface Props {
  label: string;
  accent?: 'terracotta' | 'lavender' | 'soft-lavender';
  type?: 'submit' | 'button';
  dataBtnChallenge?: boolean;
  dataBtnVerify?: boolean;
}

const {
  label,
  accent = 'terracotta',
  type = 'submit',
  dataBtnChallenge = false,
  dataBtnVerify = false,
} = Astro.props;

const accentClasses =
  accent === 'lavender'
    ? 'bg-gradient-to-r from-terracotta to-terracotta hover:from-terracotta hover:to-terracotta-deep focus-visible:ring-terracotta'
    : accent === 'soft-lavender'
      ? 'bg-gradient-to-r from-terracotta to-terracotta hover:from-terracotta hover:to-terracotta data-[ready=true]:from-terracotta data-[ready=true]:to-terracotta focus-visible:ring-terracotta'
      : 'bg-gradient-to-r from-terracotta to-terracotta-deep hover:from-terracotta-deep hover:to-terracotta-deep focus-visible:ring-terracotta';
---

<button
  type={type}
  data-btn-challenge={dataBtnChallenge ? '' : undefined}
  data-btn-verify={dataBtnVerify ? '' : undefined}
  class:list={[
    'group relative mt-1 flex w-full items-center justify-center gap-2 rounded-full px-6 py-3.5 text-[15px] font-medium text-white shadow-[0_10px_24px_-8px_rgba(29,25,23,0.32)] transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:opacity-60',
    accentClasses,
  ]}
>
  <span>{label}</span>
  <span class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
    →
  </span>
</button>
