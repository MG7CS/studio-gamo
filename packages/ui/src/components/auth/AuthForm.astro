---
/**
 * The two steps of every shared auth screen: request a code (sign in / sign up / recover) and enter it.
 *
 * Sign-up also asks for the provider role (chips), the required Site Terms + Privacy consent and the
 * separate, never pre-ticked marketing checkbox. The Cloudflare Turnstile widget sits below both steps
 * (tokens are single-use; resend needs a fresh one). Sign-in never creates an account: the code step
 * always offers "No account yet? Create one" so it reads the same for every address.
 */
import AuthNavBar from './AuthNavBar.astro';
import AuthFormHeader from './AuthFormHeader.astro';
import AuthFeedback from './AuthFeedback.astro';
import AuthTextField from './AuthTextField.astro';
import AuthEmailInput from './AuthEmailInput.astro';
import AuthCodeInput from './AuthCodeInput.astro';
import AuthActions from './AuthActions.astro';
import AuthRoleChips, { type AuthRoleOption } from './AuthRoleChips.astro';
import AuthGoogleButton from './AuthGoogleButton.astro';
import TermsConsent from '../forms/TermsConsent.astro';
import MarketingConsent from '../forms/MarketingConsent.astro';
import TurnstileWidget from '../forms/TurnstileWidget.astro';
import { getAuthScreenCopy, type AuthScreenMode } from '../../lib/auth-flow-client';
import type { TermsConsentDocument } from '../../lib/terms-links';

interface Props {
  mode?: AuthScreenMode;
  program?: string;
  product?: string;
  heading?: string;
  subtext?: string;
  signupRoles?: AuthRoleOption[];
  selectedRole?: string | null;
  termsDocuments?: TermsConsentDocument[];
  googleEnabled?: boolean;
  /** True when Clerk handles the code step (its own bot protection replaces Turnstile). */
  clerkActive?: boolean;
}

const {
  mode = 'signin',
  program = 'Gamo Studios',
  product = 'web',
  heading,
  subtext,
  signupRoles = [],
  selectedRole,
  termsDocuments = [],
  googleEnabled = false,
  clerkActive = false,
} = Astro.props;

const copy = getAuthScreenCopy(program)[mode];
const effectiveHeading = heading || copy.heading;
const effectiveSubtext = subtext || copy.subtext;
const accent = mode === 'signin' ? 'terracotta' : 'lavender';
const primaryActionLabel = mode === 'signup' ? `Create ${program} account` : 'Email me a code';
const showGoogle = googleEnabled && (mode === 'signin' || mode === 'signup');
const marketingProduct = (
  ['web', 'worship', 'academy', 'live', 'production'].includes(product) ? product : 'web'
) as 'web' | 'worship' | 'academy' | 'live' | 'production';
---

<AuthNavBar mode={mode} />

<div class="relative z-10 my-auto w-full max-w-[432px] mx-auto pt-1 pb-4 lg:py-6">
  <AuthFormHeader mode={mode} heading={effectiveHeading} subtext={effectiveSubtext} />

  <AuthFeedback />

  {/* Request a code (sign in / create account / recovery) */}
  <form class="space-y-4" data-step-challenge hidden={mode === 'verify'} novalidate={false}>
    {mode === 'signup' && (
      <div class="grid grid-cols-1 min-[340px]:grid-cols-2 gap-3 sm:gap-3.5">
        <AuthTextField
          id="auth-first-name"
          name="firstName"
          label="First name"
          autocomplete="given-name"
          required
          placeholder="e.g. Grace"
        />
        <AuthTextField
          id="auth-last-name"
          name="lastName"
          label="Last name"
          autocomplete="family-name"
          required
          placeholder="e.g. Mensah"
        />
      </div>
    )}

    <AuthEmailInput
      id="auth-email-input"
      name="email"
      label="Email address"
      required
      placeholder="you@example.org"
      icon="mail"
      accent={accent}
    />

    {mode === 'signup' && <AuthRoleChips roles={signupRoles} selected={selectedRole} program={program} />}

    {mode === 'signup' && termsDocuments.length > 0 && (
      <TermsConsent documents={termsDocuments} id="auth-terms-accept" newTab />
    )}
    {mode === 'signup' && <MarketingConsent product={marketingProduct} id="auth-marketing" />}

    {/* Mount point for Clerk's bot-protection widget (Cloudflare Turnstile run by Clerk). Empty when Clerk is off. */}
    {mode === 'signup' && <div id="clerk-captcha" class="empty:hidden" />}

    <AuthActions
      mode={mode}
      program={program}
      primaryLabel={primaryActionLabel}
      accent={accent}
      dataBtnChallenge
    />
    {showGoogle && <AuthGoogleButton mode={mode === 'signup' ? 'signup' : 'signin'} />}
  </form>

  {/* Enter the code (step 2 and direct /account/verify) */}
  <form class="space-y-5 lg:space-y-6" data-step-verify hidden={mode !== 'verify'}>
    <div data-verify-direct-email class="hidden">
      <AuthEmailInput
        id="auth-verify-email-input"
        name="verifyEmail"
        label="Email address"
        required={false}
        placeholder="you@example.org"
        icon="none"
        accent="lavender"
        dataVerifyEmailInput
      />
    </div>

    <AuthCodeInput />

    <p class="text-[14px] text-muted">
      No code after a few minutes? Check your spam folder, or{' '}
      <button
        type="button"
        data-btn-resend
        class="inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline decoration-terracotta/40 underline-offset-4 transition-colors hover:text-ink disabled:opacity-50"
      >
        resend the code
      </button>
      .
    </p>
    {mode !== 'signup' && (
      <p class="text-[14px] text-muted">
        No {program} account yet?{' '}
        <a
          href="/account/signup"
          data-nav-signup
          class="inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline decoration-terracotta/40 underline-offset-4"
        >
          Create one
        </a>
        — we only email codes to addresses that already have an account.
      </p>
    )}

    <AuthActions mode="verify" primaryLabel="Verify and continue" accent="soft-lavender" dataBtnVerify />
  </form>

  {!clerkActive && mode !== 'verify' && (
    <div class="mt-5">
      <TurnstileWidget action="auth" id="auth-turnstile" />
    </div>
  )}
</div>

<div class="relative z-10 h-2" aria-hidden="true"></div>
