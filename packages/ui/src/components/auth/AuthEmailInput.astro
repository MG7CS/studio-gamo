---
import AuthTextField from './AuthTextField.astro';

interface Props {
  id?: string;
  name?: string;
  label?: string;
  placeholder?: string;
  required?: boolean;
  accent?: 'terracotta' | 'lavender';
  icon?: 'mail' | 'none';
  dataVerifyEmailInput?: boolean;
}

const {
  id = 'auth-email-input',
  name = 'email',
  label = 'Email address',
  placeholder = 'you@example.com',
  required = true,
  accent = 'terracotta',
  icon = 'mail',
  dataVerifyEmailInput = false,
} = Astro.props;
---

<AuthTextField
  id={id}
  name={name}
  type="email"
  label={label}
  autocomplete="email"
  required={required}
  placeholder={placeholder}
  icon={icon}
  accent={accent}
  dataVerifyEmailInput={dataVerifyEmailInput}
/>
