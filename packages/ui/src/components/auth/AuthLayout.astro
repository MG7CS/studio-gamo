---
import AuthPhotoPanel, { type AuthPhotoItem } from './AuthPhotoPanel.astro';
import AuthCurvedDivider from './AuthCurvedDivider.astro';
import type { AuthScreenMode } from '../../lib/auth-flow-client';

interface Props {
  mode: AuthScreenMode;
  program?: string;
  brandHref?: string;
  brandLabel?: string;
  photos?: AuthPhotoItem[];
  panelBgClass?: string;
  clerkPublishableKey?: string;
  clerkAppId?: string;
}

const {
  mode,
  program = 'Gamo Studios',
  brandHref = '/',
  brandLabel = `${program} home`,
  photos,
  panelBgClass,
  clerkPublishableKey,
  clerkAppId,
} = Astro.props;
---

<section
  class="relative min-h-screen w-full bg-ivory text-ink flex flex-col lg:flex-row overflow-hidden selection:bg-terracotta/15"
  data-verified-auth
  data-auth-mode={mode}
  data-active-mode={mode}
  data-auth-program={program}
  data-clerk-publishable-key={clerkPublishableKey || undefined}
  data-clerk-app-id={clerkAppId || undefined}
>
  <AuthPhotoPanel
    activeMode={mode}
    program={program}
    brandHref={brandHref}
    brandLabel={brandLabel}
    photos={photos}
  />
  <AuthCurvedDivider panelBgClass={panelBgClass}>
    <slot />
  </AuthCurvedDivider>
</section>
