---
import AuthPrimaryButton from './AuthPrimaryButton.astro';
import type { AuthScreenMode } from '../../lib/auth-flow-client';

interface Props {
  mode: AuthScreenMode;
  program?: string;
  primaryLabel: string;
  accent?: 'terracotta' | 'lavender' | 'soft-lavender';
  dataBtnChallenge?: boolean;
  dataBtnVerify?: boolean;
}

const {
  mode,
  program = 'Gamo Studios',
  primaryLabel,
  accent = 'terracotta',
  dataBtnChallenge = false,
  dataBtnVerify = false,
} = Astro.props;
const linkClass =
  'inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline decoration-terracotta/40 underline-offset-4 transition-colors hover:text-ink';
---

<div class="pt-1">
  <AuthPrimaryButton
    label={primaryLabel}
    accent={accent}
    dataBtnChallenge={dataBtnChallenge}
    dataBtnVerify={dataBtnVerify}
  />
</div>

{mode === 'signin' && (
  <div class="pt-3 text-center space-y-1">
    <p class="text-[14px] text-muted">
      New to {program}?{' '}
      <a href="/account/signup" data-nav-signup class={linkClass}>
        Create an account
      </a>
    </p>
    <p class="text-[14px] text-muted">
      Can't get into your account?{' '}
      <a href="/account/recover" data-nav-recover class={linkClass}>
        Get help signing in
      </a>
    </p>
  </div>
)}

{mode === 'signup' && (
  <div class="pt-3 text-center">
    <p class="text-[14px] text-muted">
      Already have a {program} account?{' '}
      <a href="/account/signin" data-nav-signin class={linkClass}>
        Sign in
      </a>
    </p>
  </div>
)}

{(mode === 'recover' || mode === 'verify') && (
  <div class="pt-2">
    <a href="/account/signin" data-nav-signin class={linkClass}>
      <span aria-hidden="true">←&nbsp;</span>
      <span>Back to sign in</span>
    </a>
  </div>
)}
