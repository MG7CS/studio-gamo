---
interface Props {
  panelBgClass?: string;
}

const { panelBgClass = 'bg-[#FCFBF9]' } = Astro.props;
---

<div
  class:list={[
    'relative z-10 flex flex-1 flex-col justify-between px-6 pb-9 pt-2 sm:px-12 sm:pb-12 sm:pt-4 lg:mt-0 lg:min-h-screen lg:-ml-[140px] xl:-ml-[160px] lg:bg-transparent lg:pl-[164px] xl:pl-[196px] lg:pr-14 xl:pr-24 lg:py-12',
    panelBgClass,
  ]}
>
  <!-- Mobile & Tablet: Distinctive asymmetric sweeping curved white transition over lower portion of photograph -->
  <div class="pointer-events-none absolute -top-[54px] sm:-top-[66px] left-0 right-0 h-[55px] sm:h-[67px] overflow-hidden lg:hidden" aria-hidden="true">
    <svg
      class="h-full w-full text-[#FCFBF9] drop-shadow-[0_-10px_22px_rgba(14,11,9,0.18)]"
      viewBox="0 0 400 72"
      preserveAspectRatio="none"
      fill="currentColor"
    >
      <path d="M 0,72 L 0,58 C 0,30 34,22 108,21 C 218,20 296,19 348,11 C 378,6 394,2 400,0 L 400,72 Z" />
    </svg>
  </div>

  <!-- Desktop: Distinctive full-height curved white background overlapping the photograph -->
  <div class="pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true">
    <svg
      class="absolute inset-y-0 left-0 h-full w-[164px] text-[#FCFBF9] drop-shadow-[-20px_0_36px_rgba(14,11,9,0.24)]"
      viewBox="0 0 164 900"
      preserveAspectRatio="none"
      fill="currentColor"
    >
      <path d="M 164,0 L 142,0 C 52,0 6,104 6,255 L 6,645 C 6,796 52,900 142,900 L 164,900 Z" />
    </svg>
    <div class="absolute inset-y-0 left-[162px] right-0 bg-[#FCFBF9]" />
  </div>

  <slot />
</div>
