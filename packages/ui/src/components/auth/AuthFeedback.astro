---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    'mb-5 rounded-xl border border-sand bg-cream px-4 py-3 text-[13px] leading-relaxed text-ink',
    className,
  ]}
  role="status"
  aria-live="polite"
  data-auth-status
  hidden
></div>
