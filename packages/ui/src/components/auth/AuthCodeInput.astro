---
/**
 * The 6-digit code field: one real, visible input (no transparent overlay) that screen readers, password
 * managers and email/SMS autofill understand — `autocomplete="one-time-code"`, `inputmode="numeric"`.
 * Wide letter spacing makes the digits read like separate boxes. The error element `${id}-error` is bound
 * with aria-describedby and filled by the auth client.
 */
interface Props {
  id?: string;
  label?: string;
}

const { id = 'auth-code-input', label = '6-digit code' } = Astro.props;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
---

<div>
  <label for={id} class="mb-2 block text-[14px] font-semibold text-ink">
    {label}
  </label>
  <p id={hintId} class="-mt-1 mb-2 text-[13px] text-muted">
    The code is in the email we just sent. It works for 10 minutes.
  </p>
  <input
    id={id}
    name="code"
    type="text"
    inputmode="numeric"
    autocomplete="one-time-code"
    pattern="[0-9]{6}"
    minlength="6"
    maxlength="6"
    required
    spellcheck="false"
    aria-describedby={`${hintId} ${errorId}`}
    placeholder="000000"
    class="min-h-[56px] w-full rounded-[14px] border border-ink/50 bg-white px-4 py-3 text-center font-mono text-[26px] font-semibold tracking-[0.5em] text-ink shadow-[0_1px_2px_rgba(24,20,17,0.03)] placeholder:text-muted/60 focus:border-terracotta focus:outline-none focus:ring-2 focus:ring-terracotta/20 aria-[invalid=true]:border-2 aria-[invalid=true]:border-terracotta-deep"
  />
  <p id={errorId} class="mt-1.5 text-[13px] font-semibold text-terracotta-deep" hidden>
    <span class="sr-only">Error: </span>
    <span data-error-text></span>
  </p>
</div>
