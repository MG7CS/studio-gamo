---
interface Props {
  id?: string;
  label?: string;
}

const { id = 'auth-code-input', label = '6-digit verification code' } = Astro.props;
---

<div>
  <label for={id} class="sr-only">
    {label}
  </label>
  <div class="relative" data-otp-container>
    <div class="grid grid-cols-6 gap-2 min-[375px]:gap-2.5 sm:gap-3" aria-hidden="true">
      {[0, 1, 2, 3, 4, 5].map((idx) => (
        <div
          data-otp-slot={idx}
          data-active={idx === 0 ? 'true' : 'false'}
          class="flex h-[52px] min-[375px]:h-[56px] sm:h-[60px] items-center justify-center rounded-[14px] border border-[#E4DFD7] bg-white text-[21px] font-semibold text-[#1D1917] shadow-[0_1px_2px_rgba(24,20,17,0.03)] transition-all data-[active=true]:border-[#6D64E8] data-[active=true]:ring-2 data-[active=true]:ring-[#6D64E8]/20"
        />
      ))}
    </div>
    <input
      id={id}
      name="code"
      type="text"
      inputmode="numeric"
      autocomplete="one-time-code"
      pattern="[0-9]{6}"
      minlength="6"
      maxlength="6"
      required
      aria-label={label}
      class="absolute inset-0 h-full w-full cursor-text opacity-0 text-transparent caret-transparent focus:outline-none"
    />
  </div>
</div>
