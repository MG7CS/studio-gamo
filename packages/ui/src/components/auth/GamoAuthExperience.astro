---
/**
 * GamoAuthExperience — the one shared sign-in / sign-up / verify / recover screen (AGENTS.md "Shared
 * Authentication Design Rule"). Product differences come in as configuration:
 *
 * - mode, program, brandHref, brandLabel, heading, subtext, photos — as before;
 * - signupRoles — the product's provider role chips (`authScreenOptions()` from `@gamo/domain`);
 * - termsDocuments — the Site Terms + Privacy consent shown on sign-up (`termsConsentDocuments()`);
 * - selectedRole — preselect a chip (`?role=` on the sign-up URL).
 *
 * Clerk is used only when the server can verify its sessions (`Astro.locals.clerkConfig.isConfigured`);
 * "Continue with Google" only when, in addition, `CLERK_GOOGLE_ENABLED_<APP>=true`.
 */
import AuthLayout from './AuthLayout.astro';
import AuthForm from './AuthForm.astro';
import type { AuthPhotoItem } from './AuthPhotoPanel.astro';
import type { AuthRoleOption } from './AuthRoleChips.astro';
import type { AuthScreenMode } from '../../lib/auth-flow-client';
import type { TermsConsentDocument } from '../../lib/terms-links';
import { googleSignInEnabled } from '../../lib/auth-errors';

interface Props {
  mode?: AuthScreenMode;
  program?: string;
  brandHref?: string;
  brandLabel?: string;
  heading?: string;
  subtext?: string;
  photos?: AuthPhotoItem[];
  signupRoles?: AuthRoleOption[];
  selectedRole?: string | null;
  termsDocuments?: TermsConsentDocument[];
  clerkPublishableKey?: string;
  clerkAppId?: string;
}

const clerkLocals = Astro.locals.clerkConfig as
  { isConfigured?: boolean; publishableKey?: string | null; clerkAppId?: string | null } | undefined;
const clerkActive = clerkLocals?.isConfigured === true;
const product = typeof Astro.locals.product === 'string' ? Astro.locals.product : undefined;

const {
  mode = 'signin',
  program = 'Gamo Studios',
  brandHref = '/',
  brandLabel = `${program} home`,
  heading,
  subtext,
  photos,
  signupRoles = [],
  selectedRole,
  termsDocuments = [],
  clerkPublishableKey = clerkActive ? (clerkLocals?.publishableKey ?? undefined) : undefined,
  clerkAppId = clerkActive ? (clerkLocals?.clerkAppId ?? undefined) : undefined,
} = Astro.props;

const googleEnabled = googleSignInEnabled({
  clerkConfigured: clerkActive,
  product,
  env: Astro.locals.runtimeEnv as Record<string, unknown> | undefined,
});
const claim = Astro.url.searchParams.get('claim');
const claimNote =
  mode === 'signup' && (claim === 'tickets' || claim === 'registration')
    ? `Use the same email you used for your ${claim === 'tickets' ? 'tickets' : 'registration'}. After you confirm it with the emailed code, your ${claim === 'tickets' ? 'orders' : 'registrations'} appear in your account.`
    : undefined;
const roleValue = signupRoles.some((r) => r.value === selectedRole) ? selectedRole : null;
---

<AuthLayout
  mode={mode}
  program={program}
  brandHref={brandHref}
  brandLabel={brandLabel}
  photos={photos}
  clerkPublishableKey={clerkPublishableKey}
  clerkAppId={clerkAppId}
>
  <AuthForm
    mode={mode}
    program={program}
    product={product}
    heading={heading}
    subtext={claimNote ?? subtext}
    signupRoles={signupRoles}
    selectedRole={roleValue}
    termsDocuments={termsDocuments}
    googleEnabled={googleEnabled}
    clerkActive={clerkActive}
  />
</AuthLayout>

<script>
  import { initAuthFlow } from '../../lib/auth-flow-client';
  import { initForms } from '../../lib/forms-client';
  initAuthFlow();
  initForms();
</script>
