---
import AuthLayout from './AuthLayout.astro';
import AuthForm from './AuthForm.astro';
import type { AuthPhotoItem } from './AuthPhotoPanel.astro';
import type { AuthScreenMode } from '../../lib/auth-flow-client';

interface Props {
  mode?: AuthScreenMode;
  program?: string;
  brandHref?: string;
  brandLabel?: string;
  heading?: string;
  subtext?: string;
  photos?: AuthPhotoItem[];
  googleAuthUrl?: string;
  facebookAuthUrl?: string;
  clerkPublishableKey?: string;
  clerkAppId?: string;
}

// The browser may use Clerk only when the server can verify the resulting session (publishable key
// plus secret or JWT key). A half-configured product keeps the emailed-code flow.
const clerkLocals = Astro.locals.clerkConfig as
  { isConfigured?: boolean; publishableKey?: string | null; clerkAppId?: string | null } | undefined;
const clerkActive = clerkLocals?.isConfigured === true;

const {
  mode = 'signin',
  program = 'Gamo Studios',
  brandHref = '/',
  brandLabel = `${program} home`,
  heading,
  subtext,
  photos,
  googleAuthUrl,
  facebookAuthUrl,
  clerkPublishableKey = clerkActive ? (clerkLocals?.publishableKey ?? undefined) : undefined,
  clerkAppId = clerkActive ? (clerkLocals?.clerkAppId ?? undefined) : undefined,
} = Astro.props;
---

<AuthLayout
  mode={mode}
  program={program}
  brandHref={brandHref}
  brandLabel={brandLabel}
  photos={photos}
  clerkPublishableKey={clerkPublishableKey}
  clerkAppId={clerkAppId}
>
  <AuthForm
    mode={mode}
    program={program}
    heading={heading}
    subtext={subtext}
    googleAuthUrl={googleAuthUrl}
    facebookAuthUrl={facebookAuthUrl}
  />
</AuthLayout>

<script>
  import { initAuthFlow } from '../../lib/auth-flow-client';
  initAuthFlow();
</script>
