---
/**
 * Role chips on the sign-up screen (design §4.3): which kind of provider account this is. Radio buttons in a
 * fieldset (arrow keys move between them), each a ≥ 44 px chip. Optional — "Not now" keeps a plain account;
 * a chosen role opens the matching onboarding after the email is verified. `selected` comes from `?role=`.
 */
export interface AuthRoleOption {
  value: string;
  label: string;
}
interface Props {
  roles: AuthRoleOption[];
  selected?: string | null;
  program: string;
}
const { roles, selected, program } = Astro.props;
const options = [...roles, { value: '', label: 'Not now' }];
---

{roles.length > 0 && (
  <fieldset>
    <legend class="mb-2 block text-[14px] font-semibold text-ink">I'm joining {program} as</legend>
    <div class="flex flex-wrap gap-2">
      {options.map((role) => (
        <label class="relative inline-flex min-h-11 cursor-pointer items-center rounded-full border border-ink/40 bg-white px-4 text-[14px] font-medium text-ink transition-colors has-[:checked]:border-terracotta-deep has-[:checked]:bg-terracotta-deep has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-terracotta has-[:focus-visible]:ring-offset-2">
          <input
            type="radio"
            name="role"
            value={role.value}
            checked={(selected ?? '') === role.value}
            class="sr-only"
          />
          {role.label}
        </label>
      ))}
    </div>
  </fieldset>
)}
