---
import type { AuthScreenMode } from '../../lib/auth-flow-client';

interface Props {
  mode: AuthScreenMode;
  signInHref?: string;
}

const { mode, signInHref = '/account/signin' } = Astro.props;
---

<div class="relative z-10 flex items-center justify-between min-h-[12px] lg:min-h-[36px]">
  {/* Top-left Back Button (Verify & Recover) — aligned with the form column on mobile and top-left on desktop */}
  <div
    data-back-bar
    class:list={[
      'w-full max-w-[432px] mx-auto lg:max-w-none lg:mx-0 flex items-center pt-1 pb-2 lg:py-0',
      mode === 'verify' || mode === 'recover' ? 'flex' : 'hidden',
    ]}
  >
    <button
      type="button"
      data-btn-reset
      aria-label="Back to sign in"
      class="-ml-2 inline-flex h-9 w-9 items-center justify-center rounded-full text-muted transition-colors hover:bg-ink/[0.05] hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.5 10H4.5m0 0 4.5-4.5M4.5 10 9 14.5" />
      </svg>
    </button>
  </div>

  {/* Top-right "Already have an account? Sign in" bar (Desktop Create Account) */}
  <div
    data-signup-topbar
    class:list={[
      'ml-auto items-center gap-3 text-[13px] text-muted',
      mode === 'signup' ? 'hidden lg:flex' : 'hidden',
    ]}
  >
    <span>Already have an account?</span>
    <a
      href={signInHref}
      data-nav-signin
      class="inline-flex items-center justify-center rounded-lg border border-terracotta-soft/60 bg-transparent px-3.5 py-1.5 text-[13px] font-medium text-terracotta transition-colors hover:border-terracotta hover:bg-terracotta/[0.05] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-terracotta"
    >
      Sign in
    </a>
  </div>
</div>
