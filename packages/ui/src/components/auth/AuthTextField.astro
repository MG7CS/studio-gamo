---
/**
 * One labelled field of the shared auth screens. The label is visible at every width (placeholders are
 * examples only), and the error element `${id}-error` is bound with aria-describedby; the auth client sets
 * `aria-invalid` and fills it when the server or Clerk reports a problem with this field.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email';
  autocomplete?: string;
  placeholder?: string;
  required?: boolean;
  icon?: 'mail' | 'none';
  accent?: 'terracotta' | 'lavender';
  dataVerifyEmailInput?: boolean;
  hint?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  autocomplete,
  placeholder = '',
  required = false,
  icon = 'none',
  dataVerifyEmailInput = false,
  hint,
} = Astro.props;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
---

<div>
  <label for={id} class="mb-2 block text-[14px] font-semibold text-ink">
    {label}
    {required && (
      <span class="font-normal text-muted">
        {' '}
        <span aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      </span>
    )}
  </label>
  {hint && (
    <p id={hintId} class="-mt-1 mb-2 text-[13px] text-muted">
      {hint}
    </p>
  )}
  <div class="relative">
    {icon === 'mail' && (
      <span
        class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-muted"
        aria-hidden="true"
      >
        <svg
          class="h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
        >
          <rect x="3" y="5" width="18" height="14" rx="2.5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6" />
        </svg>
      </span>
    )}
    <input
      id={id}
      name={name}
      type={type}
      autocomplete={autocomplete}
      required={required}
      placeholder={placeholder}
      aria-describedby={[hint ? hintId : null, errorId].filter(Boolean).join(' ')}
      data-verify-email-input={dataVerifyEmailInput ? '' : undefined}
      class:list={[
        'min-h-11 w-full rounded-[14px] border border-ink/50 bg-white py-3.5 text-[15px] text-ink placeholder:text-muted shadow-[0_1px_2px_rgba(24,20,17,0.03)] transition-all focus:outline-none focus:border-terracotta focus:ring-2 focus:ring-terracotta/20 aria-[invalid=true]:border-2 aria-[invalid=true]:border-terracotta-deep',
        icon === 'mail' ? 'pl-11 pr-4' : 'px-4',
      ]}
    />
  </div>
  <p id={errorId} class="mt-1.5 text-[13px] font-semibold text-terracotta-deep" hidden>
    <span class="sr-only">Error: </span>
    <span data-error-text></span>
  </p>
</div>
