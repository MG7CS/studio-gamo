---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email';
  autocomplete?: string;
  placeholder?: string;
  required?: boolean;
  icon?: 'mail' | 'none';
  accent?: 'terracotta' | 'lavender';
  dataVerifyEmailInput?: boolean;
}

const {
  id,
  name,
  label,
  type = 'text',
  autocomplete,
  placeholder = '',
  required = false,
  icon = 'none',
  accent = 'terracotta',
  dataVerifyEmailInput = false,
} = Astro.props;

const focusClasses =
  accent === 'lavender'
    ? 'focus:border-[#7B73E6] focus:ring-2 focus:ring-[#7B73E6]/20'
    : 'focus:border-[#B85A34] focus:ring-2 focus:ring-[#B85A34]/20';
---

<div>
  <label
    for={id}
    class="sr-only lg:not-sr-only lg:block lg:text-[13px] lg:font-medium lg:text-[#3A332E] lg:mb-2"
  >
    {label}
  </label>
  <div class="relative">
    {icon === 'mail' && (
      <span
        class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-[#8C827A]"
        aria-hidden="true"
      >
        <svg
          class="h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
        >
          <rect x="3" y="5" width="18" height="14" rx="2.5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="m4 7 8 6 8-6" />
        </svg>
      </span>
    )}
    <input
      id={id}
      name={name}
      type={type}
      autocomplete={autocomplete}
      required={required}
      placeholder={placeholder}
      data-verify-email-input={dataVerifyEmailInput ? '' : undefined}
      class:list={[
        'w-full rounded-[14px] border border-[#E4DFD7] bg-white py-3.5 text-[15px] text-[#1D1917] placeholder:text-[#9A9087] shadow-[0_1px_2px_rgba(24,20,17,0.03)] transition-all focus:outline-none',
        icon === 'mail' ? 'pl-11 pr-4' : 'px-4',
        focusClasses,
      ]}
    />
  </div>
</div>
