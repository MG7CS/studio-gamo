---
import type { AuthScreenMode } from '../../lib/auth-flow-client';

interface Props {
  mode: AuthScreenMode;
  heading: string;
  subtext: string;
  maskedEmailPlaceholder?: string;
}

const { mode, heading, subtext, maskedEmailPlaceholder = 'you@example.com' } = Astro.props;
---

<header class="mb-6 lg:mb-7">
  <h1
    data-auth-heading
    class="text-[29px] sm:text-[34px] lg:text-[36px] font-black tracking-[-0.03em] text-ink leading-[1.12] uppercase"
  >
    {heading}
  </h1>
  <p data-auth-subtext class="mt-2 text-[15px] leading-relaxed text-muted">
    {subtext}
  </p>
  <p
    data-verify-email-wrap
    class:list={[
      'mt-0.5 text-[15px] font-medium text-muted lg:text-ink',
      mode === 'verify' ? 'block' : 'hidden',
    ]}
  >
    <span data-verify-email-label>{maskedEmailPlaceholder}</span>
  </p>
</header>
