---
/**
 * Accessible FAQ list built on native <details>/<summary> (works without JS). Semantic tokens only;
 * `tone="dark"` sets data-surface="dark" for use on a dark band.
 */
import Icon from './Icon.astro';
interface Props {
  items: { q: string; a: string }[];
  tone?: 'light' | 'dark';
  class?: string;
}
const { items, tone = 'light', class: className } = Astro.props;
---

<div
  data-surface={tone === 'dark' ? 'dark' : undefined}
  class:list={['divide-y divide-border border-y border-border', className]}
>
  {items.map((item) => (
    <details class="group py-1">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-xl py-5 text-left text-lg font-semibold [&::-webkit-details-marker]:hidden">
        {item.q}
        <span class="flex size-9 shrink-0 items-center justify-center rounded-button bg-surface-raised transition-transform group-open:rotate-45">
          <Icon name="plus" class="h-4 w-4" strokeWidth={2} />
        </span>
      </summary>
      <p class="max-w-3xl pb-6 leading-relaxed text-fg-muted">{item.a}</p>
    </details>
  ))}
</div>
