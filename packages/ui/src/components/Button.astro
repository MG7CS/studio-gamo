---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { href, variant = 'primary', class: className = '', type = 'button', ...rest } = Astro.props;

const baseClasses = "inline-flex min-h-12 items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold transition-colors text-center w-full sm:w-auto";

const variants = {
  primary: "bg-[#B65B35] text-white hover:bg-[#8F432A] shadow-lg shadow-[#B65B35]/20",
  secondary: "bg-white text-[#1D2323] hover:bg-white/90",
  outline: "bg-transparent text-white border border-white/30 hover:bg-white/10",
  ghost: "bg-white/10 backdrop-blur-md text-white border border-white/20 hover:bg-white/20",
};

const classes = `${baseClasses} ${variants[variant]} ${className}`;
---
{href ? (
  <a href={href} class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} {...rest}>
    <slot />
  </button>
)}
