---
/**
 * Contextual audience switch (WAI-ARIA tabs). Panels are provided as named slots
 * matching each option `id`, e.g. <div slot="churches">…</div>.
 * Without JS every panel stays visible, so content is never lost.
 */
interface Props {
  id: string;
  label: string;
  options: { id: string; label: string }[];
  tone?: 'light' | 'dark';
  class?: string;
}
const { id, label, options, tone = 'light', class: className } = Astro.props;
const slotHtml = await Promise.all(options.map((o) => Astro.slots.render(o.id)));
---
<div class:list={['audience-switch', className]} data-audience-switch={id}>
  <div role="tablist" aria-label={label} class:list={['inline-flex rounded-full p-1.5', tone === 'dark' ? 'bg-white/10' : 'border border-sand bg-white/80']}>
    {options.map((o, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${o.id}`}
        aria-controls={`${id}-panel-${o.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class:list={[
          'rounded-full px-5 py-2.5 text-sm font-semibold transition-colors sm:px-6',
          tone === 'dark'
            ? 'text-cream/75 aria-selected:bg-cream aria-selected:text-charcoal'
            : 'text-charcoal/70 aria-selected:bg-charcoal aria-selected:text-cream',
        ]}
      >{o.label}</button>
    ))}
  </div>
  {options.map((o, i) => (
    <div role="tabpanel" id={`${id}-panel-${o.id}`} aria-labelledby={`${id}-tab-${o.id}`} tabindex="0" class="mt-8 focus-visible:outline-none" data-initial-hidden={i === 0 ? undefined : ''}>
      <Fragment set:html={slotHtml[i]} />
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-audience-switch]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const select = (index: number, focus = false) => {
      tabs.forEach((t, i) => {
        const on = i === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        if (e.key === 'Home') select(0, true);
        if (e.key === 'End') select(tabs.length - 1, true);
      });
    });
    select(0);
  });
</script>
