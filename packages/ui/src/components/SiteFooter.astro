---
/**
 * Footer shared by every public app. App-neutral: description, link groups, legal links, social
 * links, the optional updates column and the status note come from the app's `ShellConfig` (`src/site.config.ts`).
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { ShellConfig } from '../shell/types';

interface Props {
  shell: ShellConfig;
}
const { shell } = Astro.props;
const { brand, footer } = shell;

/** Generic social icon paths, selected by a social link's `key`. */
const SOCIAL_ICONS: Record<string, string> = {
  instagram:
    'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.5-1.5h.01',
  youtube: 'M3 8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8Zm7 1.5v5l4.5-2.5L10 9.5Z',
  facebook: 'M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v7h4v-7h3l1-4h-4V8.5c0-.3.2-.5.5-.5Z',
};
const socials = (footer.social ?? []).filter((s) => s.key && SOCIAL_ICONS[s.key]);
---

<footer data-surface="dark" class="relative isolate overflow-hidden bg-ink text-cream">
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[185px] bg-gradient-to-t from-terracotta/10 to-transparent"
    aria-hidden="true"
  ></div>
  <div class="relative z-10 mx-auto max-w-[1536px] px-6 pt-20 pb-14 sm:px-12 lg:px-[4.5%]">
    <div
      class:list={[
        'grid grid-cols-2 gap-x-6 gap-y-10 lg:gap-8',
        footer.updates ? 'lg:grid-cols-[1.65fr_1fr_1fr_1fr_1.4fr]' : 'lg:grid-cols-[1.65fr_1fr_1fr_1fr]',
      ]}
    >
      <div class="col-span-2 lg:col-span-1">
        <a href={brand.href} class="inline-flex min-h-11 items-center" aria-label={`${brand.name} homepage`}>
          <Logo width="210" height="45" />
        </a>
        <p class="mt-5 max-w-[300px] text-base leading-relaxed text-cream/80">{footer.description}</p>
        {socials.length > 0 && (
          <ul class="mt-7 flex gap-3" aria-label="Social media">
            {socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  title={s.label}
                  class="flex h-11 w-11 items-center justify-center rounded-button bg-white/10 text-white transition-colors hover:bg-white/20"
                >
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                    <path d={SOCIAL_ICONS[s.key as string]} />
                  </svg>
                  <span class="sr-only">{s.label}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      {footer.groups.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="mb-5 text-base font-semibold text-white">{col.title}</h2>
          <ul class="space-y-1">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="inline-flex min-h-11 min-w-11 items-center text-sm text-cream/80 transition-colors hover:text-white"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
      {footer.updates && (
        <div class="col-span-2 lg:col-span-1">
          <h2 class="mb-5 text-base font-semibold text-white">{footer.updates.title}</h2>
          <p class="max-w-xs text-sm leading-relaxed text-cream/80">{footer.updates.body}</p>
          <a
            href={footer.updates.link.href}
            class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-button border border-white/25 bg-white/5 px-5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
          >
            {footer.updates.link.label}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
      )}
    </div>
    {footer.note && (
      <p id="status" class="mt-16 max-w-3xl text-xs leading-relaxed text-cream/80">
        {footer.note}
      </p>
    )}
    <div class="mt-6 flex flex-col gap-4 border-t border-white/20 pt-7 text-sm text-cream/80 md:flex-row md:items-center md:justify-between">
      <p>
        © {new Date().getFullYear()} {brand.name}. All rights reserved.
      </p>
      <nav aria-label="Legal" class="flex flex-wrap gap-x-6">
        {footer.legal.map((l) => (
          <a href={l.href} class="inline-flex min-h-11 items-center hover:text-white">
            {l.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
