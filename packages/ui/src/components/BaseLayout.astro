---
import HeadIcons from './HeadIcons.astro';
import FontPreload from './FontPreload.astro';
/**
 * Shared document shell for every public Gamo Studios app.
 * Each app's own Layout imports its `app.css` and then wraps this component.
 */
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { siteOrigin, type SiteKey } from '../lib/sites';

interface Props {
  title: string;
  description?: string;
  /** Active primary nav key. */
  current?: string;
  headerTheme?: 'light' | 'dark';
  /** Background/text classes for <body>. */
  bodyClass?: string;
  /** Hide shared chrome for focused flows (e.g. sign-in, scanner). */
  chrome?: boolean;
  /** Absolute or root-relative 1200x630 share image; defaults to the app's /og-image.png (scripts/generate-share-images.mjs). */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'event';
  /** Opt a page out of indexing metadata (no canonical or social tags). Private routes are detected automatically. */
  noindex?: boolean;
  /** Structured data blocks, serialized as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = 'Gamo Studios brings together Worship, Academy, Live and Production to serve churches, musicians, students and families through music and Christian gatherings.',
  current,
  headerTheme = 'light',
  bodyClass = 'bg-cream text-charcoal',
  chrome = true,
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

// Private and account pages (flagged by the page middleware) get no canonical or social tags.
const locals = Astro.locals;
const app = locals.product as SiteKey | undefined;
const indexable = Boolean(app) && !noindex;
const origin = app ? siteOrigin(app) : '';
const canonical = indexable ? origin + (Astro.url.pathname.replace(/\/+$/, '') || '/') : undefined;
const imageUrl = indexable && ogImage ? new URL(ogImage, origin).href : undefined;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <HeadIcons />
    <FontPreload />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && (
      <>
        <meta property="og:site_name" content="Gamo Studios" />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {imageUrl && <meta property="og:image" content={imageUrl} />}
        {imageUrl && <meta name="twitter:image" content={imageUrl} />}
      </>
    )}
    {indexable &&
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, '\\u003c')} />
      ))}
    <slot name="head" />
  </head>
  <body class:list={['font-sans antialiased', bodyClass]}>
    {/* SiteHeader carries its own skip link; focused flows without chrome still need one. */}
    {!chrome && (
      <a
        href="#main-content"
        class="sr-only z-[60] rounded-full bg-charcoal px-5 text-sm font-semibold text-cream focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center"
      >
        Skip to content
      </a>
    )}
    {chrome &&
      (Astro.slots.has('header') ? (
        <slot name="header" />
      ) : (
        <SiteHeader current={current} theme={headerTheme} />
      ))}
    <main id="main-content" class:list={['overflow-x-clip', !chrome && 'min-h-screen w-full']}>
      <slot />
    </main>
    {chrome && (Astro.slots.has('footer') ? <slot name="footer" /> : <SiteFooter />)}
    <script>
      // Progressive enhancement: reveal elements as they scroll into view.
      document.documentElement.classList.add('js');
      const items = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
