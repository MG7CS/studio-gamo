---
import HeadIcons from './HeadIcons.astro';
import FontPreload from './FontPreload.astro';
/**
 * Shared document shell. App-neutral: each app's own layout imports its `app.css`, then wraps
 * this component and passes its `ShellConfig` (`src/site.config.ts`). Without a `shell` the page
 * renders no header or footer (as with `chrome={false}`).
 */
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { siteOrigin, type SiteKey } from '../lib/sites';
import type { ShellConfig } from '../shell/types';

interface Props {
  title: string;
  /** Meta description; defaults to the shell's footer description. */
  description?: string;
  /** The app's shell configuration (brand, nav, footer). */
  shell?: ShellConfig;
  /** Active nav item key. */
  current?: string;
  headerTheme?: 'light' | 'dark';
  /** Background/text classes for <body>. */
  bodyClass?: string;
  /** Hide shared chrome for focused flows. */
  chrome?: boolean;
  /** Keep the header but drop the footer (and the `footer` slot); ignored when `chrome` is false, which drops both. */
  footer?: boolean;
  /** Absolute or root-relative 1200x630 share image; defaults to the app's /og-image.png (scripts/generate-share-images.mjs). */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'event';
  /** Opt a page out of indexing: outputs `<meta name="robots" content="noindex, nofollow">` and drops canonical and social tags. Private routes are detected automatically. */
  noindex?: boolean;
  /** Structured data blocks, serialized as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  shell,
  description = shell?.footer.description ?? '',
  current,
  headerTheme = 'light',
  bodyClass = 'bg-cream text-charcoal',
  chrome = true,
  footer = true,
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

// Private pages (flagged by the page middleware) get no canonical or social tags.
const locals = Astro.locals;
const app = locals.product as SiteKey | undefined;
const indexable = Boolean(app) && !noindex && !locals.noindexPage;
const origin = app ? siteOrigin(app) : '';
const canonical = indexable ? origin + (Astro.url.pathname.replace(/\/+$/, '') || '/') : undefined;
const imageUrl = indexable && ogImage ? new URL(ogImage, origin).href : undefined;
const siteName = shell?.brand.name;
const showChrome = chrome && Boolean(shell);
const showFooter = showChrome && footer;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <HeadIcons />
    <FontPreload />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && (
      <>
        {siteName && <meta property="og:site_name" content={siteName} />}
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {imageUrl && <meta property="og:image" content={imageUrl} />}
        {imageUrl && <meta name="twitter:image" content={imageUrl} />}
      </>
    )}
    {indexable &&
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block).replace(/</g, '\\u003c')} />
      ))}
    <slot name="head" />
  </head>
  <body class:list={['font-sans antialiased', bodyClass]}>
    {/* SiteHeader carries its own skip link; focused flows without chrome still need one. */}
    {!showChrome && (
      <a
        href="#main-content"
        class="sr-only z-[60] rounded-button bg-charcoal px-5 text-sm font-semibold text-cream focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center"
      >
        Skip to content
      </a>
    )}
    {showChrome &&
      shell &&
      (Astro.slots.has('header') ? (
        <slot name="header" />
      ) : (
        <SiteHeader shell={shell} current={current} theme={headerTheme} />
      ))}
    <main id="main-content" class:list={['overflow-x-clip', !chrome && 'min-h-screen w-full']}>
      <slot />
    </main>
    {showFooter &&
      shell &&
      (Astro.slots.has('footer') ? <slot name="footer" /> : <SiteFooter shell={shell} />)}
    <script>
      // Progressive enhancement: reveal elements as they scroll into view.
      document.documentElement.classList.add('js');
      const items = document.querySelectorAll('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
