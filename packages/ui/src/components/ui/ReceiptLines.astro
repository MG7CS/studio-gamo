---
/**
 * Every line of what someone pays, then the total (checkout review, order page, organizer and admin order detail, door
 * sale). Amounts arrive formatted (cents formatted on the server); a line may carry a short note such as who receives
 * a gift. Each line is a row with its label and amount, so screen readers read them in pairs.
 */
interface Line {
  label: string;
  amount: string;
  note?: string;
}
interface Props {
  lines: Line[];
  total: { label: string; amount: string };
  /** Optional visible heading above the lines. */
  caption?: string;
  class?: string;
}
const { lines, total, caption, class: className } = Astro.props;
---

<div class:list={['text-[14px] text-ink', className]}>
  {caption && <p class="mb-2 text-[13px] font-semibold text-muted">{caption}</p>}
  <dl class="divide-y divide-line">
    {lines.map((l) => (
      <div class="flex items-start justify-between gap-4 py-2">
        <dt>
          {l.label}
          {l.note && <span class="block text-[12px] text-muted">{l.note}</span>}
        </dt>
        <dd class="shrink-0 tabular-nums">{l.amount}</dd>
      </div>
    ))}
    <div class="flex items-start justify-between gap-4 py-2 text-[15px] font-bold">
      <dt>{total.label}</dt>
      <dd class="shrink-0 tabular-nums">{total.amount}</dd>
    </div>
  </dl>
</div>
