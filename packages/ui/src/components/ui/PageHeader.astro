---
/**
 * The top of an organizer or account page: breadcrumbs, the one <h1>, a one-line description and actions.
 * Slots: `breadcrumbs` (usually <Breadcrumbs />), `actions` (buttons aligned right on wide screens).
 */
interface Props {
  title: string;
  description?: string;
  class?: string;
}
const { title, description, class: className } = Astro.props;
---

<header class:list={['mb-6', className]}>
  {Astro.slots.has('breadcrumbs') && (
    <div class="-ml-1 mb-1">
      <slot name="breadcrumbs" />
    </div>
  )}
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
    <div class="min-w-0 flex-1 basis-64">
      <h1 class="text-[26px] font-semibold leading-tight tracking-tight text-ink">{title}</h1>
      {description && <p class="mt-1.5 max-w-prose text-[15px] text-muted">{description}</p>}
    </div>
    {Astro.slots.has('actions') && (
      <div class="flex flex-wrap items-center gap-2">
        <slot name="actions" />
      </div>
    )}
  </div>
</header>
