---
/**
 * A labelled native date or time input that matches SplitField. The browser supplies the picker, so there
 * is no free-text date parsing. Values are `YYYY-MM-DD` (date) or `HH:MM` (time).
 */
interface Props {
  id: string;
  name: string;
  label: string;
  kind?: 'date' | 'time';
  value?: string;
  min?: string;
  max?: string;
  step?: number;
  required?: boolean;
  disabled?: boolean;
  disabledReason?: string;
  hint?: string;
  error?: string;
  class?: string;
}
const {
  id,
  name,
  label,
  kind = 'date',
  value,
  min,
  max,
  step,
  required = false,
  disabled = false,
  disabledReason,
  hint,
  error,
  class: className,
} = Astro.props;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
const reasonId = `${id}-reason`;
const describedBy =
  [hint ? hintId : null, disabled && disabledReason ? reasonId : null, error ? errorId : null]
    .filter(Boolean)
    .join(' ') || undefined;
const control =
  'min-h-[56px] w-full rounded-[14px] border border-ink/50 bg-white px-4 py-3 text-[16px] text-ink shadow-[0_1px_2px_rgba(24,20,17,0.03)] focus:border-terracotta focus:outline-none focus:ring-2 focus:ring-terracotta/20 aria-[invalid=true]:border-2 aria-[invalid=true]:border-terracotta-deep disabled:cursor-not-allowed disabled:border-line disabled:bg-sand disabled:text-muted';
---

<div class={className}>
  <label for={id} class="mb-2 block text-[14px] font-semibold text-ink">
    {label}
    {required && (
      <span class="font-normal text-muted">
        <span aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      </span>
    )}
  </label>
  {hint && (
    <p id={hintId} class="-mt-1 mb-2 text-[13px] text-muted">
      {hint}
    </p>
  )}
  <input
    id={id}
    name={name}
    type={kind}
    value={value}
    min={min}
    max={max}
    step={step}
    required={required}
    disabled={disabled}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy}
    class={control}
  />
  {disabled && disabledReason && (
    <p id={reasonId} class="mt-1.5 text-[13px] text-muted">
      {disabledReason}
    </p>
  )}
  {error && (
    <p id={errorId} class="mt-1.5 text-[13px] font-semibold text-terracotta-deep">
      <span class="sr-only">Error: </span>
      {error}
    </p>
  )}
</div>
