---
/**
 * Page shell for a program site: BaseLayout with the program's title suffix and nav highlight.
 * Each app wraps this in its own layout, which imports that app's stylesheet and passes its
 * `ShellConfig` and program label.
 */
import BaseLayout from './BaseLayout.astro';
import type { ShellConfig } from '../shell/types';

export interface Props {
  /** The app's shell configuration. */
  shell: ShellConfig;
  /** Program name used in page title suffixes. */
  programLabel: string;
  /** Nav key of this program, highlighted in the header. */
  current?: string;
  title?: string;
  description?: string;
  headerTheme?: 'light' | 'dark';
  bodyClass?: string;
  chrome?: boolean;
  footer?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'event';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  shell,
  programLabel,
  current,
  title,
  description,
  headerTheme = 'light',
  bodyClass = 'bg-cream text-charcoal',
  chrome = true,
  footer = true,
  ogImage,
  ogType,
  noindex,
  jsonLd,
} = Astro.props;
---

<BaseLayout
  title={title ? `${title} | ${programLabel}` : `${programLabel} | ${shell.brand.name}`}
  description={description}
  shell={shell}
  current={current}
  headerTheme={headerTheme}
  bodyClass={bodyClass}
  chrome={chrome}
  footer={footer}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <slot name="head" slot="head" />
  <slot />
</BaseLayout>
