---
/** The big uppercase title and one line of context for a split-screen page. Renders the page's only <h1>. */
interface Props {
  title: string;
  subtext?: string;
}
const { title, subtext } = Astro.props;
---

<header class="mb-5 lg:mb-4">
  <h1 class="text-[29px] font-black uppercase leading-[1.12] tracking-[-0.03em] text-ink sm:text-[34px] lg:text-[30px] [@media(min-height:900px)]:lg:text-[34px]">
    {title}
  </h1>
  {subtext && <p class="mt-2 text-[15px] leading-relaxed text-muted">{subtext}</p>}
</header>
