---
/**
 * One labelled field for split-screen forms. The label is always visible; `error` (from the server) is
 * announced and bound with aria-describedby. Use `as="select"` with the options as the slot.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'number' | 'date' | 'time' | 'url';
  as?: 'input' | 'select' | 'textarea';
  autocomplete?: string;
  placeholder?: string;
  required?: boolean;
  value?: string;
  hint?: string;
  error?: string;
  inputmode?: 'numeric' | 'text' | 'email' | 'url';
  maxlength?: number;
  pattern?: string;
  rows?: number;
  disabled?: boolean;
  /** Shown under a disabled field so it is clear why it cannot be changed. */
  disabledReason?: string;
  min?: string;
  max?: string;
  class?: string;
  /** `sm` is the compact field for dense screens (the organizer area): 44 px high, 14 px text. */
  size?: 'md' | 'sm';
}
const {
  id,
  name,
  label,
  type = 'text',
  as = 'input',
  autocomplete,
  placeholder,
  required = false,
  value,
  hint,
  error,
  inputmode,
  maxlength,
  pattern,
  rows = 4,
  disabled = false,
  disabledReason,
  min,
  max,
  class: className,
  size = 'md',
} = Astro.props;
const hintId = `${id}-hint`;
const errorId = `${id}-error`;
const reasonId = `${id}-reason`;
const describedBy =
  [hint ? hintId : null, disabled && disabledReason ? reasonId : null, error ? errorId : null]
    .filter(Boolean)
    .join(' ') || undefined;
const compact = size === 'sm';
// Sizing differs by size; the rest of the look is shared (so the two never fight over the same property).
const sizing = compact
  ? 'min-h-11 px-3.5 py-2 text-[14px]'
  : 'min-h-[56px] px-4 py-3 text-[16px] [@media(min-width:1024px)_and_(max-height:860px)]:min-h-[48px] [@media(min-width:1024px)_and_(max-height:860px)]:py-2';
const control = `${sizing} w-full rounded-[14px] border border-ink/50 bg-white text-ink shadow-[0_1px_2px_rgba(24,20,17,0.03)] placeholder:text-muted/60 focus:border-terracotta focus:outline-none focus:ring-2 focus:ring-terracotta/20 aria-[invalid=true]:border-2 aria-[invalid=true]:border-terracotta-deep disabled:cursor-not-allowed disabled:border-line disabled:bg-sand disabled:text-muted`;
const labelClass = compact
  ? 'mb-1.5 block text-[13px] font-semibold text-ink'
  : 'mb-2 block text-[14px] font-semibold text-ink [@media(min-width:1024px)_and_(max-height:860px)]:mb-1.5';
---

<div class={className}>
  <label for={id} class={labelClass}>
    {label}
    {required && (
      <span class="font-normal text-muted">
        <span aria-hidden="true">*</span>
        <span class="sr-only">(required)</span>
      </span>
    )}
  </label>
  {hint && (
    <p id={hintId} class="-mt-1 mb-2 text-[13px] text-muted">
      {hint}
    </p>
  )}
  {as === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      maxlength={maxlength}
      required={required}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class={control}
    >{value}</textarea>
  ) : as === 'select' ? (
    <select
      id={id}
      name={name}
      required={required}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class={control}
    >
      <slot />
    </select>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      autocomplete={autocomplete}
      placeholder={placeholder}
      required={required}
      value={value}
      inputmode={inputmode}
      maxlength={maxlength}
      pattern={pattern}
      min={min}
      max={max}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class={control}
    />
  )}
  {disabled && disabledReason && (
    <p id={reasonId} class="mt-1.5 text-[13px] text-muted">
      {disabledReason}
    </p>
  )}
  {error && (
    <p id={errorId} class="mt-1.5 text-[13px] font-semibold text-terracotta-deep">
      <span class="sr-only">Error: </span>
      {error}
    </p>
  )}
</div>
