---
/**
 * Progress through a multi-step split-screen form: "Step 2 of 3 · Your seats" over a segmented bar. The bar is
 * decorative (the words carry the meaning). Each step is its own server-rendered screen, so this only shows
 * where the person is.
 */
interface Props {
  step: number;
  total: number;
  /** One short name per step, in order. */
  labels?: readonly string[];
}
const { step, total, labels = [] } = Astro.props;
const label = labels[step - 1];
---

<div class="mb-4 lg:mb-5" role="group" aria-label="Progress">
  <p class="mb-2 text-[13px] font-medium text-muted">
    <span class="font-semibold text-ink">
      Step {step} of {total}
    </span>
    {label && <span> · {label}</span>}
  </p>
  <div class="flex gap-1.5" aria-hidden="true">
    {Array.from({ length: total }, (_, i) => (
      <span
        class:list={[
          'h-1.5 flex-1 rounded-full transition-colors',
          i < step ? 'bg-terracotta-deep' : 'bg-tan/70',
        ]}
      />
    ))}
  </div>
</div>
