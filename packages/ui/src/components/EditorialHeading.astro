---
/**
 * Editorial section heading: eyebrow, large title (optional accent line) and lede.
 * Semantic tokens only: `tone="dark"` sets data-surface="dark" on the wrapper (cream title, tan
 * accent, muted lede) for use on a dark band; light keeps the parent's roles.
 */
interface Props {
  eyebrow?: string;
  title: string;
  /** Optional second line rendered in the accent colour. */
  accent?: string;
  lede?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  size?: 'display' | 'section' | 'sub';
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
  class?: string;
}
const {
  eyebrow,
  title,
  accent,
  lede,
  align = 'left',
  tone = 'light',
  size = 'section',
  as: Tag = 'h2',
  id,
  class: className,
} = Astro.props;
const sizeClass = { display: 'display-lg', section: 'section-heading', sub: 'section-subheading' }[size];
const dark = tone === 'dark';
---

<div
  data-surface={dark ? 'dark' : undefined}
  class:list={[align === 'center' ? 'mx-auto text-center' : '', 'max-w-3xl', className]}
>
  {eyebrow && <p class="eyebrow mb-4 text-accent">{eyebrow}</p>}
  <Tag id={id} class:list={[sizeClass, 'text-fg text-balance']}>
    {title}
    {accent && <span class="block text-accent">{accent}</span>}
  </Tag>
  {lede && (
    <p class:list={['mt-5 max-w-2xl text-lg leading-relaxed text-fg-muted', align === 'center' && 'mx-auto']}>
      {lede}
    </p>
  )}
  <slot />
</div>
