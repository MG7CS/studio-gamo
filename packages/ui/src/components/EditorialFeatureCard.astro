---
/**
 * Shared rounded-edge editorial feature card section with a photo in a shared `Frame` (one radius,
 * catalog focal point, inset in the panel so corners stay concentric), structured icon highlights,
 * and action buttons. `photoAlt`: omit for the catalog description, '' when decorative.
 * `photoRatio`: landscape (default), portrait or square; the build fails when the photo cannot take it.
 * `caption` renders below the photo.
 *
 * Used across Academy, Worship, and the global Gamo Studios pages for visual continuity.
 *
 * tone (semantic surfaces, default 'inset'):
 * - 'inset' — sand panel (data-surface="inset").
 * - 'raised' — ivory panel on the current surface.
 * - 'dark' — night panel with cream text (data-surface="dark").
 * Deprecated aliases: 'sand' → 'inset', 'ivory' → 'raised' (still accepted; migrate callers).
 */
import Frame from './media/Frame.astro';
import StatusPill from './StatusPill.astro';
import Icon from './Icon.astro';
import { photos, type PhotoKey } from '../lib/images';
import type { FrameRatio } from './media/frame';
import type { IconName } from '../lib/icons';

export interface EditorialFeaturePoint {
  icon: IconName;
  title: string;
  body: string;
}

export type EditorialFeatureTone = 'raised' | 'inset' | 'dark';
/** @deprecated Use 'inset' (was 'sand') or 'raised' (was 'ivory'). */
export type DeprecatedEditorialFeatureTone = 'sand' | 'ivory';
const TONE_ALIAS: Record<DeprecatedEditorialFeatureTone, EditorialFeatureTone> = {
  sand: 'inset',
  ivory: 'raised',
};

interface Props {
  id?: string;
  pillText?: string;
  pillKind?: 'sample' | 'proposal' | 'verified';
  title: string;
  accent?: string;
  /** Optional sentence under the title; omit it for a heading and the points only. */
  body?: string;
  points?: EditorialFeaturePoint[];
  photo: PhotoKey;
  photoAlt?: string;
  photoRatio?: Exclude<FrameRatio, 'wide'>;
  caption?: string;
  tone?: EditorialFeatureTone | DeprecatedEditorialFeatureTone;
  reverse?: boolean;
  /** When the copy and the photo stack (below lg), put the photo first and the copy and buttons below it. */
  mediaFirstStacked?: boolean;
  sectionClass?: string;
}

const {
  id,
  pillText,
  pillKind = 'proposal',
  title,
  accent,
  body,
  points = [],
  photo,
  photoAlt,
  photoRatio = 'landscape',
  caption,
  tone: toneProp = 'inset',
  reverse = false,
  mediaFirstStacked = false,
  sectionClass = '',
} = Astro.props;

const tone: EditorialFeatureTone =
  toneProp === 'sand' || toneProp === 'ivory' ? TONE_ALIAS[toneProp] : toneProp;
const frameAlt = photoAlt === '' ? { decorative: true as const } : { alt: photoAlt ?? photos[photo].alt };
/** data-surface for the panel: inset and dark re-map colour roles; raised keeps the parent's. */
const surface = tone === 'raised' ? undefined : tone;
const cardSurface = {
  inset: 'bg-surface text-fg',
  raised: 'bg-surface-raised text-fg ring-1 ring-border',
  dark: 'bg-surface-inset text-fg ring-1 ring-border',
}[tone];

const pointSurface = {
  inset: 'bg-surface-raised/75 ring-1 ring-border/60',
  raised: 'bg-surface-raised ring-1 ring-border',
  dark: 'bg-surface-raised ring-1 ring-border',
}[tone];

const iconBadgeSurface = {
  inset: 'bg-surface-inset text-action',
  raised: 'bg-surface text-action',
  dark: 'bg-surface-raised text-accent',
}[tone];
---

<section id={id} data-tone={tone} class:list={['px-4 section-space sm:px-8', sectionClass]} data-reveal>
  <div
    data-surface={surface}
    class:list={[
      'mx-auto grid max-w-page overflow-hidden rounded-hero shadow-panel lg:grid-cols-12',
      cardSurface,
    ]}
  >
    <div
      class:list={[
        'flex flex-col justify-center p-7 sm:p-12 lg:col-span-7 lg:p-14 xl:p-16',
        reverse && 'lg:order-2',
      ]}
    >
      <div class="flex flex-wrap items-center gap-3">
        {pillText && <StatusPill kind={pillKind} label={pillText} />}
      </div>

      <h2 class="section-heading mt-4 text-balance">
        {title} {accent && <span class="text-accent">{accent}</span>}
      </h2>

      {body && <p class="mt-4 max-w-xl text-base leading-relaxed text-fg-muted sm:text-lg">{body}</p>}

      {points.length > 0 && (
        <ul class="mt-7 grid gap-3">
          {points.map((pt) => (
            <li class:list={['flex items-start gap-3.5 rounded-2xl p-3.5 sm:p-4', pointSurface]}>
              <span class:list={['grid h-10 w-10 shrink-0 place-items-center rounded-xl', iconBadgeSurface]}>
                <Icon name={pt.icon} class="h-5 w-5" />
              </span>
              <div class="min-w-0">
                <p class="font-bold leading-snug">{pt.title}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-fg-muted">{pt.body}</p>
              </div>
            </li>
          ))}
        </ul>
      )}

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <slot />
      </div>
    </div>

    <div
      class:list={[
        'flex items-center p-5 lg:col-span-5',
        reverse && 'lg:order-1',
        mediaFirstStacked && 'max-lg:order-first',
      ]}
    >
      <div class="w-full">
        <Frame photo={photo} ratio={photoRatio} sizes="half" caption={caption} {...frameAlt} />
      </div>
    </div>
  </div>
</section>
