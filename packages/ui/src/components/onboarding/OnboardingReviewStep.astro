---
/**
 * Last onboarding step: the publish-gate checklist and the next action — submit for staff review (church,
 * musician, technician, teacher) or publish (roles without required review).
 */
import PublishGateChecklist, { type PublishGateProp } from './PublishGateChecklist.astro';
import SubmitButton from '../forms/SubmitButton.astro';

interface Props {
  role: string;
  gates: PublishGateProp[];
  canSubmit: boolean;
  requiresReview: boolean;
  status: string;
  isChurch: boolean;
}
const { role, gates, canSubmit, requiresReview, status, isChurch } = Astro.props;
const submittable = ['draft', 'changes_requested', 'rejected'].includes(status);
---

<section class="space-y-6" aria-labelledby="review-step-title">
  <div>
    <h2 id="review-step-title" class="text-2xl font-black uppercase tracking-tight text-ink">
      {requiresReview ? 'Submit for review' : 'Publish your profile'}
    </h2>
    <p class="mt-1 text-[15px] text-muted">
      {requiresReview
        ? isChurch
          ? 'Gamo staff verify every church in person before it is listed. After you submit, staff will contact you to arrange a meeting.'
          : 'Gamo staff review every profile in this role before it is listed.'
        : 'Profiles in this role can be published once the required steps are done.'}
    </p>
  </div>
  <PublishGateChecklist gates={gates} />
  {requiresReview && submittable && (
    <form method="post" action="/api/account/providers">
      <input type="hidden" name="action" value="submit" />
      <input type="hidden" name="role" value={role} />
      {canSubmit ? (
        <SubmitButton
          label={isChurch ? 'Submit church for verification' : 'Submit for review'}
          pendingLabel="Submitting…"
        />
      ) : (
        <p class="text-[15px] text-ink">Finish the items marked “To do” to submit.</p>
      )}
    </form>
  )}
  {requiresReview && !submittable && (
    <p class="rounded-xl bg-white px-4 py-3 text-[15px] text-ink ring-1 ring-ink/15">
      Status: {status.replace(/_/g, ' ')}.{' '}
      <a href={`/account/profile?role=${role}`} class="font-semibold text-terracotta-deep underline">
        See your profile
      </a>
    </p>
  )}
  {!requiresReview && (
    <a
      href={`/account/profile?role=${role}`}
      class="inline-flex min-h-11 items-center rounded-full bg-ink px-6 text-sm font-semibold text-cream"
    >
      Go to your profile to publish
    </a>
  )}
</section>
