---
/**
 * `/account/profile`: each provider profile of this person that this product offers, with its status, the
 * publish-gate checklist (what is missing and how to fix it) and the next action (submit / publish /
 * unpublish). Data: `loadProfileOverview()` from `@gamo/domain`.
 */
import AccountNotice from '../account/AccountNotice.astro';
import PublishGateChecklist, { type PublishGateProp } from './PublishGateChecklist.astro';
import SubmitButton from '../forms/SubmitButton.astro';

interface ProfileProp {
  role: string;
  label: string;
  displayName: string;
  status: string;
  statusLabel: string;
  completeness: number;
  published: boolean;
  gates: PublishGateProp[];
  canPublish: boolean;
  canSubmit: boolean;
  onboardingHref: string;
  selected: boolean;
}
interface Props {
  program: string;
  view: {
    notice: { tone: 'success' | 'error' | 'info'; text: string } | null;
    personMissing: boolean;
    profiles: ProfileProp[];
    startRoles: { value: string; label: string }[];
  };
}
const { program, view } = Astro.props;
---

<section class="mx-auto w-full max-w-3xl px-5 pb-24 pt-32 sm:px-8" aria-labelledby="profile-title">
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-terracotta-deep">{program}</p>
  <h1 id="profile-title" class="mt-2 text-3xl font-black uppercase tracking-tight text-ink sm:text-4xl">
    Your provider profiles
  </h1>
  <div class="mt-6">
    <AccountNotice notice={view.notice} />
  </div>

  {view.profiles.length === 0 && (
    <p class="mt-6 text-[15px] text-ink">
      You have no provider profile in {program} yet.{' '}
      <a href="/account/onboarding" class="font-semibold text-terracotta-deep underline">
        Set one up
      </a>
      .
    </p>
  )}

  <div class="mt-8 space-y-8">
    {view.profiles.map((p) => (
      <article
        id={`profile-${p.role}`}
        class:list={[
          'rounded-3xl bg-cream p-5 ring-1 sm:p-8',
          p.selected ? 'ring-2 ring-terracotta' : 'ring-ink/10',
        ]}
        aria-labelledby={`profile-${p.role}-title`}
      >
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-muted">{p.label}</p>
        <h2 id={`profile-${p.role}-title`} class="mt-1 text-2xl font-black uppercase tracking-tight text-ink">
          {p.displayName}
        </h2>
        <p class="mt-2 text-[15px] text-ink">
          Status: <strong>{p.statusLabel}</strong> · {p.completeness}% complete ·{' '}
          {p.published ? 'Published' : 'Not public'}
        </p>
        <div class="mt-5">
          <PublishGateChecklist gates={p.gates} />
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={p.onboardingHref}
            class="inline-flex min-h-11 items-center rounded-full border border-ink/40 bg-white px-5 text-sm font-semibold text-ink"
          >
            Edit profile
          </a>
          {p.canSubmit && (
            <form method="post" action="/api/account/providers">
              <input type="hidden" name="action" value="submit" />
              <input type="hidden" name="role" value={p.role} />
              <SubmitButton
                label={p.role === 'church' ? 'Submit church for verification' : 'Submit for review'}
              />
            </form>
          )}
          {p.canPublish && (
            <form method="post" action="/api/account/providers">
              <input type="hidden" name="action" value="publish" />
              <input type="hidden" name="role" value={p.role} />
              <SubmitButton label="Publish profile" />
            </form>
          )}
          {p.published && (
            <form method="post" action="/api/account/providers">
              <input type="hidden" name="action" value="unpublish" />
              <input type="hidden" name="role" value={p.role} />
              <SubmitButton label="Take off public view" variant="secondary" />
            </form>
          )}
        </div>
      </article>
    ))}
  </div>

  {view.startRoles.length > 0 && (
    <p class="mt-8 text-[15px] text-ink">
      Serve in another role?{' '}
      <a href="/account/onboarding" class="font-semibold text-terracotta-deep underline">
        Start a profile
      </a>
      .
    </p>
  )}
</section>
