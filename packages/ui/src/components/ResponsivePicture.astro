---
interface Props {
  /** Filename stem in /images/optimized without width or extension. */
  stem: string;
  /** Widths actually generated by the image optimization script. */
  widths: number[];
  /** CSS responsive sizing hint for the browser. */
  sizes: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const {
  stem, widths, sizes, alt,
  class: className = '',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
} = Astro.props;
const available = [...new Set(widths)].filter((n) => Number.isInteger(n) && n > 0).sort((a, b) => a - b);
if (!available.length || !/^[a-z0-9-]+$/.test(stem)) {
  throw new Error('ResponsivePicture requires a safe filename stem and at least one width');
}
const asset = (width: number, format: 'webp' | 'avif') => `/images/optimized/${stem}-${width}w.${format}`;
const srcset = (format: 'webp' | 'avif') => available.map((width) => `${asset(width, format)} ${width}w`).join(', ');
const fallback = asset(available[available.length - 1], 'webp');
---
<picture class="block h-full w-full">
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img src={fallback} alt={alt} class={className} loading={loading} decoding={decoding} fetchpriority={fetchpriority} />
</picture>
