---
/**
 * Body for 404 and 500 pages. Each app renders it inside its own layout (src/pages/404.astro,
 * src/pages/500.astro) and passes its shell config, so the home and contact links match the
 * site. Never shows error details.
 */
import ButtonLink from './ButtonLink.astro';
import type { ShellConfig } from '../shell/types';

interface Props {
  status: 404 | 500;
  /** Home and contact links come from the app's shell config. */
  shell: Pick<ShellConfig, 'brand' | 'contactHref'>;
  /** Site name shown in the copy; defaults to the shell's brand name. */
  siteName?: string;
}
const { status, shell, siteName = shell.brand.name } = Astro.props;
const homeHref = shell.brand.href;
const copy =
  status === 404
    ? {
        title: 'Page not found',
        body: `This page doesn't exist on ${siteName}, or it has moved. Check the address, or start again from the home page.`,
      }
    : {
        title: 'Something went wrong',
        body: 'We could not load this page. Please try again in a moment. If it keeps happening, let us know.',
      };
---

<section class="page-intro-space mx-auto flex min-h-[70vh] max-w-3xl flex-col justify-center px-5 md:px-8">
  <h1 class="display-lg text-charcoal">{copy.title}</h1>
  <p class="mt-6 max-w-xl text-lg text-ink-soft">{copy.body}</p>
  <div class="mt-10 flex flex-wrap gap-3">
    <ButtonLink href={homeHref} arrow>
      {siteName} home
    </ButtonLink>
    <ButtonLink href={shell.contactHref} variant="secondary">
      Contact us
    </ButtonLink>
  </div>
</section>
