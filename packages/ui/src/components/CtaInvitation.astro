---
/** Warm photographic closing invitation used at the end of pages. */
import Photo from './Photo.astro';
import type { PhotoKey } from '../lib/images';
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  photo: PhotoKey;
  photoPosition?: string;
  tone?: 'light' | 'dark';
  id?: string;
}
const { eyebrow, title, body, photo, photoPosition, tone = 'light', id } = Astro.props;
const dark = tone === 'dark';
---

<section
  id={id}
  data-surface={dark ? 'dark' : undefined}
  class:list={['section-space px-4 sm:px-8', dark ? 'bg-charcoal' : 'bg-cream']}
>
  <div
    class:list={[
      'mx-auto grid max-w-[1320px] items-stretch overflow-hidden rounded-[36px] lg:grid-cols-[1.05fr_1fr]',
      dark ? 'bg-night text-cream' : 'bg-ivory text-charcoal ring-1 ring-sand',
    ]}
  >
    <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-12">
      {eyebrow && (
        <p class:list={['eyebrow-pill mb-4 self-start', dark && 'bg-white/10 text-gold']}>{eyebrow}</p>
      )}
      <h2 class="section-heading text-balance">{title}</h2>
      <p
        class:list={[
          'mt-4 max-w-xl text-base leading-relaxed sm:text-lg',
          dark ? 'text-cream/75' : 'text-ink-soft',
        ]}
      >
        {body}
      </p>
      <div class="button-stack mt-7">
        <slot />
      </div>
    </div>
    {/* Phones see the photo first, then the invitation; desktop keeps the text on the left. */}
    <div class="relative order-first min-h-[260px] sm:min-h-[320px] lg:order-none lg:min-h-[400px]">
      <div class="absolute inset-3 overflow-hidden rounded-[24px] lg:inset-4">
        <Photo
          name={photo}
          sizes="(min-width:1024px) 45vw, 100vw"
          position={photoPosition}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
