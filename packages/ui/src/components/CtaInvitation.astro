---
/** Warm photographic closing invitation used at the end of pages. */
import Photo from './Photo.astro';
import type { PhotoKey } from '../lib/images';
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  photo: PhotoKey;
  photoPosition?: string;
  tone?: 'light' | 'dark';
  id?: string;
}
const { eyebrow, title, body, photo, photoPosition, tone = 'light', id } = Astro.props;
const dark = tone === 'dark';
---

<section
  id={id}
  data-surface={dark ? 'dark' : undefined}
  class:list={['section-space px-gutter', 'bg-surface']}
>
  <div
    class:list={[
      'mx-auto grid max-w-page items-stretch overflow-hidden rounded-hero lg:grid-cols-2',
      dark ? 'bg-surface-inset text-fg' : 'bg-surface-raised text-fg ring-1 ring-border',
    ]}
  >
    <div class="flex flex-col justify-center p-7 sm:p-10 lg:p-12">
      {eyebrow && (
        <p class:list={['eyebrow mb-4', dark ? 'text-fg-muted' : 'text-action-strong']}>{eyebrow}</p>
      )}
      <h2 class="section-heading text-balance">{title}</h2>
      <p class:list={['mt-5 max-w-xl text-lg leading-relaxed', 'text-fg-muted']}>{body}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <slot />
      </div>
    </div>
    <div class="relative min-h-75 lg:min-h-100">
      <div class="absolute inset-3 overflow-hidden rounded-card lg:inset-4 lg:rounded-tl-[12.5rem]">
        <Photo
          name={photo}
          sizes="(min-width:1024px) 45vw, 100vw"
          position={photoPosition}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
