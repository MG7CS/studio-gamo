---
/** Pill link-button. Always a real <a>; use a <button> elsewhere for in-page actions. */
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost-dark' | 'light';
  size?: 'md' | 'lg';
  arrow?: boolean;
  class?: string;
  'aria-label'?: string;
}
const { href, variant = 'primary', size = 'md', arrow = false, class: className, ...rest } = Astro.props;
const variants = {
  primary: 'bg-terracotta text-white hover:bg-terracotta-dark',
  secondary: 'border border-charcoal/20 bg-white/60 text-charcoal hover:bg-white',
  'ghost-dark': 'border border-cream/45 text-cream hover:bg-white/10',
  light: 'bg-cream text-charcoal hover:bg-white',
};
const sizes = { md: 'min-h-11 px-5 py-3 text-sm', lg: 'min-h-12 px-6 py-3 text-base' };
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-3 rounded-full font-semibold transition-colors',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
  {arrow && <Icon name="arrow" class="h-4 w-4" />}
</a>
