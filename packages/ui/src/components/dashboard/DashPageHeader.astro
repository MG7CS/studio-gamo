---
/** Contextual page header: breadcrumb, restrained title, description, actions, state preview. */
import Icon from '../Icon.astro';
import type { DashAction, Workspace } from '../../lib/dashboard';
interface Props { workspace: Workspace; title: string; description?: string; actions?: DashAction[]; path: string; state?: string }
const { workspace, title, description, actions = [], path, state } = Astro.props;
const states = ['', 'loading', 'empty', 'error', 'success'];
---
<div class="mb-6 flex flex-col gap-4 lg:mb-8 lg:flex-row lg:items-end lg:justify-between">
  <div class="min-w-0">
    <nav aria-label="Breadcrumb" class="mb-1 text-[12px] font-medium text-ink-soft">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href={workspace.basePath || '/'} class="hover:text-charcoal hover:underline">{workspace.name}</a>
        </li>
        <li class="flex items-center gap-1.5 text-ink-soft/50" aria-hidden="true">/</li>
        <li class="font-semibold text-charcoal">
          <span aria-current="page">{title}</span>
        </li>
        {workspace.organization && (
          <li class="hidden items-center gap-1.5 text-ink-soft/75 sm:inline-flex">
            <span aria-hidden="true">·</span>
            <span>{workspace.organization}</span>
          </li>
        )}
      </ol>
    </nav>
    <h1 class="mt-1 text-[26px] font-semibold leading-tight tracking-[-0.02em] sm:text-[30px]">{title}</h1>
    {description && <p class="mt-1.5 max-w-2xl text-[14px] text-ink-soft sm:text-[15px]">{description}</p>}
  </div>
  <div class="flex flex-wrap items-center gap-2">
    {actions.map((a) => {
      const cls = ['inline-flex min-h-10 items-center gap-2 rounded-lg px-4 text-[14px] font-semibold transition-colors', (a.variant ?? 'primary') === 'primary' ? 'bg-terracotta text-white hover:bg-terracotta-dark' : 'border border-sand bg-white hover:border-charcoal/30'];
      return a.dialog
        ? <button type="button" data-dialog-open={a.dialog} class:list={cls}>{a.icon && <Icon name={a.icon} class="h-4 w-4" strokeWidth={2} />}{a.label}</button>
        : <a href={a.href} class:list={cls}>{a.icon && <Icon name={a.icon} class="h-4 w-4" strokeWidth={2} />}{a.label}</a>;
    })}
    <details class="dash-menu relative" data-dash-menu>
      <summary class="inline-flex min-h-10 cursor-pointer list-none items-center gap-1.5 rounded-lg border border-dashed border-charcoal/25 px-3 text-[13px] text-ink-soft hover:bg-white [&::-webkit-details-marker]:hidden">Preview state<Icon name="chevron-down" class="h-4 w-4" /></summary>
      <ul class="absolute right-0 z-30 mt-2 w-44 rounded-xl border border-sand bg-white p-1.5 shadow-xl lg:right-0">
        {states.map((s) => <li><a href={s ? `${path}?state=${s}` : path} aria-current={(state ?? '') === s ? 'true' : undefined} class:list={['block rounded-lg px-2.5 py-1.5 text-[13px] capitalize hover:bg-cream', (state ?? '') === s && 'bg-cream font-semibold']}>{s || 'Populated (default)'}</a></li>)}
      </ul>
    </details>
  </div>
</div>
