---
/** Contextual page header: breadcrumb, restrained title, description, and actions. */
import Icon from '../Icon.astro';
import type { DashAction, Workspace } from '../../lib/dashboard';
interface Props { workspace: Workspace; title: string; description?: string; actions?: DashAction[]; path: string; state?: string }
const { workspace, title, description, actions = [] } = Astro.props;
---
<div class="mb-5 flex flex-col gap-3 sm:mb-6 lg:mb-8 lg:flex-row lg:items-end lg:justify-between">
  <div class="min-w-0 flex-1">
    <div class="mb-1.5 flex items-center justify-between gap-2">
      <nav aria-label="Breadcrumb" class="min-w-0 text-[12px] font-medium text-ink-soft">
        <ol class="flex items-center gap-1.5 truncate">
          <li class:list={[workspace.organization ? 'hidden sm:inline-flex' : 'truncate']}>
            <a href={workspace.basePath || '/'} class="font-semibold text-terracotta-dark hover:text-charcoal hover:underline sm:font-medium sm:text-ink-soft">{workspace.name}</a>
          </li>
          <li class="hidden items-center gap-1.5 text-ink-soft/50 sm:inline-flex" aria-hidden="true">/</li>
          <li class="hidden truncate font-semibold text-charcoal sm:inline-flex">
            <span aria-current="page">{title}</span>
          </li>
          {workspace.organization && (
            <li class="inline-flex min-w-0 items-center gap-1.5 text-ink-soft">
              <span class="hidden sm:inline" aria-hidden="true">·</span>
              <span class="truncate font-medium text-ink-soft">{workspace.organization}</span>
            </li>
          )}
        </ol>
      </nav>
    </div>
    <h1 class="mt-0.5 text-[24px] font-bold leading-tight tracking-[-0.025em] sm:text-[30px]" data-page-title>{title}</h1>
    {description && <p class="mt-1 max-w-2xl text-[13px] leading-5 text-ink-soft sm:text-[15px] sm:leading-6">{description}</p>}
    <p data-page-export-status hidden aria-live="polite" class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-[#E6F2EA] px-3 py-1 text-[12px] font-semibold text-[#1F5A37]"></p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    {actions.map((a) => {
      const cls = ['inline-flex min-h-10 items-center gap-2 rounded-full px-4 text-[13px] font-semibold transition-colors sm:rounded-xl sm:text-[14px]', (a.variant ?? 'primary') === 'primary' ? 'bg-terracotta text-white shadow-2xs hover:bg-terracotta-dark' : 'border border-sand bg-white hover:border-charcoal/30'];
      if (a.exportReport) {
        return <button type="button" data-export-report={a.exportReport} class:list={cls}>{a.icon && <Icon name={a.icon} class="h-4 w-4" strokeWidth={2} />}{a.label}</button>;
      }
      return a.dialog
        ? <button type="button" data-dialog-open={a.dialog} class:list={cls}>{a.icon && <Icon name={a.icon} class="h-4 w-4" strokeWidth={2} />}{a.label}</button>
        : <a href={a.href} class:list={cls}>{a.icon && <Icon name={a.icon} class="h-4 w-4" strokeWidth={2} />}{a.label}</a>;
    })}
  </div>
</div>
