---
/** Month calendar with selectable days and an accessible detail readout. */
import type { Tone } from '../../lib/dashboard';
interface Props {
  month: string;
  startDay: number;
  days: number;
  events: { day: number; label: string; tone?: Tone }[];
}
const { month, startDay, days, events } = Astro.props;
const dots: Record<string, string> = {
  success: 'bg-emerald-600',
  verified: 'bg-emerald-600',
  pending: 'bg-amber-500',
  canceled: 'bg-red-600',
  proposal: 'bg-terracotta',
  sample: 'bg-gold',
  info: 'bg-charcoal',
};
const cells = [...Array(startDay).fill(null), ...Array.from({ length: days }, (_, i) => i + 1)];
const byDay = (d: number) => events.filter((e) => e.day === d);
---

<div data-calendar>
  <div class="mb-3 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <p class="text-[16px] font-semibold text-charcoal">{month}</p>
      <div class="flex items-center gap-0.5 text-ink-soft" aria-hidden="true" title="Calendar navigation">
        <span class="inline-grid h-6 w-6 place-items-center rounded text-[11px] opacity-40">‹</span>
        <span class="inline-grid h-6 w-6 place-items-center rounded text-[11px] opacity-40">›</span>
      </div>
    </div>
    <p class="text-[12px] text-ink-soft">Select a day</p>
  </div>
  <div
    class="grid grid-cols-7 gap-1 text-center text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-soft"
    aria-hidden="true"
  >
    {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((d) => (
      <span>{d}</span>
    ))}
  </div>
  <div class="mt-1 grid grid-cols-7 gap-1">
    {cells.map((d) =>
      d === null ? (
        <span />
      ) : (
        <button
          type="button"
          data-cal-day
          aria-pressed="false"
          data-detail={
            byDay(d).length
              ? `${month.split(' ')[0]} ${d}: ${byDay(d)
                  .map((e) => e.label)
                  .join('; ')}`
              : `${month.split(' ')[0]} ${d}: nothing scheduled`
          }
          class="cal-day flex aspect-square min-h-9 flex-col items-center justify-center rounded-lg text-[13px] hover:bg-cream"
          aria-label={`${month.split(' ')[0]} ${d}${byDay(d).length ? `, ${byDay(d).length} item(s)` : ''}`}
        >
          <span>{d}</span>
          <span class="mt-0.5 flex h-1.5 gap-0.5">
            {byDay(d)
              .slice(0, 3)
              .map((e) => (
                <span class:list={['h-1.5 w-1.5 rounded-full', dots[e.tone ?? 'info'] ?? 'bg-charcoal']} />
              ))}
          </span>
        </button>
      ),
    )}
  </div>
  <p
    data-cal-detail
    aria-live="polite"
    class="mt-3 min-h-10 rounded-lg bg-ivory px-3 py-2 text-[13px] text-ink-soft"
  >
    Select a date to view scheduled commitments.
  </p>
</div>
<style>
  .cal-day[aria-pressed='true'] {
    background: var(--color-charcoal);
    color: var(--color-cream);
  }
  .cal-day[aria-pressed='true'] .rounded-full.bg-charcoal {
    background-color: var(--color-cream) !important;
  }
</style>
