---
/**
 * Demo role & workspace switcher. One fictional account, many roles/organizations.
 * Only switches between fixed demo workspaces — it can never select a real user.
 */
import Icon from '../Icon.astro';
import { workspaceDirectory } from '../../lib/dashboard';
interface Props { currentId: string; align?: 'left' | 'right' }
const { currentId, align = 'left' } = Astro.props;
const dir = workspaceDirectory();
const current = dir.find((w) => w.id === currentId) ?? dir[0];
const programs = [...new Set(dir.map((w) => w.program))];
---
<details class="dash-menu relative min-w-0" data-dash-menu>
  <summary class="flex min-h-10 cursor-pointer list-none items-center gap-2 rounded-full border border-sand bg-white px-3 py-1.5 text-left transition-colors hover:border-charcoal/30 sm:rounded-xl [&::-webkit-details-marker]:hidden">
    <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-cream text-terracotta-dark">
      <Icon name="swap" class="h-3.5 w-3.5" strokeWidth={2} />
    </span>
    <span class="min-w-0">
      <span class="block max-w-[9.5rem] truncate text-[13px] font-semibold leading-4 sm:max-w-none">{current.label}</span>
      <span class="hidden truncate text-[11px] leading-4 text-ink-soft sm:block">{current.role}{current.organization ? ` · ${current.organization}` : ''}</span>
    </span>
    <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-ink-soft" />
    <span class="sr-only">Switch workspace</span>
  </summary>
  <div class:list={['absolute z-50 mt-2 max-h-[70vh] w-[min(22rem,calc(100vw-1.5rem))] overflow-y-auto rounded-2xl border border-sand bg-white p-2.5 shadow-xl', align === 'right' ? 'right-0' : 'left-0']}>
    <p class="px-2 pb-2 pt-1 text-[12px] text-ink-soft"><strong class="text-charcoal">Switch workspace.</strong> Move between your personal account and program workspaces.</p>
    {programs.map((program) => (
      <div class="border-t border-sand/70 py-1.5">
        <p class="px-2 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-soft">{program}</p>
        {dir.filter((w) => w.program === program).map((w) => (
          <a href={w.href} aria-current={w.id === current.id ? 'true' : undefined} class:list={['flex items-center justify-between gap-2 rounded-xl px-2.5 py-2 text-[13px] hover:bg-cream', w.id === current.id && 'bg-cream font-semibold']}>
            <span><span class="block">{w.label}</span><span class="block text-[11px] text-ink-soft">{w.role}{w.organization ? ` · ${w.organization}` : ''}</span></span>
            {w.staff ? <span class="rounded bg-charcoal px-1.5 py-0.5 text-[10px] font-semibold uppercase text-cream">Staff</span> : w.id === current.id ? <Icon name="check" class="h-4 w-4 text-terracotta-dark" strokeWidth={2} /> : null}
          </a>
        ))}
      </div>
    ))}
  </div>
</details>
