---
/** Inline form with local validation and a demo success state (nothing is submitted). */
import FormFields from './FormFields.astro';
import Icon from '../Icon.astro';
import type { FormFieldDef } from '../../lib/dashboard';
interface Props { id: string; fields: FormFieldDef[]; submitLabel?: string; successText?: string; redirect?: string }
const { id, fields, submitLabel = 'Save in preview', successText = 'Saved in this preview only. Nothing was stored or sent.', redirect } = Astro.props;
---
<div>
  <form data-dash-form novalidate data-redirect={redirect} class="space-y-5">
    <FormFields fields={fields} idPrefix={id} />
    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="inline-flex min-h-10 items-center rounded-lg bg-terracotta px-4 text-[14px] font-semibold text-white hover:bg-terracotta-dark">{submitLabel}</button>
      <button type="reset" class="inline-flex min-h-10 items-center rounded-lg border border-sand bg-white px-4 text-[14px] font-semibold hover:border-charcoal/30">Reset</button>
      <span class="text-[12px] text-ink-soft">Demo only — not submitted.</span>
    </div>
  </form>
  <p data-form-success hidden tabindex="-1" role="status" class="mt-4 flex items-start gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2.5 text-[13px] text-emerald-900"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2.2} />{successText}</p>
</div>
