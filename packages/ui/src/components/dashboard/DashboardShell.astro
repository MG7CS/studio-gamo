---
import HeadIcons from '../HeadIcons.astro';
import FontPreload from '../FontPreload.astro';
/**
 * Authenticated application shell (design-first demo).
 * Full document: demo banner · desktop sidebar · top bar (search, notifications,
 * workspace switcher, account menu) · mobile drawer + bottom tab bar · content slot.
 * Each app wraps this in its own `DashboardLayout.astro` that imports the app stylesheet.
 */
import Logo from '../Logo.astro';
import Icon from '../Icon.astro';
import DashNav from './DashNav.astro';
import WorkspaceSwitcher from './WorkspaceSwitcher.astro';
import AccountMenu from './AccountMenu.astro';
import { screenHref, shortNavLabel, type ViewerPersona, type Workspace } from '../../lib/dashboard';
import { resolveWorkspaceViewer } from '../../lib/session-viewer';
import { siteUrl } from '../../lib/sites';

interface Props {
  workspace: Workspace;
  current: string;
  title: string;
  viewer?: ViewerPersona;
}
const { workspace, current, title, viewer: viewerProp } = Astro.props;
const viewer = viewerProp ?? (await resolveWorkspaceViewer(Astro));
const activeOrg = viewer.organization || workspace.organization;
const flat = workspace.nav.flatMap((g) => g.items);
const tabs = flat.slice(0, 4);
const isMoreActive = !tabs.some((t) => t.slug === current);
const notifSlug = flat.find((i) => i.slug === 'notifications');
const notifHref = notifSlug
  ? screenHref(workspace, 'notifications')
  : siteUrl('web', '/account/notifications');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <HeadIcons />
    <FontPreload />
    <title>{`${title} · ${workspace.name} | ${workspace.program}`}</title>
  </head>
  <body class="dash bg-ivory font-sans text-[14px] leading-6 text-charcoal antialiased">
    <a
      href="#dash-main"
      class="sr-only z-[60] rounded bg-charcoal px-3 py-2 text-cream focus:not-sr-only focus:fixed focus:left-3 focus:top-3"
    >
      Skip to content
    </a>
    <div class="lg:grid lg:min-h-screen lg:grid-cols-[256px_minmax(0,1fr)]">
      <aside class="hidden bg-charcoal text-cream lg:flex lg:flex-col" data-surface="dark">
        <div class="sticky top-0 flex max-h-screen flex-col overflow-y-auto">
          <div class="border-b border-white/10 px-5 py-5">
            <a href={siteUrl('web', '/')} class="block text-cream" aria-label="Gamo Studios home">
              <Logo width={132} height={24} />
            </a>
            <p class="mt-3 text-[12px] font-semibold uppercase tracking-[0.14em] text-gold">
              {workspace.program}
            </p>
            <p class="text-[13px] text-cream/70">{workspace.name}</p>
          </div>
          <div class="flex-1 px-3 py-5">
            <DashNav workspace={workspace} current={current} />
          </div>
          <div class="border-t border-white/10 px-5 py-4 text-[12px] text-cream/60">
            <p class="truncate">
              <span class="text-cream/90">Account:</span> {viewer.name}
            </p>
            <p>
              <span class="text-cream/90">Role:</span> {workspace.role}
            </p>
            {activeOrg && (
              <p class="truncate">
                <span class="text-cream/90">Organization:</span> {activeOrg}
              </p>
            )}
            <p>
              <span class="text-cream/90">Permission:</span> {workspace.permission}
            </p>
          </div>
        </div>
      </aside>

      <div class="min-w-0 pb-28 lg:pb-0">
        <header class="sticky top-0 z-30 border-b border-sand/70 bg-ivory/95 backdrop-blur-md">
          <div class="flex h-14 items-center gap-2 px-3 sm:px-5 lg:h-16 lg:px-8">
            <button
              type="button"
              class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-sand/80 bg-white text-charcoal shadow-2xs transition-colors hover:bg-cream lg:hidden"
              data-drawer-open
              aria-controls="dash-drawer"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-label="Open workspace menu"
            >
              <Icon name="menu" class="h-5 w-5" />
            </button>
            <a
              href={siteUrl('web', '/')}
              class="hidden text-charcoal sm:block lg:hidden"
              aria-label="Gamo Studios home"
            >
              <Logo width={104} height={20} />
            </a>
            <div class="min-w-0">
              <WorkspaceSwitcher currentId={workspace.id} />
            </div>
            <form role="search" class="ml-auto hidden max-w-sm flex-1 md:block" data-dash-search>
              <label class="relative block">
                <span class="sr-only">Search this workspace</span>
                <Icon
                  name="search"
                  class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-soft"
                />
                <input
                  type="search"
                  placeholder="Search this workspace"
                  class="h-10 w-full rounded-xl border border-ink/50 bg-white pl-9 pr-3 text-[14px] placeholder:text-ink-soft/70"
                  data-dash-search-input
                />
              </label>
            </form>
            <a
              href={notifHref}
              class="relative ml-auto grid h-10 w-10 shrink-0 place-items-center rounded-full border border-sand/80 bg-white transition-colors hover:bg-cream md:ml-0"
              aria-label="Notifications"
            >
              <Icon name="bell" class="h-5 w-5" />
              <span
                class="absolute right-2.5 top-2.5 h-2 w-2 rounded-full bg-terracotta"
                aria-hidden="true"
              ></span>
            </a>
            <AccountMenu viewer={viewer} staff={workspace.staff} />
          </div>
        </header>

        <main
          id="dash-main"
          tabindex="-1"
          class="mx-auto w-full max-w-[1320px] px-4 py-5 sm:px-6 lg:px-8 lg:py-8"
        >
          <slot />
        </main>
      </div>
    </div>

    <dialog
      id="dash-drawer"
      class="fixed inset-y-0 left-0 z-50 m-0 h-dvh max-h-none w-[min(21rem,88vw)] max-w-none flex-col rounded-r-3xl border-0 bg-charcoal p-0 text-cream shadow-2xl open:flex backdrop:bg-charcoal/55 backdrop:backdrop-blur-xs"
      data-surface="dark"
      aria-label={`${workspace.name} menu`}
    >
      <div class="flex items-center justify-between border-b border-white/10 px-4 py-3.5">
        <div>
          <a
            href={siteUrl('web', '/')}
            class="mb-1 inline-block text-cream/90 hover:text-cream"
            aria-label="Gamo Studios home"
          >
            <Logo width={108} height={20} />
          </a>
          <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold">
            {workspace.program} · {workspace.name}
          </p>
        </div>
        <button
          type="button"
          class="grid h-10 w-10 place-items-center rounded-full bg-white/5 text-cream/80 hover:bg-white/10 hover:text-cream"
          data-drawer-close
          aria-label="Close menu"
        >
          <Icon name="x" class="h-5 w-5" />
        </button>
      </div>

      <div class="border-b border-white/10 bg-white/5 px-4 py-3">
        <div class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-gold text-[12px] font-bold text-charcoal">
            {viewer.initials}
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-[13px] font-semibold text-cream">{viewer.name}</p>
            <p class="truncate text-[11px] text-cream/65">
              {workspace.role}
              {activeOrg ? ` · ${activeOrg}` : ''}
            </p>
          </div>
        </div>
      </div>

      <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 py-4">
        <DashNav workspace={workspace} current={current} />
      </div>

      <div class="border-t border-white/10 bg-white/5 p-3 text-[12px]">
        <div class="mb-2 grid grid-cols-2 gap-2">
          <a
            href={siteUrl('web', '/account/profile')}
            class="flex items-center gap-2 rounded-xl bg-white/5 px-3 py-2 text-[12px] font-medium text-cream hover:bg-white/10"
          >
            <Icon name="user" class="h-4 w-4 text-cream/60" />
            Profile
          </a>
          <a
            href={notifHref}
            class="flex items-center gap-2 rounded-xl bg-white/5 px-3 py-2 text-[12px] font-medium text-cream hover:bg-white/10"
          >
            <Icon name="bell" class="h-4 w-4 text-cream/60" />
            Alerts
          </a>
        </div>
        {viewer.authenticated ? (
          <a
            href={siteUrl('web', '/account/signed-out')}
            class="flex items-center justify-center gap-2 rounded-xl border border-white/15 px-3 py-2 text-[12px] font-medium text-cream/80 hover:bg-white/10 hover:text-cream"
          >
            <Icon name="logout" class="h-4 w-4 text-cream/60" />
            Sign out ({viewer.email})
          </a>
        ) : (
          <div class="grid grid-cols-2 gap-2">
            <a
              href={siteUrl('web', '/account/signin')}
              class="flex items-center justify-center rounded-xl bg-gold px-3 py-2 text-[12px] font-semibold text-charcoal hover:bg-gold/90"
            >
              Sign in
            </a>
            <a
              href={siteUrl('web', '/account/signup')}
              class="flex items-center justify-center rounded-xl border border-white/15 px-3 py-2 text-[12px] font-medium text-cream hover:bg-white/10"
            >
              Create account
            </a>
          </div>
        )}
      </div>
    </dialog>

    <nav
      aria-label="Quick navigation"
      data-surface="dark"
      class="fixed inset-x-3 bottom-3 z-40 mx-auto grid max-w-md grid-cols-5 items-center gap-1 rounded-[28px] bg-charcoal/95 p-1.5 text-cream shadow-float ring-1 ring-white/10 backdrop-blur-md lg:hidden"
    >
      {tabs.map((t) => {
        const active = t.slug === current;
        return (
          <a
            href={screenHref(workspace, t.slug)}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-[22px] px-1 py-1.5 text-[10px] font-semibold tracking-[-0.01em] transition-colors',
              active ? 'bg-gold text-charcoal shadow-xs' : 'text-cream/70 hover:bg-white/10 hover:text-cream',
            ]}
          >
            <Icon name={t.icon} class="h-[19px] w-[19px]" strokeWidth={active ? 2.1 : 1.8} />
            <span class="max-w-full truncate leading-tight">{shortNavLabel(t)}</span>
          </a>
        );
      })}
      <button
        type="button"
        data-drawer-open
        aria-controls="dash-drawer"
        aria-expanded="false"
        aria-haspopup="dialog"
        class:list={[
          'flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-[22px] px-1 py-1.5 text-[10px] font-semibold tracking-[-0.01em] transition-colors',
          isMoreActive ? 'bg-white/15 text-gold' : 'text-cream/70 hover:bg-white/10 hover:text-cream',
        ]}
      >
        <Icon name="grid" class="h-[19px] w-[19px]" strokeWidth={1.8} />
        <span class="leading-tight">More</span>
      </button>
    </nav>

    <script>
      import { initDashboard } from '../../lib/dashboard-client';
      initDashboard();
    </script>
  </body>
</html>

<style>
  /* Author display utilities must never reveal a closed native dialog. */
  #dash-drawer:not([open]) {
    display: none;
  }
  :global(html:has(#dash-drawer[open])) {
    overflow: hidden;
  }
</style>
