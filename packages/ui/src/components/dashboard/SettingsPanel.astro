---
/** Settings groups with accessible switches. Changes are never persisted. */
interface Props {
  groups: { title: string; toggles: { label: string; description?: string; on?: boolean }[] }[];
}
const { groups } = Astro.props;
---

<div data-settings class="space-y-6">
  {groups.map((g) => (
    <fieldset>
      <legend class="text-[14px] font-semibold">{g.title}</legend>
      <ul class="mt-2 divide-y divide-sand/70 rounded-xl border border-sand/80">
        {g.toggles.map((t) => (
          <li class="flex items-center justify-between gap-4 px-3.5 py-3" data-search-item>
            <div class="min-w-0">
              <p class="text-[14px] font-medium">{t.label}</p>
              {t.description && <p class="text-[12px] text-ink-soft">{t.description}</p>}
            </div>
            <button
              type="button"
              role="switch"
              aria-checked={t.on ? 'true' : 'false'}
              aria-label={t.label}
              class="switch relative h-6 w-11 shrink-0 rounded-full bg-sand transition-colors"
            >
              <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform" />
            </button>
          </li>
        ))}
      </ul>
    </fieldset>
  ))}
  <p data-settings-status aria-live="polite" class="text-[12px] text-ink-soft">
    Preferences are updated immediately for your account.
  </p>
</div>
<style>
  .switch[aria-checked='true'] {
    background: var(--color-terracotta);
  }
  .switch[aria-checked='true'] span {
    transform: translateX(1.25rem);
  }
</style>
