---
/** Activity / notification list with optional icon, badge and link. */
import Icon from '../Icon.astro';
import StatusPill from '../StatusPill.astro';
import type { BadgeValue } from '../../lib/dashboard';
import type { IconName } from '../../lib/icons';
interface Props { items: { title: string; meta?: string; body?: string; badge?: BadgeValue; href?: string; icon?: IconName }[] }
const { items } = Astro.props;
---
<ul class="-my-1 divide-y divide-sand/70">
  {items.map((it) => {
    const Tag = it.href ? 'a' : 'div';
    return (
      <li data-search-item>
        <Tag href={it.href} class:list={['flex gap-3 py-3', it.href && 'group rounded-lg hover:bg-ivory']}>
          {it.icon && <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-cream text-terracotta-dark"><Icon name={it.icon} class="h-4 w-4" strokeWidth={1.8} /></span>}
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <p class="break-words [overflow-wrap:anywhere] text-[14px] font-semibold group-hover:underline">{it.title}</p>
              {it.badge && <StatusPill kind={it.badge.tone ?? 'info'}>{it.badge.badge}</StatusPill>}
            </div>
            {it.body && <p class="mt-0.5 break-words [overflow-wrap:anywhere] text-[13px] text-charcoal/80">{it.body}</p>}
            {it.meta && <p class="mt-0.5 break-words [overflow-wrap:anywhere] text-[12px] text-ink-soft">{it.meta}</p>}
          </div>
          {it.href && <Icon name="chevron-right" class="mt-1 h-4 w-4 shrink-0 text-ink-soft" />}
        </Tag>
      </li>
    );
  })}
</ul>
