---
/** Workflow / review status steps (done · current · upcoming · blocked). */
import Icon from '../Icon.astro';
interface Props {
  items: { label: string; body?: string; state: 'done' | 'current' | 'upcoming' | 'blocked' }[];
}
const { items } = Astro.props;
const sr = {
  done: 'Completed',
  current: 'In progress',
  upcoming: 'Not started',
  blocked: 'Blocked — awaiting approval',
};
---

<ol class="space-y-0">
  {items.map((s, i) => (
    <li class="relative flex gap-3 pb-4 last:pb-0" data-search-item>
      {i < items.length - 1 && (
        <span class="absolute left-[13px] top-7 h-[calc(100%-1.5rem)] w-px bg-sand" aria-hidden="true" />
      )}
      <span
        class:list={[
          'relative grid h-7 w-7 shrink-0 place-items-center rounded-full text-[12px] font-semibold',
          s.state === 'done'
            ? 'bg-emerald-700 text-white'
            : s.state === 'current'
              ? 'bg-terracotta text-white'
              : s.state === 'blocked'
                ? 'bg-amber-100 text-amber-900 ring-1 ring-amber-300'
                : 'bg-white text-ink-soft ring-1 ring-sand',
        ]}
      >
        {s.state === 'done' ? (
          <Icon name="check" class="h-3.5 w-3.5" strokeWidth={2.5} />
        ) : s.state === 'blocked' ? (
          <Icon name="lock" class="h-3.5 w-3.5" strokeWidth={2} />
        ) : (
          i + 1
        )}
      </span>
      <div class="min-w-0 pt-0.5">
        <p class="text-[14px] font-semibold">
          {s.label} <span class="sr-only">({sr[s.state]})</span>
        </p>
        {s.body && <p class="mt-0.5 text-[13px] text-ink-soft">{s.body}</p>}
      </div>
    </li>
  ))}
</ol>
