---
/** Card surface with optional heading, description and header action. */
import Icon from '../Icon.astro';
import type { DashAction } from '../../lib/dashboard';
interface Props { title?: string; description?: string; action?: DashAction; class?: string; padded?: boolean; headingLevel?: 'h2' | 'h3' }
const { title, description, action, class: className, padded = true, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---
<section class:list={['min-w-0 rounded-[26px] border border-sand/80 bg-white shadow-[0_2px_10px_-2px_rgb(29_35_35/0.05)]', className]} data-search-item>
  {(title || action) && (
    <header class="flex flex-wrap items-center justify-between gap-2 border-b border-sand/60 px-4 py-3.5 sm:px-5">
      <div class="min-w-0">
        {title && <H class="text-[17px] font-bold leading-6 tracking-[-0.015em] sm:text-[19px]">{title}</H>}
        {description && <p class="mt-0.5 text-[12px] text-ink-soft sm:text-[13px]">{description}</p>}
      </div>
      {action && (action.exportReport
        ? <button type="button" data-export-report={action.exportReport} class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-ivory px-3 text-[12px] font-semibold text-terracotta-dark ring-1 ring-sand/80 hover:bg-cream sm:text-[13px]">{action.icon && <Icon name={action.icon} class="h-3.5 w-3.5" />}{action.label}</button>
        : action.dialog
          ? <button type="button" data-dialog-open={action.dialog} class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-ivory px-3 text-[12px] font-semibold text-terracotta-dark ring-1 ring-sand/80 hover:bg-cream sm:text-[13px]">{action.icon && <Icon name={action.icon} class="h-3.5 w-3.5" />}{action.label}</button>
          : <a href={action.href} class="inline-flex min-h-9 items-center gap-1 rounded-full bg-ivory px-3 text-[12px] font-semibold text-terracotta-dark ring-1 ring-sand/80 hover:bg-cream sm:text-[13px]">{action.label}<Icon name={action.icon ?? 'chevron-right'} class="h-3.5 w-3.5" /></a>)}
    </header>
  )}
  <div class:list={['@container', padded && 'p-3.5 sm:p-5']}><slot /></div>
</section>
