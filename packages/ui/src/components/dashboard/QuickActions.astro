---
/** Grid of shortcut actions (links or dialog triggers). */
import Icon from '../Icon.astro';
import type { DashAction } from '../../lib/dashboard';
interface Props { items: DashAction[] }
const { items } = Astro.props;
const cls = 'flex min-h-12 w-full items-center gap-3 rounded-xl border border-sand/80 bg-ivory px-3.5 py-2.5 text-left text-[14px] font-semibold hover:border-charcoal/30 hover:bg-white';
---
<ul class="grid gap-2 @lg:grid-cols-2">
  {items.map((a) => (
    <li data-search-item>
      {a.dialog
        ? <button type="button" data-dialog-open={a.dialog} class={cls}><Icon name={a.icon ?? 'plus'} class="h-[18px] w-[18px] text-terracotta-dark" strokeWidth={1.8} /><span class="flex-1">{a.label}</span></button>
        : <a href={a.href} class={cls}><Icon name={a.icon ?? 'arrow'} class="h-[18px] w-[18px] text-terracotta-dark" strokeWidth={1.8} /><span class="flex-1">{a.label}</span><Icon name="chevron-right" class="h-4 w-4 text-ink-soft" /></a>}
    </li>
  ))}
</ul>
