---
/** Upcoming schedule list with a compact date tile. */
import StatusPill from '../StatusPill.astro';
import type { BadgeValue } from '../../lib/dashboard';
interface Props {
  items: { date: string; time?: string; title: string; meta?: string; badge?: BadgeValue; href?: string }[];
}
const { items } = Astro.props;
const split = (d: string) => {
  const [a, ...b] = d.split(' ');
  return [a, b.join(' ')];
};
---

<ol class="space-y-2.5">
  {items.map((it, idx) => {
    const [mon, day] = split(it.date);
    const Tag = it.href ? 'a' : 'div';
    const featured = idx === 0;
    return (
      <li class="min-w-0" data-search-item>
        <Tag
          href={it.href}
          class:list={[
            'flex min-w-0 items-start gap-3 rounded-[20px] border border-sand/70 bg-ivory/85 p-3.5 transition-colors',
            it.href && 'hover:border-charcoal/30 hover:bg-white',
          ]}
        >
          <span
            class:list={[
              'grid w-12 shrink-0 rounded-2xl py-1.5 text-center shadow-2xs',
              featured ? 'bg-charcoal text-cream' : 'bg-white text-charcoal ring-1 ring-sand',
            ]}
            aria-hidden="true"
          >
            <span
              class:list={[
                'text-[10px] font-bold uppercase tracking-[0.08em]',
                featured ? 'text-gold' : 'text-terracotta-dark',
              ]}
            >
              {mon}
            </span>
            <span class="text-[18px] font-bold leading-6">{day}</span>
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
              <p class="text-[14px] font-bold leading-5 text-charcoal">
                <span class="sr-only">{it.date}: </span>
                {it.title}
              </p>
              {it.badge && (
                <StatusPill kind={it.badge.tone ?? 'info'} class="shrink-0">
                  {it.badge.badge}
                </StatusPill>
              )}
            </div>
            <p class="mt-1 text-[12px] leading-4 text-ink-soft">
              {[it.time, it.meta].filter(Boolean).join(' · ')}
            </p>
          </div>
        </Tag>
      </li>
    );
  })}
</ol>
