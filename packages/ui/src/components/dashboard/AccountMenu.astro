---
/** Account menu: active user or demo persona summary, account links, and sign-in/sign-out controls. */
import Icon from '../Icon.astro';
import { DEMO_PERSONA, type ViewerPersona } from '../../lib/dashboard';
import { siteUrl } from '../../lib/sites';
interface Props { viewer?: ViewerPersona }
const { viewer = DEMO_PERSONA } = Astro.props;
const isAuth = Boolean(viewer?.authenticated);
const links: [string, string, 'user' | 'settings' | 'bell' | 'users' | 'logout'][] = [
  ['Profile', siteUrl('web', '/account/profile'), 'user'],
  ['Roles & organizations', siteUrl('web', '/account/roles'), 'users'],
  ['Notifications', siteUrl('web', '/account/notifications'), 'bell'],
  ['Account settings', siteUrl('web', '/account/settings'), 'settings'],
];
---
<details class="dash-menu relative" data-dash-menu>
  <summary class="flex h-10 cursor-pointer list-none items-center gap-2 rounded-full pl-1 pr-2 hover:bg-white [&::-webkit-details-marker]:hidden">
    <span class:list={['grid h-8 w-8 place-items-center rounded-full text-[12px] font-semibold', isAuth ? 'bg-terracotta text-white' : 'bg-charcoal text-cream']} aria-hidden="true">{viewer.initials}</span>
    <Icon name="chevron-down" class="hidden h-4 w-4 text-ink-soft sm:block" />
    <span class="sr-only">Account menu for {viewer.name}{isAuth ? '' : ' (demo)'}</span>
  </summary>
  <div class="absolute right-0 z-50 mt-2 w-68 rounded-xl border border-sand bg-white p-2 shadow-xl">
    <div class="px-2 py-2">
      <p class="text-[14px] font-semibold">{viewer.name}</p>
      <p class="truncate text-[12px] text-ink-soft">{viewer.email}</p>
      {viewer.organization && <p class="mt-0.5 truncate text-[11px] font-medium text-charcoal/80">{viewer.organization}</p>}
      <p class:list={['mt-1.5 inline-block rounded px-1.5 py-0.5 text-[11px] font-semibold', isAuth ? 'bg-[#E6F2EA] text-[#1F5A37]' : 'bg-gold/30 text-[#5C3A20]']}>{viewer.note}</p>
    </div>
    {!isAuth && (
      <div class="mb-1 grid grid-cols-2 gap-1.5 border-t border-sand/70 px-1 pt-2">
        <a href={siteUrl('web', '/account/signin')} class="flex items-center justify-center rounded-lg bg-charcoal px-2.5 py-1.5 text-[12px] font-semibold text-cream hover:bg-charcoal/90">Sign in</a>
        <a href={siteUrl('web', '/account/signup')} class="flex items-center justify-center rounded-lg bg-terracotta px-2.5 py-1.5 text-[12px] font-semibold text-white hover:bg-terracotta-dark">Create account</a>
      </div>
    )}
    <ul class="border-t border-sand/70 pt-1">
      {links.map(([label, href, icon]) => <li><a href={href} class="flex items-center gap-2.5 rounded-lg px-2 py-2 text-[13px] hover:bg-cream"><Icon name={icon} class="h-4 w-4 text-ink-soft" />{label}</a></li>)}
      <li class="mt-1 border-t border-sand/70 pt-1">
        <a href={siteUrl('web', '/account/signed-out')} class="flex items-center gap-2.5 rounded-lg px-2 py-2 text-[13px] hover:bg-cream">
          <Icon name="logout" class="h-4 w-4 text-ink-soft" />{isAuth ? 'Sign out of account' : 'Exit demo (sign-out preview)'}
        </a>
      </li>
    </ul>
  </div>
</details>
