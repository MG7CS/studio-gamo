---
/**
 * ClaimAccountPrompt — "Create a <Product> account with this email" on a customer's manage page (design
 * §4.2). Drop it into a ticket-order or registration manage page (behind the customer session). Props:
 * - program: 'Gamo Live' | 'Gamo Academy' — the product whose sign-up it links to (same host as the page).
 * - what?: 'tickets' | 'registration' — wording and the `?claim=` value.
 * - emailHint?: string — masked address shown to the customer (never the full address).
 * The sign-up link carries `?claim=` only to change the wording; the account attaches to the customer
 * record when that email is verified with an emailed code (no automatic access is granted).
 */
interface Props {
  program: string;
  what?: 'tickets' | 'registration';
  emailHint?: string;
}
const { program, what = 'registration', emailHint } = Astro.props;
---

<aside class="rounded-2xl bg-cream p-5 ring-1 ring-ink/10" aria-labelledby="claim-account-title">
  <h2 id="claim-account-title" class="text-lg font-bold text-ink">Create a {program} account (optional)</h2>
  <p class="mt-2 text-[15px] text-ink">
    You don't need an account to use your {what === 'tickets' ? 'tickets' : 'registration'}. If you create one with
    {emailHint ? <strong>{emailHint}</strong> : ' the same email'} and confirm it with an emailed code, your
    {what === 'tickets' ? ' orders' : ' registrations'} appear in your account.
  </p>
  <a
    href={`/account/signup?claim=${what}`}
    class="mt-3 inline-flex min-h-11 items-center rounded-full bg-ink px-6 text-sm font-semibold text-cream"
  >
    Create a {program} account
  </a>
</aside>
