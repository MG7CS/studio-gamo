---
/**
 * Account page sections added by the identity work (data: `loadAccountExtras()` from `@gamo/domain`):
 *
 * - Provider profiles of this person (links to /account/profile).
 * - "Also on Gamo …": the other products that share this person (names only) + "Unlink this product".
 * - Purchases and registrations made as a guest with this verified email (read-only; each is managed on
 *   its product's site through the emailed link).
 */
import AccountNotice from './AccountNotice.astro';

interface Props {
  program: string;
  extras: {
    notice: { tone: 'success' | 'error' | 'info'; text: string } | null;
    person: {
      linked: boolean;
      optedOut: boolean;
      otherProducts: { name: string; sharesSignInRecord: boolean }[];
    };
    customerRecords: {
      id: string;
      kind: string;
      title: string;
      reference: string | null;
      status: string;
      createdAt: number;
      manageHref: string;
      product: string;
    }[];
    providerProfiles: { role: string; label: string; statusLabel: string; href: string }[];
    signupRoles: { value: string; label: string }[];
  };
}
const { program, extras } = Astro.props;
const formatDate = (s: number) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(s * 1000));
const shared = extras.person.otherProducts.filter((p) => p.sharesSignInRecord).map((p) => p.name);
---

<div class="mt-10 space-y-10">
  <AccountNotice notice={extras.notice} />

  <section class="border-t border-sand pt-8" aria-labelledby="provider-profiles-title">
    <h2 id="provider-profiles-title" class="text-xl font-bold text-ink">
      Provider profiles
    </h2>
    {extras.providerProfiles.length ? (
      <ul class="mt-4 divide-y divide-sand">
        {extras.providerProfiles.map((p) => (
          <li class="flex flex-wrap items-center justify-between gap-2 py-3 text-[15px]">
            <span class="font-semibold text-ink">{p.label}</span>
            <span class="text-ink">{p.statusLabel}</span>
            {p.href && (
              <a
                href={p.href}
                class="inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline"
              >
                View
              </a>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-2 text-[15px] text-ink">No provider profile yet.</p>
    )}
    {extras.signupRoles.length > 0 && (
      <a
        href="/account/onboarding"
        class="mt-3 inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline"
      >
        Set up a {extras.signupRoles.map((r) => r.label.toLowerCase()).join(', ')} profile
      </a>
    )}
  </section>

  <section id="person-links" class="border-t border-sand pt-8" aria-labelledby="person-links-title">
    <h2 id="person-links-title" class="text-xl font-bold text-ink">
      Your Gamo person record
    </h2>
    {extras.person.linked ? (
      <>
        <p class="mt-2 text-[15px] text-ink">
          Your verified email links this {program} account to your shared Gamo person record, so your provider
          profiles and accepted terms carry across Gamo products. It never signs you in elsewhere or gives
          access to another product.
        </p>
        {extras.person.otherProducts.length > 0 ? (
          <p class="mt-3 text-[15px] text-ink">
            Also on {extras.person.otherProducts.map((p) => p.name).join(', ')}.
          </p>
        ) : (
          <p class="mt-3 text-[15px] text-ink">No other Gamo product shares this record yet.</p>
        )}
        <form method="post" action="/api/account/person-link" class="mt-4">
          <input type="hidden" name="action" value="unlink" />
          <button
            type="submit"
            class="inline-flex min-h-11 items-center rounded-full border border-ink/40 bg-white px-5 text-sm font-semibold text-ink"
          >
            Unlink this product
          </button>
          {shared.length > 0 && (
            <p class="mt-2 text-sm text-muted">
              Your {shared.join(', ')} account uses the same sign-in record, so it is unlinked too.
            </p>
          )}
        </form>
      </>
    ) : (
      <>
        <p class="mt-2 text-[15px] text-ink">
          {extras.person.optedOut
            ? `You unlinked ${program} from your shared Gamo person record. It stays unlinked until you link it again.`
            : `This ${program} account is not linked to a shared Gamo person record yet.`}
        </p>
        <form method="post" action="/api/account/person-link" class="mt-4">
          <input type="hidden" name="action" value="link" />
          <button
            type="submit"
            class="inline-flex min-h-11 items-center rounded-full bg-ink px-5 text-sm font-semibold text-cream"
          >
            Link this product
          </button>
        </form>
      </>
    )}
  </section>

  <section class="border-t border-sand pt-8" aria-labelledby="customer-records-title">
    <h2 id="customer-records-title" class="text-xl font-bold text-ink">
      Tickets and registrations
    </h2>
    <p class="mt-2 text-[15px] text-ink">
      Tickets and Academy registrations you made as a guest with this verified email. Each one is managed on
      its own site through the link we email you.
    </p>
    {extras.customerRecords.length ? (
      <ul class="mt-4 divide-y divide-sand">
        {extras.customerRecords.map((r) => (
          <li class="flex flex-wrap items-center justify-between gap-2 py-3 text-[15px]">
            <span class="min-w-0">
              <span class="block font-semibold capitalize text-ink">{r.title}</span>
              <span class="block text-sm text-muted">
                {r.kind === 'ticket_order' ? 'Gamo Live order' : 'Gamo Academy registration'}
                {r.reference ? ` · ${r.reference}` : ''} · {r.status.replace(/_/g, ' ')} ·{' '}
                {formatDate(r.createdAt)}
              </span>
            </span>
            <a
              href={r.manageHref}
              class="inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline"
            >
              Get a manage link
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-3 text-[15px] text-muted">Nothing yet.</p>
    )}
  </section>
</div>
