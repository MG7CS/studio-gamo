---
/**
 * Shared `/account/sso-callback` screen: finishes "Continue with Google" for THIS product's own Clerk
 * application, then exchanges the Clerk session for a Gamo session (`/api/auth/clerk-session`). Without
 * Clerk configured for the product it says so and points to the emailed code.
 */
interface Props {
  program: string;
}
const { program } = Astro.props;
const clerkConfig = Astro.locals.clerkConfig;
const key = clerkConfig?.isConfigured ? (clerkConfig.publishableKey ?? '') : '';
---

<section
  class="mx-auto w-full max-w-xl px-5 pb-20 pt-32"
  aria-labelledby="sso-title"
  data-sso-callback
  data-clerk-publishable-key={key || undefined}
>
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-terracotta-deep">{program}</p>
  <h1 id="sso-title" class="mt-2 text-3xl font-black uppercase tracking-tight text-ink">
    Finishing sign-in
  </h1>
  <p data-sso-status role="status" aria-live="polite" class="mt-5 text-[15px] text-ink">
    {key ? 'Connecting your Google sign-in…' : 'Google sign-in is not available for this site.'}
  </p>
  <noscript>
    <p class="mt-4 text-[15px] text-ink">
      Google sign-in needs JavaScript. You can sign in with an emailed code instead.
    </p>
  </noscript>
  <p data-sso-help class="mt-6" hidden={Boolean(key)}>
    <a
      href="/account/signin"
      class="inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline underline-offset-4"
    >
      Sign in with an emailed code
    </a>
  </p>
</section>

<script>
  import { initSsoCallback } from '../../lib/auth-flow-client';
  initSsoCallback();
</script>
