---
/** Outcome message after a form post (from the redirect's query string). Announced politely. */
interface Props {
  notice: { tone: 'success' | 'error' | 'info'; text: string } | null | undefined;
}
const { notice } = Astro.props;
---

{notice && (
  <p
    role={notice.tone === 'error' ? 'alert' : 'status'}
    class:list={[
      'rounded-xl px-4 py-3 text-[15px] font-medium',
      notice.tone === 'error'
        ? 'bg-white text-terracotta-deep ring-2 ring-terracotta-deep'
        : 'bg-white text-ink ring-1 ring-ink/20',
    ]}
  >
    {notice.tone === 'error' ? (
      <span class="sr-only">Error: </span>
    ) : (
      notice.tone === 'success' && <span aria-hidden="true">✓ </span>
    )}
    {notice.text}
  </p>
)}
