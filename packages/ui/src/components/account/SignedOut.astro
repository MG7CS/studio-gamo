---
/**
 * Shared sign-out screen (`/account/signed-out`) for every product. Signing out ends this product's Clerk
 * session first (when the product uses Clerk) and then the Gamo session; it never touches another product.
 * Without JavaScript the page explains how to sign out (the API needs a same-origin DELETE).
 */
interface Props {
  program: string;
}
const { program } = Astro.props;
const clerkConfig = Astro.locals.clerkConfig;
const clerkPublishableKey = clerkConfig?.isConfigured ? (clerkConfig.publishableKey ?? '') : '';
const signedIn = Boolean(Astro.locals.auth);
---

<section class="mx-auto w-full max-w-xl px-5 pb-20 pt-32" aria-labelledby="signed-out-title" data-signed-out>
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-terracotta-deep">{program}</p>
  <h1 id="signed-out-title" class="mt-2 text-3xl font-black uppercase tracking-tight text-ink">
    {signedIn ? `Sign out of ${program}` : `You're signed out of ${program}`}
  </h1>
  <p class="mt-5 text-[15px] leading-relaxed text-ink">
    {signedIn
      ? `This ends your ${program} session on this device. Other Gamo products keep their own sessions.`
      : `Your ${program} session on this device has ended.`}
  </p>
  {signedIn && (
    <button
      type="button"
      data-signout
      data-clerk-publishable-key={clerkPublishableKey || undefined}
      class="mt-7 inline-flex min-h-11 items-center rounded-full bg-terracotta-deep px-6 text-sm font-semibold text-white"
    >
      Sign out
    </button>
  )}
  <p data-signout-status role="status" aria-live="polite" class="mt-5 text-[15px] text-ink"></p>
  <noscript>
    <p class="mt-4 text-[15px] text-ink">
      Signing out needs JavaScript. Close the browser to end the session.
    </p>
  </noscript>
  <div class="mt-6 flex flex-wrap gap-4">
    <a
      href="/account/signin"
      class="inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline underline-offset-4"
    >
      Sign in again
    </a>
    <a href="/" class="inline-flex min-h-11 items-center font-semibold text-ink underline underline-offset-4">
      {program} home
    </a>
  </div>
</section>

<script>
  import { signOutOfClerk } from '../../lib/clerk-browser.ts';
  document.querySelector<HTMLButtonElement>('[data-signout]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const status = document.querySelector<HTMLElement>('[data-signout-status]')!;
    button.disabled = true;
    status.textContent = 'Signing out…';
    try {
      await signOutOfClerk(button.dataset.clerkPublishableKey).catch(() => undefined);
      const response = await fetch('/api/auth/session', { method: 'DELETE' });
      if (!response.ok) throw new Error();
      status.textContent = 'You are signed out on this device.';
      button.hidden = true;
    } catch {
      status.textContent = 'We could not confirm sign-out. Please try again.';
      button.disabled = false;
    }
  });
</script>
