---
/**
 * Shared "access denied" screen for every product (`/account/access-denied`). Explains, without naming
 * other products' accounts, that workspaces open by role and verification — never by signing up alone —
 * and what to do next. The page sets HTTP 403.
 */
interface Props {
  program: string;
  /** Optional reason from `?reason=` (e.g. 'church-verification'). */
  reason?: string | null;
}
const { program, reason } = Astro.props;
const signedIn = Boolean(Astro.locals.auth);
const reasons: Record<string, string> = {
  'church-verification':
    'The church workspace opens after Gamo staff verify your church in person. Finish your church profile and submit it for verification from your account.',
  staff: 'This area is for Gamo staff. Staff roles are given by Gamo administrators, never by signing up.',
};
const explanation =
  (reason && reasons[reason]) ||
  `This part of ${program} needs a role or a verification your account does not have yet. Creating an account never grants staff, church administrator or approved musician access by itself, and an account in another Gamo product does not open ${program}.`;
---

<section class="mx-auto w-full max-w-xl px-5 pb-20 pt-32" aria-labelledby="access-denied-title">
  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-terracotta-deep">{program}</p>
  <h1 id="access-denied-title" class="mt-2 text-3xl font-black uppercase tracking-tight text-ink">
    This area needs access you don't have yet
  </h1>
  <p class="mt-5 text-[15px] leading-relaxed text-ink">{explanation}</p>
  <h2 class="mt-8 text-lg font-bold text-ink">What you can do</h2>
  <ul class="mt-3 list-disc space-y-2 pl-5 text-[15px] text-ink">
    {signedIn ? (
      <li>
        Open{' '}
        <a href="/account/profile" class="font-semibold text-terracotta-deep underline">
          your profile
        </a>{' '}
        to see which steps are missing and how to finish them.
      </li>
    ) : (
      <li>
        <a href="/account/signin" class="font-semibold text-terracotta-deep underline">
          Sign in
        </a>{' '}
        with the account that has access.
      </li>
    )}
    <li>
      New to {program}?{' '}
      <a href="/account/signup" class="font-semibold text-terracotta-deep underline">
        Create an account
      </a>
      and choose your role.
    </li>
    <li>
      Think this is a mistake? Write to{' '}
      <a href="mailto:hello@gamostudio.org" class="font-semibold text-terracotta-deep underline">
        hello@gamostudio.org
      </a>
      .
    </li>
  </ul>
  <div class="mt-8 flex flex-wrap gap-4">
    <a
      href={signedIn ? '/account' : '/'}
      class="inline-flex min-h-11 items-center rounded-full bg-ink px-6 text-sm font-semibold text-cream"
    >
      {signedIn ? 'Back to your account' : `Back to ${program}`}
    </a>
  </div>
</section>
