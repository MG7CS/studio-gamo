---
/**
 * SubmitButton — a plain submit button (works without JS). With JS it disables itself after the form is
 * submitted and shows `pendingLabel`, and re-enables on `pageshow` (back/forward cache) or when the form
 * dispatches a `gamo:form-error` event.
 *
 * Props
 * - label: string — e.g. 'Reserve my spot'.
 * - pendingLabel?: string (default 'Sending…').
 * - variant?: 'primary' | 'secondary' (default 'primary').
 * - name?: string; value?: string — sent with the form (still sent: the button disables after submission starts).
 * - id?: string; fullWidth?: boolean (default false; full width below 640 px either way); class?: string.
 */
interface Props {
  label: string;
  pendingLabel?: string;
  variant?: 'primary' | 'secondary';
  name?: string;
  value?: string;
  id?: string;
  fullWidth?: boolean;
  class?: string;
}

const {
  label,
  pendingLabel = 'Sending…',
  variant = 'primary',
  name,
  value,
  id,
  fullWidth = false,
  class: className,
} = Astro.props;
---

<button
  type="submit"
  id={id}
  name={name}
  value={value}
  data-submit-button
  data-pending-label={pendingLabel}
  class:list={[
    'inline-flex min-h-11 w-full items-center justify-center rounded-full px-7 py-2.5 text-base font-semibold transition-colors sm:w-auto',
    'focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2 focus-visible:outline-none',
    'disabled:cursor-progress aria-disabled:cursor-progress',
    variant === 'primary'
      ? 'bg-terracotta text-white hover:bg-terracotta-deep disabled:bg-terracotta-deep'
      : 'border border-ink/50 bg-white text-ink hover:bg-sand',
    fullWidth && 'sm:w-full',
    className,
  ]}
>
  <span data-label aria-live="polite">
    {label}
  </span>
</button>

<script>
  import { initForms } from '../../lib/forms-client';
  initForms();
</script>
