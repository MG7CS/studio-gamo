---
/**
 * ConfirmEmailField — "Confirm email" for EmailField. Paste is allowed; the comparison is trimmed and
 * case-insensitive (`emailsMatch` in `lib/email-typo`, use the same on the server). With JS a mismatch
 * shows inline and blocks submission; without JS the server compares and passes `error`.
 *
 * Props
 * - emailId?: string — id of the EmailField to compare with (default 'email').
 * - id?: string (default 'email-confirm'); name?: string (default 'email_confirm').
 * - label?: string (default 'Confirm email'); value?: string; error?: string; required?: boolean (default true).
 * - hint?: string; class?: string.
 */
import TextField from './TextField.astro';

interface Props {
  emailId?: string;
  id?: string;
  name?: string;
  label?: string;
  value?: string;
  hint?: string;
  error?: string;
  required?: boolean;
  class?: string;
}

const {
  emailId = 'email',
  id = 'email-confirm',
  name = 'email_confirm',
  label = 'Confirm email',
  value,
  hint,
  error,
  required = true,
  class: className,
} = Astro.props;
---

<TextField
  id={id}
  name={name}
  label={label}
  type="email"
  value={value}
  hint={hint}
  error={error}
  required={required}
  autocomplete="email"
  inputmode="email"
  autocapitalize="off"
  spellcheck={false}
  maxlength={320}
  data={{ confirmEmailOf: emailId }}
  class={className}
/>

<script>
  import { initForms } from '../../lib/forms-client';
  initForms();
</script>
