---
/**
 * MarketingConsent — a separate, optional, **never pre-ticked** opt-in for occasional news. Record it with
 * `recordMarketingConsent` only when ticked (an unticked box is not a withdrawal of an earlier choice).
 *
 * Props
 * - label: string — the opt-in wording, supplied by the app (keep it neutral; no guilt or pressure).
 * - hint?: string — helper line (default 'Optional. You can unsubscribe at any time.').
 * - id?: string (default 'marketing-opt-in'); name?: string (default 'marketing_opt_in'; value 'yes').
 * - class?: string.
 *
 * There is intentionally no `checked` prop. The whole row is the `<label>` (≥ 44 px, as in ChoiceItem);
 * the hint sits under it, aligned with the label text.
 */
interface Props {
  label: string;
  hint?: string;
  id?: string;
  name?: string;
  class?: string;
}

const {
  label,
  hint = 'Optional. You can unsubscribe at any time.',
  id = 'marketing-opt-in',
  name = 'marketing_opt_in',
  class: className,
} = Astro.props;
const hintId = `${id}-hint`;
---

<div class:list={['gamo-choice', className]}>
  <label for={id} class="flex min-h-11 cursor-pointer items-start gap-3 py-2.5 text-body-sm text-fg">
    <input
      id={id}
      name={name}
      type="checkbox"
      value="yes"
      aria-describedby={hintId}
      class="mt-0.5 size-6 shrink-0 accent-action"
    />
    <span>{label}</span>
  </label>
  <p id={hintId} class="-mt-1.5 ps-9 pb-1 text-small text-fg-muted">
    {hint}
  </p>
</div>
