---
/**
 * MarketingConsent — a separate, optional, **never pre-ticked** opt-in for occasional news. Record it with
 * `recordMarketingConsent` only when ticked (an unticked box is not a withdrawal of an earlier choice).
 *
 * Props
 * - product: 'web' | 'worship' | 'academy' | 'live' | 'production' — picks the neutral default wording.
 * - id?: string (default 'marketing-opt-in'); name?: string (default 'marketing_opt_in'; value 'yes').
 * - label?: string — override the wording (keep it neutral; no guilt or pressure).
 * - class?: string.
 *
 * There is intentionally no `checked` prop.
 */
type ProductKey = 'web' | 'worship' | 'academy' | 'live' | 'production';

interface Props {
  product: ProductKey;
  id?: string;
  name?: string;
  label?: string;
  class?: string;
}

const DEFAULT_LABELS: Record<ProductKey, string> = {
  web: 'Send me occasional news from Gamo Studios',
  worship: 'Send me occasional news from Gamo Worship',
  academy: 'Send me occasional news about Gamo Academy lessons and programs',
  live: 'Send me occasional news about Gamo Live events',
  production: 'Send me occasional news from Gamo Production',
};

const { product, id = 'marketing-opt-in', name = 'marketing_opt_in', label, class: className } = Astro.props;
const hintId = `${id}-hint`;
---

<div class:list={['flex min-h-11 items-start gap-3', className]}>
  <input
    id={id}
    name={name}
    type="checkbox"
    value="yes"
    aria-describedby={hintId}
    class="mt-0.5 h-6 w-6 shrink-0 rounded border-ink/60 accent-terracotta focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2 focus-visible:outline-none"
  />
  <div>
    <label for={id} class="text-[15px] leading-6 text-ink">
      {label ?? DEFAULT_LABELS[product]}
    </label>
    <p id={hintId} class="text-sm text-muted">
      Optional. You can unsubscribe at any time.
    </p>
  </div>
</div>
