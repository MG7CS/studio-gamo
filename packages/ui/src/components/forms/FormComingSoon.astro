---
/**
 * FormComingSoon — interim page body for a public form that has no online form yet (no page uses it today;
 * the catalog keeps one sample). Owns the page's single `<h1>` by default (`titleAs`); offers email as the way to reach the team meanwhile.
 *
 * Props
 * - eyebrow: string — small line above the title (program and audience).
 * - title: string — the heading text.
 * - titleAs?: 'h1' | 'h2' — heading level (default 'h1': the page's single `<h1>`). Use 'h2' when the
 *   page already has an `<h1>` (e.g. a catalog or a page showing it below another hero).
 * - intro: string — what the form will ask and what happens next.
 * - email: string — contact address (from the app; the shared kit names no address).
 * - subject?: string — mailto subject (defaults to `title`).
 * - ctaLabel?: string — button text (default 'Email us').
 * - class?: string.
 */
import ButtonLink from '../ButtonLink.astro';

interface Props {
  eyebrow: string;
  title: string;
  titleAs?: 'h1' | 'h2';
  intro: string;
  email: string;
  subject?: string;
  ctaLabel?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  titleAs: TitleTag = 'h1',
  intro,
  email,
  subject = title,
  ctaLabel = 'Email us',
  class: className,
} = Astro.props;
const href = `mailto:${email}?subject=${encodeURIComponent(subject)}`;
const titleId = TitleTag === 'h1' ? 'form-coming-soon-title' : 'form-coming-soon-title-h2';
---

<section class:list={['page-intro-space bg-surface text-fg', className]} aria-labelledby={titleId}>
  <div class="gutter-x mx-auto max-w-prose box-content pb-10">
    <p class="eyebrow text-action-strong">{eyebrow}</p>
    <TitleTag id={titleId} class="display-lg mt-4 text-balance">
      {title}
    </TitleTag>
    <p class="mt-5 text-base leading-relaxed text-fg-muted md:text-lg">{intro}</p>
    <p class="mt-5 text-base leading-relaxed text-fg-muted md:text-lg">
      Our online form is coming soon. In the meantime, email us at
      <a href={href} class="inline-flex min-h-11 items-center font-semibold text-action-strong underline">
        {email}
      </a>
      .
    </p>
    <ButtonLink href={href} class="mt-8" arrow>
      {ctaLabel}
    </ButtonLink>
  </div>
</section>
