---
/**
 * DateField — native date input ("Date" questions). Values are `YYYY-MM-DD`.
 *
 * Props
 * - id: string; name: string; label: string — as TextField (hint/error ids `${id}-hint` / `${id}-error`).
 * - value?: string — e.g. '2026-12-24' (preserved after a failed submit).
 * - min?: string; max?: string; step?: number — native constraints (state them in `hint` too).
 * - hint?: string; error?: string; required?: boolean (default false).
 * - autocomplete?: string — e.g. 'bday' (rare; we don't collect dates of birth).
 * - disabled?: boolean; readonly?: boolean.
 * - class?: string — wrapper classes.
 */
import FieldShell from './FieldShell.astro';
import { CONTROL_CLASS, fieldIds } from './field';

interface Props {
  id: string;
  name: string;
  label: string;
  value?: string;
  min?: string;
  max?: string;
  step?: number;
  hint?: string;
  error?: string;
  required?: boolean;
  autocomplete?: string;
  disabled?: boolean;
  readonly?: boolean;
  class?: string;
}

const {
  id,
  name,
  label,
  value,
  min,
  max,
  step,
  hint,
  error,
  required = false,
  autocomplete,
  disabled = false,
  readonly = false,
  class: className,
} = Astro.props;
const ids = fieldIds(id, Boolean(hint));
---

<FieldShell id={id} label={label} hint={hint} error={error} required={required} class={className}>
  <input
    id={id}
    name={name}
    type="date"
    value={value}
    min={min}
    max={max}
    step={step}
    required={required}
    autocomplete={autocomplete}
    disabled={disabled}
    readonly={readonly}
    aria-describedby={ids.describedBy}
    aria-invalid={error ? 'true' : undefined}
    data-server-error={error ? 'true' : undefined}
    class:list={[CONTROL_CLASS, 'sm:max-w-xs']}
  />
</FieldShell>
