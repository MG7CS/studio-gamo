---
/**
 * TermsConsent — the required "I agree to the … and …" checkbox, plus hidden inputs naming exactly which
 * documents and versions were shown (`terms_slug` / `terms_version`, one pair per document, in order), so
 * the server can record them with `recordTermsAcceptance` and refuse a stale page.
 *
 * Props
 * - documents: { slug: string; label: string; href: string; version: string }[] — build with
 *   `termsConsentDocuments()` from `lib/terms-links` (links go to gamostudio.org/legal/<slug>).
 * - id?: string (default 'terms-accept'); name?: string (default 'terms_accept'; value 'yes').
 * - error?: string — server-rendered "Please agree to the terms to continue."
 * - newTab?: boolean — open the documents in a new tab (default false: same tab).
 * - required?: boolean — native `required` (default true). Pass false only when the server decides
 *   whether the box is needed (e.g. guardian consent only for a student under 18).
 * - class?: string.
 *
 * Never pre-checked (there is no `checked` prop). The whole row is the `<label>` (≥ 44 px, as in
 * ChoiceItem), so the 24 px box is never the only target; the document links inside it still work.
 */
import FieldError from './FieldError.astro';
import RequiredMark from './RequiredMark.astro';
import type { TermsConsentDocument } from '../../lib/terms-links';

interface Props {
  documents: TermsConsentDocument[];
  id?: string;
  name?: string;
  error?: string;
  newTab?: boolean;
  required?: boolean;
  class?: string;
}

const {
  documents,
  id = 'terms-accept',
  name = 'terms_accept',
  error,
  newTab = false,
  required = true,
  class: className,
} = Astro.props;
const errorId = `${id}-error`;
const joiner = (i: number) => (i === 0 ? '' : i === documents.length - 1 ? ' and ' : ', ');
---

<div class:list={['gamo-field', className]}>
  {documents.map((doc) => (
    <>
      <input type="hidden" name="terms_slug" value={doc.slug} />
      <input type="hidden" name="terms_version" value={doc.version} />
    </>
  ))}
  <label for={id} class="flex min-h-11 cursor-pointer items-start gap-3 py-2.5 text-body-sm text-fg">
    <input
      id={id}
      name={name}
      type="checkbox"
      value="yes"
      required={required}
      aria-describedby={errorId}
      aria-invalid={error ? 'true' : undefined}
      data-server-error={error ? 'true' : undefined}
      class="mt-0.5 size-6 shrink-0 accent-action aria-invalid:outline-2 aria-invalid:outline-danger"
    />
    <span>
      I agree to the{' '}
      {documents.map((doc, i) => (
        <>
          {joiner(i)}
          <a
            href={doc.href}
            target={newTab ? '_blank' : undefined}
            rel={newTab ? 'noopener' : undefined}
            class="font-semibold text-action-strong underline underline-offset-4 hover:text-fg"
          >
            {doc.label}
            {newTab && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        </>
      ))}
      .{required && <RequiredMark />}
    </span>
  </label>
  <FieldError id={errorId} error={error} />
</div>
