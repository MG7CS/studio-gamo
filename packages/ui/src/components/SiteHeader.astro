---
/**
 * Pill navigation shared by every public app. App-neutral: brand, nav items and the call to
 * action come from the app's `ShellConfig` (`src/site.config.ts`).
 * On scroll the bar compacts into a floating pill with stronger contrast.
 * Local UI state only (mobile menu); public visitors have no accounts.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { ShellConfig } from '../shell/types';

interface Props {
  shell: ShellConfig;
  /** Key of the active nav item. */
  current?: string;
  /** Accepted for backwards compatibility; header styling is unified across all pages. */
  theme?: 'light' | 'dark';
}
const { shell, current } = Astro.props;
const { brand, nav: items, cta } = shell;
const homeLabel = `${brand.programLabel ? `${brand.name} ${brand.programLabel}` : brand.name} home`;
---

<a
  href="#main-content"
  class="sr-only z-[60] rounded-full bg-charcoal px-5 text-sm font-semibold text-cream focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center"
>
  Skip to content
</a>
<header
  id="site-header"
  data-theme="light"
  class="site-header fixed inset-x-0 top-3 z-50 mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] text-charcoal transition-[top] duration-300 sm:top-4 sm:w-[calc(100%-2.5rem)]"
>
  <div class="site-header__bar flex h-14 items-center justify-between gap-3 rounded-full border border-sand bg-ivory/96 py-1.5 pl-5 pr-1.5 shadow-[0_14px_38px_-12px_rgba(20,26,27,0.28)] ring-1 ring-charcoal/8 backdrop-blur-xl transition-[background-color,box-shadow,border-color,height] duration-300 lg:h-16 lg:pl-6">
    <a
      href={brand.href}
      class="flex min-h-11 shrink-0 items-center gap-2.5 rounded-full"
      aria-label={homeLabel}
    >
      <Logo width="138" height="26" />
      {brand.programLabel && (
        <span
          class="border-l border-sand pl-2.5 text-xs font-semibold uppercase tracking-wider text-terracotta sm:text-sm"
          aria-hidden="true"
        >
          {brand.programLabel}
        </span>
      )}
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1 rounded-full border border-sand bg-white/95 p-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
        {items.map((item) => {
          const active = item.key !== undefined && item.key === current;
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'block rounded-full px-3.5 py-2 text-sm font-semibold transition-colors xl:px-4 xl:text-[15px]',
                  active
                    ? 'bg-charcoal text-cream shadow-sm'
                    : 'text-charcoal/80 hover:bg-cream hover:text-charcoal',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {cta && (
        <a
          href={cta.href}
          class="hidden min-h-11 items-center gap-2 rounded-full bg-terracotta px-4 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-terracotta-dark sm:inline-flex xl:px-5"
        >
          {cta.label} <Icon name="arrow" class="h-4 w-4" />
        </a>
      )}
      <button
        type="button"
        class="site-header__toggle inline-flex h-11 w-11 items-center justify-center rounded-full bg-charcoal/8 text-charcoal transition-colors hover:bg-charcoal/15 lg:hidden"
        aria-expanded="false"
        aria-controls="site-mobile-menu"
        aria-label="Open menu"
      >
        <span class="icon-open">
          <Icon name="menu" class="h-5 w-5" strokeWidth={2} />
        </span>
        <span class="icon-close hidden">
          <Icon name="x" class="h-5 w-5" strokeWidth={2} />
        </span>
      </button>
    </div>
  </div>

  <div
    id="site-mobile-menu"
    class="mt-2 hidden rounded-[28px] border border-sand bg-ivory/98 p-3 text-charcoal shadow-2xl ring-1 ring-charcoal/10 backdrop-blur-xl lg:hidden"
  >
    <nav aria-label="Mobile primary">
      <ul class="flex flex-col">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.key !== undefined && item.key === current ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between rounded-2xl px-4 py-3 text-base font-semibold transition-colors hover:bg-cream',
                item.key !== undefined && item.key === current ? 'bg-cream text-terracotta' : 'text-charcoal',
              ]}
            >
              {item.label}
              <Icon name="chevron-right" class="h-4 w-4 opacity-50" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {cta && (
      <div class="mt-2 grid gap-2 border-t border-sand pt-3">
        <a
          href={cta.href}
          class="rounded-full bg-terracotta px-4 py-3 text-center text-sm font-semibold text-white"
        >
          {cta.label}
        </a>
      </div>
    )}
  </div>
</header>

<style>
  .site-header[data-scrolled] {
    top: 0.5rem;
  }
  .site-header[data-scrolled] .site-header__bar {
    background-color: rgb(251 247 241 / 0.98);
    box-shadow: 0 18px 44px -16px rgb(20 26 27 / 0.36);
  }
  @media (min-width: 1024px) {
    .site-header[data-scrolled] .site-header__bar {
      height: 3.5rem;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.site-header__toggle');
  const menu = document.getElementById('site-mobile-menu');

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('hidden', !open);
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
