---
/**
 * Organization-wide pill navigation, shared by every public app.
 * - theme="light": cream/white pill for bright pages (default).
 * - theme="dark":  charcoal glass pill for cinematic heroes (Live, Production, home).
 * On scroll the bar compacts into a floating pill with stronger contrast.
 * Local UI state only (mobile menu); no account functionality is wired yet.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { primaryNav, siteUrl } from '../lib/sites';

interface Props {
  /** Key of the active primary item: mission | worship | academy | live | production. */
  current?: string;
  theme?: 'light' | 'dark';
}
const { current, theme = 'light' } = Astro.props;
const items = primaryNav();
const signIn = siteUrl('web', '/signin');
const getInvolved = siteUrl('web', '/get-involved');
const home = siteUrl('web');
const dark = theme === 'dark';
---
<a href="#main-content" class="sr-only z-[60] rounded-full bg-charcoal px-4 py-2 text-sm font-semibold text-cream focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
<header
  id="site-header"
  data-theme={theme}
  data-surface={dark ? 'dark' : undefined}
  class:list={[
    'site-header fixed inset-x-0 top-3 z-50 mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] transition-[top] duration-300 sm:top-4 sm:w-[calc(100%-2.5rem)]',
    dark ? 'text-cream' : 'text-charcoal',
  ]}
>
  <div
    class:list={[
      'site-header__bar flex h-14 items-center justify-between gap-3 rounded-full border py-2 pl-5 pr-2 transition-[background-color,box-shadow,border-color,height] duration-300 lg:h-16 lg:pl-6',
      dark
        ? 'border-white/10 bg-charcoal/55 shadow-[0_10px_40px_-12px_rgba(0,0,0,.55)] backdrop-blur-xl'
        : 'border-sand/80 bg-ivory/80 shadow-[0_10px_30px_-18px_rgba(29,35,35,.35)] backdrop-blur-xl',
    ]}
  >
    <a href={home} class="flex shrink-0 items-center rounded-full" aria-label="Gamo Studios home">
      <Logo width="138" height="26" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class:list={['flex items-center gap-1 rounded-full border p-1', dark ? 'border-white/10 bg-white/[.04]' : 'border-sand bg-white/70']}>
        {items.map((item) => {
          const active = item.key === current;
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'block rounded-full px-3 py-2 text-sm font-medium transition-colors xl:px-4 xl:text-[15px]',
                  active
                    ? dark ? 'bg-cream text-charcoal' : 'bg-charcoal text-cream'
                    : dark ? 'text-cream/80 hover:bg-white/10 hover:text-white' : 'text-charcoal/75 hover:bg-cream hover:text-charcoal',
                ]}
              >{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={signIn} class:list={['hidden rounded-full border px-4 py-2.5 text-sm font-semibold transition-colors md:inline-flex xl:px-5', dark ? 'border-cream/35 hover:bg-white/10' : 'border-charcoal/20 hover:bg-white']}>Sign In</a>
      <a href={getInvolved} class="hidden items-center gap-2 rounded-full bg-terracotta px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-terracotta-dark sm:inline-flex xl:px-5">
        Get Involved <Icon name="arrow" class="h-4 w-4" />
      </a>
      <button
        type="button"
        class:list={['site-header__toggle inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors lg:hidden', dark ? 'bg-white/10 hover:bg-white/15' : 'bg-charcoal/5 hover:bg-charcoal/10']}
        aria-expanded="false"
        aria-controls="site-mobile-menu"
        aria-label="Open menu"
      >
        <span class="icon-open"><Icon name="menu" class="h-5 w-5" strokeWidth={2} /></span>
        <span class="icon-close hidden"><Icon name="x" class="h-5 w-5" strokeWidth={2} /></span>
      </button>
    </div>
  </div>

  <div id="site-mobile-menu" class:list={['mt-2 hidden rounded-[28px] border p-3 shadow-2xl backdrop-blur-xl lg:hidden', dark ? 'border-white/10 bg-charcoal/95' : 'border-sand bg-ivory/97']}>
    <nav aria-label="Mobile primary">
      <ul class="flex flex-col">
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.key === current ? 'page' : undefined} class:list={['flex items-center justify-between rounded-2xl px-4 py-3 text-base font-medium', dark ? 'hover:bg-white/10' : 'hover:bg-cream', item.key === current && 'text-terracotta']}>
              {item.label}<Icon name="chevron-right" class="h-4 w-4 opacity-50" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class:list={['mt-2 grid grid-cols-2 gap-2 border-t pt-3', dark ? 'border-white/10' : 'border-sand']}>
      <a href={signIn} class:list={['rounded-full border px-4 py-3 text-center text-sm font-semibold', dark ? 'border-cream/35' : 'border-charcoal/20']}>Sign In</a>
      <a href={getInvolved} class="rounded-full bg-terracotta px-4 py-3 text-center text-sm font-semibold text-white">Get Involved</a>
    </div>
  </div>
</header>

<style>
  .site-header[data-scrolled] { top: 0.5rem; }
  .site-header[data-scrolled][data-theme='dark'] .site-header__bar {
    background-color: rgb(29 35 35 / 0.9);
    border-color: rgb(255 255 255 / 0.14);
    box-shadow: 0 14px 44px -14px rgb(0 0 0 / 0.7);
  }
  .site-header[data-scrolled][data-theme='light'] .site-header__bar {
    background-color: rgb(251 247 241 / 0.94);
    box-shadow: 0 18px 44px -20px rgb(29 35 35 / 0.45);
  }
  @media (min-width: 1024px) {
    .site-header[data-scrolled] .site-header__bar { height: 3.5rem; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.site-header__toggle');
  const menu = document.getElementById('site-mobile-menu');

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('hidden', !open);
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
