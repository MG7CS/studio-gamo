---
/**
 * Site navigation shared by every public app: a flat bar with a hairline border, plain text links (the active
 * page is underlined) and a rectangular call to action (`DESIGN.md` §11: no pills, no floating capsule).
 * App-neutral: brand, nav items and the call to action come from the app's `ShellConfig` (`src/site.config.ts`).
 *
 * An item with a `menu` also gets an image-led panel (W3C APG "Disclosure Navigation", progressively
 * enhanced): the top item stays a real link, a small chevron button (revealed by the script) toggles the
 * panel, which is `hidden` until opened so its images are not fetched. Not `role="menu"`: the buttons are
 * disclosure buttons, so there is deliberately no `aria-haspopup` (docs/DECISIONS.md, 2026-11-18).
 * Below `lg` a full-screen layer (Tesla-style) lists the programs; each opens its own screen with a Back control.
 * Local UI state only (menus); public visitors have no accounts.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MegaMenuPanel from './MegaMenuPanel.astro';
import MenuTile from './MenuTile.astro';
import type { ShellConfig } from '../shell/types';

interface Props {
  shell: ShellConfig;
  /** Key of the active nav item. */
  current?: string;
  /** Accepted for backwards compatibility; header styling is unified across all pages. */
  theme?: 'light' | 'dark';
}
const { shell, current } = Astro.props;
const { brand, nav: items, cta } = shell;
const homeLabel = `${brand.programLabel ? `${brand.name} ${brand.programLabel}` : brand.name} home`;
---

<a
  href="#main-content"
  class="sr-only z-60 rounded-button bg-surface-inverse px-5 text-sm font-semibold text-fg-inverse focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:inline-flex focus:min-h-11 focus:items-center"
>
  Skip to content
</a>
<header
  id="site-header"
  data-theme="light"
  class="site-header fixed inset-x-0 top-0 z-50 border-b border-border bg-surface/95 text-fg backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-3 px-gutter sm:gap-6 lg:h-18">
    <a href={brand.href} class="flex min-h-11 min-w-0 shrink items-center gap-3" aria-label={homeLabel}>
      <Logo width="138" height="26" class="h-auto min-w-0 shrink" />
      {brand.programLabel && (
        <span
          class="hidden border-l border-border pl-3 text-sm font-semibold text-action-strong xs:inline"
          aria-hidden="true"
        >
          {brand.programLabel}
        </span>
      )}
    </a>

    <nav aria-label="Primary" class="hidden h-full lg:block">
      <ul class="flex h-full items-center gap-8">
        {items.map((item, index) => {
          const active = item.key !== undefined && item.key === current;
          const link = (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center border-b-2 text-sm font-semibold transition-colors',
                active ? 'border-action text-fg' : 'border-transparent text-fg-muted hover:text-fg',
              ]}
            >
              {item.label}
            </a>
          );
          if (!item.menu) return <li class="flex h-full items-center">{link}</li>;
          const panelId = `site-menu-${index}`;
          return (
            <li class="flex h-full items-center" data-mega>
              <div class="flex items-center">
                {link}
                <button
                  type="button"
                  hidden
                  data-mega-button
                  class="inline-flex h-11 w-8 items-center justify-center rounded-button text-fg-muted transition-colors hover:text-fg"
                  aria-expanded="false"
                  aria-controls={panelId}
                  aria-label={`${item.label} menu`}
                >
                  <Icon name="chevron-down" class="h-4 w-4" strokeWidth={2} />
                </button>
              </div>
              <div
                id={panelId}
                hidden
                data-mega-panel
                class="mega-fade absolute inset-x-0 top-full z-10 border-b border-border bg-surface text-fg"
              >
                <MegaMenuPanel menu={item.menu} />
              </div>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      {cta && (
        <a
          href={cta.href}
          class="hidden min-h-11 items-center gap-2 rounded-button bg-action px-5 text-sm font-semibold text-on-action transition-colors hover:bg-action-strong sm:inline-flex"
        >
          {cta.label} <Icon name="arrow" class="h-4 w-4" />
        </a>
      )}
      <button
        type="button"
        class="site-header__toggle inline-flex min-h-11 items-center gap-2 rounded-button border border-border px-3 text-sm font-semibold text-fg transition-colors hover:bg-surface-inset lg:hidden"
        aria-expanded="false"
        aria-controls="site-mobile-menu"
        aria-label="Menu"
      >
        <span class="icon-open">
          <Icon name="menu" class="h-5 w-5" strokeWidth={2} />
        </span>
        <span class="icon-close hidden">
          <Icon name="x" class="h-5 w-5" strokeWidth={2} />
        </span>
        <span class="toggle-label max-2xs:hidden">Menu</span>
      </button>
    </div>
  </div>

  <div
    hidden
    data-mega-backdrop
    aria-hidden="true"
    class="mega-fade absolute inset-x-0 top-full z-0 h-screen bg-scrim"
  ></div>
</header>

<!-- Below lg: a full-screen white layer (Tesla-style). A sibling of the header, not a child, because the header's
     backdrop blur would otherwise become the containing block of this fixed layer. -->
<div
  id="site-mobile-menu"
  class="fixed inset-0 z-40 hidden flex flex-col overflow-y-auto overscroll-contain bg-surface pt-16 lg:hidden"
>
  <nav aria-label="Mobile primary" class="mx-auto my-auto w-full max-w-page py-6 text-center">
    <div data-mobile-root>
      <ul class="flex flex-col">
        {items.map((item, index) => {
          const active = item.key !== undefined && item.key === current;
          const rowClass = [
            'flex min-h-14 w-full items-center justify-center gap-2 px-gutter text-center text-xl font-semibold transition-colors hover:text-action-strong',
            active ? 'text-action-strong' : 'text-fg',
          ];
          const screenId = `site-mobile-screen-${index}`;
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={rowClass}
                data-mobile-link
              >
                {item.label}
              </a>
              {item.menu && (
                <button
                  type="button"
                  hidden
                  data-mobile-drill
                  aria-expanded="false"
                  aria-controls={screenId}
                  class:list={rowClass}
                >
                  {item.label}
                  <Icon name="chevron-right" class="h-5 w-5 text-fg-muted" strokeWidth={2} />
                </button>
              )}
            </li>
          );
        })}
      </ul>
      {cta && (
        <div class="px-gutter pt-8">
          <a
            href={cta.href}
            class="flex min-h-14 w-full items-center justify-center rounded-button bg-action px-5 text-base font-semibold text-on-action transition-colors hover:bg-action-strong"
          >
            {cta.label}
          </a>
        </div>
      )}
    </div>

    {items.map((item, index) => {
      if (!item.menu) return null;
      const screenId = `site-mobile-screen-${index}`;
      const rowClass =
        'flex min-h-14 items-center justify-center px-gutter text-center text-xl font-semibold text-fg transition-colors hover:text-action-strong';
      const linkedTiles = item.menu.tiles.filter((tile) => tile.href);
      return (
        <section id={screenId} hidden data-mobile-screen aria-labelledby={`${screenId}-title`}>
          <div class="flex h-14 items-center px-gutter">
            <button
              type="button"
              data-mobile-back
              aria-label="Back"
              class="-ml-3 inline-flex size-11 shrink-0 items-center justify-center rounded-button text-fg transition-colors hover:bg-surface-inset"
            >
              <Icon name="chevron-left" class="h-6 w-6" strokeWidth={2} />
            </button>
            <h2 id={`${screenId}-title`} class="flex-1 text-center text-lg font-semibold text-fg">
              {item.label}
            </h2>
            <span class="-mr-3 size-11 shrink-0" aria-hidden="true"></span>
          </div>
          {/* Pictures (and the divider under them) show here only for tiles that have an `href`; add hrefs to the
              tiles in packages/config/menus.ts once the pages exist. With none, the screen is the bar and the links. */}
          {linkedTiles.length > 0 && (
            <ul class="flex flex-col gap-6 px-gutter pt-8 pb-8">
              {linkedTiles.map((tile) => (
                <li>
                  <MenuTile tile={tile} variant="row" />
                </li>
              ))}
            </ul>
          )}
          <ul class:list={['flex flex-col pt-2', linkedTiles.length > 0 && 'border-t border-border']}>
            {item.menu.links.map((link) => (
              <li>
                <a href={link.href} class={rowClass}>
                  {link.label}
                </a>
              </li>
            ))}
            <li>
              <a href={item.menu.all.href} class={rowClass}>
                {item.menu.all.label}
              </a>
            </li>
          </ul>
        </section>
      );
    })}
  </nav>
</div>

<style>
  /* Short fade-in only; no motion at all for visitors who ask for less (WCAG 2.3.3). */
  @media (prefers-reduced-motion: no-preference) {
    .mega-fade:not([hidden]) {
      animation: mega-fade 150ms ease-out;
    }
  }
  @keyframes mega-fade {
    from {
      opacity: 0;
    }
  }
  /* Page behind the open mobile menu does not scroll. */
  :global(html.menu-open) {
    overflow: hidden;
  }
  /* Screens slide in (200 ms); the first screen only fades. None of it for visitors who ask for less. */
  @media (prefers-reduced-motion: no-preference) {
    [data-mobile-screen]:not([hidden]) {
      animation: mobile-slide 200ms ease-out;
    }
    [data-mobile-root]:not([hidden]) {
      animation: mega-fade 200ms ease-out;
    }
  }
  @keyframes mobile-slide {
    from {
      opacity: 0;
      transform: translateX(1.5rem);
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.site-header__toggle');
  const menu = document.getElementById('site-mobile-menu');
  const root = menu?.querySelector<HTMLElement>('[data-mobile-root]');
  const screens = Array.from(menu?.querySelectorAll<HTMLElement>('[data-mobile-screen]') ?? []);
  const drills = Array.from(menu?.querySelectorAll<HTMLButtonElement>('[data-mobile-drill]') ?? []);
  const desktop = window.matchMedia('(min-width: 1024px)');
  let current: HTMLElement | null = null;
  let opener: HTMLButtonElement | null = null;

  // Level 1 rows ship as plain links; with JavaScript the program rows become drill-down buttons.
  drills.forEach((button) => {
    button.hidden = false;
    const link = button.parentElement?.querySelector<HTMLElement>('[data-mobile-link]');
    if (link) link.hidden = true;
  });

  const showScreen = (screen: HTMLElement | null) => {
    current = screen;
    if (root) root.hidden = screen !== null;
    screens.forEach((s) => (s.hidden = s !== screen));
    drills.forEach((b) => b.setAttribute('aria-expanded', String(screen !== null && b === opener)));
    if (menu) menu.scrollTop = 0;
  };
  const goBack = () => {
    const from = opener;
    showScreen(null);
    from?.focus();
  };

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    const label = toggle.querySelector('.toggle-label');
    if (label) label.textContent = open ? 'Close' : 'Menu';
    // The label word hides below 17rem; the accessible name stays Menu / Close.
    toggle.setAttribute('aria-label', open ? 'Close' : 'Menu');
    menu.classList.toggle('hidden', !open);
    document.documentElement.classList.toggle('menu-open', open);
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    if (open) {
      root?.querySelector<HTMLElement>('a:not([hidden]), button:not([hidden])')?.focus();
    } else {
      showScreen(null);
    }
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  drills.forEach((button) => {
    button.addEventListener('click', () => {
      const screen = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!screen) return;
      opener = button;
      showScreen(screen);
      screen.querySelector<HTMLElement>('[data-mobile-back]')?.focus();
    });
  });
  screens.forEach((screen) => {
    screen.querySelector('[data-mobile-back]')?.addEventListener('click', goBack);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
    if (current) {
      goBack();
    } else {
      setOpen(false);
      toggle.focus();
    }
  });
  desktop.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });

  // Desktop panels (APG Disclosure Navigation). The chevron buttons ship `hidden` and appear here, so
  // without JavaScript the top links simply navigate and the panels stay closed.
  const backdrop = header?.querySelector<HTMLElement>('[data-mega-backdrop]');
  const hoverable = window.matchMedia('(hover: hover) and (pointer: fine)');
  const OPEN_DELAY = 150;
  const CLOSE_DELAY = 300;

  interface Mega {
    item: HTMLElement;
    button: HTMLButtonElement;
    panel: HTMLElement;
    timer?: number;
    /** Opened with the button or keyboard: the pointer leaving must not close it. */
    pinned: boolean;
  }
  const megas: Mega[] = [];
  header?.querySelectorAll<HTMLElement>('[data-mega]').forEach((item) => {
    const button = item.querySelector<HTMLButtonElement>('[data-mega-button]');
    const panel = item.querySelector<HTMLElement>('[data-mega-panel]');
    if (button && panel) {
      button.hidden = false;
      megas.push({ item, button, panel, pinned: false });
    }
  });

  const isOpen = (m: Mega) => !m.panel.hidden;
  const show = (m: Mega, open: boolean) => {
    window.clearTimeout(m.timer);
    m.panel.hidden = !open;
    m.button.setAttribute('aria-expanded', String(open));
    if (!open) m.pinned = false;
    if (backdrop) backdrop.hidden = !megas.some(isOpen);
  };
  const openOnly = (m: Mega) => {
    megas.forEach((other) => other !== m && show(other, false));
    show(m, true);
  };
  const closeAll = () => megas.forEach((m) => show(m, false));

  megas.forEach((m) => {
    m.button.addEventListener('click', () => {
      if (isOpen(m) && m.pinned) {
        show(m, false);
      } else {
        openOnly(m);
        m.pinned = true;
      }
    });
    m.button.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown') return;
      e.preventDefault();
      openOnly(m);
      m.pinned = true;
      m.panel.querySelector<HTMLElement>('a')?.focus();
    });
    m.item.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !hoverable.matches) return;
      window.clearTimeout(m.timer);
      if (!isOpen(m)) m.timer = window.setTimeout(() => openOnly(m), OPEN_DELAY);
    });
    m.item.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !hoverable.matches) return;
      window.clearTimeout(m.timer);
      if (isOpen(m) && !m.pinned) m.timer = window.setTimeout(() => show(m, false), CLOSE_DELAY);
    });
    m.item.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !m.item.contains(next)) show(m, false);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = megas.find(isOpen);
    if (!open) return;
    const focusInside =
      open.item.contains(document.activeElement) || document.activeElement === document.body;
    closeAll();
    if (focusInside) open.button.focus();
  });
  document.addEventListener('pointerdown', (e) => {
    const target = e.target as Node;
    if (megas.some((m) => isOpen(m) && !m.item.contains(target))) closeAll();
  });
  backdrop?.addEventListener('click', closeAll);
</script>
