---
/**
 * Site navigation shared by every public app: a flat bar with a hairline border, plain text links (the active
 * page is underlined) and a rectangular call to action (`DESIGN.md` §11: no pills, no floating capsule).
 * App-neutral: brand, nav items and the call to action come from the app's `ShellConfig` (`src/site.config.ts`).
 *
 * An item with a `menu` also gets an image-led panel (W3C APG "Disclosure Navigation", progressively
 * enhanced): the top item stays a real link, a small chevron button (revealed by the script) toggles the
 * panel, which is `hidden` until opened so its images are not fetched. Not `role="menu"`: the buttons are
 * disclosure buttons, so there is deliberately no `aria-haspopup` (docs/DECISIONS.md, 2026-11-18).
 * Below `lg` the drawer shows the same menus as accordions.
 * Local UI state only (menus); public visitors have no accounts.
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MegaMenuPanel from './MegaMenuPanel.astro';
import MenuTile from './MenuTile.astro';
import type { ShellConfig } from '../shell/types';

interface Props {
  shell: ShellConfig;
  /** Key of the active nav item. */
  current?: string;
  /** Accepted for backwards compatibility; header styling is unified across all pages. */
  theme?: 'light' | 'dark';
}
const { shell, current } = Astro.props;
const { brand, nav: items, cta } = shell;
const homeLabel = `${brand.programLabel ? `${brand.name} ${brand.programLabel}` : brand.name} home`;
---

<a
  href="#main-content"
  class="sr-only z-60 rounded-button bg-surface-inverse px-5 text-sm font-semibold text-fg-inverse focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:inline-flex focus:min-h-11 focus:items-center"
>
  Skip to content
</a>
<header
  id="site-header"
  data-theme="light"
  class="site-header fixed inset-x-0 top-0 z-50 border-b border-border bg-surface/95 text-fg backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-6 px-gutter lg:h-18">
    <a href={brand.href} class="flex min-h-11 shrink-0 items-center gap-3" aria-label={homeLabel}>
      <Logo width="138" height="26" />
      {brand.programLabel && (
        <span class="border-l border-border pl-3 text-sm font-semibold text-action-strong" aria-hidden="true">
          {brand.programLabel}
        </span>
      )}
    </a>

    <nav aria-label="Primary" class="hidden h-full lg:block">
      <ul class="flex h-full items-center gap-8">
        {items.map((item, index) => {
          const active = item.key !== undefined && item.key === current;
          const link = (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center border-b-2 text-sm font-semibold transition-colors',
                active ? 'border-action text-fg' : 'border-transparent text-fg-muted hover:text-fg',
              ]}
            >
              {item.label}
            </a>
          );
          if (!item.menu) return <li class="flex h-full items-center">{link}</li>;
          const panelId = `site-menu-${index}`;
          return (
            <li class="flex h-full items-center" data-mega>
              <div class="flex items-center">
                {link}
                <button
                  type="button"
                  hidden
                  data-mega-button
                  class="inline-flex h-11 w-8 items-center justify-center rounded-button text-fg-muted transition-colors hover:text-fg"
                  aria-expanded="false"
                  aria-controls={panelId}
                  aria-label={`${item.label} menu`}
                >
                  <Icon name="chevron-down" class="h-4 w-4" strokeWidth={2} />
                </button>
              </div>
              <div
                id={panelId}
                hidden
                data-mega-panel
                class="mega-fade absolute inset-x-0 top-full z-10 border-b border-border bg-surface text-fg"
              >
                <MegaMenuPanel menu={item.menu} />
              </div>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      {cta && (
        <a
          href={cta.href}
          class="hidden min-h-11 items-center gap-2 rounded-button bg-action px-5 text-sm font-semibold text-on-action transition-colors hover:bg-action-strong sm:inline-flex"
        >
          {cta.label} <Icon name="arrow" class="h-4 w-4" />
        </a>
      )}
      <button
        type="button"
        class="site-header__toggle inline-flex h-11 w-11 items-center justify-center rounded-button border border-border text-fg transition-colors hover:bg-surface-inset lg:hidden"
        aria-expanded="false"
        aria-controls="site-mobile-menu"
        aria-label="Open menu"
      >
        <span class="icon-open">
          <Icon name="menu" class="h-5 w-5" strokeWidth={2} />
        </span>
        <span class="icon-close hidden">
          <Icon name="x" class="h-5 w-5" strokeWidth={2} />
        </span>
      </button>
    </div>
  </div>

  <div
    hidden
    data-mega-backdrop
    aria-hidden="true"
    class="mega-fade absolute inset-x-0 top-full z-0 h-screen bg-scrim"
  ></div>

  <div id="site-mobile-menu" class="hidden border-t border-border bg-surface lg:hidden">
    <div class="mx-auto max-w-page px-gutter py-2">
      <nav aria-label="Mobile primary">
        <ul class="flex flex-col divide-y divide-border">
          {items.map((item, index) => {
            const active = item.key !== undefined && item.key === current;
            if (!item.menu) {
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex min-h-12 items-center justify-between py-3 text-base font-semibold transition-colors hover:text-action-strong',
                      active ? 'text-action-strong' : 'text-fg',
                    ]}
                  >
                    {item.label}
                    <Icon name="chevron-right" class="h-4 w-4 opacity-50" />
                  </a>
                </li>
              );
            }
            const sectionId = `site-mobile-section-${index}`;
            return (
              <li>
                <button
                  type="button"
                  data-accordion-button
                  aria-expanded="false"
                  aria-controls={sectionId}
                  aria-current={active ? 'true' : undefined}
                  class:list={[
                    'flex min-h-12 w-full items-center justify-between py-3 text-left text-base font-semibold transition-colors hover:text-action-strong',
                    active ? 'text-action-strong' : 'text-fg',
                  ]}
                >
                  {item.label}
                  <Icon name="chevron-down" class="accordion-chevron h-4 w-4 opacity-50" />
                </button>
                <div id={sectionId} hidden class="pb-3">
                  <ul class="flex flex-col">
                    {item.menu.tiles.map((tile) => (
                      <li>
                        <MenuTile tile={tile} variant="row" />
                      </li>
                    ))}
                  </ul>
                  <ul class="mt-2 flex flex-col border-t border-border pt-2">
                    {item.menu.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="flex min-h-11 items-center text-sm font-semibold text-fg-muted hover:text-fg"
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                    <li>
                      <a
                        href={item.menu.all.href}
                        class="flex min-h-11 items-center text-sm font-semibold text-action-strong hover:text-fg"
                      >
                        {item.menu.all.label}
                      </a>
                    </li>
                  </ul>
                </div>
              </li>
            );
          })}
        </ul>
      </nav>
      {cta && (
        <a
          href={cta.href}
          class="my-3 flex min-h-12 items-center justify-center rounded-button bg-action px-4 text-sm font-semibold text-on-action"
        >
          {cta.label}
        </a>
      )}
    </div>
  </div>
</header>

<style>
  /* Short fade-in only; no motion at all for visitors who ask for less (WCAG 2.3.3). */
  @media (prefers-reduced-motion: no-preference) {
    .mega-fade:not([hidden]) {
      animation: mega-fade 150ms ease-out;
    }
  }
  @keyframes mega-fade {
    from {
      opacity: 0;
    }
  }
  [aria-expanded='true'] > :global(.accordion-chevron) {
    transform: rotate(180deg);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.site-header__toggle');
  const menu = document.getElementById('site-mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('hidden', !open);
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Mobile accordions: one button per program with a menu.
  header?.querySelectorAll<HTMLButtonElement>('[data-accordion-button]').forEach((button) => {
    const section = document.getElementById(button.getAttribute('aria-controls') ?? '');
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      if (section) section.hidden = !open;
    });
  });

  // Desktop panels (APG Disclosure Navigation). The chevron buttons ship `hidden` and appear here, so
  // without JavaScript the top links simply navigate and the panels stay closed.
  const backdrop = header?.querySelector<HTMLElement>('[data-mega-backdrop]');
  const hoverable = window.matchMedia('(hover: hover) and (pointer: fine)');
  const OPEN_DELAY = 150;
  const CLOSE_DELAY = 300;

  interface Mega {
    item: HTMLElement;
    button: HTMLButtonElement;
    panel: HTMLElement;
    timer?: number;
    /** Opened with the button or keyboard: the pointer leaving must not close it. */
    pinned: boolean;
  }
  const megas: Mega[] = [];
  header?.querySelectorAll<HTMLElement>('[data-mega]').forEach((item) => {
    const button = item.querySelector<HTMLButtonElement>('[data-mega-button]');
    const panel = item.querySelector<HTMLElement>('[data-mega-panel]');
    if (button && panel) {
      button.hidden = false;
      megas.push({ item, button, panel, pinned: false });
    }
  });

  const isOpen = (m: Mega) => !m.panel.hidden;
  const show = (m: Mega, open: boolean) => {
    window.clearTimeout(m.timer);
    m.panel.hidden = !open;
    m.button.setAttribute('aria-expanded', String(open));
    if (!open) m.pinned = false;
    if (backdrop) backdrop.hidden = !megas.some(isOpen);
  };
  const openOnly = (m: Mega) => {
    megas.forEach((other) => other !== m && show(other, false));
    show(m, true);
  };
  const closeAll = () => megas.forEach((m) => show(m, false));

  megas.forEach((m) => {
    m.button.addEventListener('click', () => {
      if (isOpen(m) && m.pinned) {
        show(m, false);
      } else {
        openOnly(m);
        m.pinned = true;
      }
    });
    m.button.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown') return;
      e.preventDefault();
      openOnly(m);
      m.pinned = true;
      m.panel.querySelector<HTMLElement>('a')?.focus();
    });
    m.item.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !hoverable.matches) return;
      window.clearTimeout(m.timer);
      if (!isOpen(m)) m.timer = window.setTimeout(() => openOnly(m), OPEN_DELAY);
    });
    m.item.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || !hoverable.matches) return;
      window.clearTimeout(m.timer);
      if (isOpen(m) && !m.pinned) m.timer = window.setTimeout(() => show(m, false), CLOSE_DELAY);
    });
    m.item.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !m.item.contains(next)) show(m, false);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = megas.find(isOpen);
    if (!open) return;
    const focusInside =
      open.item.contains(document.activeElement) || document.activeElement === document.body;
    closeAll();
    if (focusInside) open.button.focus();
  });
  document.addEventListener('pointerdown', (e) => {
    const target = e.target as Node;
    if (megas.some((m) => isOpen(m) && !m.item.contains(target))) closeAll();
  });
  backdrop?.addEventListener('click', closeAll);
</script>
