---
/**
 * Contextual audience switch (WAI-ARIA tabs). Panels are provided as named slots
 * matching each option `id`, e.g. <div slot="churches">…</div>.
 * Without JS every panel stays visible, so content is never lost.
 */
interface Props {
  id: string;
  label: string;
  options: { id: string; label: string }[];
  tone?: 'light' | 'dark';
  align?: 'left' | 'center';
  class?: string;
}
const { id, label, options, tone = 'light', align = 'left', class: className } = Astro.props;
const slotHtml = await Promise.all(options.map((o) => Astro.slots.render(o.id)));
const hasHeadingSlot = Astro.slots.has('heading');
---

<div class:list={['audience-switch', className]} data-audience-switch={id}>
  <div class:list={[align === 'center' && 'flex justify-center']}>
    <div
      role="tablist"
      aria-label={label}
      class:list={[
        'inline-flex flex-wrap justify-center rounded-full p-1.5 shadow-sm',
        tone === 'dark' ? 'bg-white/10' : 'border border-sand bg-white/95',
      ]}
    >
      {options.map((o, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${o.id}`}
          aria-controls={`${id}-panel-${o.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class:list={[
            'min-h-11 rounded-full px-5 text-sm font-semibold transition-colors sm:px-6',
            tone === 'dark'
              ? 'text-cream/75 aria-selected:bg-cream aria-selected:text-charcoal'
              : 'text-charcoal/75 aria-selected:bg-charcoal aria-selected:text-cream',
          ]}
        >
          {o.label}
        </button>
      ))}
    </div>
  </div>
  {hasHeadingSlot && (
    <div class="mt-5">
      <slot name="heading" />
    </div>
  )}
  {options.map((o, i) => (
    <div
      role="tabpanel"
      id={`${id}-panel-${o.id}`}
      aria-labelledby={`${id}-tab-${o.id}`}
      tabindex="0"
      class="mt-8 focus-visible:outline-none sm:mt-10"
      data-initial-hidden={i === 0 ? undefined : ''}
    >
      <Fragment set:html={slotHtml[i]} />
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-audience-switch]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const select = (index: number, focus = false) => {
      tabs.forEach((t, i) => {
        const on = i === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length, true);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
        if (e.key === 'Home') select(0, true);
        if (e.key === 'End') select(tabs.length - 1, true);
      });
    });
    select(0);
  });
</script>
