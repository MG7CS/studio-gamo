# Shared local settings for all six apps. Copy to `.env` (git-ignored) and fill in.
# Loaded only by `astro dev` via @gamo/config/env-loader; never embedded in preview/production builds.
# Per-app secrets (Clerk, Stripe, admin access) go in apps/<app>/.dev.vars — see each app's .dev.vars.example.
# Clerk variables are ignored here on purpose: every product has its own Clerk application.
# In preview/production, set secrets with `wrangler secret put <NAME> --env <env>`; non-secret values live in wrangler.toml [vars].

# REQUIRED. Runtime mode. Use `local` for development (wrangler.toml sets `preview` / `production`).
ENVIRONMENT=

# REQUIRED. Signs D1 session cookies and the admin gate cookie. At least 32 random characters
# (e.g. `openssl rand -base64 48`). Must differ between local, preview and production.
SESSION_SECRET=

# OPTIONAL locally, REQUIRED in production for email. Resend API key for transactional email
# (verification codes, registration confirmations). Locally, a value starting with `re_mock_`
# logs instead of sending.
RESEND_API_KEY=
# OPTIONAL. Sender, e.g. `Gamo Studios <notifications@gamostudio.org>` (that is the default).
EMAIL_FROM=

# LOCAL-ONLY FLAGS. Each is honoured only when ENVIRONMENT=local AND the request host is
# localhost / 127.0.0.1 / [::1]. Leave empty unless you need them.
# Issue a session for any email without verification (POST /api/auth/session).
ALLOW_DEMO_SESSION=
# Return email verification codes in the API response instead of sending them.
ALLOW_AUTH_SIMULATION=
# Render dashboards with fictional sample data without signing in.
ALLOW_PUBLIC_DEMO_WORKSPACES=
