# Gamo Studios Monorepo — Shared Local Development Config (.env.example)
# Copy this file to studio-gamo/.env for shared local settings across all 6 Astro applications.
#
# IMPORTANT:
# 1. Keep application-specific Clerk credentials inside each application's own directory:
#      apps/web/.env          (or apps/web/.dev.vars)
#      apps/live/.env         (or apps/live/.dev.vars)
#      apps/academy/.env      (or apps/academy/.dev.vars)
#      apps/worship/.env      (or apps/worship/.dev.vars)
#      apps/production/.env   (or apps/production/.dev.vars)
#      apps/admin/.env        (or apps/admin/.dev.vars)
# 2. Never put un-suffixed Clerk credentials in this root .env file, and never reuse Gamo Live's
#    Clerk credentials in another application.
# 3. Never commit real secrets to Git (.env and .dev.vars are ignored by .gitignore).

ENVIRONMENT="local"
SESSION_SECRET="YOUR_GENERATED_SECRET"
ALLOW_DEMO_SESSION="false"
ALLOW_TEST_CHALLENGE_OUTBOX="false"
REQUIRE_ADMIN_AUTH="true"

# Shared local transactional email fallback (used when a product's Clerk app is not yet provisioned)
RESEND_API_KEY="re_mock_local"
