# Gamo Studios Monorepo — Shared Local Worker Secrets Example (.dev.vars.example)
# Application-specific Clerk and Stripe credentials belong inside each application's own directory:
#   apps/web/.dev.vars          (or apps/web/.env)
#   apps/live/.dev.vars         (or apps/live/.env)
#   apps/academy/.dev.vars      (or apps/academy/.env)
#   apps/worship/.dev.vars      (or apps/worship/.env)
#   apps/production/.dev.vars   (or apps/production/.env)
#   apps/admin/.dev.vars        (or apps/admin/.env)
# Never commit real secrets or API keys.

ENVIRONMENT="local"
SESSION_SECRET="replace-with-32-character-minimum-random-secret"
ALLOW_DEMO_SESSION="false"
ALLOW_TEST_CHALLENGE_OUTBOX="false"
REQUIRE_ADMIN_AUTH="true"

# Shared local transactional email fallback (re_mock_ prefix safely logs locally without sending external mail)
RESEND_API_KEY="re_mock_local"
EMAIL_FROM="noreply@gamostudio.org"
