    "/api/events": {
      "servers": [
        {
          "url": "http://127.0.0.1:4324",
          "description": "Local live application"
        }
      ],
      "get": {
        "operationId": "listEvents",
        "tags": [
          "Live"
        ],
        "summary": "Discover approved Christian events",
        "description": "At most 50 results ordered by startsAt then id ascending. meta.total is returned row count, not all matching rows. No cursor or client limit yet. Unknown query fields are rejected.",
        "security": [],
        "x-application": "live",
        "x-status": "implemented",
        "x-authorization": "Public",
        "x-idempotency": "Unsupported; client keys are ignored.",
        "x-source": "apps/live/src/pages/api/events/index.ts",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Exact category filter.",
            "schema": {
              "$ref": "#/components/schemas/category"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Exact city filter.",
            "schema": {
              "$ref": "#/components/schemas/city"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/LegacyError"
          },
          "500": {
            "$ref": "#/components/responses/LegacyError"
          }
        }
      },
      "post": {
        "operationId": "proposeEvent",
        "tags": [
          "Live"
        ],
        "summary": "Submit event for review",
        "description": "Submit event for review",
        "security": [
          {
            "BrowserSession": []
          }
        ],
        "x-application": "live",
        "x-status": "implemented",
        "x-authorization": "Active owner/admin membership of organizationId, or superadmin. Session verification required; no demo header bypass.",
        "x-idempotency": "Unsupported; client keys are ignored.",
        "x-source": "apps/live/src/pages/api/events/index.ts",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/LegacyError"
          },
          "401": {
            "$ref": "#/components/responses/LegacyError"
          },
          "403": {
            "$ref": "#/components/responses/LegacyError"
          },
          "500": {
            "$ref": "#/components/responses/LegacyError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEvent"
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "servers": [
        {
          "url": "http://127.0.0.1:4324",
          "description": "Local live application"
        }
      ],
      "get": {
        "operationId": "getEvent",
        "tags": [
          "Live"
        ],
        "summary": "Read approved event",
        "description": "Read approved event",
        "security": [],
        "x-application": "live",
        "x-status": "implemented",
        "x-authorization": "Public",
        "x-idempotency": "Unsupported; client keys are ignored.",
        "x-source": "apps/live/src/pages/api/events/[id]/index.ts",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/LegacyError"
          },
          "404": {
            "$ref": "#/components/responses/LegacyError"
          },
          "500": {
            "$ref": "#/components/responses/LegacyError"
          }
        }
      }
    },
    "/api/events/{id}/register": {
      "servers": [
        {
          "url": "http://127.0.0.1:4324",
          "description": "Local live application"
        }
      ],
      "post": {
        "operationId": "registerAttendee",
        "tags": [
          "Live"
        ],
        "summary": "Register for a free event",
        "description": "Sequential duplicate email/event requests return 200 with existing pass. Public registration; userId is legacy untrusted input and a known reconciliation finding. Capacity serialization and duplicate pass disclosure need policy/technical resolution.",
        "security": [],
        "x-application": "live",
        "x-status": "implemented",
        "x-authorization": "Public",
        "x-idempotency": "Natural key: event ID plus lowercase trimmed email. Sequential retries only; concurrent replay behavior incomplete.",
        "x-source": "apps/live/src/pages/api/events/[id]/register.ts",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/LegacyError"
          },
          "404": {
            "$ref": "#/components/responses/LegacyError"
          },
          "409": {
            "$ref": "#/components/responses/LegacyError"
          },
          "500": {
            "$ref": "#/components/responses/LegacyError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAttendee"
              }
            }
          }
        }
      }
    },
    "/api/checkout/session": {
      "servers": [
        {
          "url": "http://127.0.0.1:4324",
          "description": "Local live application"
        }
      ],
      "post": {
        "operationId": "createTestCheckout",
        "tags": [
          "Payments"
        ],
        "summary": "Create sandbox checkout",
        "description": "Sandbox only. Event must exist and be approved, paid, with a valid server-priced tier. No inventory reservation, organizer authorization or client idempotency yet; not production ready.",
        "security": [],
        "x-application": "live",
        "x-status": "implemented",
        "x-authorization": "Public",
        "x-idempotency": "Unsupported; client keys are ignored.",
        "x-source": "apps/live/src/pages/api/checkout/session.ts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/SimpleError"
          },
          "404": {
            "$ref": "#/components/responses/SimpleError"
          },
          "409": {
            "$ref": "#/components/responses/SimpleError"
          },
          "500": {
            "$ref": "#/components/responses/SimpleError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutInput"
              }
            }
          }
        }
      }
    },
    "/api/webhook/stripe": {
      "servers": [
        {
          "url": "http://127.0.0.1:4324",
          "description": "Local live application"
        }
      ],
      "post": {
        "operationId": "receiveStripeWebhook",
        "tags": [
          "Payments"
        ],
        "summary": "Receive signed test Stripe event",
        "description": "Signature verified on raw body; livemode=true rejected. Durable event-ID deduplication exists but claim-before-processing and partial writes are unresolved. No real ticket fulfillment, refund reversal or reservation release.",
        "security": [
          {
            "StripeSignature": []
          }
        ],
        "x-application": "live",
        "x-status": "implemented",
        "x-authorization": "Public",
        "x-idempotency": "Stripe event ID in D1; failure retry and concurrent claim correctness remain blockers.",
        "x-source": "apps/live/src/pages/api/webhook/stripe.ts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/SimpleError"
          },
          "500": {
            "$ref": "#/components/responses/SimpleError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StripeEvent"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Identifier": {
        "type": "string",
