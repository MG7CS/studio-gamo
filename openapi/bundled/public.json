    "description": "Authoritative contract for a developing Christian nonprofit. Existing routes only; demo/incomplete operations are explicitly labeled. Internal operations must not be published. No production readiness or payment authorization implied.",
    "license": {
      "name": "Private repository; no public API license"
    }
  },
