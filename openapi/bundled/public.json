        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "organizerId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "concert",
              "worship",
              "bible",
              "conference",
              "youth"
            ]
          },
          "tagline": {
            "anyOf": [
              {
                "type": "string"
