          },
          "description": {
            "type": "string"
          },
          "venueName": {
            "type": "string"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "startsAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "endsAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "timezone": {
            "type": "string"
          },
          "admissionType": {
            "type": "string",
            "enum": [
