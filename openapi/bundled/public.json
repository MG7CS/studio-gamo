              "message"
            ]
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "TierInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "default": 0
