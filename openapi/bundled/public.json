          "capacity": {
            "type": "integer",
            "minimum": 1,
            "default": 100
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "Tier": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "eventId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "name": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "reservedCount": {
            "type": "integer",
            "minimum": 0
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "eventId",
          "name",
          "priceCents",
          "capacity",
          "reservedCount",
          "note"
        ]
      },
      "CreateEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "organizationId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "category": {
            "type": "string",
            "enum": [
              "concert",
              "worship",
              "bible",
              "conference",
              "youth"
            ]
          },
          "tagline": {
            "type": "string",
            "maxLength": 250
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "venueName": {
            "type": "string",
            "minLength": 2
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string",
            "minLength": 2
          },
          "state": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "startsAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "endsAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "timezone": {
            "type": "string",
            "default": "America/Phoenix",
            "description": "IANA timezone; validated by Intl.DateTimeFormat."
          },
          "admissionType": {
            "type": "string",
            "enum": [
              "free",
              "paid",
              "external"
            ],
            "default": "free"
          },
          "photoKey": {
            "type": "string"
          },
          "externalUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "const": ""
              }
            ]
          },
          "tiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TierInput"
            }
          }
        },
        "required": [
          "organizationId",
          "title",
          "category",
          "description",
          "venueName",
          "city",
          "state",
          "startsAt"
        ]
      },
      "RegisterAttendee": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attendeeName": {
            "type": "string",
            "minLength": 2
          },
          "attendeeEmail": {
            "type": "string",
