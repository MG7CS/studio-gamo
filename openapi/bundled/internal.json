{
  "openapi": "3.1.1",
  "info": {
    "title": "Gamo Studios HTTP API — local foundation",
    "version": "4.0.0",
    "description": "Authoritative contract for Gamo Studios, a Christian, mission-driven Public Benefit Corporation. Demo/incomplete operations are explicitly labeled. Internal operations must not be published. No production readiness or payment authorization implied.",
    "license": {
      "name": "Private repository; no public API license"
    }
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://127.0.0.1:4321",
      "description": "Local global site (web); each path specifies its owning application."
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Worship",
      "description": "Worship domain. No endpoint existence implied by tag."
    },
    {
      "name": "Academy",
      "description": "Academy domain. No endpoint existence implied by tag."
    },
    {
      "name": "Production",
      "description": "Production domain. No endpoint existence implied by tag."
    },
    {
      "name": "Partnerships",
      "description": "Partnerships domain. No endpoint existence implied by tag."
    },
    {
      "name": "Media",
      "description": "Media domain. No endpoint existence implied by tag."
    },
    {
      "name": "Administration",
      "description": "Administration domain. No endpoint existence implied by tag."
    },
    {
      "name": "Email",
      "description": "Email delivery domain (provider delivery events and suppressions). No endpoint existence implied by tag."
    }
  ],
  "paths": {
    "/api/staff/provision": {
      "servers": [
        {
          "url": "http://127.0.0.1:4326",
          "description": "Local admin application"
        }
      ],
      "post": {
        "operationId": "provisionStaffIdentity",
        "tags": [
          "Administration"
        ],
        "summary": "Provision a staff user role and bind external Cloudflare Access identity",
        "description": "Restricted to superadmin inside the Admin Access boundary. Creates or updates the target staff user, binds their immutable Cloudflare Access subject in external_identities, assigns the requested global staff role, and records an audit log entry.",
        "security": [
          {
            "CloudflareAccess": [],
            "BrowserSession": []
          },
          {
            "EmergencyBearer": [],
            "BrowserSession": []
          },
          {
            "EmergencyKey": [],
            "BrowserSession": []
          },
          {
            "EmergencyBasic": [],
            "BrowserSession": []
          }
        ],
        "x-application": "admin",
        "x-status": "implemented",
        "x-authorization": "Access boundary AND D1 superadmin session required.",
        "x-idempotency": "Re-provisioning the same user/role/subject updates the binding idempotently; conflicting subject binding returns 409.",
        "x-source": "apps/admin/src/pages/api/staff/provision.ts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvisionStaffResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/LegacyError"
          },
          "401": {
            "description": "Middleware denies access",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegacyError"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/LegacyError"
          },
          "409": {
            "$ref": "#/components/responses/LegacyError"
          },
          "500": {
            "$ref": "#/components/responses/LegacyError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisionStaffInput"
              }
            }
          }
        },
        "x-internal": true
      }
    },
    "/api/webhook/resend": {
      "servers": [
        {
          "url": "http://127.0.0.1:4321",
          "description": "Local global site (web)"
        }
      ],
      "post": {
        "operationId": "receiveResendWebhook",
        "tags": [
          "Email"
        ],
        "summary": "Receive a signed Resend event",
        "description": "Svix signature with RESEND_WEBHOOK_SECRET (503 without it). Updates the email_log status for every program's mail; hard bounces and complaints add the address hash to email_suppressions.",
        "security": [],
        "x-application": "web",
        "x-status": "implemented",
        "x-authorization": "Public (Svix signature).",
        "x-idempotency": "Statuses never move backwards; repeated events change nothing.",
        "x-source": "apps/web/src/pages/api/webhook/resend.ts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Event received; `applied` says whether it changed a stored delivery status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendWebhookResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/LegacyError"
          },
          "503": {
            "$ref": "#/components/responses/LegacyError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendEvent"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Identifier": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque case-sensitive resource identifier; never parse for authority."
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "ListMeta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "total"
        ]
      },
      "LegacyError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "message",
                    "code"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "SimpleError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message",
                "code"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "verifiedEmailAt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "verifiedEmailAt",
          "status",
          "createdAt"
        ]
      },
      "ProvisionStaffInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 3,
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "enum": [
              "staff_reviewer",
              "finance_manager",
              "superadmin"
            ]
          },
          "accessSubject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "email",
          "role",
          "accessSubject"
        ]
      },
      "ProvisionStaffResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              },
              "role": {
                "type": "string",
                "enum": [
                  "staff_reviewer",
                  "finance_manager",
                  "superadmin"
                ]
              },
              "provider": {
                "type": "string",
                "const": "cloudflare_access"
              },
              "accessSubject": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "user",
              "role",
              "provider",
              "accessSubject",
              "message"
            ]
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "ResendEvent": {
        "type": "object",
        "additionalProperties": true,
        "description": "Resend webhook payload (Svix-signed).",
        "properties": {
          "type": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "type",
          "data"
        ]
      },
      "ResendWebhookResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "received": {
            "const": true
          },
          "applied": {
            "type": "boolean"
          }
        },
        "required": [
          "received",
          "applied"
        ]
      }
    },
    "securitySchemes": {
      "BrowserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__session",
        "description": "HMAC signed session ID verified against D1. Not proof of identity at session issuance."
      },
      "CloudflareAccess": {
        "type": "apiKey",
        "in": "header",
        "name": "Cf-Access-Jwt-Assertion",
        "description": "RS256 JWT verified against configured audience, issuer and JWKS. Staff application boundary, not domain RBAC."
      },
      "EmergencyBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Conditional configured break-glass only; disabled by default in production."
      },
      "EmergencyKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-admin-key",
        "description": "Conditional break-glass only."
      },
      "EmergencyBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "Conditional break-glass only."
      }
    },
    "responses": {
      "LegacyError": {
        "description": "Documented API failure. Internal details are suppressed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/LegacyError"
            }
          }
        }
      }
    }
  }
}
