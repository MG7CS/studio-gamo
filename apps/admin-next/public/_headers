# Static files (served before the Worker runs). HTML/API responses get their full header set,
# including the Content-Security-Policy, from middleware (packages/domain/src/http/security-headers.ts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
