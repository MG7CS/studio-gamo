---
/** Church verification (design §4.4): submitted → meeting scheduled → verified in person. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Notice from '../../components/Notice.astro';
import ReviewQueue from '../../components/ReviewQueue.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { loadQueue, outcomeFrom } from '../../lib/review-data';
import { CHURCH_ROLES } from '../../lib/review-scope';

const env = await getRuntimeEnv(Astro);
const queue = await loadQueue(env.DB, CHURCH_ROLES, Astro.url);
const outcome = outcomeFrom(Astro.url);
---

<AdminLayout title="Church verification" current="churches">
  <PageHeader
    title="Church verification"
    description="Churches are verified in person before they are listed: schedule the meeting, then verify with notes."
  />
  {outcome && <Notice tone={outcome.tone} text={outcome.text} />}
  <ReviewQueue basePath="/review/churches" queue={queue} emptyText="No churches in this state." />
</AdminLayout>
