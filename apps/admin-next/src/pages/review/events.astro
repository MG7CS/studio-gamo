---
/** First-event review: every organizer's first event is reviewed; later events publish unless "review every event" is on. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Notice from '../../components/Notice.astro';
import EventReviewList from '../../components/EventReviewList.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { loadPendingEvents, outcomeFrom } from '../../lib/review-data';

const env = await getRuntimeEnv(Astro);
const events = await loadPendingEvents(env.DB);
const outcome = outcomeFrom(Astro.url);
---

<AdminLayout title="First-event review" current="events">
  <PageHeader
    title="First-event review"
    description="Every organizer's first event is reviewed by staff; later events publish directly unless “review every event” is on."
  />
  {outcome && <Notice tone={outcome.tone} text={outcome.text} />}
  <EventReviewList events={events} />
</AdminLayout>
