---
/** Provider review queue: musicians, technicians, teachers, artists and agents. */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Notice from '../../../components/Notice.astro';
import ReviewQueue from '../../../components/ReviewQueue.astro';
import { getRuntimeEnv, roleLabel } from '@gamo/domain';
import { loadQueue, outcomeFrom } from '../../../lib/review-data';
import { PROVIDER_REVIEW_ROLES } from '../../../lib/review-scope';

const env = await getRuntimeEnv(Astro);
const queue = await loadQueue(env.DB, PROVIDER_REVIEW_ROLES, Astro.url);
const roles = PROVIDER_REVIEW_ROLES.map((r) => ({ value: r, label: roleLabel(r) }));
const outcome = outcomeFrom(Astro.url);
---

<AdminLayout title="Provider review" current="providers">
  <PageHeader
    title="Provider review"
    description="Musicians, technicians and teachers need staff verification before they are listed; artists and agents may ask for it."
  />
  {outcome && <Notice tone={outcome.tone} text={outcome.text} />}
  <ReviewQueue
    basePath="/review/providers"
    queue={queue}
    roles={roles}
    emptyText="No providers in this state."
  />
</AdminLayout>
