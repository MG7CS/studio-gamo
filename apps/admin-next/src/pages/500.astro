---
import AdminLayout from '../layouts/AdminLayout.astro';
import PageHeader from '../components/PageHeader.astro';

Astro.response.status = 500;
---

<AdminLayout title="Something went wrong">
  <PageHeader
    title="Something went wrong"
    description="The page could not be loaded. Try again in a moment."
  />
  <a
    href="/participation"
    class="inline-flex min-h-11 items-center text-sm font-semibold text-charcoal underline"
  >
    Back to the work queues
  </a>
</AdminLayout>
