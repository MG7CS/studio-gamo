---
/** Sign-out confirmation (GET) and sign-out (same-origin POST). Signing out is never a side effect of a GET. */
import AdminLayout from '../layouts/AdminLayout.astro';
import Notice from '../components/Notice.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { AuthError } from '@gamo/auth';
import { isLocalRuntime, signOut } from '../lib/gate';

const env = await getRuntimeEnv(Astro);
const signedIn = Astro.locals.adminAuthSession !== undefined;
let done = false;
let refused = false;

if (Astro.request.method === 'POST') {
  try {
    const cookies = await signOut(Astro.request, env, !isLocalRuntime(env, Astro.url));
    for (const cookie of cookies) Astro.response.headers.append('Set-Cookie', cookie);
    done = true;
  } catch (error) {
    if (!(error instanceof AuthError)) throw error;
    refused = true;
    Astro.response.status = 403;
  }
}
---

<AdminLayout title="Sign out" shell="gate">
  <h1 class="text-2xl font-black uppercase leading-tight tracking-tight">Sign out</h1>
  <div class="mt-6">
    {refused && <Notice tone="error" text="That request came from another site and was refused." />}
    {done && <Notice tone="success" text="You have been signed out of Gamo Studios Operations." />}
  </div>
  {done || !signedIn ? (
    <p class="text-sm text-ink-soft">
      {!done && 'You are not signed in. '}
      <a href="/signin" class="inline-flex min-h-11 items-center font-semibold text-charcoal underline">
        Go to staff sign-in
      </a>
    </p>
  ) : (
    <form method="post" action="/signout" class="rounded-2xl border border-sand bg-white p-5">
      <p class="text-sm">Sign out of the admin on this device?</p>
      <button
        type="submit"
        class="mt-4 inline-flex min-h-11 items-center rounded-full bg-terracotta-deep px-5 text-sm font-semibold text-white"
      >
        Sign out
      </button>
      <a href="/" class="ml-3 inline-flex min-h-11 items-center text-sm font-semibold underline">
        Cancel
      </a>
    </form>
  )}
</AdminLayout>
