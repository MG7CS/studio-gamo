---
/**
 * The only document shell in this app. `shell="app"` is the signed-in workspace (sidebar, account, counts);
 * `shell="gate"` is the centered card used by sign-in, sign-out and as the fallback when no staff session is
 * present. Every page, including 404 and 500, renders through this layout, so nothing here ever falls
 * back to the public Gamo layout. `data-admin-shell` marks the document for tests.
 */
import '../app.css';
import HeadIcons from '@studio-gamo/ui/components/HeadIcons.astro';
import FontPreload from '@studio-gamo/ui/components/FontPreload.astro';
import Logo from '@studio-gamo/ui/components/Logo.astro';
import { getRuntimeEnv } from '@gamo/domain';
import AccountFooter from '../components/AccountFooter.astro';
import SideNav from '../components/SideNav.astro';
import { loadQueueCounts } from '../lib/queue-counts';
import type { NavKey } from '../lib/nav';

interface Props {
  title: string;
  current?: NavKey | null;
  shell?: 'app' | 'gate';
}
const { title, current = null, shell = 'app' } = Astro.props;

// The workspace chrome (and its database reads) only exists for a verified staff session.
const session = Astro.locals.adminAuthSession ?? null;
const showWorkspace = shell === 'app' && session !== null;
let counts = null;
if (showWorkspace) {
  const env = await getRuntimeEnv(Astro);
  counts = await loadQueueCounts(env.DB, session.user.id);
}
const email = session?.user.email ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <HeadIcons />
    <FontPreload />
    <title>{`${title} · Gamo Studios Operations`}</title>
  </head>
  <body
    class="bg-ivory font-sans text-[15px] leading-6 text-charcoal antialiased"
    data-admin-shell={showWorkspace ? 'app' : 'gate'}
  >
    {showWorkspace ? (
      <>
        <a
          href="#admin-main"
          class="sr-only z-50 rounded bg-charcoal px-3 py-2 text-cream focus:not-sr-only focus:fixed focus:left-3 focus:top-3"
        >
          Skip to content
        </a>
        <div class="lg:grid lg:min-h-screen lg:grid-cols-[272px_minmax(0,1fr)]">
          <aside class="hidden bg-charcoal lg:block">
            <div class="sticky top-0 flex max-h-screen flex-col gap-6 overflow-y-auto px-3 py-6">
              <p class="px-3 text-cream">
                <Logo width={132} height={24} />
                <span class="mt-2 block text-xs font-semibold uppercase tracking-widest text-cream/70">
                  Operations
                </span>
              </p>
              <SideNav current={current} counts={counts} idPrefix="desktop" />
              <AccountFooter email={email} />
            </div>
          </aside>
          <div class="min-w-0">
            <details class="bg-charcoal lg:hidden">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between px-4 text-cream">
                <Logo width={110} height={20} />
                <span class="text-sm font-semibold">Menu</span>
              </summary>
              <div class="space-y-6 px-3 pb-6 pt-2">
                <SideNav current={current} counts={counts} idPrefix="mobile" />
                <AccountFooter email={email} />
              </div>
            </details>
            <main id="admin-main" class="mx-auto max-w-5xl px-4 py-8 sm:px-8 sm:py-12">
              <slot />
            </main>
          </div>
        </div>
      </>
    ) : (
      <main
        id="admin-main"
        class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-4 py-10"
      >
        <p class="mb-8 text-charcoal">
          <Logo width={132} height={24} />
          <span class="mt-2 block text-xs font-semibold uppercase tracking-widest text-ink-soft">
            Operations
          </span>
        </p>
        <slot />
      </main>
    )}
  </body>
</html>
