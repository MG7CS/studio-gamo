---
/**
 * Administrator email + password form.
 *
 * Founder exception (shared authentication rule, AGENTS.md): the admin app signs staff in with this
 * password gateway behind Cloudflare Access instead of the shared `GamoAuthExperience` account flows,
 * because staff accounts are provisioned by the owner and never self-register. Approved by the founder
 * on 2026-10-19 with the admin rebuild.
 */
import Notice from './Notice.astro';

interface Props {
  email?: string;
  next?: string;
  error?: string;
  notice?: string;
}
const { email = '', next = '', error, notice } = Astro.props;
---

<h1 class="text-2xl font-black uppercase leading-tight tracking-tight">Staff sign-in</h1>
<p class="mt-3 text-base text-ink-soft">Sign in with your Gamo Studios administrator email and password.</p>
<div class="mt-6">
  {notice && <Notice tone="info" text={notice} />}
  {error && <Notice tone="error" text={error} />}
</div>
<form method="post" action="/signin" class="space-y-4 rounded-2xl border border-sand bg-white p-5">
  {next && <input type="hidden" name="next" value={next} />}
  <div>
    <label for="admin-email" class="block text-sm font-semibold">
      Administrator email
    </label>
    <input
      id="admin-email"
      name="email"
      type="email"
      required
      autocomplete="username"
      value={email}
      class="mt-1 block min-h-11 w-full rounded-xl border border-ink/50 bg-white px-3 text-sm"
    />
  </div>
  <div>
    <label for="admin-password" class="block text-sm font-semibold">
      Password
    </label>
    <input
      id="admin-password"
      name="password"
      type="password"
      required
      autocomplete="current-password"
      class="mt-1 block min-h-11 w-full rounded-xl border border-ink/50 bg-white px-3 text-sm"
    />
  </div>
  <button
    type="submit"
    class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-terracotta-deep px-5 text-sm font-semibold text-white"
  >
    Sign in
  </button>
</form>
