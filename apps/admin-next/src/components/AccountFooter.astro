---
/** Who is signed in, and the way out. Sign-out is a link to a confirmation page (no sign-out by GET). */
interface Props {
  email: string;
}
const { email } = Astro.props;
---

<div class="border-t border-white/10 px-3 pt-4 text-cream">
  <p class="text-xs uppercase tracking-wider text-cream/70">Signed in as</p>
  <p class="mt-1 break-all text-sm font-medium">{email}</p>
  <a
    href="/signout"
    class="mt-3 flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold hover:bg-white/10"
  >
    Sign out
  </a>
</div>
