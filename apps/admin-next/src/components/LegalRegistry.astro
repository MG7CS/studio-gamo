---
/** The terms registry: one card per document with its version, review status and acceptance count. */
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import type { LegalSummary } from '../lib/legal-data';

interface Props {
  summary: LegalSummary;
}
const { summary } = Astro.props;
const count = (n: number | null) => (n === null ? 'Unavailable' : String(n));
---

<dl class="mb-8 grid gap-4 sm:grid-cols-3">
  <div class="rounded-2xl border border-sand bg-white p-5">
    <dt class="text-sm text-ink-soft">Documents in the registry</dt>
    <dd class="mt-1 text-3xl font-black">{summary.documents}</dd>
  </div>
  <div class="rounded-2xl border border-sand bg-white p-5">
    <dt class="text-sm text-ink-soft">Legal review complete</dt>
    <dd class="mt-1 text-3xl font-black">
      {summary.reviewed} of {summary.documents}
    </dd>
  </div>
  <div class="rounded-2xl border border-sand bg-white p-5">
    <dt class="text-sm text-ink-soft">Recorded acceptances (all versions)</dt>
    <dd class="mt-1 text-3xl font-black">{count(summary.totalAcceptances)}</dd>
  </div>
</dl>

<ul class="space-y-4">
  {summary.rows.map(({ doc, accepted }) => (
    <li class="rounded-2xl border border-sand bg-white p-5">
      <h2 class="text-lg font-semibold">{doc.title}</h2>
      <p class="mt-1 text-sm text-ink-soft">{doc.summary}</p>
      <dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
        <div>
          <dt class="font-semibold">Slug</dt>
          <dd class="break-all">{doc.slug}</dd>
        </div>
        <div>
          <dt class="font-semibold">Version</dt>
          <dd class="break-all">{doc.version}</dd>
        </div>
        <div>
          <dt class="font-semibold">Status</dt>
          <dd>{doc.status === 'draft' ? 'Draft' : doc.status}</dd>
        </div>
        <div>
          <dt class="font-semibold">Legal review</dt>
          <dd>{doc.legalReviewStatus === 'draft_requires_review' ? 'Requires review' : 'Reviewed'}</dd>
        </div>
        <div>
          <dt class="font-semibold">Acceptances (this version)</dt>
          <dd>{count(accepted)}</dd>
        </div>
        <div>
          <dt class="font-semibold">Public page</dt>
          <dd>
            <a
              href={siteUrl('web', doc.path)}
              class="inline-flex min-h-11 items-center break-all font-semibold underline"
            >
              {siteUrl('web', doc.path)}
            </a>
          </dd>
        </div>
      </dl>
    </li>
  ))}
</ul>
