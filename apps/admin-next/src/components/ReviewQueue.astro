---
/** A provider/church review queue: status and role filters, then the profiles (oldest first). */
import EmptyState from './EmptyState.astro';
import { QUEUE_LIMIT, type QueueView } from '../lib/review-data';

interface Props {
  basePath: string;
  queue: QueueView;
  roles?: { value: string; label: string }[];
  emptyText: string;
}
const { basePath, queue, roles = [], emptyText } = Astro.props;
const { filter, filters, items, roleFilter, truncated } = queue;
const filterLabels: Record<string, string> = {
  open: 'Waiting for staff',
  changes_requested: 'Changes requested',
  verified: 'Verified',
  rejected: 'Rejected',
  suspended: 'Suspended',
  draft: 'Drafts',
};
const date = (s: number) =>
  new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'America/Phoenix' }).format(
    new Date(s * 1000),
  );
const href = (status: string, role?: string | null) => {
  const p = new URLSearchParams({ status });
  if (role) p.set('role', role);
  return `${basePath}?${p}`;
};
---

<nav aria-label="Filter by status" class="mb-3 flex flex-wrap gap-2">
  {filters.map((f) => (
    <a
      href={href(f, roleFilter)}
      aria-current={f === filter ? 'page' : undefined}
      class:list={[
        'inline-flex min-h-11 items-center rounded-full px-4 text-sm font-semibold',
        f === filter ? 'bg-charcoal text-cream' : 'bg-white text-charcoal ring-1 ring-sand',
      ]}
    >
      {filterLabels[f] ?? f}
    </a>
  ))}
</nav>
{roles.length > 1 && (
  <nav aria-label="Filter by role" class="mb-5 flex flex-wrap gap-2">
    {[{ value: '', label: 'All roles' }, ...roles].map((r) => (
      <a
        href={href(filter, r.value || null)}
        aria-current={(roleFilter ?? '') === r.value ? 'page' : undefined}
        class:list={[
          'inline-flex min-h-11 items-center rounded-full px-4 text-sm font-medium',
          (roleFilter ?? '') === r.value
            ? 'bg-terracotta-deep text-white'
            : 'bg-white text-charcoal ring-1 ring-sand',
        ]}
      >
        {r.label}
      </a>
    ))}
  </nav>
)}
{items.length === 0 ? (
  <EmptyState text={emptyText} />
) : (
  <>
    <ul class="divide-y divide-sand rounded-2xl border border-sand bg-white">
      {items.map((item) => (
        <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
          <div class="min-w-0">
            <a
              href={item.href}
              class="inline-flex min-h-11 items-center font-semibold text-charcoal underline"
            >
              {item.displayName}
            </a>
            <p class="text-sm text-ink-soft">
              {item.roleLabel} · from {item.productOrigin} · updated {date(item.updatedAt)}
            </p>
          </div>
          <span class="rounded-full bg-cream px-3 py-1 text-xs font-semibold text-charcoal">
            {item.statusLabel}
          </span>
        </li>
      ))}
    </ul>
    {truncated && (
      <p class="mt-3 text-sm text-ink-soft">Showing the first {QUEUE_LIMIT}. Older entries are not listed.</p>
    )}
  </>
)}
