---
/** Change the administrator password. All three fields are required; the server checks the current one. */
interface Props {
  email: string;
  /** The user is still on a temporary password. */
  temporary: boolean;
}
const { email, temporary } = Astro.props;
const field = 'mt-1 block min-h-11 w-full rounded-xl border border-ink/50 bg-white px-3 text-sm';
---

<form
  method="post"
  action="/security"
  class="max-w-2xl space-y-4 rounded-2xl border border-sand bg-white p-5"
>
  <div>
    <label for="sec-email" class="block text-sm font-semibold">
      Administrator email
    </label>
    <input id="sec-email" type="email" value={email} readonly class={`${field} bg-cream/60`} />
  </div>
  <div>
    <label for="sec-current-password" class="block text-sm font-semibold">
      {temporary ? 'Temporary password' : 'Current password'}
    </label>
    <input
      id="sec-current-password"
      name="currentPassword"
      type="password"
      required
      autocomplete="current-password"
      class={field}
    />
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="sec-new-password" class="block text-sm font-semibold">
        New password
      </label>
      <input
        id="sec-new-password"
        name="newPassword"
        type="password"
        required
        minlength="8"
        maxlength="128"
        autocomplete="new-password"
        aria-describedby="sec-password-hint"
        class={field}
      />
    </div>
    <div>
      <label for="sec-confirm-password" class="block text-sm font-semibold">
        Confirm new password
      </label>
      <input
        id="sec-confirm-password"
        name="confirmPassword"
        type="password"
        required
        minlength="8"
        maxlength="128"
        autocomplete="new-password"
        class={field}
      />
    </div>
  </div>
  <p id="sec-password-hint" class="text-sm text-ink-soft">
    At least 8 characters.
  </p>
  <button
    type="submit"
    class="inline-flex min-h-11 items-center rounded-full bg-terracotta-deep px-6 text-sm font-semibold text-white"
  >
    Update password
  </button>
</form>
