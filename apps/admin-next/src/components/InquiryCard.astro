---
/**
 * One participation inquiry. The update below is shown to the person who wrote it, and reviewing does not
 * grant program access, approve a partnership or send a notification. Staff cannot review their own inquiry.
 */
import type { InquiryRow } from '../lib/participation-data';

interface Props {
  inquiry: InquiryRow;
  /** The signed-in staff user's id. */
  staffUserId: string;
}
const { inquiry, staffUserId } = Astro.props;
const received = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'medium',
  timeZone: 'America/Phoenix',
}).format(new Date(inquiry.createdAt * 1000));
const statusLabel = { pending: 'Waiting for review', reviewed: 'Reviewed', closed: 'Closed' }[inquiry.status];
const canReview = inquiry.status !== 'closed' && inquiry.userId !== staffUserId;
const field = 'mt-1 block min-h-11 w-full rounded-xl border border-ink/50 bg-white px-3 py-2 text-sm';
---

<li class="rounded-2xl border border-sand bg-white p-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <h2 class="text-lg font-semibold text-charcoal">
      {inquiry.interest} · {inquiry.name}
    </h2>
    <span class="rounded-full bg-cream px-3 py-1 text-xs font-semibold text-charcoal">{statusLabel}</span>
  </div>
  <p class="mt-1 text-sm text-ink-soft">
    {inquiry.kind} · {inquiry.organization || 'No organization supplied'} · received {received} · {inquiry.id}
  </p>
  <p class="mt-4 whitespace-pre-wrap">{inquiry.message}</p>
  {inquiry.reviewNotes && (
    <p class="mt-4 whitespace-pre-wrap text-sm">
      <strong>Last update: </strong>
      {inquiry.reviewNotes}
    </p>
  )}
  {inquiry.userId === staffUserId && inquiry.status !== 'closed' && (
    <p class="mt-4 text-sm text-ink-soft">
      This is your own inquiry, so another staff member must review it.
    </p>
  )}
  {canReview && (
    <form method="post" action="/participation" class="mt-5 max-w-2xl space-y-3">
      <input type="hidden" name="id" value={inquiry.id} />
      <div>
        <label class="block text-sm font-semibold" for={`notes-${inquiry.id}`}>
          Update for the participant
        </label>
        <textarea
          id={`notes-${inquiry.id}`}
          name="notes"
          required
          minlength="1"
          maxlength="2000"
          rows="3"
          class={field}
        ></textarea>
      </div>
      <div>
        <label class="block text-sm font-semibold" for={`status-${inquiry.id}`}>
          Status
        </label>
        <select id={`status-${inquiry.id}`} name="status" class={field}>
          <option value="reviewed">Reviewed</option>
          <option value="closed">Closed</option>
        </select>
      </div>
      <button
        type="submit"
        class="inline-flex min-h-11 items-center rounded-full bg-terracotta-deep px-5 text-sm font-semibold text-white"
      >
        Save review
      </button>
    </form>
  )}
</li>
