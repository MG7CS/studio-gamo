---
/** A message to the signed-in staff user. Errors are announced as alerts, the rest as status updates. */
interface Props {
  tone: 'success' | 'error' | 'warning' | 'info';
  title?: string;
  text: string;
}
const { tone, title, text } = Astro.props;
const styles = {
  success: 'border-emerald-300 bg-emerald-50',
  error: 'border-terracotta-deep bg-white ring-1 ring-terracotta-deep',
  warning: 'border-amber-300 bg-amber-50',
  info: 'border-sand bg-white',
} as const;
---

<div
  role={tone === 'error' ? 'alert' : 'status'}
  class:list={['mb-5 rounded-xl border px-4 py-3 text-sm text-charcoal', styles[tone]]}
>
  {tone === 'error' && <span class="sr-only">Error: </span>}
  {title && <strong class="font-semibold">{title}. </strong>}
  {text}
</div>
