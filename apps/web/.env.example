# Gamo Studios (apps/web) — Application Local Environment Template (.env.example)
# Copy to apps/web/.env (or apps/web/.dev.vars) after provisioning Gamo Studios' dedicated Clerk application.
# NEVER reuse Gamo Live (app_3KlWyOBL2xL2YzhJuvgk8QdrWIt) credentials here.

# Standard Clerk SDK variable names (automatically mapped to *_WEB by @gamo/config/env-loader)
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_WEB_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_WEB_SECRET"

# Product-scoped Clerk metadata & optional explicit suffixed overrides
PUBLIC_CLERK_KEYLESS_DISABLED="true"
CLERK_KEYLESS_DISABLED="true"
CLERK_APP_ID_WEB="pending_clerk_app_gamo_web"
PUBLIC_CLERK_PUBLISHABLE_KEY_WEB="pk_test_YOUR_WEB_KEY"
CLERK_SECRET_KEY_WEB="sk_test_YOUR_WEB_SECRET"
CLERK_JWT_KEY_WEB=""
CLERK_ISSUER_WEB=""
CLERK_AUTHORIZED_PARTIES_WEB="http://127.0.0.1:4321,http://localhost:4321,https://gamostudio.org,https://www.gamostudio.org"
