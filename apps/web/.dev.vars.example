# Gamo Studios (apps/web) — Local Worker Secrets Example (.dev.vars.example)
# Copy to apps/web/.dev.vars after provisioning the dedicated Gamo Studios Clerk application.
# NEVER reuse Gamo Live (app_3KlWyOBL2xL2YzhJuvgk8QdrWIt) credentials here.
# Shared local settings (ENVIRONMENT, SESSION_SECRET, RESEND_API_KEY, etc.) are inherited from root .dev.vars / .env.

# Clerk — Gamo Studios Dedicated Application (Pending Founder Provisioning)
PUBLIC_CLERK_KEYLESS_DISABLED="true"
CLERK_KEYLESS_DISABLED="true"
CLERK_APP_ID_WEB="pending_clerk_app_gamo_web"
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_WEB_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_WEB_SECRET"
CLERK_JWT_KEY_WEB=""
CLERK_ISSUER_WEB=""
CLERK_AUTHORIZED_PARTIES_WEB="http://127.0.0.1:4321,http://localhost:4321,https://gamostudio.org,https://www.gamostudio.org"
