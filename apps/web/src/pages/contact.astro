---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactIntroduction from '../components/organization/ContactIntroduction.astro';
import EmailContact from '../components/organization/EmailContact.astro';
---

<SiteLayout
  title="Contact | Gamo Studios"
  description="Contact the Gamo Studios team about a program, a way to serve or a collaboration. Local programs start in Phoenix, Arizona."
>
  <section class="px-5 page-intro-space sm:px-12">
    <div class="mx-auto grid max-w-[1320px] items-start gap-10 lg:grid-cols-2 lg:gap-24">
      <ContactIntroduction />
      <EmailContact />
    </div>
  </section>
</SiteLayout>
