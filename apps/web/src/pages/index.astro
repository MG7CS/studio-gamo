---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeEditorialHero from '../components/home/HomeEditorialHero.astro';
import ProgramsShowcase from '../components/organization/ProgramsShowcase.astro';
import PathChooser from '../components/organization/PathChooser.astro';
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { siteOrigin } from '@studio-gamo/ui/lib/sites';
import { programs } from '../data/programs';

const origin = siteOrigin('web');
// Organization facts only: name, URLs, logo, description and the three programs (owner order). No legal-status claims.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${origin}/#organization`,
  name: 'Gamo Studios',
  url: origin,
  logo: `${origin}/logo-512.png`,
  description:
    'Gamo Studios is a Christian, mission-driven Public Benefit Corporation that brings together three connected programs serving students, families, churches and musicians: teaching instruments, preparing worship teams and supporting technical ministry.',
  subOrganization: programs.map((p) => ({ '@type': 'Organization', name: p.name, url: siteOrigin(p.key) })),
};
---

<SiteLayout
  jsonLd={organizationJsonLd}
  title="Gamo Studios — Music Education, Worship & Technical Ministry"
  description="Gamo Studios connects Academy, Worship and Production to serve students, families, churches and musicians through music and worship."
>
  <HomeEditorialHero />
  <ProgramsShowcase
    id="programs"
    eyebrow="One mission · three programs"
    title="Three connected ways we serve together."
    intro="Gamo Academy, Gamo Worship and Gamo Production serve one religious and educational mission. Each program has its own site with the details."
    action={{ label: 'Read our mission', href: '/mission' }}
  />
  <Section title="Find your place in the mission.">
    <Fragment slot="eyebrow">Where to begin</Fragment>
    <p slot="intro">
      Learning an instrument, leading a congregation, playing in a worship team or serving behind the sound
      board: start here.
    </p>
    <ButtonLink slot="actions" href="/get-involved" variant="secondary" arrow>
      See every way to get involved
    </ButtonLink>
    <PathChooser />
  </Section>
  <CtaInvitation
    eyebrow="Join the mission"
    title="Ready to take your first step with Gamo Studios?"
    body="Find your place in Academy, Worship or Production, or talk with us about how your church or community can partner with us."
    photo="chapelSpring"
  >
    <ButtonLink href="/get-started" arrow>
      Find your first step
    </ButtonLink>
    <ButtonLink href="/partners" variant="secondary">
      Explore church partnerships
    </ButtonLink>
  </CtaInvitation>
</SiteLayout>
