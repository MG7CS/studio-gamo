---
import SiteLayout from '../layouts/SiteLayout.astro';
import OrganizationHero from '../components/organization/OrganizationHero.astro';
import SupportPathways from '../components/organization/SupportPathways.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<SiteLayout
  title="Support Our Mission | Gamo Studios"
  description="Support is more than financial: teaching, mentoring, technical skills and welcoming spaces all help sustain the Gamo Studios mission."
>
  <OrganizationHero
    title="Make room for"
    accent="what music can do."
    photo="girlGuitar"
    photoRatio="portrait"
    tone="inset"
  >
    <ButtonLink href="#support-paths" arrow>
      Explore ways to support
    </ButtonLink>
    <ButtonLink href="/contact?interest=Mission%20support" variant="secondary">
      Start an inquiry
    </ButtonLink>
  </OrganizationHero>
  <SupportPathways />
  <CtaInvitation title="Serve with the gifts you already have." photo="guitarMentor">
    <ButtonLink href="/get-involved" arrow>
      Get involved
    </ButtonLink>
  </CtaInvitation>
</SiteLayout>
