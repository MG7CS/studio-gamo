---
import SiteLayout from '../layouts/SiteLayout.astro';
import OrganizationHero from '../components/organization/OrganizationHero.astro';
import SupportPathways from '../components/organization/SupportPathways.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<SiteLayout
  title="Support Our Mission | Gamo Studios"
  description="Support is more than money: teaching, mentoring, technical skills and welcoming spaces all help sustain the Gamo Studios mission."
>
  <OrganizationHero
    eyebrow="Sustain a shared purpose"
    title="Make room for"
    accent="what music can do."
    body="Help shape chances to learn, worship and gather. See the practical ways people and organizations can sustain the mission."
    photo="girlGuitar"
    inset="churchGoldenHour"
    variant="support"
  >
    <ButtonLink href="#support-paths" arrow>
      Ways to support
    </ButtonLink>
    <ButtonLink href="/contact?interest=Mission%20support" variant="secondary">
      Start an inquiry
    </ButtonLink>
  </OrganizationHero>
  <SupportPathways />
  <CtaInvitation
    eyebrow="Your time matters too"
    title="Serve with the gifts you already have."
    body="Support is more than money. Teaching, mentoring, technical skills and welcoming spaces all have a place."
    photo="guitarMentor"
  >
    <ButtonLink href="/get-involved" arrow>
      Get involved
    </ButtonLink>
  </CtaInvitation>
</SiteLayout>
