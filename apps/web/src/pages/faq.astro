---
import SiteLayout from '../layouts/SiteLayout.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import FaqAccordion from '@studio-gamo/ui/components/FaqAccordion.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { generalFaq } from '../data/organization';
---

<SiteLayout
  title="Frequently Asked Questions | Gamo Studios"
  description="Answers to common questions about the Gamo Studios mission and how churches, learners and musicians can take part."
>
  <section class="px-5 page-intro-space sm:px-12">
    <div class="mx-auto max-w-[1050px]">
      <EditorialHeading
        eyebrow="A little more clarity"
        eyebrowStyle="pill"
        title="Good questions."
        accent="Honest answers."
        as="h1"
        size="display"
        lede="About our mission, our programs, and how churches, families and musicians take part."
      />
      <FaqAccordion items={generalFaq} class="mt-10" />
      <div class="button-stack mt-8">
        <ButtonLink href="/contact" arrow>
          Contact our team
        </ButtonLink>
      </div>
    </div>
  </section>
</SiteLayout>
