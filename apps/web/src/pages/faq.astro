---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FaqAccordion from '@studio-gamo/ui/components/FaqAccordion.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { generalFaq } from '../data/organization';
---

<SiteLayout
  title="Frequently Asked Questions | Gamo Studios"
  description="Answers to common questions about the Gamo Studios mission, its three programs, and how families, churches and musicians can take part."
>
  <PageHero width="narrow">
    <Fragment slot="title">
      Good questions. <span class="block text-action">Honest answers.</span>
    </Fragment>
  </PageHero>
  <Section width="narrow" spacing="none" class="pb-20">
    <FaqAccordion items={generalFaq} />
    <div class="mt-10">
      <ButtonLink href="/contact" arrow>
        Contact our team
      </ButtonLink>
    </div>
  </Section>
</SiteLayout>
