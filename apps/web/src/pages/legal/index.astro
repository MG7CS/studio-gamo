---
/** gamostudio.org/legal — index of the draft legal documents (design §4.5). Rendered on demand. */
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import LegalDraftBanner from '@studio-gamo/ui/components/legal/LegalDraftBanner.astro';
import LegalIndexList from '@studio-gamo/ui/components/legal/LegalIndexList.astro';
import { TERMS_DOCUMENTS } from '@gamo/domain/terms';

const documents = TERMS_DOCUMENTS.map((doc) => ({
  title: doc.title,
  summary: doc.summary,
  href: doc.path,
  version: doc.version,
}));
---

<SiteLayout
  title="Legal & Privacy | Gamo Studios"
  description="Draft Site Terms, Privacy Policy, Provider and Church Terms and Academy Enrollment Terms for Gamo Studios programs."
>
  <PageHero width="narrow">
    <Fragment slot="title">
      Legal &amp; privacy <span class="block text-action">documents.</span>
    </Fragment>
  </PageHero>
  <Section width="narrow" spacing="none" class="pb-20">
    <LegalDraftBanner>
      Every document below is a working draft that has not been reviewed by a lawyer and is not yet in effect.
      Questions? Use the{' '}
      <a
        href="/contact"
        class="inline-flex min-h-11 items-center font-semibold text-action-strong underline underline-offset-4 hover:text-action"
      >
        contact form
      </a>
      .
    </LegalDraftBanner>
    <LegalIndexList documents={documents} />
  </Section>
</SiteLayout>
