---
import SiteLayout from '../layouts/SiteLayout.astro';
import OrganizationHero from '../components/organization/OrganizationHero.astro';
import ParticipationPaths from '../components/organization/ParticipationPaths.astro';
import CtaInvitation from '@gamo/site/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<SiteLayout
  title="Get Involved | Gamo Studios"
  description="Find a practical way to take part in the Gamo Studios mission: a musical gift, a welcoming space, teaching, technical knowledge or community connections."
>
  <OrganizationHero
    eyebrow="People · learning · serving"
    title="There's a place"
    accent="for you here."
    body="A musical gift. A welcoming space. A willingness to serve. Find a practical way to take part."
    photo="guitarMentor"
    inset="chapelSpring"
    variant="collage"
  >
    <ButtonLink href="#paths" arrow>
      Find your path
    </ButtonLink>
    <ButtonLink href="/mission" variant="secondary">
      Our mission
    </ButtonLink>
  </OrganizationHero>
  <ParticipationPaths />
  <CtaInvitation
    eyebrow="Something else in mind?"
    title="Start with what you can share."
    body="Facilities, instruments, teaching, technical knowledge and community connections all help. Tell us your idea."
    photo="sanctuaryCongregation"
  >
    <ButtonLink href="/contact?interest=Volunteering" arrow>
      Send an inquiry
    </ButtonLink>
  </CtaInvitation>
</SiteLayout>
