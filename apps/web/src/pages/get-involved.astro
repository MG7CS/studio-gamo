---
import SiteLayout from '../layouts/SiteLayout.astro';
import OrganizationHero from '../components/organization/OrganizationHero.astro';
import ParticipationPaths from '../components/organization/ParticipationPaths.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<SiteLayout
  title="Get Involved | Gamo Studios"
  description="Find a practical way to take part in the Gamo Studios mission: a musical gift, a welcoming space, teaching, technical knowledge or community connections."
>
  <OrganizationHero title="There's a place" accent="for you here." photo="instrumentMusicTheory">
    <ButtonLink href="#paths" arrow>
      Find your path
    </ButtonLink>
    <ButtonLink href="/mission" variant="secondary">
      Our mission
    </ButtonLink>
  </OrganizationHero>
  <ParticipationPaths />
  <CtaInvitation title="Start with what you can share." photo="techSlides">
    <ButtonLink href="/contact?interest=Volunteering" arrow>
      Send an inquiry
    </ButtonLink>
  </CtaInvitation>
</SiteLayout>
