---
import SiteLayout from '../../layouts/SiteLayout.astro';
import FormPageView from '../../components/forms/FormPageView.astro';
import { loadFormPage } from '../../lib/form-page';
import { siteUrl } from '@studio-gamo/ui/lib/sites';

export const prerender = false;

const page = await loadFormPage(Astro, 'academy-teach');
if ('response' in page) return page.response;
---

<SiteLayout
  footer={false}
  title="Apply to Teach | Gamo Academy"
  description="Instructors can apply to teach private, small-group and community lessons with Gamo Academy."
>
  <FormPageView
    page={page}
    fallbackTitle="Apply to teach"
    backHref={siteUrl('academy')}
    backLabel="Back to Gamo Academy"
  />
</SiteLayout>
