---
/**
 * Gamo Live Marketing Page on Gamo Studios (`apps/web/src/pages/live.astro` -> `/live`).
 * Loads real published Christian concerts and worship gatherings directly from the D1 `events`
 * database via `LiveService`, and enforces the Past Event Closure Rule so any event whose
 * date/time has passed is clearly marked `Past · Closed`.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import { getDb } from '@gamo/db';
import { LiveService, getRuntimeEnv } from '@gamo/domain';
import EventSpotlightHero from '../components/live/EventSpotlightHero.astro';
import NearbyRail from '../components/live/NearbyRail.astro';
import BrowsePlaceDate from '../components/live/BrowsePlaceDate.astro';
import GospelConcerts from '../components/live/GospelConcerts.astro';
import WorshipAndRecurring from '../components/live/WorshipAndRecurring.astro';
import ConferencesYouth from '../components/live/ConferencesYouth.astro';
import FreeAndTicketed from '../components/live/FreeAndTicketed.astro';
import LiveEcosystemPillars from '../components/live/LiveEcosystemPillars.astro';
import FeaturedOrganizers from '../components/live/FeaturedOrganizers.astro';
import TrustLegend from '../components/live/TrustLegend.astro';
import {
  buildOrganizersFromEvents,
  buildVerifiedCatalogFallbackEvents,
  mapDbEventsToMarketingEvents,
  type LiveEvent,
} from '../data/live-marketing';

export const prerender = false;

const now = new Date();
let liveEvents: LiveEvent[];

try {
  const env = await getRuntimeEnv(Astro);
  const liveService = new LiveService(getDb(env.DB));
  await liveService.ensureVerifiedCatalogSeeded();
  const dbEvents = await liveService.listDiscoverableEvents({ limit: 100 });
  if (dbEvents.length > 0) {
    liveEvents = mapDbEventsToMarketingEvents(dbEvents, now);
  } else {
    liveEvents = buildVerifiedCatalogFallbackEvents(now);
  }
} catch {
  liveEvents = buildVerifiedCatalogFallbackEvents(now);
}

const organizers = buildOrganizersFromEvents(liveEvents);
const upcomingEvents = liveEvents.filter((e) => !e.isPast && e.status !== 'canceled');
const activeOrAll = upcomingEvents.length > 0 ? upcomingEvents : liveEvents;

const featured = activeOrAll.filter((e) => e.featured).slice(0, 4);
const spotlightSlides = featured.length > 0 ? featured : activeOrAll.slice(0, 4);

const nearbyEvents = [
  ...upcomingEvents.slice(0, 7),
  ...liveEvents.filter((e) => e.isPast).slice(0, Math.max(0, 7 - upcomingEvents.length)),
];

const concertEvents = liveEvents.filter((e) => e.category === 'concert');
const worshipEvents = liveEvents.filter((e) => e.category === 'worship');
const secondaryWorshipOrRegional =
  liveEvents.filter((e) => e.category !== 'concert').length >= 3
    ? liveEvents.filter((e) => e.category !== 'concert').slice(0, 3)
    : liveEvents.slice(4, 7);

const conferenceOrArenaEvents =
  liveEvents.filter((e) => e.category === 'conference').length > 0
    ? liveEvents.filter((e) => e.category === 'conference')
    : liveEvents.filter((e) => /arena|forum|center|theater|theatre/i.test(e.venue)).slice(0, 2);

const youthOrChurchEvents =
  liveEvents.filter((e) => e.category === 'youth').length > 0
    ? liveEvents.filter((e) => e.category === 'youth').slice(0, 3)
    : liveEvents.filter((e) => /church|chapel|worship|hall/i.test(e.venue)).slice(0, 3);

const freeOrChurchEvents =
  liveEvents.filter((e) => e.ticketing === 'free').length > 0
    ? liveEvents.filter((e) => e.ticketing === 'free').slice(0, 5)
    : liveEvents.filter((e) => e.category === 'worship' || /church/i.test(e.venue)).slice(0, 5);

const ticketedEvents = liveEvents.filter((e) => e.ticketing !== 'free').slice(0, 5);

---

<SiteLayout
  title="Gamo Live — Christian Concerts, Worship Gatherings & Event Promotion | Gamo Studios"
  description="Find verified Christian concerts, worship nights and ministry gatherings across the U.S., or submit your own Christian event to Gamo Live for review."
  current="live"
  headerTheme="dark"
>
  <EventSpotlightHero slides={spotlightSlides} organizers={organizers} />
  <NearbyRail events={nearbyEvents} />
  <BrowsePlaceDate events={liveEvents} />
  <GospelConcerts events={concertEvents.slice(0, 4)} />
  <WorshipAndRecurring
    worship={worshipEvents.length > 0 ? worshipEvents : concertEvents.slice(0, 2)}
    recurring={secondaryWorshipOrRegional}
    organizers={organizers}
  />
  <ConferencesYouth
    conferences={conferenceOrArenaEvents.length > 0 ? conferenceOrArenaEvents : liveEvents.slice(0, 2)}
    youth={youthOrChurchEvents.length > 0 ? youthOrChurchEvents : liveEvents.slice(2, 5)}
  />
  <FreeAndTicketed free={freeOrChurchEvents} ticketed={ticketedEvents} />
  <LiveEcosystemPillars />
  <FeaturedOrganizers events={liveEvents} organizers={organizers} />
  <section class="bg-cream px-4 pb-4 sm:px-8">
    <TrustLegend class="mx-auto max-w-[1320px]" />
  </section>
  <CtaInvitation
    eyebrow="For churches, organizers & artists"
    title="Hosting or performing at a Christian event?"
    body="Submit your gathering, manage ticket tiers and door check-in, or coordinate artist bookings and event production. Every listing is reviewed before publishing."
    photo="worshipBand"
  >
    <ButtonLink href={siteUrl('live', '/promote/create')} arrow>List an event</ButtonLink>
    <ButtonLink href={siteUrl('live', '/artists')} variant="secondary">Artist &amp; agent participation</ButtonLink>
  </CtaInvitation>
</SiteLayout>
