---
import SiteLayout from '../../layouts/SiteLayout.astro';
import OrganizationHero from '../../components/organization/OrganizationHero.astro';
import PartnershipOpportunities from '../../components/organization/PartnershipOpportunities.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<SiteLayout
  title="Partnerships | Gamo Studios"
  description="How churches and community partners can work with Gamo Studios to expand music education, develop musicians and strengthen technical ministry."
>
  <OrganizationHero
    eyebrow="Churches & mission-aligned organizations"
    title="Shared resources."
    accent="Stronger communities."
    body="Churches and community partners can help expand music education, develop musicians and strengthen technical ministry."
    photo="churchModernDay"
  >
    <ButtonLink href="#opportunities" arrow>
      See the pathways
    </ButtonLink>
    <ButtonLink href="/partners/interest" variant="secondary">
      Start an inquiry
    </ButtonLink>
    <Fragment slot="caption">
      Photography illustrates the mission; it does not identify an existing partner.
    </Fragment>
  </OrganizationHero>
  <PartnershipOpportunities />
  <CtaInvitation
    eyebrow="A conversation worth starting"
    title="Bring your community into the picture."
    body="Tell us what collaboration could look like for your church or organization."
    photo="chapelSpring"
  >
    <ButtonLink href="/partners/interest" arrow>
      Start a partnership inquiry
    </ButtonLink>
  </CtaInvitation>
</SiteLayout>
