---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import EmailUsBlock from '../../components/organization/EmailUsBlock.astro';
import FormPanel from '../../components/forms/FormPanel.astro';
import { loadFormPage } from '../../lib/form-page';

export const prerender = false;

// If the form is not published yet the page keeps its email card and shows no form.
const page = await loadFormPage(Astro, 'partner-interest', {
  fallbackWhenMissing: true,
  anchor: 'share-an-idea',
});
if ('response' in page) return page.response;
---

<SiteLayout
  title="Partnership Inquiry | Gamo Studios"
  description="Share a partnership idea with Gamo Studios: hosting lessons, learning cohorts, worship development or shared resources for your church or organization."
>
  <PageHero breadcrumbs={[{ label: 'Partnerships', href: '/partners' }, { label: 'Inquiry' }]}>
    <Fragment slot="title">
      Every partnership <span class="block text-action">starts with an idea.</span>
    </Fragment>
    <p slot="intro" class="text-small">
      Programs begin in the Phoenix metropolitan area, Arizona.
    </p>
    <EmailUsBlock slot="media" partnership />
  </PageHero>
  <FormPanel page={page} id="share-an-idea" />
</SiteLayout>
