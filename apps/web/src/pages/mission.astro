---
import SiteLayout from '../layouts/SiteLayout.astro';
import OrganizationHero from '../components/organization/OrganizationHero.astro';
import ProgramsShowcase from '../components/organization/ProgramsShowcase.astro';
import WhyWeExist from '../components/mission/WhyWeExist.astro';
import WhoWeServe from '../components/mission/WhoWeServe.astro';
import OurValues from '../components/mission/OurValues.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<SiteLayout
  title="Our Mission | Gamo Studios"
  description="Helping students, families, churches and musicians grow through music and shared Christian experiences: three connected programs, one mission."
  current="mission"
>
  <OrganizationHero title="Music. Worship." accent="Community." photo="sanctuaryCongregation">
    <ButtonLink href="#programs" arrow>
      Explore our programs
    </ButtonLink>
    <ButtonLink href="/get-involved" variant="secondary">
      Get Involved
    </ButtonLink>
  </OrganizationHero>
  <WhyWeExist />
  <ProgramsShowcase id="programs" title="Interconnected programs serving one purpose." lead={false} />
  <WhoWeServe />
  <OurValues />
  <CtaInvitation title="Your gifts can help shape what comes next." photo="guitarMentor">
    <ButtonLink href="/get-involved" arrow>
      Find your path
    </ButtonLink>
    <ButtonLink href="/partners" variant="secondary">
      Explore partnerships
    </ButtonLink>
  </CtaInvitation>
</SiteLayout>
