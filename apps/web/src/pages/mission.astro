---
import SiteLayout from '../layouts/SiteLayout.astro';
import OrganizationHero from '../components/organization/OrganizationHero.astro';
import WhyWeExist from '../components/mission/WhyWeExist.astro';
import FourPrograms from '../components/mission/FourPrograms.astro';
import WhoWeServe from '../components/mission/WhoWeServe.astro';
import OurValues from '../components/mission/OurValues.astro';
import CtaInvitation from '@gamo/site/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<SiteLayout
  title="Our Mission | Gamo Studios"
  description="Helping churches, musicians, learners and families grow in faith through music and Christian gatherings."
  current="mission"
>
  <OrganizationHero
    eyebrow="Faith expressed through music"
    title="Music. Worship."
    accent="Community."
    body="Helping churches, musicians, learners and families grow in faith through music and Christian gatherings."
    photo="sanctuaryCongregation"
    inset="girlGuitar"
  >
    <ButtonLink href="#programs" arrow>
      Explore our programs
    </ButtonLink>
    <ButtonLink href="/get-involved" variant="secondary">
      Get involved
    </ButtonLink>
  </OrganizationHero>
  <WhyWeExist />
  <FourPrograms />
  <WhoWeServe />
  <OurValues />
  <CtaInvitation
    eyebrow="Get involved"
    title="Your gifts can shape what comes next."
    body="Churches, musicians, instructors, families, volunteers and organizers each have a practical way to take part."
    photo="guitarMentor"
  >
    <ButtonLink href="/get-involved" arrow>
      Find your path
    </ButtonLink>
    <ButtonLink href="/partners" variant="secondary">
      Explore partnerships
    </ButtonLink>
  </CtaInvitation>
</SiteLayout>
