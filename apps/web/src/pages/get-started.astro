---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import PathChooser from '../components/organization/PathChooser.astro';
---

<SiteLayout
  title="Get Started | Gamo Studios"
  description="Tell us who you are and we'll point you to the right Gamo Studios program, whether you are a student, family, church, musician or church volunteer."
>
  <PageHero>
    <Fragment slot="title">
      Where would you <span class="block text-action">like to begin?</span>
    </Fragment>
    <p slot="intro">Choose who you are and we'll point you to the right program.</p>
  </PageHero>
  <Section spacing="none" class="pb-20">
    <PathChooser headingLevel="h2" />
    <p class="mt-10 text-fg-muted">
      Not sure?{' '}
      <a href="/get-involved" class="font-semibold text-action-strong underline">
        See every way to get involved
      </a>{' '}
      or{' '}
      <a href="/contact" class="font-semibold text-action-strong underline">
        contact us
      </a>
      .
    </p>
  </Section>
</SiteLayout>
