---
/**
 * Contact card beside the heading of /contact and /partners/interest: a mailto link to the team inbox, for people
 * who would rather write an email than use the form below it (the only action when the form is not published yet).
 */
import Card from '@studio-gamo/ui/components/content/Card.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';

interface Props {
  partnership?: boolean;
}
const { partnership = false } = Astro.props;
const address = 'hello@gamostudio.org';
const subject = partnership ? 'Partnership inquiry' : 'Inquiry';
const mailto = `mailto:${address}?subject=${encodeURIComponent(subject)}`;
---

<Card as="section" padding="lg" tone="outline" class="items-start gap-3">
  <h2 class="text-2xl font-semibold tracking-tight">
    {partnership ? 'Share a partnership idea' : 'Send an inquiry'}
  </h2>
  <p class="text-small font-medium">Email us at</p>
  <ButtonLink href={mailto}>{address}</ButtonLink>
</Card>
