---
/**
 * Organization-page hero (mission, get-involved, partners, support): the shared PageHero with a two-line
 * title (second line in the accent colour), an intro, actions and one photo in the media slot.
 *
 * Slots: default (actions), caption (optional note under the photo).
 */
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';

interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  body: string;
  photo: PhotoKey;
  photoPosition?: string;
  tone?: 'default' | 'inset';
}
const { eyebrow, title, accent, body, photo, photoPosition, tone = 'default' } = Astro.props;
const hasCaption = Astro.slots.has('caption');
---

<PageHero eyebrow={eyebrow} tone={tone}>
  <Fragment slot="title">
    {title}
    <span class="block text-action">{accent}</span>
  </Fragment>
  <p slot="intro">{body}</p>
  <Fragment slot="actions">
    <slot />
  </Fragment>
  <figure slot="media">
    <div class="aspect-landscape overflow-hidden rounded-hero bg-surface-inset @4xl:aspect-square">
      <Photo name={photo} position={photoPosition} sizes="(min-width:1024px) 45vw, 94vw" priority />
    </div>
    {hasCaption && (
      <figcaption class="mt-3 text-small text-fg-muted">
        <slot name="caption" />
      </figcaption>
    )}
  </figure>
</PageHero>
