---
import Photo from '@studio-gamo/ui/components/Photo.astro';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  body: string;
  photo: PhotoKey;
  inset?: PhotoKey;
  variant?: 'community' | 'collage' | 'support';
}
const { eyebrow, title, accent, body, photo, inset, variant = 'community' } = Astro.props;
---

<section
  class:list={[
    'organization-hero page-intro-space relative flex min-h-[100dvh] flex-col justify-center overflow-hidden',
    variant === 'support' ? 'bg-sand' : 'bg-cream',
  ]}
  aria-labelledby="organization-title"
>
  <div class="relative mx-auto grid w-full max-w-[1440px] items-center gap-10 px-6 sm:px-12 lg:grid-cols-[1fr_1.05fr] lg:gap-10">
    <div class="relative z-10">
      <p class="eyebrow mb-5 text-terracotta">{eyebrow}</p>
      <h1 id="organization-title" class="display-xl max-w-[700px] text-balance">
        {title}
        <span class="block text-terracotta">{accent}</span>
      </h1>
      <p class="mt-6 max-w-[510px] text-base leading-relaxed text-ink-soft sm:text-lg">{body}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <slot />
      </div>
      <p class="mt-6 text-xs tracking-wide text-ink-soft">
        Mission-driven Public Benefit Corporation · Programs in preparation
      </p>
    </div>
    <div
      class:list={[
        'order-first lg:order-none hero-composition relative mx-auto w-full max-w-[680px]',
        variant,
      ]}
    >
      <div class="hero-main relative overflow-hidden bg-sand">
        <Photo name={photo} sizes="(min-width:1024px) 48vw, 100vw" priority />
      </div>
      {inset && (
        <div class="hero-inset absolute -bottom-4 -left-2 h-[170px] w-[135px] overflow-hidden rounded-[65px_65px_20px_20px] border-[7px] border-cream shadow-float sm:-left-3 sm:h-[205px] sm:w-[160px]">
          <Photo name={inset} sizes="(min-width:640px) 160px, 135px" />
        </div>
      )}
      <div class="absolute right-0 bottom-5 rounded-[22px] bg-ivory px-4 py-3 shadow-float sm:px-5">
        <p class="eyebrow text-terracotta">One shared mission</p>
        <p class="mt-2 text-sm font-semibold">Worship. Learn. Gather. Serve.</p>
      </div>
    </div>
  </div>
</section>
<style>
  .hero-main {
    height: 350px;
    border-radius: 42% 42% 10% 10% / 34% 34% 10% 10%;
  }
  .collage .hero-main {
    border-radius: 46% 46% 28px 46%;
  }
  .support .hero-main {
    border-radius: 200px 32px 200px 32px;
  }
  @media (max-width: 639px) {
    .hero-main {
      height: 350px;
    }
    .hero-composition {
      margin-bottom: 1rem;
    }
  }
  @media (min-width: 640px) {
    .hero-main {
      height: 420px;
    }
  }
  @media (min-width: 1024px) {
    .hero-main {
      height: clamp(400px, 57svh, 520px);
    }
  }
</style>
