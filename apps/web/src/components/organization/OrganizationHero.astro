---
/**
 * Organization-page hero (mission, get-involved, partners, support): the shared PageHero with a two-line
 * title (second line in the accent colour), an intro, actions and one landscape photo Frame in the media slot (the page's priority image).
 *
 * Slots: default (actions), caption (optional note under the photo).
 */
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import { photos, type PhotoKey } from '@studio-gamo/ui/lib/images';

interface Props {
  title: string;
  accent: string;
  body: string;
  photo: PhotoKey;
  /** Omit for the catalog description. */
  photoAlt?: string;
  tone?: 'default' | 'inset';
}
const { title, accent, body, photo, photoAlt, tone = 'default' } = Astro.props;
const hasCaption = Astro.slots.has('caption');
---

<PageHero tone={tone}>
  <Fragment slot="title">
    {title}
    <span class="block text-action">{accent}</span>
  </Fragment>
  <p slot="intro">{body}</p>
  <Fragment slot="actions">
    <slot />
  </Fragment>
  <figure slot="media">
    <Frame photo={photo} ratio="landscape" sizes="half" alt={photoAlt ?? photos[photo].alt} priority />
    {hasCaption && (
      <figcaption class="mt-3 text-small text-fg-muted">
        <slot name="caption" />
      </figcaption>
    )}
  </figure>
</PageHero>
