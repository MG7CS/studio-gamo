---
/** Page hero for the organization pages: photo composition first on phones, text left on desktop. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  body: string;
  photo: PhotoKey;
  inset?: PhotoKey;
  variant?: 'community' | 'collage' | 'support';
}
const { eyebrow, title, accent, body, photo, inset, variant = 'community' } = Astro.props;
---

<section
  class:list={[
    'organization-hero page-intro-space relative flex flex-col justify-center overflow-hidden lg:min-h-[100dvh]',
    variant === 'support' ? 'bg-sand' : 'bg-cream',
  ]}
  aria-labelledby="organization-title"
>
  <div class="relative mx-auto grid w-full max-w-[1440px] items-center gap-10 px-5 sm:px-12 lg:grid-cols-[1fr_1.05fr] lg:gap-10">
    <div class="relative z-10">
      <p class="eyebrow-pill mb-5">{eyebrow}</p>
      <h1 id="organization-title" class="display-xl max-w-[700px] text-balance">
        {title}
        <span class="block text-terracotta">{accent}</span>
      </h1>
      <p class="mt-5 max-w-[510px] text-base leading-relaxed text-ink-soft sm:text-lg">{body}</p>
      <div class="button-stack mt-7">
        <slot />
      </div>
      <p class="mt-6 text-xs tracking-wide text-ink-soft">
        Public Benefit Corporation · Programs in preparation
      </p>
    </div>
    <div
      class:list={[
        'order-first lg:order-none hero-composition relative mx-auto w-full max-w-[680px]',
        variant,
      ]}
    >
      <div class="hero-main relative overflow-hidden bg-sand">
        <Photo name={photo} sizes="(min-width:1024px) 48vw, 100vw" priority />
      </div>
      {inset && (
        <div class="hero-inset absolute -bottom-4 -left-2 h-[150px] w-[120px] overflow-hidden rounded-[28px] border-[6px] border-cream shadow-float sm:-left-3 sm:h-[205px] sm:w-[160px] sm:border-[7px]">
          <Photo name={inset} sizes="(min-width:640px) 160px, 120px" />
        </div>
      )}
      <div class="absolute right-0 bottom-5 rounded-[22px] bg-ivory px-4 py-3 shadow-float sm:px-5">
        <p class="eyebrow text-terracotta">One shared mission</p>
        <p class="mt-2 text-sm font-semibold">Worship. Learn. Gather. Serve.</p>
      </div>
    </div>
  </div>
</section>
<style>
  .hero-main {
    height: 320px;
    border-radius: 28px;
  }
  @media (max-width: 639px) {
    .hero-composition {
      margin-bottom: 1rem;
    }
  }
  @media (min-width: 640px) {
    .hero-main {
      height: 420px;
    }
  }
  @media (min-width: 1024px) {
    .hero-main {
      height: clamp(400px, 57svh, 520px);
    }
  }
</style>
