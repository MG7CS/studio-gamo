---
/** Every participation path, as photo rows. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { participation } from '../../data/organization';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section id="paths" class="scroll-mt-24 bg-ivory px-5 section-space sm:px-12">
  <div class="mx-auto max-w-[1320px]">
    <div class="mb-8 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
      <div>
        <p class="eyebrow-pill">Ways to take part</p>
        <h2 class="section-heading mt-4">Find your place.</h2>
      </div>
      <p class="max-w-sm text-base leading-relaxed text-ink-soft">
        Different gifts. Different starting points. One shared purpose.
      </p>
    </div>
    <div class:list={['grid gap-x-10', compact ? 'lg:grid-cols-2' : 'md:grid-cols-2']}>
      {participation.map((p) => (
        <a href={p.href} class="group flex items-center gap-4 border-t border-sand py-5 sm:gap-7 sm:py-7">
          <div class="h-[110px] w-[88px] shrink-0 overflow-hidden sm:h-[165px] sm:w-[135px] rounded-[20px]">
            <Photo name={p.photo} sizes="135px" alt="" />
          </div>
          <div class="min-w-0">
            <h3 class="text-lg font-bold tracking-tight sm:text-2xl">{p.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-soft sm:mt-3 sm:text-base">{p.body}</p>
            <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-terracotta group-hover:underline">
              {p.action}
              <Icon name="arrow" class="h-4 w-4 shrink-0" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
