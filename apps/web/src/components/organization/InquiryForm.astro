---
import FormField from '@studio-gamo/ui/components/FormField.astro';
interface Props { partnership?: boolean; }
const { partnership = false } = Astro.props;
---
<div class="rounded-[28px] border border-sand bg-white p-6 sm:p-9">
  <h2 class="text-2xl font-bold tracking-tight">{partnership ? 'Partnership inquiry' : 'Send us a message'}</h2>
  <p class="mt-2 text-sm text-ink-soft">Share a few details below and our team will follow up with you directly.</p>
  <form data-inquiry-form class="mt-7" method="post">
    <fieldset disabled data-inquiry-fields class="space-y-5">
      <legend class="sr-only">{partnership ? 'Partnership inquiry' : 'Contact details'}</legend>
      <div class="grid gap-5 sm:grid-cols-2"><FormField label="Your name" name="name" required placeholder="Your full name" autocomplete="name" /><FormField label="Email address" name="email" type="email" required placeholder="you@example.com" autocomplete="email" /></div>
      <FormField label="Church or organization (optional)" name="organization" placeholder="Church or organization name" autocomplete="organization" />
      <FormField label={partnership ? 'How would you like to participate?' : 'What would you like to explore?'} name="interest" type="select" required options={['Worship support', 'Music education', 'Teaching', 'Christian events', 'Technical support', 'Hosting a program', 'Partnerships', 'Mission support', 'Volunteering', 'General inquiry']} />
      <FormField label="Your idea or question" name="message" type="textarea" required placeholder="Tell us what you are exploring or how we can help." hint="Please do not include sensitive financial details or private identity documents." />
      <button type="submit" class="inline-flex rounded-full bg-terracotta px-6 py-3 font-semibold text-white hover:bg-terracotta-dark">Send inquiry</button>
    </fieldset>
    <noscript><p class="mt-5 text-sm">JavaScript is required to validate and submit this inquiry form.</p></noscript>
    <div data-inquiry-result hidden role="status" tabindex="-1" class="mt-6 rounded-2xl bg-cream p-5"><h3 class="text-lg font-semibold">Inquiry received</h3><p class="mt-2 text-sm leading-relaxed text-ink-soft">Thank you for reaching out. Your message has been recorded and our team will follow up with you shortly.</p><button data-inquiry-reset type="button" class="mt-4 text-sm font-semibold text-terracotta underline">Send another message</button></div>
  </form>
</div>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach((form) => {
    const fields = form.querySelector<HTMLFieldSetElement>('[data-inquiry-fields]');
    const result = form.querySelector<HTMLElement>('[data-inquiry-result]');
    if (!fields || !result) return;
    fields.disabled = false;
    const interest = new URLSearchParams(location.search).get('interest');
    const select = form.querySelector<HTMLSelectElement>('[name="interest"]');
    if (select && interest && [...select.options].some((o) => o.value === interest)) select.value = interest;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      result.hidden = false;
      result.focus();
    });
    form.querySelector('[data-inquiry-reset]')?.addEventListener('click', () => {
      form.reset(); result.hidden = true;
      form.querySelector<HTMLInputElement>('[name="name"]')?.focus();
    });
  });
</script>
