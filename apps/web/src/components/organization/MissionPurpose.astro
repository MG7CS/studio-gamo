---
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
const needs = [
  ['Churches', 'Prepared musicians for meaningful worship.', 'Churches need dependable musical support, shared preparation and clear coordination.'],
  ['Students & families', 'A welcoming way to begin.', 'Children, young people and adults need opportunities to discover instruments and grow through music.'],
  ['Christian communities', 'More ways to gather and serve.', 'Communities need trusted event discovery and churches need technical knowledge to support their message.'],
];
---
<section class="bg-ivory px-6 section-space sm:px-12">
  <div class="mx-auto max-w-[1320px]">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-24">
      <EditorialHeading eyebrow="Why we exist" title="Music opens doors." accent="Community keeps them open." />
      <div><p class="text-xl leading-relaxed">Gamo Studios strengthens Christian worship and communities by developing musical talent, connecting churches with skilled musicians, expanding access to music education, and helping people discover and participate in Christian events.</p><p class="mt-5 text-sm text-ink-soft">Our proposed working mission. We are building the programs and relationships to put it into practice.</p></div>
    </div>
    <div class="mt-16 grid gap-8 border-t border-sand pt-9 md:grid-cols-3">
      {needs.map(([audience, title, body]) => <article><p class="eyebrow text-terracotta">{audience}</p><h3 class="mt-5 max-w-xs text-2xl font-semibold tracking-tight">{title}</h3><p class="mt-4 max-w-sm leading-relaxed text-ink-soft">{body}</p></article>)}
    </div>
  </div>
</section>
