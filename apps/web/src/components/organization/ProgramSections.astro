---
/**
 * The three programs in owner order, each as its own section: a large photo and the program name with one
 * action (DESIGN.md section 11: heading only, no sentence under it, no label above). The photo side and the
 * surface alternate so the page keeps a rhythm. Used on the homepage; /mission keeps the single-block
 * `ProgramsShowcase`. The first section carries `id` so the hero's "Explore our programs" lands on it.
 */
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { photos, type PhotoKey } from '@studio-gamo/ui/lib/images';
import { programs } from '../../data/programs';

interface Props {
  /** Anchor id for the first section. */
  id?: string;
  /** Replaces a program's default photo, keyed by program. */
  photos?: Partial<Record<'academy' | 'worship' | 'production', PhotoKey>>;
}
const { id, photos: photoOverrides = {} } = Astro.props;
---

{programs.map((p, i) => {
  const photo = photoOverrides[p.key as 'academy' | 'worship' | 'production'] ?? p.bannerPhoto ?? p.photo;
  const raised = i % 2 === 1;
  const reverse = i % 2 === 1;
  const headingId = `program-${p.key}-title`;
  return (
    <section
      id={i === 0 ? id : undefined}
      aria-labelledby={headingId}
      data-tone={raised ? 'raised' : 'default'}
      class:list={['section-space text-fg', raised ? 'bg-surface-raised' : 'bg-surface']}
    >
      <Container class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class:list={[reverse && 'lg:order-2']}>
          <h2 id={headingId} class="section-heading text-balance">
            {p.name}
          </h2>
          <div class="mt-8">
            <ButtonLink href={p.href} arrow>
              Explore {p.name.replace(/^Gamo /, '')}
            </ButtonLink>
          </div>
        </div>
        <Frame photo={photo} ratio="landscape" sizes="half" alt={photos[photo].alt} />
      </Container>
    </section>
  );
})}
