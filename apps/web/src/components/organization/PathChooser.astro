---
/**
 * "Find your place" list: one row per way to take part (Academy, then Worship, then Production, then the
 * organization). Flat rows with hairlines, not a grid of identical tiles (DESIGN.md section 11). Used on the
 * homepage and /get-started; the surrounding Section or page owns the heading.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { participation } from '../../data/organization';

interface Props {
  /** Heading level of each row title. Default h3. */
  headingLevel?: 'h2' | 'h3';
  /** Which sentence sits under the title: the short next step (default) or the longer description. */
  detail?: 'next' | 'body';
}
const { headingLevel: Heading = 'h3', detail = 'next' } = Astro.props;
---

<ul class="grid gap-x-12 border-b border-border md:grid-cols-2">
  {participation.map((p) => (
    <li class="border-t border-border">
      <a href={p.href} class="group flex items-start justify-between gap-6 py-6">
        <span class="min-w-0">
          <Heading class="text-xl font-semibold tracking-tight text-fg group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">
            {p.title}
          </Heading>
          <p class="mt-1 text-body text-fg-muted">{p[detail]}</p>
        </span>
        <Icon
          name="arrow"
          class="mt-1.5 h-5 w-5 shrink-0 text-action transition-transform group-hover:translate-x-1"
        />
      </a>
    </li>
  ))}
</ul>
