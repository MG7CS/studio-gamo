---
/**
 * "Find your place" list: one row per way to take part (Academy, then Worship, then Production, then the
 * organization), as the shared flat `LinkRows` (DESIGN.md section 11). Used on the homepage and /get-started and
 * /get-involved; the surrounding Section or page owns the heading.
 */
import LinkRows from '@studio-gamo/ui/components/content/LinkRows.astro';
import { participation } from '../../data/organization';

interface Props {
  /** Heading level of each row title. Default h3. */
  headingLevel?: 'h2' | 'h3';
  /** Which sentence sits under the title: the short next step (default), the longer description, or none. */
  detail?: 'next' | 'body' | 'none';
}
const { headingLevel = 'h3', detail = 'next' } = Astro.props;
---

<LinkRows
  headingLevel={headingLevel}
  items={participation.map((p) => ({
    href: p.href,
    title: p.title,
    ...(detail === 'none' ? {} : { body: p[detail] }),
  }))}
/>
