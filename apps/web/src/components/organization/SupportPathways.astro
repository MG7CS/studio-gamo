---
/** Ways to support the mission: photo first on phones, list left and sticky photo right on desktop. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
const ways = [
  ['Music education', 'Instruments, learning materials, instructor time and welcoming programs.'],
  [
    'Program sponsorships',
    'Support for one education or community program, with delivery and reporting agreed first.',
  ],
  [
    'Instruments and equipment',
    'Instruments, audio gear or other useful resources. Condition and acceptance are reviewed.',
  ],
  [
    'Church and institutional support',
    'Mission-aligned church contributions, grants and institutional collaboration.',
  ],
  ['Time, skills and spaces', 'Teach, mentor, volunteer knowledge or offer a facility. It all counts.'],
];
---

<section id="support-paths" class="scroll-mt-24 bg-ivory px-5 section-space sm:px-12">
  <div class="mx-auto grid max-w-[1320px] items-start gap-10 lg:grid-cols-[1.05fr_.95fr] lg:gap-24">
    <div>
      <EditorialHeading
        eyebrow="Ways to sustain the mission"
        eyebrowStyle="pill"
        title="Support can take"
        accent="many forms."
        lede="We are building responsible ways for people and organizations to support religious and educational programs."
      />
      <div class="mt-8">
        {ways.map(([title, body]) => (
          <article class="border-t border-sand py-5 sm:py-7">
            <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">{title}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-soft">{body}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="order-first lg:order-none lg:sticky lg:top-28">
      <div class="h-[300px] overflow-hidden rounded-[28px] sm:h-[360px] lg:h-[440px]">
        <Photo name="youngPianist" sizes="(min-width:1024px) 40vw, 100vw" />
      </div>
      <p class="mt-4 text-sm leading-relaxed text-ink-soft">
        Sponsored classes start as funding and community partnerships are agreed.
      </p>
    </div>
  </div>
</section>
<section class="px-5 section-space sm:px-12">
  <div class="mx-auto grid max-w-[1320px] gap-8 lg:grid-cols-2 lg:gap-24">
    <EditorialHeading
      eyebrow="Responsible stewardship"
      eyebrowStyle="pill"
      title="Care for the mission."
      accent="Care for the resources."
    />
    <div>
      <p class="text-base leading-relaxed text-ink-soft sm:text-lg">
        Program budgets, separate tracking for restricted support, clear musician and instructor pay, and
        reporting to a governing board as governance develops.
      </p>
      <div class="button-stack mt-7">
        <ButtonLink href="/contact?interest=Mission%20support" arrow>
          Start a support inquiry
        </ButtonLink>
      </div>
    </div>
  </div>
</section>
