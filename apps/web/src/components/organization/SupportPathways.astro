---
import TitleCase from '@studio-gamo/ui/components/TitleCase.astro';
/** Ways to support the mission and the stewardship statement (/support). */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';

const ways = [
  {
    title: 'Music education & access',
    body: 'Instruments, learning materials and instructor time that open music lessons to more students.',
  },
  {
    title: 'Program support',
    body: 'Support for one defined education or community program, with delivery and reporting agreed before it begins.',
  },
  {
    title: 'Instruments & equipment',
    body: 'Instruments, audio equipment or other useful resources, reviewed for suitability and condition.',
  },
  {
    title: 'Church & institutional collaboration',
    body: 'Mission-aligned collaboration with churches and institutions that share the purpose of the programs.',
  },
  {
    title: 'Time, skills & spaces',
    body: 'Volunteer your knowledge, teach, mentor or offer facilities. Nonfinancial support makes a real difference.',
  },
];
---

<Section id="support-paths" title="Support can take many forms.">
  <FeatureGrid as="ul" max={3}>
    {ways.map((w) => (
      <Card as="li" padding="lg" tone="outline" data-reveal>
        <h3 class="text-xl font-black tracking-tight text-balance">
          <TitleCase>{w.title}</TitleCase>
        </h3>
        <p class="mt-3 text-body-sm text-fg-muted">{w.body}</p>
      </Card>
    ))}
  </FeatureGrid>
</Section>
<Section title="Care for the mission. Care for the resources.">
  <p slot="intro">
    Stewardship means program budgets, separate tracking for designated support, and musician and instructor
    pay always shown as its own line item.
  </p>
  <ButtonLink slot="actions" href="/contact?interest=Mission%20support" arrow>
    Start a support inquiry
  </ButtonLink>
</Section>
