---
import TitleCase from '@studio-gamo/ui/components/TitleCase.astro';
/**
 * The three programs in owner order.
 * - `featured` layout (default, /mission): Gamo Academy as the full-width leading card, Worship and Production side by
 *   side below it, under a left-aligned heading.
 * - `row` layout (the homepage, owner direction 2026-11-19): three cards of equal size next to each other, all in the
 *   same square frame, under a centred heading that stays on one line on wide screens with its second part in the
 *   accent colour.
 * The cards of a row share one photo shape, chosen by `MediaCardGrid` so the set crops least. Photo-led
 * (DESIGN.md section 11): the whole card is the photo, the program name and one line sit on it, and there is no label,
 * badge or paragraph.
 */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import Stack from '@studio-gamo/ui/components/layout/Stack.astro';
import MediaCard from '@studio-gamo/ui/components/content/MediaCard.astro';
import MediaCardGrid from '@studio-gamo/ui/components/content/MediaCardGrid.astro';
import { programs } from '../../data/programs';

interface Props {
  title: string;
  /** Optional second part of the heading, in the accent colour (a second line, or the same line in the `row` layout). */
  accent?: string;
  /** Heading id; also the in-page anchor ("programs" for #programs). */
  id?: string;
  tone?: 'default' | 'raised';
  /** Show the one line under each program name. Default true; the home page leaves it out. */
  lead?: boolean;
  /** `featured` (one large card, then two) or `row` (three equal cards side by side). Default featured. */
  layout?: 'featured' | 'row';
}
const { title, accent, id, tone = 'default', lead = true, layout = 'featured' } = Astro.props;
const [featured, ...others] = programs;
const headingId = `${id ?? 'programs'}-title`;
---

{layout === 'row' ? (
  <section
    id={id}
    aria-labelledby={headingId}
    data-band
    data-tone={tone}
    class:list={['section-space text-fg', tone === 'raised' && 'bg-surface-raised']}
  >
    <Container>
      <h2 id={headingId} class="section-heading mb-10 text-center text-balance text-fg">
        <TitleCase>
          {accent ? `${title} ` : title}
          {accent && <span class="text-accent">{accent}</span>}
        </TitleCase>
      </h2>
      <MediaCardGrid
        variant="overlay"
        max={3}
        min="md"
        gap="lg"
        items={programs.map((p) => ({
          image: { name: p.photo, sizes: 'third' },
          title: p.name,
          href: p.href,
          body: lead ? p.lead : undefined,
        }))}
      />
    </Container>
  </section>
) : (
  <Section tone={tone} title={title} id={id}>
    <Fragment slot="title">
      {title}
      {accent && <span class="block text-accent">{accent}</span>}
    </Fragment>
    <Stack gap="lg">
      {featured && (
        <MediaCard
          variant="overlay"
          image={{ name: featured.bannerPhoto ?? featured.photo, sizes: 'full' }}
          title={featured.name}
          href={featured.href}
        >
          {lead && <p class="text-base font-semibold">{featured.lead}</p>}
        </MediaCard>
      )}
      <MediaCardGrid
        variant="overlay"
        max={2}
        min="lg"
        gap="lg"
        items={others.map((p) => ({
          image: { name: p.photo, sizes: 'half' },
          title: p.name,
          href: p.href,
          body: lead ? p.lead : undefined,
        }))}
      />
    </Stack>
  </Section>
)}
