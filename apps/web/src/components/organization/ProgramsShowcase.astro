---
/**
 * The three programs in owner order: Gamo Academy as the wide leading card, Worship and Production side by side
 * below it. Photo-led (DESIGN.md section 11): the whole card is the photo, the program name and one line sit on it,
 * and there is no label, badge or paragraph. Used on the homepage and /mission.
 */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import Stack from '@studio-gamo/ui/components/layout/Stack.astro';
import MediaCard from '@studio-gamo/ui/components/content/MediaCard.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import { programs } from '../../data/programs';

interface Props {
  title: string;
  /** Optional second line of the heading, in the accent colour. */
  accent?: string;
  /** Heading id; also the in-page anchor ("programs" for #programs). */
  id?: string;
  tone?: 'default' | 'raised';
  /** Show the one line under each program name. Default true; the home page leaves it out. */
  lead?: boolean;
}
const { title, accent, id, tone = 'default', lead = true } = Astro.props;
const [featured, ...others] = programs;
---

<Section tone={tone} title={title} id={id}>
  <Fragment slot="title">
    {title}
    {accent && <span class="block text-accent">{accent}</span>}
  </Fragment>
  <Stack gap="lg">
    {featured && (
      <MediaCard
        variant="overlay"
        image={{
          name: featured.bannerPhoto ?? featured.photo,
          ratio: featured.bannerPhoto ? 'wide' : 'landscape',
          sizes: 'full',
        }}
        title={featured.name}
        href={featured.href}
      >
        {lead && <p class="text-base font-semibold">{featured.lead}</p>}
      </MediaCard>
    )}
    <FeatureGrid max={2} min="lg" gap="lg" as="ul">
      {others.map((p) => (
        <MediaCard
          as="li"
          variant="overlay"
          image={{ name: p.photo, ratio: 'landscape', sizes: 'half' }}
          title={p.name}
          href={p.href}
        >
          {lead && <p class="text-base font-semibold">{p.lead}</p>}
        </MediaCard>
      ))}
    </FeatureGrid>
  </Stack>
</Section>
