---
import TitleCase from '@studio-gamo/ui/components/TitleCase.astro';
/** Partnership pathways (Academy → Worship → Production → shared resources) and the principles band. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';

const paths = [
  {
    title: 'Host an Academy program',
    body: 'Offer classroom space, instruments and local support for lessons close to home.',
  },
  {
    title: 'Support a learning cohort',
    body: 'Help young people learn together in a group program; funding, eligibility and delivery are agreed with each partner.',
  },
  {
    title: 'Develop worship musicians',
    body: 'Collaborate on preparation, shared repertoire and opportunities for musicians to serve and grow.',
  },
  {
    title: 'Equip technical ministry',
    body: 'Volunteer training and practical support for sanctuary sound, livestreaming and lighting through Gamo Production.',
  },
  {
    title: 'Share practical resources',
    body: 'Facilities, instruments, sound equipment and professional skills all support the mission.',
  },
];
---

<Section id="opportunities" title="What can we build together?">
  <ButtonLink slot="actions" href="/partners/interest" arrow>
    Start a partnership inquiry
  </ButtonLink>
  <FeatureGrid as="ul" max={3}>
    {paths.map((p) => (
      <Card as="li" padding="lg" data-reveal>
        <h3 class="text-xl font-black tracking-tight text-balance">
          <TitleCase>{p.title}</TitleCase>
        </h3>
        <p class="mt-3 text-body-sm text-fg-muted">{p.body}</p>
      </Card>
    ))}
  </FeatureGrid>
</Section>
<Section tone="dark" title="Shared mission. Clear principles.">
  <div class="flex max-w-prose flex-col gap-5 text-lg leading-relaxed text-fg-muted">
    <p>
      Ordinary participation never requires a partnership. Partnerships and contributions never influence
      musician auditions, trust indicators or rankings.
    </p>
    <p>No fees, tiers or contribution amounts have been approved.</p>
  </div>
</Section>
