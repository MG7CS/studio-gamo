---
/** Partnership possibilities: photo first on phones, heading and photo left on desktop, list right. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
const paths = [
  [
    'Sponsor a class',
    'Help a group of learners take lessons together. Funding and eligibility are still being worked out.',
  ],
  ['Host Academy lessons', 'Offer classroom space, instruments and local support for lessons.'],
  ['Develop worship musicians', 'Work with us on preparation, shared repertoire and chances to serve.'],
  ['Bring people together', 'Share Christian events, workshops and gatherings through Gamo Live.'],
  ['Share practical resources', 'Facilities, instruments, sound equipment and professional skills all help.'],
];
---

<section id="opportunities" class="scroll-mt-24 px-5 section-space sm:px-12">
  <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[.85fr_1.15fr] lg:grid-rows-[auto_1fr] lg:gap-x-24 lg:gap-y-8">
    <EditorialHeading
      eyebrow="Partnership possibilities"
      eyebrowStyle="pill"
      title="What can we"
      accent="build together?"
      class="lg:col-start-1 lg:row-start-1"
    />
    <div class="order-first lg:order-none lg:col-start-1 lg:row-start-2">
      <div class="h-[300px] overflow-hidden rounded-[28px] sm:h-[390px]">
        <Photo name="guitarMentor" sizes="(min-width:1024px) 37vw, 100vw" />
      </div>
      <p class="mt-4 text-sm text-ink-soft">
        Photography illustrates the mission. It does not show an existing partner.
      </p>
    </div>
    <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
      {paths.map(([title, body], i) => (
        <article class="border-t border-sand py-6 sm:py-7">
          <p class="eyebrow text-terracotta">0{i + 1} · Proposed</p>
          <h3 class="mt-2 text-xl font-semibold tracking-tight sm:text-2xl">{title}</h3>
          <p class="mt-2 max-w-xl text-base leading-relaxed text-ink-soft">{body}</p>
        </article>
      ))}
      <div class="button-stack mt-2">
        <ButtonLink href="/partners/interest" arrow>
          Start a partnership inquiry
        </ButtonLink>
      </div>
    </div>
  </div>
</section>
<section data-surface="dark" class="bg-charcoal px-5 section-space text-cream sm:px-12">
  <div class="mx-auto grid max-w-[1320px] gap-6 lg:grid-cols-2 lg:gap-24">
    <h2 class="section-heading">
      Shared mission.
      <br />
      <span class="text-gold">Clear principles.</span>
    </h2>
    <div class="space-y-4 text-base leading-relaxed text-cream/80 sm:text-lg">
      <p>
        Taking part never requires a partnership. Support never affects auditions, trust labels or rankings.
      </p>
      <p>
        Church contributions, recognition and sponsorship terms are still being developed. No tiers or amounts
        are approved.
      </p>
    </div>
  </div>
</section>
