---
import Photo from '@studio-gamo/ui/components/Photo.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
const paths = [
  [
    'Sponsor a learning cohort',
    'Help shape a proposed program where young people can learn together. Funding, eligibility and delivery arrangements remain under development.',
  ],
  [
    'Host an Academy program',
    'Explore offering classroom space, instruments and local support for a future education program.',
  ],
  [
    'Develop worship musicians',
    'Collaborate on preparation, shared repertoire and opportunities for musicians to serve and grow.',
  ],
  [
    'Bring communities together',
    'Explore Christian event participation, workshops and gatherings through Gamo Live.',
  ],
  [
    'Share practical resources',
    'Facilities, instruments, sound equipment and professional skills can all support the mission.',
  ],
];
---

<section id="opportunities" class="px-6 section-space sm:px-12">
  <div class="mx-auto grid max-w-[1320px] gap-14 lg:grid-cols-[.85fr_1.15fr] lg:gap-24">
    <div>
      <EditorialHeading eyebrow="Partnership possibilities" title="What can we" accent="build together?" />
      <div class="mt-10 h-[390px] overflow-hidden mask-arch">
        <Photo name="guitarMentor" sizes="(min-width:1024px) 37vw, 100vw" />
      </div>
      <p class="mt-5 text-sm text-ink-soft">
        Photography illustrates the mission; it does not identify an existing partner.
      </p>
    </div>
    <div>
      {paths.map(([title, body], i) => (
        <article class="border-t border-sand py-7">
          <p class="eyebrow text-terracotta">0{i + 1} · Proposed pathway</p>
          <h3 class="mt-3 text-2xl font-semibold tracking-tight">{title}</h3>
          <p class="mt-3 max-w-xl leading-relaxed text-ink-soft">{body}</p>
        </article>
      ))}
      <ButtonLink href="/partners/interest" arrow>
        Start a partnership inquiry
      </ButtonLink>
    </div>
  </div>
</section>
<section data-surface="dark" class="bg-charcoal px-6 py-16 text-cream sm:px-12">
  <div class="mx-auto grid max-w-[1320px] gap-8 lg:grid-cols-2 lg:gap-24">
    <h2 class="section-heading">
      Shared mission.
      <br />
      <span class="text-gold">Clear principles.</span>
    </h2>
    <div class="space-y-5 text-lg leading-relaxed text-cream/80">
      <p>
        Ordinary participation never requires a partnership. Supporting contributions do not influence
        musician auditions, trust indicators or rankings.
      </p>
      <p>
        Church membership contributions, recognition and sponsorship arrangements are still being developed.
        No membership tiers or contribution amounts are approved.
      </p>
    </div>
  </div>
</section>
