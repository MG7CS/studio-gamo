---
/**
 * Event card on the Gamo Live marketing page, linking directly to the standalone Gamo Live marketplace.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import EventPills from './EventPills.astro';
import {
  categoryLabels,
  dateParts,
  fromPrice,
  getOrganizer,
  type LiveEvent,
} from '../../data/live-marketing';
interface Props {
  event: LiveEvent;
  variant?: 'tall' | 'row' | 'compact';
  class?: string;
}
const { event: e, variant = 'tall', class: className } = Astro.props;
const d = dateParts(e.date);
const org = getOrganizer(e.organizer);
const hostLabel = e.organizerName || org.name;
const href = siteUrl('live', e.productPath);
const isPast = Boolean(e.isPast || e.status === 'past');
---

{variant === 'tall' && (
  <article
    class:list={['group relative flex flex-col', isPast && 'opacity-80', className]}
    data-event-status={isPast ? 'past-closed' : e.status}
  >
    <div class="relative aspect-[4/5] overflow-hidden rounded-[28px] bg-charcoal/10">
      <Photo
        name={e.photo}
        position={e.photoPosition}
        sizes="(min-width:1024px) 22vw, 70vw"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        alt=""
      />
      <div class="absolute left-3 top-3 rounded-2xl bg-cream px-3 py-2 text-center leading-none text-charcoal shadow-float">
        <span class="block text-[11px] font-semibold uppercase tracking-wider text-terracotta">
          {d.month}
        </span>
        <span class="mt-1 block text-xl font-bold">{d.day}</span>
      </div>
      {isPast && (
        <div class="absolute right-3 top-3 rounded-full bg-charcoal/90 px-3 py-1 text-xs font-semibold text-cream shadow-float">
          Past · Closed
        </div>
      )}
    </div>
    <EventPills event={e} class="mt-4" />
    <h3 class="mt-2 text-lg font-semibold leading-snug">
      <a href={href} class="after:absolute after:inset-0">
        {e.title}
      </a>
    </h3>
    <p class="mt-1 text-sm opacity-70">
      {e.venue} · {e.city}, {e.state}
    </p>
    <p class="mt-1 text-sm font-medium opacity-80">{fromPrice(e)}</p>
  </article>
)}
{variant === 'row' && (
  <article
    class:list={[
      'group relative grid grid-cols-[96px_1fr] gap-4 rounded-[24px] bg-white p-3 ring-1 ring-sand sm:grid-cols-[150px_1fr]',
      isPast && 'opacity-80',
      className,
    ]}
    data-event-status={isPast ? 'past-closed' : e.status}
  >
    <div class="aspect-square overflow-hidden rounded-[18px]">
      <Photo name={e.photo} sizes="150px" class="h-full w-full object-cover" alt="" />
    </div>
    <div class="flex min-w-0 flex-col justify-center py-1 pr-2">
      <p class="eyebrow text-terracotta">
        {d.weekday}, {d.month} {d.day} · {e.time}
        {isPast ? ' · Past (Closed)' : ''}
      </p>
      <h3 class="mt-1 text-base font-semibold leading-snug sm:text-lg">
        <a href={href} class="after:absolute after:inset-0">
          {e.title}
        </a>
      </h3>
      <p class="mt-1 truncate text-sm text-ink-soft">
        {e.venue} · {e.city}, {e.state}
      </p>
      <EventPills event={e} class="mt-2" />
    </div>
  </article>
)}
{variant === 'compact' && (
  <article
    class:list={[
      'relative flex h-full flex-col rounded-[24px] bg-ivory p-5 ring-1 ring-sand',
      isPast && 'opacity-80',
      className,
    ]}
    data-event-status={isPast ? 'past-closed' : e.status}
  >
    <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-terracotta">
      <Icon name="calendar" class="h-4 w-4" />
      {d.weekday} {d.month} {d.day}
      {isPast ? ' · Closed' : ''}
    </p>
    <h3 class="mt-3 text-lg font-semibold leading-snug">
      <a href={href} class="after:absolute after:inset-0">
        {e.title}
      </a>
    </h3>
    <p class="mt-1 text-sm text-ink-soft">
      {categoryLabels[e.category]} · {e.city}, {e.state}
    </p>
    {e.recurring && (
      <p class="mt-2 flex items-center gap-1.5 text-sm">
        <Icon name="repeat" class="h-4 w-4 text-terracotta" />
        {e.recurring}
      </p>
    )}
    <p class="mt-auto pt-4 text-xs text-ink-soft">Venue: {hostLabel}</p>
    <EventPills event={e} class="mt-3" />
  </article>
)}
