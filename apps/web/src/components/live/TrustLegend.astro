---
/** Trust legend on Gamo Live marketing page: explains every trust/status state including Past · Closed. */
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: className, compact = false } = Astro.props;
const rows = [
  { kind: 'verified', label: 'Verified organizer', body: 'Confirmed after a meeting with Gamo.' },
  {
    kind: 'paid',
    label: 'Gamo ticketing',
    body: 'Tickets issued and checked in through Gamo Live.',
  },
  {
    kind: 'external',
    label: 'External tickets',
    body: 'Sold by the organizer or venue. You leave Gamo Live to buy.',
  },
  { kind: 'free', label: 'Free', body: 'No cost to attend. Optional registration may help hosts plan.' },
  {
    kind: 'past',
    label: 'Past · Closed',
    body: 'The date has passed. Registration and tickets are closed.',
  },
  {
    kind: 'rescheduled',
    label: 'Rescheduled',
    body: 'The date or time changed. The new schedule is shown first.',
  },
  { kind: 'canceled', label: 'Canceled', body: 'The event will not take place.' },
] as const;
---

<section
  aria-labelledby="trust-legend-title"
  class:list={['rounded-[28px] bg-white p-5 ring-1 ring-sand sm:p-8', className]}
>
  <p class="eyebrow-pill">Event status guide</p>
  <h2 id="trust-legend-title" class="mt-3 text-xl font-semibold tracking-tight sm:text-2xl">
    How to read an event listing
  </h2>
  <dl
    class:list={['mt-6 grid gap-x-8 gap-y-5', compact ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-4']}
  >
    {rows.map((r) => (
      <div>
        <dt>
          <StatusPill kind={r.kind}>{r.label}</StatusPill>
        </dt>
        <dd class="mt-2 text-sm leading-relaxed text-ink-soft">{r.body}</dd>
      </div>
    ))}
  </dl>
</section>
