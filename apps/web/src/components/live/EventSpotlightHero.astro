---
/**
 * Dark cinematic event spotlight on the Gamo Studios Live marketing page (`/live`).
 * Renders real featured events from the database and enforces the Past Event Closure Rule.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import EventPills from './EventPills.astro';
import AudienceSelector from './AudienceSelector.astro';
import { dateParts, getOrganizer, type LiveEvent, type Organizer } from '../../data/live-marketing';
interface Props { slides: LiveEvent[]; organizers?: Organizer[] }
const { slides, organizers } = Astro.props;
---
<section data-surface="dark" class="relative isolate overflow-hidden bg-night text-cream" data-spotlight aria-roledescription="carousel" aria-label="Featured events">
  {slides.map((e, i) => (
    <div class="absolute inset-0 -z-10 transition-opacity duration-700 motion-reduce:transition-none" data-bg={i} style={i === 0 ? '' : 'opacity:0'} aria-hidden="true">
      <Photo name={e.photo} position={e.photoPosition} sizes="100vw" priority={i === 0} class="h-full w-full object-cover" alt="" />
    </div>
  ))}
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-night via-night/75 to-night/10" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-gradient-to-t from-night via-night/70 to-transparent" aria-hidden="true"></div>

  <div class="mx-auto flex spotlight-frame max-w-[1320px] flex-col px-4 pb-6 pt-28 sm:px-8">
    <AudienceSelector current="explore" class="self-start" />
    <div class="mt-6 max-w-3xl" aria-live="polite">
      {slides.map((e, i) => {
        const d = dateParts(e.date);
        const org = getOrganizer(e.organizer, organizers);
        const isClosed = Boolean(e.isPast || e.isClosed || e.status === 'past' || e.status === 'canceled');
        return (
          <article data-slide={i} hidden={i !== 0} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
            <p class="eyebrow text-gold">Featured · {i + 1} / {slides.length}</p>
            <h1 class="display-xl spotlight-title mt-3 text-balance">{e.title}</h1>
            <p class="mt-4 max-w-xl text-base md:text-lg text-cream/80">{e.tagline}</p>
            <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-cream/85">
              <li class="flex items-center gap-2"><Icon name="calendar" class="h-4 w-4 text-gold" />{d.long} · {e.time}</li>
              <li class="flex items-center gap-2"><Icon name="pin" class="h-4 w-4 text-gold" />{e.venue}, {e.city}, {e.state}</li>
            </ul>
            <p class="mt-3 flex items-center gap-2 text-sm text-cream/70">
              <Icon name="users" class="h-4 w-4" />
              Hosted at <a class="font-semibold text-cream underline-offset-4 hover:underline" href={siteUrl('live', e.productPath)}>{e.organizerName || org.name}</a>
            </p>
            <EventPills event={e} class="mt-3" tone="dark" />
            <div class="mt-5 flex flex-wrap items-center gap-3">
              <ButtonLink href={siteUrl('live', e.productPath)} arrow>View event</ButtonLink>
              {!isClosed ? (
                <ButtonLink href={siteUrl('live', e.ticketPath)} variant="ghost-dark">
                  {e.ticketing === 'free' ? 'Register' : e.externalSource ? `Tickets · ${e.externalSource}` : 'Get tickets'}
                </ButtonLink>
              ) : (
                <span class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-5 py-3 text-sm font-semibold text-cream/80">
                  <Icon name="clock" class="h-4 w-4 text-gold" />
                  Event closed · Past
                </span>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-auto pt-7">
      <div class="mb-3 flex items-center justify-between gap-4">
        <p class="text-sm font-semibold text-cream/80">Upcoming events</p>
        <div class="flex gap-2">
          <button type="button" data-prev class="grid h-11 w-11 place-items-center rounded-full border border-white/25 hover:bg-white/10" aria-label="Previous featured event"><Icon name="arrow" class="h-4 w-4 rotate-180" /></button>
          <button type="button" data-next class="grid h-11 w-11 place-items-center rounded-full border border-white/25 hover:bg-white/10" aria-label="Next featured event"><Icon name="arrow" class="h-4 w-4" /></button>
        </div>
      </div>
      <ol class="scroll-rail -mx-4 flex snap-x gap-3 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-4 sm:overflow-visible sm:px-0">
        {slides.map((e, i) => {
          const d = dateParts(e.date);
          return (
            <li class="w-[72%] shrink-0 snap-start sm:w-auto">
              <a href={siteUrl('live', e.productPath)} data-thumb={i} aria-current={i === 0 ? 'true' : undefined}
                class="group flex items-center gap-3 rounded-2xl bg-white/[0.07] p-2.5 ring-1 ring-white/15 transition hover:bg-white/15 aria-[current=true]:bg-cream aria-[current=true]:text-charcoal">
                <span class="h-12 w-12 shrink-0 overflow-hidden rounded-xl"><Photo name={e.photo} sizes="48px" class="h-full w-full object-cover" alt="" /></span>
                <span class="min-w-0">
                  <span class="block text-xs font-semibold uppercase tracking-wider opacity-70">{d.month} {d.day} · {e.city}</span>
                  <span class="block truncate text-sm font-semibold">{e.title}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .spotlight-frame {
    min-height: clamp(640px, 92svh, 880px);
  }
  .spotlight-title {
    font-size: clamp(2.25rem, 4.4vw + 0.5rem, 4.25rem);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const bgs = [...root.querySelectorAll<HTMLElement>('[data-bg]')];
    const thumbs = [...root.querySelectorAll<HTMLAnchorElement>('[data-thumb]')];
    if (slides.length === 0) return;
    let cur = 0;
    const show = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((s, i) => (s.hidden = i !== cur));
      bgs.forEach((b, i) => (b.style.opacity = i === cur ? '1' : '0'));
      thumbs.forEach((t, i) => (i === cur ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(cur - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(cur + 1));
    thumbs.forEach((t, i) => t.addEventListener('click', (ev) => { if (i !== cur) { ev.preventDefault(); show(i); } }));
  });
</script>
