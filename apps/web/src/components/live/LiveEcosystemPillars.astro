---
/**
 * Who Gamo Live serves, on the Gamo Studios `/live` page. Each card links to a real page
 * on the standalone Gamo Live product (`siteUrl('live', ...)`) or to Gamo Production.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import EditorialHeading from '@gamo/site/components/EditorialHeading.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';

const pillars = [
  {
    number: '01',
    title: 'Discover and attend',
    eyebrow: 'Attendees',
    body: 'Browse concerts, worship nights and conferences nationwide. Register for free events or buy tickets. No account needed to attend.',
    icon: 'ticket' as const,
    links: [
      { label: 'Browse events', href: siteUrl('live', '/events') },
      { label: 'Find my tickets', href: siteUrl('live', '/tickets/find') },
    ],
  },
  {
    number: '02',
    title: 'Organize and share',
    eyebrow: 'Churches, ministries and organizers',
    body: 'Submit an event for review, take free registrations or sell tickets, and check people in at the door.',
    icon: 'calendar' as const,
    links: [{ label: 'List an event', href: siteUrl('live', '/organizer') }],
  },
  {
    number: '03',
    title: 'Perform',
    eyebrow: 'Artists',
    body: 'Artists appearing at listed events are shown on their own page, with their upcoming dates.',
    icon: 'music' as const,
    links: [{ label: 'Artists on Gamo Live', href: siteUrl('live', '/artists') }],
  },
  {
    number: '04',
    title: 'Produce',
    eyebrow: 'Sound, light and media',
    body: 'Need help with sound, livestream or lighting for your event? Gamo Production supports churches and organizers.',
    icon: 'sliders' as const,
    links: [{ label: 'Gamo Production', href: siteUrl('production') }],
  },
];
---

<section class="bg-ivory px-5 section-space sm:px-8" aria-labelledby="ecosystem-pillars-title">
  <div class="mx-auto max-w-[1320px]">
    <EditorialHeading
      id="ecosystem-pillars-title"
      eyebrow="One body, many roles"
      eyebrowStyle="pill"
      title="Built for everyone in the room."
      lede="For those who attend, host, lead worship and serve behind the scenes."
    />

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
      {pillars.map((pillar) => (
        <article class="flex flex-col justify-between rounded-[28px] bg-white p-5 ring-1 ring-sand transition-shadow hover:shadow-float sm:p-6">
          <div>
            <div class="flex items-center justify-between gap-3">
              <span class="eyebrow-pill">
                {pillar.number} · {pillar.eyebrow}
              </span>
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-cream text-charcoal">
                <Icon name={pillar.icon} class="h-5 w-5 text-terracotta" />
              </span>
            </div>
            <h3 class="mt-4 text-xl font-bold tracking-tight text-charcoal">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{pillar.body}</p>
          </div>

          <ul class="mt-5 space-y-1 border-t border-sand pt-3">
            {pillar.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-charcoal transition-colors hover:text-terracotta"
                >
                  <span>{link.label}</span>
                  <Icon name="arrow" class="h-3.5 w-3.5 text-terracotta" />
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
