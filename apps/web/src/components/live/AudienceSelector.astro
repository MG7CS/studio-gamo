---
/** Primary audience selector on Gamo Live marketing page — Explore Events vs Promote Event. */
import { siteUrl, inquiryUrl } from '@studio-gamo/ui/lib/sites';
interface Props {
  current: 'explore' | 'promote';
  tone?: 'light' | 'dark';
  class?: string;
}
const { current, tone = 'dark', class: className } = Astro.props;
const items = [
  { id: 'promote', label: 'Promote Event', href: inquiryUrl('Event listing') },
  { id: 'explore', label: 'Explore Events', href: siteUrl('live', '/events') },
];
const dark = tone === 'dark';
---

<nav
  aria-label="Choose your Gamo Live experience"
  class:list={[
    'inline-flex rounded-full p-1',
    dark ? 'bg-white/10 ring-1 ring-white/20 backdrop-blur' : 'bg-white ring-1 ring-sand',
    className,
  ]}
>
  {items.map((i) => (
    <a
      href={i.href}
      aria-current={current === i.id ? 'page' : undefined}
      class:list={[
        'inline-flex min-h-11 items-center rounded-full px-4 py-2 text-sm font-semibold transition-colors sm:px-5',
        current === i.id
          ? dark
            ? 'bg-cream text-charcoal'
            : 'bg-charcoal text-cream'
          : dark
            ? 'text-cream/80 hover:text-cream'
            : 'text-charcoal/70 hover:text-charcoal',
      ]}
    >
      {i.label}
    </a>
  ))}
</nav>
