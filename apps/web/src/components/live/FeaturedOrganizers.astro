---
/** Featured organizers on Gamo Live marketing page — links to standalone marketplace organizer profiles. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import { events, organizers } from '../../data/live-marketing';
---
<section class="bg-cream px-4 section-space sm:px-8" aria-labelledby="orgs-title">
  <div class="mx-auto max-w-[1320px]">
    <EditorialHeading id="orgs-title" eyebrow="Featured organizers" title="Know who is hosting." lede="Every event names its organizer. Profiles show the ministry behind the listing and its upcoming events." />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {organizers.map((o, i) => (
        <article class:list={['group relative rounded-[28px] bg-white p-3 ring-1 ring-sand', i % 2 === 1 && 'lg:translate-y-8']}>
          <div class="aspect-[4/3] overflow-hidden rounded-[22px]"><Photo name={o.photo} sizes="(min-width:1024px) 22vw, (min-width:640px) 45vw, 100vw" class="h-full w-full object-cover" alt="" /></div>
          <div class="p-3">
            <StatusPill kind="info">{o.kind}</StatusPill>
            <h3 class="mt-3 text-lg font-semibold"><a href={siteUrl('live', `/organizers/${o.slug}`)} class="after:absolute after:inset-0">{o.name}</a></h3>
            <p class="text-sm text-ink-soft">{o.kind} · {o.city}</p>
            <p class="mt-3 text-sm font-medium text-terracotta">{events.filter((e) => e.organizer === o.slug).length} upcoming events</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
