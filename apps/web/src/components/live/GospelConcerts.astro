---
/** Christian concerts on Gamo Live marketing page — links to standalone marketplace. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import EventCard from './EventCard.astro';
import { dateParts, type LiveEvent } from '../../data/live-marketing';
interface Props {
  events: LiveEvent[];
}
const { events } = Astro.props;
const lead = events[0];
const d = lead ? dateParts(lead.date) : null;
---

{lead && d && (
  <section class="bg-cream px-5 section-space sm:px-8" aria-labelledby="gospel-title">
    <div class="mx-auto grid max-w-[1320px] items-center gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div class="relative">
        <div class="aspect-[4/5] overflow-hidden rounded-[28px] sm:aspect-[5/4] lg:aspect-[5/6]">
          <Photo
            name="worshipLeaderGolden"
            sizes="(min-width:1024px) 45vw, 100vw"
            class="h-full w-full object-cover"
            alt="Gospel singer performing on a warmly lit stage"
          />
        </div>
        <a
          href={siteUrl('live', lead.productPath)}
          class="absolute -bottom-6 right-2 w-[min(16rem,80%)] rounded-[24px] bg-white p-4 shadow-float ring-1 ring-sand lg:right-[-1rem]"
        >
          {lead.isPast || lead.status === 'past' ? (
            <StatusPill kind="past">Past · Closed</StatusPill>
          ) : (
            <StatusPill kind="paid">Featured concert</StatusPill>
          )}
          <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-terracotta">
            {d.weekday} {d.month} {d.day} · {lead.time}
          </p>
          <p class="mt-1 font-semibold leading-snug">{lead.title}</p>
          <p class="mt-1 text-sm text-ink-soft">
            {lead.venue} · {lead.city}, {lead.state}
          </p>
        </a>
      </div>
      <div>
        <p class="eyebrow-pill">Christian concerts</p>
        <h2 id="gospel-title" class="section-heading mt-4 text-balance">
          Choirs, bands and voices <span class="text-terracotta">lifted together.</span>
        </h2>
        <p class="mt-4 max-w-lg text-base text-ink-soft sm:text-lg">
          From church-hall nights to arena tours. Each listing names the venue and the ticket provider.
        </p>
        <div class="mt-6 space-y-3">
          {events.map((e) => (
            <EventCard event={e} variant="row" />
          ))}
        </div>
      </div>
    </div>
  </section>
)}
