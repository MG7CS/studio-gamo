---
import Logo from '@studio-gamo/ui/components/Logo.astro';
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
const churchLinks = [
  { label: 'Find Musicians', url: 'https://worship.gamostudios.com/' },
  { label: 'Booking Plans', url: 'https://worship.gamostudios.com/' },
  { label: 'Standby Coverage', url: 'https://worship.gamostudios.com/' },
  { label: 'Host a Class', url: 'https://academy.gamostudios.com/host/apply' },
];
const musicianLinks = [
  { label: 'Join as a Musician', url: 'https://worship.gamostudios.com/apply/start' },
  { label: 'Audition Process', url: 'https://worship.gamostudios.com/apply/start' },
  { label: 'Opportunities', url: 'https://worship.gamostudios.com/' },
  { label: 'Musician Portal', url: 'https://worship.gamostudios.com/' },
];
const exploreLinks = [
  { label: 'Gamo Academy', url: 'https://academy.gamostudios.com/' },
  { label: 'Gamo Live', url: 'https://live.gamostudios.com/' },
  { label: 'A/V Production', url: 'https://production.gamostudios.com/' },
];
---
<footer class="relative isolate overflow-hidden bg-[#171E20] text-[#F4EDE3]">
  <!-- Subtle photographic continuation from the final CTA -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[185px] opacity-20" aria-hidden="true">
    <ResponsivePicture stem="photo-oct-12-2026-at-10-50-32-am-9" widths={[480,768,1200,1600]} sizes="100vw" alt="" class="h-full w-full object-cover object-[center_60%]" />
    <div class="absolute inset-0 bg-gradient-to-b from-[#171E20] via-[#171E20]/70 to-[#171E20]/30"></div>
  </div>
  <div class="relative z-10 mx-auto max-w-[1536px] px-6 pt-20 pb-12 sm:px-12 lg:px-[5%]">
    <div class="grid gap-11 sm:grid-cols-2 lg:grid-cols-[1.65fr_1fr_1fr_1fr_1.5fr] lg:gap-8">
      <div>
        <a href="/" class="inline-flex items-center" aria-label="Gamo Studios homepage"><Logo width="210" height="45" /></a>
        <p class="mt-5 max-w-[300px] text-base leading-relaxed text-[#D8D4D0]">
          Connecting churches with vetted musicians, supporting music education, and bringing communities together through live events.
        </p>
        <p class="mt-6 text-xs uppercase tracking-[.17em] text-[#D7AD86]">Arizona · Growing Nationwide</p>
      </div>
      <nav aria-label="For churches">
        <h2 class="mb-5 text-base font-semibold text-white">For Churches</h2>
        <ul class="space-y-3">{churchLinks.map((item) => <li><a href={item.url} class="text-sm text-[#D8D4D0] transition-colors hover:text-white">{item.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="For musicians">
        <h2 class="mb-5 text-base font-semibold text-white">For Musicians</h2>
        <ul class="space-y-3">{musicianLinks.map((item) => <li><a href={item.url} class="text-sm text-[#D8D4D0] transition-colors hover:text-white">{item.label}</a></li>)}</ul>
      </nav>
      <nav aria-label="Explore Gamo Studios">
        <h2 class="mb-5 text-base font-semibold text-white">Explore</h2>
        <ul class="space-y-3">{exploreLinks.map((item) => <li><a href={item.url} class="text-sm text-[#D8D4D0] transition-colors hover:text-white">{item.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2 class="mb-5 text-base font-semibold text-white">Stay in the Loop</h2>
        <p class="max-w-xs text-sm leading-relaxed text-[#D8D4D0]">News about musicians, Academy programs, and future events.</p>
        <!-- Visual preview only: no newsletter service exists during the design phase. -->
        <div class="mt-5 flex items-center overflow-hidden rounded-full border border-white/25 bg-white/5 p-1.5">
          <span class="min-w-0 flex-1 truncate pl-4 text-sm text-white/55">Your email address</span>
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#B65B35] text-xl" aria-hidden="true">→</span>
        </div>
        <p class="mt-2 text-xs text-[#D7AD86]">Newsletter sign-up coming soon</p>
      </div>
    </div>
    <div class="mt-16 flex flex-col gap-4 border-t border-white/20 pt-7 text-sm text-[#D8D4D0] md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} Gamo Studios. All rights reserved.</p>
      <nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="/legal/terms" class="hover:text-white">Terms of Service</a>
        <a href="/legal/privacy" class="hover:text-white">Privacy Policy</a>
        <a href="/contact" class="hover:text-white">Contact</a>
      </nav>
    </div>
  </div>
</footer>
