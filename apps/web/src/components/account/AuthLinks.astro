---
/** Small row of secondary links under an account-entry card. */
interface Props {
  links: { label: string; href: string }[];
}
const { links } = Astro.props;
---

<nav aria-label="Account entry links" class="mt-5 flex flex-wrap justify-center gap-x-4 gap-y-1 text-[13px]">
  {links.map((l) => (
    <a href={l.href} class="font-semibold text-terracotta-dark underline-offset-2 hover:underline">
      {l.label}
    </a>
  ))}
</nav>
