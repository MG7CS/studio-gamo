---
/**
 * Interactive verified email sign-in & organization onboarding panel.
 * Integrates with:
 * - POST /api/auth/challenge
 * - POST /api/auth/verify
 * - GET  /api/auth/me
 * - POST /api/organizations
 * - DELETE /api/auth/session
 */
---

<section
  class="mt-8 rounded-[28px] border border-white/15 bg-white/[0.04] p-6 sm:p-8"
  data-verified-auth
  aria-labelledby="verified-auth-heading"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="eyebrow text-gold">Verified Authentication &amp; Onboarding · Local / Sandbox</p>
    <span
      class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-xs font-medium text-emerald-300"
      data-auth-badge
    >
      OTP Challenge + HttpOnly Session
    </span>
  </div>
  <h2 id="verified-auth-heading" class="mt-3 text-xl font-semibold text-cream">
    Verified Email Sign-In &amp; Organization Setup
  </h2>
  <p class="mt-2 text-sm text-cream/70">
    Request a 6-digit verification code, verify your email to establish a signed <code>HttpOnly</code> session, and onboard your church, ministry, or school organization.
  </p>

  <div
    class="mt-4 rounded-xl border border-white/10 bg-black/30 p-3 text-sm text-cream/85"
    data-auth-status
    hidden
    role="status"
    aria-live="polite"
  ></div>

  <!-- Step 1: Request Email Challenge -->
  <form class="mt-5 space-y-4" data-step-challenge>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block text-sm">
        <span class="font-medium text-cream/85">Email address</span>
        <input
          type="email"
          name="email"
          required
          placeholder="pastor@gracechapel.org"
          class="mt-1.5 w-full rounded-xl border border-white/15 bg-black/40 px-3.5 py-2.5 text-sm text-cream placeholder:text-cream/40 focus:border-gold focus:outline-none"
        />
      </label>
      <label class="block text-sm">
        <span class="font-medium text-cream/85">Display name (optional)</span>
        <input
          type="text"
          name="displayName"
          placeholder="Pastor David Mensah"
          class="mt-1.5 w-full rounded-xl border border-white/15 bg-black/40 px-3.5 py-2.5 text-sm text-cream placeholder:text-cream/40 focus:border-gold focus:outline-none"
        />
      </label>
    </div>
    <button
      type="submit"
      data-btn-challenge
      class="rounded-full bg-terracotta px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-terracotta/90"
    >
      Send Verification Code
    </button>
  </form>

  <!-- Step 2: Verify 6-Digit Code -->
  <form class="mt-5 space-y-4" data-step-verify hidden>
    <p class="text-sm text-cream/75">
      Enter the 6-digit code sent to <strong class="text-cream" data-verify-email-label></strong>.
    </p>
    <div class="max-w-xs">
      <label class="block text-sm">
        <span class="font-medium text-cream/85">6-digit verification code</span>
        <input
          type="text"
          name="code"
          inputmode="numeric"
          pattern="\d{6}"
          maxlength="6"
          required
          placeholder="123456"
          class="mt-1.5 w-full rounded-xl border border-white/15 bg-black/40 px-3.5 py-2.5 font-mono text-base tracking-widest text-cream placeholder:text-cream/40 focus:border-gold focus:outline-none"
        />
      </label>
    </div>
    <div class="flex flex-wrap gap-3">
      <button
        type="submit"
        data-btn-verify
        class="rounded-full bg-terracotta px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-terracotta/90"
      >
        Verify &amp; Sign In
      </button>
      <button
        type="button"
        data-btn-reset
        class="rounded-full border border-white/20 px-4 py-2.5 text-sm font-medium text-cream/80 hover:bg-white/10"
      >
        Use different email
      </button>
    </div>
  </form>

  <!-- Step 3: Authenticated Session & Organization Onboarding -->
  <div class="mt-5 space-y-5" data-step-authenticated hidden>
    <div class="rounded-2xl border border-white/15 bg-black/30 p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-wider text-gold">Signed-in session</p>
          <p class="mt-1 text-base font-semibold text-cream" data-session-summary></p>
        </div>
        <button
          type="button"
          data-btn-signout
          class="rounded-full border border-white/20 px-4 py-2 text-xs font-semibold text-cream/85 hover:bg-white/10"
        >
          Sign out
        </button>
      </div>
    </div>

    <div class="rounded-2xl border border-white/15 bg-white/[0.03] p-5">
      <h3 class="text-base font-semibold text-cream">Organization Onboarding</h3>
      <p class="mt-1 text-xs text-cream/70">
        Create your church, ministry, or school organization to submit Christian gatherings on Gamo Live.
      </p>

      <div class="mt-3 rounded-xl border border-emerald-400/25 bg-emerald-950/30 p-3 text-sm text-emerald-200" data-org-current hidden>
        Active Organization: <strong data-org-summary></strong>
      </div>

      <form class="mt-4 space-y-4" data-form-org>
        <div class="grid gap-4 sm:grid-cols-3">
          <label class="block text-sm">
            <span class="font-medium text-cream/85">Organization name</span>
            <input
              type="text"
              name="name"
              required
              minlength="2"
              placeholder="Grace Chapel Community"
              class="mt-1.5 w-full rounded-xl border border-white/15 bg-black/40 px-3.5 py-2 text-sm text-cream placeholder:text-cream/40 focus:border-gold focus:outline-none"
            />
          </label>
          <label class="block text-sm">
            <span class="font-medium text-cream/85">Slug</span>
            <input
              type="text"
              name="slug"
              required
              pattern="[a-z0-9-]+"
              placeholder="grace-chapel"
              class="mt-1.5 w-full rounded-xl border border-white/15 bg-black/40 px-3.5 py-2 text-sm text-cream placeholder:text-cream/40 focus:border-gold focus:outline-none"
            />
          </label>
          <label class="block text-sm">
            <span class="font-medium text-cream/85">Type</span>
            <select
              name="type"
              class="mt-1.5 w-full rounded-xl border border-white/15 bg-black/40 px-3.5 py-2 text-sm text-cream focus:border-gold focus:outline-none"
            >
              <option value="church">Church</option>
              <option value="ministry">Ministry</option>
              <option value="school">School / Academy</option>
              <option value="other">Other Christian Organization</option>
            </select>
          </label>
        </div>
        <button
          type="submit"
          data-btn-create-org
          class="rounded-full bg-gold px-5 py-2 text-sm font-semibold text-charcoal transition hover:bg-gold/90"
        >
          Create Organization
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-verified-auth]').forEach((root) => {
    const statusBox = root.querySelector<HTMLElement>('[data-auth-status]')!;
    const stepChallenge = root.querySelector<HTMLFormElement>('[data-step-challenge]')!;
    const stepVerify = root.querySelector<HTMLFormElement>('[data-step-verify]')!;
    const stepAuth = root.querySelector<HTMLElement>('[data-step-authenticated]')!;
    const emailLabel = root.querySelector<HTMLElement>('[data-verify-email-label]')!;
    const sessionSummary = root.querySelector<HTMLElement>('[data-session-summary]')!;
    const orgCurrent = root.querySelector<HTMLElement>('[data-org-current]')!;
    const orgSummary = root.querySelector<HTMLElement>('[data-org-summary]')!;
    const orgForm = root.querySelector<HTMLFormElement>('[data-form-org]')!;

    let pendingEmail = '';
    let pendingDisplayName = '';

    const setStatus = (msg: string, isError = false) => {
      statusBox.hidden = false;
      statusBox.textContent = msg;
      statusBox.className = isError
        ? 'mt-4 rounded-xl border border-red-400/30 bg-red-950/40 p-3 text-sm text-red-200'
        : 'mt-4 rounded-xl border border-white/10 bg-black/30 p-3 text-sm text-cream/85';
    };

    const refreshMe = async () => {
      try {
        const res = await fetch('/api/auth/me', { headers: { Accept: 'application/json' } });
        if (!res.ok) {
          stepChallenge.hidden = false;
          stepVerify.hidden = true;
          stepAuth.hidden = true;
          return;
        }
        const body = await res.json();
        const data = body.data;
        if (data?.user) {
          stepChallenge.hidden = true;
          stepVerify.hidden = true;
          stepAuth.hidden = false;
          sessionSummary.textContent = `${data.user.email} (${data.user.verifiedEmailAt ? 'Verified' : 'Unverified'})`;
          const firstOrg = data.memberships?.[0];
          if (firstOrg) {
            orgCurrent.hidden = false;
            orgSummary.textContent = `${firstOrg.organizationName} (${firstOrg.organizationType} · ${firstOrg.role})`;
          } else {
            orgCurrent.hidden = true;
          }
        } else {
          stepChallenge.hidden = false;
          stepVerify.hidden = true;
          stepAuth.hidden = true;
        }
      } catch {
        // Ignore network errors during initial probe
      }
    };

    stepChallenge.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(stepChallenge);
      pendingEmail = String(fd.get('email') || '').trim();
      pendingDisplayName = String(fd.get('displayName') || '').trim();
      try {
        const payload: Record<string, string> = { email: pendingEmail };
        if (pendingDisplayName) payload.displayName = pendingDisplayName;
        const res = await fetch('/api/auth/challenge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) {
          setStatus(body.error?.message || 'Failed to send verification code', true);
          return;
        }
        emailLabel.textContent = pendingEmail;
        stepChallenge.hidden = true;
        stepVerify.hidden = false;
        setStatus(`Verification code sent (${body.data?.deliveryStatus || 'queued'}).`);
      } catch (err: any) {
        setStatus(err?.message || 'Request failed', true);
      }
    });

    stepVerify.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(stepVerify);
      const code = String(fd.get('code') || '').trim();
      try {
        const payload: Record<string, string> = { email: pendingEmail, code };
        if (pendingDisplayName) payload.displayName = pendingDisplayName;
        const res = await fetch('/api/auth/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) {
          setStatus(body.error?.message || 'Verification failed', true);
          return;
        }
        setStatus('Email verified and signed in.');
        await refreshMe();
      } catch (err: any) {
        setStatus(err?.message || 'Verification failed', true);
      }
    });

    root.querySelector('[data-btn-reset]')?.addEventListener('click', () => {
      stepVerify.hidden = true;
      stepChallenge.hidden = false;
      statusBox.hidden = true;
    });

    orgForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(orgForm);
      const payload = {
        name: String(fd.get('name') || '').trim(),
        slug: String(fd.get('slug') || '').trim(),
        type: String(fd.get('type') || 'church'),
      };
      try {
        const res = await fetch('/api/organizations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) {
          setStatus(body.error?.message || 'Organization creation failed', true);
          return;
        }
        setStatus(`Organization "${body.data.organization.name}" created.`);
        await refreshMe();
      } catch (err: any) {
        setStatus(err?.message || 'Organization creation failed', true);
      }
    });

    root.querySelector('[data-btn-signout]')?.addEventListener('click', async () => {
      await fetch('/api/auth/session', { method: 'DELETE' });
      setStatus('Signed out.');
      await refreshMe();
    });

    refreshMe();
  });
</script>
