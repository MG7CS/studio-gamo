---
/**
 * Interactive verified email sign-in, account creation & organization onboarding panel.
 * Integrates with:
 * - POST /api/auth/challenge
 * - POST /api/auth/verify
 * - GET  /api/auth/me
 * - POST /api/organizations
 * - DELETE /api/auth/session
 */
import { siteUrl } from '@studio-gamo/ui/lib/sites';

interface Props {
  mode?: 'signin' | 'signup';
}
const { mode = 'signin' } = Astro.props;
const isSignup = mode === 'signup';

const appLaunchers = [
  { label: 'Personal Account Hub', meta: 'Overview, profile & organizations', href: siteUrl('web', '/account') },
  { label: 'Gamo Worship · Church', meta: 'Request & manage Sunday musicians', href: siteUrl('worship', '/church') },
  { label: 'Gamo Worship · Musician', meta: 'Opportunities, schedule & check-in', href: siteUrl('worship', '/musician') },
  { label: 'Gamo Academy · Family', meta: 'Lessons, students & practice logs', href: siteUrl('academy', '/family') },
  { label: 'Gamo Academy · Instructor', meta: 'Teaching roster & attendance', href: siteUrl('academy', '/instructor') },
  { label: 'Gamo Live · Organizer', meta: 'Promote & manage Christian events', href: siteUrl('live', '/organizer') },
  { label: 'Gamo Production · Client', meta: 'Sound, video & media projects', href: siteUrl('production', '/client') },
];
---

<section
  class="mt-2 rounded-2xl border border-sand bg-ivory/60 p-5 text-charcoal sm:p-6"
  data-verified-auth
  data-auth-mode={mode}
  aria-labelledby="verified-auth-heading"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-terracotta">
      {isSignup ? 'Email Verification' : 'Quick Email Sign-In'}
    </p>
    <span
      class="rounded-full bg-cream px-3 py-1 text-xs font-semibold text-charcoal ring-1 ring-sand"
      data-auth-badge
    >
      6-digit verification code
    </span>
  </div>
  <h2 id="verified-auth-heading" class="mt-2 text-lg font-bold text-charcoal">
    {isSignup ? 'Create your account with email' : 'Continue with email'}
  </h2>
  <p class="mt-1 text-sm text-ink-soft">
    {isSignup
      ? 'Enter your name and email address to receive a 6-digit verification code.'
      : 'Enter your email address to receive a 6-digit verification code and open your workspaces.'}
  </p>

  <div
    class="mt-4 rounded-xl border border-sand bg-white p-3 text-sm text-charcoal"
    data-auth-status
    hidden
    role="status"
    aria-live="polite"
  ></div>

  <!-- Step 1: Request Email Challenge -->
  <form class="mt-5 space-y-4" data-step-challenge>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block text-sm">
        <span class="font-semibold text-charcoal">Email address *</span>
        <input
          type="email"
          name="email"
          required
          placeholder="you@church.org"
          class="mt-1.5 w-full rounded-xl border border-sand bg-white px-3.5 py-2.5 text-sm text-charcoal placeholder:text-ink-soft/60 focus:border-terracotta focus:outline-none"
        />
      </label>
      <label class="block text-sm">
        <span class="font-semibold text-charcoal">{isSignup ? 'Full name *' : 'Full name (optional)'}</span>
        <input
          type="text"
          name="displayName"
          required={isSignup}
          placeholder="Pastor David Mensah"
          class="mt-1.5 w-full rounded-xl border border-sand bg-white px-3.5 py-2.5 text-sm text-charcoal placeholder:text-ink-soft/60 focus:border-terracotta focus:outline-none"
        />
      </label>
    </div>
    <button
      type="submit"
      data-btn-challenge
      class="inline-flex items-center justify-center rounded-full bg-terracotta px-6 py-2.5 text-sm font-semibold text-white shadow-xs transition hover:bg-terracotta-dark"
    >
      {isSignup ? 'Continue with Email' : 'Send Verification Code'}
    </button>
  </form>

  <!-- Step 2: Verify 6-Digit Code -->
  <form class="mt-5 space-y-4" data-step-verify hidden>
    <p class="text-sm text-ink-soft">
      Enter the 6-digit code sent to <strong class="text-charcoal" data-verify-email-label></strong>.
    </p>
    <div class="max-w-xs">
      <label class="block text-sm">
        <span class="font-semibold text-charcoal">6-digit verification code</span>
        <input
          type="text"
          name="code"
          inputmode="numeric"
          pattern="\d{6}"
          maxlength="6"
          required
          placeholder="123456"
          class="mt-1.5 w-full rounded-xl border border-sand bg-white px-3.5 py-2.5 font-mono text-base tracking-widest text-charcoal placeholder:text-ink-soft/50 focus:border-terracotta focus:outline-none"
        />
      </label>
    </div>
    <div class="flex flex-wrap gap-3">
      <button
        type="submit"
        data-btn-verify
        class="rounded-full bg-terracotta px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-terracotta-dark"
      >
        {isSignup ? 'Verify & Complete Account' : 'Verify & Sign In'}
      </button>
      <button
        type="button"
        data-btn-reset
        class="rounded-full border border-sand bg-white px-4 py-2.5 text-sm font-medium text-charcoal hover:bg-cream"
      >
        Use a different email
      </button>
    </div>
  </form>

  <!-- Step 3: Authenticated Session, App Launchers & Organization Onboarding -->
  <div class="mt-5 min-w-0 space-y-5" data-step-authenticated hidden>
    <div class="min-w-0 rounded-2xl border border-sand bg-white p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-wider text-terracotta">Signed in</p>
          <p class="mt-1 break-all text-base font-bold text-charcoal" data-session-summary></p>
          <p class="mt-0.5 text-xs text-ink-soft" data-session-name></p>
        </div>
        <button
          type="button"
          data-btn-signout
          class="shrink-0 rounded-full border border-sand bg-ivory px-4 py-2 text-xs font-semibold text-charcoal hover:bg-cream"
        >
          Sign out
        </button>
      </div>
    </div>

    <div class="min-w-0 rounded-2xl border border-sand bg-white p-4 sm:p-5">
      <h3 class="text-base font-bold text-charcoal">Open Your Gamo Workspaces</h3>
      <p class="mt-1 text-xs text-ink-soft">
        Choose a program workspace below to get started.
      </p>
      <div class="mt-3.5 grid gap-2.5 sm:grid-cols-2">
        {appLaunchers.map((app) => (
          <a
            href={app.href}
            class="group flex min-w-0 items-center justify-between rounded-xl border border-sand bg-ivory/70 px-3.5 py-2.5 transition hover:border-terracotta/50 hover:bg-cream"
          >
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-charcoal group-hover:text-terracotta">{app.label}</p>
              <p class="truncate text-xs text-ink-soft">{app.meta}</p>
            </div>
            <span class="ml-2 shrink-0 text-xs font-semibold text-terracotta">Open →</span>
          </a>
        ))}
      </div>
    </div>

    <div class="rounded-2xl border border-sand bg-white p-5">
      <h3 class="text-base font-bold text-charcoal">Connect Your Church or Organization (Optional)</h3>
      <p class="mt-1 text-xs text-ink-soft">
        Link your church, ministry, or school organization to publish gatherings and manage team workspaces.
      </p>

      <div class="mt-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900" data-org-current hidden>
        Active Organization: <strong data-org-summary></strong>
      </div>

      <form class="mt-4 space-y-4" data-form-org>
        <div class="grid gap-4 sm:grid-cols-3">
          <label class="block text-sm">
            <span class="font-semibold text-charcoal">Organization name</span>
            <input
              type="text"
              name="name"
              required
              minlength="2"
              placeholder="Grace Chapel Community"
              class="mt-1.5 w-full rounded-xl border border-sand bg-ivory/60 px-3.5 py-2 text-sm text-charcoal placeholder:text-ink-soft/60 focus:border-terracotta focus:outline-none"
            />
          </label>
          <label class="block text-sm">
            <span class="font-semibold text-charcoal">Slug</span>
            <input
              type="text"
              name="slug"
              required
              pattern="[a-z0-9-]+"
              placeholder="grace-chapel"
              class="mt-1.5 w-full rounded-xl border border-sand bg-ivory/60 px-3.5 py-2 text-sm text-charcoal placeholder:text-ink-soft/60 focus:border-terracotta focus:outline-none"
            />
          </label>
          <label class="block text-sm">
            <span class="font-semibold text-charcoal">Type</span>
            <select
              name="type"
              class="mt-1.5 w-full rounded-xl border border-sand bg-ivory/60 px-3.5 py-2 text-sm text-charcoal focus:border-terracotta focus:outline-none"
            >
              <option value="church">Church</option>
              <option value="ministry">Ministry</option>
              <option value="school">School / Academy</option>
              <option value="event_producer">Event Producer</option>
              <option value="sponsor">Partner / Sponsor</option>
            </select>
          </label>
        </div>
        <button
          type="submit"
          data-btn-create-org
          class="rounded-full bg-charcoal px-5 py-2 text-sm font-semibold text-cream transition hover:bg-charcoal/90"
        >
          Create Organization
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-verified-auth]').forEach((root) => {
    const statusBox = root.querySelector<HTMLElement>('[data-auth-status]')!;
    const stepChallenge = root.querySelector<HTMLFormElement>('[data-step-challenge]')!;
    const stepVerify = root.querySelector<HTMLFormElement>('[data-step-verify]')!;
    const stepAuth = root.querySelector<HTMLElement>('[data-step-authenticated]')!;
    const emailLabel = root.querySelector<HTMLElement>('[data-verify-email-label]')!;
    const sessionSummary = root.querySelector<HTMLElement>('[data-session-summary]')!;
    const sessionName = root.querySelector<HTMLElement>('[data-session-name]');
    const orgCurrent = root.querySelector<HTMLElement>('[data-org-current]')!;
    const orgSummary = root.querySelector<HTMLElement>('[data-org-summary]')!;
    const orgForm = root.querySelector<HTMLFormElement>('[data-form-org]')!;
    const orgNameInput = orgForm.querySelector<HTMLInputElement>('input[name="name"]');
    const orgSlugInput = orgForm.querySelector<HTMLInputElement>('input[name="slug"]');

    let pendingEmail = '';
    let pendingDisplayName = '';

    // Auto-generate slug when typing organization name if slug hasn't been manually edited
    let slugEdited = false;
    orgSlugInput?.addEventListener('input', () => {
      slugEdited = Boolean(orgSlugInput.value.trim());
    });
    orgNameInput?.addEventListener('input', () => {
      if (!slugEdited && orgSlugInput) {
        orgSlugInput.value = orgNameInput.value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .slice(0, 48);
      }
    });

    const saveProfileHintCookie = (hint: { email: string; displayName?: string; orgName?: string; orgRole?: string } | null) => {
      const isGamostudio = window.location.hostname.endsWith('gamostudio.org');
      const domainPart = isGamostudio ? '; domain=.gamostudio.org' : '';
      if (!hint) {
        document.cookie = `gamo_profile_hint=; path=/; max-age=0; SameSite=Lax${domainPart}`;
        return;
      }
      const encoded = encodeURIComponent(JSON.stringify(hint));
      document.cookie = `gamo_profile_hint=${encoded}; path=/; max-age=2592000; SameSite=Lax${domainPart}`;
    };

    const setStatus = (msg: string, isError = false) => {
      statusBox.hidden = false;
      statusBox.textContent = msg;
      statusBox.className = isError
        ? 'mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-900'
        : 'mt-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900';
    };

    const refreshMe = async () => {
      try {
        const res = await fetch('/api/auth/me', { headers: { Accept: 'application/json' } });
        if (!res.ok) {
          stepChallenge.hidden = false;
          stepVerify.hidden = true;
          stepAuth.hidden = true;
          return;
        }
        const body = await res.json();
        const data = body.data;
        if (data?.user) {
          stepChallenge.hidden = true;
          stepVerify.hidden = true;
          stepAuth.hidden = false;
          sessionSummary.textContent = `${data.user.email} (${data.user.verifiedEmailAt ? 'Verified' : 'Unverified'})`;
          if (sessionName) {
            sessionName.textContent = data.user.displayName
              ? `Account holder: ${data.user.displayName}`
              : 'Verified Gamo Studios account';
          }
          const firstOrg = data.memberships?.[0];
          if (firstOrg) {
            const orgName = firstOrg.organizationName || firstOrg.orgName || firstOrg.organizationSlug;
            const orgType = firstOrg.organizationType || 'church';
            orgCurrent.hidden = false;
            orgCurrent.setAttribute('data-org-id', firstOrg.organizationId);
            orgSummary.textContent = `${orgName} (${orgType} · ${firstOrg.role})`;
            saveProfileHintCookie({
              email: data.user.email,
              displayName: data.user.displayName || undefined,
              orgName,
              orgRole: firstOrg.role,
            });
          } else {
            orgCurrent.hidden = true;
            orgCurrent.removeAttribute('data-org-id');
            saveProfileHintCookie({
              email: data.user.email,
              displayName: data.user.displayName || undefined,
            });
          }
        } else {
          stepChallenge.hidden = false;
          stepVerify.hidden = true;
          stepAuth.hidden = true;
        }
      } catch {
        // Ignore network errors during initial probe
      }
    };

    stepChallenge.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(stepChallenge);
      pendingEmail = String(fd.get('email') || '').trim();
      pendingDisplayName = String(fd.get('displayName') || '').trim();
      try {
        const payload: Record<string, string> = { email: pendingEmail };
        if (pendingDisplayName) payload.displayName = pendingDisplayName;
        const res = await fetch('/api/auth/challenge', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) {
          setStatus(body.error?.message || body.error || 'Failed to send verification code', true);
          return;
        }
        emailLabel.textContent = pendingEmail;
        stepChallenge.hidden = true;
        stepVerify.hidden = false;
        const msg = String(body.data?.message || '');
        const match = msg.match(/Local test code:\s*(\d{6})/);
        const codeInput = stepVerify.querySelector<HTMLInputElement>('input[name="code"]');
        if (match && codeInput) {
          codeInput.value = match[1];
          setStatus(`Verification code sent (${body.data?.deliveryStatus || 'simulated'}). Local dev code: ${match[1]}`);
        } else {
          setStatus(`Verification code sent (${body.data?.deliveryStatus || 'queued'}).`);
        }
      } catch (err: any) {
        setStatus(err?.message || 'Request failed', true);
      }
    });

    stepVerify.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(stepVerify);
      const code = String(fd.get('code') || '').trim();
      try {
        const payload: Record<string, string> = { email: pendingEmail, code };
        if (pendingDisplayName) payload.displayName = pendingDisplayName;
        const res = await fetch('/api/auth/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) {
          setStatus(body.error?.message || body.error || 'Verification failed', true);
          return;
        }
        setStatus('Email verified and signed in. Choose a workspace below or onboard an organization.');
        await refreshMe();
      } catch (err: any) {
        setStatus(err?.message || 'Verification failed', true);
      }
    });

    root.querySelector('[data-btn-reset]')?.addEventListener('click', () => {
      stepVerify.hidden = true;
      stepChallenge.hidden = false;
      statusBox.hidden = true;
    });

    orgForm.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(orgForm);
      const payload = {
        name: String(fd.get('name') || '').trim(),
        slug: String(fd.get('slug') || '').trim(),
        type: String(fd.get('type') || 'church'),
      };
      try {
        const res = await fetch('/api/organizations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json();
        if (!res.ok) {
          setStatus(body.error?.message || body.error || 'Organization creation failed', true);
          return;
        }
        const org = body.data?.organization;
        if (org) {
          orgCurrent.hidden = false;
          orgCurrent.setAttribute('data-org-id', org.id);
          orgSummary.textContent = `${org.name} (${org.type} · ${body.data?.membershipRole || 'owner'})`;
        }
        setStatus(`Organization "${org?.name || payload.name}" created.`);
        await refreshMe();
      } catch (err: any) {
        setStatus(err?.message || 'Organization creation failed', true);
      }
    });

    root.querySelector('[data-btn-signout]')?.addEventListener('click', async () => {
      await fetch('/api/auth/session', { method: 'DELETE' });
      saveProfileHintCookie(null);
      setStatus('Signed out.');
      await refreshMe();
    });

    refreshMe();
  });
</script>
