---
/** One Mission, Four Programs — asymmetric bento of differently shaped photo panels. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { programs } from '../../data/programs';

const layout = [
  { tone: 'bg-white', dark: false },
  { tone: 'bg-cream', dark: false },
  { tone: 'bg-night text-cream', dark: true },
  { tone: 'bg-white', dark: false },
];
---

<section
  id="programs"
  aria-labelledby="programs-title"
  class="scroll-mt-28 bg-cream px-5 py-20 sm:px-8 lg:py-28"
>
  <div class="mx-auto max-w-[1320px]">
    <div class="max-w-3xl">
      <p class="eyebrow text-terracotta">One mission, four programs</p>
      <h2 id="programs-title" class="section-heading mt-4 text-balance text-charcoal">
        Interconnected programs serving one purpose.
      </h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {programs.map((p, i) => {
        const l = layout[i];
        return (
          <a
            href={p.href}
            data-reveal
            data-surface={l.dark ? 'dark' : undefined}
            class:list={[
              'group flex flex-col justify-between overflow-hidden rounded-[34px] p-3.5 sm:p-4 ring-1 ring-black/5 transition-transform hover:-translate-y-1',
              l.tone,
            ]}
          >
            <div>
              <div class="relative aspect-[16/9] w-full overflow-hidden rounded-[26px] bg-sand">
                <Photo
                  name={p.photo}
                  sizes="(min-width:1024px) 45vw, 92vw"
                  alt=""
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </div>
              <div class="p-4 sm:p-6">
                <span
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full text-charcoal"
                  style={`background:${p.accent}`}
                >
                  <Icon name={p.icon} class="h-5 w-5" />
                </span>
                <h3 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">{p.name}</h3>
                <p class:list={['mt-2 max-w-xl leading-relaxed', l.dark ? 'text-cream/75' : 'text-ink-soft']}>
                  {p.summary}
                </p>
              </div>
            </div>
            <div class="flex items-center justify-between p-4 pt-0 sm:p-6 sm:pt-0">
              <span class:list={['text-sm font-semibold', l.dark ? 'text-cream/90' : 'text-charcoal']}>
                {p.short}
              </span>
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-terracotta text-white transition-transform group-hover:translate-x-1">
                <Icon name="arrow" class="h-5 w-5" />
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
