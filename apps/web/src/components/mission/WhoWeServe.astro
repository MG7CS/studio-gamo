---
/** Who we serve: audience list beside a photo (SplitHero used as a section band). */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';

const audiences = [
  { title: 'Students & families', body: 'Young learners and parents who want a caring path into music.' },
  {
    title: 'Churches & ministries',
    body: 'Congregations of every size looking for musicians, guidance and technical help.',
  },
  {
    title: 'Musicians & instructors',
    body: 'Teachers and worship musicians who want to serve with their gifts and be treated fairly.',
  },
  {
    title: 'Church volunteers',
    body: 'Sound, media and worship volunteers who want practical training to serve with confidence.',
  },
  {
    title: 'Community partners & supporters',
    body: 'Individuals and organizations who want to share time, skills, spaces or resources.',
  },
];
---

<SplitHero as="div" spacing="section" tone="inset" mediaSide="start">
  <p class="eyebrow text-action-strong">Who we serve</p>
  <h2 class="section-heading text-balance">Built for the whole worshiping community.</h2>
  <dl class="mt-4 flex flex-col gap-6">
    {audiences.map((a) => (
      <div data-reveal class="border-s-2 border-action ps-5">
        <dt class="text-xl font-bold tracking-tight">{a.title}</dt>
        <dd class="mt-1 leading-relaxed text-fg-muted">{a.body}</dd>
      </div>
    ))}
  </dl>
  <div slot="media" class="aspect-portrait overflow-hidden shadow-float mask-arch">
    <Photo name="sanctuaryCongregation" sizes="(min-width:1024px) 45vw, 94vw" position="50% 40%" />
  </div>
</SplitHero>
