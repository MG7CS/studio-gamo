---
/** Who we serve: a large arch photo (first on phones) with an audience list. */
import Photo from '@studio-gamo/ui/components/Photo.astro';

const audiences = [
  {
    title: 'Churches and ministries',
    body: 'Congregations of every size looking for musicians, guidance and technical help.',
  },
  {
    title: 'Learners of any age',
    body: 'Anyone who wants a caring path into music, and the families behind them.',
  },
  {
    title: 'Musicians and instructors',
    body: 'People who want to serve with their gifts and be treated fairly.',
  },
  {
    title: 'Artists and organizers',
    body: 'People hosting worship nights, concerts and gatherings across the country.',
  },
  {
    title: 'Partners and supporters',
    body: 'Individuals and organizations who share time, skills, spaces or resources.',
  },
];
---

<section aria-labelledby="serve-title" class="bg-ivory px-5 section-space sm:px-8">
  <div class="mx-auto grid max-w-[1320px] items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div class="relative mx-auto w-full max-w-[520px]">
      <div class="rounded-[28px] aspect-[4/5] overflow-hidden shadow-float">
        <Photo name="sanctuaryCongregation" sizes="(min-width:1024px) 38vw, 90vw" position="50% 40%" />
      </div>
      <div class="rounded-[28px] absolute -right-2 bottom-6 aspect-square w-[38%] overflow-hidden border-[6px] border-ivory shadow-float sm:-right-8">
        <Photo name="youngPianist" sizes="(min-width:1024px) 14vw, 36vw" />
      </div>
    </div>
    <div>
      <p class="eyebrow-pill">Who we serve</p>
      <h2 id="serve-title" class="section-heading mt-4 text-balance text-charcoal">
        The whole worshiping community.
      </h2>
      <dl class="mt-8 space-y-6">
        {audiences.map((a) => (
          <div data-reveal class="border-l-2 border-terracotta/40 pl-5">
            <dt class="text-lg font-bold tracking-tight text-charcoal sm:text-xl">{a.title}</dt>
            <dd class="mt-1 text-base leading-relaxed text-ink-soft">{a.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
