---
import TitleCase from '@studio-gamo/ui/components/TitleCase.astro';
/**
 * Who we serve: audience list beside a photo (SplitHero used as a section band). The photo's frame shape follows its own
 * shape; the list keeps three audiences (2026-11-19); church volunteers are named with their churches.
 */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';

const audiences = [
  { title: 'Students & families', body: 'Young learners and parents who want a caring path into music.' },
  {
    title: 'Churches & ministries',
    body: 'Congregations of every size, and their sound and media volunteers, looking for musicians, guidance and training.',
  },
  {
    title: 'Musicians & instructors',
    body: 'Teachers and worship musicians who want to serve with their gifts and be treated fairly.',
  },
];
---

<SplitHero as="div" spacing="section" tone="inset" mediaSide="start">
  <h2 class="section-heading text-balance">
    <TitleCase>Built for the whole worshiping community.</TitleCase>
  </h2>
  <dl class="mt-4 flex flex-col gap-6">
    {audiences.map((a) => (
      <div data-reveal class="border-s-2 border-action ps-5">
        <dt class="text-xl font-bold tracking-tight">{a.title}</dt>
        <dd class="mt-1 leading-relaxed text-fg-muted">{a.body}</dd>
      </div>
    ))}
  </dl>
  <Frame
    slot="media"
    photo="sanctuaryCongregation"
    sizes="half"
    alt="Congregation worshipping together in a sunlit sanctuary"
  />
</SplitHero>
