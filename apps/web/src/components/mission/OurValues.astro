---
/** Our values: large typographic index on a dark Section (data-surface switches every colour role). */
import Section from '@studio-gamo/ui/components/layout/Section.astro';

const values = [
  { name: 'Faith', body: 'We serve Christ and the church first.' },
  { name: 'Education', body: 'We invest in learning that lasts a lifetime.' },
  { name: 'Excellence', body: 'We offer our best work as an act of worship.' },
  { name: 'Community', body: 'We grow stronger by serving together.' },
  { name: 'Trust', body: 'We earn confidence through honesty and care.' },
  { name: 'Fairness', body: 'We treat musicians and instructors with respect and clear pay.' },
  { name: 'Stewardship', body: 'We handle every gift and resource responsibly.' },
];
---

<Section tone="dark" title="What guides how we serve.">
  <Fragment slot="eyebrow">Our values</Fragment>
  <ol class="border-t border-border">
    {values.map((v, i) => (
      <li data-reveal class="grid items-baseline gap-2 border-b border-border py-6 sm:grid-cols-2 sm:gap-8">
        <h3 class="flex items-baseline gap-4 text-4xl font-extrabold tracking-tight sm:text-6xl">
          <span class="text-small font-semibold text-action-strong" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          {v.name}
        </h3>
        <p class="text-lg text-fg-muted">{v.body}</p>
      </li>
    ))}
  </ol>
</Section>
