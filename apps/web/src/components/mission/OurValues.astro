---
/** Our Values — large typographic index on a dark surface. */
const values = [
  { name: 'Faith', body: 'We serve Christ and the church first.' },
  { name: 'Education', body: 'We invest in learning that lasts a lifetime.' },
  { name: 'Excellence', body: 'We offer our best work as an act of worship.' },
  { name: 'Community', body: 'We grow stronger by serving together.' },
  { name: 'Trust', body: 'We earn confidence through honesty and care.' },
  { name: 'Fairness', body: 'We treat musicians and instructors with respect and clear pay.' },
  { name: 'Stewardship', body: 'We handle every gift and resource responsibly.' },
];
---

<section
  aria-labelledby="values-title"
  data-surface="dark"
  class="bg-night px-5 py-20 text-cream sm:px-8 lg:py-28"
>
  <div class="mx-auto max-w-[1320px]">
    <p class="eyebrow text-gold">Our values</p>
    <h2 id="values-title" class="section-heading mt-4 max-w-2xl text-balance">
      What guides how we serve.
    </h2>
    <ul class="mt-12 border-t border-cream/15">
      {values.map((v, i) => (
        <li
          data-reveal
          class="grid items-baseline gap-2 border-b border-cream/15 py-6 sm:grid-cols-[3rem_minmax(0,1fr)_minmax(0,1fr)] sm:gap-8"
        >
          <span class="text-sm font-semibold text-gold">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="text-4xl font-extrabold tracking-tight sm:text-6xl">{v.name}</h3>
          <p class="text-lg text-cream/70">{v.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
