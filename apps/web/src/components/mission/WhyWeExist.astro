---
/** Five practical needs, set as a numbered list beside a sticky statement. */
const needs = [
  {
    title: 'Churches need dependable musicians.',
    body: 'Many congregations, especially smaller ones, struggle to keep worship teams staffed.',
  },
  {
    title: 'Musicians deserve fair opportunities.',
    body: 'Skilled musicians should be paid clearly and treated as partners in ministry.',
  },
  {
    title: 'People want to learn music.',
    body: 'Learning an instrument can shape a life, yet lessons are often out of reach.',
  },
  {
    title: 'Christian events need to be found.',
    body: 'Worship nights and gatherings deserve a trusted place where people can discover them.',
  },
  {
    title: 'Ministries need technical support.',
    body: 'Good sound, light and media help people focus on worship.',
  },
];
---

<section aria-labelledby="why-title" class="bg-ivory px-5 section-space sm:px-8">
  <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <p class="eyebrow-pill">Why we exist</p>
      <h2 id="why-title" class="section-heading mt-4 text-balance text-charcoal">
        Worship is carried by people.
      </h2>
      <p class="mt-4 max-w-md text-base leading-relaxed text-ink-soft sm:text-lg">
        Gamo Studios is a Christian, mission-driven Public Benefit Corporation shaped around a few practical
        needs we see in churches and communities.
      </p>
    </div>
    <ol class="divide-y divide-sand border-y border-sand">
      {needs.map((n, i) => (
        <li data-reveal class="grid grid-cols-[3rem_1fr] gap-4 py-6 sm:grid-cols-[5rem_1fr] sm:py-8">
          <span class="text-3xl font-extrabold tracking-tight text-terracotta/80 sm:text-5xl">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="text-xl font-bold tracking-tight text-charcoal sm:text-3xl">{n.title}</h3>
            <p class="mt-2 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">{n.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
