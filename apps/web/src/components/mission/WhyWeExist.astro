---
/** Why we exist: four practical needs (Academy → Worship → Production) as aligned numbered items. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import NumberedSteps from '@studio-gamo/ui/components/content/NumberedSteps.astro';

const needs = [
  {
    title: 'Families want access to music education.',
    body: 'Learning an instrument can shape a young person for life, yet lessons are often out of reach.',
  },
  {
    title: 'Churches need dependable musicians.',
    body: 'Many congregations, especially smaller ones, struggle to keep worship teams staffed week to week.',
  },
  {
    title: 'Musicians deserve fair, respectful opportunities.',
    body: 'Skilled worship musicians should be paid clearly and treated as partners in ministry.',
  },
  {
    title: 'Ministries need technical support.',
    body: 'Good sound, light and media help people focus on worship rather than distractions.',
  },
];
---

<Section tone="raised" title="Worship is carried by people. We want to help them.">
  <p slot="intro">
    Gamo Studios is a Christian, mission-driven Public Benefit Corporation, formed to be mission-driven and
    not only profit-seeking. Our programs answer a few practical needs we see in churches and communities.
  </p>
  <NumberedSteps items={needs} />
</Section>
