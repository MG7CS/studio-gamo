---
/**
 * ContentCatalog — content primitives and patterns (Badge, Card, LinkCard, MediaCard, FeatureGrid,
 * NumberedSteps, FloatingPreviewCard, SplitHero, a second PageHero tone) in every variant, plus
 * All people, lessons and schedules shown are labelled Sample.
 */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import Stack from '@studio-gamo/ui/components/layout/Stack.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import LinkCard from '@studio-gamo/ui/components/content/LinkCard.astro';
import MediaCard from '@studio-gamo/ui/components/content/MediaCard.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import NumberedSteps from '@studio-gamo/ui/components/content/NumberedSteps.astro';
import FloatingPreviewCard from '@studio-gamo/ui/components/content/FloatingPreviewCard.astro';
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Specimen from './Specimen.astro';

const badgeTones = ['neutral', 'accent', 'proposal', 'sample', 'success', 'danger'] as const;
const cardTones = ['raised', 'inset', 'dark', 'outline'] as const;
const paddings = ['none', 'sm', 'md', 'lg'] as const;
const stepTones = ['plain', 'raised', 'inset'] as const;
const steps = [
  { title: 'Tell us about the student', body: 'Sample step: age, instrument and a good time for lessons.' },
  { title: 'Meet the teacher', body: 'Sample step: a short first lesson to get to know each other.' },
  { title: 'Keep playing', body: 'Sample step: weekly lessons and a recital each term.' },
];
const gridItems = ['One', 'Two', 'Three', 'Four', 'Five'];
---

<Section title="Content · Badge" id="catalog-badge">
  <Stack gap="lg">
    {(['md', 'sm'] as const).map((size) => (
      <Specimen name={`Badge · size="${size}"`}>
        <div class="flex flex-wrap gap-3">
          {badgeTones.map((tone) =>
            tone === 'sample' || tone === 'proposal' ? (
              <Badge tone={tone} size={size} />
            ) : (
              <Badge tone={tone} size={size}>
                {tone}
              </Badge>
            ),
          )}
        </div>
      </Specimen>
    ))}
    <Specimen name="Badge · wrap" note="Long labels break onto several lines instead of truncating.">
      <div class="flex max-w-xs flex-wrap gap-3">
        <Badge tone="accent" wrap>
          Church-hosted lessons for children, teens and adults
        </Badge>
        <Badge tone="sample" wrap />
      </div>
    </Specimen>
  </Stack>
</Section>

<Section tone="dark" title="Content · Badge on a dark section" id="catalog-badge-dark">
  <div class="flex flex-wrap gap-3">
    {badgeTones.map((tone) =>
      tone === 'sample' || tone === 'proposal' ? <Badge tone={tone} /> : <Badge tone={tone}>{tone}</Badge>,
    )}
  </div>
</Section>

<Section title="Content · Card" id="catalog-card">
  <Stack gap="xl">
    <FeatureGrid min="sm" max={4} as="ul">
      {cardTones.map((tone) => (
        <Card as="li" tone={tone}>
          <p class="font-mono text-small font-semibold">tone="{tone}"</p>
          <p class="mt-2 text-fg-muted">Grouped content on a rounded surface.</p>
        </Card>
      ))}
    </FeatureGrid>
    <FeatureGrid min="sm" max={4} as="ul">
      {paddings.map((padding) => (
        <Card as="li" tone="outline" padding={padding} data-catalog={`card-padding-${padding}`}>
          <p class="font-mono text-small font-semibold">padding="{padding}"</p>
        </Card>
      ))}
    </FeatureGrid>
  </Stack>
</Section>

<Section tone="inset" title="Content · LinkCard" id="catalog-linkcard">
  <p slot="intro">The whole card is one link named by its title.</p>
  <FeatureGrid min="sm" max={4} as="ul">
    {cardTones.map((tone, i) => (
      <LinkCard
        as="li"
        href="#catalog-linkcard"
        title={`Sample link · ${tone}`}
        tone={tone}
        padding={i === 3 ? 'lg' : i === 0 ? 'sm' : 'md'}
        headingLevel="h3"
      >
        <p>Short body copy about where this link goes.</p>
        <Fragment slot="meta">Sample meta line</Fragment>
      </LinkCard>
    ))}
  </FeatureGrid>
</Section>

<Section title="Content · MediaCard" id="catalog-mediacard">
  <p slot="intro">
    Adaptive keeps text on the card surface (photo beside the text in wide containers); overlay puts text on
    the photo's bottom scrim.
  </p>
  <Stack gap="xl">
    <FeatureGrid max={3} as="ul">
      <MediaCard
        as="li"
        image={{ name: 'boyGuitar', alt: 'Smiling boy learning to play acoustic guitar (Sample)' }}
        title="Guitar · overlay, link"
        href="#catalog-mediacard"
        variant="overlay"
      >
        <Badge slot="on-media" tone="sample" />
        <p>Sample lesson: acoustic guitar from first chords.</p>
      </MediaCard>
      <MediaCard
        as="li"
        image={{ name: 'youngPianist', alt: 'Young pianist smiling at a keyboard (Sample)' }}
        title="Piano · adaptive, raised"
      >
        <p>Sample lesson: weekly piano for beginners.</p>
        <Fragment slot="meta">Sample · 30 minutes</Fragment>
      </MediaCard>
      <MediaCard
        as="li"
        image={{ name: 'musicianDrummer', alt: 'Drummer playing a kit (Sample)' }}
        title="Drums · adaptive, inset"
        tone="inset"
        href="#catalog-mediacard"
      >
        <Badge slot="on-media" tone="sample" />
        <p>Sample lesson: weekly drums for beginners.</p>
      </MediaCard>
    </FeatureGrid>
    <Specimen name='MediaCard · variant="adaptive", tone="dark" (wide container)'>
      <MediaCard
        image={{ name: 'soundEngineer', alt: 'Sound engineer at a mixing console (Sample)', sizes: 'half' }}
        title="Sound · dark"
        tone="dark"
      >
        <p>Sample: the photo moves beside the text once the card is at least 36rem wide.</p>
      </MediaCard>
    </Specimen>
  </Stack>
</Section>

<Section tone="raised" title="Content · FeatureGrid" id="catalog-featuregrid">
  <Stack gap="xl">
    {(
      [
        { min: 'sm', max: 4, lastRow: 'stretch', gap: 'md' },
        { min: 'md', max: 3, lastRow: 'center', gap: 'lg' },
        { min: 'lg', max: 2, lastRow: 'stretch', gap: 'md' },
      ] as const
    ).map((g) => (
      <Specimen name={`FeatureGrid · min="${g.min}" max={${g.max}} lastRow="${g.lastRow}" gap="${g.gap}"`}>
        <FeatureGrid min={g.min} max={g.max} lastRow={g.lastRow} gap={g.gap} as="ul">
          {gridItems.map((label) => (
            <Card as="li" tone="inset" padding="sm">
              <p class="text-small">{label}</p>
            </Card>
          ))}
        </FeatureGrid>
      </Specimen>
    ))}
  </Stack>
</Section>

<Section title="Content · NumberedSteps" id="catalog-steps">
  <Stack gap="xl">
    {stepTones.map((tone) => (
      <Specimen name={`NumberedSteps · tone="${tone}"`}>
        <NumberedSteps items={steps} tone={tone} headingLevel="h4" />
      </Specimen>
    ))}
    <Specimen
      name="NumberedSteps · start={4}, five items"
      note="Five steps read 3 + 2 with the short last row centred; no empty cell."
    >
      <NumberedSteps items={[...steps, ...steps.slice(0, 2)]} start={4} headingLevel="h4" />
    </Specimen>
    <Specimen name='NumberedSteps · six items, tone="raised"' note="Six steps read 3 + 3.">
      <NumberedSteps items={[...steps, ...steps]} tone="raised" headingLevel="h4" />
    </Specimen>
  </Stack>
</Section>

<Section tone="dark" title="Content · NumberedSteps on dark" id="catalog-steps-dark">
  <NumberedSteps items={steps} headingLevel="h3" />
</Section>

<Section tone="inset" title="Content · FloatingPreviewCard" id="catalog-preview-card">
  <div class="grid gap-10 md:grid-cols-2">
    {(['light', 'dark'] as const).map((tone, i) => (
      <Specimen name={`FloatingPreviewCard · tone="${tone}"`}>
        <div class="relative">
          <Frame photo={i === 0 ? 'girlGuitar' : 'worshipNight'} ratio="landscape" sizes="half" decorative />
          <FloatingPreviewCard
            title={i === 0 ? 'Next lesson' : 'Service plan'}
            tone={tone}
            class="absolute end-4 bottom-4 w-64 max-w-full"
            data-catalog={`preview-card-${tone}`}
          >
            <p class="text-small">{i === 0 ? 'Guitar · Thursday 4:30 pm' : 'Sunday · 3 musicians'}</p>
          </FloatingPreviewCard>
        </div>
      </Specimen>
    ))}
    <Specimen name='FloatingPreviewCard · as="aside", badge slot'>
      <FloatingPreviewCard title="Proposed contribution" as="aside">
        <Badge slot="badge" tone="proposal" size="sm" />
        <p class="text-small">Sample amount, not approved.</p>
      </FloatingPreviewCard>
    </Specimen>
  </div>
</Section>

<SplitHero as="section" spacing="section" mediaSide="start" tone="dark">
  <h2 class="section-heading text-balance">SplitHero · tone="dark", mediaSide="start"</h2>
  <p class="text-lg text-fg-muted">
    Copy and media side by side from a 48rem container. Used lower on a page it takes an h2.
  </p>
  <ButtonLink href="#catalog-container" variant="light">
    Sample action
  </ButtonLink>
  <Frame
    slot="media"
    photo="worshipBand"
    ratio="portrait"
    sizes="half"
    alt="Worship team with guitar, drums and keys in a bright sanctuary (Sample)"
  />
</SplitHero>

<SplitHero as="section" spacing="section" tone="inset">
  <h2 class="section-heading text-balance">SplitHero · tone="inset", mediaSide="end"</h2>
  <p class="text-lg text-fg-muted">
    The default media side is end. <Badge tone="sample" size="sm" />
  </p>
  <Frame
    slot="media"
    photo="guitarMentor"
    ratio="landscape"
    sizes="half"
    alt="Guitar instructor guiding a young student through a chord (Sample)"
  />
</SplitHero>

<SplitHero
  as="section"
  spacing="section"
  tone="raised"
  aria-label="SplitHero raised example"
  data-catalog="split-hero-raised"
>
  <h2 class="section-heading text-balance">SplitHero · tone="raised", forwarded attributes</h2>
  <p class="text-lg text-fg-muted">
    Lifts the band onto the raised surface; extra HTML attributes pass through.
  </p>
  <Frame
    slot="media"
    photo="churchModernDay"
    ratio="landscape"
    sizes="half"
    alt="Modern church building on a sunny day (Sample)"
  />
</SplitHero>

<SplitHero as="div" spacing="section">
  <h2 class="section-heading text-balance">SplitHero · tone="default", copy only</h2>
  <p class="text-lg text-fg-muted">Without media the copy takes the first column.</p>
</SplitHero>

<PageHero titleAs="h2" tone="dark" title='PageHero · tone="dark", titleAs="h2"'>
  <p slot="intro">A second hero on one page takes an h2, so the page keeps a single h1.</p>
  <ButtonLink slot="actions" href="#catalog-forms" variant="light">
    Sample action
  </ButtonLink>
</PageHero>

<PageHero titleAs="h2" tone="inset" align="center" title='PageHero · tone="inset", centred'>
  <p slot="intro">
    Centred copy without media. <Badge tone="sample" size="sm" />
  </p>
</PageHero>
