---
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
---
<section class="py-32 w-full relative overflow-hidden flex items-center min-h-[700px]">
  <div class="absolute inset-0 z-0">
    <ResponsivePicture stem="photo-oct-12-2026-at-10-50-32-am-9" widths={[480,768,1200,1600]} sizes="100vw" alt="Live Concert" class="w-full h-full object-cover object-right" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#8F432A]/90 via-[#8F432A]/70 to-transparent"></div>
  </div>
  
  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6">
    <div class="max-w-2xl space-y-8 text-white">
      <div>
        <h2 class="text-white font-semibold tracking-wider text-sm uppercase mb-3 bg-white/20 inline-block px-3 py-1 rounded-full backdrop-blur-md">Gamo Live</h2>
        <h3 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-[1.05]">Experience<br/>the energy.</h3>
      </div>
      <p class="text-xl text-white/90 leading-relaxed font-medium">
        Curated live worship events, nights of worship, and special artist showcases. Join us for an unforgettable experience.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-4 pt-4">
        <a href="/live" class="bg-white text-[#8F432A] px-8 py-4 rounded-xl font-semibold text-lg hover:bg-white/90 transition-colors w-full sm:w-auto text-center">
          View Upcoming Events
        </a>
        <a href="/live/past" class="bg-white/10 backdrop-blur-md text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-white/20 transition-colors border border-white/20 w-full sm:w-auto text-center">
          Watch Past Events
        </a>
      </div>
    </div>
  </div>
</section>
