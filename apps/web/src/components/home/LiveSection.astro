---
import Icon from '../editorial/Icon.astro';
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
import SectionEyebrow from '../editorial/SectionEyebrow.astro';
import InitialsAvatar from '../editorial/InitialsAvatar.astro';
import EventPreviewCard from '../editorial/EventPreviewCard.astro';

const events = [
  { title: 'Phoenix Worship Night', location: 'Phoenix, AZ', subtitle: 'Full Band', month: 'Oct', day: '18', metaIcon: 'music' as const, stem: 'photo-oct-12-2026-at-10-50-25-am-1', widths: [480,768,1200] },
  { title: 'Community Choir Tour', location: 'Mesa, AZ', subtitle: 'Choir + Band', month: 'Nov', day: '12', metaIcon: 'users' as const, stem: 'photo-oct-12-2026-at-10-50-27-am-3', widths: [480,768] },
  { title: 'Christmas Worship Concert', location: 'Scottsdale, AZ', subtitle: 'Special Guests', month: 'Dec', day: '6', metaIcon: 'music' as const, stem: 'photo-oct-12-2026-at-10-50-28-am-4', widths: [480,768] },
];
---
<section id="live" aria-labelledby="live-title" class="relative overflow-hidden bg-[#F4EDE3]">
  <div class="mx-auto max-w-[1536px]">
    <div class="relative flex flex-col lg:block lg:min-h-[610px]">
      <!-- Curved performance photo: not a generic image card. -->
      <div class="live-photo relative order-2 mx-5 h-[430px] overflow-hidden rounded-[28px] sm:mx-10 lg:absolute lg:inset-y-0 lg:right-0 lg:mx-0 lg:h-full lg:w-[70%] lg:rounded-none">
        <ResponsivePicture stem="photo-oct-12-2026-at-10-50-32-am-9" widths={[480,768,1200,1600]} sizes="(min-width: 1024px) 70vw, 100vw" alt="Concertgoers gathered for a live worship event" class="h-full w-full object-cover object-center" />
        <div class="absolute inset-0 bg-gradient-to-l from-black/20 via-transparent to-transparent"></div>
      </div>
      <div class="relative z-10 order-1 px-6 py-16 sm:px-12 lg:absolute lg:left-0 lg:top-[15%] lg:w-[40%] lg:px-[4.5%] lg:py-0">
        <SectionEyebrow label="Gamo Live" />
        <h2 id="live-title" class="mt-7 section-heading text-[#1D2323]">
          Live<br/>Moments. <span class="block text-[#B65B35]">Lasting Impact.</span>
        </h2>
        <p class="mt-6 max-w-sm text-lg leading-relaxed text-[#626866]">
          Concerts, worship nights, and choir tours that bring people together and strengthen communities.
        </p>
        <a href="https://live.gamostudios.com/" class="mt-7 inline-flex items-center gap-9 rounded-full bg-[#B65B35] px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-[#8F432A]">Explore Events <Icon name="arrow" class="h-5 w-5" /></a>
      </div>
      <div class="relative z-20 order-3 mx-5 -mt-20 max-w-[325px] rounded-[23px] border border-white/30 bg-[#202627]/90 p-5 text-white shadow-2xl backdrop-blur-xl sm:mx-10 lg:absolute lg:right-[13%] lg:bottom-[9%] lg:mx-0 lg:mt-0">
        <span class="mb-3 inline-block rounded-full bg-[#B65B35] px-3 py-1 text-[11px] font-semibold uppercase tracking-widest">Live</span>
        <h3 class="max-w-[250px] text-xl font-bold leading-tight">Grace Community Worship Night</h3>
        <p class="sr-only">Illustrative event preview, not a real event</p>
        <div class="mt-4 flex items-center gap-2" aria-hidden="true">
          {Array.from({length:22},(_,i)=>i).map((i) => <span class="w-[3px] rounded-full bg-[#D7AD86]" style={{height: (8 + (i*7)%25) + 'px'}}></span>)}
          <span class="ml-auto flex h-9 w-9 items-center justify-center rounded-full bg-[#F4EDE3] text-[#1D2323]"><Icon name="arrow" class="h-4 w-4" /></span>
        </div>
        <div class="mt-4 flex items-center -space-x-2" aria-hidden="true">
          {(['AR','JM','TL'] as const).map((initials, i) => <InitialsAvatar initials={initials} class="h-10 w-10 border-2 border-[#2a3032] text-xs" tone={i === 1 ? 'cream' : 'terracotta'} />)}
          <span class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-[#2a3032] bg-white/15 text-xs font-medium">+3</span>
        </div>
      </div>
    </div>
    <div class="px-5 pt-12 pb-10 sm:px-10 lg:px-[4.5%] lg:pt-16 lg:pb-14">
      <div class="mb-8 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <SectionEyebrow label="Upcoming Events" />
          <h3 class="mt-4 section-subheading text-[#1D2323]">
            Join Us for <span class="text-[#B65B35]">What's Next.</span>
          </h3>
          <p class="mt-3 max-w-xl text-xs font-medium text-[#8F432A]">The sample event cards shown here are design previews, not scheduled or ticketed events.</p>
        </div>
        <a href="https://live.gamostudios.com/" class="inline-flex items-center gap-8 self-start rounded-full border border-[#1D2323] px-6 py-3 font-semibold text-[#1D2323] transition-colors hover:bg-white/70 lg:self-auto">View All Events <Icon name="arrow" class="h-5 w-5" /></a>
      </div>
      <div class="-mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pt-5 pb-3 sm:mx-0 sm:grid sm:overflow-visible sm:px-0 sm:pb-0 [&>*]:w-[78%] [&>*]:shrink-0 [&>*]:snap-start sm:[&>*]:w-auto sm:grid-cols-3">
        {events.map((event) => <EventPreviewCard {...event} />)}
      </div>
    </div>
  </div>
</section>
<style>
@media (min-width: 1024px) {
  .live-photo {
    clip-path: polygon(20% 0,100% 0,100% 100%,6% 100%);
  }
}
</style>
