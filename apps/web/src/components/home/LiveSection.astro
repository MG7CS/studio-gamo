---
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
import SectionEyebrow from '../editorial/SectionEyebrow.astro';
import EventPreviewCard from '../editorial/EventPreviewCard.astro';

const events = [
  { title: 'Phoenix Worship Night', location: 'Phoenix, AZ', subtitle: 'Worship band · Concept event', stem: 'photo-oct-12-2026-at-10-50-32-am-9', widths: [480,768,1200] },
  { title: 'Community Choir Tour', location: 'Mesa, AZ', subtitle: 'Choir and live music · Concept event', stem: 'photo-oct-12-2026-at-10-50-27-am-3', widths: [480,768] },
  { title: 'Christmas Worship Concert', location: 'Scottsdale, AZ', subtitle: 'Live musicians · Concept event', stem: 'photo-oct-12-2026-at-10-50-28-am-4', widths: [480,768] },
];
---
<section id="live" aria-labelledby="live-title" class="relative overflow-hidden bg-[#F4EDE3]">
  <div class="mx-auto max-w-[1536px]">
    <div class="relative flex flex-col lg:block lg:min-h-[610px]">
      <!-- Curved performance photo: not a generic image card. -->
      <div class="live-photo relative order-2 mx-5 h-[430px] overflow-hidden rounded-[28px] sm:mx-10 lg:absolute lg:inset-y-0 lg:right-0 lg:mx-0 lg:h-full lg:w-[70%] lg:rounded-none">
        <ResponsivePicture stem="photo-oct-12-2026-at-10-50-32-am-9" widths={[480,768,1200,1600]} sizes="(min-width: 1024px) 70vw, 100vw" alt="Concertgoers gathered for a live worship event" class="h-full w-full object-cover object-center" />
        <div class="absolute inset-0 bg-gradient-to-l from-black/20 via-transparent to-transparent"></div>
      </div>
      <div class="relative z-10 order-1 px-6 py-16 sm:px-12 lg:absolute lg:left-0 lg:top-[15%] lg:w-[40%] lg:px-[4.5%] lg:py-0">
        <SectionEyebrow label="Gamo Live" />
        <h2 id="live-title" class="mt-7 text-[clamp(3.25rem,5.1vw,5.3rem)] font-extrabold leading-[.98] tracking-[-.05em] text-[#1D2323]">
          Live<br/>Moments. <span class="block text-[#B65B35]">Lasting Impact.</span>
        </h2>
        <p class="mt-6 max-w-sm text-lg leading-relaxed text-[#626866]">
          Concerts, worship nights, and choir tours that bring people together and strengthen communities.
        </p>
        <a href="https://live.gamostudios.com/" class="mt-7 inline-flex items-center gap-9 rounded-full bg-[#B65B35] px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-[#8F432A]">Explore Events <span aria-hidden="true" class="text-lg">→</span></a>
      </div>
      <div class="relative z-20 order-3 mx-5 -mt-20 max-w-[325px] rounded-[23px] border border-white/30 bg-[#202627]/90 p-5 text-white shadow-2xl backdrop-blur-xl sm:mx-10 lg:absolute lg:right-[13%] lg:bottom-[9%] lg:mx-0 lg:mt-0">
        <span class="mb-3 inline-block rounded-full bg-[#B65B35] px-3 py-1 text-[11px] font-semibold uppercase tracking-widest">Gamo Live · Demo</span>
        <h3 class="max-w-[250px] text-xl font-bold leading-tight">Community Worship Night</h3>
        <p class="mt-2 text-sm text-white/75">Illustrative event discovery preview</p>
        <div class="mt-4 flex items-center gap-2" aria-hidden="true">
          {Array.from({length:22},(_,i)=>i).map((i) => <span class="w-[3px] rounded-full bg-[#D7AD86]" style={{height: (8 + (i*7)%25) + 'px'}}></span>)}
          <span class="ml-auto flex h-9 w-9 items-center justify-center rounded-full bg-[#F4EDE3] text-[#1D2323]">→</span>
        </div>
      </div>
    </div>
    <div class="grid gap-9 px-5 pt-14 pb-24 sm:px-10 lg:grid-cols-[minmax(280px,.9fr)_minmax(0,2.5fr)] lg:gap-12 lg:px-[4.5%]">
      <div class="lg:pt-6">
        <SectionEyebrow label="Upcoming Events" />
        <h3 class="mt-6 text-[clamp(2.5rem,3.7vw,3.9rem)] font-extrabold leading-[1.02] tracking-[-.05em] text-[#1D2323]">
          Join Us for <span class="block text-[#B65B35]">What's Next.</span>
        </h3>
        <p class="mt-5 max-w-sm text-base leading-relaxed text-[#626866]">
          Discover concerts, worship gatherings, and choral experiences as they are announced.
        </p>
        <p class="mt-3 max-w-sm text-xs font-medium text-[#8F432A]">The sample event cards shown here are design previews, not scheduled or ticketed events.</p>
        <a href="https://live.gamostudios.com/" class="mt-6 inline-flex items-center gap-8 rounded-full border border-[#1D2323] px-6 py-3 font-semibold text-[#1D2323] transition-colors hover:bg-white/70">View All Events <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {events.map((event) => <EventPreviewCard {...event} />)}
      </div>
    </div>
  </div>
</section>
<style>
@media (min-width: 1024px) {
  .live-photo {
    clip-path: polygon(13% 0,100% 0,100% 100%,0 100%,12% 70%,0 36%);
    border-top-left-radius: 25% 52%;
  }
}
</style>
