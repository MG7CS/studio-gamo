---
import Icon from '../editorial/Icon.astro';
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
import SectionEyebrow from '../editorial/SectionEyebrow.astro';
import InitialsAvatar from '../editorial/InitialsAvatar.astro';

const liveModes = [
  {
    id: 'promote', label: 'Promote Event', cta: 'Promote an Event', href: 'https://live.gamostudios.com/promote',
    description: 'Churches, ministries, and Christian artists: share your worship nights, concerts, and gatherings, with optional registration and ticketing.',
  },
  {
    id: 'explore', label: 'Explore Events', cta: 'Explore Events', href: 'https://live.gamostudios.com/',
    description: 'Find worship nights, gospel concerts, conferences, Bible studies, and free community gatherings near you.',
  },
];
---
<section id="live" aria-labelledby="live-title" class="relative overflow-hidden bg-[#F4EDE3]">
  <div class="mx-auto max-w-[1536px]">
    <div class="relative flex min-h-[100svh] flex-col justify-center py-8 lg:block lg:min-h-[700px] lg:py-0">
      <!-- Curved performance photo: not a generic image card. -->
      <div class="live-photo relative order-1 mx-5 h-[32svh] min-h-[160px] [@media(max-height:720px)]:h-[25svh] overflow-hidden rounded-[28px] sm:mx-10 lg:absolute lg:inset-y-0 lg:right-0 lg:mx-0 lg:h-full lg:w-[70%] lg:rounded-none">
        <ResponsivePicture stem="photo-oct-12-2026-at-10-50-32-am-9" widths={[480,768,1200,1600]} sizes="(min-width: 1024px) 70vw, 100vw" alt="Concertgoers gathered for a live worship event" class="h-full w-full object-cover object-center" />
        <div class="absolute inset-0 bg-gradient-to-l from-black/20 via-transparent to-transparent"></div>
      </div>
      <div class="relative z-10 order-2 mt-6 px-6 sm:px-12 lg:absolute lg:left-0 lg:top-[15%] lg:w-[40%] lg:px-[4.5%] lg:py-0">
        <SectionEyebrow label="Gamo Live" />
        <h2 id="live-title" class="mt-4 lg:mt-7 section-heading text-[#1D2323]">
          Christian Events. <span class="block text-[#B65B35]">Bring People Together.</span>
        </h2>
        <div data-live-toggle>
          <div role="tablist" aria-label="Gamo Live options" class="mt-6 inline-flex rounded-full border border-[#1D2323]/15 bg-white/60 p-1">
            {liveModes.map((m, i) => (
              <button type="button" role="tab" id={`live-tab-${m.id}`} aria-controls={`live-panel-${m.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-live-tab={m.id}
                class="rounded-full px-4 py-2 text-sm font-semibold text-[#1D2323]/70 transition-colors hover:text-[#1D2323] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#B65B35] aria-selected:bg-[#B65B35] aria-selected:text-white">{m.label}</button>
            ))}
          </div>
          {liveModes.map((m, i) => (
            <div role="tabpanel" id={`live-panel-${m.id}`} aria-labelledby={`live-tab-${m.id}`} data-live-panel={m.id} hidden={i !== 0}>
              <p class="mt-5 max-w-sm text-lg leading-relaxed text-[#626866]">{m.description}</p>
              <a href={m.href} class="mt-7 inline-flex items-center gap-9 rounded-full bg-[#B65B35] px-7 py-4 text-sm font-semibold text-white transition-colors hover:bg-[#8F432A]">{m.cta} <Icon name="arrow" class="h-5 w-5" /></a>
            </div>
          ))}
        </div>
      </div>
      <div class="relative z-20 order-3 hidden lg:block max-w-[325px] rounded-[23px] border border-white/30 bg-[#202627]/90 p-5 text-white shadow-2xl backdrop-blur-xl sm:mx-10 lg:absolute lg:right-[13%] lg:bottom-[9%] lg:mx-0 lg:mt-0">
        <span class="mb-3 inline-block rounded-full bg-[#B65B35] px-3 py-1 text-[11px] font-semibold uppercase tracking-widest">Sample Event</span>
        <h3 class="max-w-[250px] text-xl font-bold leading-tight">Community Worship Night</h3>
        <p class="sr-only">Illustrative event preview, not a real event</p>
        <div class="mt-4 flex items-center gap-2" aria-hidden="true">
          {Array.from({length:22},(_,i)=>i).map((i) => <span class="w-[3px] rounded-full bg-[#D7AD86]" style={{height: (8 + (i*7)%25) + 'px'}}></span>)}
          <span class="ml-auto flex h-9 w-9 items-center justify-center rounded-full bg-[#F4EDE3] text-[#1D2323]"><Icon name="arrow" class="h-4 w-4" /></span>
        </div>
        <div class="mt-4 flex items-center -space-x-2" aria-hidden="true">
          {(['AR','JM','TL'] as const).map((initials, i) => <InitialsAvatar initials={initials} class="h-10 w-10 border-2 border-[#2a3032] text-xs" tone={i === 1 ? 'cream' : 'terracotta'} />)}
          <span class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-[#2a3032] bg-white/15 text-xs font-medium">+3</span>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-live-toggle]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-live-tab]'));
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.liveTab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      root.querySelectorAll<HTMLElement>('[data-live-panel]').forEach((p) => (p.hidden = p.dataset.livePanel !== id));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.liveTab!));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length].dataset.liveTab!, true);
      });
    });
  });
</script>
<style>
@media (min-width: 1024px) {
  .live-photo {
    clip-path: polygon(20% 0,100% 0,100% 100%,6% 100%);
  }
}
</style>
