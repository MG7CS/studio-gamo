---
/**
 * Gamo Worship spotlight: photo with a sample roster card, then the three principles.
 * Phones see the photo first; desktop keeps text left, photo right.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { providerSignupUrl } from '@studio-gamo/ui/lib/sites';

const coverageSteps = [
  { day: 'Tue', text: 'Set list, keys and call times shared with primary and standby', done: true },
  { day: 'Thu', text: 'Primary musician confirms rehearsal and service time', done: true },
  { day: 'Sat', text: 'Standby stays ready with the same charts', done: true },
  { day: 'Sun', text: 'Arrival recorded; musician pay shown as its own line', done: false },
];

const pillars = [
  {
    icon: 'verified' as const,
    title: 'Vetted, never pay-to-rank',
    body: 'Musicians are reviewed for skill and character. Money never affects vetting.',
  },
  {
    icon: 'shield' as const,
    title: 'Primary and standby',
    body: 'A standby musician is prepared where local availability allows.',
  },
  {
    icon: 'heart' as const,
    title: 'Fair, clear pay',
    body: 'Musician pay and any Gamo allocation are always separate line items.',
  },
];
---

<section id="worship" aria-labelledby="home-worship-title" class="bg-cream px-5 section-space sm:px-8">
  <div class="mx-auto grid max-w-[1320px] items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6">
      <EditorialHeading
        id="home-worship-title"
        eyebrow="01 · Gamo Worship"
        eyebrowStyle="pill"
        title="Musicians for"
        accent="any occasion."
        lede="Services, concerts and events, for churches and almost any group. Skilled Christian musicians who want good ways to serve."
      />

      <ul class="mt-8 space-y-5">
        {pillars.map((p) => (
          <li data-reveal class="flex gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-ivory text-terracotta ring-1 ring-sand">
              <Icon name={p.icon} class="h-5 w-5" />
            </span>
            <div>
              <h3 class="text-base font-bold tracking-tight text-charcoal sm:text-lg">{p.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-soft sm:text-base">{p.body}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="button-stack mt-8">
        <ButtonLink href={providerSignupUrl('worship', 'church')} arrow>
          Request a musician
        </ButtonLink>
        <ButtonLink href={providerSignupUrl('worship', 'musician')} variant="secondary">
          Apply as a musician
        </ButtonLink>
      </div>
    </div>

    <div class="relative order-first lg:order-none lg:col-span-6">
      <div class="aspect-[4/3] overflow-hidden rounded-[28px] bg-sand shadow-float">
        <Photo
          name="acousticLeader"
          sizes="(min-width:1024px) 46vw, 94vw"
          position="45% 25%"
          class="h-full w-full object-cover"
        />
      </div>

      <aside
        data-reveal
        class="relative -mt-10 ml-auto w-[94%] rounded-3xl border border-sand bg-white p-4 shadow-float sm:w-[23rem] sm:p-6 lg:absolute lg:-bottom-10 lg:-left-6 lg:mt-0"
        aria-label="Sample service roster"
      >
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-terracotta">Service roster</p>
            <p class="mt-0.5 text-sm font-bold text-charcoal sm:text-base">Cornerstone Chapel · 9:00 AM</p>
          </div>
          <StatusPill kind="sample">Sample</StatusPill>
        </div>

        <ol class="mt-4 space-y-2.5 border-t border-sand/80 pt-3.5">
          {coverageSteps.map((step) => (
            <li class="flex items-start gap-2.5 text-xs sm:text-sm">
              <span
                class:list={[
                  'mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full',
                  step.done ? 'bg-terracotta text-white' : 'border border-sand bg-cream',
                ]}
              >
                {step.done && <Icon name="check" class="h-3 w-3" />}
              </span>
              <span>
                <strong class="font-semibold text-charcoal">{step.day}:</strong>{' '}
                <span class="text-ink-soft">{step.text}</span>
              </span>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>
</section>
