    <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
      <a href="/worship/hire" class="bg-[#B65B35] text-white px-10 py-5 rounded-full font-semibold text-lg hover:bg-[#8F432A] transition-colors w-full sm:w-auto shadow-lg shadow-[#B65B35]/20">
        Hire a Musician
      </a>
      <a href="/contact" class="bg-transparent text-white px-10 py-5 rounded-full font-semibold text-lg hover:bg-white/10 transition-colors border border-white/30 w-full sm:w-auto">
        Contact Sales
      </a>
    </div>
  </div>
</section>
