---
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
---
<section class="py-32 w-full bg-[#1D2323] relative text-white overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center relative z-10">
    <div class="order-2 lg:order-1 relative rounded-3xl overflow-hidden h-[600px] shadow-2xl">
      <ResponsivePicture stem="photo-oct-12-2026-at-10-50-31-am-8" widths={[480,768,1200]} sizes="(min-width: 768px) 50vw, 100vw" alt="Academy Instructor" class="w-full h-full object-cover" loading="lazy" decoding="async" />
    </div>
    <div class="order-1 lg:order-2 space-y-8 max-w-xl">
      <div>
        <h2 class="text-[#D7AD86] font-semibold tracking-wider text-sm uppercase mb-3">Gamo Academy</h2>
        <h3 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[1.1]">Master your<br/>instrument.</h3>
      </div>
      <p class="text-xl text-[#F4EDE3]/80 leading-relaxed">
        Private lessons and clinics from working professionals. Build the next generation of musicians through our structured, faith-based curriculum.
      </p>
      <ul class="space-y-4 text-[#F4EDE3]/90 pt-2 font-medium">
        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#D7AD86]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 1-on-1 Mentorship</li>
        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#D7AD86]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Masterclasses & Clinics</li>
        <li class="flex items-center gap-3"><svg class="w-5 h-5 text-[#D7AD86]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Custom Church Training Plans</li>
      </ul>
      <div class="pt-4">
        <a href="/academy" class="inline-flex items-center justify-center gap-2 bg-[#D7AD86] text-[#1D2323] px-8 py-4 rounded-xl font-semibold hover:bg-[#C29871] transition-colors w-full sm:w-auto">
          Explore Academy
        </a>
      </div>
    </div>
  </div>
</section>
