---
import Icon from '../editorial/Icon.astro';
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
import SectionEyebrow from '../editorial/SectionEyebrow.astro';
import InitialsAvatar from '../editorial/InitialsAvatar.astro';

---
<section id="academy" aria-labelledby="academy-title" class="relative overflow-hidden bg-[#ECE1D3] py-8 lg:pt-0 lg:pb-0">
  <div class="mx-auto max-w-[1536px]">
    <div class="relative flex min-h-[calc(100svh-4rem)] flex-col justify-center lg:block lg:min-h-[625px]">
      <!-- Hero-sized lesson image: sculptural boundary with cream editorial panel. -->
      <div class="academy-photo relative order-1 mx-5 h-[32svh] min-h-[160px] [@media(max-height:720px)]:h-[25svh] overflow-hidden rounded-[30px] bg-[#1D2323] sm:mx-10 lg:absolute lg:top-0 lg:right-0 lg:mx-0 lg:h-[625px] lg:w-[66%] lg:rounded-none">
        <ResponsivePicture stem="photo-oct-12-2026-at-10-50-46-am-1" widths={[480,768,1200]} sizes="(min-width: 1024px) 67vw, 100vw" alt="African music teacher guiding a young guitarist in a church practice room" class="h-full w-full object-cover object-[50%_center]" />
        <div class="absolute inset-0 bg-gradient-to-l from-[#1D2323]/55 via-transparent to-transparent"></div>
      </div>

      <!-- Brand/editorial information -->
      <div class="relative z-10 order-2 mt-6 px-6 sm:px-12 lg:absolute lg:left-0 lg:top-[11%] lg:mt-0 lg:w-[43%] lg:px-[4.5%] lg:pt-0">
        <SectionEyebrow label="Gamo Academy" />
        <h2 id="academy-title" class="mt-4 lg:mt-6 section-heading text-[#1D2323]">
          Learn To Play <span class="block text-[#B65B35]">The Instrument</span> You Love
        </h2>
        <p class="mt-5 max-w-sm text-lg leading-relaxed text-[#626866]">
          Private lessons and church-hosted classes led by experienced musicians — for all ages and skill levels.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="https://academy.gamostudios.com/" class="inline-flex items-center gap-6 rounded-full bg-[#B65B35] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#8F432A]">Find a Lesson <Icon name="arrow" class="h-5 w-5" /></a>
          <a href="https://academy.gamostudios.com/host/apply" class="inline-flex items-center gap-6 rounded-full border border-[#1D2323] px-6 py-3.5 text-sm font-semibold text-[#1D2323] transition-colors hover:bg-white/70">Host a Class <Icon name="arrow" class="h-5 w-5" /></a>
        </div>
      </div>

      <!-- Floating instructor panel inside the photography on desktop. -->
      <div class="relative z-20 order-3 hidden lg:grid gap-3 sm:mx-10 lg:absolute lg:right-[2.5%] lg:top-[13%] lg:mx-0 lg:mt-0 lg:w-[295px]">
        <div class="rounded-[24px] border border-white/65 bg-[#FFF9F2]/90 p-5 text-[#1D2323] shadow-2xl backdrop-blur-xl">
          <div class="mb-4 flex items-center gap-3">
            <InitialsAvatar initials="DK" class="h-14 w-14 text-lg" />
            <div class="min-w-0">
              <p class="font-bold">Daniel K. <Icon name="verified" class="inline h-4 w-4 align-[-2px] text-[#B65B35]" strokeWidth={2} /></p>
              <p class="text-sm text-[#555B5A]">Guitar Instructor</p>
            </div>
          </div>
          <span class="mb-4 inline-block rounded-full bg-[#F4EDE3] px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-[#8F432A]">Illustrative profile</span>
          <div class="mb-3 flex flex-wrap gap-1.5">
            {['Worship Guitar','Beginners','Teens','Nashville Numbers'].map((tag) => <span class="rounded-full bg-[#F4EDE3] px-2.5 py-1 text-xs text-[#1D2323]">{tag}</span>)}
          </div>
          <p class="mb-4 flex items-center gap-2 text-xs text-[#626866]"><Icon name="pin" class="h-4 w-4" />Phoenix, AZ</p>
          <a href="https://academy.gamostudios.com/" class="flex items-center justify-between rounded-full bg-[#B65B35] px-5 py-3 text-sm font-semibold text-white">Explore Lessons <Icon name="arrow" class="h-5 w-5" /></a>
        </div>
        <div class="relative hidden h-32 overflow-hidden rounded-[22px] border lg:block border-white/35 bg-[#1D2323] text-white shadow-2xl">
          <ResponsivePicture stem="photo-oct-12-2026-at-10-50-31-am-8" widths={[480,768,1200]} sizes="295px" alt="Instructor leading a group music class in a church" class="h-full w-full object-cover object-center" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-center justify-between p-4 text-sm font-semibold"><span class="flex items-center gap-2"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-[#1D2323]"><Icon name="play" class="h-4 w-4 fill-current" /></span>Watch Intro</span><span class="rounded-full bg-white/15 px-2 py-1 text-[10px]">Demo · 1:28</span></div>
        </div>
      </div>
    </div>


  </div>
</section>
<style>
@media (min-width: 1024px) {
  .academy-photo {
    clip-path: polygon(16% 0,100% 0,100% 100%,0 100%,11% 74%,0 35%);
    border-top-left-radius: 19% 48%;
  }
}
</style>
