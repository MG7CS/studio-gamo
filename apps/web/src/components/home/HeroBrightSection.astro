---
/**
 * PROPOSED global hero evolution (review only — not used on the homepage).
 * Reference: design-reference/2026-brand-refresh/global-hero-bright-concept.png
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import HeroProgramCards from './HeroProgramCards.astro';
---
<section aria-labelledby="bright-hero-title" class="relative overflow-hidden bg-cream page-intro-space">
  <div aria-hidden="true" class="pointer-events-none absolute -left-32 top-1/3 h-[420px] w-[420px] rounded-full bg-[#F7E3D3] opacity-70 blur-3xl"></div>
  <div class="relative mx-auto max-w-[1440px] px-5 sm:px-10">
    <div class="grid items-center gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-0">
      <div class="relative z-10 lg:pb-24">
        <p class="eyebrow text-terracotta">Music / People / Churches / Communities</p>
        <h1 id="bright-hero-title" class="mt-6 display-xl text-charcoal">Keep<br />Worship<br /><span class="text-terracotta">Going.</span></h1>
        <p class="mt-7 max-w-md text-lg leading-relaxed text-ink-soft">Strengthening Christian worship and community through skilled musicians, music education and Christian events.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink href="#bright-programs" size="lg" arrow>Explore Our Programs</ButtonLink>
          <ButtonLink href="/mission" size="lg" variant="secondary">Our Mission</ButtonLink>
        </div>
      </div>
      <div class="bright-photo relative h-[360px] overflow-hidden sm:h-[420px] lg:-mr-10 lg:h-[clamp(440px,65svh,580px)]">
        <Photo name="worshipLeaderGolden" priority sizes="(min-width:1024px) 58vw, 100vw" position="50% 25%" />
        <p class="absolute right-6 top-8 hidden h-36 w-36 items-center justify-center rounded-full border border-white/60 bg-cream/85 p-5 text-center text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-terracotta sm:flex">A stronger church tomorrow</p>
      </div>
    </div>
    <HeroProgramCards />
  </div>
</section>
<style>
  .bright-photo { border-radius: 180px 32px 32px 120px; }
  @media (min-width: 1024px) { .bright-photo { border-radius: 340px 0 0 260px / 300px 0 0 420px; } }
</style>
