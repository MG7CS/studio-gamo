---
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
---
<section class="py-32 w-full bg-white relative">
  <!-- Top Curve -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-10 -translate-y-full rotate-180">
    <svg viewBox="0 0 1440 120" class="w-full h-[60px] md:h-[120px]" preserveAspectRatio="none">
      <path d="M0,120 C320,0 1120,0 1440,120 L1440,120 L0,120 Z" fill="#ffffff"></path>
    </svg>
  </div>

  <div class="max-w-[1440px] mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="space-y-8 max-w-xl">
        <div>
          <h2 class="text-[#B65B35] font-semibold tracking-wider text-sm uppercase mb-3">Worship Coverage</h2>
          <h3 class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#1D2323] tracking-tight leading-[1.1]">Your Sunday,<br/>Covered.</h3>
        </div>
        <p class="text-xl text-[#6B6B67] leading-relaxed">
          We provide a vetted local roster with paid standby understudies and a reliable dispatch workflow so you're never left without a team.
        </p>
        
        <div class="space-y-6 pt-4">
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#F4EDE3] flex items-center justify-center text-[#B65B35] font-bold text-xl">1</div>
            <div>
              <h4 class="text-xl font-bold text-[#1D2323] mb-2">Book the primary</h4>
              <p class="text-[#6B6B67] text-lg">Select a verified professional for your specific service times.</p>
            </div>
          </div>
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#F4EDE3] flex items-center justify-center text-[#B65B35] font-bold text-xl">2</div>
            <div>
              <h4 class="text-xl font-bold text-[#1D2323] mb-2">Standby assigned</h4>
              <p class="text-[#6B6B67] text-lg">We automatically designate a standby musician on call.</p>
            </div>
          </div>
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-[#F4EDE3] flex items-center justify-center text-[#B65B35] font-bold text-xl">3</div>
            <div>
              <h4 class="text-xl font-bold text-[#1D2323] mb-2">Failover logic</h4>
              <p class="text-[#6B6B67] text-lg">If the primary is delayed or sick, the standby is dispatched instantly.</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Right side image with overlapping UI -->
      <div class="relative rounded-3xl overflow-hidden h-[600px] shadow-2xl">
        <ResponsivePicture stem="photo-oct-12-2026-at-10-50-46-am-2" widths={[480,768,1200]} sizes="50vw" alt="Worship Staffing" class="absolute inset-0 w-full h-full object-cover object-center" loading="lazy" decoding="async" />
        
        <!-- Simulated Glass UI snippet -->
        <div class="absolute bottom-10 right-10 w-full max-w-sm bg-white/90 backdrop-blur-2xl rounded-2xl shadow-[0_20px_50px_-12px_rgba(0,0,0,0.3)] border border-white/50 p-6">
          <div class="flex justify-between items-center mb-5 border-b border-[#DED6CC] pb-4">
            <div>
              <div class="flex items-center gap-2">
                <h5 class="font-bold text-[#1D2323]">Sunday Morning Service</h5>
                <span class="text-[9px] bg-[#E8E1D9] text-[#6B6B67] px-1.5 py-0.5 rounded uppercase font-bold tracking-wider">Demo</span>
              </div>
              <div class="text-xs text-[#6B6B67] mt-1">Oct 18, 9:00 AM • Main Sanctuary</div>
            </div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#26865B] bg-[#26865B]/10 px-3 py-1.5 rounded-full">Fully Staffed</span>
          </div>
          <div class="space-y-5">
            <div class="flex items-center gap-4 relative">
              <!-- Connection line to standby -->
              <div class="absolute left-[19px] top-10 w-[2px] h-6 bg-gradient-to-b from-[#26865B] to-[#DED6CC]"></div>
              
              <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0 border-2 border-[#26865B]">
                <ResponsivePicture stem="photo-oct-12-2026-at-10-50-26-am-2" widths={[480,768]} sizes="40px" alt="Sarah M" class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </div>
              <div class="flex-1">
                <div class="text-sm font-bold text-[#1D2323] flex items-center gap-2">Sarah M. <span class="text-[10px] bg-[#26865B] text-white px-1.5 py-0.5 rounded font-medium uppercase">Primary</span></div>
                <div class="text-xs text-[#6B6B67]">Keys • Confirmed</div>
              </div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#26865B] shadow-[0_0_8px_#26865B]"></div>
            </div>
            <div class="flex items-center gap-4 opacity-80">
              <div class="w-10 h-10 rounded-full border-2 border-dashed border-[#DED6CC] p-0.5">
                <div class="w-full h-full rounded-full bg-[#F4EDE3] flex items-center justify-center text-xs font-bold text-[#6B6B67]">DK</div>
              </div>
              <div class="flex-1">
                <div class="text-sm font-bold text-[#1D2323] flex items-center gap-2">David K. <span class="text-[10px] bg-[#DED6CC] text-[#1D2323] px-1.5 py-0.5 rounded font-medium uppercase">Standby</span></div>
                <div class="text-xs text-[#6B6B67]">Keys • On-Call</div>
              </div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#D7AD86]"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
