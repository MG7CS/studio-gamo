---
import SectionEyebrow from '../editorial/SectionEyebrow.astro';

const steps = [
  {
    number: '01', symbol: 'church' as const, title: 'Post Your Need',
    description: 'Tell us the date, instruments, and worship schedule.',
  },
  {
    number: '02', symbol: 'users' as const, title: 'Get Matched',
    description: 'Discover musicians for your style and location.',
  },
  {
    number: '03', symbol: 'phone' as const, title: 'Primary & Standby',
    description: 'See the lead musician and the available backup.',
  },
  {
    number: '04', symbol: 'music' as const, title: 'Worship Continues',
    description: 'Keep the focus on music and your congregation.',
  },
];
---
<section id="coverage" aria-labelledby="how-it-works-title" class="relative overflow-hidden bg-[#1D2323]">
  <!-- Process strip continues on the dark band so Coverage reads as one section. -->
  <div class="relative mx-auto grid max-w-[1536px] gap-10 px-6 pt-20 pb-16 text-white sm:px-12 lg:pt-24 lg:pb-24 lg:grid-cols-[330px_minmax(0,1fr)] lg:gap-8 lg:px-[4.5%]">
    <div class="lg:pt-4">
      <SectionEyebrow label="How It Works" theme="dark" />
      <h3 id="how-it-works-title" class="mt-7 max-w-[360px] section-subheading text-white">
        From booking to backup, <span class="text-[#D4865B]">built for peace of mind.</span>
      </h3>
    </div>
    <div class="-mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pt-5 pb-3 sm:mx-0 sm:grid sm:overflow-visible sm:px-0 sm:pb-0 [&>*]:w-[78%] [&>*]:shrink-0 [&>*]:snap-start sm:[&>*]:w-auto sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <article data-reveal class="flex h-full flex-col rounded-2xl border border-white/10 bg-white/[.04] p-5 hover:-translate-y-1 lg:p-6">
          <span class="text-4xl font-bold tracking-tight text-[#D7AD86]">{step.number}</span>
          <div class="mt-6">
            <h4 class="mb-2 text-lg font-bold text-white">{step.title}</h4>
            <p class="text-sm leading-relaxed text-[#F4EDE3]/70">{step.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
