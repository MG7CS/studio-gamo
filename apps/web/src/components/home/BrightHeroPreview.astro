---
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import ProgramCard from '@studio-gamo/ui/components/ProgramCard.astro';
import { programs } from '../../data/organization';
---
<section aria-labelledby="bright-hero-title" class="relative overflow-hidden bg-cream px-6 pt-32 pb-16 sm:px-12 lg:pt-40">
  <div class="mx-auto max-w-[1440px]">
    <div class="grid items-center gap-10 lg:grid-cols-[.85fr_1.15fr] lg:gap-8">
      <div class="relative z-10"><p class="eyebrow text-terracotta">Music / people / churches / communities</p><h1 id="bright-hero-title" class="display-xl mt-6">Keep Worship<br /><span class="text-terracotta">Going.</span></h1><p class="mt-7 max-w-lg text-lg leading-relaxed text-ink-soft">Strengthening Christian worship and community through skilled musicians, music education, and shared experiences.</p><div class="mt-8 flex flex-wrap gap-3"><ButtonLink href="#preview-programs" arrow>Explore our programs</ButtonLink><ButtonLink href="/mission" variant="secondary">Our mission</ButtonLink></div></div>
      <div class="h-[410px] overflow-hidden rounded-[160px_28px_28px_70px] sm:h-[560px] lg:h-[610px] lg:rounded-[230px_0_0_100px]"><Photo name="worshipLeaderGolden" sizes="(min-width:1024px) 55vw, 100vw" position="50% 28%" priority /></div>
    </div>
    <div id="preview-programs" class="relative z-10 mt-7 grid gap-4 sm:grid-cols-2 lg:ml-[28%] lg:-mt-24 lg:grid-cols-4">{programs.map((p) => <ProgramCard title={`Gamo ${p.name}`} description={p.label} photo={p.photo} href={p.href} sizes="(min-width:1024px) 17vw, (min-width:640px) 45vw, 100vw" />)}</div>
  </div>
</section>
