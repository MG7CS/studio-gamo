---
---
<section class="relative min-h-screen flex items-center pt-24 pb-12 overflow-hidden">
  <!-- Full Bleed Background Image with dark gradient fade to left -->
  <div class="absolute inset-0 z-0">
    <picture>
      <source type="image/avif" srcset="/images/optimized/photo-oct-12-2026-at-10-50-25-am-1-480w.avif 480w, /images/optimized/photo-oct-12-2026-at-10-50-25-am-1-768w.avif 768w, /images/optimized/photo-oct-12-2026-at-10-50-25-am-1-1200w.avif 1200w, /images/optimized/photo-oct-12-2026-at-10-50-25-am-1-1600w.avif 1600w" sizes="100vw" />
      <source type="image/webp" srcset="/images/optimized/photo-oct-12-2026-at-10-50-25-am-1-480w.webp 480w, /images/optimized/photo-oct-12-2026-at-10-50-25-am-1-768w.webp 768w, /images/optimized/photo-oct-12-2026-at-10-50-25-am-1-1200w.webp 1200w, /images/optimized/photo-oct-12-2026-at-10-50-25-am-1-1600w.webp 1600w" sizes="100vw" />
      <img src="/images/optimized/photo-oct-12-2026-at-10-50-25-am-1-1600w.webp" alt="Keyboardist playing worship" class="w-full h-full object-cover object-center" fetchpriority="high" loading="eager" decoding="sync" />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-r from-[#1D2323] via-[#1D2323]/80 to-transparent"></div>
  </div>
  
  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div class="max-w-xl space-y-8 text-white">
      <h1 class="text-6xl md:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[1.05]">
        Keep Worship<br/>Going.
      </h1>
      <p class="text-xl md:text-2xl text-[#F4EDE3]/80 leading-relaxed font-medium">
        Reliable musicians for every service. A curated roster of professionals ready when you need them.
      </p>
      <div class="flex flex-col sm:flex-row items-center gap-4 pt-6">
        <a href="/worship/hire" class="bg-[#B65B35] text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-[#8F432A] transition-colors w-full sm:w-auto text-center">
          Hire a Musician
        </a>
        <a href="/worship/apply" class="bg-white/10 backdrop-blur-md text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-white/20 transition-colors border border-white/20 w-full sm:w-auto text-center">
          Join the Roster
        </a>
      </div>
    </div>

    <!-- Floating UI Glassmorphism Cards -->
    <div class="hidden lg:block relative h-[600px] w-full">
      <!-- Musician Card -->
      <div class="absolute bottom-32 right-10 bg-white/10 backdrop-blur-xl border border-white/20 p-5 rounded-2xl shadow-2xl flex items-center gap-4 w-72 transform rotate-[-2deg] hover:rotate-0 transition-transform duration-500">
        <div class="w-14 h-14 rounded-full overflow-hidden flex-shrink-0">
          <picture>
            <source type="image/avif" srcset="/images/optimized/photo-oct-12-2026-at-10-50-26-am-2-480w.avif 480w, /images/optimized/photo-oct-12-2026-at-10-50-26-am-2-768w.avif 768w" sizes="56px" />
            <source type="image/webp" srcset="/images/optimized/photo-oct-12-2026-at-10-50-26-am-2-480w.webp 480w, /images/optimized/photo-oct-12-2026-at-10-50-26-am-2-768w.webp 768w" sizes="56px" />
            <img src="/images/optimized/photo-oct-12-2026-at-10-50-26-am-2-768w.webp" alt="David K." class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </picture>
        </div>
        <div>
          <div class="font-bold text-white text-lg flex items-center gap-2">David K. <svg class="w-4 h-4 text-[#26865B]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg></div>
          <div class="text-white/70 text-sm">Keys • Vocals</div>
        </div>
      </div>

      <!-- Church Service Card -->
      <div class="absolute top-20 left-10 bg-white/10 backdrop-blur-xl border border-white/20 p-4 rounded-2xl shadow-2xl w-80 transform rotate-[3deg] hover:rotate-0 transition-transform duration-500">
        <div class="w-full h-32 rounded-lg overflow-hidden mb-4">
          <picture>
            <source type="image/avif" srcset="/images/optimized/photo-oct-12-2026-at-10-50-33-am-10-480w.avif 480w, /images/optimized/photo-oct-12-2026-at-10-50-33-am-10-768w.avif 768w, /images/optimized/photo-oct-12-2026-at-10-50-33-am-10-1200w.avif 1200w" sizes="300px" />
            <source type="image/webp" srcset="/images/optimized/photo-oct-12-2026-at-10-50-33-am-10-480w.webp 480w, /images/optimized/photo-oct-12-2026-at-10-50-33-am-10-768w.webp 768w, /images/optimized/photo-oct-12-2026-at-10-50-33-am-10-1200w.webp 1200w" sizes="300px" />
            <img src="/images/optimized/photo-oct-12-2026-at-10-50-33-am-10-1200w.webp" alt="Church Service" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </picture>
        </div>
        <div class="font-bold text-white flex items-center justify-between">Sunday Service <span class="bg-white/20 text-[10px] uppercase px-2 py-0.5 rounded border border-white/30">Demo</span></div>
        <div class="text-white/70 text-sm mb-3">Today at 9:00 AM</div>
        <div class="w-full bg-white/20 h-2 rounded-full overflow-hidden">
          <div class="bg-[#26865B] h-full w-[80%]"></div>
        </div>
        <div class="text-right text-xs text-white/50 mt-1">Status: Covered</div>
      </div>
    </div>
  </div>
  
  <!-- Curved bottom overlap to next section -->
  <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none z-10 translate-y-[1px]">
    <svg viewBox="0 0 1440 120" class="w-full h-[60px] md:h-[120px]" preserveAspectRatio="none">
      <path d="M0,120 C320,0 1120,0 1440,120 L1440,120 L0,120 Z" fill="#F4EDE3"></path>
    </svg>
  </div>
</section>
