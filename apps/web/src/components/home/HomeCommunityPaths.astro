---
/**
 * Audience routing & stewardship section matching /get-started GetStartedRoutes
 * and /partners PartnershipOpportunities.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { participation } from '../../data/organization';

const featuredPaths = participation.slice(0, 6);
---

<section id="paths" aria-labelledby="home-paths-title" class="bg-ivory px-5 section-space sm:px-8">
  <div class="mx-auto max-w-[1320px]">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <EditorialHeading
        id="home-paths-title"
        eyebrow="Who we serve"
        title="Find your place"
        accent="in the mission."
        lede="Whether you lead a congregation, play an instrument, want lessons for your child, or organize Christian gatherings, there is a clear path designed for you."
      />
      <a
        href="/get-involved"
        class="inline-flex items-center gap-2 text-sm font-semibold text-terracotta hover:underline"
      >
        See all ways to get involved <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-10 grid gap-x-10 md:grid-cols-2">
      {featuredPaths.map((p, i) => (
        <a href={p.href} data-reveal class="group flex items-center gap-5 border-t border-sand py-6 sm:gap-6">
          <div
            class:list={[
              'h-[120px] w-[96px] shrink-0 overflow-hidden bg-sand sm:h-[145px] sm:w-[118px]',
              i % 2 ? 'rounded-[56px_20px_20px_20px]' : 'rounded-[64px_64px_20px_20px]',
            ]}
          >
            <Photo name={p.photo} sizes="120px" alt="" class="h-full w-full object-cover" />
          </div>
          <div class="min-w-0">
            <h3 class="text-xl font-bold tracking-tight text-charcoal sm:text-2xl">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft sm:text-base">{p.body}</p>
            <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-terracotta group-hover:underline">
              {p.action}
              <Icon name="arrow" class="h-4 w-4 shrink-0" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
