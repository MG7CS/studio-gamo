---
import SectionEyebrow from '../editorial/SectionEyebrow.astro';
import StoryPreviewCard from '../editorial/StoryPreviewCard.astro';

const examples = [
  { heading: 'Last-minute coverage', description: 'A worship leader needs a substitute keys player before Sunday. The proposed roster helps them identify a nearby, qualified musician.', stem: 'photo-oct-12-2026-at-10-50-25-am-1', widths: [480,768,1200] },
  { heading: 'A stronger team', description: 'A growing church wants recurring bass and drum support. A consistent booking plan can help the team prepare together.', stem: 'photo-oct-12-2026-at-10-50-27-am-3', widths: [480,768] },
  { heading: 'Peace of mind', description: 'A scheduled musician becomes unavailable. The proposed standby workflow gives the worship director an additional option.', stem: 'photo-oct-12-2026-at-10-50-46-am-2', widths: [480,768,1200] },
];
---
<section id="stories" aria-labelledby="stories-title" class="relative overflow-hidden bg-[#F4EDE3] py-20 lg:py-28">
  <div class="mx-auto grid max-w-[1536px] gap-12 px-6 sm:px-12 lg:grid-cols-[minmax(275px,.9fr)_minmax(0,2.15fr)] lg:gap-10 lg:px-[4.5%]">
    <div class="lg:pt-6">
      <SectionEyebrow label="Church Stories · Preview" />
      <h2 id="stories-title" class="mt-6 text-[clamp(2.8rem,4.3vw,4.4rem)] font-extrabold leading-[1.03] tracking-[-.05em] text-[#1D2323]">
        Real Churches. <span class="block text-[#B65B35]">Real Stories.</span>
      </h2>
      <p class="mt-6 max-w-sm text-lg leading-relaxed text-[#626866]">We're building a service around dependable musicians, meaningful worship, and lasting community connections.</p>
      <p class="mt-4 max-w-sm text-sm font-medium text-[#8F432A]">These examples illustrate planned use cases. Verified church testimonials will be added after launch.</p>
      <div class="mt-7 flex gap-3" aria-hidden="true">
        <span class="flex h-11 w-11 items-center justify-center rounded-full border border-[#D9C8B8] text-xl text-[#B65B35]">←</span>
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-[#B65B35] text-xl text-white">→</span>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      {examples.map((example) => <StoryPreviewCard {...example} />)}
    </div>
  </div>
</section>
