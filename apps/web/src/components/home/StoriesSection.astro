---
import SectionEyebrow from '../editorial/SectionEyebrow.astro';
import StoryPreviewCard from '../editorial/StoryPreviewCard.astro';

const examples = [
  { heading: 'Last-minute coverage', description: 'A worship leader needs a substitute keys player before Sunday. The proposed roster helps them identify a nearby, qualified musician.' },
  { heading: 'A stronger team', description: 'A growing church wants recurring bass and drum support. A consistent booking plan can help the team prepare together.' },
  { heading: 'Peace of mind', description: 'A scheduled musician becomes unavailable. The proposed standby workflow gives the worship director an additional option.' },
];
---
<section id="stories" aria-labelledby="stories-title" class="relative overflow-hidden bg-[#F4EDE3] pt-10 pb-16 lg:pt-14 lg:pb-24">
  <div class="mx-auto mb-12 max-w-[1536px] px-6 sm:px-12 lg:mb-16 lg:px-[4.5%]" aria-hidden="true"><div class="h-px bg-[#D9C8B8]"></div></div>
  <div class="mx-auto grid max-w-[1536px] gap-12 px-6 sm:px-12 lg:grid-cols-[minmax(275px,.9fr)_minmax(0,2.15fr)] lg:gap-10 lg:px-[4.5%]">
    <div class="lg:pt-6">
      <SectionEyebrow label="Church Stories · Preview" />
      <h2 id="stories-title" class="mt-6 section-heading text-[#1D2323]">
        Real Churches. <span class="block text-[#B65B35]">Real Stories.</span>
      </h2>
      <p class="mt-6 max-w-sm text-lg leading-relaxed text-[#626866]">We're building a service around dependable musicians, meaningful worship, and lasting community connections.</p>
      <p class="mt-4 max-w-sm text-sm font-medium text-[#8F432A]">These examples illustrate planned use cases. Verified church testimonials will be added after launch.</p>
    </div>
    <div class="-mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pt-5 pb-3 sm:mx-0 sm:grid sm:overflow-visible sm:px-0 sm:pb-0 [&>*]:w-[78%] [&>*]:shrink-0 [&>*]:snap-start sm:[&>*]:w-auto sm:grid-cols-3">
      {examples.map((example) => <StoryPreviewCard {...example} />)}
    </div>
  </div>
</section>
