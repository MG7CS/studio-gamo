---
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
import SectionEyebrow from '../editorial/SectionEyebrow.astro';
import Icon from '../editorial/Icon.astro';
import InitialsAvatar from '../editorial/InitialsAvatar.astro';

const categories = [
  { label: 'Keyboardists', symbol: 'piano' as const },
  { label: 'Guitarists', symbol: 'guitar' as const },
  { label: 'Bassists', symbol: 'music' as const },
  { label: 'Drummers', symbol: 'drums' as const },
  { label: 'Vocalists', symbol: 'mic' as const },
  { label: 'More Instruments', symbol: 'users' as const },
];
const waveform = [10,22,14,31,16,27,39,19,34,13,27,19,11,28,18,8,16,23,10];
---
<section id="musicians" aria-labelledby="musicians-title" class="relative overflow-hidden bg-[#F4EDE3] py-8 lg:pt-0 lg:pb-0">
  <div class="mx-auto max-w-[1536px]">
    <div class="relative flex min-h-[calc(100svh-4rem)] flex-col justify-center lg:block lg:min-h-0 lg:h-[670px]">
      <!-- The left editorial panel is intentionally narrower than the photographic mosaic. -->
      <div class="relative z-20 order-2 mt-6 px-6 sm:px-12 lg:mt-0 lg:absolute lg:top-1/2 lg:-translate-y-1/2 lg:left-0 lg:w-[38%] lg:px-[4.5%] lg:pb-0">
        <SectionEyebrow label="The Gamo Collection" />
        <h2 id="musicians-title" class="mt-4 lg:mt-7 section-heading text-[#1D2323]">
          Meet the <span class="block text-[#854630]">Musicians</span>
        </h2>
        <p class="mt-6 max-w-[20rem] text-lg leading-relaxed text-[#303737] lg:text-xl">
          Skilled musicians who serve. Each one auditions and is reviewed before serving a church — and is paid fairly.
        </p>
        <a href="https://worship.gamostudios.com/" class="mt-7 inline-flex items-center gap-8 rounded-full bg-[#B65B35] px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-[#8F432A] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#B65B35]">
          Explore Gamo Worship <Icon name="arrow" class="h-5 w-5" />
        </a>
        <div class="mt-9 hidden lg:block">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[.18em] text-[#8F432A]">Browse by instrument</p>
          <ul class="flex flex-wrap gap-2">
            {categories.map((category) => (
              <li><a href="https://worship.gamostudios.com/" class="inline-flex items-center gap-2 rounded-full border border-[#D9C8B8] bg-[#FFF9F2] py-1.5 pl-1.5 pr-4 text-sm font-semibold text-[#1D2323] transition-colors hover:border-[#B65B35] hover:bg-white"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#F4EDE3] text-[#8F432A]" aria-hidden="true"><Icon name={category.symbol} class="h-4 w-4" /></span>{category.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Featured keyboardist. On desktop this photograph sculpts the cream/text transition. -->
      <div class="roster-feature relative order-1 mx-5 h-[32svh] min-h-[160px] [@media(max-height:720px)]:h-[25svh] overflow-hidden rounded-3xl bg-[#1D2323] sm:mx-10 lg:absolute lg:inset-y-0 lg:right-0 lg:mx-0 lg:h-full lg:w-[60%] lg:rounded-none">
        <ResponsivePicture stem="photo-oct-12-2026-at-10-50-46-am-2" widths={[480,768,1200]} sizes="(min-width: 1024px) 60vw, 100vw" alt="Gospel keyboardist playing with a church worship team" class="h-full w-full object-cover object-[58%_center]" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
      </div>

      <!-- Sample audition panel: visually demonstrates the planned audition review step (demo content). -->
      <div class="relative z-20 hidden lg:block rounded-[24px] border border-white/35 bg-[#202527]/85 p-5 text-[#F4EDE3] shadow-2xl backdrop-blur-xl sm:mx-16 lg:absolute lg:bottom-10 lg:right-[4%] lg:mx-0 lg:mt-0 lg:w-[360px]">
        <div class="mb-4 flex items-center gap-3">
          <InitialsAvatar initials="MT" />
          <div class="min-w-0">
            <div class="flex items-center gap-2 text-lg font-semibold">Marcus T.</div>
            <p class="text-xs text-[#F4EDE3]/75">Keys · Gospel & CCM</p>
          </div>
          <span class="ml-auto rounded-full border border-white/20 px-2 py-1 text-[10px] uppercase tracking-widest text-white/70">Demo</span>
        </div>
        <div class="flex items-center gap-3" aria-label="Audition player preview; playback not available">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#F4EDE3] text-[#1D2323]" aria-hidden="true"><Icon name="play" class="h-4 w-4 fill-current" /></span>
          <div class="flex h-9 min-w-0 flex-1 items-center justify-center gap-[3px] overflow-hidden" aria-hidden="true">
            {waveform.map((height) => <span class="w-[3px] shrink-0 rounded-full bg-[#D7AD86]" style={{height: height + 'px'}}></span>)}
          </div>
          <span class="text-[11px] text-white/70">0:00 / 2:15</span>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          {['Keys','MainStage','Nashville Numbers'].map((tag) => <span class="rounded-full border border-white/25 bg-white/5 px-3 py-1 text-[11px]">{tag}</span>)}
        </div>
        <p class="mt-3 flex items-center gap-2 text-xs text-white/70"><Icon name="pin" class="h-4 w-4" />Phoenix Metro · Sample profile</p>
      </div>

    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .roster-feature {
      clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%, 12% 74%, 0 35%);
      border-top-left-radius: 18% 38%;
    }
  }
</style>
