---
/**
 * Gamo Production spotlight on the global homepage using the shared EditorialFeatureCard.
 */
import EditorialFeatureCard, {
  type EditorialFeaturePoint,
} from '@studio-gamo/ui/components/EditorialFeatureCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { siteUrl, inquiryUrl } from '@studio-gamo/ui/lib/sites';

const areas: EditorialFeaturePoint[] = [
  {
    icon: 'sliders',
    title: 'Sanctuary and stage audio',
    body: 'Clear vocals, balanced monitor mixes and sensible gain staging.',
  },
  {
    icon: 'video',
    title: 'Livestream and broadcast',
    body: 'Reliable cameras and dedicated broadcast audio for people at home.',
  },
  {
    icon: 'users',
    title: 'Volunteer training',
    body: 'Hands-on coaching so volunteers feel confident behind the console.',
  },
];
---

<EditorialFeatureCard
  id="production"
  eyebrow="04 · Gamo Production"
  pillText="Proposal"
  pillKind="proposal"
  title="Serving those"
  accent="behind the board."
  body="Good sound and media keep the focus on worship. We equip churches and train volunteers."
  points={areas}
  photo="soundEngineer"
  photoPosition="40% 40%"
  caption="Booth readiness and volunteer training"
  tone="sand"
  sectionClass="bg-cream"
>
  <ButtonLink href={inquiryUrl('Production consultation')} arrow>
    Request a needs assessment
  </ButtonLink>
  <ButtonLink href={siteUrl('academy', '/#production-training')} variant="secondary">
    Volunteer training
  </ButtonLink>
</EditorialFeatureCard>
