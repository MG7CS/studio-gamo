---
/**
 * Gamo Production spotlight on the global homepage using the shared rounded-edge
 * EditorialFeatureCard component for visual continuity across public pages.
 */
import EditorialFeatureCard, {
  type EditorialFeaturePoint,
} from '@studio-gamo/ui/components/EditorialFeatureCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { siteUrl, inquiryUrl } from '@studio-gamo/ui/lib/sites';

const areas: EditorialFeaturePoint[] = [
  {
    icon: 'sliders',
    title: 'Sanctuary & stage audio',
    body: 'Clear vocal presence, balanced monitor mixes, and practical room gain staging.',
  },
  {
    icon: 'video',
    title: 'Livestream & broadcast clarity',
    body: 'Reliable camera workflows and dedicated broadcast audio for homebound congregants.',
  },
  {
    icon: 'users',
    title: 'Volunteer team training',
    body: 'Patient, hands-on coaching so church volunteers feel confident behind the console.',
  },
];
---

<EditorialFeatureCard
  id="production"
  eyebrow="04 · Gamo Production"
  pillText="Proposed technical ministry"
  pillKind="proposal"
  title="Better tools and training"
  accent="for the team behind the board."
  body="Good sound, light, and media help a congregation focus on worship rather than technical distractions. Gamo Production is a proposed program to equip churches and train their volunteers."
  points={areas}
  photo="soundEngineer"
  photoPosition="40% 40%"
  caption="Sunday booth readiness & volunteer training (proposed)"
  tone="sand"
  sectionClass="bg-cream"
>
  <ButtonLink href={inquiryUrl('Production consultation')} arrow>
    Request a needs assessment
  </ButtonLink>
  <ButtonLink href={siteUrl('production', '/training')} variant="secondary">
    Explore volunteer training
  </ButtonLink>
</EditorialFeatureCard>
