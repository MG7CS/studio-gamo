---
/**
 * Gamo Production spotlight + Why We Exist principles, matching apps/production
 * and apps/web/src/components/mission/WhyWeExist.astro.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';

const areas = [
  {
    icon: 'sliders' as const,
    title: 'Sanctuary & stage audio',
    detail: 'Clear vocal presence, balanced monitor mixes, and practical room gain staging.',
  },
  {
    icon: 'video' as const,
    title: 'Livestream & broadcast clarity',
    detail: 'Reliable camera workflows and dedicated broadcast audio for homebound congregants.',
  },
  {
    icon: 'light' as const,
    title: 'Lighting, lyrics & visual cues',
    detail: 'Warm, distraction-free stage lighting and readable congregation lyric projection.',
  },
  {
    icon: 'users' as const,
    title: 'Volunteer team training',
    detail: 'Patient, hands-on coaching so church volunteers feel confident behind the console.',
  },
];
---

<section
  id="production"
  aria-labelledby="home-production-title"
  class="bg-cream px-5 section-space sm:px-8"
>
  <div class="mx-auto grid max-w-[1320px] items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="relative lg:col-span-5">
      <div class="aspect-[4/5] overflow-hidden rounded-[2.5rem] rounded-tr-[9rem] bg-night shadow-float">
        <Photo
          name="soundEngineer"
          sizes="(min-width:1024px) 40vw, 92vw"
          position="40% 40%"
          class="h-full w-full object-cover"
        />
      </div>

      <aside
        data-reveal
        class="relative -mt-12 ml-3 max-w-[19rem] rounded-3xl border border-sand bg-white p-5 shadow-float sm:absolute sm:-bottom-6 sm:right-0 sm:ml-0 sm:mt-0 lg:-right-6"
        aria-label="Sample technical ministry checklist"
      >
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-semibold uppercase tracking-wider text-terracotta">
            Sunday booth readiness
          </p>
          <StatusPill kind="proposal">Proposed</StatusPill>
        </div>
        <p class="mt-2 text-sm font-bold text-charcoal">Volunteer sound &amp; stream check</p>
        <ul class="mt-3 space-y-1.5 text-xs text-ink-soft">
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-3.5 w-3.5 text-terracotta" /> Pastor &amp; worship leader gain matched
          </li>
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-3.5 w-3.5 text-terracotta" /> Livestream stereo bus checked
          </li>
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-3.5 w-3.5 text-terracotta" /> Volunteer shadow rotation active
          </li>
        </ul>
      </aside>
    </div>

    <div class="lg:col-span-7">
      <EditorialHeading
        id="home-production-title"
        eyebrow="04 · Gamo Production"
        title="Better tools and training"
        accent="for the team behind the board."
        lede="Good sound, light, and media help a congregation focus on worship rather than technical distractions. Gamo Production is a proposed program to equip churches and train their volunteers."
      />

      <div class="mt-9 grid gap-4 sm:grid-cols-2">
        {areas.map((a) => (
          <div
            data-reveal
            class="rounded-3xl bg-ivory p-5 ring-1 ring-sand/80"
          >
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-cream text-terracotta">
              <Icon name={a.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-3.5 text-lg font-bold tracking-tight text-charcoal">{a.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{a.detail}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink href={siteUrl('production', '/assessment')} arrow>
          Preview a needs assessment
        </ButtonLink>
        <ButtonLink href={siteUrl('production', '/training')} variant="secondary">
          Explore volunteer training
        </ButtonLink>
      </div>
    </div>
  </div>
</section>
