---
/**
 * Home page Gamo Academy section (restored 2026-11-18 without the label above the heading and the sentence under
 * it, DESIGN.md section 11): heading, the instruments as flat linked rows, the scholarship note (plain text, no
 * tag; 2026-11-19) and two actions, beside one portrait photo of the young pianist (2026-11-19: one larger photo
 * instead of two small ones, at least as tall as the text; the mentor photo already leads the programs block).
 */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import type { IconName } from '@studio-gamo/ui/lib/icons';

const instruments: { name: string; age: string; path: string; icon: IconName }[] = [
  { name: 'Piano & Keys', age: 'Ages 6 to adult', path: '/instruments/piano', icon: 'piano' },
  {
    name: 'Acoustic & Electric Guitar',
    age: 'Ages 7 to adult',
    path: '/instruments/acoustic-guitar',
    icon: 'guitar',
  },
  { name: 'Voice & Worship Vocals', age: 'Ages 8 to adult', path: '/instruments/vocals', icon: 'mic' },
  { name: 'Drums & Rhythm', age: 'Ages 7 to adult', path: '/instruments/drums', icon: 'drums' },
  { name: 'Bass Guitar', age: 'Ages 9 to adult', path: '/instruments/bass', icon: 'music' },
  { name: 'Ensemble & Group Labs', age: 'Youth & families', path: '/instruments', icon: 'users' },
];
---

<SplitHero
  as="section"
  spacing="section"
  mediaSide="start"
  tone="raised"
  id="academy"
  aria-labelledby="home-academy-title"
>
  <h2 id="home-academy-title" class="section-heading text-balance text-fg">
    Learn to Play the <span class="text-accent">Instrument You Love.</span>
  </h2>

  <ul class="mt-8 grid gap-x-6 sm:grid-cols-2">
    {instruments.map((inst) => (
      <li class="border-t border-border">
        <a
          href={siteUrl('academy', inst.path)}
          class="flex min-h-11 items-center gap-3 py-3 text-fg hover:text-action"
        >
          <Icon name={inst.icon} class="size-5 shrink-0 text-action" />
          <span class="min-w-0">
            <span class="block text-body-sm font-semibold">{inst.name}</span>
            <span class="block text-small text-fg-muted">{inst.age}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="mt-8 flex flex-wrap gap-3">
    <ButtonLink href={siteUrl('academy', '/instruments')} arrow>
      Choose an instrument
    </ButtonLink>
    <ButtonLink href={siteUrl('academy', '/sponsored')} variant="secondary">
      Read about scholarship cohorts
    </ButtonLink>
  </div>

  <Frame
    slot="media"
    photo="youngPianist"
    ratio="portrait"
    sizes="half"
    alt="Young pianist smiling while playing a keyboard in a bright classroom"
  />
</SplitHero>
