---
/**
 * Gamo Academy spotlight section using the approved headline
 * "Learn to Play the Instrument You Love." Photo first, then the instrument list.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import type { IconName } from '@studio-gamo/ui/lib/icons';

const instruments: { name: string; age: string; slug: string; icon: IconName }[] = [
  { name: 'Piano and keys', age: 'Ages 6 to adult', slug: 'piano', icon: 'piano' },
  { name: 'Guitar', age: 'Ages 7 to adult', slug: 'acoustic-guitar', icon: 'guitar' },
  { name: 'Voice', age: 'Ages 8 to adult', slug: 'vocals', icon: 'mic' },
  { name: 'Drums', age: 'Ages 7 to adult', slug: 'drums', icon: 'drums' },
  { name: 'Bass guitar', age: 'Ages 9 to adult', slug: 'bass', icon: 'music' },
  { name: 'Group labs', age: 'Youth and families', slug: 'piano', icon: 'users' },
];
---

<section id="academy" aria-labelledby="home-academy-title" class="bg-ivory px-5 section-space sm:px-8">
  <div class="mx-auto max-w-[1320px]">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="relative mx-auto w-full max-w-[540px] lg:col-span-5">
        <div class="rounded-[28px] aspect-[4/5] overflow-hidden bg-sand shadow-float">
          <Photo
            name="guitarMentor"
            sizes="(min-width:1024px) 38vw, 90vw"
            position="55% 40%"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="rounded-[28px] absolute -bottom-5 right-0 aspect-square w-[40%] overflow-hidden border-[6px] border-ivory bg-sand shadow-float sm:-right-5">
          <Photo
            name="youngPianist"
            sizes="(min-width:1024px) 15vw, 36vw"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <div class="lg:col-span-7">
        <p class="eyebrow-pill">02 · Gamo Academy</p>
        <h2 id="home-academy-title" class="section-heading mt-4 text-balance text-charcoal">
          Learn to Play the <span class="text-terracotta">Instrument You Love.</span>
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          Patient, screened instructors for private lessons and small groups. Open to anyone.
        </p>

        <ul class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {instruments.map((inst) => (
            <li>
              <a
                href={siteUrl('academy', `/instruments/${inst.slug}`)}
                class="group flex min-h-16 items-center gap-3 rounded-2xl bg-white p-3 ring-1 ring-sand transition hover:-translate-y-0.5 hover:shadow-float"
              >
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-cream text-terracotta transition group-hover:bg-terracotta group-hover:text-white">
                  <Icon name={inst.icon} class="h-5 w-5" />
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-sm font-bold text-charcoal">{inst.name}</span>
                  <span class="block truncate text-xs text-ink-soft">{inst.age}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-6 rounded-3xl bg-sand p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-sm font-bold text-charcoal">Lessons should not depend on budget.</p>
            <StatusPill kind="proposal">Proposal</StatusPill>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            Churches and organizations can sponsor classes. Pricing is still a proposal.
          </p>
        </div>

        <div class="button-stack mt-7">
          <ButtonLink href={siteUrl('academy', '/instruments')} arrow>
            Choose an instrument
          </ButtonLink>
          <ButtonLink href={siteUrl('academy', '/sponsored')} variant="secondary">
            Sponsored classes
          </ButtonLink>
        </div>
      </div>
    </div>
  </div>
</section>
