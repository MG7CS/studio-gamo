---
/**
 * Global homepage hero ("Worship, Learning & Community"): only the content (heading, button, photos); the layout is
 * the shared PhotoTrioHero (DESIGN.md section 11).
 */
import PhotoTrioHero from '@studio-gamo/ui/components/content/PhotoTrioHero.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<PhotoTrioHero
  id="home-hero-title"
  title="Preparing the Way"
  accent="so Worship Can Rise in Communities"
  photos={[
    {
      photo: 'worshipLeaderGolden',
      alt: 'Gospel worship leader singing with eyes closed in warm golden light',
      priority: true,
    },
    { photo: 'boyGuitar', alt: 'Smiling boy learning to play acoustic guitar' },
    { photo: 'sanctuaryCongregation', alt: 'Congregation worshipping together in a sunlit sanctuary' },
  ]}
>
  <ButtonLink slot="actions" href="#programs" size="lg" arrow>
    Explore our programs
  </ButtonLink>
</PhotoTrioHero>
