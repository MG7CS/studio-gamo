---
/**
 * Global homepage hero ("Worship, Learning & Community"). Clean layout rules (DESIGN.md section 11): a heading
 * and one action over a full-width photo; no sentence, no label, no card. The photo is an owner-supplied
 * illustration (docs/ASSET_MANIFEST.md), so it is never captioned as a real person. Two stacked scrims
 * (token `scrim`) darken the left and bottom edges, where the text sits, to keep the contrast at AA.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
---

<section
  class="relative flex min-h-dvh flex-col justify-end overflow-hidden bg-ink page-intro-space text-cream"
  aria-labelledby="home-hero-title"
>
  <div class="absolute inset-0">
    <Photo name="illustrationSingerCloseUp" sizes="100vw" priority />
  </div>
  <div class="absolute inset-0 bg-linear-to-t from-scrim via-scrim to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-linear-to-r from-scrim via-scrim to-transparent" aria-hidden="true"></div>

  <Container class="relative">
    <h1 id="home-hero-title" class="display-xl max-w-[14ch] text-balance text-cream">
      Worship, Learning &amp; Community
    </h1>
    <div class="mt-8">
      <ButtonLink href="#programs" variant="light" size="lg" arrow>
        Explore our programs
      </ButtonLink>
    </div>
  </Container>
</section>
