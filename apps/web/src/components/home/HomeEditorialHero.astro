---
/**
 * Approved global homepage hero ("Where Worship, Learning & Community Meet."). Composition preserved;
 * colours and sizes use semantic tokens. The floating mission card is organizational copy, not sample data.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
---

<section
  class="relative flex min-h-dvh flex-col justify-center overflow-hidden bg-surface page-intro-space text-fg"
  aria-labelledby="home-hero-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-28 top-16 size-120 rounded-full bg-surface-raised/80 blur-2xl"
  ></div>

  <Container class="relative grid items-center gap-10 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <p class="eyebrow text-action-strong">Christian, mission-driven organization</p>
      <h1 id="home-hero-title" class="display-xl mt-4 max-w-[14ch] text-balance text-fg">
        Where Worship, Learning &amp; <span class="block text-action">Community Meet.</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-fg-muted sm:text-lg">
        Gamo Studios brings together three connected programs serving students, families, churches and
        musicians: teaching instruments, preparing worship teams and supporting technical ministry.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <ButtonLink href="#programs" size="lg" arrow>
          Explore our programs
        </ButtonLink>
        <ButtonLink href="/get-started" size="lg" variant="secondary">
          Find where to begin
        </ButtonLink>
      </div>
    </div>

    <div class="relative order-first mx-auto w-full max-w-xl lg:order-none lg:col-span-6">
      <div class="grid grid-cols-12 items-end gap-3 sm:gap-4">
        <div class="col-span-7 aspect-3/4 overflow-hidden bg-surface-inset shadow-float mask-arch">
          <Photo
            name="worshipLeaderGolden"
            priority
            sizes="(min-width:1024px) 28vw, 58vw"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="col-span-5 flex flex-col gap-3 sm:gap-4">
          <div class="aspect-square overflow-hidden bg-surface-inset shadow-float mask-leaf-alt">
            <Photo
              name="boyGuitar"
              sizes="(min-width:1024px) 18vw, 38vw"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="aspect-portrait overflow-hidden rounded-panel rounded-br-[5.5rem] bg-surface-inset shadow-float">
            <Photo
              name="sanctuaryCongregation"
              sizes="(min-width:1024px) 18vw, 38vw"
              position="50% 40%"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>

      <aside
        class="relative z-10 -mt-10 ml-2 max-w-xs rounded-card border border-border bg-surface-raised/95 p-4 shadow-float backdrop-blur-xs sm:absolute sm:-bottom-5 sm:left-0 sm:mt-0 sm:p-5 lg:-left-4"
        aria-label="Mission overview card"
      >
        <p class="eyebrow whitespace-nowrap text-action-strong">One shared mission</p>
        <p class="mt-2 text-base font-bold tracking-tight text-fg">Learn. Worship. Serve.</p>
        <p class="mt-1 text-caption text-fg-muted">
          For young learners, congregations, vetted musicians and church volunteers.
        </p>
      </aside>
    </div>
  </Container>
</section>
