---
/**
 * Global homepage hero ("Worship, Learning & Community"). Clean layout rules (DESIGN.md section 11): the
 * heading comes first, one short paragraph, one action; no label above, no glow behind, no card over the photos.
 * The three photos are one shared PhotoGrid (rounded frames, one radius).
 */
import PhotoGrid from '@studio-gamo/ui/components/media/PhotoGrid.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
---

<section
  class="relative flex min-h-dvh flex-col justify-center overflow-hidden bg-surface page-intro-space text-fg"
  aria-labelledby="home-hero-title"
>
  <Container class="relative grid items-center gap-10 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h1 id="home-hero-title" class="display-xl max-w-[14ch] text-balance text-fg">
        Worship, Learning &amp; <span class="block text-action">Community</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-fg-muted sm:text-lg">
        Gamo Studios brings together three connected programs serving students, families, churches and
        musicians: teaching instruments, preparing worship teams and supporting technical ministry.
      </p>

      <div class="mt-8">
        <ButtonLink href="#programs" size="lg" arrow>
          Explore our programs
        </ButtonLink>
      </div>
    </div>

    <div class="order-first lg:order-none lg:col-span-7">
      <PhotoGrid
        layout="trio"
        photos={[
          {
            photo: 'instrumentVocals',
            alt: 'Microphone on a stand against a terracotta wall',
            priority: true,
          },
          { photo: 'instrumentUkulele', alt: 'Ukulele resting on a cream sofa' },
          { photo: 'techSlides', alt: 'Congregation facing a band and a projected slide' },
        ]}
      />
    </div>
  </Container>
</section>
