---
/**
 * Global homepage hero ("Worship, Learning & Community"). Clean layout rules (DESIGN.md section 11): the
 * heading comes first, then one action; no sentence under it, no label above, no glow behind, no card over the
 * photos. Two photos (the worship leader and the young guitarist) stand side by side as the shared PhotoGrid `pair`
 * in a narrower column, so their height stays close to the height of the text beside them (owner direction
 * 2026-11-19).
 */
import PhotoGrid from '@studio-gamo/ui/components/media/PhotoGrid.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
---

<section
  class="relative flex min-h-dvh flex-col justify-center overflow-hidden bg-surface page-intro-space text-fg"
  aria-labelledby="home-hero-title"
>
  <Container class="relative grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_32rem] lg:gap-16">
    <div>
      <h1 id="home-hero-title" class="display-xl max-w-[14ch] text-balance text-fg">
        Worship, Learning &amp; <span class="block text-action">Community</span>
      </h1>
      <div class="mt-10">
        <ButtonLink href="#programs" size="lg" arrow>
          Explore our programs
        </ButtonLink>
      </div>
    </div>

    <div class="order-first lg:order-none">
      <PhotoGrid
        layout="pair"
        photos={[
          {
            photo: 'worshipLeaderGolden',
            alt: 'Gospel worship leader singing with eyes closed in warm golden light',
            priority: true,
          },
          { photo: 'boyGuitar', alt: 'Smiling boy learning to play acoustic guitar' },
        ]}
      />
    </div>
  </Container>
</section>
