---
/**
 * Global homepage hero crafted to match the bright editorial language of /mission, /partners,
 * /get-involved, Worship, Academy, and Production. Phones see the photo mosaic first.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<section
  class="relative flex flex-col justify-center overflow-hidden bg-cream px-5 page-intro-space sm:px-8 lg:min-h-[100dvh]"
  aria-labelledby="home-hero-title"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-28 top-16 h-[480px] w-[480px] rounded-full bg-ivory/80 blur-2xl"
  ></div>

  <div class="relative mx-auto grid w-full max-w-[1320px] items-center gap-10 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6">
      <p class="eyebrow-pill">Christian, mission-driven organization</p>
      <h1 id="home-hero-title" class="display-xl mt-5 max-w-[14ch] text-balance text-charcoal">
        Worship, Learning &amp; <span class="block text-terracotta">Community.</span>
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
        Helping churches worship well, people learn music and believers gather together.
      </p>

      <div class="button-stack mt-7">
        <ButtonLink href="#programs" size="lg" arrow>
          Explore our programs
        </ButtonLink>
        <ButtonLink href="/get-started" size="lg" variant="secondary">
          Find where to begin
        </ButtonLink>
      </div>
    </div>

    <div class="order-first relative mx-auto w-full max-w-[580px] lg:order-none lg:col-span-6">
      <div class="grid grid-cols-12 items-end gap-3 sm:gap-4">
        <div class="col-span-7 aspect-[3/4] overflow-hidden rounded-[28px] bg-sand shadow-float">
          <Photo
            name="worshipLeaderGolden"
            priority
            sizes="(min-width:1024px) 28vw, 58vw"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="col-span-5 flex flex-col gap-3 sm:gap-4">
          <div class="aspect-square overflow-hidden rounded-[28px] bg-sand shadow-float">
            <Photo
              name="boyGuitar"
              sizes="(min-width:1024px) 18vw, 38vw"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="aspect-[4/5] overflow-hidden rounded-[28px] bg-sand shadow-float">
            <Photo
              name="sanctuaryCongregation"
              sizes="(min-width:1024px) 18vw, 38vw"
              position="50% 40%"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>

      <aside
        class="relative z-10 -mt-8 ml-2 max-w-[20rem] rounded-3xl border border-sand bg-white/95 p-4 shadow-float backdrop-blur-xs sm:absolute sm:-bottom-5 sm:left-0 sm:mt-0 sm:p-5 lg:-left-4"
        aria-label="Mission overview card"
      >
        <p class="eyebrow whitespace-nowrap text-terracotta">One shared mission</p>
        <p class="mt-2 text-base font-bold tracking-tight text-charcoal">Worship. Learn. Gather. Serve.</p>
        <p class="mt-1 text-xs leading-relaxed text-ink-soft">
          For churches, musicians, learners and Christian events.
        </p>
      </aside>
    </div>
  </div>
</section>
