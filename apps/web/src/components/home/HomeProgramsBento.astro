---
/**
 * Four-program showcase on the homepage: one card per program, photo first, short copy.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import EditorialHeading from '@gamo/site/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';
import type { IconName } from '@studio-gamo/ui/lib/icons';

interface ProgramCard {
  name: string;
  tag: string;
  title: string;
  summary: string;
  points: string[];
  href: string;
  cta: string;
  photo: PhotoKey;
  photoPosition?: string;
  icon: IconName;
  surfaceClass: string;
  dark?: boolean;
}

const programCards: ProgramCard[] = [
  {
    name: 'Gamo Live',
    tag: 'Events',
    title: 'Worship nights, concerts and gatherings.',
    summary: 'Find and share Christian events, free or ticketed. Sponsored listings are always labeled.',
    points: ['Open to Christian events nationwide', 'Free registration and paid tickets'],
    href: siteUrl('web', '/live'),
    cta: 'Explore Gamo Live',
    photo: 'worshipNight',
    photoPosition: '50% 40%',
    icon: 'calendar',
    surfaceClass: 'bg-night text-cream',
    dark: true,
  },
  {
    name: 'Gamo Worship',
    tag: 'Musicians',
    title: 'Dependable musicians, well prepared.',
    summary:
      'Vetted worship musicians for services, concerts and events. Musician pay is always its own line item.',
    points: ['Vocals, keys, guitar, bass and drums', 'Pay shown separately from any Gamo allocation'],
    href: siteUrl('worship'),
    cta: 'Explore Gamo Worship',
    photo: 'worshipBand',
    photoPosition: '55% 35%',
    icon: 'music',
    surfaceClass: 'bg-white ring-1 ring-sand',
  },
  {
    name: 'Gamo Academy',
    tag: 'Lessons',
    title: 'Learn to Play the Instrument You Love.',
    summary: 'Patient lessons in guitar, piano, vocals, bass and drums, plus production training.',
    points: ['Private and small-group lessons', 'Classes can be sponsored by a church or organization'],
    href: siteUrl('academy'),
    cta: 'Explore Gamo Academy',
    photo: 'girlGuitar',
    photoPosition: '50% 28%',
    icon: 'school',
    surfaceClass: 'bg-cream ring-1 ring-sand/80',
  },
  {
    name: 'Gamo Production',
    tag: 'Production',
    title: 'Sound, livestream and lighting that serve the message.',
    summary: 'Production support and hands-on volunteer training for churches.',
    points: ['Sanctuary audio and livestream help', 'Side-by-side volunteer training'],
    href: siteUrl('production'),
    cta: 'Explore Gamo Production',
    photo: 'soundEngineer',
    photoPosition: '40% 40%',
    icon: 'video',
    surfaceClass: 'bg-white ring-1 ring-sand',
  },
];
---

<section
  id="programs"
  aria-labelledby="home-programs-title"
  class="scroll-mt-24 bg-ivory px-5 section-space sm:px-8"
>
  <div class="mx-auto max-w-[1320px]">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <EditorialHeading
        id="home-programs-title"
        eyebrow="How we serve"
        eyebrowStyle="pill"
        title="Serving the Church"
        accent="together."
        lede="Worship, learning and gathering that build up the Church."
      />
      <div class="button-stack">
        <ButtonLink href="/mission" variant="secondary" arrow>
          Read our mission
        </ButtonLink>
      </div>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:gap-6">
      {programCards.map((p) => (
        <article
          data-reveal
          data-surface={p.dark ? 'dark' : undefined}
          class:list={[
            'group flex flex-col justify-between overflow-hidden rounded-[30px] p-3 sm:rounded-[34px] sm:p-4 transition-transform duration-300 hover:-translate-y-1',
            p.surfaceClass,
          ]}
        >
          <div>
            <div class="relative aspect-[16/10] w-full overflow-hidden rounded-[22px] bg-sand sm:aspect-[16/9] sm:rounded-[26px]">
              <Photo
                name={p.photo}
                position={p.photoPosition}
                sizes="(min-width:1024px) 45vw, 94vw"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>

            <div class="p-3 pt-5 sm:p-6">
              <p class:list={['eyebrow-pill', p.dark && 'bg-white/10 text-gold']}>
                <Icon name={p.icon} class="h-3.5 w-3.5" />
                {p.name} · {p.tag}
              </p>

              <h3 class="mt-4 text-xl font-bold tracking-tight sm:text-2xl">{p.title}</h3>
              <p class:list={['mt-2 text-base leading-relaxed', p.dark ? 'text-cream/75' : 'text-ink-soft']}>
                {p.summary}
              </p>

              <ul class="mt-4 grid gap-2">
                {p.points.map((pt) => (
                  <li
                    class:list={[
                      'flex items-start gap-2 text-sm',
                      p.dark ? 'text-cream/85' : 'text-charcoal',
                    ]}
                  >
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-terracotta" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="button-stack p-3 pt-0 sm:p-6 sm:pt-0">
            <ButtonLink href={p.href} variant={p.dark ? 'ghost-dark' : 'secondary'} arrow>
              {p.cta}
            </ButtonLink>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
