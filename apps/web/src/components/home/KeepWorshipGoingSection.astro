---
import { siteUrl } from "@studio-gamo/ui/lib/sites";
import Icon from '../editorial/Icon.astro';
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
import SectionCurve from '../editorial/SectionCurve.astro';
import SectionEyebrow from '../editorial/SectionEyebrow.astro';
---
<section id="keep-going" aria-labelledby="keep-going-title" class="relative isolate overflow-hidden bg-[#171E20] text-white">
  <SectionCurve position="top" color="#F4EDE3" />
  <div class="mx-auto grid max-w-[1536px] lg:min-h-[520px] lg:grid-cols-[42%_58%]">
    <div class="relative z-10 px-6 pt-20 pb-16 sm:px-12 lg:flex lg:flex-col lg:justify-center lg:pl-[min(4.5vw,69px)] lg:pr-10 lg:py-20">
      <SectionEyebrow label="Join Gamo Studios" theme="dark" />
      <h2 id="keep-going-title" class="mt-6 section-heading">
        Find Your Place <span class="block text-[#D4865B]">in Worship</span>
      </h2>
      <p class="mt-5 max-w-[420px] text-lg leading-relaxed text-[#F4EDE3]/85">
        Whether you’re a church looking for trusted musicians or a musician ready to serve, Gamo Studios makes it simple.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={siteUrl("worship")} class="inline-flex items-center gap-6 rounded-full bg-[#B65B35] px-7 py-3.5 font-semibold text-white transition-colors hover:bg-[#8F432A]">For Churches <Icon name="arrow" class="h-5 w-5" /></a>
        <a href={siteUrl("worship","/apply")} class="inline-flex items-center gap-6 rounded-full border border-white/65 px-7 py-3.5 font-semibold text-white transition-colors hover:bg-white/10">For Musicians <Icon name="arrow" class="h-5 w-5" /></a>
      </div>
    </div>

    <div class="relative min-h-[420px] lg:min-h-0">
      <!-- Right: musician portrait full-bleed, church exterior in a curved mask on the left. -->
      <div class="absolute inset-0">
        <ResponsivePicture stem="photo-oct-12-2026-at-10-50-26-am-2" widths={[480,768]} sizes="(min-width: 1024px) 58vw, 100vw" alt="Musician smiling toward the light at golden hour" class="h-full w-full object-cover object-[70%_center]" />
        <div class="absolute inset-0 bg-gradient-to-r from-[#171E20]/60 via-transparent to-transparent"></div>
      </div>
      <div class="keep-church absolute inset-y-0 left-0 w-[72%] overflow-hidden lg:w-[68%]">
        <ResponsivePicture stem="photo-oct-12-2026-at-10-50-33-am-10" widths={[480,768,1200]} sizes="(min-width: 1024px) 40vw, 70vw" alt="Church building at golden hour" class="h-full w-full object-cover" />
      </div>
      <!-- Floating chips: decorative marketing copy. -->
      <div class="absolute left-[6%] top-[16%] z-10 flex w-[190px] items-center gap-3 rounded-2xl border border-white/20 bg-[#1D2323]/70 p-4 text-sm leading-snug backdrop-blur-md">
        <svg class="h-8 w-8 shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v4M10 4h4M12 6l5 4v10H7V10l5-4ZM3 20h18M10 20v-5h4v5"/></svg>
        <span>Find trusted musicians for your church</span>
      </div>
      <div class="absolute bottom-[12%] right-[4%] z-10 flex w-[230px] items-center gap-3 rounded-2xl border border-white/20 bg-[#1D2323]/70 p-4 text-sm leading-snug backdrop-blur-md">
        <svg class="h-8 w-8 shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>
        <span>Join a community of musicians making an impact</span>
      </div>
    </div>
  </div>
</section>
<style>
@media (min-width: 1024px) {
  .keep-church { clip-path: ellipse(100% 95% at 0% 50%); border-top-right-radius: 60% 50%; border-bottom-right-radius: 25% 40%; }
}
@media (max-width: 1023px) {
  .keep-church { border-bottom-right-radius: 40% 35%; }
}
</style>
