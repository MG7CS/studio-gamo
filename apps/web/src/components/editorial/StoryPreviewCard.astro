---
interface Props {
  heading: string;
  description: string;
}
const { heading, description } = Astro.props;
---
<article data-reveal class="flex h-full flex-col rounded-3xl bg-[#FFF9F2] p-6 shadow-[0_18px_45px_-28px_rgba(64,34,22,.25)] hover:-translate-y-1 lg:p-7">
  <span class="font-serif text-6xl leading-none text-[#B65B35]/35" aria-hidden="true">“</span>
  <span class="mt-2 mb-4 self-start rounded-full bg-[#B65B35]/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#8F432A]">Illustrative scenario</span>
  <h3 class="mb-3 text-xl font-bold text-[#1D2323]">{heading}</h3>
  <p class="text-base leading-relaxed text-[#545A59]">{description}</p>
  <div class="mt-auto pt-5"><div class="border-t border-[#DED6CC] pt-4 text-xs tracking-wider text-[#555B5A]">Sample content · Not a customer testimonial</div></div>
</article>
