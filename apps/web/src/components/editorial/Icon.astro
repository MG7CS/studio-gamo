  | 'play' | 'phone' | 'piano' | 'guitar' | 'drums' | 'mic' | 'verified';
interface Props { name: IconName; class?: string; strokeWidth?: number }
const { name, class: className = 'h-5 w-5', strokeWidth = 1.6 } = Astro.props;
const paths: Record<IconName, string> = {
  pin: 'M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.400-6.500 11-6.500 11Zm0-8.500a2.500 2.500 0 1 0 0-5 2.500 2.500 0 0 0 0 5Z',
