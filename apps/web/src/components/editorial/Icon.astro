  church: 'M12 2v5M9.500 4.500h5M12 7l5 3.500V21H7V10.500L12 7ZM3 21h18M10 21v-5a2 2 0 0 1 4 0v5M3 21v-7l4-2.500M21 21v-7l-4-2.500',
  users: 'M16 20v-1.500a3.500 3.500 0 0 0-3.500-3.500h-5A3.500 3.500 0 0 0 4 18.500V20M10 11.500a3.500 3.500 0 1 0 0-7 3.500 3.500 0 0 0 0 7ZM20 20v-1.500a3.500 3.500 0 0 0-2.500-3.300M15.500 4.700a3.500 3.500 0 0 1 0 6.600',
  check: 'm5 12.500 4.500 4.500L19 7.500',
  arrow: 'M5 12h14m-6-6 6 6-6 6',
  'arrow-left': 'M19 12H5m6-6-6 6 6 6',
  play: 'M8 5.500v13l11-6.500-11-6.500Z',
  phone: 'M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z',
  piano: 'M3 6h18v12H3V6Zm4.500 0v7M12 6v12M16.500 6v7M7.500 13h0M3 13h18',
  guitar: 'm20 4-6 6m-1.500-1.500 3 3M11 11.500a4 4 0 0 0-5.500 1l-.5 1.500a3 3 0 0 0-2 4.500 3 3 0 0 0 4.500 0 3 3 0 0 0 1.200-3.400l1.300-.600a4 4 0 0 0 1-2.500M17 3l4 4',
  drums: 'M3 11c0 1.700 4 3 9 3s9-1.300 9-3-4-3-9-3-9 1.300-9 3Zm0 0v6c0 1.700 4 3 9 3s9-1.300 9-3v-6M7 3l4 5m6-5-4 5',
  mic: 'M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3ZM6 11.500a6 6 0 0 0 12 0M12 17.500V21m-3 0h6',
  verified: 'M12 2.500l2.300 1.700 2.800-.1.900 2.700 2.300 1.700-.9 2.700.9 2.700-2.300 1.700-.9 2.700-2.800-.1L12 21.500l-2.300-1.700-2.800.1-.9-2.700-2.300-1.700.9-2.700-.9-2.700 2.300-1.700.9-2.700 2.800.1L12 2.500Zm-3.500 9.500 2.500 2.500 4.500-4.500',
};
---
<svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
