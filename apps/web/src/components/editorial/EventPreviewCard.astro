---
import Icon from './Icon.astro';
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
interface Props {
  title: string;
  location: string;
  subtitle: string;
  stem: string;
  widths: number[];
  month: string;
  day: string;
  metaIcon?: 'music' | 'users';
}
const { title, location, subtitle, stem, widths, month, day, metaIcon = 'music' } = Astro.props;
---
<article data-reveal class="group overflow-hidden rounded-2xl bg-white shadow-[0_12px_35px_-20px_rgba(54,33,20,.18)] hover:-translate-y-1 hover:shadow-[0_22px_40px_-20px_rgba(54,33,20,.3)]">
  <div class="relative h-44 sm:h-48 overflow-hidden">
    <ResponsivePicture stem={stem} widths={widths} sizes="(min-width: 1024px) 26vw, (min-width: 640px) 45vw, 90vw" alt="" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <div class="absolute left-4 top-4 flex w-14 flex-col items-center rounded-xl bg-[#FFF9F2] py-1.5 text-center shadow-sm" aria-label={`Sample date: ${month} ${day}`}><span class="text-[11px] font-semibold uppercase leading-none tracking-wider text-[#B65B35]">{month}</span><span class="mt-0.5 text-2xl font-bold leading-none text-[#1D2323]">{day}</span></div>
  </div>
  <div class="flex items-end justify-between gap-3 p-5">
    <div class="min-w-0">
      <h4 class="mb-2 line-clamp-2 text-lg font-bold leading-snug text-[#1D2323]">{title}</h4>
      <p class="flex items-center gap-2.5 text-sm text-[#545A59]"><Icon name="pin" class="h-4 w-4 shrink-0 text-[#555B5A]" />{location}</p>
      <p class="mt-1.5 flex items-center gap-2.5 text-sm text-[#545A59]"><Icon name={metaIcon} class="h-4 w-4 shrink-0 text-[#555B5A]" />{subtitle}</p>
    </div>
    <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#B65B35] text-[#B65B35]"><Icon name="arrow" class="h-5 w-5" /></span>
  </div>
</article>
