---
import ResponsivePicture from '@studio-gamo/ui/components/ResponsivePicture.astro';
interface Props {
  title: string;
  location: string;
  subtitle: string;
  stem: string;
  widths: number[];
}
const { title, location, subtitle, stem, widths } = Astro.props;
---
<article class="group overflow-hidden rounded-2xl bg-white shadow-[0_12px_35px_-20px_rgba(54,33,20,.18)]">
  <div class="relative h-44 sm:h-48 overflow-hidden">
    <ResponsivePicture stem={stem} widths={widths} sizes="(min-width: 1024px) 26vw, (min-width: 640px) 45vw, 90vw" alt="" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
    <span class="absolute top-4 left-4 rounded-xl bg-[#F4EDE3] px-3 py-2 text-xs font-bold uppercase tracking-[.12em] text-[#8F432A]">Concept</span>
  </div>
  <div class="flex items-end justify-between gap-3 p-5">
    <div class="min-w-0">
      <h4 class="mb-2 text-lg font-bold leading-snug text-[#1D2323]">{title}</h4>
      <p class="text-sm text-[#6B6B67]">{location}</p>
      <p class="mt-1 text-sm text-[#6B6B67]">{subtitle}</p>
    </div>
    <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#B65B35] text-[#B65B35]">↗</span>
  </div>
</article>
