---
interface Props {
  label: string;
  theme?: 'light' | 'dark';
  class?: string;
}
const { label, theme = 'light', class: className = '' } = Astro.props;
---
<div class:list={['flex items-center gap-5 text-xs sm:text-sm font-semibold uppercase tracking-[0.2em]', theme === 'light' ? 'text-[#9A4727]' : 'text-[#D7AD86]', className]}>
  <span>{label}</span><span aria-hidden="true" class:list={['h-px w-12', theme === 'light' ? 'bg-[#9A4727]/50' : 'bg-[#D7AD86]/50']}></span>
</div>
