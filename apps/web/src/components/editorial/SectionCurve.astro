---
/**
 * Decorative arched edge that bleeds the neighbouring section's colour into
 * the current one, so colour changes between sections read as sculpted
 * curves rather than hard horizontal lines.
 */
interface Props {
  /** Edge of the parent section the curve sits on. */
  position: 'top' | 'bottom';
  /** Background colour of the adjacent section (any CSS colour). */
  color: string;
  class?: string;
}
const { position, color, class: className = '' } = Astro.props;
const shape = position === 'top' ? 'top-0 rounded-[0_0_50%_50%]' : 'bottom-0 rounded-[50%_50%_0_0]';
---
<div
  class:list={['pointer-events-none absolute inset-x-0 z-20 h-6 sm:h-8 lg:h-9', shape, className]}
  style={`background-color:${color}`}
  aria-hidden="true"
></div>
