---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
interface Props {
  title: string;
  description: string;
  symbol: IconName;
}
const { title, description, symbol } = Astro.props;
---
<article data-reveal class="flex h-full min-w-0 flex-col rounded-[22px] bg-[#FFFAF4] p-5 shadow-[0_16px_30px_-24px_rgba(56,31,21,.3)] hover:-translate-y-1 lg:p-6">
  <div class="flex items-start justify-between gap-2">
    <span class="flex h-12 w-12 items-center justify-center rounded-full border border-[#E8DBCC] bg-[#F4EDE3] text-[#8F432A]" aria-hidden="true"><Icon name={symbol} class="h-6 w-6" /></span>
    <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#E8DBCC] text-[#8F432A]"><Icon name="arrow" class="h-4 w-4" /></span>
  </div>
  <h3 class="mt-6 text-xl font-bold leading-tight text-[#1D2323]">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-[#555B5A]">{description}</p>
</article>
