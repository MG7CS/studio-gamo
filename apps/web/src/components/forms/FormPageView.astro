---
/**
 * FormPageView: the body of a public form page for every state `loadFormPage` can return: the form, the
 * confirmation after a send, a closed form, or "temporarily unavailable". The page owns the single <h1>
 * (the form's own title, which staff edit in the admin form builder). Content-agnostic: the back link comes
 * from the page.
 */
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import DynamicForm from '@studio-gamo/ui/components/forms/dynamic/DynamicForm.astro';
import { FORM_TURNSTILE_ACTION } from '@gamo/domain/forms';
import type { FormPageData } from '../../lib/form-page';
import FormReceipt from './FormReceipt.astro';

type Page = Exclude<FormPageData, { response: Response }>;

interface Props {
  page: Page;
  backHref: string;
  backLabel: string;
  fallbackTitle: string;
}
const { page, backHref, backLabel, fallbackTitle } = Astro.props;
const title = 'form' in page ? page.form.title : fallbackTitle;
---

{page.view === 'form' ? (
  <>
    <PageHero title={title} width="narrow">
      {page.form.description && <p slot="intro">{page.form.description}</p>}
    </PageHero>
    <Container width="narrow" class="pb-16 lg:pb-24">
      <DynamicForm
        schema={page.schema}
        formSlug={page.form.slug}
        idempotencyKey={page.idempotencyKey}
        values={page.values}
        errors={page.errors}
        uploads={page.uploads}
        uploadTokens={page.uploadTokens}
        summaryExtra={page.summaryExtra}
        turnstile={{ action: FORM_TURNSTILE_ACTION, error: page.turnstileError }}
        submitLabel="Send"
        pendingLabel="Sending…"
      />
    </Container>
  </>
) : page.view === 'sent' ? (
  <>
    <PageHero title="Thank you" width="narrow">
      <p slot="intro">{page.form.confirmationMessage}</p>
    </PageHero>
    <Container width="narrow" class="pb-16 lg:pb-24">
      <Card padding="lg" class="space-y-4">
        <FormReceipt
          reference={page.reference}
          subject={page.form.title.toLowerCase()}
          problem={page.problem}
        />
        <ButtonLink href={backHref} arrow>
          {backLabel}
        </ButtonLink>
      </Card>
    </Container>
  </>
) : page.view === 'closed' ? (
  <>
    <PageHero title={title} width="narrow">
      <p slot="intro">This form is not taking responses right now.</p>
    </PageHero>
    <Container width="narrow" class="pb-16 lg:pb-24">
      <Card padding="lg" class="space-y-4">
        <p class="text-body">
          Please check back soon, or write to{' '}
          <a
            href="mailto:hello@gamostudio.org"
            class="font-semibold text-action-strong underline underline-offset-4"
          >
            hello@gamostudio.org
          </a>
          .
        </p>
        <ButtonLink href={backHref} arrow>
          {backLabel}
        </ButtonLink>
      </Card>
    </Container>
  </>
) : page.view === 'unavailable' ? (
  <>
    <PageHero title={title} width="narrow">
      <p slot="intro">{page.message}</p>
    </PageHero>
    <Container width="narrow" class="pb-16 lg:pb-24">
      <ButtonLink href={backHref} arrow>
        {backLabel}
      </ButtonLink>
    </Container>
  </>
) : null}
