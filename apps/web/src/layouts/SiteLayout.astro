---
/** Global website layout: shared document shell + web stylesheet. */
import '../app.css';
import BaseLayout from '@studio-gamo/ui/components/BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  headerTheme?: 'light' | 'dark';
  bodyClass?: string;
  chrome?: boolean;
}
const {
  title = 'Gamo Studios',
  description,
  current,
  headerTheme = 'light',
  bodyClass = 'bg-cream text-charcoal',
  chrome = true,
} = Astro.props;
---
<BaseLayout title={title} description={description} current={current} headerTheme={headerTheme} bodyClass={bodyClass} chrome={chrome}>
  <slot />
</BaseLayout>
