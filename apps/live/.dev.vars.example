# Gamo Live (apps/live) — Local Worker Secrets Example (.dev.vars.example)
# Copy to apps/live/.dev.vars and populate with keys from Clerk app: app_3KlWyOBL2xL2YzhJuvgk8QdrWIt
# NEVER reuse Gamo Live Clerk credentials in any other Gamo product.
# Shared local settings (ENVIRONMENT, SESSION_SECRET, RESEND_API_KEY, etc.) are inherited from root .dev.vars / .env.

# Clerk — Gamo Live Dedicated Application (app_3KlWyOBL2xL2YzhJuvgk8QdrWIt)
PUBLIC_CLERK_KEYLESS_DISABLED="true"
CLERK_KEYLESS_DISABLED="true"
CLERK_APP_ID_LIVE="app_3KlWyOBL2xL2YzhJuvgk8QdrWIt"
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_LIVE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_LIVE_SECRET"
CLERK_JWT_KEY_LIVE=""
CLERK_ISSUER_LIVE=""
CLERK_AUTHORIZED_PARTIES_LIVE="http://127.0.0.1:4324,http://localhost:4324,https://live.gamostudio.org"

# Stripe Sandbox Only (sk_live_ and rk_live_ keys are blocked by assertStripeTestMode)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
