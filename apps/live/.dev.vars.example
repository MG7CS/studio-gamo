# Gamo Live (apps/live) Local Worker Variables & Secrets Example
# Copy to .dev.vars for local testing. NEVER commit real credentials.

ENVIRONMENT=local
PUBLIC_ROOT_DOMAIN=gamostudio.org

# Resend Email Integration (Cloudflare Worker Secret)
# RESEND_API_KEY=re_test_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Gamo Live <live@gamostudio.org>

# Stripe Test Mode for Event Ticketing (Worker secret - test mode only)
# STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxx

# Demo Mode Workspace Controls
ALLOW_PUBLIC_DEMO_WORKSPACES=true
# DEMO_ACCESS_KEY=gamo_preview_secret_token
