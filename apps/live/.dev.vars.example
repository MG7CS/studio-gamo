# Gamo Live (apps/live) Local Worker Variables & Secrets Example
# Copy to .dev.vars for local testing. NEVER commit real credentials.

ENVIRONMENT=local
PUBLIC_ROOT_DOMAIN=gamostudio.org

# Session Signing Secret (Required across all apps sharing D1 sessions; 32+ chars)
SESSION_SECRET=local-dev-session-secret-replace-before-deploy-0123456789

# Resend Email Integration (Required outside local simulation)
# RESEND_API_KEY=re_test_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Gamo Live <live@gamostudio.org>

# Local-Only Auth & Demo Controls (Ignored outside ENVIRONMENT=local on loopback)
ALLOW_AUTH_SIMULATION=true
ALLOW_DEMO_SESSION=false
ALLOW_PUBLIC_DEMO_WORKSPACES=false

# Stripe Test Mode for Event Ticketing (Worker secret - test mode only; gated by STRIPE_SANDBOX_ENABLED)
STRIPE_SANDBOX_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxxxxxxxxxxx
