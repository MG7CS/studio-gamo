# Gamo Live (apps/live) — local secrets. Copy to apps/live/.dev.vars (git-ignored).
# Shared settings (ENVIRONMENT, SESSION_SECRET, RESEND_API_KEY, local-only flags) come from the root .env.
# In preview/production: `wrangler secret put <NAME> --env <preview|production>` from apps/live.

# OPTIONAL. Clerk sign-in for Gamo Live only (Clerk application app_3KlWyOBL2xL2YzhJuvgk8QdrWIt).
# When unset, sign-in uses Gamo's own email verification codes. Never reuse these keys in another product.
CLERK_APP_ID_LIVE=
PUBLIC_CLERK_PUBLISHABLE_KEY_LIVE=
CLERK_SECRET_KEY_LIVE=
CLERK_JWT_KEY_LIVE=
CLERK_ISSUER_LIVE=
CLERK_AUTHORIZED_PARTIES_LIVE=

# Stripe — TEST MODE ONLY (sk_test_… / rk_test_…). Live-mode keys are refused at runtime.
# REQUIRED for paid checkout; without it checkout fails closed with 503.
STRIPE_SECRET_KEY=
# REQUIRED for POST /api/webhook/stripe (signature verification). From `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
