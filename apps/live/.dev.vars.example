# Gamo Live (apps/live) — local secrets. Copy to apps/live/.dev.vars (git-ignored).
# In preview/production: `wrangler secret put <NAME> --env <preview|production>` from apps/live (docs/RUNBOOK.md §5).
# Never put real secret values in this example file.

# Local-only flags (fatal outside ENVIRONMENT=local). ALLOW_AUTH_SIMULATION=true shows a local sign-in form on
# /account/signin when Clerk is not configured, so the organizer area can be worked on without keys.
ALLOW_AUTH_SIMULATION=true

# Organizer sign-in: Gamo Live's own Clerk application (never reuse these keys in another product).
# Local development uses the Clerk DEVELOPMENT instance (pk_test_ / sk_test_). Both keys are needed; with only one
# set, sign-in answers 503. CLERK_JWT_KEY_LIVE is a PEM public key (optional: verifies tokens without a network call),
# on one line with literal \n sequences or in quotes. CLERK_AUTHORIZED_PARTIES_LIVE is a comma-separated origin list.
PUBLIC_CLERK_PUBLISHABLE_KEY_LIVE=
CLERK_SECRET_KEY_LIVE=
CLERK_JWT_KEY_LIVE=
CLERK_AUTHORIZED_PARTIES_LIVE=http://127.0.0.1:4324,http://localhost:4324

# Hashes registrations, codes and invitations (32+ random characters). Optional locally (a fixed development key is
# used); required in preview/production: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PII_HASH_SECRET=

# Email through Resend. Without a key, ENVIRONMENT=local prints each email (the 6-digit code, links) in the dev
# server terminal; outside local nothing is sent and registration fails closed. EMAIL_FROM must be on gamostudio.org.
RESEND_API_KEY=
EMAIL_FROM=Gamo Live <hello@gamostudio.org>
