# Gamo Live (apps/live) — Application Local Environment Template (.env.example)
# Copy to apps/live/.env (or apps/live/.dev.vars) and populate with Gamo Live's dedicated Clerk keys
# from Clerk application: app_3KlWyOBL2xL2YzhJuvgk8QdrWIt
# NEVER reuse Gamo Live Clerk credentials in any other Gamo Studios product.

# Standard Clerk SDK variable names (automatically mapped to *_LIVE by @gamo/config/env-loader)
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_LIVE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_LIVE_SECRET"

# Product-scoped Clerk metadata & optional explicit suffixed overrides
PUBLIC_CLERK_KEYLESS_DISABLED="true"
CLERK_KEYLESS_DISABLED="true"
CLERK_APP_ID_LIVE="app_3KlWyOBL2xL2YzhJuvgk8QdrWIt"
PUBLIC_CLERK_PUBLISHABLE_KEY_LIVE="pk_test_YOUR_LIVE_KEY"
CLERK_SECRET_KEY_LIVE="sk_test_YOUR_LIVE_SECRET"
CLERK_JWT_KEY_LIVE=""
CLERK_ISSUER_LIVE=""
CLERK_AUTHORIZED_PARTIES_LIVE="http://127.0.0.1:4324,http://localhost:4324,https://live.gamostudio.org"

# Stripe Sandbox Only (Gamo Live event ticketing & checkout)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
