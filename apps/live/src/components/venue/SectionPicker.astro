---
/**
 * Buyer-side section picker (design §5.6). Embed it inside the checkout <form>; it posts the chosen
 * section id in a normal radio field (`name`, default `sectionId`), so it works without JavaScript.
 *
 * - The list of radio buttons is the primary control (first in reading order, first on small screens,
 *   and the one assistive technology uses). Sold-out sections are disabled.
 * - The blueprint overlay (`<svg>` over the uploaded image) has one focusable link per available
 *   section, labelled "Section B — VIP — $40.00 — 12 left"; with JavaScript a click/Enter selects the
 *   section's radio. The selected section is drawn with a thick outline and a hatch, not colour alone;
 *   sold-out shapes are hatched grey and not focusable.
 *
 * Data: `getSectionAvailability(db, eventId)` from `@gamo/domain/scanner` (server side). The checkout
 * must still re-validate the section when it places the hold; the triggers are the authority.
 */
import type { SectionAvailability } from '@gamo/domain/scanner';

export interface Props {
  availability: SectionAvailability;
  /** Form field name (default `sectionId`). */
  name?: string;
  selectedId?: string | null;
  legend?: string;
  required?: boolean;
  /** Prefix for element ids when the picker appears more than once on a page. */
  idPrefix?: string;
  /** Server-rendered error for the field (bound with aria-describedby). */
  error?: string | null;
}
const {
  availability,
  name = 'sectionId',
  selectedId = null,
  legend = 'Choose a section',
  required = true,
  idPrefix = 'section',
  error = null,
} = Astro.props;
const { map, sections } = availability;
const shapes = map ? sections.filter((s) => s.points) : [];
const errorId = `${idPrefix}-error`;
const pts = (points: Array<[number, number]>) => points.map(([x, y]) => `${x},${y}`).join(' ');
---

<fieldset data-section-picker class="space-y-4" aria-describedby={error ? errorId : undefined}>
  <legend class="text-lg font-black tracking-tight text-ink uppercase">{legend}</legend>
  {error && (
    <p id={errorId} class="text-sm font-semibold text-terracotta-deep">
      Error: {error}
    </p>
  )}
  {sections.length === 0 && <p class="text-sm text-muted">No sections are on sale for this event.</p>}
  <div class="grid gap-5 lg:grid-cols-[1.25fr_1fr] lg:items-start">
    <ul class="space-y-2 lg:order-2" data-section-list>
      {sections.map((s) => (
        <li>
          <label
            class:list={[
              'flex min-h-14 items-start gap-3 rounded-2xl bg-white p-3 ring-1 ring-sand has-[:checked]:ring-4 has-[:checked]:ring-ink',
              s.soldOut ? 'opacity-70' : 'cursor-pointer hover:bg-ivory',
            ]}
          >
            <input
              type="radio"
              id={`${idPrefix}-${s.id}`}
              name={name}
              value={s.id}
              required={required}
              disabled={s.soldOut}
              checked={selectedId === s.id && !s.soldOut}
              class="peer mt-1 size-5 shrink-0 accent-terracotta"
              data-section-radio
              data-label={s.label}
            />
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-ink">
                {s.name} <span class="text-muted">· {s.categoryName}</span>
              </span>
              <span class="block text-sm text-ink">
                {s.priceText} · {s.soldOut ? <strong>Sold out</strong> : `${s.remaining} left`}
                {s.accessible && ' · Wheelchair accessible'}
                {s.companionSeats && ' · Companion seats'}
              </span>
            </span>
            <span class="hidden shrink-0 rounded-full bg-ink px-2 py-0.5 text-xs font-bold text-cream peer-checked:inline">
              Selected
            </span>
          </label>
        </li>
      ))}
    </ul>
    {map && (
      <figure class="lg:order-1">
        <div class="relative overflow-hidden rounded-2xl bg-white ring-1 ring-sand">
          <img
            src={map.url}
            alt={map.altText}
            width={map.width}
            height={map.height}
            class="block h-auto w-full"
            loading="lazy"
          />
          {shapes.length > 0 && (
            <svg
              viewBox={`0 0 ${map.width} ${map.height}`}
              class="absolute inset-0 size-full"
              role="group"
              aria-label="Sections on the venue map"
              data-section-overlay
            >
              <defs>
                <pattern
                  id={`${idPrefix}-hatch`}
                  width="12"
                  height="12"
                  patternUnits="userSpaceOnUse"
                  patternTransform="rotate(45)"
                >
                  <rect width="12" height="12" fill="rgba(24,24,27,0.25)" />
                  <line x1="0" y1="0" x2="0" y2="12" stroke="#18181b" stroke-width="4" />
                </pattern>
              </defs>
              {shapes.map((s) =>
                s.soldOut ? (
                  <polygon
                    points={pts(s.points!)}
                    fill={`url(#${idPrefix}-hatch)`}
                    stroke="#57534e"
                    stroke-width="2"
                    opacity="0.8"
                  >
                    <title>{s.label}</title>
                  </polygon>
                ) : (
                  <a
                    href={`#${idPrefix}-${s.id}`}
                    aria-label={s.label}
                    data-section-shape={s.id}
                    class="section-shape"
                  >
                    <polygon
                      points={pts(s.points!)}
                      fill="rgba(179,78,36,0.28)"
                      stroke="#8f3b18"
                      stroke-width="3"
                    />
                  </a>
                ),
              )}
            </svg>
          )}
        </div>
        <figcaption class="mt-2 text-sm text-muted">
          {shapes.length > 0
            ? 'Tap a section on the map, or choose it from the list.'
            : 'Venue map for orientation. Choose your section from the list.'}
        </figcaption>
      </figure>
    )}
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-section-status></p>
</fieldset>

<style>
  .section-shape:focus-visible polygon,
  .section-shape:hover polygon {
    stroke: #18181b;
    stroke-width: 6;
  }
  .section-shape[data-selected='true'] polygon {
    fill: rgba(24, 24, 27, 0.35);
    stroke: #18181b;
    stroke-width: 8;
    stroke-dasharray: 14 6;
  }
  .section-shape {
    outline: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-section-picker]').forEach((root) => {
    const status = root.querySelector<HTMLElement>('[data-section-status]');
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[data-section-radio]')];
    const shapes = [...root.querySelectorAll<SVGAElement>('[data-section-shape]')];
    const sync = (announce: boolean) => {
      const chosen = radios.find((r) => r.checked);
      for (const s of shapes) s.dataset.selected = String(s.dataset.sectionShape === chosen?.value);
      if (announce && status && chosen) status.textContent = `Selected: ${chosen.dataset.label ?? ''}`;
    };
    for (const r of radios) r.addEventListener('change', () => sync(true));
    for (const shape of shapes)
      shape.addEventListener('click', (ev) => {
        ev.preventDefault();
        const radio = radios.find((r) => r.value === shape.dataset.sectionShape);
        if (!radio || radio.disabled) return;
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      });
    sync(false);
  });
</script>
