---
/** Compact operational sub-page header: eyebrow, functional title, concise lede, optional back link + slot for actions. */
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  lede?: string;
  back?: { href: string; label: string };
}
const { eyebrow, title, accent, lede, back } = Astro.props;
---

<header class="bg-ivory border-b border-sand pt-8 pb-7 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-[1100px] flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      {back && (
        <a href={back.href} class="inline-block text-xs font-semibold text-muted hover:text-terracotta mb-2">
          ← {back.label}
        </a>
      )}
      {eyebrow && <p class="text-xs font-bold uppercase tracking-wider text-terracotta mb-1.5">{eyebrow}</p>}
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-ink text-balance uppercase">
        {title}
        {accent && <span class="block text-terracotta">{accent}</span>}
      </h1>
      {lede && <p class="mt-1.5 max-w-2xl text-sm sm:text-base text-muted leading-relaxed">{lede}</p>}
    </div>
    <div class="flex flex-wrap items-center gap-2.5 shrink-0">
      <slot />
    </div>
  </div>
</header>
