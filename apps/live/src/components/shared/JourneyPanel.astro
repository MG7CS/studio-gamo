---
interface Props {
  title: string;
  body: string;
  href?: string;
  label?: string;
}
const { title, body, href, label } = Astro.props;
---

<section class="bg-cream px-5 pb-20 sm:px-8">
  <div class="mx-auto max-w-[1100px] border-t border-sand py-10">
    <h2 class="text-2xl font-bold text-charcoal">{title}</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">{body}</p>
    {href && (
      <a class="mt-6 inline-flex rounded-full bg-terracotta px-6 py-3 font-semibold text-white" href={href}>
        {label}
      </a>
    )}
    <slot />
  </div>
</section>
