---
/** Public header: a floating white bar on the cream page, with the phone menu as a card below it. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { GAMO_LIVE_METROS, resolveMetroBySlug } from '@gamo/domain';

const pathname = Astro.url.pathname;
const urlMetroParam = Astro.url.searchParams.get('metro');

const pathSegments = pathname.split('/').filter(Boolean);
const pathMetro =
  pathSegments[0] === 'events' && pathSegments[1] ? resolveMetroBySlug(pathSegments[1]) : null;

const selectedMetro =
  urlMetroParam === 'all'
    ? 'all'
    : resolveMetroBySlug(urlMetroParam)?.slug || pathMetro?.slug || 'phoenix-az';

const navItems = [
  {
    label: 'Events',
    href: '/events',
    match: (p: string) => p === '/events' || p.startsWith('/events/'),
  },
  {
    label: 'Artists',
    href: '/artists',
    match: (p: string) => p.startsWith('/artists'),
  },
  {
    label: 'Venues',
    href: '/venues',
    match: (p: string) => p.startsWith('/venues'),
  },
  {
    label: 'Organizers',
    href: '/organizer',
    match: (p: string) => p.startsWith('/organizer'),
  },
];
---

<a
  href="#main-content"
  class="sr-only z-[60] rounded-full bg-ink px-5 text-sm font-semibold text-ivory focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center"
>
  Skip to content
</a>

<header
  id="site-header"
  data-theme="light"
  class="sticky top-0 z-50 w-full bg-cream px-3 pt-3 text-ink sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-[1340px]">
    <div class="flex h-16 items-center justify-between gap-3 rounded-2xl border border-sand bg-white px-3 shadow-[0_10px_30px_-20px_rgba(24,24,27,0.4)] sm:rounded-full sm:px-5">
      {/* Brand */}
      <a href="/" class="group flex min-h-11 shrink-0 items-center gap-2.5 rounded-md">
        <svg class="h-7 w-7 shrink-0 text-terracotta" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect x="2" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
          <rect x="7.2" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
          <rect x="12.4" y="2.5" width="3.2" height="23" rx="1.6" fill="currentColor" />
          <rect x="17.6" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
          <rect x="22.8" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
        </svg>
        <span class="flex items-baseline text-[20px] leading-none tracking-tight sm:text-[22px]">
          <span aria-hidden="true" class="font-extrabold text-ink">
            GAMO
          </span>
          <span aria-hidden="true" class="ml-1 font-normal text-terracotta">
            LIVE
          </span>
          <span class="sr-only">Gamo Live home</span>
        </span>
      </a>

      {/* Desktop navigation */}
      <nav aria-label="Primary" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {navItems.map((item) => {
            const active = item.match(pathname);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'inline-flex min-h-11 items-center rounded-full px-4 text-[15px] transition-colors',
                    active
                      ? 'bg-cream font-semibold text-terracotta-deep'
                      : 'font-medium text-ink hover:bg-cream hover:text-terracotta-deep',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      {/* Right controls */}
      <div class="flex items-center gap-2">
        <div class="hidden min-h-11 items-center gap-1.5 rounded-full border border-sand bg-cream px-3.5 transition-colors hover:bg-sand md:flex">
          <Icon name="pin" class="h-4 w-4 shrink-0 text-terracotta-deep" strokeWidth={2} />
          <label for="header-metro-select" class="sr-only">
            City
          </label>
          <select
            id="header-metro-select"
            data-header-metro-select
            class="min-h-11 cursor-pointer bg-transparent pr-1 text-sm font-medium text-ink"
          >
            {GAMO_LIVE_METROS.map((metro) => (
              <option value={metro.slug} selected={selectedMetro === metro.slug}>
                {metro.displayLabel}
              </option>
            ))}
            <option value="all" selected={selectedMetro === 'all'}>
              All cities
            </option>
          </select>
        </div>

        <a
          href="/account/signin"
          class="hidden min-h-11 items-center justify-center whitespace-nowrap rounded-full border border-tan px-4 text-sm font-semibold text-terracotta-deep transition-colors hover:bg-sand sm:inline-flex"
        >
          Sign in
        </a>

        <a
          href="/events"
          class="hidden min-h-11 items-center justify-center whitespace-nowrap rounded-full bg-terracotta px-4 text-sm font-semibold text-white transition-colors hover:bg-terracotta-deep sm:inline-flex"
        >
          Find events
        </a>

        <button
          type="button"
          class="site-header__toggle inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-sand bg-cream text-ink transition-colors hover:bg-sand lg:hidden"
          aria-expanded="false"
          aria-controls="site-mobile-menu"
          aria-label="Open menu"
        >
          <Icon name="menu" class="icon-open h-5 w-5" strokeWidth={2} />
          <Icon name="x" class="icon-close hidden h-5 w-5" strokeWidth={2} />
        </button>
      </div>
    </div>

    {/* Phone menu */}
    <div
      id="site-mobile-menu"
      class="mt-2 hidden rounded-2xl border border-sand bg-white p-3 shadow-[0_18px_40px_-24px_rgba(24,24,27,0.45)] lg:hidden"
    >
      <div class="mb-2 flex items-center gap-2 rounded-xl border border-sand bg-cream px-3.5">
        <Icon name="pin" class="h-4 w-4 shrink-0 text-terracotta-deep" strokeWidth={2} />
        <label for="mobile-metro-select" class="sr-only">
          City
        </label>
        <select
          id="mobile-metro-select"
          data-header-metro-select
          class="min-h-11 w-full bg-transparent text-sm font-semibold text-ink"
        >
          {GAMO_LIVE_METROS.map((metro) => (
            <option value={metro.slug} selected={selectedMetro === metro.slug}>
              {metro.displayLabel}
            </option>
          ))}
          <option value="all" selected={selectedMetro === 'all'}>
            All cities
          </option>
        </select>
      </div>

      <nav aria-label="Mobile primary">
        <ul class="flex flex-col">
          {navItems.map((item) => {
            const active = item.match(pathname);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center justify-between rounded-xl px-3.5 text-[15px] font-semibold transition-colors',
                    active ? 'bg-cream text-terracotta-deep' : 'text-ink hover:bg-cream',
                  ]}
                >
                  <span>{item.label}</span>
                  <Icon name="chevron-right" class="h-4 w-4 text-muted" strokeWidth={2} />
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <div class="mt-3 grid grid-cols-2 gap-2.5 border-t border-sand pt-3">
        <a
          href="/account/signin"
          class="flex min-h-11 items-center justify-center rounded-full border border-tan bg-white px-4 text-center text-sm font-semibold text-terracotta-deep"
        >
          Sign in
        </a>
        <a
          href="/events"
          class="flex min-h-11 items-center justify-center rounded-full bg-terracotta px-4 text-center text-sm font-semibold text-white"
        >
          Find events
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    const header = document.getElementById('site-header');
    const toggle = header ? header.querySelector<HTMLElement>('.site-header__toggle') : null;
    const menu = document.getElementById('site-mobile-menu');
    const metroSelects = document.querySelectorAll('[data-header-metro-select]');

    const setOpen = function (open: boolean) {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.classList.toggle('hidden', !open);
      const openIcon = toggle.querySelector('.icon-open');
      const closeIcon = toggle.querySelector('.icon-close');
      if (openIcon) openIcon.classList.toggle('hidden', open);
      if (closeIcon) closeIcon.classList.toggle('hidden', !open);
    };

    if (toggle) {
      toggle.addEventListener('click', function () {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });
    }

    if (menu) {
      menu.addEventListener('click', function (e) {
        if ((e.target as Element | null)?.closest('a')) {
          setOpen(false);
        }
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    const knownMetros = [
      'phoenix-az',
      'atlanta-ga',
      'nashville-tn',
      'orlando-fl',
      'los-angeles-ca',
      'houston-tx',
      'seattle-wa',
      'new-york-ny',
      'oklahoma-city-ok',
    ];

    metroSelects.forEach(function (selectEl) {
      selectEl.addEventListener('change', function (e) {
        const val = (e.target as HTMLSelectElement).value || 'phoenix-az';
        try {
          localStorage.setItem('gamo_live_metro', val);
        } catch {
          // Storage unavailable (private mode); the metro choice just isn't remembered.
        }

        const pathname = window.location.pathname;
        const segments = pathname.split('/').filter(Boolean);
        if (segments[0] === 'events' && segments[1] && knownMetros.indexOf(segments[1]) !== -1) {
          if (val === 'all') {
            window.location.href = '/events';
          } else {
            window.location.href = '/events/' + encodeURIComponent(val);
          }
          return;
        }

        const url = new URL(window.location.href);
        url.searchParams.set('metro', val);
        window.location.href = url.pathname + url.search;
      });
    });
  })();
</script>
