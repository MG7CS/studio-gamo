---
/**
 * The one header for every public Gamo Live page: the brand, four links, search, and on phones a menu that works
 * without JavaScript (<details>). No metro picker and no ticket buttons: choosing a city belongs to the events list,
 * and Gamo Live does not sell tickets.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';

const pathname = Astro.url.pathname;
const navItems = [
  { label: 'Events', href: '/events', active: pathname === '/events' || pathname.startsWith('/events/') },
  { label: 'Artists', href: '/artists', active: pathname.startsWith('/artists') },
  { label: 'Venues', href: '/venues', active: pathname.startsWith('/venues') },
  { label: 'Promote an event', href: '/promote', active: pathname.startsWith('/promote') },
];
const link = 'inline-flex min-h-11 items-center text-[15px] font-medium text-ink hover:text-terracotta-deep';
---

<a
  href="#main-content"
  class="sr-only z-[60] rounded-full bg-ink px-5 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center"
>
  Skip to content
</a>

<header id="site-header" class="relative z-50 w-full border-b border-sand bg-ivory text-ink">
  <div class="mx-auto flex h-16 max-w-[1340px] items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex min-h-11 shrink-0 items-center gap-2.5 rounded-md">
      <svg class="h-7 w-7 shrink-0 text-terracotta" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <rect x="2" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
        <rect x="7.2" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
        <rect x="12.4" y="2.5" width="3.2" height="23" rx="1.6" fill="currentColor" />
        <rect x="17.6" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
        <rect x="22.8" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
      </svg>
      <span class="flex items-baseline gap-1 text-xl leading-none tracking-tight">
        <span aria-hidden="true" class="font-extrabold">
          GAMO
        </span>
        <span aria-hidden="true" class="font-normal text-terracotta-deep">
          LIVE
        </span>
        <span class="sr-only">Gamo Live home</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                link,
                item.active &&
                  'font-semibold underline decoration-terracotta decoration-2 underline-offset-8',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/events#search"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-sand bg-cream text-ink hover:bg-sand"
        aria-label="Search events"
      >
        <Icon name="search" class="h-5 w-5" />
      </a>
      <details class="group relative lg:hidden">
        <summary class="flex h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-full border border-sand bg-cream px-4 text-sm font-semibold marker:hidden [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">Menu</span>
          <span class="hidden group-open:inline">Close</span>
        </summary>
        <nav
          aria-label="Menu"
          class="absolute right-0 top-14 w-64 rounded-2xl border border-sand bg-white p-2 shadow-lg"
        >
          <ul>
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center rounded-xl px-3 text-[15px] font-medium hover:bg-sand',
                    item.active && 'bg-sand font-semibold',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
