---
import { GAMO_LIVE_METROS, resolveMetroBySlug } from '@gamo/domain';

const pathname = Astro.url.pathname;
const urlMetroParam = Astro.url.searchParams.get('metro');

const pathSegments = pathname.split('/').filter(Boolean);
const pathMetro =
  pathSegments[0] === 'events' && pathSegments[1] ? resolveMetroBySlug(pathSegments[1]) : null;

const selectedMetro =
  urlMetroParam === 'all'
    ? 'all'
    : resolveMetroBySlug(urlMetroParam)?.slug || pathMetro?.slug || 'phoenix-az';

const navItems = [
  {
    label: 'Events',
    href: '/events',
    match: (p: string) => p === '/events' || p.startsWith('/events/'),
  },
  {
    label: 'Artists',
    href: '/artists',
    match: (p: string) => p.startsWith('/artists') || p.startsWith('/artist') || p.startsWith('/agent'),
  },
  {
    label: 'Venues',
    href: '/venues',
    match: (p: string) => p.startsWith('/venues'),
  },
  {
    label: 'Organizers',
    href: '/promote/create',
    match: (p: string) => p.startsWith('/promote') || p.startsWith('/submit') || p.startsWith('/organizer'),
  },
];
---

<a
  href="#main-content"
  class="sr-only z-[60] rounded-full bg-ink px-5 text-sm font-semibold text-ivory focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:inline-flex focus:min-h-11 focus:items-center"
>
  Skip to content
</a>

<header
  id="site-header"
  data-theme="light"
  class="relative z-50 w-full bg-ivory border-b border-sand text-ink transition-shadow duration-200"
>
  <div class="mx-auto flex h-16 max-w-[1340px] items-center justify-between gap-3 px-4 sm:h-[72px] sm:px-6 lg:px-8">
    <!-- Left Brand Mark -->
    <a
      href="/"
      class="flex min-h-11 shrink-0 items-center gap-2.5 rounded-md group"
      aria-label="Gamo Live home"
    >
      <svg
        class="h-7 w-7 shrink-0 text-terracotta transition-transform duration-200 group-hover:scale-105"
        viewBox="0 0 28 28"
        fill="none"
        aria-hidden="true"
      >
        <rect x="2" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
        <rect x="7.2" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
        <rect x="12.4" y="2.5" width="3.2" height="23" rx="1.6" fill="currentColor" />
        <rect x="17.6" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
        <rect x="22.8" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
      </svg>
      <span class="text-[20px] sm:text-[22px] leading-none tracking-tight flex items-baseline">
        <span class="font-extrabold text-ink">GAMO</span>
        <span class="font-normal text-terracotta ml-0.5">LIVE</span>
        <span class="sr-only"> — Gamo Live</span>
      </span>
    </a>

    <!-- Center Navigation Links -->
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-7 xl:gap-9">
        {navItems.map((item) => {
          const active = item.match(pathname);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'relative text-[15px] transition-colors py-2',
                  active
                    ? 'text-ink font-semibold after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-[2.5px] after:rounded-full after:bg-terracotta'
                    : 'text-ink font-medium hover:text-terracotta',
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <!-- Search Icon Button -->
      <a
        href="/events#discovery-search"
        class="w-11 h-11 rounded-full border border-sand bg-cream hover:bg-sand text-ink flex items-center justify-center transition-colors shrink-0"
        aria-label="Search events, artists, or venues"
        title="Search events"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
          />
        </svg>
      </a>

      <!-- Location Chooser Pill (Desktop & Tablet) -->
      <div class="hidden md:flex min-h-11 items-center gap-1.5 rounded-full border border-sand bg-cream hover:bg-sand px-3.5 transition-colors">
        <svg
          class="w-4 h-4 text-ink shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
          />
        </svg>
        <select
          aria-label="Select metro area"
          data-header-metro-select
          class="min-h-11 bg-transparent text-sm font-medium text-ink pr-1 cursor-pointer"
        >
          {GAMO_LIVE_METROS.map((metro) => (
            <option value={metro.slug} selected={selectedMetro === metro.slug}>
              {metro.displayLabel}
            </option>
          ))}
          <option value="all" selected={selectedMetro === 'all'}>
            All U.S. Cities
          </option>
        </select>
      </div>

      <!-- Sign In Pill -->
      <a
        href="/account/signin"
        class="hidden sm:inline-flex items-center justify-center rounded-full border border-line bg-transparent hover:bg-cream text-terracotta px-5 min-h-11 text-sm font-semibold transition-colors whitespace-nowrap"
      >
        Sign In
      </a>

      <!-- Get Tickets Filled Pill -->
      <a
        href="/events"
        class="hidden sm:inline-flex items-center justify-center rounded-full bg-terracotta hover:bg-terracotta-deep text-white px-5 min-h-11 text-sm font-semibold shadow-sm transition-colors whitespace-nowrap"
      >
        Get Tickets
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        type="button"
        class="site-header__toggle inline-flex h-11 w-11 items-center justify-center rounded-full border border-sand bg-cream text-ink transition-colors hover:bg-sand lg:hidden shrink-0"
        aria-expanded="false"
        aria-controls="site-mobile-menu"
        aria-label="Open menu"
      >
        <svg
          class="icon-open h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
          />
        </svg>
        <svg
          class="icon-close hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Responsive Mobile Menu Drawer -->
  <div id="site-mobile-menu" class="hidden border-t border-sand bg-ivory px-4 pt-3 pb-5 shadow-xl lg:hidden">
    <!-- Mobile Metro Picker -->
    <div class="mb-3 flex items-center gap-2 rounded-2xl border border-sand bg-cream px-3.5">
      <svg
        class="w-4 h-4 text-terracotta shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
        />
      </svg>
      <label for="mobile-metro-select" class="sr-only">
        Select metro area
      </label>
      <select
        id="mobile-metro-select"
        aria-label="Select metro area"
        data-header-metro-select
        class="min-h-11 w-full bg-transparent text-sm font-semibold text-ink"
      >
        {GAMO_LIVE_METROS.map((metro) => (
          <option value={metro.slug} selected={selectedMetro === metro.slug}>
            {metro.displayLabel}
          </option>
        ))}
        <option value="all" selected={selectedMetro === 'all'}>
          All U.S. Cities
        </option>
      </select>
    </div>

    <nav aria-label="Mobile primary">
      <ul class="flex flex-col space-y-1">
        {navItems.map((item) => {
          const active = item.match(pathname);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex items-center justify-between rounded-xl px-3.5 py-2.5 text-[15px] font-semibold transition-colors',
                  active ? 'bg-cream text-terracotta' : 'text-ink hover:bg-cream',
                ]}
              >
                <span>{item.label}</span>
                <svg
                  class="h-4 w-4 opacity-50"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="mt-4 grid grid-cols-2 gap-2.5 border-t border-sand pt-4">
      <a
        href="/account/signin"
        class="rounded-full border border-line bg-white px-4 py-2.5 text-center text-sm font-semibold text-terracotta"
      >
        Sign In
      </a>
      <a
        href="/events"
        class="rounded-full bg-terracotta px-4 py-2.5 text-center text-sm font-semibold text-white"
      >
        Get Tickets
      </a>
    </div>
  </div>
</header>

<script>
  (function () {
    const header = document.getElementById('site-header');
    const toggle = header ? header.querySelector<HTMLElement>('.site-header__toggle') : null;
    const menu = document.getElementById('site-mobile-menu');
    const metroSelects = document.querySelectorAll('[data-header-metro-select]');

    const setOpen = function (open: boolean) {
      if (!toggle || !menu) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.classList.toggle('hidden', !open);
      const openIcon = toggle.querySelector('.icon-open');
      const closeIcon = toggle.querySelector('.icon-close');
      if (openIcon) openIcon.classList.toggle('hidden', open);
      if (closeIcon) closeIcon.classList.toggle('hidden', !open);
    };

    if (toggle) {
      toggle.addEventListener('click', function () {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });
    }

    if (menu) {
      menu.addEventListener('click', function (e) {
        if ((e.target as Element | null)?.closest('a')) {
          setOpen(false);
        }
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    const knownMetros = [
      'phoenix-az',
      'atlanta-ga',
      'nashville-tn',
      'orlando-fl',
      'los-angeles-ca',
      'houston-tx',
      'seattle-wa',
      'new-york-ny',
      'oklahoma-city-ok',
    ];

    metroSelects.forEach(function (selectEl) {
      selectEl.addEventListener('change', function (e) {
        const val = (e.target as HTMLSelectElement).value || 'phoenix-az';
        try {
          localStorage.setItem('gamo_live_metro', val);
        } catch {
          // Storage unavailable (private mode); the metro choice just isn't remembered.
        }

        const pathname = window.location.pathname;
        const segments = pathname.split('/').filter(Boolean);
        if (segments[0] === 'events' && segments[1] && knownMetros.indexOf(segments[1]) !== -1) {
          if (val === 'all') {
            window.location.href = '/events';
          } else {
            window.location.href = '/events/' + encodeURIComponent(val);
          }
          return;
        }

        const url = new URL(window.location.href);
        url.searchParams.set('metro', val);
        window.location.href = url.pathname + url.search;
      });
    });
  })();
</script>
