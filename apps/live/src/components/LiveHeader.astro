---
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { resolvePlatformBrandConfig } from '@studio-gamo/ui/lib/brand';

const brand = await resolvePlatformBrandConfig(Astro.locals);
const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Discover Events', href: '/events', match: (p: string) => p === '/' || p.startsWith('/events') },
  { label: 'Promote & Organize', href: '/promote', match: (p: string) => p.startsWith('/promote') || p.startsWith('/submit') || p.startsWith('/organizer') },
  { label: 'Artists & Agents', href: '/artist', match: (p: string) => p.startsWith('/artist') || p.startsWith('/agent') },
  { label: 'Order & Pass Lookup', href: '/my-tickets', match: (p: string) => p.startsWith('/my-tickets') || p.startsWith('/me') },
];
---
<a href="#main-content" class="sr-only z-[60] rounded-full bg-charcoal px-4 py-2 text-sm font-semibold text-cream focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
<header
  id="site-header"
  data-theme="light"
  class="site-header fixed inset-x-0 top-3 z-50 mx-auto w-[calc(100%-1.5rem)] max-w-[1320px] text-charcoal transition-[top] duration-300 sm:top-4 sm:w-[calc(100%-2.5rem)]"
>
  <div
    class="site-header__bar flex h-14 items-center justify-between gap-3 rounded-full border border-sand bg-ivory/96 py-2 pl-4 pr-2 shadow-[0_14px_38px_-12px_rgba(20,26,27,0.28)] ring-1 ring-charcoal/8 backdrop-blur-xl transition-[background-color,box-shadow,border-color,height] duration-300 lg:h-16 lg:pl-5"
  >
    <a href="/" class="flex shrink-0 items-center gap-2.5 rounded-full pr-2" aria-label={`${brand.displayName} home`}>
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-charcoal text-xs font-extrabold tracking-wider text-cream">
        {brand.logoMark}
      </span>
      <span class="text-base font-extrabold tracking-tight text-charcoal sm:text-lg">{brand.displayName}</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1 rounded-full border border-sand bg-white/95 p-1 shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
        {navItems.map((item) => {
          const active = item.match(pathname);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'block rounded-full px-3.5 py-2 text-sm font-semibold transition-colors xl:px-4 xl:text-[15px]',
                  active
                    ? 'bg-charcoal text-cream shadow-sm'
                    : 'text-charcoal/80 hover:bg-cream hover:text-charcoal',
                ]}
              >{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/organizer" class="hidden rounded-full border border-charcoal/20 bg-white/90 px-4 py-2.5 text-sm font-semibold text-charcoal transition-colors hover:bg-white md:inline-flex xl:px-5">Workspaces</a>
      <a href="/promote/create" class="hidden items-center gap-2 rounded-full bg-terracotta px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-terracotta-dark sm:inline-flex xl:px-5">
        List an Event <Icon name="arrow" class="h-4 w-4" />
      </a>
      <button
        type="button"
        class="site-header__toggle inline-flex h-10 w-10 items-center justify-center rounded-full bg-charcoal/8 text-charcoal transition-colors hover:bg-charcoal/15 lg:hidden"
        aria-expanded="false"
        aria-controls="site-mobile-menu"
        aria-label="Open menu"
      >
        <span class="icon-open"><Icon name="menu" class="h-5 w-5" strokeWidth={2} /></span>
        <span class="icon-close hidden"><Icon name="x" class="h-5 w-5" strokeWidth={2} /></span>
      </button>
    </div>
  </div>

  <div id="site-mobile-menu" class="mt-2 hidden rounded-[28px] border border-sand bg-ivory/98 p-3 text-charcoal shadow-2xl ring-1 ring-charcoal/10 backdrop-blur-xl lg:hidden">
    <nav aria-label="Mobile primary">
      <ul class="flex flex-col">
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={item.match(pathname) ? 'page' : undefined} class:list={['flex items-center justify-between rounded-2xl px-4 py-3 text-base font-semibold transition-colors hover:bg-cream', item.match(pathname) ? 'bg-cream text-terracotta' : 'text-charcoal']}>
              {item.label}<Icon name="chevron-right" class="h-4 w-4 opacity-50" />
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-2 grid grid-cols-2 gap-2 border-t border-sand pt-3">
      <a href="/organizer" class="rounded-full border border-charcoal/20 bg-white px-4 py-3 text-center text-sm font-semibold text-charcoal">Workspaces</a>
      <a href="/promote/create" class="rounded-full bg-terracotta px-4 py-3 text-center text-sm font-semibold text-white">List an Event</a>
    </div>
  </div>
</header>

<style>
  .site-header[data-scrolled] { top: 0.5rem; }
  .site-header[data-scrolled] .site-header__bar {
    background-color: rgb(251 247 241 / 0.98);
    box-shadow: 0 18px 44px -16px rgb(20, 26, 27 / 0.36);
  }
  @media (min-width: 1024px) {
    .site-header[data-scrolled] .site-header__bar { height: 3.5rem; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.site-header__toggle');
  const menu = document.getElementById('site-mobile-menu');

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('hidden', !open);
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
