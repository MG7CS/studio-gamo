---
/** Manual lookup results with an "admit with reason" form per ticket (supervisors and organizers). */
import type { LookupResult } from '@gamo/domain/scanner';

interface Props {
  results: LookupResult[];
  truncated: boolean;
  query: string;
}
const { results, truncated, query } = Astro.props;
const statusText = (r: LookupResult) =>
  r.status === 'valid'
    ? r.inside
      ? `Inside now (${r.entriesToday} ${r.entriesToday === 1 ? 'entry' : 'entries'} today)`
      : 'Not inside'
    : r.status === 'checked_in'
      ? 'Checked in'
      : r.status === 'voided'
        ? 'Voided — do not admit'
        : r.status === 'refunded'
          ? 'Refunded — do not admit'
          : r.status;
---

<section aria-labelledby="lookup-results" class="space-y-3">
  <h2 id="lookup-results" class="text-lg font-black uppercase">
    {results.length === 0
      ? `No tickets found for “${query}”`
      : `${results.length} ${results.length === 1 ? 'ticket' : 'tickets'} found`}
  </h2>
  {results.length === 0 && (
    <p class="text-sm text-cream/80">
      Check the spelling, try the email address, or the order reference (GL-XXXX-XXXX).
    </p>
  )}
  {truncated && (
    <p class="text-sm text-cream/80">Showing the first 10. Type more of the name to narrow it down.</p>
  )}
  <ul class="space-y-3">
    {results.map((r) => (
      <li class="rounded-2xl bg-white p-4 text-ink" data-lookup-result>
        <p class="text-lg font-bold">{r.holderName}</p>
        <p class="text-sm text-muted">
          {r.emailMasked} · {r.orderReference ?? 'No reference'} · {r.category ?? 'Ticket'}
          {r.section ? ` · ${r.section}` : ''}
        </p>
        <p class="mt-1 text-sm font-semibold">{statusText(r)}</p>
        {r.status === 'valid' && !r.inside && (
          <form method="post" class="mt-3 space-y-2">
            <input type="hidden" name="action" value="override" />
            <input type="hidden" name="ticket_id" value={r.ticketId} />
            <label for={`reason-${r.ticketId}`} class="text-sm font-semibold">
              Reason for admitting without the code
            </label>
            <input
              id={`reason-${r.ticketId}`}
              name="reason"
              required
              minlength="3"
              maxlength="300"
              placeholder="e.g. Phone battery died, name and ID checked"
              class="min-h-11 w-full rounded-xl border border-ink/50 px-3"
            />
            <button
              type="submit"
              class="min-h-12 w-full rounded-full bg-emerald-700 font-bold text-white hover:bg-emerald-800"
            >
              Admit {r.holderName.split(' ')[0]}
            </button>
          </form>
        )}
      </li>
    ))}
  </ul>
</section>
