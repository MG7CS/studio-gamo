---
/** Quick door sale / free issue form (no card payments at the door). Plain form POST. */
interface Props {
  options: Array<{
    id: string;
    name: string;
    priceText: string;
    remaining: number;
    sections: Array<{ id: string; name: string; code: string; remaining: number }>;
  }>;
  methods: Array<'free_issue' | 'cash_recorded'>;
  idempotencyKey: string;
}
const { options, methods, idempotencyKey } = Astro.props;
const methodText = { free_issue: 'Free issue', cash_recorded: 'Cash received (recorded)' };
---

<form method="post" class="space-y-4 rounded-[20px] bg-white/5 p-4 ring-1 ring-white/15">
  <input type="hidden" name="idempotency_key" value={idempotencyKey} />
  <div>
    <label for="door-category" class="text-sm font-semibold">
      Ticket
    </label>
    <select
      id="door-category"
      name="category"
      required
      class="mt-1.5 min-h-12 w-full rounded-xl bg-white px-3 text-ink"
    >
      {options.map((o) => (
        <option value={o.id} disabled={o.remaining === 0}>
          {o.name} — {o.priceText} — {o.remaining === 0 ? 'sold out' : `${o.remaining} left`}
        </option>
      ))}
    </select>
  </div>
  {options.some((o) => o.sections.length) && (
    <div>
      <label for="door-section" class="text-sm font-semibold">
        Section (if the ticket has sections)
      </label>
      <select
        id="door-section"
        name="section"
        class="mt-1.5 min-h-12 w-full rounded-xl bg-white px-3 text-ink"
      >
        <option value="">No section</option>
        {options.flatMap((o) =>
          o.sections.map((s) => (
            <option value={s.id} disabled={s.remaining === 0}>
              {o.name}: {s.name} ({s.code}) — {s.remaining === 0 ? 'full' : `${s.remaining} left`}
            </option>
          )),
        )}
      </select>
    </div>
  )}
  <div class="grid grid-cols-2 gap-3">
    <div>
      <label for="door-qty" class="text-sm font-semibold">
        How many
      </label>
      <input
        id="door-qty"
        name="quantity"
        type="number"
        min="1"
        max="10"
        value="1"
        required
        class="mt-1.5 min-h-12 w-full rounded-xl bg-white px-3 text-ink"
      />
    </div>
    <div>
      <label for="door-amount" class="text-sm font-semibold">
        Cash per ticket
      </label>
      <input
        id="door-amount"
        name="amount"
        inputmode="decimal"
        placeholder="0.00"
        class="mt-1.5 min-h-12 w-full rounded-xl bg-white px-3 text-ink"
        aria-describedby="door-amount-hint"
      />
      <p id="door-amount-hint" class="mt-1 text-xs text-cream/75">
        Only for cash sales.
      </p>
    </div>
  </div>
  <fieldset>
    <legend class="text-sm font-semibold">Payment</legend>
    <div class="mt-2 space-y-2">
      {methods.map((m, i) => (
        <label class="flex min-h-11 items-center gap-3 rounded-xl bg-white/10 px-3">
          <input type="radio" name="method" value={m} checked={i === 0} class="size-5 accent-terracotta" />
          {methodText[m]}
        </label>
      ))}
    </div>
    <p class="mt-1 text-xs text-cream/75">Card payments are never taken at the door.</p>
  </fieldset>
  <div>
    <label for="door-name" class="text-sm font-semibold">
      Guest name (optional)
    </label>
    <input
      id="door-name"
      name="name"
      maxlength="120"
      autocomplete="off"
      class="mt-1.5 min-h-12 w-full rounded-xl bg-white px-3 text-ink"
    />
  </div>
  <div>
    <label for="door-email" class="text-sm font-semibold">
      Guest email (optional)
    </label>
    <input
      id="door-email"
      name="email"
      type="email"
      maxlength="320"
      autocomplete="off"
      class="mt-1.5 min-h-12 w-full rounded-xl bg-white px-3 text-ink"
    />
  </div>
  <label class="flex min-h-11 items-center gap-3">
    <input type="checkbox" name="admit" value="1" checked class="size-5 accent-terracotta" /> Admit now
  </label>
  <button
    type="submit"
    class="min-h-14 w-full rounded-full bg-terracotta text-base font-bold text-white hover:bg-terracotta-deep"
  >
    Issue ticket
  </button>
</form>
