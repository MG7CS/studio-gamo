---
/** One artist in the list: the name (the whole card is the link), how many upcoming events, and the next date. */
import type { LiveArtistSummary } from '@gamo/domain';
import { formatLocalEventSchedule } from '@gamo/domain';

interface Props {
  artist: LiveArtistSummary;
}
const { artist } = Astro.props;
const next = artist.nextEventDateLocal
  ? formatLocalEventSchedule(artist.nextEventDateLocal, null, null).shortDateLabel
  : null;
---

<li class="list-none">
  <article class="relative h-full rounded-2xl border border-sand bg-white p-5 transition-shadow focus-within:ring-2 focus-within:ring-terracotta hover:shadow-md">
    <h2 class="text-lg font-semibold leading-snug text-ink">
      <a href={`/artists/${artist.slug}`} class="outline-none after:absolute after:inset-0 after:rounded-2xl">
        {artist.stageName}
      </a>
    </h2>
    <p class="mt-2 text-sm font-semibold text-terracotta-deep">
      {artist.upcomingEventCount} upcoming{next && <span class="font-medium text-ink"> · Next {next}</span>}
    </p>
  </article>
</li>
