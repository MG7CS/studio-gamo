---
/** Event detail body: about, schedule outline, venue, admission tiers and organizer card. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { getOrganizer, price, type LiveEvent } from '../../data/events';
interface Props { event: LiveEvent }
const { event: e } = Astro.props;
const org = getOrganizer(e.organizer);
const schedule = [['Doors open', '30 min before'], ['Welcome & worship', e.time], ['Main program', 'About 90 minutes'], ['Fellowship', 'After the program']];
---
<section class="bg-ivory px-4 py-16 sm:px-8 lg:py-20">
  <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[1.3fr_1fr]">
    <div class="space-y-10">
      <div>
        <h2 class="section-subheading">About this event</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{e.description}</p>
      </div>
      <div>
        <h2 class="text-xl font-semibold">Schedule</h2>
        <ol class="mt-4 divide-y divide-sand rounded-[24px] bg-white ring-1 ring-sand">
          {schedule.map(([a, b]) => <li class="flex justify-between gap-4 px-5 py-4"><span class="font-medium">{a}</span><span class="text-ink-soft">{b}</span></li>)}
        </ol>
      </div>
      <div class="rounded-[24px] bg-white p-6 ring-1 ring-sand">
        <h2 class="flex items-center gap-2 text-xl font-semibold"><Icon name="pin" class="h-5 w-5 text-terracotta" />Venue</h2>
        <p class="mt-2 font-medium">{e.venue}</p>
        <p class="text-ink-soft">{e.city}, {e.state} · Full address shared with registered guests</p>
        <p class="mt-3 text-sm text-ink-soft">Accessibility details, parking and childcare notes are provided by the organizer.</p>
      </div>
    </div>
    <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
      <div class="rounded-[28px] bg-white p-6 ring-1 ring-sand">
        <div class="flex items-center justify-between"><h2 class="text-xl font-semibold">Admission</h2><StatusPill kind="info">{e.ticketing === 'free' ? 'Free admission' : e.ticketing === 'external' ? 'External tickets' : 'Gamo ticketing'}</StatusPill></div>
        <ul class="mt-4 space-y-3">
          {e.tiers.map((t) => <li class="flex items-start justify-between gap-4 rounded-2xl bg-cream px-4 py-3"><span><span class="block font-medium">{t.name}</span>{t.note && <span class="text-sm text-ink-soft">{t.note}</span>}</span><span class="font-semibold">{price(t.priceCents)}</span></li>)}
        </ul>
        <p class="mt-4 text-xs text-ink-soft">{e.ticketing === 'external' ? `Tickets are sold by ${e.externalSource}, outside Gamo Live.` : 'Any Gamo administrative allocation is always listed as a separate line item.'}</p>
      </div>
      <a href={`/organizers/${org.slug}`} class="flex items-center gap-4 rounded-[28px] bg-white p-4 ring-1 ring-sand hover:ring-terracotta">
        <span class="h-16 w-16 shrink-0 overflow-hidden rounded-2xl"><Photo name={org.photo} sizes="64px" class="h-full w-full object-cover" alt="" /></span>
        <span><span class="block text-xs font-semibold uppercase tracking-wider text-ink-soft">Hosted by</span><span class="block font-semibold">{org.name}</span><span class="text-sm text-ink-soft">{org.kind} · {org.city}</span></span>
      </a>
    </aside>
  </div>
</section>
