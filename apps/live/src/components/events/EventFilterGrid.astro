---
/**
 * Demo search & filters. Filtering happens client-side over pre-rendered cards (data-* attributes).
 * Query params from browse links (?city, ?category, ?price, ?date, ?when) preselect filters.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import EventCard from '../shared/EventCard.astro';
import { categoryLabels, cities, organizers, type LiveEvent } from '../../data/events';
interface Props { events: LiveEvent[] }
const { events } = Astro.props;
const select = 'mt-1.5 block w-full rounded-2xl border border-sand bg-white px-4 py-3 text-sm';
---
<section class="bg-cream px-4 pb-20 sm:px-8" data-event-filter>
  <div class="mx-auto max-w-[1320px]">
    <form class="grid gap-3 rounded-[28px] bg-white p-4 ring-1 ring-sand sm:grid-cols-2 lg:grid-cols-4 lg:items-end" role="search" onsubmit="return false">
      <label class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Search
        <span class="relative block"><input name="q" type="search" placeholder="Event, organizer or city" class={`${select} pl-10 normal-case tracking-normal`} /><Icon name="sliders" class="pointer-events-none absolute left-3.5 top-[1.15rem] h-4 w-4 text-ink-soft" /></span>
      </label>
      <label class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Location
        <select name="city" class={select}><option value="">Anywhere</option>{cities.map((c) => <option>{c}</option>)}</select>
      </label>
      <label class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Type
        <select name="category" class={select}><option value="">All types</option>{Object.entries(categoryLabels).map(([v, l]) => <option value={v}>{l}</option>)}</select>
      </label>
      <label class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Price
        <select name="price" class={select}><option value="">Free &amp; ticketed</option><option value="free">Free</option><option value="paid">Ticketed</option></select>
      </label>
      <label class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Organizer
        <select name="organizer" class={select}><option value="">All organizers</option>{organizers.map(o => <option value={o.slug}>{o.name}</option>)}</select>
      </label>
      <label class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Date
        <input name="date" type="date" class={select}/>
      </label>
      <label class="text-xs font-semibold uppercase tracking-wider text-ink-soft">When
        <select name="when" class={select}><option value="">Any time</option><option value="weekend">This weekend (sample week)</option><option value="month">Next 30 days (sample month)</option><option value="recurring">Recurring gatherings</option></select>
      </label>
      <button type="reset" class="rounded-full px-5 py-3 text-sm font-semibold text-terracotta hover:bg-cream">Clear</button>
    </form>
    <p class="mt-6 text-sm text-ink-soft" aria-live="polite"><span data-count>{events.length}</span> sample events · <span data-extra></span></p>
    <ul class="mt-6 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {events.map((e) => (
        <li data-card data-city={`${e.city}, ${e.state}`} data-category={e.category} data-price={e.ticketing === 'free' ? 'free' : 'paid'} data-organizer={e.organizer} data-date={e.date} data-recurring={e.recurring ? '1' : ''} data-text={`${e.title} ${e.city} ${e.organizer}`.toLowerCase()}>
          <EventCard event={e} />
        </li>
      ))}
    </ul>
    <p data-empty hidden class="mt-10 rounded-[24px] bg-white p-8 text-center text-ink-soft ring-1 ring-sand">No sample events match these filters.</p>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-event-filter]').forEach((root) => {
    const form = root.querySelector('form')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const params = new URL(location.href).searchParams;
    for (const k of ['city', 'category', 'price', 'organizer', 'date', 'when']) { const v = params.get(k); const el = form.elements.namedItem(k) as HTMLSelectElement; if (v && el) el.value = v; }
    const previewDate = new Date('2026-10-12T12:00:00Z');
    const extra = root.querySelector('[data-extra]')!;
    extra.textContent = 'Demo filters — date presets use October 12, 2026';
    const apply = () => {
      const f = new FormData(form); const q = String(f.get('q') || '').toLowerCase();
      const date = String(f.get('date') || ''); const when = String(f.get('when') || '');
      let n = 0;
      cards.forEach((c) => {
        const d = c.dataset; const eventDate = new Date(`${d.date}T12:00:00Z`); const days = (eventDate.getTime() - previewDate.getTime()) / 86400000;
        const weekend = (eventDate.getUTCDay() === 6 || eventDate.getUTCDay() === 0) && days >= 0 && days <= 6;
        const ok = (!q || d.text!.includes(q)) && (!f.get('city') || d.city === f.get('city')) && (!f.get('category') || d.category === f.get('category'))
          && (!f.get('price') || d.price === f.get('price')) && (!f.get('organizer') || d.organizer === f.get('organizer')) && (!date || d.date === date) && (when !== 'recurring' || d.recurring === '1') && (when !== 'weekend' || weekend) && (when !== 'month' || (days >= 0 && days <= 30));
        c.hidden = !ok; if (ok) n++;
      });
      root.querySelector('[data-count]')!.textContent = String(n);
      (root.querySelector('[data-empty]') as HTMLElement).hidden = n > 0;
    };
    form.addEventListener('input', apply);
    form.addEventListener('reset', () => { extra.textContent = 'Demo filters — date presets use October 12, 2026'; history.replaceState(null, '', location.pathname); setTimeout(apply); });
    apply();
  });
</script>
