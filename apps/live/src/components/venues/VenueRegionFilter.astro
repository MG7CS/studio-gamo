---
/** A plain GET form: pick a city or metro and see only its venues. Works without JavaScript. */
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import SplitField from '@studio-gamo/ui/components/split/SplitField.astro';

interface Props {
  regions: string[];
  selected: string | null;
}
const { regions, selected } = Astro.props;
---

<form action="/venues" method="get" class="mb-8 flex flex-wrap items-end gap-3">
  <SplitField id="venue-city" name="city" label="City" as="select" class="w-full sm:w-72">
    <option value="" selected={!selected}>
      All cities
    </option>
    {regions.map((r) => (
      <option value={r} selected={r === selected}>
        {r}
      </option>
    ))}
  </SplitField>
  <Button variant="secondary" size="lg" class="min-h-[56px]">
    Show venues
  </Button>
  {selected && (
    <a
      href="/venues"
      class="inline-flex min-h-11 items-center px-2 text-sm font-semibold text-terracotta-deep underline underline-offset-4"
    >
      Clear
    </a>
  )}
</form>
