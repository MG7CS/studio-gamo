---
/** Short pill label above a heading ("Events nationwide", "Next up"). */
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
---

<p
  class:list={[
    'inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold',
    tone === 'dark' ? 'bg-white/15 text-cream' : 'bg-sand text-terracotta-deep',
    className,
  ]}
>
  <slot />
</p>
