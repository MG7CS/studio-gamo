---
/** Split card for organizers: photo first on phones, photo on the right on desktop. */
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import EyebrowPill from './EyebrowPill.astro';
import Surface from './Surface.astro';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image?: string;
  imageAlt?: string;
}
const {
  eyebrow,
  title,
  body,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  image = '/images/optimized/live-worship-night-hands-raised-1254w.webp',
  imageAlt = 'Worship night audience with hands raised in stage light',
} = Astro.props;
---

<Surface padding="none" class="grid grid-cols-1 lg:grid-cols-12 lg:items-stretch">
  <div class="relative aspect-[16/10] w-full lg:order-last lg:col-span-5 lg:aspect-auto lg:min-h-[380px]">
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
  </div>
  <div class="p-5 sm:p-10 lg:col-span-7 lg:p-14">
    <EyebrowPill class="mb-3">{eyebrow}</EyebrowPill>
    <h2 class="text-[26px] font-black uppercase leading-[1.06] tracking-tight text-ink sm:text-[34px] lg:text-[40px]">
      {title}
    </h2>
    <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted sm:text-base">{body}</p>
    <div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:items-center">
      <ButtonLink href={ctaHref} arrow class="w-full sm:w-auto">
        {ctaLabel}
      </ButtonLink>
      {secondaryLabel && secondaryHref && (
        <ButtonLink href={secondaryHref} variant="secondary" class="w-full sm:w-auto">
          {secondaryLabel}
        </ButtonLink>
      )}
    </div>
  </div>
</Surface>
