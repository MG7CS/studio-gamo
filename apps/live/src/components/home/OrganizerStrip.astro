---
/** One short line for organizers, linking to the promote page. */
import Button from '@studio-gamo/ui/components/ui/Button.astro';
---

<section
  aria-labelledby="organizer-strip-title"
  class="flex flex-col gap-4 border-t border-tan pt-8 sm:flex-row sm:items-center sm:justify-between"
>
  <div>
    <h2 id="organizer-strip-title" class="text-xl font-semibold text-ink">
      Hosting a Christian event?
    </h2>
    <p class="mt-1 text-[15px] text-muted">List it on Gamo Live so people can find it.</p>
  </div>
  <Button href="/promote" variant="secondary" class="shrink-0 self-start">
    Promote an event
  </Button>
</section>
