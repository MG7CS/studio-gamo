---
/** An event an admin chose to feature. Always labeled "Featured by Gamo"; never shown for any other reason. */
import type { LiveEventWithDetails } from '@gamo/domain';
import { admissionLabel, categoryLabel, formatLocalEventSchedule } from '@gamo/domain';
import DateBlock from '../DateBlock.astro';
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';

interface Props {
  event: LiveEventWithDetails;
}
const { event } = Astro.props;
const schedule = formatLocalEventSchedule(
  event.startDateLocal,
  event.startTimeLocal,
  event.timezone,
  event.startsAt,
);
---

<section aria-labelledby="featured-title" class="rounded-3xl bg-sand p-6 sm:p-8">
  <Pill tone="info">Featured by Gamo</Pill>
  <div class="mt-5 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
    <DateBlock date={event.startDateLocal} size="lg" />
    <div class="min-w-0 flex-1">
      <p class="text-sm font-semibold text-muted">{categoryLabel(event.category)}</p>
      <h2 id="featured-title" class="mt-1 text-2xl font-semibold leading-tight text-ink sm:text-3xl">
        {event.title}
      </h2>
      <p class="mt-2 text-[15px] text-ink">
        {schedule.shortDateLabel} · {schedule.timeLabel}
      </p>
      <p class="text-[15px] text-muted">
        {event.venueName}, {event.city}, {event.state}
      </p>
      <p class="mt-2 text-[15px] font-semibold text-terracotta-deep">{admissionLabel(event)}</p>
    </div>
    <Button href={`/events/${event.slug}`} size="lg" class="shrink-0 self-start sm:self-center">
      View event
    </Button>
  </div>
</section>
