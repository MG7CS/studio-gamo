---
/**
 * The first screen: the approved worship-leader photograph, one line of copy and one search that opens the events
 * list. A flat dark layer (no gradient) keeps the white text readable over the photograph.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
---

<section class="relative isolate overflow-hidden bg-ink text-white">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <Photo
      name="worshipLeaderGolden"
      sizes="100vw"
      alt=""
      priority
      class="h-full w-full object-cover"
      position="50% 22%"
    />
    <div class="absolute inset-0 bg-night/70"></div>
  </div>

  <div class="mx-auto max-w-[1340px] px-4 pb-14 pt-14 sm:px-6 sm:pb-20 sm:pt-20 lg:px-8 lg:pb-24 lg:pt-28">
    <h1 class="max-w-2xl text-[40px] font-black uppercase leading-[1.06] tracking-tight sm:text-6xl lg:text-[68px]">
      Find your next <span class="text-terracotta-soft">live</span> experience.
    </h1>
    <p class="mt-4 max-w-lg text-lg leading-relaxed text-white/90 sm:text-xl">
      Concerts, worship nights, and gatherings worth being there for.
    </p>

    <form
      action="/events"
      method="get"
      role="search"
      class="mt-8 flex max-w-2xl flex-col gap-2 rounded-3xl bg-white p-2 text-ink sm:flex-row sm:items-center sm:rounded-full"
    >
      <label for="home-search" class="sr-only">
        Search events, artists or venues
      </label>
      <input
        id="home-search"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Search events, artists or venues"
        class="min-h-12 w-full flex-1 rounded-full bg-transparent px-5 text-base text-ink placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-terracotta"
      />
      <Button size="lg" class="shrink-0">
        Search
      </Button>
    </form>
  </div>
</section>
