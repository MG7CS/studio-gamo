---
/** The next few upcoming events, or an honest empty state with the way to add one. */
import type { LiveEventWithDetails } from '@gamo/domain';
import LiveDiscoveryCard from '../LiveDiscoveryCard.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';

interface Props {
  events: LiveEventWithDetails[];
  /** True when the events could not be read at all (not the same as having none). */
  unavailable?: boolean;
}
const { events, unavailable = false } = Astro.props;
---

<section aria-labelledby="upcoming-title">
  <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h2 id="upcoming-title" class="text-2xl font-semibold tracking-tight text-ink">
      Upcoming events
    </h2>
    {events.length > 0 && (
      <a
        href="/events"
        class="inline-flex min-h-11 items-center text-[15px] font-semibold text-terracotta-deep underline-offset-4 hover:underline"
      >
        See all events
      </a>
    )}
  </div>
  {unavailable ? (
    <Notice tone="warning" title="Events are unavailable right now">
      Please try again in a moment.
    </Notice>
  ) : events.length === 0 ? (
    <EmptyState title="No upcoming events yet." text="Events appear here as soon as organizers publish them.">
      <Button href="/promote" variant="secondary">
        Promote an event
      </Button>
    </EmptyState>
  ) : (
    <ul class="grid gap-4 md:grid-cols-2">
      {events.map((event) => (
        <LiveDiscoveryCard event={event} />
      ))}
    </ul>
  )}
</section>
