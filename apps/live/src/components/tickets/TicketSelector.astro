---
/** Ticket/registration selection mock. Quantity steppers update a local summary; nothing is reserved. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { dateParts, price, type LiveEvent } from '../../data/events';
interface Props { event: LiveEvent }
const { event: e } = Astro.props;
const d = dateParts(e.date);
const closed = e.status === 'canceled';
---
<section class="bg-cream px-4 pb-20 sm:px-8" data-ticket-select>
  <div class="mx-auto grid max-w-[1100px] gap-8 lg:grid-cols-[1.4fr_1fr]">
    <div class="rounded-[28px] bg-white p-6 ring-1 ring-sand sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl font-semibold tracking-tight">{e.ticketing === 'free' ? 'Choose registration' : 'Choose tickets'}</h2>
        <StatusPill kind={e.ticketing === 'external' ? 'external' : e.ticketing === 'free' ? 'free' : 'paid'}>{e.ticketing === 'external' ? 'External tickets' : e.ticketing === 'free' ? 'Free' : 'Gamo ticketing'}</StatusPill>
      </div>
      {closed && <p class="mt-5 rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-900 ring-1 ring-red-200">This event is canceled. Ticket selection is disabled.</p>}
      {e.ticketing === 'external' ? (
        <div class="mt-6 rounded-2xl bg-cream p-5">
          <p class="flex items-center gap-2 font-semibold"><Icon name="external" class="h-5 w-5 text-terracotta" />Sold by {e.externalSource}</p>
          <p class="mt-2 text-sm text-ink-soft">Tickets are sold directly through the organizer’s ticketing page. Gamo Live does not process external ticket purchases.</p>
        </div>
      ) : (
        <ul class="mt-6 divide-y divide-sand">
          {e.tiers.map((t, i) => (
            <li class="flex items-center justify-between gap-4 py-5" data-tier data-price={t.priceCents}>
              <div><p class="font-semibold">{t.name}</p><p class="text-sm text-ink-soft">{price(t.priceCents)}{t.note && ` · ${t.note}`}</p></div>
              <div class="flex items-center gap-2">
                <button type="button" data-dec disabled={closed} class="grid h-10 w-10 place-items-center rounded-full ring-1 ring-sand hover:bg-cream disabled:opacity-40" aria-label={`Remove one ${t.name}`}><Icon name="minus" class="h-4 w-4" /></button>
                <output data-qty class="w-6 text-center font-semibold" aria-label={`${t.name} quantity`}>{i === 0 && !closed ? 1 : 0}</output>
                <button type="button" data-inc disabled={closed} class="grid h-10 w-10 place-items-center rounded-full ring-1 ring-sand hover:bg-cream disabled:opacity-40" aria-label={`Add one ${t.name}`}><Icon name="plus" class="h-4 w-4" /></button>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
    <aside class="h-fit rounded-[28px] bg-charcoal p-6 text-cream sm:p-8" data-surface="dark">
      <p class="eyebrow text-gold">Order summary</p>
      <p class="mt-3 text-lg font-semibold">{e.title}</p>
      <p class="text-sm text-cream/70">{d.long} · {e.time}<br />{e.venue}, {e.city}, {e.state}</p>
      <dl class="mt-6 space-y-2 border-t border-white/15 pt-5 text-sm">
        <div class="flex justify-between"><dt>Tickets</dt><dd data-count>—</dd></div>
        <div class="flex justify-between text-base font-semibold"><dt>Total</dt><dd data-total aria-live="polite">—</dd></div>
      </dl>
      <p class="mt-3 text-xs text-cream/60">Any Gamo administrative allocation appears as a separate line item.</p>
      {!closed && e.ticketing !== 'external' && <div data-checkout><ButtonLink href={`/checkout?event=${e.id}`} arrow class="mt-6 w-full justify-center">Continue to checkout</ButtonLink><p data-zero hidden class="mt-4 text-sm text-gold">Choose at least one ticket to continue.</p></div>}
    </aside>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-ticket-select]').forEach((root) => {
    const tiers = [...root.querySelectorAll<HTMLElement>('[data-tier]')];
    const update = () => {
      let n = 0, sum = 0;
      tiers.forEach((t) => { const q = Number(t.querySelector('[data-qty]')!.textContent); n += q; sum += q * Number(t.dataset.price); });
      root.querySelector('[data-count]')!.textContent = String(n);
      root.querySelector('[data-total]')!.textContent = sum === 0 ? (n ? 'Free' : '—') : `$${(sum / 100).toFixed(2)}`;
      const link = root.querySelector<HTMLAnchorElement>('[data-checkout] a');
      if (link) { const url = new URL(link.href); tiers.forEach((t,i) => url.searchParams.set(`q${i}`, t.querySelector('[data-qty]')!.textContent!)); link.href=url.pathname+url.search; link.setAttribute('aria-disabled', String(n === 0)); root.querySelector<HTMLElement>('[data-zero]')!.hidden=n > 0; }
    };
    tiers.forEach((t) => {
      const out = t.querySelector('[data-qty]')!;
      t.querySelector('[data-inc]')?.addEventListener('click', () => { out.textContent = String(Math.min(10, Number(out.textContent) + 1)); update(); });
      t.querySelector('[data-dec]')?.addEventListener('click', () => { out.textContent = String(Math.max(0, Number(out.textContent) - 1)); update(); });
    });
    root.querySelector('[data-checkout] a')?.addEventListener('click', (event) => { if (root.querySelector('[data-checkout] a')!.getAttribute('aria-disabled') === 'true') event.preventDefault(); });
    if (tiers.length) update();
  });
</script>
