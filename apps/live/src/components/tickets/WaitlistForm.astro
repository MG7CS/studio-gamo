---
/**
 * Waitlist signup for a sold-out event (design §7). A separate small form on the register page:
 * posts to `…/register?waitlist=1`; the answer is the same whether or not the address was waiting.
 * Nothing is reserved or charged; the earliest entries are emailed when tickets are released.
 */
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';
import EmailField from '@studio-gamo/ui/components/forms/EmailField.astro';
import TurnstileWidget from '@studio-gamo/ui/components/forms/TurnstileWidget.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import type { RemainingCount } from '@gamo/domain';

interface Props {
  action: string;
  remaining: RemainingCount[];
  message: string;
}
const { action, remaining, message } = Astro.props;
const categories = [...new Map(remaining.map((r) => [r.categoryId, r.name.split(' — ')[0]])).entries()];
---

<section class="mb-8 rounded-2xl border-2 border-ink/20 bg-cream p-5" aria-labelledby="waitlist-title">
  <h2 id="waitlist-title" class="text-lg font-black uppercase text-ink">
    Join the waitlist
  </h2>
  <p class="mt-1 text-sm text-ink">{message}</p>
  <form method="post" action={action} class="mt-4 space-y-4" novalidate>
    <EmailField id="waitlist-email" />
    {categories.length > 0 && (
      <div class="gamo-field">
        <label for="waitlist-category" class="block text-[15px] font-semibold text-ink">
          Ticket type
        </label>
        <select
          id="waitlist-category"
          name="categoryId"
          class="mt-2 block min-h-11 w-full rounded-xl border border-ink/50 bg-white px-4 py-2.5 text-base text-ink"
        >
          {categories.map(([id, name]) => (
            <option value={id}>{name}</option>
          ))}
        </select>
      </div>
    )}
    <TextField
      id="waitlist-quantity"
      name="quantity"
      label="How many tickets"
      type="number"
      inputmode="numeric"
      value="1"
    />
    <TurnstileWidget action="waitlist" id="turnstile-waitlist" />
    <SubmitButton label="Join the waitlist" variant="secondary" />
  </form>
</section>
