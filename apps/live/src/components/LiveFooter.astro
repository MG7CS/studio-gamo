---
import { GAMO_LIVE_METROS } from '@gamo/domain';
import { siteUrl } from '@studio-gamo/ui/lib/sites';

const primaryLinks = [
  { label: 'Events', href: '/events' },
  { label: 'Artists', href: '/artists' },
  { label: 'Venues', href: '/venues' },
  { label: 'List an Event', href: '/promote/create' },
  { label: 'My Tickets', href: '/tickets/find' },
  { label: 'Workspaces', href: '/workspaces' },
];
---

<footer data-surface="light" class="bg-ivory border-t border-sand text-ink">
  <div class="mx-auto max-w-[1340px] px-4 py-10 sm:px-6 lg:px-8">
    {/* Top Row: Brand Mark, Primary Links, Quick Actions */}
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      {/* Brand Mark */}
      <a href="/" class="inline-flex items-center gap-2.5 focus:outline-none group">
        <svg class="h-6 w-6 shrink-0 text-terracotta" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect x="2" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
          <rect x="7.2" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
          <rect x="12.4" y="2.5" width="3.2" height="23" rx="1.6" fill="currentColor" />
          <rect x="17.6" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
          <rect x="22.8" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
        </svg>
        <span class="text-[19px] leading-none tracking-tight flex items-baseline">
          <span aria-hidden="true" class="font-extrabold text-ink">
            GAMO
          </span>{' '}
          <span aria-hidden="true" class="font-normal text-terracotta ml-0.5">
            LIVE
          </span>
          <span class="sr-only">Gamo Live home</span>
        </span>
      </a>

      {/* Center Navigation Links */}
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap items-center gap-x-7 gap-y-2.5">
          {primaryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm font-medium text-muted hover:text-terracotta transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Right Icons / Discovery Shortcuts */}
      <div class="flex items-center gap-3 text-muted">
        <a
          href="/events"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-sand hover:text-terracotta transition-colors"
          aria-label="Browse all Christian concerts and worship events"
          title="Browse events"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
        </a>
        <a
          href="/venues"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-sand hover:text-terracotta transition-colors"
          aria-label="Explore concert venues across U.S. metros"
          title="Explore venues"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </a>
        <a
          href="/artists"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-sand hover:text-terracotta transition-colors"
          aria-label="Artists and ministry representation"
          title="Artists"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"
            />
          </svg>
        </a>
        <a
          href="/promote/create"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-sand hover:text-terracotta transition-colors"
          aria-label="Submit a Christian concert or worship event"
          title="List an event"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </a>
      </div>
    </div>

    {/* Metro Quick Links Row */}
    <div class="mt-7 pt-6 border-t border-sand/80">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-xs">
        <span class="font-bold uppercase tracking-wider text-muted mr-1.5">Browse by Metro:</span>
        {GAMO_LIVE_METROS.map((metro) => (
          <a
            href={`/events/${metro.slug}`}
            class="inline-flex items-center rounded-full border border-sand bg-cream hover:bg-sand hover:border-line px-3 py-1 font-medium text-muted hover:text-terracotta transition-colors min-h-11"
          >
            {metro.displayLabel}
          </a>
        ))}
      </div>
    </div>

    {/* Truthful Platform Disclosure Line */}
    <div
      id="status"
      class="mt-6 pt-5 border-t border-sand/80 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between text-xs text-muted leading-relaxed"
    >
      <p class="max-w-4xl">
        Gamo Live is a Christian, mission-driven event discovery and organizer platform. External discovery
        listings are published by Gamo Live Listings for informational discovery; ticket purchases and
        customer support occur on the linked official ticket provider site.
      </p>
      <p class="shrink-0 text-muted">© {new Date().getFullYear()} Gamo Live · Gamo Studios</p>
    </div>

    {/* Legal documents (drafts) on gamostudio.org — Phase 2 Agent A */}
    <nav aria-label="Legal" class="mt-4 flex flex-wrap gap-x-6 text-xs text-muted">
      {[
        { label: 'Legal & Privacy', path: '/legal' },
        { label: 'Privacy Policy', path: '/legal/privacy-policy' },
        { label: 'Site Terms', path: '/legal/site-terms' },
        { label: 'Ticket Terms', path: '/legal/ticket-terms' },
        { label: 'Organizer Terms', path: '/legal/organizer-terms' },
      ].map((link) => (
        <a href={siteUrl('web', link.path)} class="inline-flex min-h-11 items-center hover:text-terracotta">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
