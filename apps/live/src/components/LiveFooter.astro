---
/** The one footer for every public Gamo Live page: who we are in a sentence, the same four links, three legal links. */
import { siteUrl } from '@studio-gamo/ui/lib/sites';

const links = [
  { label: 'Events', href: '/events' },
  { label: 'Artists', href: '/artists' },
  { label: 'Venues', href: '/venues' },
  { label: 'Promote an event', href: '/promote' },
];
// The legal documents stay linked from every footer (scripts/audit/legal-drafts.test.ts).
const legal = [
  { label: 'Legal', path: '/legal' },
  { label: 'Privacy', path: '/legal/privacy-policy' },
  { label: 'Site terms', path: '/legal/site-terms' },
  { label: 'Ticket terms', path: '/legal/ticket-terms' },
  { label: 'Organizer terms', path: '/legal/organizer-terms' },
  { label: 'Contact', path: '/contact' },
];
const link = 'inline-flex min-h-11 items-center text-sm font-medium text-ink hover:text-terracotta-deep';
---

<footer class="border-t border-sand bg-ivory text-ink">
  <div class="mx-auto max-w-[1340px] px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-md">
        <a href="/" class="inline-flex min-h-11 items-center text-xl tracking-tight">
          <span aria-hidden="true" class="font-extrabold">
            GAMO
          </span>
          <span aria-hidden="true" class="ml-1 font-normal text-terracotta-deep">
            LIVE
          </span>
          <span class="sr-only">Gamo Live home</span>
        </a>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Christian concerts, worship nights and conferences across the United States. Gamo Live is part of
          Gamo Studios, a Christian public benefit corporation. Tickets for listed events are sold by the
          organizers, not by Gamo.
        </p>
      </div>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-7 md:flex-col">
          {links.map((l) => (
            <li>
              <a href={l.href} class={link}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="mt-8 flex flex-col gap-2 border-t border-sand pt-4 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Gamo Studios</p>
      <nav aria-label="Legal">
        <ul class="flex flex-wrap gap-x-6">
          {legal.map((l) => (
            <li>
              <a
                href={siteUrl('web', l.path)}
                class="inline-flex min-h-11 items-center hover:text-terracotta-deep"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
