---
/** Public footer: brand, the four site links, city pills, one honest line about listings, legal links. */
import { GAMO_LIVE_METROS } from '@gamo/domain';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import MetroLinks from './public/MetroLinks.astro';

const primaryLinks = [
  { label: 'Events', href: '/events' },
  { label: 'Artists', href: '/artists' },
  { label: 'Venues', href: '/venues' },
  { label: 'List an event', href: '/organizer' },
];

const legalLinks = [
  { label: 'Legal and privacy', path: '/legal' },
  { label: 'Privacy policy', path: '/legal/privacy-policy' },
  { label: 'Site terms', path: '/legal/site-terms' },
  { label: 'Ticket terms', path: '/legal/ticket-terms' },
  { label: 'Organizer terms', path: '/legal/organizer-terms' },
];

const metroItems = GAMO_LIVE_METROS.map((m) => ({ slug: m.slug, label: m.displayLabel }));
---

<footer data-surface="light" class="bg-cream text-ink">
  <div class="mx-auto max-w-[1340px] px-4 pb-8 pt-12 sm:px-6 lg:px-8">
    <div class="rounded-[24px] border border-sand bg-white p-5 sm:rounded-[28px] sm:p-8">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <a href="/" class="group inline-flex min-h-11 items-center gap-2.5">
          <svg class="h-6 w-6 shrink-0 text-terracotta" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect x="2" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
            <rect x="7.2" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
            <rect x="12.4" y="2.5" width="3.2" height="23" rx="1.6" fill="currentColor" />
            <rect x="17.6" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.9" />
            <rect x="22.8" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.75" />
          </svg>
          <span class="flex items-baseline text-[19px] leading-none tracking-tight">
            <span aria-hidden="true" class="font-extrabold text-ink">
              GAMO
            </span>
            <span aria-hidden="true" class="ml-1 font-normal text-terracotta">
              LIVE
            </span>
            <span class="sr-only">Gamo Live home</span>
          </span>
        </a>

        <nav aria-label="Footer">
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-1">
            {primaryLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center text-sm font-semibold text-ink transition-colors hover:text-terracotta-deep"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="mt-6 border-t border-sand pt-6">
        <p class="mb-3 text-xs font-semibold text-muted">Browse by city</p>
        <MetroLinks items={metroItems} href={(slug) => `/events/${slug}`} label="Cities" />
      </div>

      <div
        id="status"
        class="mt-6 flex flex-col gap-3 border-t border-sand pt-5 text-xs leading-relaxed text-muted lg:flex-row lg:items-start lg:justify-between"
      >
        <div class="max-w-3xl space-y-1.5">
          <p>
            Gamo Live is part of Gamo Studios, a Christian, mission-driven Public Benefit Corporation. Events
            are listed by their organizers or by Gamo Live Listings.
          </p>
          <p>
            Listings marked "Tickets at" link to the official ticket provider. Gamo does not sell those
            tickets.
          </p>
        </div>
        <p class="shrink-0">© {new Date().getFullYear()} Gamo Live · Gamo Studios</p>
      </div>

      <nav aria-label="Legal" class="mt-2 flex flex-wrap gap-x-6 text-xs text-muted">
        {legalLinks.map((link) => (
          <a
            href={siteUrl('web', link.path)}
            class="inline-flex min-h-11 items-center hover:text-terracotta-deep"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>
