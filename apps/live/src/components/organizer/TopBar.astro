---
/** Phones only: the signed-in person's menu at the top right. On desktop the menu lives at the bottom of the sidebar. */
import UserMenu from './UserMenu.astro';
import type { MembershipSummary, Organizer } from '@gamo/domain';

interface Props {
  organizer: Organizer;
  memberships: MembershipSummary[];
  active: MembershipSummary | null;
}
const { organizer, memberships, active } = Astro.props;
---

<header class="flex justify-end px-4 py-3 sm:px-6 lg:hidden">
  <UserMenu organizer={organizer} memberships={memberships} active={active} variant="phone" />
</header>
