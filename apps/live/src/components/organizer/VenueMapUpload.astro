---
/** Blueprint upload (PNG/JPEG/WebP ≤ 5 MB, SVG ≤ 1 MB, sanitised on the server). Multipart form POST. */
interface Props {
  hasMap: boolean;
  error?: string | null;
}
const { hasMap, error } = Astro.props;
---

<section aria-labelledby="map-upload" class="rounded-[24px] bg-white p-5 ring-1 ring-sand sm:p-7">
  <h2 id="map-upload" class="text-xl font-black tracking-tight text-ink uppercase">
    {hasMap ? 'Replace the blueprint' : 'Upload a blueprint'}
  </h2>
  <p class="mt-1 max-w-2xl text-sm text-muted">
    A floor plan of the venue: PNG, JPEG or WebP up to 5 MB, or SVG up to 1 MB. SVG files are cleaned on
    upload (scripts, links and embedded content are removed).{' '}
    {hasMap && 'Sections keep their shapes — check them after replacing.'}
  </p>
  <form method="post" enctype="multipart/form-data" class="mt-5 space-y-4">
    <input type="hidden" name="action" value="upload" />
    <div>
      <label for="map-file" class="text-sm font-semibold text-ink">
        Blueprint file
      </label>
      <input
        id="map-file"
        name="file"
        type="file"
        required
        accept="image/png,image/jpeg,image/webp,image/svg+xml,.svg"
        aria-describedby={error ? 'map-error' : undefined}
        class="mt-1.5 block min-h-11 w-full rounded-xl border border-ink/50 bg-white px-3 py-2 text-sm"
      />
    </div>
    <div>
      <label for="map-alt" class="text-sm font-semibold text-ink">
        Short description for people who cannot see the map
      </label>
      <input
        id="map-alt"
        name="alt"
        required
        minlength="3"
        maxlength="500"
        placeholder="Main hall, stage at the north end, balcony above"
        class="mt-1.5 min-h-11 w-full rounded-xl border border-ink/50 bg-white px-3 text-sm"
      />
    </div>
    {error && (
      <p id="map-error" class="text-sm font-semibold text-terracotta-deep">
        Error: {error}
      </p>
    )}
    <button
      type="submit"
      class="min-h-11 rounded-full bg-terracotta px-6 text-sm font-semibold text-white hover:bg-terracotta-deep"
    >
      Upload blueprint
    </button>
  </form>
</section>
