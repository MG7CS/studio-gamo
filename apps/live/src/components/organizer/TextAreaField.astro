---
/** A labelled <textarea> with the same look as the shared TextField. */
interface Props {
  id: string;
  name: string;
  label: string;
  value?: string;
  hint?: string;
  error?: string;
  rows?: number;
  maxlength?: number;
  required?: boolean;
}
const {
  id,
  name,
  label,
  value = '',
  hint,
  error,
  rows = 5,
  maxlength = 10000,
  required = false,
} = Astro.props;
const describedBy =
  [hint ? `${id}-hint` : null, error ? `${id}-error` : null].filter(Boolean).join(' ') || undefined;
---

<div class="gamo-field">
  <label for={id} class="block text-[15px] font-semibold text-ink">
    {label}
  </label>
  {hint && (
    <p id={`${id}-hint`} class="mt-1 text-sm text-muted">
      {hint}
    </p>
  )}
  <textarea
    id={id}
    name={name}
    rows={rows}
    maxlength={maxlength}
    required={required}
    aria-describedby={describedBy}
    aria-invalid={error ? 'true' : undefined}
    class:list={[
      'mt-2 block w-full rounded-xl border bg-white px-4 py-2.5 text-base text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2',
      error ? 'border-2 border-terracotta-deep' : 'border-ink/50',
    ]}
  >{value}</textarea>
  {error && (
    <p id={`${id}-error`} class="mt-1.5 text-sm font-semibold text-terracotta-deep">
      <span class="sr-only">Error: </span>
      {error}
    </p>
  )}
</div>
