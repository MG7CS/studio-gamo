---
/**
 * Shows a new scanner link and PIN exactly once (they are not stored and cannot be shown again),
 * with plain-language sharing instructions. The copy buttons are a progressive enhancement.
 */
import OrganizerNotice from './OrganizerNotice.astro';

interface Props {
  label: string;
  url: string;
  pin: string;
  expiresText: string;
}
const { label, url, pin, expiresText } = Astro.props;
---

<section aria-labelledby="gate-created" class="rounded-[24px] bg-ink p-5 text-cream sm:p-7" data-copy-root>
  <h2 id="gate-created" class="text-xl font-black tracking-tight uppercase">
    Scanner ready: {label}
  </h2>
  <p class="mt-1 text-sm text-cream/85">
    Copy the link and the PIN now — for security they are shown only once. Lost them? End this scanner and
    create a new one.
  </p>
  <div class="mt-5 space-y-4">
    <div>
      <label for="gate-link" class="text-sm font-semibold">
        Scanner link
      </label>
      <div class="mt-1.5 flex flex-col gap-2 sm:flex-row">
        <input
          id="gate-link"
          readonly
          value={url}
          class="min-h-11 w-full rounded-xl bg-white px-3 font-mono text-sm text-ink"
          data-copy-source
        />
        <button
          type="button"
          data-copy-button="gate-link"
          hidden
          class="min-h-11 shrink-0 rounded-full bg-terracotta px-5 text-sm font-semibold text-white hover:bg-terracotta-deep"
        >
          Copy link
        </button>
      </div>
    </div>
    <div>
      <p class="text-sm font-semibold" id="gate-pin-label">
        PIN
      </p>
      <p
        class="mt-1 font-mono text-4xl font-black tracking-[0.3em] tabular-nums"
        aria-labelledby="gate-pin-label"
        data-pin
      >
        {pin}
      </p>
    </div>
    <p class="text-xs text-cream/80">The link stops working {expiresText}.</p>
  </div>
  <OrganizerNotice kind="info" title="How to share" class="mt-5 text-ink">
    Send the link and the PIN in <strong>separate</strong> messages (for example the link by text, the PIN in
    person). On the phone at the door: open the link, type the PIN, allow the camera, and keep the page open.
    Five wrong PINs lock the link for 15 minutes.
  </OrganizerNotice>
  <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-copy-root]').forEach((root) => {
    const status = root.querySelector<HTMLElement>('[data-copy-status]');
    root.querySelectorAll<HTMLButtonElement>('[data-copy-button]').forEach((button) => {
      const input = root.querySelector<HTMLInputElement>(`#${button.dataset.copyButton}`);
      if (!input || !navigator.clipboard) return;
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(input.value);
          button.textContent = 'Copied';
          if (status) status.textContent = 'Scanner link copied.';
        } catch {
          input.select();
          if (status) status.textContent = 'Select the link and copy it.';
        }
      });
    });
  });
</script>
