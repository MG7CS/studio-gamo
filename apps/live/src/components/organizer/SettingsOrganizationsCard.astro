---
/** The organizations you belong to, with your role in each. Switching and managing happen on the Organization page. */
import Panel from '@studio-gamo/ui/components/ui/Panel.astro';
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import { ORGANIZATION_KIND_LABELS, type MembershipSummary } from '@gamo/domain';

interface Props {
  memberships: MembershipSummary[];
  activeId: string | null;
}
const { memberships, activeId } = Astro.props;
---

<Panel id="organizations" title="Your organizations">
  {memberships.length === 0 ? (
    <p class="text-[14px] text-ink">
      You are not part of an organization yet.{' '}
      <a class="font-semibold text-terracotta-deep underline" href="/organizer/start">
        Set one up
      </a>
      , or open an invitation link from your email.
    </p>
  ) : (
    <ul class="space-y-2">
      {memberships.map((m) => (
        <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-cream px-3 py-2.5 text-[14px]">
          <span class="min-w-0">
            <span class="block truncate font-semibold text-ink">{m.name}</span>
            <span class="block text-[12px] text-muted">
              {ORGANIZATION_KIND_LABELS[m.kind]}
              {m.verified ? ' · Verified by Gamo' : ' · Not verified yet'}
              {m.status === 'suspended' ? ' · Suspended' : ''}
              {m.organizationId === activeId ? ' · Open now' : ''}
            </span>
          </span>
          <Pill tone="neutral">{m.role === 'owner' ? 'Owner' : 'Member'}</Pill>
        </li>
      ))}
    </ul>
  )}
  {memberships.length > 0 && (
    <p class="mt-3 text-[13px] text-muted">
      Profile, members and invitations are on the{' '}
      <a class="font-semibold text-terracotta-deep underline" href="/organizer/organization">
        Organization
      </a>{' '}
      page.
    </p>
  )}
</Panel>
