---
/**
 * Left menu of the organizer area (desktop): brand, grouped navigation and the signed-in person's menu. It
 * collapses to an icon rail (`body[data-sidebar=collapsed]`, set by the shared sidebar script): labels stay in
 * the page for screen readers and show as tooltips. Tailwind only generates classes it can read literally, so
 * the collapsed variants are spelled out in full.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import Logo from '@studio-gamo/ui/components/Logo.astro';
import UserMenu from './UserMenu.astro';
import { ORGANIZER_NAV, type OrganizerNavKey } from '../../lib/organizer-nav';
import type { MembershipSummary, Organizer } from '@gamo/domain';

interface Props {
  current: OrganizerNavKey;
  organizer: Organizer;
  memberships: MembershipSummary[];
  active: MembershipSummary | null;
}
const { current, organizer, memberships, active } = Astro.props;
const groups = ['Menu', 'You'] as const;
---

<div
  id="organizer-sidebar"
  class="flex h-full flex-col rounded-2xl bg-white p-4 shadow-[0_1px_2px_rgba(24,24,27,0.05)] group-data-[sidebar=collapsed]/shell:p-1.5"
>
  <a
    href="/organizer"
    class="flex min-h-11 items-center gap-3 text-ink group-data-[sidebar=collapsed]/shell:justify-center"
    aria-label="Gamo Live organizer home"
    title="Gamo Live organizer home"
  >
    <span class="group-data-[sidebar=collapsed]/shell:hidden">
      <Logo program="Gamo Live" tone="onLight" class="text-ink" />
    </span>
    {/* The collapsed rail shows the mark in the brand orange (the favicon turns cream in a dark browser theme). */}
    <svg
      class="hidden h-8 w-8 text-terracotta-deep group-data-[sidebar=collapsed]/shell:block"
      viewBox="0 0 28 28"
      fill="none"
      aria-hidden="true"
    >
      <rect x="2" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.8" />
      <rect x="7.2" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.92" />
      <rect x="12.4" y="2.5" width="3.2" height="23" rx="1.6" fill="currentColor" />
      <rect x="17.6" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.92" />
      <rect x="22.8" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.8" />
    </svg>
  </a>
  <p class="mt-1 text-[12px] font-semibold uppercase tracking-wider text-muted group-data-[sidebar=collapsed]/shell:hidden">
    Organizer
  </p>
  <button
    type="button"
    hidden
    data-sidebar-toggle
    data-sidebar-key="live-organizer-sidebar"
    aria-controls="organizer-sidebar"
    aria-expanded="true"
    class="mt-3 hidden min-h-11 w-full items-center gap-3 rounded-xl px-3 text-[14px] font-semibold text-ink transition-colors hover:bg-sand/60 group-data-[sidebar=collapsed]/shell:justify-center group-data-[sidebar=collapsed]/shell:px-0 lg:flex"
  >
    <Icon name="menu" class="h-[18px] w-[18px] shrink-0" />
    <span data-sidebar-label class="group-data-[sidebar=collapsed]/shell:sr-only">
      Collapse menu
    </span>
  </button>
  <nav aria-label="Organizer" class="mt-3 flex-1 space-y-5 overflow-y-auto">
    {groups.map((group) => (
      <div>
        <p class="px-3 text-[12px] font-semibold uppercase tracking-wider text-muted group-data-[sidebar=collapsed]/shell:sr-only">
          {group}
        </p>
        <ul class="mt-2 space-y-1">
          {ORGANIZER_NAV.filter((i) => i.group === group).map((item) => (
            <li>
              <a
                href={item.href}
                title={item.label}
                aria-current={item.key === current ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center gap-3 rounded-xl px-3 text-[14px] font-semibold transition-colors group-data-[sidebar=collapsed]/shell:justify-center group-data-[sidebar=collapsed]/shell:px-0',
                  item.key === current
                    ? 'bg-terracotta/10 text-terracotta-deep'
                    : 'text-ink hover:bg-sand/60',
                ]}
              >
                <Icon name={item.icon} class="h-[18px] w-[18px] shrink-0" />
                <span class="group-data-[sidebar=collapsed]/shell:sr-only">{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
  <div class="mt-3 border-t border-sand pt-3">
    <UserMenu organizer={organizer} memberships={memberships} active={active} variant="sidebar" />
  </div>
</div>
