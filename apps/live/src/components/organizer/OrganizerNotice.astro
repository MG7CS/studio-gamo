---
/**
 * A message box for organizer and scanner pages. `kind` sets colour **and** a text prefix, so the
 * meaning never depends on colour alone. Errors use role="alert", success/info role="status".
 */
interface Props {
  kind: 'error' | 'success' | 'info';
  title?: string;
  class?: string;
}
const { kind, title, class: className } = Astro.props;
const styles = {
  error: 'bg-red-50 text-red-950 ring-red-300',
  success: 'bg-emerald-50 text-emerald-950 ring-emerald-300',
  info: 'bg-ivory text-ink ring-sand',
}[kind];
const prefix = { error: 'Problem', success: 'Done', info: 'Note' }[kind];
---

<div
  role={kind === 'error' ? 'alert' : 'status'}
  class:list={['rounded-2xl px-4 py-3 text-sm ring-1', styles, className]}
>
  <p class="font-bold">{title ? `${prefix}: ${title}` : `${prefix}:`}</p>
  <div class="mt-1 leading-relaxed">
    <slot />
  </div>
</div>
