---
/**
 * Owners: check each card order against the payment processor's records (ledger next to balance transactions). The
 * result lists every order with "Matches" or what differs; nothing is shown before the check is run.
 */
import Panel from '@studio-gamo/ui/components/ui/Panel.astro';
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import { formatCents } from '@gamo/domain';
import { RECONCILE_STATUS, type ReconcileResult } from '../../../lib/sales-page';

interface Props {
  isOwner: boolean;
  result: ReconcileResult | null;
}
const { isOwner, result } = Astro.props;
---

<Panel
  id="reconcile"
  title="Check against the payment processor"
  description="Compares each card order here with the payment processor’s records and records its processing cost once."
>
  {!isOwner ? (
    <p class="text-[13px] text-muted">Only an owner of the organization can run this check.</p>
  ) : (
    <>
      <form method="post">
        <input type="hidden" name="action" value="reconcile" />
        <Button type="submit" variant="secondary">
          Run the check
        </Button>
      </form>
      {result?.kind === 'error' && (
        <Notice tone="danger" class="mt-3">
          {result.notice}
        </Notice>
      )}
      {result?.kind === 'done' &&
        (result.lines.length === 0 ? (
          <p class="mt-3 text-[13px] text-muted">There are no card orders to check yet.</p>
        ) : (
          <ul class="mt-3 divide-y divide-sand">
            {result.lines.map((l) => {
              const s = RECONCILE_STATUS[l.status];
              return (
                <li class="flex flex-wrap items-start justify-between gap-2 py-2 text-[14px]">
                  <span>
                    <span class="font-mono">{l.reference}</span>
                    <span class="block text-[12px] text-muted">
                      Charged {formatCents(l.ledgerChargedCents)} here, {formatCents(l.stripeChargedCents)} at
                      the processor · refunded {formatCents(l.ledgerRefundedCents)} here,{' '}
                      {formatCents(l.stripeRefundedCents)} there
                      {l.processingCostCents != null
                        ? ` · processing ${formatCents(l.processingCostCents)}`
                        : ''}
                    </span>
                  </span>
                  <Pill tone={s.tone}>{s.label}</Pill>
                </li>
              );
            })}
          </ul>
        ))}
    </>
  )}
</Panel>
