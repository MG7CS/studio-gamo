---
/** A labelled checkbox with a short explanation, posting `value="yes"` when ticked. 44 px target. */
interface Props {
  name: string;
  checked?: boolean;
  disabled?: boolean;
  value?: string;
  error?: string;
  class?: string;
}
const { name, checked = false, disabled = false, value = 'yes', error, class: className } = Astro.props;
const errorId = `${name}-${value}-error`.replace(/[^A-Za-z0-9_-]/g, '');
---

<div class={className}>
  {/* The label's text is the slot (always given), which the rule cannot see. */}
  {/* eslint-disable-next-line astro/jsx-a11y/label-has-associated-control */}
  <label class="flex min-h-11 cursor-pointer items-start gap-3 text-[14px] leading-relaxed text-ink">
    <input
      type="checkbox"
      name={name}
      value={value}
      checked={checked}
      disabled={disabled}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={error ? errorId : undefined}
      class="mt-1 h-5 w-5 shrink-0 rounded border-ink/50 accent-terracotta"
    />
    <span>
      <slot />
    </span>
  </label>
  {error && (
    <p id={errorId} class="mt-1 text-[13px] font-semibold text-terracotta-deep">
      {error}
    </p>
  )}
</div>
