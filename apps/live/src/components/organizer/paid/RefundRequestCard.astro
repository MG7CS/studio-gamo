---
/**
 * A buyer's refund request waiting for a decision: the amount, the tickets and their reason. Approve refunds it to the
 * card they paid with (confirm first, with the real amount); Decline keeps the tickets valid, with an optional note
 * the buyer receives.
 */
import Panel from '@studio-gamo/ui/components/ui/Panel.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import ConfirmAction from '@studio-gamo/ui/components/ui/ConfirmAction.astro';
import SplitField from '@studio-gamo/ui/components/split/SplitField.astro';
import { formatCents, type RefundRow } from '@gamo/domain';
import { whenLabel } from '../../../lib/organizer-format';

interface Props {
  request: RefundRow;
  ticketLabels: Record<string, string>;
  timeZone: string;
}
const { request: r, ticketLabels, timeZone } = Astro.props;
const tickets = r.ticketIds.map((id) => ticketLabels[id] ?? 'A ticket');
---

<Panel
  id={`request-${r.id}`}
  title={`Refund request: ${formatCents(r.amountCents)}`}
  description={`Asked ${whenLabel(r.createdAt, timeZone)}`}
>
  <p class="text-[14px] text-ink">
    {tickets.length === 1 ? 'Ticket' : 'Tickets'}: {tickets.join('; ')}
  </p>
  {r.reason && (
    <p class="mt-1 text-[14px] text-ink">
      <span class="text-muted">Their reason (written by the buyer):</span>
      {r.reason}
    </p>
  )}
  <div class="mt-3 flex flex-wrap items-start gap-2">
    <ConfirmAction
      summaryLabel="Approve and refund…"
      confirmLabel={`Refund ${formatCents(r.amountCents)}`}
      actionValue="approve"
      class="open:basis-full"
    >
      {formatCents(r.amountCents)} goes back to the card they paid with (the final amount is checked again and
      never more than what remains). The {tickets.length === 1 ? 'ticket stops' : 'tickets stop'} working and
      the buyer is emailed.
      <Fragment slot="fields">
        <input type="hidden" name="refund" value={r.id} />
      </Fragment>
    </ConfirmAction>
    <details class="group open:basis-full">
      <summary class="inline-flex min-h-11 cursor-pointer list-none items-center rounded-full border border-ink/30 bg-white px-5 text-[13px] font-semibold text-ink hover:bg-sand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta [&::-webkit-details-marker]:hidden">
        Decline…
      </summary>
      <form method="post" class="mt-3 space-y-3 rounded-xl border border-line bg-cream/60 p-4">
        <input type="hidden" name="action" value="decline" />
        <input type="hidden" name="refund" value={r.id} />
        <SplitField
          id={`decline-${r.id}`}
          name="note"
          label="Note to the buyer (optional)"
          as="textarea"
          rows={2}
          maxlength={500}
          size="sm"
          hint="Their tickets keep working."
        />
        <Button type="submit" variant="secondary">
          Decline the request
        </Button>
      </form>
    </details>
  </div>
</Panel>
