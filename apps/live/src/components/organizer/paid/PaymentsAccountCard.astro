---
/**
 * The organization's Stripe account: ready or not, in plain words; connect it or continue onboarding (Stripe's own
 * pages), and check its status again. Card details and bank details are only ever entered on Stripe.
 */
import Panel from '@studio-gamo/ui/components/ui/Panel.astro';
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import FactRows from './FactRows.astro';
import type { PaymentsPageView } from '../../../lib/payments-page';
import { whenLabel } from '../../../lib/organizer-format';

interface Props {
  view: PaymentsPageView;
  timeZone: string;
}
const { view, timeZone } = Astro.props;
const { readiness, status } = view;
const org = status.org;
const modeB = status.flow === 'gamo_collects';
---

<Panel
  id="account"
  title={modeB ? 'Payout account' : 'Stripe account'}
  description={
    modeB
      ? 'Where Gamo sends what it holds for your organization.'
      : 'Where buyers’ card payments go. You enter your details on Stripe, never on Gamo.'
  }
>
  <Pill tone={readiness.ready ? 'success' : 'warning'} dot>
    {readiness.ready ? 'Ready' : 'Not ready'}
  </Pill>
  <p class="mt-2 text-[14px] leading-relaxed text-ink">{readiness.text}</p>
  {org?.connectedAccountId && (
    <FactRows
      class="mt-2"
      rows={[
        { label: 'Takes card payments', value: org.chargesEnabled ? 'Yes' : 'Not yet' },
        { label: 'Receives payouts', value: org.payoutsEnabled ? 'Yes' : 'Not yet' },
        { label: 'Details sent to Stripe', value: org.detailsSubmitted ? 'Yes' : 'Not yet' },
        ...(org.checkedAt ? [{ label: 'Last checked', value: whenLabel(org.checkedAt, timeZone) }] : []),
      ]}
    />
  )}
  <div class="mt-3 flex flex-wrap gap-2">
    {readiness.canConnect && (
      <form method="post">
        <input type="hidden" name="action" value="connect" />
        <Button type="submit">
          {org?.connectedAccountId
            ? 'Continue with Stripe'
            : modeB
              ? 'Add a payout account'
              : 'Connect a Stripe account'}
        </Button>
      </form>
    )}
    {org?.connectedAccountId && (
      <form method="post">
        <input type="hidden" name="action" value="check" />
        <Button type="submit" variant="secondary">
          Check status again
        </Button>
      </form>
    )}
  </div>
</Panel>
