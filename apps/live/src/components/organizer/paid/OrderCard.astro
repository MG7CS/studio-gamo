---
/** One order as its own card in the Orders list: who, which date, how many tickets, the total, status and how it was paid. */
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import { formatCents, type OrganizerOrderRow } from '@gamo/domain';
import { CHANNEL_LABELS, METHOD_LABELS, ORDER_STATUS_LABELS } from '../../../lib/orders-page';
import { whenLabel } from '../../../lib/organizer-format';

interface Props {
  order: OrganizerOrderRow;
  href: string;
  timeZone: string;
}
const { order: o, href, timeZone } = Astro.props;
const status = ORDER_STATUS_LABELS[o.status];
const who = o.buyerName || o.buyerEmail || 'No name given';
---

<a
  href={href}
  class="block rounded-2xl border border-line/60 bg-white p-4 shadow-[0_1px_2px_rgba(24,24,27,0.04)] hover:border-terracotta/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
>
  <span class="flex flex-wrap items-start justify-between gap-3">
    <span class="min-w-0">
      <span class="block truncate text-[15px] font-bold text-ink">{who}</span>
      {o.buyerName && o.buyerEmail && (
        <span class="block break-all text-[13px] text-muted">{o.buyerEmail}</span>
      )}
      <span class="mt-1 block text-[13px] text-muted">
        <span class="font-mono">{o.reference}</span> · {whenLabel(o.startsAt, timeZone)} · {o.tickets}
        {o.tickets === 1 ? ' ticket' : ' tickets'}
      </span>
      <span class="block text-[12px] text-muted">
        {CHANNEL_LABELS[o.channel]} · {METHOD_LABELS[o.paymentMethod]}
      </span>
    </span>
    <span class="flex flex-col items-end gap-1">
      <span class="text-[15px] font-bold tabular-nums text-ink">{formatCents(o.totalCents)}</span>
      <Pill tone={status.tone}>{status.label}</Pill>
      {o.disputed && <Pill tone="danger">Disputed</Pill>}
      {o.amountRefundedCents > 0 && o.status !== 'refunded' && (
        <span class="text-[12px] text-muted">{formatCents(o.amountRefundedCents)} refunded</span>
      )}
    </span>
  </span>
  <span class="sr-only">. Opens order {o.reference}.</span>
</a>
