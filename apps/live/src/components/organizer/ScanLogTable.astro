---
/** Scan log rows; offline conflicts get a "Mark reviewed" form. Holder shown as first name + initial. */
import type { ScanLogRow } from '@gamo/domain/scanner';
import { TONE_LABEL, toneOf } from '../../lib/scan-result-style';

interface Props {
  rows: ScanLogRow[];
  total: number;
}
const { rows, total } = Astro.props;
const label = (r: string) => r.replaceAll('_', ' ');
---

<div class="overflow-x-auto rounded-[20px] bg-white ring-1 ring-sand">
  <table class="w-full min-w-[760px] text-left text-sm">
    <caption class="px-4 pt-4 text-left text-base font-black text-ink uppercase">Scans ({total})</caption>
    <thead>
      <tr class="border-b border-sand text-xs tracking-wider text-muted uppercase">
        <th scope="col" class="px-4 py-3">
          Time
        </th>
        <th scope="col" class="px-4 py-3">
          Result
        </th>
        <th scope="col" class="px-4 py-3">
          Ticket
        </th>
        <th scope="col" class="px-4 py-3">
          Gate / device
        </th>
        <th scope="col" class="px-4 py-3">
          Notes
        </th>
      </tr>
    </thead>
    <tbody>
      {rows.length === 0 ? (
        <tr>
          <td colspan="5" class="px-4 py-4 text-muted">
            No scans match these filters.
          </td>
        </tr>
      ) : (
        rows.map((r) => (
          <tr class="border-b border-sand align-top last:border-0" data-scan-row={r.result}>
            <th scope="row" class="px-4 py-3 font-normal whitespace-nowrap">
              {r.atText}
            </th>
            <td class="px-4 py-3">
              <span class="font-semibold capitalize">
                {TONE_LABEL[toneOf(r.result)]}: {label(r.result)}
              </span>
              <span class="block text-xs text-muted">{r.direction === 'in' ? 'Entry' : 'Exit'}</span>
            </td>
            <td class="px-4 py-3">
              {r.holder ?? '—'}
              {r.category && <span class="block text-xs text-muted">{r.category}</span>}
            </td>
            <td class="px-4 py-3">
              {r.gate ?? '—'}
              <span class="block text-xs text-muted">{r.device}</span>
            </td>
            <td class="px-4 py-3">
              {r.offline && <span class="block text-xs font-semibold">Scanned offline</span>}
              {r.overrideReason && <span class="block text-xs">Override: {r.overrideReason}</span>}
              {r.conflict !== 'none' &&
                (r.reviewed ? (
                  <span class="block text-xs font-semibold">Conflict reviewed</span>
                ) : (
                  <form method="post" class="mt-1">
                    <input type="hidden" name="action" value="review" />
                    <input type="hidden" name="scan_id" value={r.id} />
                    <span class="block text-xs font-semibold text-terracotta-deep">
                      Also admitted on another scanner while offline
                    </span>
                    <button
                      type="submit"
                      class="mt-1 min-h-11 rounded-full px-4 text-xs font-semibold ring-1 ring-ink/40 hover:bg-sand"
                    >
                      Mark reviewed
                    </button>
                  </form>
                ))}
            </td>
          </tr>
        ))
      )}
    </tbody>
  </table>
</div>
