<section class="px-4 pb-20 sm:px-8" data-scanner><div class="mx-auto grid max-w-[1000px] gap-8 md:grid-cols-2">
  <div class="rounded-[32px] bg-charcoal p-8 text-cream"><p class="eyebrow text-gold">Door check-in</p><div class="my-8 grid aspect-square place-items-center rounded-3xl border-2 border-dashed border-cream/30"><div class="text-center"><p class="text-4xl">⌗</p><p class="mt-4 text-sm text-cream/70">Scan guest pass QR code or verify status below.</p></div></div><h2 class="text-xl font-semibold">Verify admission status</h2><div class="mt-5 flex flex-wrap gap-3"><button data-result="valid" type="button" class="rounded-full bg-cream px-4 py-3 text-sm font-semibold text-charcoal">Valid pass</button><button data-result="duplicate" type="button" class="rounded-full border border-cream/30 px-4 py-3 text-sm font-semibold">Already checked in</button><button data-result="invalid" type="button" class="rounded-full border border-cream/30 px-4 py-3 text-sm font-semibold">Invalid pass</button></div></div>
  <aside class="h-fit rounded-[28px] bg-white p-8 ring-1 ring-sand"><p class="eyebrow text-terracotta">Verification result</p><h2 class="mt-4 text-2xl font-semibold" data-result-title aria-live="polite">Ready to scan.</h2><p class="mt-4 text-ink-soft" data-result-body>Select or scan a guest pass to verify admission status.</p><p class="mt-8 border-t border-sand pt-5 text-sm text-ink-soft">Check-in uses event-scoped staff authorization, server validation, and replay protection across all doors.</p></aside>
</div></section>
<script>
  const messages = {valid:['Accepted pass','GL-2026-8410 · Grace Mensah. Verified for one admission.'],duplicate:['Duplicate scan','This pass was already checked in at Door 1. Please verify with event staff.'],invalid:['Unrecognized pass','This code is not valid for the selected event. Please refer the guest to the registration desk.']};
  document.querySelectorAll<HTMLElement>('[data-scanner]').forEach(root => root.querySelectorAll<HTMLButtonElement>('[data-result]').forEach(button => button.addEventListener('click', () => { const result = messages[button.dataset.result as keyof typeof messages]; root.querySelector('[data-result-title]')!.textContent=result[0]; root.querySelector('[data-result-body]')!.textContent=result[1]; })));
</script>
