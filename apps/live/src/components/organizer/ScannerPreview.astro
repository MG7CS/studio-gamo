---
<section class="px-4 pb-20 sm:px-8" data-scanner><div class="mx-auto grid max-w-[1000px] gap-8 md:grid-cols-2">
  <div class="rounded-[32px] bg-charcoal p-8 text-cream"><p class="eyebrow text-gold">Camera disconnected</p><div class="my-8 grid aspect-square place-items-center rounded-3xl border-2 border-dashed border-cream/30"><div class="text-center"><p class="text-4xl">⌗</p><p class="mt-4 text-sm text-cream/70">No camera or QR data is accessed.</p></div></div><h2 class="text-xl font-semibold">Simulate a ticket check</h2><div class="mt-5 flex flex-wrap gap-3"><button data-result="valid" type="button" class="rounded-full bg-cream px-4 py-3 text-sm font-semibold text-charcoal">Valid sample</button><button data-result="duplicate" type="button" class="rounded-full border border-cream/30 px-4 py-3 text-sm font-semibold">Already checked in</button><button data-result="invalid" type="button" class="rounded-full border border-cream/30 px-4 py-3 text-sm font-semibold">Invalid sample</button></div></div>
  <aside class="h-fit rounded-[28px] bg-white p-8 ring-1 ring-sand"><p class="eyebrow text-terracotta">Sample result</p><h2 class="mt-4 text-2xl font-semibold" data-result-title aria-live="polite">Waiting for a simulation.</h2><p class="mt-4 text-ink-soft" data-result-body>Choose a scenario. No admission is granted and no attendance is recorded.</p><p class="mt-8 border-t border-sand pt-5 text-sm text-ink-soft">Real check-in will require event-scoped staff authorization, server validation and replay protection. This demo cannot validate any ticket.</p></aside>
</div></section>
<script>
  const messages = {valid:['Sample accepted state','GL-SAMPLE-0000 · Sample Attendee. This would allow one admission after server validation. No real admission was granted.'],duplicate:['Sample duplicate state','This sample ticket was already checked in. Do not admit again; seek staff help.'],invalid:['Sample invalid state','This sample code is invalid for the event. No admission; refer the guest to staff.']};
  document.querySelectorAll<HTMLElement>('[data-scanner]').forEach(root => root.querySelectorAll<HTMLButtonElement>('[data-result]').forEach(button => button.addEventListener('click', () => { const result = messages[button.dataset.result as keyof typeof messages]; root.querySelector('[data-result-title]')!.textContent=result[0]; root.querySelector('[data-result-body]')!.textContent=result[1]; })));
</script>
