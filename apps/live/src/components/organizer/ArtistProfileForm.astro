<section class="bg-cream px-5 pb-20">
  <form id="artist-profile" class="mx-auto max-w-[1100px] space-y-5 border-t border-sand pt-8">
    <h2 class="text-2xl font-black uppercase">Create your artist profile</h2>
    <p class="max-w-2xl text-ink-soft">
      Tell us about your music and Christian ministry. New profiles start pending review. Representation,
      verification and bookings require separate authorization.
    </p>
    <div class="grid max-w-2xl gap-5 sm:grid-cols-2">
      <label>
        Artist or stage name
        <input name="stageName" required minlength="2" maxlength="120" />
      </label>
      <label>
        Musical genre
        <input name="genre" required minlength="2" maxlength="60" />
      </label>
      <label>
        Home city
        <input name="homeCity" maxlength="80" />
      </label>
      <label>
        Home state
        <input name="homeState" maxlength="40" />
      </label>
    </div>
    <label class="max-w-2xl">
      About your music<textarea name="bio" maxlength="2000" rows="4"></textarea>
    </label>
    <button type="submit" class="rounded-full bg-terracotta px-6 py-3 font-semibold text-white">
      Save artist profile
    </button>
    <p id="artist-feedback" role="status" aria-live="polite"></p>
  </form>
</section>
<style>
  label {
    display: block;
    font-weight: 600;
  }
  input,
  textarea {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    /* 3.3:1 against white (WCAG 1.4.11) */
    border: 1px solid color-mix(in srgb, var(--color-ink) 50%, transparent);
    border-radius: 0.75rem;
    padding: 0.8rem;
    background: white;
  }
  input:focus,
  textarea:focus {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 2px;
  }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#artist-profile');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const feedback = document.querySelector<HTMLElement>('#artist-feedback')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    button.disabled = true;
    feedback.textContent = 'Saving your profile…';
    try {
      const res = await fetch('/api/artists', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const body = await res.json();
      if (!res.ok) throw new Error(body.error?.message || 'Unable to save your profile.');
      feedback.textContent =
        'Your profile has been saved and is pending review. Reload this page to view it.';
      button.textContent = 'Profile saved';
    } catch (e) {
      feedback.textContent = e instanceof Error ? e.message : 'Connection problem. Please try again.';
      button.disabled = false;
    }
  });
</script>
