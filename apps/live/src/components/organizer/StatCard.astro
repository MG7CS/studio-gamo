---
/** One real number from the database, with a plain label. Never a placeholder. */
interface Props {
  label: string;
  value: number;
  hint?: string;
}
const { label, value, hint } = Astro.props;
---

<div class="rounded-3xl bg-white p-6 shadow-[0_1px_2px_rgba(24,24,27,0.05)]">
  <p class="text-[14px] font-semibold text-muted">{label}</p>
  <p class="mt-2 text-[40px] font-black leading-none tracking-[-0.03em] text-ink">
    {value.toLocaleString('en-US')}
  </p>
  {hint && <p class="mt-2 text-[13px] text-muted">{hint}</p>}
</div>
