---
/** One real number from the database, with a plain label. Never a placeholder. */
interface Props {
  label: string;
  value: number;
  hint?: string;
}
const { label, value, hint } = Astro.props;
---

<div class="rounded-2xl bg-white p-4 shadow-[0_1px_2px_rgba(24,24,27,0.05)]">
  <p class="text-[13px] font-semibold text-muted">{label}</p>
  <p class="mt-1.5 text-[28px] font-black leading-none tracking-[-0.03em] text-ink">
    {value.toLocaleString('en-US')}
  </p>
  {hint && <p class="mt-1.5 text-[12px] text-muted">{hint}</p>}
</div>
