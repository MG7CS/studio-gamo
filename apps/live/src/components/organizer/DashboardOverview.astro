---
/** Organizer dashboard: overview figures (labeled sample), event management table, quick actions. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { dateParts, events } from '../../data/events';
const mine = events.filter((e) => e.organizer === 'riverside-fellowship');
const pub = (id: string) => (id === 'saturday-worship-gathering' ? 'review' : 'published');
const stats = [['Upcoming events', String(mine.length)], ['Registrations', '128'], ['Checked in (last event)', '96'], ['Awaiting review', '1']];
const actions = [['plus', 'Create event', '/promote/create'], ['qr', 'Check in guests', '/organizer/scan'], ['clock', 'Review status', '/promote/status'], ['users', 'Public profile', '/organizers/riverside-fellowship']] as const;
---
<section class="bg-cream px-4 pb-20 sm:px-8">
  <div class="mx-auto max-w-[1320px] space-y-8">
    <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {stats.map(([l, v], i) => (
        <div class:list={['rounded-[24px] p-5', i === 0 ? 'bg-charcoal text-cream' : 'bg-white ring-1 ring-sand']}>
          <dt class="text-sm opacity-70">{l}</dt><dd class="mt-2 text-4xl font-bold tracking-tight">{v}</dd>
        </div>
      ))}
    </dl>
    <div class="grid gap-8 lg:grid-cols-[1fr_280px]">
      <div class="overflow-hidden rounded-[28px] bg-white ring-1 ring-sand">
        <h2 class="border-b border-sand px-6 py-5 text-xl font-semibold">Your events</h2>
        <ul class="divide-y divide-sand">
          {mine.map((e) => { const d = dateParts(e.date); return (
            <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center">
              <span class="w-14 shrink-0 text-center leading-none"><span class="block text-[11px] font-semibold uppercase text-terracotta">{d.month}</span><span class="block text-2xl font-bold">{d.day}</span></span>
              <span class="min-w-0 flex-1"><a href={`/events/${e.id}`} class="font-semibold hover:text-terracotta">{e.title}</a><span class="block text-sm text-ink-soft">{e.city}, {e.state} · {e.time}</span></span>
              <span class="flex flex-wrap gap-1.5">
                {e.status === 'canceled' ? <StatusPill kind="canceled">Canceled</StatusPill> : pub(e.id) === 'review' ? <StatusPill kind="pending">In review</StatusPill> : <StatusPill kind="success">Published</StatusPill>}
                <StatusPill kind={e.ticketing === 'free' ? 'free' : e.ticketing === 'external' ? 'external' : 'paid'}>{e.ticketing === 'free' ? 'Free' : e.ticketing === 'external' ? 'External' : 'Tickets'}</StatusPill>
              </span>
              <a href="/organizer/manage" class="text-sm font-semibold text-terracotta">Manage</a>
            </li>
          ); })}
        </ul>
      </div>
      <aside class="space-y-3">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-ink-soft">Quick actions</h2>
        {actions.map(([icon, l, h]) => <a href={h} class="flex items-center gap-3 rounded-2xl bg-white px-4 py-3.5 font-medium ring-1 ring-sand hover:ring-terracotta"><Icon name={icon} class="h-5 w-5 text-terracotta" />{l}</a>)}
      </aside>
    </div>
  </div>
</section>
