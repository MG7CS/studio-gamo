---
/**
 * Common frame of an organizer event page: header, tool tabs and either the page content or a
 * permission/availability message (`denied`). Exactly one <h1> (in PageHeader).
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../shared/PageHeader.astro';
import OrganizerEventNav from './OrganizerEventNav.astro';
import OrganizerNotice from './OrganizerNotice.astro';

interface Props {
  title: string;
  eventId: string;
  eventTitle?: string;
  current: 'overview' | 'orders' | 'scanners' | 'scans' | 'venue-map';
  lede?: string;
  denied?: string | null;
}
const { title, eventId, eventTitle, current, lede, denied } = Astro.props;
---

<Layout title={eventTitle ? `${title} — ${eventTitle}` : title} noindex>
  <PageHeader
    eyebrow={eventTitle ?? 'Event tools'}
    title={title}
    lede={lede}
    back={{ href: '/organizer', label: 'All events' }}
  />
  {!denied && <OrganizerEventNav eventId={eventId} current={current} />}
  <div class="mx-auto max-w-[1100px] space-y-8 px-4 py-8 sm:px-6 lg:px-8">
    {denied ? (
      <OrganizerNotice kind="error" title="Not available">
        {denied}
      </OrganizerNotice>
    ) : (
      <slot />
    )}
  </div>
</Layout>
