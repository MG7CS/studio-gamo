---
/** The chosen day of the schedule: the events on it, each a link to the event on that date. */
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import type { OrganizationScheduleView } from '@gamo/domain';
import Panel from '@studio-gamo/ui/components/ui/Panel.astro';

interface Props {
  view: OrganizationScheduleView;
}
const { view } = Astro.props;
const pillFor = (i: OrganizationScheduleView['items'][number]) =>
  i.canceled
    ? ({ label: 'Canceled', tone: 'danger' } as const)
    : i.status !== 'published'
      ? ({ label: 'In review', tone: 'warning' } as const)
      : i.past
        ? ({ label: 'Past', tone: 'neutral' } as const)
        : ({ label: 'Upcoming', tone: 'info' } as const);
---

<Panel id="day">
  <h2 class="text-[16px] font-extrabold text-ink">{view.chosenLabel ?? 'Choose a day'}</h2>
  {view.items.length === 0 ? (
    <p class="mt-2 text-[14px] text-muted">
      {view.total === 0 ? 'Nothing is scheduled.' : 'Choose a day with a date in the calendar.'}
    </p>
  ) : (
    <ul class="mt-3 space-y-2">
      {view.items.map((i) => {
        const pill = pillFor(i);
        return (
          <li>
            <a
              href={i.href}
              class="block rounded-xl bg-cream/60 p-3 hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
            >
              <span class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-[14px] font-semibold text-ink">{i.title}</span>
                <Pill tone={pill.tone}>{pill.label}</Pill>
              </span>
              <span class="mt-0.5 block text-[13px] text-muted">
                {i.timeLabel}
                {i.confirmedPeople > 0 ? ` · ${i.confirmedPeople} registered` : ''}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</Panel>
