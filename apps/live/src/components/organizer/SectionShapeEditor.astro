---
/**
 * Drawing island for section shapes: choose a section, then click on the blueprint to add points
 * (or type X/Y and press "Add point" — the keyboard alternative). Points go into that section's
 * "Shape" field, which also works by hand without JavaScript. Save with the section's own button.
 */
import type { EditorSection, VenueMapRecord } from '@gamo/domain/scanner';

interface Props {
  map: VenueMapRecord;
  sections: EditorSection[];
  /** Form ids by section id ('new' for the add form). */
  formIds: Record<string, string>;
}
const { map, sections, formIds } = Astro.props;
const pts = (p: Array<[number, number]>) => p.map(([x, y]) => `${x},${y}`).join(' ');
---

<section
  aria-labelledby="draw-shapes"
  class="space-y-4 rounded-[24px] bg-white p-5 ring-1 ring-sand sm:p-7"
  data-shape-editor
  data-width={map.width}
  data-height={map.height}
>
  <h2 id="draw-shapes" class="text-xl font-black tracking-tight text-ink uppercase">
    Draw sections
  </h2>
  <div class="grid gap-4 lg:grid-cols-[1.5fr_1fr]">
    <div class="relative overflow-hidden rounded-2xl ring-1 ring-sand">
      <img
        src={map.url}
        alt={map.altText}
        width={map.width}
        height={map.height}
        class="block h-auto w-full"
        data-editor-image
      />
      <svg
        viewBox={`0 0 ${map.width} ${map.height}`}
        class="pointer-events-none absolute inset-0 size-full"
        aria-hidden="true"
        data-editor-overlay
      >
        {sections
          .filter((s) => s.points)
          .map((s) => (
            <g>
              <polygon
                points={pts(s.points!)}
                fill="rgba(179,78,36,0.25)"
                stroke="#8f3b18"
                stroke-width="3"
              />
              <text
                x={s.points![0]![0] + 6}
                y={s.points![0]![1] + 22}
                font-size="20"
                font-weight="700"
                fill="#18181b"
              >
                {s.code}
              </text>
            </g>
          ))}
        <polyline
          points=""
          fill="rgba(24,24,27,0.2)"
          stroke="#18181b"
          stroke-width="4"
          stroke-dasharray="10 5"
          data-editor-draft
        />
      </svg>
    </div>
    <div class="space-y-3" data-editor-tools hidden>
      <label class="block text-sm font-semibold" for="draw-target">
        Drawing the shape of
        <select
          id="draw-target"
          class="mt-1 min-h-11 w-full rounded-xl border border-ink/50 bg-white px-3 text-sm"
          data-editor-target
        >
          {sections.map((s) => (
            <option value={formIds[s.id]}>
              {s.name} ({s.code})
            </option>
          ))}
          <option value={formIds.new}>New section</option>
        </select>
      </label>
      <p class="text-sm text-muted">Click on the blueprint to add a corner. Or type a point:</p>
      <div class="grid grid-cols-2 gap-2">
        <label class="text-sm font-semibold" for="draw-x">
          X (0–{map.width})
          <input
            id="draw-x"
            type="number"
            min="0"
            max={map.width}
            step="any"
            class="mt-1 min-h-11 w-full rounded-xl border border-ink/50 px-3 text-sm"
            data-editor-x
          />
        </label>
        <label class="text-sm font-semibold" for="draw-y">
          Y (0–{map.height})
          <input
            id="draw-y"
            type="number"
            min="0"
            max={map.height}
            step="any"
            class="mt-1 min-h-11 w-full rounded-xl border border-ink/50 px-3 text-sm"
            data-editor-y
          />
        </label>
      </div>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class="min-h-11 rounded-full bg-ink px-4 text-sm font-semibold text-cream"
          data-editor-add
        >
          Add point
        </button>
        <button
          type="button"
          class="min-h-11 rounded-full px-4 text-sm font-semibold ring-1 ring-ink/40"
          data-editor-undo
        >
          Undo last point
        </button>
        <button
          type="button"
          class="min-h-11 rounded-full px-4 text-sm font-semibold ring-1 ring-ink/40"
          data-editor-clear
        >
          Clear shape
        </button>
      </div>
      <p class="text-sm" role="status" aria-live="polite" data-editor-status></p>
      <p class="text-xs text-muted">
        Then press “Save section” (or “Add section”) in that section’s form below.
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-shape-editor]').forEach((root) => {
    const width = Number(root.dataset.width);
    const height = Number(root.dataset.height);
    const image = root.querySelector<HTMLImageElement>('[data-editor-image]');
    const draft = root.querySelector<SVGPolylineElement>('[data-editor-draft]');
    const tools = root.querySelector<HTMLElement>('[data-editor-tools]');
    const target = root.querySelector<HTMLSelectElement>('[data-editor-target]');
    const status = root.querySelector<HTMLElement>('[data-editor-status]');
    const xIn = root.querySelector<HTMLInputElement>('[data-editor-x]');
    const yIn = root.querySelector<HTMLInputElement>('[data-editor-y]');
    if (!image || !draft || !tools || !target) return;
    tools.hidden = false;
    image.style.cursor = 'crosshair';
    const field = () => document.querySelector<HTMLTextAreaElement>(`#${target.value} [data-points-field]`);
    const points = () =>
      (field()?.value ?? '')
        .trim()
        .split(/\s+/)
        .filter(Boolean)
        .map((p) => p.split(',').map(Number) as [number, number])
        .filter((p) => p.length === 2 && p.every(Number.isFinite));
    const write = (list: Array<[number, number]>, message: string) => {
      const f = field();
      if (!f) return;
      f.value = list.map(([x, y]) => `${x},${y}`).join(' ');
      draft.setAttribute('points', f.value);
      if (status) status.textContent = message;
    };
    const add = (x: number, y: number) => {
      const px = Math.round(Math.min(width, Math.max(0, x)) * 10) / 10;
      const py = Math.round(Math.min(height, Math.max(0, y)) * 10) / 10;
      const list = [...points(), [px, py] as [number, number]];
      write(list, `Point ${list.length} added at ${px}, ${py}.`);
    };
    image.addEventListener('click', (ev) => {
      const rect = image.getBoundingClientRect();
      add(((ev.clientX - rect.left) / rect.width) * width, ((ev.clientY - rect.top) / rect.height) * height);
    });
    root.querySelector('[data-editor-add]')?.addEventListener('click', () => {
      if (!xIn?.value || !yIn?.value) {
        if (status) status.textContent = 'Type both X and Y first.';
        return;
      }
      add(Number(xIn.value), Number(yIn.value));
    });
    root.querySelector('[data-editor-undo]')?.addEventListener('click', () => {
      const list = points().slice(0, -1);
      write(list, `${list.length} points left.`);
    });
    root.querySelector('[data-editor-clear]')?.addEventListener('click', () => write([], 'Shape cleared.'));
    target.addEventListener('change', () => {
      draft.setAttribute('points', field()?.value ?? '');
      if (status) status.textContent = '';
    });
    draft.setAttribute('points', field()?.value ?? '');
  });
</script>
