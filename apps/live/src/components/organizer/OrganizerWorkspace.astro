---
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import { events, dateParts } from '../../data/events';
interface Props { view?: 'dashboard' | 'manage' | 'status' | 'verification' | 'report' | 'promotion' }
const { view = 'dashboard' } = Astro.props;
const e = events[0];
const states = [{label:'Event draft',body:'Saved in your organizer workspace.'},{label:'Organizer review',body:'Identity, Christian event eligibility and permission to publish are verified.'},{label:'Ticketing authority',body:'Written organizer authorization and approved policies are confirmed before ticket sales.'},{label:'Publishing',body:'Published to the Gamo Live directory once approved.'}];
---
<section class="px-4 pb-20 sm:px-8"><div class="mx-auto max-w-[1320px]">
  <nav aria-label="Organizer tools" class="mb-8 flex flex-wrap gap-2">{[['/organizer','Overview'],['/organizer/manage','Manage event'],['/organizer/verification','Review status'],['/organizer/report','Reports'],['/organizer/scan','Guest check-in']].map(([href,label]) => <a href={href} class="rounded-full border border-sand bg-white px-4 py-3 text-sm font-semibold hover:border-terracotta">{label}</a>)}</nav>
  {view === 'dashboard' ? <>
    <div class="grid gap-4 sm:grid-cols-3">{[['Active drafts','1'],['Published events','2'],['Issued tickets','128']].map(([label,value]) => <div class="rounded-[28px] bg-white p-6 ring-1 ring-sand"><p class="text-sm text-ink-soft">{label}</p><p class="mt-3 text-4xl font-semibold">{value}</p></div>)}</div>
    <div class="mt-8 grid overflow-hidden rounded-[32px] bg-white ring-1 ring-sand md:grid-cols-[1fr_2fr]"><Photo name={e.photo} sizes="(min-width:768px) 30vw, 100vw" class="h-full min-h-56 w-full object-cover"/><div class="p-6 sm:p-8"><StatusPill kind="info">Active event</StatusPill><h2 class="mt-4 text-3xl font-semibold">{e.title}</h2><p class="mt-3 text-ink-soft">{dateParts(e.date).long} · {e.city}, {e.state}</p><div class="mt-6 flex flex-wrap gap-3"><ButtonLink href="/organizer/manage" arrow>Manage event</ButtonLink><ButtonLink href="/promote/create" variant="secondary">Create another event</ButtonLink></div></div></div>
  </> : view === 'status' || view === 'verification' ? <>
    <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr]"><ol class="space-y-4">{states.map((s,i) => <li class="flex gap-4 rounded-[24px] bg-white p-6 ring-1 ring-sand"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-cream font-semibold">{i+1}</span><div><h2 class="font-semibold">{s.label}</h2><p class="mt-2 text-ink-soft">{s.body}</p></div></li>)}</ol><aside class="h-fit rounded-[28px] bg-charcoal p-8 text-cream"><p class="eyebrow text-gold">Organizer verification</p><h2 class="mt-4 text-2xl font-semibold">Trust comes before publishing.</h2><p class="mt-4 text-cream/75">Our team verifies ministry contact details and event eligibility before publishing listings to the community directory.</p><ButtonLink href="/organizer/preview" class="mt-6" arrow>View event page</ButtonLink></aside></div>
  </> : view === 'manage' ? <>
    <div class="grid gap-8 lg:grid-cols-[1.5fr_1fr]"><div class="rounded-[28px] bg-white p-8 ring-1 ring-sand"><StatusPill kind="pending">In review</StatusPill><h2 class="mt-5 text-3xl font-semibold">{e.title}</h2><dl class="mt-6 space-y-4">{[['Description',e.description],['Schedule',`${dateParts(e.date).long} · ${e.time}`],['Venue',`${e.venue}, ${e.city}, ${e.state}`],['Registration','Gamo ticketing with door check-in']].map(([label,body]) => <div class="border-t border-sand pt-4"><dt class="text-sm font-semibold">{label}</dt><dd class="mt-2 text-ink-soft">{body}</dd></div>)}</dl><div class="mt-8 flex flex-wrap gap-3"><ButtonLink href="/promote/create">Edit event details</ButtonLink><ButtonLink href="/organizer/preview" variant="secondary">View listing</ButtonLink></div></div><aside class="space-y-5"><div class="rounded-[28px] bg-charcoal p-6 text-cream"><h2 class="text-xl font-semibold">Publishing checklist</h2><p class="mt-3 text-cream/75">Organizer review, ticketing approval and cancellation policies are confirmed prior to launch.</p><ButtonLink href="/promote/status" class="mt-5">View review status</ButtonLink></div><div class="rounded-[28px] bg-white p-6 ring-1 ring-sand"><h2 class="text-xl font-semibold">Optional awareness support</h2><p class="mt-3 text-ink-soft">Choose outreach preferences. Any sponsored placement is always clearly labeled.</p><ButtonLink href="/organizer/promotion" class="mt-5" variant="secondary">Explore support options</ButtonLink></div></aside></div>
  </> : view === 'report' ? <>
    <div class="rounded-[28px] bg-white p-8 ring-1 ring-sand"><h2 class="text-2xl font-semibold">Attendance &amp; registration summary</h2><p class="mt-4 text-ink-soft">Track registrations, door check-ins, and awareness outreach for your gathering.</p><div class="mt-8 grid gap-5 sm:grid-cols-3">{[['Attendance','96 checked in'],['Registration & ticketing','128 registered'],['Awareness support','Regional digest']].map(([label, stat]) => <div class="rounded-2xl bg-cream p-5"><h3 class="font-semibold">{label}</h3><p class="mt-3 text-sm text-ink-soft">{stat}</p></div>)}</div><p class="mt-6 text-sm text-ink-soft">Reports always separate organizer proceeds, Gamo administrative allocations, processing costs, and refunds.</p></div>
  </> : <div class="max-w-3xl rounded-[28px] bg-white p-8 ring-1 ring-sand" data-promotion><h2 class="text-2xl font-semibold">Help people discover your gathering.</h2><p class="mt-4 text-ink-soft">Select optional outreach support for your event.</p><fieldset class="mt-6 space-y-4"><legend class="mb-4 font-semibold">Outreach interests</legend>{['Featured website placement (Sponsored label if funded)','Creative production','Community outreach','Partner communications'].map(label => <label class="flex items-start gap-3 rounded-2xl bg-cream p-4"><input class="mt-1 h-5 w-5 accent-terracotta" type="checkbox"/><span>{label}</span></label>)}</fieldset><p class="mt-6 text-sm text-ink-soft" aria-live="polite" data-interest-count>0 outreach interests selected.</p></div>}
</div></section>
<script>
  document.querySelectorAll<HTMLElement>('[data-promotion]').forEach(root => root.addEventListener('change', () => { root.querySelector('[data-interest-count]')!.textContent = `${root.querySelectorAll('input:checked').length} outreach interests selected.`; }));
</script>
