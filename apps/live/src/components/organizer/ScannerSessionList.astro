---
/** Existing gate sessions with state, devices, last seen and an "End scanner" form per active session. */
import type { ScannerSessionSummary } from '@gamo/domain/scanner';

interface Props {
  sessions: ScannerSessionSummary[];
  timeZone: string;
}
const { sessions, timeZone } = Astro.props;
const fmt = (s: number | null) =>
  s === null
    ? 'Never'
    : new Intl.DateTimeFormat('en-US', {
        timeZone,
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        timeZoneName: 'short',
      }).format(new Date(s * 1000));
const stateText = {
  active: 'Active',
  locked: 'Locked (wrong PINs)',
  expired: 'Ended (expired)',
  revoked: 'Ended by you',
};
const dirText = { in: 'Entry', out: 'Exit', both: 'Entry and exit' };
---

<section aria-labelledby="gate-list" class="rounded-[24px] bg-white p-5 ring-1 ring-sand sm:p-7">
  <h2 id="gate-list" class="text-xl font-black tracking-tight text-ink uppercase">
    Scanners for this event
  </h2>
  {sessions.length === 0 ? (
    <p class="mt-3 text-sm text-muted">No scanners yet. Create one above for each entrance.</p>
  ) : (
    <ul class="mt-4 divide-y divide-sand">
      {sessions.map((s) => (
        <li
          class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between"
          data-gate={s.label}
        >
          <div>
            <p class="font-semibold text-ink">
              {s.label}
              {s.canOverride && (
                <span class="ml-2 rounded-full bg-sand px-2 py-0.5 text-xs font-bold">Supervisor</span>
              )}
            </p>
            <p class="text-sm text-muted">
              {dirText[s.allowedDirections]} ·{' '}
              {s.allowedZones?.length ? `Zones ${s.allowedZones.join(', ')}` : 'All zones'} ·{' '}
              <span data-state>{stateText[s.state]}</span>
            </p>
            <p class="text-xs text-muted">
              {s.activeDevices} {s.activeDevices === 1 ? 'device' : 'devices'} · last seen {fmt(s.lastSeenAt)}{' '}
              · ends {fmt(s.expiresAt)}
            </p>
          </div>
          {(s.state === 'active' || s.state === 'locked') && (
            <form method="post">
              <input type="hidden" name="action" value="revoke" />
              <input type="hidden" name="session_id" value={s.id} />
              <button
                type="submit"
                class="min-h-11 rounded-full px-5 text-sm font-semibold text-terracotta-deep ring-1 ring-terracotta-deep hover:bg-terracotta-deep hover:text-white"
              >
                End scanner <span class="sr-only">{s.label}</span>
              </button>
            </form>
          )}
        </li>
      ))}
    </ul>
  )}
</section>
