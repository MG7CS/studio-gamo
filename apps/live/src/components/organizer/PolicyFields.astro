---
/**
 * Event policies (design §5.4) with the platform defaults shown and the bounds spelled out.
 * Field names are `policy.<field>`; errors come from `normalizeEventPolicy` and say what to change.
 */
import { EVENT_POLICY_BOUNDS, EVENT_POLICY_DEFAULTS } from '@gamo/domain/types';
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';
import SelectField from './SelectField.astro';

interface Props {
  values: Record<string, string>;
  errors: Record<string, string>;
}
const { values, errors } = Astro.props;
const d = EVENT_POLICY_DEFAULTS;
const v = (n: string, fallback: string) => values[`policy.${n}`] ?? fallback;
const err = (n: string) => errors[`policy.${n}`];
const B = EVENT_POLICY_BOUNDS;
const yesNo = [
  { value: 'true', label: 'Yes' },
  { value: 'false', label: 'No' },
];
const methods = (values['policy.doorSalesMethods'] ?? '').split(',');
---

<div class="grid gap-4 sm:grid-cols-2">
  <SelectField
    id="policy-refundPolicy"
    name="policy.refundPolicy"
    label="Refunds"
    value={v('refundPolicy', d.refundPolicy)}
    error={err('refundPolicy')}
    hint="Default: until 48 hours before the start."
    options={[
      { value: 'none', label: 'No refunds' },
      { value: 'until_start', label: 'Until the start' },
      { value: 'until_24h', label: 'Until 24 hours before' },
      { value: 'until_48h', label: 'Until 48 hours before' },
      { value: 'until_7d', label: 'Until 7 days before' },
      { value: 'organizer_discretion', label: 'Organizer decides' },
    ]}
  />
  <SelectField
    id="policy-transferAllowed"
    name="policy.transferAllowed"
    label="Allow transfers to another person"
    value={v('transferAllowed', String(d.transferAllowed))}
    error={err('transferAllowed')}
    hint="Tickets can never be resold."
    options={yesNo}
  />
  <TextField
    id="policy-transferCutoffHours"
    name="policy.transferCutoffHours"
    label="Transfers close (hours before the start)"
    inputmode="numeric"
    value={v('transferCutoffHours', String(d.transferCutoffHours))}
    error={err('transferCutoffHours')}
    hint={`${B.transferCutoffHours.min} to ${B.transferCutoffHours.max}`}
  />
  <TextField
    id="policy-maxTransfersPerTicket"
    name="policy.maxTransfersPerTicket"
    label="Transfers allowed per ticket"
    inputmode="numeric"
    value={v('maxTransfersPerTicket', String(d.maxTransfersPerTicket))}
    error={err('maxTransfersPerTicket')}
    hint={`${B.maxTransfersPerTicket.min} to ${B.maxTransfersPerTicket.max}`}
  />
  <SelectField
    id="policy-reentryAllowed"
    name="policy.reentryAllowed"
    label="Allow leaving and coming back in"
    value={v('reentryAllowed', String(d.reentryAllowed))}
    error={err('reentryAllowed')}
    options={yesNo}
  />
  <TextField
    id="policy-reentryLimit"
    name="policy.reentryLimit"
    label="Re-entries per day (empty = unlimited)"
    inputmode="numeric"
    value={v('reentryLimit', '')}
    error={err('reentryLimit')}
    hint={`${B.reentryLimit.min} to ${B.reentryLimit.max}`}
  />
  <SelectField
    id="policy-attendeeNamesRequired"
    name="policy.attendeeNamesRequired"
    label="Ask for a name on every ticket"
    value={v('attendeeNamesRequired', String(d.attendeeNamesRequired))}
    error={err('attendeeNamesRequired')}
    options={yesNo}
  />
  <TextField
    id="policy-maxTicketsPerOrder"
    name="policy.maxTicketsPerOrder"
    label="Most tickets in one order"
    inputmode="numeric"
    value={v('maxTicketsPerOrder', String(d.maxTicketsPerOrder))}
    error={err('maxTicketsPerOrder')}
    hint={`${B.maxTicketsPerOrder.min} to ${B.maxTicketsPerOrder.max}`}
  />
  <SelectField
    id="policy-agePolicy"
    name="policy.agePolicy"
    label="Age"
    value={v('agePolicy', d.agePolicy)}
    error={err('agePolicy')}
    options={[
      { value: 'all_ages', label: 'All ages' },
      { value: 'min_age', label: 'Minimum age (ID may be checked)' },
    ]}
  />
  <TextField
    id="policy-minAge"
    name="policy.minAge"
    label="Minimum age"
    inputmode="numeric"
    value={v('minAge', '')}
    error={err('minAge')}
    hint={`${B.minAge.min} to ${B.minAge.max}, only with a minimum age`}
  />
  <TextField
    id="policy-scanOpensMinutesBefore"
    name="policy.scanOpensMinutesBefore"
    label="Scanning opens (minutes before the start)"
    inputmode="numeric"
    value={v('scanOpensMinutesBefore', String(d.scanOpensMinutesBefore))}
    error={err('scanOpensMinutesBefore')}
    hint={`${B.scanOpensMinutesBefore.min} to ${B.scanOpensMinutesBefore.max}`}
  />
  <SelectField
    id="policy-doorSalesEnabled"
    name="policy.doorSalesEnabled"
    label="Door sales"
    value={v('doorSalesEnabled', String(d.doorSalesEnabled))}
    error={err('doorSalesEnabled')}
    hint="Card payments at the door are not available."
    options={yesNo}
  />
</div>
<fieldset class="mt-4">
  <legend class="text-[15px] font-semibold text-ink">Door sales methods</legend>
  {[
    ['free_issue', 'Issue free tickets'],
    ['cash_recorded', 'Record cash received'],
  ].map(([value, label]) => (
    <label class="flex min-h-11 items-center gap-3">
      <input
        type="checkbox"
        name="policy.doorSalesMethods"
        value={value}
        checked={methods.includes(value)}
        class="h-6 w-6 accent-terracotta"
      />
      <span>{label}</span>
    </label>
  ))}
  {err('doorSalesMethods') && (
    <p class="text-sm font-semibold text-terracotta-deep">
      <span class="sr-only">Error: </span>
      {err('doorSalesMethods')}
    </p>
  )}
</fieldset>
