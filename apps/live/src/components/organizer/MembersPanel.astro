---
/**
 * Members and invitations. Each member is a row (initial, name or email, role, joined date) with Leave or Remove on the
 * right; owners invite below, and the reason an invitation cannot be sent is said plainly. The only owner cannot
 * leave. Everyone here can create and edit events; only owners edit the profile and the members.
 */
import SplitField from '@studio-gamo/ui/components/split/SplitField.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import { inviteAvailability, isOnlyOwner, joinedLabel } from '@gamo/domain';
import type { InvitationView, MemberView } from '@gamo/domain';
import Panel from './Panel.astro';

interface Props {
  members: MemberView[];
  invitations: InvitationView[];
  isOwner: boolean;
  selfId: string;
  suspended: boolean;
  firstEventApproved: boolean;
  inviteError?: string;
}
const { members, invitations, isOwner, selfId, suspended, firstEventApproved, inviteError } = Astro.props;
const days = (expiresAt: number) => Math.max(1, Math.ceil((expiresAt * 1000 - Date.now()) / 86_400_000));
const invite = inviteAvailability({ suspended, firstEventApproved, openInvitations: invitations.length });
const soleOwner = isOnlyOwner(members, selfId);
---

<Panel
  id="members"
  title={`Members (${members.length})`}
  description="Everyone here can create and edit events. Only owners edit the profile and the members."
>
  <ul class="divide-y divide-sand">
    {members.map((m) => {
      const self = m.organizerId === selfId;
      const name = m.displayName ?? m.email;
      const canAct = !suspended && (isOwner || self);
      return (
        <li class="flex flex-wrap items-center gap-3 py-3">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-sand text-[13px] font-bold text-ink"
            aria-hidden="true"
          >
            {name.trim().charAt(0).toUpperCase()}
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex flex-wrap items-center gap-x-2 text-[14px] font-semibold text-ink">
              <span class="truncate">{name}</span>
              {self && <span class="text-[12px] font-medium text-muted">(you)</span>}
            </span>
            <span class="block truncate text-[12px] text-muted">
              {m.displayName ? m.email : joinedLabel(m.joinedAt)}
            </span>
            {m.displayName && <span class="block text-[12px] text-muted">{joinedLabel(m.joinedAt)}</span>}
          </span>
          <Pill tone={m.role === 'owner' ? 'info' : 'neutral'}>
            {m.role === 'owner' ? 'Owner' : 'Member'}
          </Pill>
          {canAct && !(self && soleOwner) && !(isOwner && !self && m.role === 'owner' && soleOwner) && (
            <form method="post">
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="member" value={m.organizerId} />
              <Button type="submit" variant="ghost" class="text-terracotta-deep">
                {self ? 'Leave' : 'Remove'}
                <span class="sr-only"> {name}</span>
              </Button>
            </form>
          )}
        </li>
      );
    })}
  </ul>
  {soleOwner && (
    <p class="mt-1 text-[12px] text-muted">
      You are the only owner, so you cannot leave. Make someone else an owner first (write to
      hello@gamostudio.org), or keep the organization as it is.
    </p>
  )}

  {isOwner && (
    <div class="mt-5 border-t border-sand pt-4">
      <h3 class="text-[14px] font-bold text-ink">Invite someone</h3>
      {invite.state === 'ready' ? (
        <form method="post" class="mt-2 flex flex-wrap items-start gap-2" novalidate>
          <input type="hidden" name="action" value="invite" />
          <SplitField
            id="invite-email"
            name="email"
            type="email"
            label="Their email address"
            size="sm"
            required
            error={inviteError}
            hint="They sign in with this address to accept."
            class="min-w-0 flex-1 basis-56"
          />
          <Button type="submit" class="mt-[1.65rem]">
            Send invitation
          </Button>
        </form>
      ) : (
        <p class="mt-1 text-[13px] leading-relaxed text-muted">{invite.message}</p>
      )}

      {invitations.length > 0 && (
        <div class="mt-4">
          <h3 class="text-[13px] font-bold text-ink">Waiting to accept ({invitations.length})</h3>
          <ul class="mt-1 divide-y divide-sand">
            {invitations.map((i) => (
              <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                <span class="min-w-0">
                  <span class="block truncate text-[14px] font-semibold text-ink">{i.email}</span>
                  <span class="text-[12px] text-muted">
                    Expires in {days(i.expiresAt)} {days(i.expiresAt) === 1 ? 'day' : 'days'}
                  </span>
                </span>
                <form method="post">
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="invitation" value={i.id} />
                  <Button type="submit" variant="ghost" class="text-terracotta-deep">
                    Remove<span class="sr-only"> invitation for {i.email}</span>
                  </Button>
                </form>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}
</Panel>
