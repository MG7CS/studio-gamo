---
/**
 * One section's form (create or edit). The `points` textarea ("x,y x,y …" in blueprint units) is the
 * plain-HTML way to set the shape; the editor island fills it from clicks or the numeric inputs.
 */
import type { EditorSection } from '@gamo/domain/scanner';
import { formatPoints } from '@gamo/domain/scanner';
import { formatMoneyInput } from '../../lib/organizer-pages';

interface Props {
  section?: EditorSection | null;
  categories: Array<{ id: string; name: string }>;
  formId: string;
  error?: { field: string; message: string } | null;
  map: { width: number; height: number } | null;
}
const { section = null, categories, formId, error = null, map } = Astro.props;
const field = (name: string) => `${formId}-${name}`;
const err = (name: string) => (error?.field === name ? error.message : null);
const input = 'mt-1 min-h-11 w-full rounded-xl border border-ink/50 bg-white px-3 text-sm';
const title = section ? `${section.name} (${section.code})` : 'Add a section';
---

<form
  method="post"
  id={formId}
  class="space-y-3 rounded-[20px] bg-white p-4 ring-1 ring-sand"
  data-section-form
>
  <input type="hidden" name="action" value="save_section" />
  {section && <input type="hidden" name="section_id" value={section.id} />}
  <h3 class="text-base font-black text-ink uppercase">{title}</h3>
  {section && (
    <p class="text-xs text-muted">
      {section.sold} sold · {section.reserved - section.sold} held · capacity {section.capacity}
    </p>
  )}
  {error && !['code', 'name', 'capacity', 'price', 'zone', 'points', 'category'].includes(error.field) && (
    <p class="text-sm font-semibold text-terracotta-deep">Error: {error.message}</p>
  )}
  <div class="grid gap-3 sm:grid-cols-2">
    <label class="text-sm font-semibold" for={field('name')}>
      Name
      <input
        id={field('name')}
        name="name"
        required
        maxlength="120"
        value={section?.name}
        class={input}
        aria-invalid={err('name') ? 'true' : undefined}
      />
    </label>
    <label class="text-sm font-semibold" for={field('code')}>
      Code
      <input
        id={field('code')}
        name="code"
        required
        maxlength="32"
        pattern="[A-Za-z0-9_-]{1,32}"
        value={section?.code}
        class={input}
        aria-invalid={err('code') ? 'true' : undefined}
        aria-describedby={err('code') ? field('code-error') : undefined}
      />
      {err('code') && (
        <span id={field('code-error')} class="block text-xs font-semibold text-terracotta-deep">
          Error: {err('code')}
        </span>
      )}
    </label>
    <label class="text-sm font-semibold" for={field('category')}>
      Ticket category
      <select id={field('category')} name="category" required class={input}>
        {categories.map((c) => (
          <option value={c.id} selected={section?.categoryId === c.id}>
            {c.name}
          </option>
        ))}
      </select>
      {err('category') && (
        <span class="block text-xs font-semibold text-terracotta-deep">Error: {err('category')}</span>
      )}
    </label>
    <label class="text-sm font-semibold" for={field('price')}>
      Price (empty = category price)
      <input
        id={field('price')}
        name="price"
        inputmode="decimal"
        value={formatMoneyInput(section?.priceCents ?? null)}
        placeholder="40.00"
        class={input}
      />
      {err('price') && (
        <span class="block text-xs font-semibold text-terracotta-deep">Error: {err('price')}</span>
      )}
    </label>
    <label class="text-sm font-semibold" for={field('capacity')}>
      Capacity
      <input
        id={field('capacity')}
        name="capacity"
        type="number"
        min="1"
        required
        value={section?.capacity}
        class={input}
        aria-invalid={err('capacity') ? 'true' : undefined}
        aria-describedby={err('capacity') ? field('capacity-error') : undefined}
      />
      {err('capacity') && (
        <span id={field('capacity-error')} class="block text-xs font-semibold text-terracotta-deep">
          Error: {err('capacity')}
        </span>
      )}
    </label>
    <label class="text-sm font-semibold" for={field('zone')}>
      Zone code (optional)
      <input
        id={field('zone')}
        name="zone"
        maxlength="32"
        value={section?.zoneCode ?? ''}
        placeholder="VIP"
        class={input}
      />
      {err('zone') && (
        <span class="block text-xs font-semibold text-terracotta-deep">Error: {err('zone')}</span>
      )}
    </label>
    <label class="text-sm font-semibold" for={field('gate')}>
      Gate (optional)
      <input
        id={field('gate')}
        name="gate"
        maxlength="60"
        value={section?.gateLabel ?? ''}
        placeholder="North door"
        class={input}
      />
    </label>
    <label class="text-sm font-semibold" for={field('status')}>
      Status
      <select id={field('status')} name="status" class={input}>
        <option value="active" selected={!section || section.status === 'active'}>
          On sale
        </option>
        <option value="hidden" selected={section?.status === 'hidden'}>
          Hidden
        </option>
        <option value="closed" selected={section?.status === 'closed'}>
          Closed
        </option>
      </select>
    </label>
  </div>
  <div class="flex flex-wrap gap-4">
    <label class="flex min-h-11 items-center gap-2 text-sm">
      <input
        type="checkbox"
        name="accessible"
        value="1"
        checked={section?.accessible}
        class="size-5 accent-terracotta"
      />{' '}
      Wheelchair accessible
    </label>
    <label class="flex min-h-11 items-center gap-2 text-sm">
      <input
        type="checkbox"
        name="companion"
        value="1"
        checked={section?.companionSeats}
        class="size-5 accent-terracotta"
      />{' '}
      Companion seats
    </label>
  </div>
  {map && (
    <label class="block text-sm font-semibold" for={field('points')}>
      Shape on the blueprint (x,y points; 0–{map.width} across, 0–{map.height} down)
      <textarea
        id={field('points')}
        name="points"
        rows="2"
        class={`${input} font-mono`}
        data-points-field
        aria-describedby={err('points') ? field('points-error') : undefined}
      >{formatPoints(section?.points ?? null)}</textarea>
      {err('points') && (
        <span id={field('points-error')} class="block text-xs font-semibold text-terracotta-deep">
          Error: {err('points')}
        </span>
      )}
    </label>
  )}
  <button
    type="submit"
    class="min-h-11 rounded-full bg-ink px-5 text-sm font-semibold text-cream hover:bg-terracotta-deep"
  >
    {section ? 'Save section' : 'Add section'}
  </button>
</form>
