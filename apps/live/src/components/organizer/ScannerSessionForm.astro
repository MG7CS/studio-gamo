---
/**
 * Create a gate session (door scanner link + PIN). Plain HTML form POST to the page; works without JS.
 * Props: zones — zone codes known for the event (offered as checkboxes); errors per field.
 */
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';

interface Props {
  zones: string[];
  error?: string | null;
  values?: { label?: string; directions?: string };
}
const { zones, error, values = {} } = Astro.props;
const directions = [
  ['in', 'Entry only'],
  ['out', 'Exit only'],
  ['both', 'Entry and exit'],
] as const;
const chosen = values.directions ?? 'both';
---

<section aria-labelledby="new-gate" class="rounded-[24px] bg-white p-5 ring-1 ring-sand sm:p-7">
  <h2 id="new-gate" class="text-xl font-black tracking-tight text-ink uppercase">
    New door scanner
  </h2>
  <p class="mt-1 max-w-2xl text-sm text-muted">
    Door staff need no account: give them the link and the 6-digit PIN. The link ends 6 hours after the event
    (at most 7 days), and you can end it any time below.
  </p>
  <form method="post" class="mt-5 space-y-5">
    <input type="hidden" name="action" value="create" />
    <TextField
      id="gate-label"
      name="label"
      label="Gate name"
      hint="Shown on the scanner and in the scan log, for example “North door” or “VIP lounge”."
      value={values.label}
      required
      maxlength={80}
      error={error ?? undefined}
    />
    <fieldset>
      <legend class="text-sm font-semibold text-ink">This scanner records</legend>
      <div class="mt-2 flex flex-wrap gap-3">
        {directions.map(([value, label]) => (
          <label class="inline-flex min-h-11 items-center gap-2 rounded-full bg-cream px-4 text-sm ring-1 ring-sand">
            <input
              type="radio"
              name="directions"
              value={value}
              checked={value === chosen}
              class="size-5 accent-terracotta"
            />
            {label}
          </label>
        ))}
      </div>
    </fieldset>
    {zones.length > 0 && (
      <fieldset>
        <legend class="text-sm font-semibold text-ink">Zones this gate admits</legend>
        <p class="text-xs text-muted">Leave all unticked to admit every ticket at this gate.</p>
        <div class="mt-2 flex flex-wrap gap-3">
          {zones.map((z) => (
            <label class="inline-flex min-h-11 items-center gap-2 rounded-full bg-cream px-4 text-sm ring-1 ring-sand">
              <input type="checkbox" name="zones" value={z} class="size-5 accent-terracotta" />
              {z}
            </label>
          ))}
        </div>
      </fieldset>
    )}
    <label class="flex min-h-11 items-start gap-3 text-sm text-ink">
      <input type="checkbox" name="can_override" value="1" class="mt-0.5 size-5 accent-terracotta" />
      <span>
        <span class="font-semibold">Supervisor</span> — may look up guests by name, email or order reference,
        admit with a written reason, and sell or issue tickets at the door (when door sales are on).
      </span>
    </label>
    <SubmitButton label="Create scanner link" pendingLabel="Creating…" />
  </form>
</section>
