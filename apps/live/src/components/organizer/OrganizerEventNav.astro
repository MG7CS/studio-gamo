---
/** Tabs between the organizer tools of one event. `current` marks the active tab (aria-current). */
interface Props {
  eventId: string;
  current: 'overview' | 'orders' | 'scanners' | 'scans' | 'venue-map';
}
const { eventId, current } = Astro.props;
const base = `/organizer/events/${encodeURIComponent(eventId)}`;
const tabs = [
  { key: 'overview', label: 'Overview', href: base },
  { key: 'orders', label: 'Orders & refunds', href: `${base}/orders` },
  { key: 'scanners', label: 'Door scanners', href: `${base}/scanners` },
  { key: 'scans', label: 'Scan log', href: `${base}/scans` },
  { key: 'venue-map', label: 'Venue map', href: `${base}/venue-map` },
] as const;
---

<nav aria-label="Event tools" class="border-b border-sand bg-white px-4 sm:px-6 lg:px-8">
  <ul class="mx-auto flex max-w-[1100px] gap-1 overflow-x-auto py-2">
    {tabs.map((t) => (
      <li>
        <a
          href={t.href}
          aria-current={t.key === current ? 'page' : undefined}
          class:list={[
            'inline-flex min-h-11 items-center whitespace-nowrap rounded-full px-4 text-sm font-semibold',
            t.key === current ? 'bg-ink text-cream' : 'text-ink hover:bg-sand focus-visible:bg-sand',
          ]}
        >
          {t.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
