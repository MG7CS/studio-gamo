---
/** One registration as its own floating card: who, which date, how many people, its status, and a confirmed cancel. */
import ConfirmAction from '@studio-gamo/ui/components/ui/ConfirmAction.astro';
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import { registrationStatus } from '../../lib/registrations-page';

interface Props {
  id: string;
  name: string;
  email: string;
  whenText: string;
  partySize: number;
  status: string;
  checkedInAt: number | null;
}
const { id, name, email, whenText, partySize, status, checkedInAt } = Astro.props;
const state = registrationStatus({ status, checkedInAt });
const canCancel = status === 'pending' || status === 'confirmed';
---

<div class="rounded-2xl border border-line/60 bg-white p-4 shadow-[0_1px_2px_rgba(24,24,27,0.04)]">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="truncate text-[15px] font-bold text-ink">{name}</p>
      <p class="break-all text-[13px] text-muted">{email}</p>
      <p class="mt-1 text-[13px] text-muted">
        {whenText} · {partySize} {partySize === 1 ? 'person' : 'people'}
      </p>
    </div>
    <Pill tone={state.tone}>{state.label}</Pill>
  </div>
  {canCancel && (
    <ConfirmAction
      class="mt-3"
      summaryLabel="Cancel registration…"
      confirmLabel="Cancel this registration"
      actionValue="cancel"
    >
      {name} is emailed and their {partySize === 1 ? 'seat is' : 'seats are'} free again.
      <input slot="fields" type="hidden" name="registration" value={id} />
    </ConfirmAction>
  )}
</div>
