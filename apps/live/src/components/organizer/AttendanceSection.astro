---
/**
 * Attendance: headcount, admissions per day and entries/exits per hour as an accessible table, with
 * a small decorative bar chart beside it (the table carries the data; the chart is aria-hidden).
 */
import StatTile from './StatTile.astro';
import type { AttendanceSummary } from '@gamo/domain/scanner';

interface Props {
  attendance: AttendanceSummary;
  exportHref: string;
}
const { attendance, exportHref } = Astro.props;
const peak = Math.max(1, ...attendance.hours.map((h) => Math.max(h.entries, h.exits)));
---

<section aria-labelledby="attendance" class="space-y-4">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 id="attendance" class="text-xl font-black tracking-tight text-ink uppercase">
      Attendance
    </h2>
    <a
      href={exportHref}
      class="inline-flex min-h-11 items-center rounded-full px-4 text-sm font-semibold text-ink ring-1 ring-ink/40 hover:bg-sand"
    >
      Download attendance (CSV)
    </a>
  </div>
  <div class="grid gap-3 sm:grid-cols-3">
    <StatTile label="Inside now" value={attendance.headcount.insideNow} />
    <StatTile
      label="Admitted today"
      value={attendance.headcount.admittedToday}
      hint={attendance.headcount.dayKey}
    />
    <StatTile label="Capacity" value={attendance.headcount.capacity} />
  </div>
  {attendance.days.length > 0 && (
    <div class="overflow-x-auto rounded-[20px] bg-white ring-1 ring-sand">
      <table class="w-full text-left text-sm">
        <caption class="px-4 pt-4 text-left text-base font-black text-ink uppercase">
          By day ({attendance.timeZone})
        </caption>
        <thead>
          <tr class="border-b border-sand text-xs tracking-wider text-muted uppercase">
            <th scope="col" class="px-4 py-3">
              Day
            </th>
            <th scope="col" class="px-4 py-3 text-right">
              People admitted
            </th>
            <th scope="col" class="px-4 py-3 text-right">
              Entries
            </th>
            <th scope="col" class="px-4 py-3 text-right">
              Exits
            </th>
          </tr>
        </thead>
        <tbody>
          {attendance.days.map((d) => (
            <tr class="border-b border-sand last:border-0">
              <th scope="row" class="px-4 py-3 font-semibold">
                {d.dayKey}
              </th>
              <td class="px-4 py-3 text-right tabular-nums">{d.admitted}</td>
              <td class="px-4 py-3 text-right tabular-nums">{d.entries}</td>
              <td class="px-4 py-3 text-right tabular-nums">{d.exits}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  {attendance.hours.length > 0 && (
    <div class="grid gap-4 rounded-[20px] bg-white p-4 ring-1 ring-sand lg:grid-cols-2">
      <table class="w-full text-left text-sm">
        <caption class="text-left text-base font-black text-ink uppercase">
          Entries and exits by hour, {attendance.dayKey}
        </caption>
        <thead>
          <tr class="border-b border-sand text-xs tracking-wider text-muted uppercase">
            <th scope="col" class="py-2">
              Hour
            </th>
            <th scope="col" class="py-2 text-right">
              Entries
            </th>
            <th scope="col" class="py-2 text-right">
              Exits
            </th>
          </tr>
        </thead>
        <tbody>
          {attendance.hours.map((h) => (
            <tr class="border-b border-sand last:border-0">
              <th scope="row" class="py-2 font-semibold">
                {h.hour}
              </th>
              <td class="py-2 text-right tabular-nums">{h.entries}</td>
              <td class="py-2 text-right tabular-nums">{h.exits}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div aria-hidden="true" class="flex items-end gap-2 border-b border-sand pt-6">
        {attendance.hours.map((h) => (
          <div class="flex flex-1 flex-col items-center gap-1">
            <div class="flex h-40 w-full items-end justify-center gap-0.5">
              <div
                class="w-1/2 rounded-t bg-terracotta"
                style={`height:${Math.round((h.entries / peak) * 100)}%`}
              />
              <div class="w-1/2 rounded-t bg-tan" style={`height:${Math.round((h.exits / peak) * 100)}%`} />
            </div>
            <span class="text-xs text-muted">{h.hour.slice(0, 2)}</span>
          </div>
        ))}
      </div>
      <p class="text-xs text-muted lg:col-start-2">
        <span class="mr-1 inline-block size-3 rounded-sm bg-terracotta align-middle" aria-hidden="true" />
        Entries
        <span class="mr-1 ml-3 inline-block size-3 rounded-sm bg-tan align-middle" aria-hidden="true" />
        Exits
      </p>
    </div>
  )}
</section>
