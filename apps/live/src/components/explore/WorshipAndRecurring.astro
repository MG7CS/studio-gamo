---
/** Worship gatherings (photo-led) beside Bible studies & recurring activities (text-led weekly cards). */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import EventPills from '../shared/EventPills.astro';
import EventCard from '../shared/EventCard.astro';
import { dateParts, type LiveEvent } from '../../data/events';
interface Props { worship: LiveEvent[]; recurring: LiveEvent[] }
const { worship, recurring } = Astro.props;
---
<section class="bg-ivory px-4 py-16 sm:px-8 lg:py-24" aria-labelledby="worship-title">
  <div class="mx-auto max-w-[1320px]">
    <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <h2 id="worship-title" class="section-heading text-balance">Worship gatherings <span class="text-terracotta">&amp; weekly fellowship.</span></h2>
      <p class="text-lg text-ink-soft">Nights of praise, seasonal services, and the Bible studies that meet every week.</p>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {worship.slice(0, 2).map((e, i) => {
        const d = dateParts(e.date);
        return (
          <article class:list={['group relative overflow-hidden rounded-[28px] bg-night text-cream', i === 0 ? 'md:col-span-2 aspect-[4/3] md:aspect-auto md:min-h-[420px]' : 'aspect-[4/5] md:aspect-auto']}>
            <Photo name={e.photo} sizes={i === 0 ? '(min-width:768px) 60vw, 100vw' : '(min-width:768px) 30vw, 100vw'} class="absolute inset-0 h-full w-full object-cover" alt="" />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-night/90 to-transparent p-5 pt-20 sm:p-6 sm:pt-24">
              <EventPills event={e} />
              <h3 class="mt-3 text-xl font-semibold sm:text-2xl"><a href={`/events/${e.id}`} class="after:absolute after:inset-0">{e.title}</a></h3>
              <p class="mt-1 text-sm text-cream/75">{d.weekday} {d.month} {d.day} · {e.city}, {e.state}</p>
            </div>
          </article>
        );
      })}
    </div>
    <div class="mt-14 flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-terracotta/10 text-terracotta"><Icon name="book" class="h-5 w-5" /></span>
      <h3 class="text-xl font-semibold">Bible studies &amp; recurring activities</h3>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {recurring.map((e) => <EventCard event={e} variant="compact" />)}
    </div>
  </div>
</section>
