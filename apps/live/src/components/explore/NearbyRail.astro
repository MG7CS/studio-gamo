---
/** "Upcoming near you" rail — light section balancing the dark hero. Location is a sample default. */
import ContentRail from '@studio-gamo/ui/components/ContentRail.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import EventCard from '../shared/EventCard.astro';
import type { LiveEvent } from '../../data/events';
interface Props { events: LiveEvent[] }
const { events } = Astro.props;
---
<section class="bg-cream px-4 section-space sm:px-8" aria-labelledby="nearby-title">
  <div class="mx-auto max-w-[1320px]">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <EditorialHeading id="nearby-title" eyebrow="Upcoming nearby" title="This month, close to home." lede="Showing a sample “Southeast” region. Location will only ever be used with your permission." />
      <ButtonLink href="/events" variant="secondary" arrow class="self-start lg:self-auto">Browse all events</ButtonLink>
    </div>
    <ContentRail label="Upcoming nearby sample events" class="mt-10">
      {events.map((e) => <div class="w-[72%] shrink-0 snap-start sm:w-[44%] lg:w-[23.5%]"><EventCard event={e} /></div>)}
    </ContentRail>
  </div>
</section>
