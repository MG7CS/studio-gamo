---
/**
 * The frame of a public list page (venues, artists, one artist): page width, the one <h1> with its one-line
 * description, optional breadcrumbs, and the content in the default slot.
 */
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import Breadcrumbs from '@studio-gamo/ui/components/ui/Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}
const { title, description, breadcrumbs } = Astro.props;
---

<div class="mx-auto max-w-[1340px] px-4 pb-16 pt-8 sm:px-6 lg:px-8">
  {breadcrumbs ? (
    <PageHeader title={title} description={description} class="mb-8">
      <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
    </PageHeader>
  ) : (
    <PageHeader title={title} description={description} class="mb-8" />
  )}
  <slot />
</div>
