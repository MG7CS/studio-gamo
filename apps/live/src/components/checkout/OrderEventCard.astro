---
/** The event an order or ticket is for: title, when, where, and one extra line (the order reference, a status). */
interface Props {
  title: string;
  whenLabel: string;
  venueLabel: string;
  extra?: string | null;
}
const { title, whenLabel, venueLabel, extra } = Astro.props;
---

<div class="rounded-2xl border border-tan bg-white px-4 py-3">
  <p class="text-[17px] font-bold leading-snug text-ink">{title}</p>
  <p class="mt-1 text-[14px] font-semibold text-ink">{whenLabel}</p>
  {venueLabel && <p class="text-[14px] text-muted">{venueLabel}</p>}
  {extra && <p class="mt-1.5 text-[13px] text-muted">{extra}</p>}
</div>
