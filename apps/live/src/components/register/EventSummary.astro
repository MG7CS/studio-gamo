---
/** Title, date, place and admission of the event a person is registering for. */
interface Props {
  title: string;
  whenLabel: string;
  venueLabel: string;
  organizerName: string;
  organizerVerified: boolean;
}
const { title, whenLabel, venueLabel, organizerName, organizerVerified } = Astro.props;
---

<div class="mb-6 rounded-2xl border border-sand bg-white px-5 py-4">
  <p class="text-[13px] font-semibold uppercase tracking-wider text-terracotta">Free registration</p>
  <p class="mt-1 text-[18px] font-bold leading-snug text-ink">{title}</p>
  <p class="mt-2 text-[14px] text-ink">{whenLabel}</p>
  <p class="text-[14px] text-muted">{venueLabel}</p>
  <p class="mt-2 text-[13px] text-muted">
    Organized by {organizerName} · {organizerVerified ? 'Verified organizer' : 'Not yet verified by Gamo'}
  </p>
</div>
