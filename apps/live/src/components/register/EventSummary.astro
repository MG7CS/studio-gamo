---
/** Which event a person is registering for: title, date (when there is only one), place and organizer. */
interface Props {
  title: string;
  /** Left out when the form asks for the date, so the same fact is not written twice. */
  whenLabel?: string;
  venueLabel: string;
  organizerName: string;
  organizerVerified: boolean;
}
const { title, whenLabel, venueLabel, organizerName, organizerVerified } = Astro.props;
---

<div class="mb-6 rounded-2xl border border-tan bg-white px-5 py-4">
  <p class="text-[18px] font-bold leading-snug text-ink">{title}</p>
  {whenLabel && <p class="mt-1.5 text-[14px] font-medium text-ink">{whenLabel}</p>}
  <p class:list={['text-[14px] text-muted', whenLabel ? '' : 'mt-1.5']}>{venueLabel}</p>
  <p class="mt-2 text-[13px] text-muted">
    Organized by {organizerName} · {organizerVerified ? 'Verified organizer' : 'Not yet verified by Gamo'}
  </p>
</div>
