---
/**
 * The guest registration form: date (only when there are several), name, email, number of people, consent.
 * Native controls and a plain POST; errors arrive from the server and are shown next to each field (the page
 * also lists them all at the top). Browser validation is off (`novalidate`) so the server's wording is the only one.
 */
import SplitField from '@studio-gamo/ui/components/split/SplitField.astro';
import SplitButton from '@studio-gamo/ui/components/split/SplitButton.astro';
import { partySelectMax } from '@gamo/domain';
import type { RegisterDateOption, RegisterField, RegisterFormValues } from '@gamo/domain';

interface Props {
  options: RegisterDateOption[];
  selectedOccurrenceId: string;
  maxParty: number;
  values: RegisterFormValues;
  errors: Partial<Record<RegisterField, string>>;
  termsUrl: string;
  privacyUrl: string;
}
const { options, selectedOccurrenceId, maxParty, values, errors, termsUrl, privacyUrl } = Astro.props;
const selected = options.find((o) => o.id === selectedOccurrenceId) ?? options[0];
const peopleMax = partySelectMax(maxParty, options);
const seatsText = (o: RegisterDateOption) =>
  o.seatsLeft == null
    ? ''
    : o.seatsLeft === 0
      ? ' · Full'
      : ` · ${o.seatsLeft} ${o.seatsLeft === 1 ? 'seat' : 'seats'} left`;
const link = 'font-semibold text-terracotta-deep underline';
---

<form method="post" class="space-y-5" novalidate>
  {options.length > 1 ? (
    <SplitField id="occurrence" name="occurrence" label="Date" as="select" required error={errors.occurrence}>
      {options.map((o) => (
        <option value={o.id} selected={o.id === selected?.id} disabled={o.seatsLeft === 0}>
          {o.label}
          {seatsText(o)}
        </option>
      ))}
    </SplitField>
  ) : (
    <input type="hidden" name="occurrence" value={options[0]?.id ?? ''} />
  )}
  <SplitField
    id="name"
    name="name"
    label="Your name"
    autocomplete="name"
    maxlength={100}
    required
    value={values.name}
    error={errors.name}
  />
  <SplitField
    id="email"
    name="email"
    type="email"
    inputmode="email"
    label="Email address"
    autocomplete="email"
    placeholder="you@example.org"
    required
    value={values.email}
    error={errors.email}
    hint="We email you a 6-digit code to confirm."
  />
  <SplitField
    id="partySize"
    name="partySize"
    label="Number of people"
    as="select"
    required
    error={errors.partySize}
  >
    {Array.from({ length: peopleMax }, (_, i) => i + 1).map((n) => (
      <option value={String(n)} selected={String(n) === values.partySize}>
        {n}
      </option>
    ))}
  </SplitField>
  <p class="text-[13px] leading-relaxed text-muted">
    We use your email to send your code and your registration link, and delete it 90 days after the event.
  </p>
  <div>
    <label class="flex min-h-11 items-start gap-3 text-[14px] leading-relaxed text-ink">
      <input
        id="consent"
        type="checkbox"
        name="consent"
        value="yes"
        checked={values.consent}
        required
        aria-invalid={errors.consent ? 'true' : undefined}
        aria-describedby={errors.consent ? 'consent-error' : undefined}
        class="mt-0.5 h-6 w-6 shrink-0 rounded border-ink/50 accent-terracotta-deep"
      />
      <span>
        I agree to the{' '}
        <a class={link} href={termsUrl} target="_blank" rel="noopener noreferrer">
          Site Terms<span class="sr-only"> (opens in a new tab)</span>
        </a>{' '}
        and have read the{' '}
        <a class={link} href={privacyUrl} target="_blank" rel="noopener noreferrer">
          Privacy Policy<span class="sr-only"> (opens in a new tab)</span>
        </a>{' '}
        (drafts, under legal review).
      </span>
    </label>
    {errors.consent && (
      <p id="consent-error" class="mt-1.5 text-[13px] font-semibold text-terracotta-deep">
        <span class="sr-only">Error: </span>
        {errors.consent}
      </p>
    )}
  </div>
  <SplitButton label="Email me a code" />
</form>
