---
/**
 * One event in a list: a typographic date block, the title (the whole card is the link), when and where, and a
 * plain label for how people get in. Canceled and past events are dimmed and say so in words. No photos, hearts or
 * hidden controls: nothing here needs JavaScript.
 */
import type { LiveEventWithDetails } from '@gamo/domain';
import {
  admissionLabel,
  categoryLabel,
  eventStateLabel,
  formatLocalEventSchedule,
  seatsLabel,
} from '@gamo/domain';
import DateBlock from './DateBlock.astro';

export interface Props {
  event: LiveEventWithDetails;
  /** Where to link; defaults to the event's own page. */
  href?: string;
}
const { event, href = `/events/${event.slug}` } = Astro.props;
const state = eventStateLabel(event);
const schedule = formatLocalEventSchedule(
  event.startDateLocal,
  event.startTimeLocal,
  event.timezone,
  event.startsAt,
);
const seats = state ? null : seatsLabel(event);
const place = `${event.venueName}, ${event.city}, ${event.state}`;
---

<li class="list-none">
  <article
    class:list={[
      'group relative flex h-full gap-4 rounded-2xl border border-sand bg-white p-4 transition-shadow focus-within:ring-2 focus-within:ring-terracotta hover:shadow-md sm:gap-5',
      state ? 'opacity-80' : '',
    ]}
  >
    <DateBlock date={event.startDateLocal} muted={Boolean(state)} />
    <div class="min-w-0 flex-1">
      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold text-muted">
        <span>{categoryLabel(event.category)}</span>
        {state && (
          <span
            class:list={[
              'rounded-full px-2 py-0.5',
              state === 'Canceled' ? 'bg-status-danger-soft text-status-danger' : 'bg-sand text-ink',
            ]}
          >
            {state}
          </span>
        )}
      </p>
      <h3 class="mt-1 text-lg font-bold leading-snug text-ink">
        <a href={href} class="outline-none after:absolute after:inset-0 after:rounded-2xl">
          {event.title}
        </a>
      </h3>
      <p class="mt-1 text-sm text-ink">
        {schedule.shortDateLabel} · {schedule.timeLabel}
      </p>
      <p class="text-sm text-muted">{place}</p>
      <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold text-terracotta-deep">
        <span>{admissionLabel(event)}</span>
        {seats && <span class="font-medium text-muted">{seats}</span>}
      </p>
    </div>
  </article>
</li>
