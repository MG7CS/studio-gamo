---
import type { LiveEventWithDetails } from '@gamo/domain';
import { isEventPast, isLocalWeekendDate } from '@gamo/domain';

export interface Props {
  event: LiveEventWithDetails;
  index?: number;
}

const { event, index = 0 } = Astro.props;

const STAGE_ATMOSPHERE_IMAGES = [
  '/images/optimized/worship-acoustic-worship-leader-stage-800w.webp',
  '/images/optimized/live-gospel-vocalists-concert-stage-800w.webp',
  '/images/optimized/worship-acoustic-worship-leader-stage-alt-800w.webp',
  '/images/optimized/live-worship-night-hands-raised-800w.webp',
  '/images/optimized/worship-gospel-worship-leader-golden-light-800w.webp',
  '/images/optimized/worship-worship-band-sanctuary-800w.webp',
];

const hasVerifiedArtwork = Boolean(event.artworkRightsVerified && event.artworkUrl);
const cardImage = hasVerifiedArtwork
  ? event.artworkUrl!
  : STAGE_ATMOSPHERE_IMAGES[index % STAGE_ATMOSPHERE_IMAGES.length];

const MONTH_SHORT = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

let badgeMonth: string;
let badgeDay: string;

if (event.startDateLocal && /^\d{4}-\d{2}-\d{2}$/.test(event.startDateLocal)) {
  const [, mStr, dStr] = event.startDateLocal.split('-');
  const mIdx = Number.parseInt(mStr, 10) - 1;
  badgeMonth = MONTH_SHORT[mIdx] || 'NOV';
  badgeDay = dStr;
} else {
  const dt = new Date(event.startsAt);
  badgeMonth = dt
    .toLocaleDateString('en-US', { month: 'short', timeZone: event.timezone || 'America/Phoenix' })
    .toUpperCase();
  badgeDay = dt.toLocaleDateString('en-US', {
    day: '2-digit',
    timeZone: event.timezone || 'America/Phoenix',
  });
}

const isPast = typeof event.isPast === 'boolean' ? event.isPast : isEventPast(event);
const isClosed = isPast || event.status === 'canceled';
const isWeekend = isLocalWeekendDate(event.startDateLocal, event.startsAt, event.timezone);
const isExternal =
  event.listingType === 'external_discovery' || event.externalOnly || event.admissionType === 'external';
const providerName = event.externalTicketProvider || 'Official Site';
const ctaLabel = isPast
  ? 'Past · Closed'
  : isExternal
    ? `Tickets at ${providerName}`
    : event.admissionType === 'free'
      ? 'Free RSVP'
      : 'View Details';

const disclosureText = isPast
  ? 'This event has already taken place and is closed.'
  : isExternal
    ? event.independentDisclosure || `Independent listing · Tickets sold by ${providerName}`
    : `Hosted by ${event.organizerName || 'Verified Organizer'}`;

const performerLine =
  event.performers && event.performers.length > 0
    ? event.performers.map((p) => p.displayName).join(', ')
    : null;
---

<article
  class={`group bg-white rounded-2xl border border-sand overflow-hidden shadow-[0_2px_8px_rgba(25,24,23,0.04)] hover:shadow-xl transition-all duration-300 flex flex-col justify-between ${isClosed ? 'opacity-85' : ''}`}
  data-event-card
  data-event-slug={event.slug}
  data-event-status={isPast ? 'past-closed' : event.status}
  data-category={event.category}
  data-metro={event.metroSlug || ''}
  data-start-date={event.startDateLocal || ''}
  data-weekend={isWeekend ? 'true' : 'false'}
  data-title={event.title}
  data-city={`${event.city}, ${event.state}`}
  title={disclosureText}
>
  <div>
    <!-- Visual Header -->
    <div class="relative aspect-[16/10] bg-ink overflow-hidden">
      <a href={`/events/${event.slug}`} class="block w-full h-full focus:outline-none">
        <img
          src={cardImage}
          alt={hasVerifiedArtwork ? `${event.title} event poster` : `Stage atmosphere for ${event.title}`}
          loading="lazy"
          decoding="async"
          width="800"
          height="500"
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/75 via-ink/10 to-transparent"></div>
      </a>

      <!-- Date Badge (top-left white rounded badge) -->
      <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm rounded-xl px-3 py-1.5 shadow-md text-center min-w-[50px] pointer-events-none">
        <div class="text-[10px] font-bold tracking-wider uppercase text-muted leading-none">{badgeMonth}</div>
        <div class="text-lg font-extrabold text-ink leading-tight mt-0.5">{badgeDay}</div>
      </div>

      <!-- Top-Right Image Heart Overlay Button -->
      <button
        type="button"
        class="favorite-event-btn absolute top-2 right-2 w-11 h-11 rounded-full flex items-center justify-center text-white/90 hover:text-white hover:bg-black/25 transition-colors focus:outline-none"
        data-favorite-btn
        data-event-slug={event.slug}
        data-event-title={event.title}
        aria-pressed="false"
        aria-label={`Save ${event.title}`}
      >
        <svg
          class="w-4 h-4 drop-shadow-sm"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
          />
        </svg>
      </button>

      <!-- Category & Past/Closed Pill (bottom-left/right) -->
      <div class="absolute bottom-2.5 left-3 right-3 flex items-center justify-between gap-2 pointer-events-none">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-ink/80 text-ivory backdrop-blur-sm capitalize">
          {event.category === 'worship'
            ? 'Worship Night'
            : event.category === 'concert'
              ? 'Concert'
              : event.category}
        </span>
        {isPast && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-muted/95 text-ivory border border-white/20 backdrop-blur-sm">
            Past · Closed
          </span>
        )}
      </div>
    </div>

    <!-- Card Body -->
    <div class="p-4 pb-3.5">
      <h3 class="font-bold text-ink text-[15.5px] leading-snug line-clamp-1 group-hover:text-terracotta transition-colors">
        <a href={`/events/${event.slug}`} class="focus:outline-none">
          {event.title}
        </a>
      </h3>

      {performerLine && <span class="sr-only">Performers: {performerLine}</span>}

      <div class="mt-2 flex items-start gap-2 text-[13px]">
        <svg
          class="w-4 h-4 text-muted shrink-0 mt-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
          />
        </svg>
        <div class="min-w-0 leading-snug">
          <p class="text-muted font-normal truncate">{event.venueName}</p>
          <p class="text-muted truncate">
            {event.city}, {event.state}
          </p>
        </div>
      </div>

      <span class="sr-only">{disclosureText}</span>
    </div>
  </div>

  <!-- Card Footer: External CTA + Save Heart -->
  <div class="px-4 py-3 border-t border-cream flex items-center justify-between gap-2 bg-white">
    {isClosed ? (
      <span
        class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-muted"
        data-past-closed-badge
      >
        <span>Past · Closed</span>
      </span>
    ) : isExternal && event.externalUrl ? (
      <a
        href={event.externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center gap-1.5 text-[13.5px] font-semibold text-terracotta hover:text-terracotta-deep transition-colors"
        aria-label={`${ctaLabel} for ${event.title} (opens external ticket provider in a new tab)`}
      >
        <span>{ctaLabel}</span>
        <svg
          class="w-3.5 h-3.5 text-terracotta"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
          />
        </svg>
      </a>
    ) : (
      <a
        href={`/events/${event.slug}`}
        class="inline-flex min-h-11 items-center gap-1 text-[13.5px] font-semibold text-terracotta hover:text-terracotta-deep transition-colors"
      >
        <span>{ctaLabel}</span>
      </a>
    )}

    <button
      type="button"
      class="favorite-event-btn inline-flex h-11 w-11 items-center justify-center rounded-full text-muted hover:text-terracotta hover:bg-cream transition-colors focus:outline-none focus:ring-2 focus:ring-terracotta/30"
      data-favorite-btn
      data-event-slug={event.slug}
      data-event-title={event.title}
      aria-pressed="false"
      aria-label={`Save ${event.title}`}
      title="Save event to your device"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
        />
      </svg>
    </button>
  </div>
</article>
