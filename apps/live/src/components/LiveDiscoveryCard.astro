---
/** Event card: photo on top, date badge, title, venue, one action and one save button. */
import type { LiveEventWithDetails } from '@gamo/domain';
import { isEventPast, isLocalWeekendDate } from '@gamo/domain';
import Icon from '@studio-gamo/ui/components/Icon.astro';

export interface Props {
  event: LiveEventWithDetails;
  index?: number;
}

const { event, index = 0 } = Astro.props;

const STAGE_ATMOSPHERE_IMAGES = [
  '/images/optimized/worship-acoustic-worship-leader-stage-800w.webp',
  '/images/optimized/live-gospel-vocalists-concert-stage-800w.webp',
  '/images/optimized/worship-acoustic-worship-leader-stage-alt-800w.webp',
  '/images/optimized/live-worship-night-hands-raised-800w.webp',
  '/images/optimized/worship-gospel-worship-leader-golden-light-800w.webp',
  '/images/optimized/worship-worship-band-sanctuary-800w.webp',
];

const hasVerifiedArtwork = Boolean(event.artworkRightsVerified && event.artworkUrl);
const cardImage = hasVerifiedArtwork
  ? event.artworkUrl!
  : STAGE_ATMOSPHERE_IMAGES[index % STAGE_ATMOSPHERE_IMAGES.length];

const MONTH_SHORT = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

let badgeMonth: string;
let badgeDay: string;

if (event.startDateLocal && /^\d{4}-\d{2}-\d{2}$/.test(event.startDateLocal)) {
  const [, mStr, dStr] = event.startDateLocal.split('-');
  const mIdx = Number.parseInt(mStr, 10) - 1;
  badgeMonth = MONTH_SHORT[mIdx] || '';
  badgeDay = dStr;
} else {
  const dt = new Date(event.startsAt);
  badgeMonth = dt
    .toLocaleDateString('en-US', { month: 'short', timeZone: event.timezone || 'America/Phoenix' })
    .toUpperCase();
  badgeDay = dt.toLocaleDateString('en-US', {
    day: '2-digit',
    timeZone: event.timezone || 'America/Phoenix',
  });
}

const isPast = typeof event.isPast === 'boolean' ? event.isPast : isEventPast(event);
const isClosed = isPast || event.status === 'canceled';
const isWeekend = isLocalWeekendDate(event.startDateLocal, event.startsAt, event.timezone);
const isExternal =
  event.listingType === 'external_discovery' || event.externalOnly || event.admissionType === 'external';
const providerName = event.externalTicketProvider || 'official site';
const ctaLabel = isExternal
  ? `Tickets at ${providerName}`
  : event.admissionType === 'free'
    ? 'Free · Details'
    : 'Details';

const disclosureText = isPast
  ? 'This event has taken place.'
  : isExternal
    ? event.independentDisclosure || `Independent listing · Tickets sold by ${providerName}`
    : event.organizerName
      ? `Organized by ${event.organizerName}`
      : '';

const categoryLabel =
  event.category === 'worship' ? 'Worship night' : event.category === 'concert' ? 'Concert' : event.category;

const performerLine =
  event.performers && event.performers.length > 0
    ? event.performers.map((p) => p.displayName).join(', ')
    : null;
---

<article
  class="group flex flex-col justify-between overflow-hidden rounded-[24px] border border-sand bg-white transition-shadow duration-300 hover:shadow-float"
  data-event-card
  data-event-slug={event.slug}
  data-event-status={isPast ? 'past-closed' : event.status}
  data-category={event.category}
  data-metro={event.metroSlug || ''}
  data-start-date={event.startDateLocal || ''}
  data-weekend={isWeekend ? 'true' : 'false'}
  data-title={event.title}
  data-city={`${event.city}, ${event.state}`}
>
  <div>
    {/* Photo first */}
    <div class="relative aspect-[16/10] overflow-hidden bg-ink">
      <a href={`/events/${event.slug}`} class="block h-full w-full" tabindex="-1" aria-hidden="true">
        <img
          src={cardImage}
          alt=""
          loading="lazy"
          decoding="async"
          width="800"
          height="500"
          class:list={[
            'h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105',
            isClosed && 'grayscale-[0.4]',
          ]}
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/5 to-transparent"
          aria-hidden="true"
        ></div>
      </a>

      <div class="pointer-events-none absolute left-3 top-3 min-w-[52px] rounded-xl bg-white/95 px-2.5 py-1.5 text-center shadow-md">
        <div class="text-[10px] font-bold uppercase leading-none tracking-wider text-muted">{badgeMonth}</div>
        <div class="mt-0.5 text-lg font-extrabold leading-tight text-ink">{badgeDay}</div>
      </div>

      <div class="pointer-events-none absolute bottom-2.5 left-3 right-3 flex items-center justify-between gap-2">
        <span class="inline-flex items-center rounded-full bg-ink/80 px-2.5 py-0.5 text-[11px] font-semibold capitalize text-ivory">
          {categoryLabel}
        </span>
        {isPast && (
          <span class="inline-flex items-center rounded-full bg-muted/95 px-2.5 py-0.5 text-[11px] font-bold text-ivory">
            Past · Closed
          </span>
        )}
      </div>
    </div>

    <div class="p-4 pb-3">
      <h3 class="text-[15px] font-bold leading-snug text-ink transition-colors group-hover:text-terracotta-deep">
        <a href={`/events/${event.slug}`} class="flex min-h-11 items-center">
          <span class="line-clamp-2">{event.title}</span>
        </a>
      </h3>
      {performerLine && <span class="sr-only">Performers: {performerLine}</span>}

      <div class="mt-2 flex items-start gap-2 text-[13px] text-muted">
        <Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={1.8} />
        <div class="min-w-0 leading-snug">
          <p class="truncate">{event.venueName}</p>
          <p class="truncate">
            {event.city}, {event.state}
          </p>
        </div>
      </div>

      {disclosureText && <span class="sr-only">{disclosureText}</span>}
    </div>
  </div>

  <div class="flex items-center justify-between gap-2 border-t border-cream px-4 py-2">
    {isClosed ? (
      <span
        class="inline-flex min-h-11 items-center text-[13px] font-semibold text-muted"
        data-past-closed-badge
      >
        Past · Closed
      </span>
    ) : isExternal && event.externalUrl ? (
      <a
        href={event.externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center gap-1.5 text-[13px] font-semibold text-terracotta-deep transition-colors hover:underline"
      >
        <span>{ctaLabel}</span>
        <Icon name="external" class="h-3.5 w-3.5" strokeWidth={2} />
        <span class="sr-only">for {event.title} (opens in a new tab)</span>
      </a>
    ) : (
      <a
        href={`/events/${event.slug}`}
        class="inline-flex min-h-11 items-center gap-1 text-[13px] font-semibold text-terracotta-deep transition-colors hover:underline"
      >
        <span>{ctaLabel}</span>
        <span class="sr-only">: {event.title}</span>
      </a>
    )}

    <button
      type="button"
      class="favorite-event-btn inline-flex h-11 w-11 items-center justify-center rounded-full text-muted transition-colors hover:bg-cream hover:text-terracotta-deep"
      data-favorite-btn
      data-event-slug={event.slug}
      data-event-title={event.title}
      aria-pressed="false"
      aria-label={`Save ${event.title}`}
    >
      <Icon name="heart" class="h-4 w-4" strokeWidth={1.8} />
    </button>
  </div>
</article>
