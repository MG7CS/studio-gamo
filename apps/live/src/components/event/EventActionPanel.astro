---
/**
 * The one place that says what a visitor can do about this event: just come, register, buy tickets from the
 * organizer, or nothing because it was canceled or has passed. Gamo Live never sells tickets and says so.
 */
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import type { EventPanel } from '@gamo/domain';

interface Props {
  panel: EventPanel;
  /** The event's own page address, offered as a plain link people can copy. */
  shareUrl: string;
  /** True when the event has more than one upcoming date, so "Full" must be about every date. */
  severalDates?: boolean;
}
const { panel, shareUrl, severalDates = false } = Astro.props;
---

<section aria-labelledby="event-action" class="rounded-2xl border border-tan bg-white p-5 sm:p-6">
  <h2 id="event-action" class="sr-only">
    Attend this event
  </h2>
  {panel.kind === 'canceled' && <Notice tone="danger" title="This event was canceled" />}
  {panel.kind === 'past' && <p class="text-lg font-bold text-ink">This event has taken place</p>}
  {panel.kind === 'free_open' && <p class="text-lg font-bold text-ink">Free. Just come.</p>}
  {panel.kind === 'register' && (
    <div class="flex flex-col gap-3">
      <p class="text-lg font-bold text-ink">Free. Register to save your seat.</p>
      {panel.full ? (
        <>
          <Button type="button" size="lg" disabled block>
            Full
          </Button>
          <p class="text-sm text-muted">
            {severalDates ? 'Every date is full' : 'Every seat is taken'}, so registration is closed. Check
            with the organizer if you hope to join anyway.
          </p>
        </>
      ) : (
        <>
          <Button href={panel.href} size="lg" block>
            Register
          </Button>
          {panel.seats && <p class="text-sm font-semibold text-muted">{panel.seats}</p>}
        </>
      )}
    </div>
  )}
  {panel.kind === 'external' && (
    <div class="flex flex-col gap-3">
      {panel.url ? (
        <>
          <Button href={panel.url} target="_blank" rel="noopener noreferrer" size="lg" block>
            {panel.provider ? `Tickets at ${panel.provider}` : 'Tickets from the organizer'}
            <span class="sr-only"> (opens in a new tab)</span>
          </Button>
          <p class="text-sm text-muted">Tickets are sold by the organizer. Gamo Live does not sell them.</p>
        </>
      ) : (
        <p class="text-sm text-muted">
          Tickets are sold by the organizer, who has not shared a ticket link yet. Gamo Live does not sell
          tickets.
        </p>
      )}
    </div>
  )}
  <p class="mt-4 text-sm">
    <a
      href={shareUrl}
      class="inline-flex min-h-11 items-center break-all font-semibold text-terracotta-deep underline underline-offset-4"
    >
      Link to this event
    </a>
  </p>
</section>
