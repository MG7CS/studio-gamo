---
/** One staff link: name, what it may do, state, last use and expiry; turning it off signs out every device. */
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import ConfirmAction from '@studio-gamo/ui/components/ui/ConfirmAction.astro';
import type { DoorTabLink } from '../../lib/door-tab';
type Props = DoorTabLink;
const { id, label, permissions, state, stateLabel, detail, canRevoke } = Astro.props;
const tone = { active: 'success', locked: 'warning', revoked: 'neutral', expired: 'neutral' } as const;
---

<div class="rounded-2xl bg-white p-4 shadow-[0_1px_2px_rgba(24,24,27,0.05)]">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <span class="min-w-0">
      <span class="block text-[15px] font-semibold text-ink">{label}</span>
      <span class="block text-[13px] text-muted">{permissions}</span>
      <span class="block text-[12px] text-muted">{detail}</span>
    </span>
    <Pill tone={tone[state]} dot>
      {stateLabel}
    </Pill>
  </div>
  {canRevoke && (
    <ConfirmAction
      summaryLabel={`Turn off ${label}`}
      confirmLabel="Turn off link"
      actionValue="revoke-link"
      class="mt-3"
    >
      The link and its PIN stop working at once, and every device signed in with it is signed out. This cannot
      be undone; create a new link if you need one.
      <Fragment slot="fields">
        <input type="hidden" name="link" value={id} />
      </Fragment>
    </ConfirmAction>
  )}
</div>
