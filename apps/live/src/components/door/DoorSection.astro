---
/** A titled group of floating cards on the Door tab (a heading, one line of context, then the cards). */
interface Props {
  id: string;
  title: string;
  description?: string;
}
const { id, title, description } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="mt-8 scroll-mt-6">
  <h2 id={`${id}-title`} class="text-[16px] font-extrabold tracking-[-0.01em] text-ink">
    {title}
  </h2>
  {description && <p class="mt-1 text-[13px] leading-relaxed text-muted">{description}</p>}
  <div class="mt-3 space-y-3">
    <slot />
  </div>
</section>
