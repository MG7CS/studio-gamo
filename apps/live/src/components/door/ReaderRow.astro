---
/** One paired reader with its status (asked from Stripe when the page loaded). Owners may remove it. */
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';
import ConfirmAction from '@studio-gamo/ui/components/ui/ConfirmAction.astro';
import type { DoorTabReader } from '../../lib/door-tab';
interface Props {
  reader: DoorTabReader;
  canRemove: boolean;
}
const { reader, canRemove } = Astro.props;
const tone = { online: 'success', offline: 'danger', unknown: 'neutral' } as const;
---

<div class="rounded-2xl bg-white p-4 shadow-[0_1px_2px_rgba(24,24,27,0.05)]">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <span class="min-w-0">
      <span class="block text-[15px] font-semibold text-ink">{reader.label}</span>
      <span class="block text-[12px] text-muted">
        {reader.lastSeen ? `Last seen ${reader.lastSeen}` : 'Not seen online yet'}
        {reader.stale && ' · status could not be checked just now'}
      </span>
    </span>
    <Pill tone={tone[reader.status]} dot>
      {reader.statusLabel}
    </Pill>
  </div>
  {canRemove && (
    <ConfirmAction
      summaryLabel={`Remove ${reader.label}`}
      confirmLabel="Remove reader"
      actionValue="remove-reader"
      class="mt-3"
    >
      The reader is unpaired from your organization at Stripe and can no longer take payments here. Pair it
      again with a new code to use it.
      <Fragment slot="fields">
        <input type="hidden" name="reader" value={reader.id} />
      </Fragment>
    </ConfirmAction>
  )}
</div>
