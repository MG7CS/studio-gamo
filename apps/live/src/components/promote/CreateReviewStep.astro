---
/** Review step: listing preview card + checklist + disabled submit. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
const checks = ['Title, type and description', 'Date, time and monthly recurrence', 'Venue and accessibility notes', 'Free registration selected'];
---
<div class="grid gap-6 md:grid-cols-[1fr_1fr]">
  <article class="overflow-hidden rounded-[24px] ring-1 ring-sand">
    <div class="aspect-[16/10]"><Photo name="worshipNight" sizes="(min-width:768px) 30vw, 100vw" class="h-full w-full object-cover" alt="" /></div>
    <div class="p-5">
      <div class="flex flex-wrap gap-1.5"><StatusPill kind="sample">Sample event</StatusPill><StatusPill kind="free">Free</StatusPill></div>
      <p class="mt-3 text-lg font-semibold">Saturday Night Worship</p>
      <p class="text-sm text-ink-soft">Sat, Nov 7 · 6:30 PM · Dallas, TX</p>
      <p class="mt-2 text-xs text-ink-soft">Listing preview — how guests would see it</p>
    </div>
  </article>
  <div>
    <ul class="space-y-3">{checks.map((c) => <li class="flex items-center gap-3 text-sm"><Icon name="check" class="h-5 w-5 text-emerald-700" />{c}</li>)}</ul>
    <p class="mt-6 rounded-2xl bg-cream p-4 text-sm text-ink-soft">After submitting, a reviewer would confirm the details before publishing. You would see the status on your dashboard.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <button type="button" disabled class="cursor-not-allowed rounded-full bg-charcoal/15 px-6 py-3 text-sm font-semibold text-charcoal/50">Submit for review (disabled)</button>
      <ButtonLink href="/promote/status" variant="secondary" arrow>See status preview</ButtonLink>
    </div>
  </div>
</div>
