---
/** Organizer commitments — editorial split with photo and principles. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
const items = [
  ['shield', 'Honest listings', 'Organizers are named on every event. Sponsored placement, if ever introduced, would always be labeled.'],
  ['ticket', 'Clear ticketing', 'Guests always see whether tickets come from Gamo Live or an external source.'],
  ['users', 'Open to all believers', 'Christian events nationwide, from any church tradition or community.'],
] as const;
---
<section class="bg-cream px-4 py-16 sm:px-8 lg:py-24">
  <div class="mx-auto grid max-w-[1320px] items-center gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div class="grid grid-cols-5 gap-4">
      <div class="col-span-3 aspect-[3/4] overflow-hidden rounded-[28px]"><Photo name="soundEngineer" sizes="(min-width:1024px) 28vw, 60vw" class="h-full w-full object-cover" alt="Sound engineer at a mixing desk during a service" /></div>
      <div class="col-span-2 mt-16 aspect-[3/5] overflow-hidden rounded-[120px_120px_28px_28px]"><Photo name="churchGoldenHour" sizes="(min-width:1024px) 18vw, 40vw" class="h-full w-full object-cover" alt="Church exterior at golden hour" /></div>
    </div>
    <div>
      <p class="eyebrow text-terracotta">Our commitments</p>
      <h2 class="section-heading mt-3 text-balance">Built for trust, <span class="text-terracotta">not for clicks.</span></h2>
      <ul class="mt-8 space-y-6">
        {items.map(([icon, t, b]) => (
          <li class="flex gap-4"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-terracotta/10 text-terracotta"><Icon name={icon} class="h-5 w-5" /></span><span><span class="block text-lg font-semibold">{t}</span><span class="text-ink-soft">{b}</span></span></li>
        ))}
      </ul>
    </div>
  </div>
</section>
