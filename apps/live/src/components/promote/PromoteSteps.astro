---
/** The four steps from "I have an event" to "people can find it", and what Gamo does at each. */
const steps = [
  { title: 'Create your account', body: 'Sign in with an emailed 6-digit code. No password to remember.' },
  {
    title: 'Set up your organization',
    body: 'Your church, ministry, band or group. People see who is behind every event.',
  },
  {
    title: 'List your event',
    body: 'Date, place, who is performing, and whether people can come freely, register, or buy tickets elsewhere.',
  },
  {
    title: 'Gamo reviews your first event',
    body: 'We check that it is a real Christian event. After the first one is approved, later events publish directly.',
  },
];
---

<ol class="grid gap-4 md:grid-cols-2">
  {steps.map((s, i) => (
    <li class="flex gap-4 rounded-3xl bg-white p-6">
      <span
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-terracotta text-[18px] font-black text-white"
        aria-hidden="true"
      >
        {i + 1}
      </span>
      <div>
        <h3 class="text-[18px] font-extrabold text-ink">{s.title}</h3>
        <p class="mt-1 text-[15px] leading-relaxed text-muted">{s.body}</p>
      </div>
    </li>
  ))}
</ol>
