---
/** How promoting works — numbered editorial path (not an icon grid), dark band for contrast. */
const steps = [
  ['Describe your event', 'Title, description, photos and the ministry hosting it.', '/promote/create'],
  ['Set the schedule', 'One-time or recurring — weekly studies, monthly worship nights.', '/promote/create'],
  ['Choose registration', 'Free, free with registration, Gamo ticketing, or link to your own tickets.', '/promote/create'],
  ['Review & approval', 'A person would review each listing for accuracy before it goes live.', '/promote/status'],
  ['Welcome guests', 'Track registrations and check guests in at the door.', '/organizer/scan'],
];
---
<section data-surface="dark" class="bg-charcoal px-4 py-16 text-cream sm:px-8 lg:py-24" aria-labelledby="how-title">
  <div class="mx-auto grid max-w-[1320px] gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="eyebrow text-gold">How it would work</p>
      <h2 id="how-title" class="section-heading mt-3 text-balance">From first draft to the front door.</h2>
      <p class="mt-4 max-w-md text-cream/70">Organizer fees and any Gamo administrative contribution are proposals still under review. Free events are intended to stay free to list.</p>
    </div>
    <ol class="divide-y divide-white/10 border-y border-white/10">
      {steps.map(([t, b, h], i) => (
        <li><a href={h} class="group grid grid-cols-[3rem_1fr] gap-4 py-6 sm:grid-cols-[4rem_1fr_auto] sm:items-center">
          <span class="text-3xl font-bold text-gold/80">0{i + 1}</span>
          <span><span class="block text-xl font-semibold group-hover:text-gold">{t}</span><span class="mt-1 block text-cream/65">{b}</span></span>
          <span class="hidden text-sm text-cream/50 sm:block">Preview →</span>
        </a></li>
      ))}
    </ol>
  </div>
</section>
