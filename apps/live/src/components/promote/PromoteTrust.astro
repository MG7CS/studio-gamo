---
/** One sentence on fairness, with the (draft) terms. */
import { siteUrl } from '@studio-gamo/ui/lib/sites';
---

<section class="mx-auto max-w-[1340px] px-4 py-10 sm:px-6 lg:px-8">
  <p class="max-w-3xl text-[15px] leading-relaxed text-muted">
    Listing is free, and payment, sponsorship or partnership never changes whether an event is approved or how
    events are ordered. Read the{' '}
    <a
      class="font-semibold text-terracotta-deep underline underline-offset-4"
      href={siteUrl('web', '/legal/organizer-terms')}
    >
      organizer terms
    </a>{' '}
    (draft, under legal review).
  </p>
</section>
