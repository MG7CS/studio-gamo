---
/** Standalone consumer event platform layout using configurable PLATFORM_BRAND. */
import '../app.css';
import BaseLayout from '@studio-gamo/ui/components/BaseLayout.astro';
import { resolvePlatformBrandConfig } from '@studio-gamo/ui/lib/brand';
import LiveHeader from '../components/LiveHeader.astro';
import LiveFooter from '../components/LiveFooter.astro';

interface Props {
  title?: string;
  description?: string;
  headerTheme?: 'light' | 'dark';
  bodyClass?: string;
  chrome?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'event';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  headerTheme = 'light',
  bodyClass = 'bg-cream text-charcoal',
  chrome = true,
  ogImage,
  ogType,
  noindex,
  jsonLd,
} = Astro.props;

const brand = await resolvePlatformBrandConfig(Astro.locals);
const pageTitle = title ? `${title} | ${brand.displayName}` : `${brand.displayName} · ${brand.tagline}`;
const pageDescription = description || brand.socialMetadata.defaultDescription;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  current="live"
  headerTheme={headerTheme}
  bodyClass={bodyClass}
  chrome={chrome}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <slot name="head" slot="head" />
  {chrome && <LiveHeader slot="header" />}
  <slot />
  {chrome && <LiveFooter slot="footer" />}
</BaseLayout>
