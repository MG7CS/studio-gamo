---
import Layout from '../layouts/Layout.astro';
import ArtistProfileForm from '../components/organizer/ArtistProfileForm.astro';
import { getDb } from '@gamo/db';
import { resolveAuth } from '@gamo/auth';
import {
  LiveService,
  getRuntimeEnv,
  formatLocalEventSchedule,
  type LiveEventWithDetails,
} from '@gamo/domain';

export const prerender = false;

const url = Astro.url;
const queryParam = (url.searchParams.get('q') || '').trim().toLowerCase();

function toArtistSlug(name: string): string {
  return name
    .toLowerCase()
    .trim()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-');
}

interface DirectoryArtistEntry {
  key: string;
  slug: string;
  stageName: string;
  roleLabel: string;
  genre: string | null;
  homeCity: string | null;
  homeState: string | null;
  isVerifiedProfile: boolean;
  upcomingEvents: LiveEventWithDetails[];
}

let directoryArtists: DirectoryArtistEntry[] = [];
let userArtistProfiles: Array<{
  id: string;
  stageName: string;
  genre: string;
  homeCity: string | null;
  homeState: string | null;
  verificationStatus: string;
}> = [];
let authUser: { id: string; email: string; displayName: string | null } | null = null;
let unavailable = false;

try {
  const env = await getRuntimeEnv(Astro);
  const db = getDb(env.DB);
  const liveService = new LiveService(db);
  await liveService.seedCatalogIfAllowed(env);

  if (env.SESSION_SECRET) {
    const auth = await resolveAuth(Astro.request, db, {
      secret: env.SESSION_SECRET,
      product: 'live',
      env,
    });
    if (auth) {
      authUser = auth.user;
      userArtistProfiles = await db.query.artistProfiles.findMany({
        where: (a, { eq }) => eq(a.userId, auth.user.id),
      });
    }
  }

  const [publishedEvents, verifiedProfiles] = await Promise.all([
    liveService.listDiscoverableEvents({ limit: 200 }),
    liveService.listArtists(),
  ]);

  const artistMap = new Map<string, DirectoryArtistEntry>();

  for (const prof of verifiedProfiles) {
    const normKey = prof.stageName.trim().toLowerCase();
    artistMap.set(normKey, {
      key: normKey,
      slug: toArtistSlug(prof.stageName),
      stageName: prof.stageName.trim(),
      roleLabel: prof.genre || 'Verified Artist',
      genre: prof.genre,
      homeCity: prof.homeCity ?? null,
      homeState: prof.homeState ?? null,
      isVerifiedProfile: true,
      upcomingEvents: [],
    });
  }

  for (const evt of publishedEvents) {
    for (const perf of evt.performers || []) {
      const name = perf.displayName.trim();
      if (!name) continue;
      const normKey = name.toLowerCase();
      const existing = artistMap.get(normKey);
      if (existing) {
        if (!existing.upcomingEvents.some((e) => e.id === evt.id)) {
          existing.upcomingEvents.push(evt);
        }
      } else {
        artistMap.set(normKey, {
          key: normKey,
          slug: toArtistSlug(name),
          stageName: name,
          roleLabel:
            perf.roleLabel === 'headliner'
              ? 'Headlining Artist'
              : perf.roleLabel === 'featured'
                ? 'Featured Artist'
                : 'Touring Artist',
          genre: evt.category === 'worship' ? 'Worship' : 'Christian & Gospel',
          homeCity: null,
          homeState: null,
          isVerifiedProfile: false,
          upcomingEvents: [evt],
        });
      }
    }
  }

  const allEntries = Array.from(artistMap.values()).sort(
    (a, b) => b.upcomingEvents.length - a.upcomingEvents.length || a.stageName.localeCompare(b.stageName),
  );

  directoryArtists = queryParam
    ? allEntries.filter(
        (artist) =>
          artist.stageName.toLowerCase().includes(queryParam) ||
          (artist.genre && artist.genre.toLowerCase().includes(queryParam)) ||
          artist.upcomingEvents.some(
            (e) =>
              e.title.toLowerCase().includes(queryParam) ||
              e.city.toLowerCase().includes(queryParam) ||
              e.venueName.toLowerCase().includes(queryParam),
          ),
      )
    : allEntries;
} catch {
  unavailable = true;
}
---

<Layout
  title="Artists & Lineups"
  description="Browse artists performing at upcoming Christian concerts and worship gatherings on Gamo Live, or onboard your artist profile."
>
  {/* Compact Operational Directory Header & Direct Onboarding Entry */}
  <section class="bg-ivory border-b border-sand pt-8 pb-7">
    <div class="max-w-[1340px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-terracotta mb-1.5">
            Artist Directory &amp; Onboarding
          </p>
          <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-ink uppercase">
            Artists on tour &amp; artist onboarding
          </h1>
          <p class="mt-1.5 text-sm sm:text-base text-muted max-w-2xl">
            Browse verified performers with upcoming U.S. concert dates, or register an artist profile for
            event representation.
            <span class="sr-only">Bring your music to the gathering.</span>
          </p>
        </div>

        {/* Direct Artist & Representative Onboarding Actions */}
        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          {authUser ? (
            <>
              <a
                href="#artist-onboarding"
                class="inline-flex items-center justify-center rounded-full bg-terracotta hover:bg-terracotta-deep text-white px-5 py-2.5 text-sm font-semibold transition-colors min-h-11"
              >
                {userArtistProfiles.length > 0 ? 'Manage artist profile' : 'Create artist profile'}
              </a>
              <a
                href="/workspaces"
                class="inline-flex items-center justify-center rounded-full border border-line bg-white hover:bg-cream text-ink px-5 py-2.5 text-sm font-semibold transition-colors min-h-11"
              >
                Open workspace
              </a>
            </>
          ) : (
            <>
              <a
                href="/account/signup?next=%2Fartists%23artist-onboarding"
                class="inline-flex items-center justify-center rounded-full bg-terracotta hover:bg-terracotta-deep text-white px-5 py-2.5 text-sm font-semibold transition-colors min-h-11"
              >
                Artist onboarding &rarr;
              </a>
              <a
                href="/account/signin?next=%2Fworkspaces"
                class="inline-flex items-center justify-center rounded-full border border-line bg-white hover:bg-cream text-ink px-5 py-2.5 text-sm font-semibold transition-colors min-h-11"
              >
                Agent &amp; manager sign in
              </a>
            </>
          )}
        </div>
      </div>

      {/* Search Filter Bar */}
      <form action="/artists" method="get" role="search" class="mt-6 flex flex-wrap items-center gap-3">
        <div class="relative flex-1 min-w-[240px] max-w-md">
          <label for="artist-search-q" class="sr-only">
            Filter artists by name, city, or tour
          </label>
          <input
            id="artist-search-q"
            name="q"
            type="search"
            value={url.searchParams.get('q') || ''}
            placeholder="Filter artists by name, city, or tour..."
            class="w-full rounded-full border border-ink/50 bg-white pl-10 pr-4 py-2.5 text-sm text-ink placeholder:text-muted focus:border-terracotta focus:outline-none min-h-11"
          />
          <svg
            class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
            />
          </svg>
        </div>
        <button
          type="submit"
          class="inline-flex min-h-11 items-center rounded-full bg-ink hover:bg-ink text-white px-5 py-2.5 text-sm font-semibold transition-colors cursor-pointer"
        >
          Filter
        </button>
        {queryParam && (
          <a href="/artists" class="text-sm font-semibold text-terracotta hover:underline px-2 py-1">
            Clear filter
          </a>
        )}
        <span class="ml-auto text-xs font-semibold text-muted">
          {directoryArtists.length} {directoryArtists.length === 1 ? 'artist' : 'artists'} listed
        </span>
      </form>
    </div>
  </section>

  {/* Active Artist Directory Grid */}
  <section class="max-w-[1340px] mx-auto px-4 sm:px-6 lg:px-8 py-10">
    {unavailable ? (
      <div class="rounded-2xl border border-sand bg-white p-8 text-center">
        <h2 class="text-lg font-bold text-ink">Artist directory temporarily unavailable</h2>
        <p class="mt-1 text-sm text-muted">Please refresh or browse upcoming events directly.</p>
        <a
          href="/events"
          class="mt-4 inline-flex items-center rounded-full bg-terracotta px-5 py-2.5 text-sm font-semibold text-white"
        >
          Browse events
        </a>
      </div>
    ) : directoryArtists.length === 0 ? (
      <div class="rounded-2xl border border-sand bg-white p-8 text-center">
        <h2 class="text-lg font-bold text-ink">No matching artists found</h2>
        <p class="mt-1 text-sm text-muted">No artists matched &ldquo;{url.searchParams.get('q')}&rdquo;.</p>
        <a
          href="/artists"
          class="mt-4 inline-flex items-center rounded-full bg-terracotta px-5 py-2.5 text-sm font-semibold text-white"
        >
          Show all artists
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {directoryArtists.map((artist) => (
          <article
            data-artist-card
            class="rounded-2xl border border-sand bg-white p-5 shadow-xs flex flex-col justify-between"
          >
            <div>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h2 class="text-lg font-extrabold text-ink leading-snug">
                    <a
                      href={`/artists/${artist.slug}`}
                      class="inline-flex min-h-11 items-center hover:text-terracotta transition-colors"
                    >
                      {artist.stageName}
                    </a>
                  </h2>
                  <p class="text-xs font-medium text-muted mt-0.5">
                    {artist.genre || artist.roleLabel}
                    {artist.homeCity && artist.homeState ? ` · ${artist.homeCity}, ${artist.homeState}` : ''}
                  </p>
                </div>
                <span class="shrink-0 inline-flex items-center rounded-full bg-cream border border-sand px-2.5 py-1 text-[11px] font-bold text-terracotta">
                  {artist.upcomingEvents.length}{' '}
                  {artist.upcomingEvents.length === 1 ? 'upcoming date' : 'upcoming dates'}
                </span>
              </div>

              {artist.upcomingEvents.length > 0 && (
                <ul class="mt-4 divide-y divide-cream border-t border-cream">
                  {artist.upcomingEvents.slice(0, 3).map((evt) => (
                    <li class="py-2.5 flex items-center justify-between gap-3 text-xs">
                      <div class="min-w-0">
                        <a
                          href={`/events/${evt.slug}`}
                          class="font-bold text-ink hover:text-terracotta transition-colors truncate block min-h-11 content-center"
                        >
                          {evt.title}
                        </a>
                        <p class="text-muted truncate mt-0.5">
                          {evt.city}, {evt.state} · {evt.venueName} ·{' '}
                          {
                            formatLocalEventSchedule(
                              evt.startDateLocal,
                              evt.startTimeLocal,
                              evt.timezone,
                              evt.startsAt,
                            ).shortDateLabel
                          }
                        </p>
                      </div>
                      <a
                        href={`/events/${evt.slug}`}
                        class="inline-flex min-h-11 items-center shrink-0 font-semibold text-terracotta hover:underline"
                      >
                        Tickets &rarr;
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="mt-4 pt-3 border-t border-cream flex items-center justify-between text-xs">
              <a
                href={`/artists/${artist.slug}`}
                class="inline-flex min-h-11 items-center font-semibold text-ink hover:text-terracotta transition-colors"
              >
                Artist profile &amp; dates ({artist.upcomingEvents.length}) &rarr;
              </a>
              <a
                href={`/events?metro=all&q=${encodeURIComponent(artist.stageName)}`}
                class="inline-flex min-h-11 items-center text-[11px] font-semibold text-muted hover:text-terracotta transition-colors"
              >
                Filter events
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  {/* Direct Artist Onboarding Section */}
  <section id="artist-onboarding" class="border-t border-sand bg-cream py-10">
    <div class="max-w-[1340px] mx-auto px-4 sm:px-6 lg:px-8">
      {authUser ? (
        <div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
              <h2 class="text-xl font-extrabold text-ink">Artist profile onboarding</h2>
              <p class="text-sm text-muted mt-0.5">
                Signed in as {authUser.email}. Manage or register artist profiles linked to your account.
              </p>
            </div>
            <a
              href="/workspaces"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-terracotta hover:underline"
            >
              Go to full workspace &rarr;
            </a>
          </div>

          {userArtistProfiles.length > 0 ? (
            <div class="rounded-2xl border border-sand bg-white p-6">
              <h3 class="text-base font-bold text-ink">Your registered artist profiles</h3>
              <ul class="mt-3 divide-y divide-cream">
                {userArtistProfiles.map((prof) => (
                  <li class="py-3 flex items-center justify-between text-sm">
                    <div>
                      <span class="font-bold text-ink">{prof.stageName}</span>
                      <span class="text-muted ml-2">
                        {prof.genre}
                        {prof.homeCity && prof.homeState ? ` · ${prof.homeCity}, ${prof.homeState}` : ''}
                      </span>
                    </div>
                    <span class="inline-flex items-center rounded-full bg-cream px-3 py-1 text-xs font-semibold text-ink">
                      {prof.verificationStatus}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <ArtistProfileForm />
          )}
        </div>
      ) : (
        <div class="rounded-2xl border border-sand bg-white p-6 sm:p-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <h2 class="text-lg sm:text-xl font-extrabold text-ink">
              Onboard as an artist or authorized representative
            </h2>
            <p class="mt-1 text-sm text-muted">
              Sign in or create an account to register an artist profile or manage authorized booking
              representation.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a
              href="/account/signup?next=%2Fartists%23artist-onboarding"
              class="inline-flex items-center justify-center rounded-full bg-terracotta hover:bg-terracotta-deep text-white px-5 py-2.5 text-sm font-semibold transition-colors min-h-11"
            >
              Create account
            </a>
            <a
              href="/account/signin?next=%2Fartists%23artist-onboarding"
              class="inline-flex items-center justify-center rounded-full border border-line bg-white hover:bg-cream text-ink px-5 py-2.5 text-sm font-semibold transition-colors min-h-11"
            >
              Sign in
            </a>
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
