---
import Layout from '../layouts/Layout.astro';
import DirectoryShell from '../components/directory/DirectoryShell.astro';
import ArtistCard from '../components/artists/ArtistCard.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import { readCatalog } from '../lib/public-catalog';

export const prerender = false;

const result = await readCatalog(Astro, (catalog) => catalog.listArtists());
if (!result.ok) Astro.response.status = 503;
const artists = result.ok ? result.data : [];
---

<Layout
  title="Artists"
  description="Artists, choirs and worship leaders with upcoming dates on Gamo Live."
  bodyClass="bg-ivory text-ink"
>
  <DirectoryShell title="Artists" description="Named on the lineup of an upcoming event.">
    {!result.ok ? (
      <Notice tone="warning" title="Artists are unavailable right now">
        Please try again in a moment.
      </Notice>
    ) : artists.length === 0 ? (
      <EmptyState
        title="No artists with upcoming events yet."
        text="An artist appears here once they are named on a published upcoming event."
      >
        <Button href="/events" variant="secondary">
          Browse events
        </Button>
      </EmptyState>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {artists.map((artist) => (
          <ArtistCard artist={artist} />
        ))}
      </ul>
    )}
  </DirectoryShell>
</Layout>
