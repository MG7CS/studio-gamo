---
import Layout from '../layouts/Layout.astro';
import Container from '../components/public/Container.astro';
import Surface from '../components/public/Surface.astro';
import SectionHeading from '../components/public/SectionHeading.astro';
import EmptyNotice from '../components/public/EmptyNotice.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import {
  LiveCatalog,
  getRuntimeEnv,
  formatLocalEventSchedule,
  type LiveEventWithDetails,
} from '@gamo/domain';
import { asSqlDatabase } from '@gamo/platform/db';

export const prerender = false;

const url = Astro.url;
const rawQuery = (url.searchParams.get('q') || '').trim();
const queryParam = rawQuery.toLowerCase();

function toArtistSlug(name: string): string {
  return name
    .toLowerCase()
    .trim()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-');
}

interface DirectoryArtistEntry {
  key: string;
  slug: string;
  stageName: string;
  roleLabel: string;
  genre: string | null;
  upcomingEvents: LiveEventWithDetails[];
}

let directoryArtists: DirectoryArtistEntry[] = [];
let unavailable = false;

try {
  const env = await getRuntimeEnv(Astro);
  const liveService = new LiveCatalog(asSqlDatabase(env.LIVE_DB));

  const [publishedEvents, verifiedProfiles] = await Promise.all([
    liveService.listDiscoverableEvents({ limit: 200 }),
    liveService.listArtists(),
  ]);

  const artistMap = new Map<string, DirectoryArtistEntry>();

  for (const prof of verifiedProfiles) {
    const normKey = prof.stageName.trim().toLowerCase();
    artistMap.set(normKey, {
      key: normKey,
      slug: toArtistSlug(prof.stageName),
      stageName: prof.stageName.trim(),
      roleLabel: 'Performer',
      genre: null,
      upcomingEvents: [],
    });
  }

  for (const evt of publishedEvents) {
    for (const perf of evt.performers || []) {
      const name = perf.displayName.trim();
      if (!name) continue;
      const normKey = name.toLowerCase();
      const existing = artistMap.get(normKey);
      if (existing) {
        if (!existing.upcomingEvents.some((e) => e.id === evt.id)) {
          existing.upcomingEvents.push(evt);
        }
      } else {
        artistMap.set(normKey, {
          key: normKey,
          slug: toArtistSlug(name),
          stageName: name,
          roleLabel:
            perf.roleLabel === 'headliner'
              ? 'Headliner'
              : perf.roleLabel === 'featured'
                ? 'Featured artist'
                : 'Touring artist',
          genre: evt.category === 'worship' ? 'Worship' : 'Christian and gospel',
          upcomingEvents: [evt],
        });
      }
    }
  }

  const allEntries = Array.from(artistMap.values()).sort(
    (a, b) => b.upcomingEvents.length - a.upcomingEvents.length || a.stageName.localeCompare(b.stageName),
  );

  directoryArtists = queryParam
    ? allEntries.filter(
        (artist) =>
          artist.stageName.toLowerCase().includes(queryParam) ||
          (artist.genre && artist.genre.toLowerCase().includes(queryParam)) ||
          artist.upcomingEvents.some(
            (e) =>
              e.title.toLowerCase().includes(queryParam) ||
              e.city.toLowerCase().includes(queryParam) ||
              e.venueName.toLowerCase().includes(queryParam),
          ),
      )
    : allEntries;
} catch {
  unavailable = true;
}

const countLine = `${directoryArtists.length} ${directoryArtists.length === 1 ? 'artist' : 'artists'}${rawQuery ? ` matching "${rawQuery}"` : ' with upcoming dates'}`;
---

<Layout
  title="Artists"
  description="Artists performing at upcoming Christian concerts and worship nights on Gamo Live."
>
  <Container as="section" class="pb-6 pt-4 sm:pt-5">
    <SectionHeading
      level={1}
      size="page"
      eyebrow="Artists"
      title="Artists on tour"
      lede="Performers with upcoming dates on Gamo Live. Artists and agents can get in touch to be represented."
    >
      <ButtonLink slot="actions" href={inquiryUrl('Artist or agent interest')} arrow class="w-full sm:w-auto">
        Artists and agents: contact us
      </ButtonLink>
    </SectionHeading>

    <Surface class="mt-6" padding="none">
      <form
        action="/artists"
        method="get"
        role="search"
        class="flex flex-col gap-2.5 p-3 sm:flex-row sm:items-center sm:p-4"
      >
        <div class="flex flex-1 items-center gap-3 rounded-2xl border border-sand bg-ivory px-4 transition-colors focus-within:border-terracotta">
          <Icon name="search" class="h-5 w-5 shrink-0 text-ink" strokeWidth={2} />
          <label for="artist-search-q" class="sr-only">
            Search artists by name, city or event
          </label>
          <input
            id="artist-search-q"
            name="q"
            type="search"
            value={rawQuery}
            placeholder="Search artists by name, city or event"
            class="min-h-12 w-full bg-transparent text-[15px] text-ink placeholder:text-muted focus:outline-none"
          />
        </div>
        <button
          type="submit"
          class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-2xl bg-ink px-5 text-[15px] font-semibold text-white transition-colors hover:bg-terracotta-deep"
        >
          Search
        </button>
        {queryParam && (
          <a
            href="/artists"
            class="inline-flex min-h-11 items-center justify-center px-2 text-sm font-semibold text-terracotta-deep hover:underline"
          >
            Clear
          </a>
        )}
      </form>
    </Surface>

    <p class="mb-4 mt-6 text-sm text-muted">{countLine}</p>

    {unavailable ? (
      <EmptyNotice
        title="Artists could not be loaded"
        body="Please refresh or browse events instead."
        primary={{ href: '/events', label: 'All events' }}
      />
    ) : directoryArtists.length === 0 ? (
      <EmptyNotice
        title={queryParam ? 'No artists match that search' : 'No artists listed yet'}
        body={
          queryParam
            ? 'Try another name, city or event.'
            : 'Artists appear here once they have an upcoming event on Gamo Live.'
        }
        primary={
          queryParam ? { href: '/artists', label: 'All artists' } : { href: '/events', label: 'All events' }
        }
      />
    ) : (
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {directoryArtists.map((artist) => (
          <article
            data-artist-card
            class="flex flex-col justify-between rounded-[24px] border border-sand bg-white p-5 sm:p-6"
          >
            <div>
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h2 class="text-lg font-extrabold leading-snug text-ink">
                    <a
                      href={`/artists/${artist.slug}`}
                      class="inline-flex min-h-11 items-center transition-colors hover:text-terracotta-deep"
                    >
                      {artist.stageName}
                    </a>
                  </h2>
                  <p class="text-sm text-muted">{artist.genre || artist.roleLabel}</p>
                </div>
                <a
                  href={`/artists/${artist.slug}`}
                  class="inline-flex min-h-11 shrink-0 items-center rounded-full bg-cream px-3 text-xs font-bold text-terracotta-deep hover:bg-sand"
                >
                  {artist.upcomingEvents.length} {artist.upcomingEvents.length === 1 ? 'date' : 'dates'}
                </a>
              </div>

              {artist.upcomingEvents.length > 0 && (
                <ul class="mt-4 divide-y divide-cream border-t border-cream">
                  {artist.upcomingEvents.slice(0, 3).map((evt) => (
                    <li>
                      <a
                        href={`/events/${evt.slug}`}
                        class="flex min-h-11 flex-col justify-center py-2 text-sm hover:text-terracotta-deep"
                      >
                        <span class="truncate font-semibold text-ink">{evt.title}</span>
                        <span class="truncate text-xs text-muted">
                          {
                            formatLocalEventSchedule(
                              evt.startDateLocal,
                              evt.startTimeLocal,
                              evt.timezone,
                              evt.startsAt,
                            ).shortDateLabel
                          }{' '}
                          · {evt.venueName} · {evt.city}, {evt.state}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="mt-4 border-t border-cream pt-3 text-sm">
              <a
                href={`/artists/${artist.slug}`}
                class="inline-flex min-h-11 items-center gap-1 font-semibold text-terracotta-deep hover:underline"
              >
                Profile and all dates
                <Icon name="arrow" class="h-4 w-4" strokeWidth={2} />
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </Container>
</Layout>
