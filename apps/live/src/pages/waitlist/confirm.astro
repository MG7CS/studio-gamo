---
/**
 * Waitlist double opt-in (CLEANUP_LOG D-180): the link in the confirmation email opens this page (GET changes
 * nothing, so mail scanners cannot confirm for you); the button POSTs the token and activates the entry.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import JourneyPanel from '../../components/shared/JourneyPanel.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import {
  confirmWaitlistEntry,
  getRuntimeEnv,
  nowSeconds,
  requestSecurityHeaders,
  ticketingDb,
} from '@gamo/domain';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
requestSecurityHeaders(Astro.locals, { noReferrer: true });

const env = (await getRuntimeEnv(Astro)) as Record<string, unknown> &
  Awaited<ReturnType<typeof getRuntimeEnv>>;
let token = Astro.url.searchParams.get('t') ?? '';
let outcome: 'form' | 'done' | 'failed' = token ? 'form' : 'failed';
let eventTitle = '';
if (Astro.request.method === 'POST') {
  try {
    token = String((await Astro.request.formData()).get('t') ?? '');
    const r = await confirmWaitlistEntry(ticketingDb(env), env, { token, now: nowSeconds() });
    outcome = r.ok ? 'done' : 'failed';
    eventTitle = r.eventTitle ?? '';
  } catch {
    outcome = 'failed';
  }
  if (outcome === 'failed') Astro.response.status = 410;
}
---

<Layout title="Confirm your waitlist spot" noindex>
  {outcome === 'form' ? (
    <>
      <PageHeader
        eyebrow="Waitlist"
        title="Confirm your waitlist spot"
        lede="Press the button to join the waitlist. We only email you if tickets become available."
      />
      <section class="bg-cream px-4 pb-20 sm:px-8">
        <form
          method="post"
          action="/waitlist/confirm"
          class="mx-auto max-w-md space-y-4 rounded-[28px] bg-white p-6 ring-1 ring-sand"
        >
          <input type="hidden" name="t" value={token} />
          <SubmitButton label="Yes, add me to the waitlist" pendingLabel="Confirming…" fullWidth />
        </form>
      </section>
    </>
  ) : outcome === 'done' ? (
    <>
      <PageHeader
        eyebrow="Waitlist"
        title="You're on the waitlist"
        lede={
          eventTitle
            ? `We'll email you if tickets for ${eventTitle} are released. They are not reserved for you — first come, first served.`
            : "We'll email you if tickets are released."
        }
      />
      <JourneyPanel title="Thank you" body="Nothing else is needed." href="/events" label="Browse events" />
    </>
  ) : (
    <>
      <PageHeader
        eyebrow="Waitlist"
        title="This link can't be used."
        lede="It may have expired or already been used."
      />
      <JourneyPanel
        title="Start again"
        body="Open the event page and join the waitlist again."
        href="/events"
        label="Browse events"
      />
    </>
  )}
</Layout>
