---
import Layout from '../../layouts/Layout.astro';
Astro.response.status = 403;
---

<Layout title="Workspace access">
  <section class="mx-auto max-w-xl px-5 pb-20 pt-32">
    <h1 class="text-3xl font-semibold">This workspace needs program access.</h1>
    <p class="mt-5">
      Your current session does not have the required Gamo Live membership or role permission for this
      workspace. Registering for another Gamo product does not automatically grant Gamo Live access, and a
      general account does not grant organizer publishing, artist representation, refund approval, or staff
      permissions.
    </p>
    <div class="mt-7 flex flex-wrap gap-5">
      <a href="/account/signup" class="font-semibold text-terracotta">
        Create a Gamo Live account →
      </a>
      <a href="/account" class="font-semibold text-charcoal underline">
        Return to your account
      </a>
    </div>
  </section>
</Layout>
