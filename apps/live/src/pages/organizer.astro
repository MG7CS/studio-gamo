---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-3xl font-bold mb-8">Organizer Dashboard</h1>
    <div class="grid md:grid-cols-3 gap-6 mb-8">
      <div class="bg-white p-6 rounded-xl border border-gray-200">
        <div class="text-sm text-gray-500">Tickets Sold</div>
        <div class="text-3xl font-bold">142</div>
      </div>
      <div class="bg-white p-6 rounded-xl border border-gray-200">
        <div class="text-sm text-gray-500">Revenue</div>
        <div class="text-3xl font-bold">$2,130</div>
      </div>
    </div>
    <a href="#" class="text-[#B65B35] font-bold">Launch Scanner Mode &rarr;</a>
  </main>
</Layout>
