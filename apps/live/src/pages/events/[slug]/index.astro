---
import { formatUsd } from '@gamo/core';
import Layout from '../../../layouts/Layout.astro';
import { siteOrigin } from '@studio-gamo/ui/lib/sites';
import { clampDescription } from '@studio-gamo/ui/lib/seo';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import LiveDiscoveryCard from '../../../components/LiveDiscoveryCard.astro';
import Container from '../../../components/public/Container.astro';
import Surface from '../../../components/public/Surface.astro';
import PhotoHero from '../../../components/public/PhotoHero.astro';
import SectionHeading from '../../../components/public/SectionHeading.astro';
import EyebrowPill from '../../../components/public/EyebrowPill.astro';
import EmptyNotice from '../../../components/public/EmptyNotice.astro';
import FilterPill from '../../../components/public/FilterPill.astro';
import MetroLinks from '../../../components/public/MetroLinks.astro';
import VenueCard from '../../../components/public/VenueCard.astro';
import OrganizerCta from '../../../components/public/OrganizerCta.astro';
import { getRuntimeEnv } from '@gamo/config/runtime-env';
import {
  LiveCatalog,
  GAMO_LIVE_METROS,
  resolveMetroBySlug,
  extractExternalDomain,
  resolveExternalCtaLabel,
  formatLocalEventSchedule,
  isEventPast,
  type LiveEventWithDetails,
} from '@gamo/domain';
import { asSqlDatabase } from '@gamo/platform/db';

export const prerender = false;

const rawParam = (Astro.params.slug || '').trim();
const metro = resolveMetroBySlug(rawParam);

const url = Astro.url;
const categoryFilter = (url.searchParams.get('category') || '').trim().toLowerCase();
const weekendFilter = url.searchParams.get('weekend') === '1' || url.searchParams.get('weekend') === 'true';

let unavailable = false;
let event: LiveEventWithDetails | null = null;
let metroEvents: LiveEventWithDetails[] = [];
let metroVenues: Awaited<ReturnType<LiveCatalog['listDiscoverableVenues']>> = [];
let allMetroSummaries: Awaited<ReturnType<LiveCatalog['getMetroSummaries']>> = [];
let relatedEvents: LiveEventWithDetails[] = [];

try {
  const env = await getRuntimeEnv(Astro);
  const liveService = new LiveCatalog(asSqlDatabase(env.LIVE_DB));

  if (metro) {
    metroEvents = await liveService.listDiscoverableEvents({
      metro: metro.slug,
      category: categoryFilter && categoryFilter !== 'all' ? categoryFilter : undefined,
      weekend: weekendFilter || undefined,
      limit: 100,
    });
    metroVenues = await liveService.listDiscoverableVenues({ metro: metro.slug });
    allMetroSummaries = await liveService.getMetroSummaries();
  } else {
    // Only published and canceled events are ever returned; a canceled one says so instead of disappearing.
    event = await liveService.getEvent(rawParam);
    if (event) {
      const candidates = await liveService.listDiscoverableEvents({ limit: 24 });
      relatedEvents = candidates
        .filter((e) => e.id !== event!.id)
        .sort((a, b) => {
          const aSameMetro = a.metroSlug && a.metroSlug === event!.metroSlug ? 1 : 0;
          const bSameMetro = b.metroSlug && b.metroSlug === event!.metroSlug ? 1 : 0;
          if (aSameMetro !== bSameMetro) return bSameMetro - aSameMetro;
          const aSameCat = a.category === event!.category ? 1 : 0;
          const bSameCat = b.category === event!.category ? 1 : 0;
          return bSameCat - aSameCat;
        })
        .slice(0, 3);
    }
  }
} catch {
  unavailable = true;
}

if (!metro && !event) {
  Astro.response.status = unavailable ? 503 : 404;
}

const isExternal = Boolean(
  event &&
  (event.listingType === 'external_discovery' || event.externalOnly || event.admissionType === 'external'),
);
const isPast = Boolean(event && (typeof event.isPast === 'boolean' ? event.isPast : isEventPast(event)));
const isClosed = Boolean(event && (isPast || event.status === 'canceled'));

const eventMetro = event?.metroSlug ? resolveMetroBySlug(event.metroSlug) : null;
const schedule = event
  ? formatLocalEventSchedule(event.startDateLocal, event.startTimeLocal, event.timezone, event.startsAt)
  : null;

const externalCtaLabel = event
  ? resolveExternalCtaLabel({
      externalTicketProvider: event.externalTicketProvider,
      externalDestinationKind: event.externalDestinationKind,
    })
  : 'View official event';

const externalDomain = event ? extractExternalDomain(event.externalUrl) : null;

const formattedVerifiedDate = (() => {
  if (!event?.lastVerifiedAt) return null;
  try {
    const dt = new Date(event.lastVerifiedAt);
    if (!Number.isFinite(dt.getTime())) return null;
    return dt.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    });
  } catch {
    return null;
  }
})();

const googleMapsUrl = event
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      [event.venueName, event.address, event.city, event.state].filter(Boolean).join(', '),
    )}`
  : '';

const STAGE_HERO_FALLBACKS = [
  '/images/optimized/worship-acoustic-worship-leader-stage-1122w.webp',
  '/images/optimized/live-gospel-vocalists-concert-stage-1254w.webp',
  '/images/optimized/live-worship-night-hands-raised-1254w.webp',
  '/images/optimized/worship-gospel-worship-leader-golden-light-1122w.webp',
];
const hasArtwork = Boolean(event?.artworkRightsVerified && event?.artworkUrl);
const heroImage = hasArtwork
  ? event!.artworkUrl!
  : STAGE_HERO_FALLBACKS[(event?.slug.length ?? 0) % STAGE_HERO_FALLBACKS.length];

const METRO_HERO_IMAGES = [
  '/images/optimized/live-worship-concert-crowd-wide-1600w.webp',
  '/images/optimized/live-gospel-vocalists-concert-stage-1254w.webp',
  '/images/optimized/live-worship-night-hands-raised-1254w.webp',
];
const metroHeroImage = metro
  ? METRO_HERO_IMAGES[GAMO_LIVE_METROS.findIndex((m) => m.slug === metro.slug) % METRO_HERO_IMAGES.length]
  : METRO_HERO_IMAGES[0];

// Event structured data: only fields present in the event record are emitted.
const eventPath = event ? `/events/${event.slug}` : '';
const jsonLd = event
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: event.title,
      startDate:
        event.startDateLocal && event.startTimeLocal
          ? `${event.startDateLocal}T${event.startTimeLocal}:00`
          : event.startDateLocal || event.startsAt.toISOString(),
      eventStatus:
        event.status === 'canceled'
          ? 'https://schema.org/EventCancelled'
          : 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      url: `${siteOrigin('live')}${eventPath}`,
      ...(event.description ? { description: event.description } : {}),
      ...(event.venueName
        ? {
            location: {
              '@type': 'Place',
              name: event.venueName,
              address: {
                '@type': 'PostalAddress',
                ...(event.address ? { streetAddress: event.address } : {}),
                ...(event.city ? { addressLocality: event.city } : {}),
                ...(event.state ? { addressRegion: event.state } : {}),
                addressCountry: 'US',
              },
            },
          }
        : {}),
      ...(event.performers && event.performers.length > 0
        ? {
            performer: event.performers.map((p) => ({
              '@type': 'PerformingGroup',
              name: p.displayName,
            })),
          }
        : {}),
      ...(typeof event.priceMinCents === 'number' && event.priceMinCents >= 0
        ? {
            offers: {
              '@type': 'Offer',
              url: event.externalUrl || `${siteOrigin('live')}${eventPath}`,
              priceCurrency: event.currency || 'USD',
              price: (event.priceMinCents / 100).toFixed(2),
            },
          }
        : {}),
    }
  : null;

const pageTitle = metro
  ? `Christian events in ${metro.displayLabel}`
  : event
    ? `${event.title} · ${event.venueName}, ${event.city}, ${event.state}`
    : unavailable
      ? 'Events temporarily unavailable'
      : 'Event not found';

const pageDescription = metro
  ? clampDescription(
      metro.introCopy.length < 120
        ? `${metro.introCopy} Dates, venues and details on Gamo Live.`
        : metro.introCopy,
    )
  : event
    ? clampDescription(
        `${event.title} at ${event.venueName} in ${event.city}, ${event.state}${schedule && schedule.dateLabel !== 'Date TBA' ? ` on ${schedule.dateLabel}` : ''}. ${event.tagline || event.description || ''}`,
      )
    : 'Only approved events are shown on Gamo Live.';

const metroItems = (allMetroSummaries.length > 0 ? allMetroSummaries : GAMO_LIVE_METROS).map((m) => ({
  slug: m.slug,
  label: m.displayLabel,
  count:
    'publishedEventCount' in m && typeof m.publishedEventCount === 'number'
      ? m.publishedEventCount
      : undefined,
}));

const categoryLabel = event
  ? event.category === 'worship'
    ? 'Worship night'
    : event.category === 'concert'
      ? 'Concert'
      : event.category
  : '';

const toArtistSlug = (name: string) =>
  name
    .toLowerCase()
    .trim()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd ?? undefined}
  noindex={!metro && !event}
>
  {metro ? (
    /* CASE A: city page (/events/phoenix-az) */
    <div>
      <Container as="section" class="pt-4 sm:pt-5">
        <nav aria-label="Breadcrumb" class="mb-3 flex flex-wrap items-center gap-2 text-sm text-muted">
          <a
            href="/"
            class="inline-flex min-h-11 min-w-11 items-center justify-center hover:text-terracotta-deep"
          >
            Home
          </a>
          <span aria-hidden="true">/</span>
          <a href="/events" class="inline-flex min-h-11 items-center hover:text-terracotta-deep">
            Events
          </a>
          <span aria-hidden="true">/</span>
          <span class="font-semibold text-ink">{metro.displayLabel}</span>
        </nav>

        <PhotoHero src={metroHeroImage} alt="" position="object-center" priority>
          <EyebrowPill tone="dark" class="mb-4">
            {metro.regionLabel} · {metroEvents.length} {metroEvents.length === 1 ? 'event' : 'events'}
          </EyebrowPill>
          <h1 class="max-w-3xl text-[34px] font-black uppercase leading-[1.04] tracking-tight text-white sm:text-5xl lg:text-[56px]">
            Events in {metro.displayLabel}
          </h1>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg">{metro.introCopy}</p>
          <p class="mt-2 text-sm text-tan">Serving {metro.cities.join(', ')}.</p>
        </PhotoHero>
      </Container>

      <Container as="section" class="pt-5">
        <Surface>
          <SectionHeading
            title="Upcoming events"
            lede="Every listing has a confirmed venue, a local schedule and an official link."
          >
            <a
              slot="actions"
              href="/events?metro=all"
              class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-terracotta-deep hover:underline"
            >
              All cities
              <Icon name="arrow" class="h-4 w-4" strokeWidth={2} />
            </a>
          </SectionHeading>

          <div class="mt-5 flex flex-wrap gap-2">
            <FilterPill href={`/events/${metro.slug}`} active={!categoryFilter && !weekendFilter}>
              All
            </FilterPill>
            <FilterPill href={`/events/${metro.slug}?category=concert`} active={categoryFilter === 'concert'}>
              Concerts
            </FilterPill>
            <FilterPill href={`/events/${metro.slug}?category=worship`} active={categoryFilter === 'worship'}>
              Worship nights
            </FilterPill>
            <FilterPill href={`/events/${metro.slug}?weekend=1`} active={weekendFilter}>
              This weekend
            </FilterPill>
          </div>

          {metroEvents.length > 0 ? (
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {metroEvents.map((evt, idx) => (
                <LiveDiscoveryCard event={evt} index={idx} />
              ))}
            </div>
          ) : (
            <EmptyNotice
              class="mt-6"
              title={
                categoryFilter || weekendFilter
                  ? `No events in ${metro.displayLabel} match that filter`
                  : `No upcoming events in ${metro.displayLabel} yet`
              }
              body={
                categoryFilter || weekendFilter
                  ? 'Clear the filter to see every event in this city.'
                  : 'Organizers add events as they are approved. Check back soon, or list your own.'
              }
              primary={
                categoryFilter || weekendFilter
                  ? { href: `/events/${metro.slug}`, label: `All in ${metro.name}` }
                  : { href: '/events?metro=all', label: 'All cities' }
              }
              secondary={{ href: '/organizer', label: 'List an event' }}
            />
          )}
        </Surface>
      </Container>

      {metroVenues.length > 0 && (
        <Container as="section" class="pt-5">
          <Surface>
            <SectionHeading
              title={`Venues in ${metro.displayLabel}`}
              lede="Places with upcoming events in this city."
            >
              <a
                slot="actions"
                href={`/venues?metro=${metro.slug}`}
                class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-terracotta-deep hover:underline"
              >
                All venues
                <Icon name="arrow" class="h-4 w-4" strokeWidth={2} />
              </a>
            </SectionHeading>
            <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
              {metroVenues.map((v) => (
                <VenueCard venue={v} showMetro={false} />
              ))}
            </div>
          </Surface>
        </Container>
      )}

      <Container as="section" class="pt-5">
        <Surface>
          <SectionHeading size="compact" title="Other cities" />
          <MetroLinks
            class="mt-4"
            items={metroItems}
            href={(slug) => `/events/${slug}`}
            label="Cities"
            activeSlug={metro.slug}
          />
        </Surface>
      </Container>

      <Container as="section" class="pb-6 pt-5">
        <OrganizerCta
          eyebrow="Churches, ministries and artists"
          title={`Hosting an event in ${metro.name}?`}
          body="List it on Gamo Live. Free listings and free registration; Gamo reviews every organization's first event."
          ctaLabel="List an event"
          ctaHref="/organizer"
        />
      </Container>
    </div>
  ) : event ? (
    /* CASE B: event page (/events/<slug>) */
    <div>
      <Container as="section" class="pt-4 sm:pt-5">
        <nav aria-label="Breadcrumb" class="mb-3 flex flex-wrap items-center gap-2 text-sm text-muted">
          <a
            href="/"
            class="inline-flex min-h-11 min-w-11 items-center justify-center hover:text-terracotta-deep"
          >
            Home
          </a>
          <span aria-hidden="true">/</span>
          <a href="/events" class="inline-flex min-h-11 items-center hover:text-terracotta-deep">
            Events
          </a>
          {eventMetro && (
            <>
              <span aria-hidden="true">/</span>
              <a
                href={`/events/${eventMetro.slug}`}
                class="inline-flex min-h-11 items-center hover:text-terracotta-deep"
              >
                {eventMetro.displayLabel}
              </a>
            </>
          )}
        </nav>

        <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 lg:items-start">
          {/* Photo first, then the title block */}
          <div class="lg:col-span-7">
            <Surface padding="none">
              <div class="relative aspect-[16/10] bg-ink sm:aspect-[16/9]">
                <img
                  src={heroImage}
                  alt={hasArtwork ? `${event.title} event artwork` : ''}
                  fetchpriority="high"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover"
                />
                {!hasArtwork && (
                  <span class="absolute bottom-3 right-3 rounded-md bg-black/60 px-2.5 py-1 text-[11px] font-medium text-white">
                    Stage photo, not this event
                  </span>
                )}
              </div>

              <div class="p-5 sm:p-8">
                <div class="flex flex-wrap items-center gap-2">
                  <EyebrowPill>{categoryLabel}</EyebrowPill>
                  <EyebrowPill>
                    {event.city}, {event.state}
                  </EyebrowPill>
                  {isPast && (
                    <span
                      class="inline-flex items-center rounded-full bg-ink px-3 py-1 text-xs font-semibold text-cream"
                      data-past-closed-badge
                    >
                      Past · Closed
                    </span>
                  )}
                </div>

                <h1 class="mt-4 text-[28px] font-black uppercase leading-[1.06] tracking-tight text-ink sm:text-[40px] lg:text-[44px]">
                  {event.title}
                </h1>

                {event.tagline && (
                  <p class="mt-3 text-[15px] leading-relaxed text-muted sm:text-base">{event.tagline}</p>
                )}

                <div class="mt-6 grid grid-cols-1 gap-4 border-t border-cream pt-5 sm:grid-cols-2">
                  <div class="flex gap-3">
                    <Icon
                      name="calendar"
                      class="mt-0.5 h-5 w-5 shrink-0 text-terracotta-deep"
                      strokeWidth={1.8}
                    />
                    <div>
                      <p class="text-xs font-semibold text-muted">Date and time</p>
                      <p class="mt-0.5 text-[15px] font-bold text-ink">
                        {schedule ? schedule.dateLabel : 'Date TBA'}
                      </p>
                      <p class="text-sm text-muted">
                        {schedule ? schedule.timeLabel : 'Time TBA'}
                        {event.timezone ? ` (${event.timezone})` : ''}
                      </p>
                    </div>
                  </div>
                  <div class="flex gap-3">
                    <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-terracotta-deep" strokeWidth={1.8} />
                    <div>
                      <p class="text-xs font-semibold text-muted">Venue</p>
                      <p class="mt-0.5 text-[15px] font-bold text-ink">{event.venueName}</p>
                      <p class="text-sm text-muted">
                        {event.address ? `${event.address}, ` : ''}
                        {event.city}, {event.state}
                      </p>
                    </div>
                  </div>
                </div>

                {event.performers && event.performers.length > 0 && (
                  <div class="mt-5 border-t border-cream pt-5">
                    <p class="text-xs font-semibold text-muted">Performers</p>
                    <ul class="mt-2 flex flex-wrap gap-2">
                      {event.performers.map((performer) => (
                        <li>
                          <a
                            href={`/artists/${toArtistSlug(performer.displayName)}`}
                            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-sand bg-cream px-3.5 text-sm font-semibold text-ink transition-colors hover:border-terracotta-soft hover:text-terracotta-deep"
                          >
                            <span>{performer.displayName}</span>
                            {performer.roleLabel && (
                              <span class="text-xs font-normal text-muted">· {performer.roleLabel}</span>
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </Surface>
          </div>

          {/* Action panel: states and forms unchanged */}
          <div class="lg:col-span-5 lg:sticky lg:top-24">
            {isClosed ? (
              <div
                class="bg-white text-ink rounded-2xl border border-sand p-6 shadow-2xl"
                data-event-closed-panel
              >
                <div class="flex items-center justify-between gap-2 pb-4 border-b border-cream">
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-muted">
                      Event Status
                    </span>
                    <h2 class="text-lg font-extrabold text-ink mt-0.5">
                      {isPast ? 'Past Event · Closed' : 'Event Canceled · Closed'}
                    </h2>
                  </div>
                  <span class="px-2.5 py-1 rounded-lg bg-cream text-muted text-xs font-semibold">Closed</span>
                </div>
                <p class="mt-4 text-sm text-muted leading-relaxed">
                  {isPast
                    ? 'This event has already taken place. Ticket purchases and attendee registration are closed.'
                    : 'This event has been canceled and is closed for registration.'}
                </p>
                <div class="mt-5">
                  <a
                    href="/events"
                    class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-ink hover:bg-ink text-white font-bold text-sm transition-colors"
                  >
                    <span>Browse Upcoming Events</span>
                  </a>
                </div>
              </div>
            ) : isExternal ? (
              <div class="bg-white text-ink rounded-2xl border border-sand p-6 shadow-2xl">
                <div class="flex items-center justify-between gap-2 pb-4 border-b border-cream">
                  <div>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">
                      Official External Destination
                    </span>
                    <h2 class="text-lg font-extrabold text-ink mt-0.5">
                      {event.externalTicketProvider
                        ? `Tickets via ${event.externalTicketProvider}`
                        : 'Official Event Page'}
                    </h2>
                  </div>
                  {externalDomain && (
                    <span class="px-2.5 py-1 rounded-lg bg-cream text-muted text-xs font-mono font-semibold">
                      {externalDomain}
                    </span>
                  )}
                </div>

                {/* Pricing / Availability Note (Truthful — never invented) */}
                <div class="py-4 border-b border-cream">
                  <div class="text-xs font-semibold uppercase tracking-wider text-muted">
                    Pricing & Seat Availability
                  </div>
                  {typeof event.priceMinCents === 'number' ? (
                    <p class="text-base font-bold text-ink mt-1">
                      Starting from {formatUsd(event.priceMinCents)} {event.currency || 'USD'}
                    </p>
                  ) : (
                    <p class="text-sm text-muted mt-1 leading-relaxed">
                      Check official ticket page for current pricing and seat availability.
                    </p>
                  )}
                </div>

                {/* Primary External Outbound CTA */}
                {event.externalUrl && (
                  <div class="mt-5">
                    <a
                      href={event.externalUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-terracotta hover:bg-terracotta-deep text-white font-bold text-base shadow-md transition-colors"
                    >
                      <span>{externalCtaLabel}</span>
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.2"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                        />
                      </svg>
                    </a>
                    <p class="text-[11px] text-muted text-center mt-2">
                      Opens <strong>{externalDomain || 'official site'}</strong> in a new tab
                      {formattedVerifiedDate ? ` · Last verified ${formattedVerifiedDate}` : ''}
                    </p>
                  </div>
                )}

                {/* Save & Share Secondary Actions */}
                <div class="mt-4 pt-4 border-t border-cream flex items-center justify-between gap-3">
                  <button
                    type="button"
                    data-favorite-btn
                    data-event-slug={event.slug}
                    data-event-title={event.title}
                    aria-pressed="false"
                    class="flex-1 inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border border-sand hover:border-terracotta text-xs font-bold text-ink transition-colors min-h-11"
                  >
                    <svg
                      class="w-4 h-4 text-terracotta"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"
                      />
                    </svg>
                    <span data-favorite-label>Save event</span>
                  </button>

                  <button
                    id="share-event-btn"
                    type="button"
                    class="flex-1 inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border border-sand hover:border-ink text-xs font-bold text-ink transition-colors min-h-11"
                  >
                    <svg
                      class="w-4 h-4 text-muted"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                      />
                    </svg>
                    <span id="share-event-label">Share event</span>
                  </button>
                </div>
              </div>
            ) : (
              /* Organizer-Submitted Event Action Card (Preserves Free/Paid Organizer Flow) */
              <div class="bg-white text-ink rounded-2xl border border-sand p-6 shadow-xl">
                <span class="text-xs font-bold uppercase tracking-wider text-terracotta">
                  Published Event
                </span>
                <h2 class="text-xl font-bold text-ink mt-1">
                  {event.venueName} · {event.city}, {event.state}
                </h2>
                <p class="text-sm text-muted mt-2">
                  {event.startsAt.toLocaleString('en-US', {
                    timeZone: event.timezone,
                    dateStyle: 'full',
                    timeStyle: 'short',
                  })}{' '}
                  ({event.timezone})
                </p>
                <p class="text-sm text-muted mt-2">
                  Organized by <strong>{event.organizerName}</strong>
                </p>

                <p class="mt-2 text-xs text-muted">
                  {event.organizerVerified ? 'Verified organizer' : 'Not yet verified by Gamo'}
                </p>
                {event.priceText && (
                  <p class="mt-3 text-sm text-ink">
                    <strong>Price:</strong> {event.priceText}
                  </p>
                )}
                {event.refundPolicyText && (
                  <p class="mt-1 text-sm text-ink">
                    <strong>Refunds:</strong> {event.refundPolicyText}
                  </p>
                )}
                {event.admission === 'paid_tickets' && event.paidTickets ? (
                  event.paidTickets.state === 'on_sale' ? (
                    <>
                      <a
                        class="mt-6 w-full inline-flex min-h-11 items-center justify-center rounded-full bg-terracotta hover:bg-terracotta-deep px-6 py-3 font-semibold text-white transition-colors"
                        href={`/events/${event.slug}/tickets`}
                      >
                        Get tickets
                      </a>
                      <p class="mt-2 text-xs text-muted">
                        {event.paidTickets.fromCents != null
                          ? `From ${formatUsd(event.paidTickets.fromCents)}. `
                          : ''}
                        No account needed. {event.paidTickets.refundLine}
                        {event.paidTickets.sellerLine ? ` ${event.paidTickets.sellerLine}` : ''}
                      </p>
                    </>
                  ) : (
                    <p class="mt-6 rounded-xl bg-cream p-4 text-sm text-ink">
                      {event.paidTickets.state === 'sold_out'
                        ? 'Sold out.'
                        : event.paidTickets.state === 'not_open' && event.paidTickets.opensAt
                          ? `Tickets go on sale ${new Date(event.paidTickets.opensAt * 1000).toLocaleString('en-US', { timeZone: event.timezone, dateStyle: 'medium', timeStyle: 'short' })}.`
                          : 'Ticket sales have ended.'}
                    </p>
                  )
                ) : event.admission === 'free_registration' ? (
                  event.capacity != null && event.seatsTaken >= event.capacity ? (
                    <p class="mt-6 rounded-xl bg-cream p-4 text-sm text-ink">
                      Registration full. Check back in case seats open up.
                    </p>
                  ) : (
                    <>
                      <a
                        class="mt-6 w-full inline-flex min-h-11 items-center justify-center rounded-full bg-terracotta hover:bg-terracotta-deep px-6 py-3 font-semibold text-white transition-colors"
                        href={`/events/${event.slug}/register`}
                      >
                        Register free
                      </a>
                      <p class="mt-2 text-xs text-muted">
                        No account needed.
                        {event.capacity != null
                          ? ` ${Math.max(0, event.capacity - event.seatsTaken)} seats left.`
                          : ''}
                        {event.qrCheckin ? ' You will get a QR code for check-in.' : ''}
                      </p>
                    </>
                  )
                ) : (
                  <p class="mt-6 rounded-xl bg-cream p-4 text-sm text-ink">
                    Free event. No registration needed; just come.
                  </p>
                )}
              </div>
            )}
          </div>

          {/* About, venue and city guide */}
          <div class="space-y-5 lg:col-span-7">
            <Surface>
              <h2 class="text-xl font-bold text-ink">About this event</h2>
              <p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-muted sm:text-base">
                {event.description}
              </p>

              {isExternal && (
                <div class="mt-6 space-y-1.5 border-t border-cream pt-5 text-xs text-muted">
                  <p>
                    Listed by {event.publishedByLabel || 'Gamo Live Listings'}.
                    {event.originalOrganizerName ? ` Organizer: ${event.originalOrganizerName}.` : ''}
                  </p>
                  <p>
                    "{externalCtaLabel}" opens{' '}
                    <span class="font-mono">{externalDomain || 'the official event page'}</span>. Check door
                    times, bag rules and prices there before you travel.
                  </p>
                </div>
              )}
            </Surface>

            <Surface>
              <h2 class="text-xl font-bold text-ink">Venue</h2>
              <p class="mt-3 text-[15px] font-bold text-ink">{event.venueName}</p>
              {event.address ? (
                <p class="text-sm text-muted">{event.address}</p>
              ) : (
                <p class="text-sm text-muted">
                  No street address listed. Check the official page or the map.
                </p>
              )}
              <p class="text-sm text-muted">
                {event.city}, {event.state}
              </p>
              <div class="mt-5 flex flex-col gap-2.5 sm:flex-row">
                <a
                  href={googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center justify-center gap-1.5 rounded-full bg-cream px-4 text-sm font-semibold text-ink transition-colors hover:bg-sand"
                >
                  Open in Google Maps
                  <Icon name="external" class="h-3.5 w-3.5" strokeWidth={2} />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
                <a
                  href={`/events?venue=${encodeURIComponent(event.venueName)}`}
                  class="inline-flex min-h-11 items-center justify-center rounded-full border border-sand px-4 text-sm font-semibold text-ink transition-colors hover:border-terracotta-soft"
                >
                  More at this venue
                </a>
              </div>
            </Surface>

            {eventMetro && (
              <Surface>
                <EyebrowPill>City guide</EyebrowPill>
                <h2 class="mt-3 text-xl font-bold text-ink">Going to {eventMetro.displayLabel}?</h2>
                <p class="mt-2 text-sm leading-relaxed text-muted">{eventMetro.introCopy}</p>
                <a
                  href={`/events/${eventMetro.slug}`}
                  class="mt-4 inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-terracotta-deep hover:underline"
                >
                  All events in {eventMetro.displayLabel}
                  <Icon name="arrow" class="h-4 w-4" strokeWidth={2} />
                </a>
              </Surface>
            )}
          </div>
        </div>
      </Container>

      {relatedEvents.length > 0 && (
        <Container as="section" class="pb-6 pt-5">
          <Surface>
            <SectionHeading title="More events">
              <a
                slot="actions"
                href="/events"
                class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-terracotta-deep hover:underline"
              >
                All events
                <Icon name="arrow" class="h-4 w-4" strokeWidth={2} />
              </a>
            </SectionHeading>
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {relatedEvents.map((rel, idx) => (
                <LiveDiscoveryCard event={rel} index={idx} />
              ))}
            </div>
          </Surface>
        </Container>
      )}
    </div>
  ) : (
    /* CASE C: not found or unavailable */
    <Container as="section" class="pb-10 pt-6">
      <div class="mx-auto max-w-2xl">
        <h1 class="sr-only">{unavailable ? 'Events are temporarily unavailable' : 'Event not found'}</h1>
        <EmptyNotice
          title={unavailable ? 'Events are temporarily unavailable' : 'This event is not available'}
          body={
            unavailable
              ? 'Please try again in a moment.'
              : 'It may have ended, moved, or not been approved yet.'
          }
          primary={{ href: '/events', label: 'All events' }}
          secondary={{ href: '/events/phoenix-az', label: 'Phoenix, AZ events' }}
        />
      </div>
    </Container>
  )}

  <script>
    (function () {
      const STORAGE_KEY = 'gamo_live_saved_events';
      function readSavedSlugs() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          const parsed = raw ? JSON.parse(raw) : [];
          return Array.isArray(parsed) ? parsed : [];
        } catch (e) {
          return [];
        }
      }
      function writeSavedSlugs(slugs: string[]) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(slugs));
        } catch {
          // Storage unavailable (private mode); favorites stay in-memory only.
        }
      }
      function syncButtons() {
        const saved = readSavedSlugs();
        document.querySelectorAll('[data-favorite-btn]').forEach(function (btn) {
          const slug = btn.getAttribute('data-event-slug');
          const isSaved = Boolean(slug && saved.indexOf(slug) !== -1);
          btn.setAttribute('aria-pressed', isSaved ? 'true' : 'false');
          const label = btn.querySelector('[data-favorite-label]');
          if (label) label.textContent = isSaved ? 'Saved' : 'Save event';
          const svg = btn.querySelector('svg');
          if (svg) svg.setAttribute('fill', isSaved ? 'currentColor' : 'none');
        });
      }
      document.addEventListener('click', function (e) {
        const btn = (e.target as Element | null)?.closest('[data-favorite-btn]');
        if (!btn) return;
        e.preventDefault();
        const slug = btn.getAttribute('data-event-slug');
        if (!slug) return;
        const saved = readSavedSlugs();
        const i = saved.indexOf(slug);
        if (i === -1) saved.push(slug);
        else saved.splice(i, 1);
        writeSavedSlugs(saved);
        syncButtons();
      });

      const shareBtn = document.getElementById('share-event-btn');
      const shareLabel = document.getElementById('share-event-label');
      if (shareBtn) {
        shareBtn.addEventListener('click', function () {
          const url = window.location.href;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function () {
              if (shareLabel) shareLabel.textContent = 'Link copied';
              setTimeout(function () {
                if (shareLabel) shareLabel.textContent = 'Share event';
              }, 2000);
            });
          }
        });
      }

      syncButtons();
    })();
  </script>
</Layout>
