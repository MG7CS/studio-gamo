---
/**
 * A4: register for a free event. Photo-left split screen like sign-in; no account. A person enters name,
 * email and party size, accepts the terms, and is emailed a 6-digit code (next page). Seats are held 15
 * minutes. Past, full or non-registration events answer with a clear closed state, decided on the server.
 */
import Layout from '../../../../layouts/Layout.astro';
import SplitScreenLayout from '@studio-gamo/ui/components/split/SplitScreenLayout.astro';
import SplitHeading from '@studio-gamo/ui/components/split/SplitHeading.astro';
import SplitNotice from '@studio-gamo/ui/components/split/SplitNotice.astro';
import EventSummary from '../../../../components/register/EventSummary.astro';
import RegisterForm from '../../../../components/register/RegisterForm.astro';
import { requireSameOrigin } from '@gamo/auth';
import {
  EmailUnavailableError,
  SecretNotConfiguredError,
  TERMS_DRAFT_VERSION,
  cancelRegistration,
  codeEmail,
  formatLocalEventSchedule,
  requesterHash,
  sendLiveEmail,
  startRegistration,
} from '@gamo/domain';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import { openLive, registrationMessage, seatsLeft, whenWhere } from '../../../../lib/registration';
import { emailRegistrationLinkAgain } from '../../../../lib/organizer-events';

export const prerender = false;

const slug = Astro.params.id ?? '';
let notice: string | null = null;
let unavailable = false;
const errors: Record<string, string> = {};
const values: { name?: string; email?: string; partySize?: string } = {};
let event = null as Awaited<ReturnType<Awaited<ReturnType<typeof openLive>>['catalog']['getEvent']>>;
let selectedOccurrenceId = '';

try {
  const live = await openLive(Astro);
  event = await live.catalog.getEvent(slug);
  if (!event || event.admission !== 'free_registration') {
    return new Response(null, { status: 404 });
  }
  // Registration closes when a date starts, the same rule the server applies.
  const upcoming = event.occurrences.filter((o) => !o.canceled && o.startsAt.getTime() > Date.now());
  selectedOccurrenceId = upcoming.find((o) => o.id === event!.occurrenceId)?.id ?? upcoming[0]?.id ?? '';

  if (Astro.request.method === 'POST' && upcoming.length > 0) {
    try {
      requireSameOrigin(Astro.request);
    } catch {
      return new Response('Forbidden', { status: 403 });
    }
    const form = await Astro.request.formData();
    values.name = String(form.get('name') ?? '').trim();
    values.email = String(form.get('email') ?? '').trim();
    values.partySize = String(form.get('partySize') ?? '1');
    const occurrenceId = String(form.get('occurrence') ?? '');
    if (upcoming.some((o) => o.id === occurrenceId)) selectedOccurrenceId = occurrenceId;
    if (form.get('consent') !== 'yes') errors.consent = 'Please accept the terms to register.';
    else {
      const now = Math.floor(Date.now() / 1000);
      try {
        const reg = await startRegistration(live.db, live.env, {
          occurrenceId: selectedOccurrenceId,
          name: values.name,
          email: values.email,
          partySize: Number(values.partySize),
          termsVersion: TERMS_DRAFT_VERSION,
          now,
          ipHash: await requesterHash(Astro.request, live.env),
        });
        const occ = event.occurrences.find((o) => o.id === selectedOccurrenceId);
        try {
          await sendLiveEmail(
            live.env,
            codeEmail(reg.email, reg.name, reg.code, whenWhere(event, occ?.startsAt)),
          );
        } catch (mailError) {
          await cancelRegistration(live.db, reg.registrationId, now);
          throw mailError;
        }
        return Astro.redirect(`/events/${event.slug}/register/confirm?r=${reg.registrationId}`, 303);
      } catch (error) {
        const shown = registrationMessage(error);
        if (shown) {
          if (shown.code === 'invalid') errors.name = shown.text;
          else if (shown.code === 'duplicate') {
            await emailRegistrationLinkAgain(live, {
              event,
              occurrenceId: selectedOccurrenceId,
              email: values.email,
              origin: new URL(Astro.request.url).origin,
              now,
            });
            notice = `We sent an email to ${values.email}. If you are already registered for this date, it has your registration link. If you started registering a moment ago, use the code in that email.`;
          } else notice = shown.text;
        } else if (error instanceof EmailUnavailableError || error instanceof SecretNotConfiguredError) {
          unavailable = true;
        } else throw error;
      }
    }
  }
} catch (error) {
  if (error instanceof Response) throw error;
  console.error('[live:register] failed', (error as Error)?.name);
  unavailable = true;
}

const upcomingList = event
  ? event.occurrences.filter((o) => !o.canceled && o.startsAt.getTime() > Date.now())
  : [];
const occurrences = upcomingList.map((o) => ({
  id: o.id,
  label: formatLocalEventSchedule(null, null, event!.timezone, o.startsAt).fullLabel,
  seatsLeft: seatsLeft(event!.capacity, o.seatsTaken),
}));
const closed = !unavailable && event && upcomingList.length === 0;
const sold = occurrences.length > 0 && occurrences.every((o) => o.seatsLeft === 0);
const summary = event ? whenWhere(event, upcomingList[0]?.startsAt ?? event.startsAt) : null;
---

<Layout title={event ? `Register: ${event.title}` : 'Register'} chrome={false} noindex>
  <SplitScreenLayout photo="concertCrowdWide" position="46% 34%" program="Gamo Live" brandHref="/">
    <SplitHeading
      title={closed ? 'Registration closed' : 'Register free'}
      subtext={closed ? undefined : 'No account needed. We email you a code to confirm.'}
    />
    {unavailable && (
      <SplitNotice tone="error">Registration is temporarily unavailable. Please try again later.</SplitNotice>
    )}
    {notice && <SplitNotice tone="error">{notice}</SplitNotice>}
    {event && summary && (
      <>
        <EventSummary
          title={event.title}
          whenLabel={summary.whenLabel}
          venueLabel={summary.venueLabel}
          organizerName={event.organizerName}
          organizerVerified={event.organizerVerified}
        />
        {closed && (
          <SplitNotice>
            {event.status === 'canceled'
              ? 'This event was canceled, so registration is closed.'
              : 'Registration is closed because every date has started or passed.'}
          </SplitNotice>
        )}
        {sold && <SplitNotice>This event is full. Check back in case seats open up.</SplitNotice>}
        {!closed && !unavailable && !sold && (
          <RegisterForm
            occurrences={occurrences}
            selectedOccurrenceId={selectedOccurrenceId}
            maxParty={event.maxPartySize}
            values={values}
            errors={errors}
            siteTermsUrl={siteUrl('web', '/legal/site-terms')}
            privacyUrl={siteUrl('web', '/legal/privacy-policy')}
          />
        )}
        <p class="mt-6 text-[14px] text-muted">
          <a class="font-semibold text-terracotta underline" href={`/events/${event.slug}`}>
            Back to the event
          </a>
        </p>
      </>
    )}
  </SplitScreenLayout>
</Layout>
