---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/shared/PageHeader.astro';
import TicketSelector from '../../../components/tickets/TicketSelector.astro';
import FreeRegistrationForm from '../../../components/tickets/FreeRegistrationForm.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import { getDb } from '@gamo/db';
import { LiveService, getRuntimeEnv } from '@gamo/domain';
import { events, type LiveEvent } from '../../../data/events';

export const prerender = false;

const id = Astro.params.id ?? '';
let event: LiveEvent | undefined = events.find((e) => e.id === id);

const runtimeEnv = await getRuntimeEnv(Astro);
if (!event && runtimeEnv?.DB) {
  const db = getDb(runtimeEnv.DB);
  const service = new LiveService(db);
  const dbEvent = await service.getEventById(id);
  if (dbEvent) {
    event = {
      id: dbEvent.id,
      sample: true,
      title: dbEvent.title,
      tagline: dbEvent.tagline ?? 'Christian community gathering',
      category: 'worship',
      date: dbEvent.startsAt.toISOString().slice(0, 10),
      time: '7:00 PM',
      city: dbEvent.city ?? 'Community',
      state: dbEvent.state ?? 'US',
      venue: dbEvent.venueName ?? 'Main Sanctuary',
      organizer: 'grace-chapel',
      photo: 'worshipNight',
      ticketing: 'free',
      status: 'scheduled',
      tiers: [{ name: 'Free Registration', priceCents: 0, note: 'General admission' }],
      description: dbEvent.description ?? 'Christian community gathering.',
    };
  }
}

if (!event) {
  event = {
    id,
    sample: true,
    title: 'Community Worship Gathering',
    tagline: 'Free registration slice',
    category: 'worship',
    date: '2026-11-15',
    time: '7:00 PM',
    city: 'Dallas',
    state: 'TX',
    venue: 'Main Sanctuary',
    organizer: 'grace-chapel',
    photo: 'worshipNight',
    ticketing: 'free',
    status: 'scheduled',
    tiers: [{ name: 'Free Registration', priceCents: 0, note: 'General admission' }],
    description: 'Free community gathering registration.',
  };
}
---

<Layout title="Free registration" headerTheme="light">
  <PageHeader eyebrow="Free registration" title={event.title} />
  <TicketSelector event={event} />
  <FreeRegistrationForm eventId={event.id} eventTitle={event.title} />
</Layout>
