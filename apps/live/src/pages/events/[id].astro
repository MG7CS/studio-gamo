---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-3xl mx-auto py-12 px-4">
    <a href="/" class="text-sm text-[#B65B35] mb-6 inline-block hover:underline">← Back to Events</a>
    <h1 class="text-4xl font-bold mb-4">Night of Worship (Demo)</h1>
    <div class="bg-white border border-[#DED6CC] p-8 rounded-xl mb-8">
      <h3 class="font-bold mb-4">Select Tickets</h3>
      <div class="flex justify-between items-center border-b pb-4 mb-4">
        <div>
          <div class="font-bold">General Admission</div>
          <div class="text-gray-500">$15.00</div>
        </div>
        <select class="border p-2 rounded">
          <option>1</option>
          <option>2</option>
        </select>
      </div>
      <a href="/checkout" class="block w-full text-center bg-[#B65B35] text-white py-3 rounded-lg font-bold">Checkout</a>
    </div>
  </main>
</Layout>
