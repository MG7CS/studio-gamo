---
import Layout from '../../layouts/Layout.astro';
import EventFilters from '../../components/events/EventFilters.astro';
import EventResults from '../../components/events/EventResults.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import {
  eventCountSummary,
  eventSearchFilters,
  hasEventFilters,
  parseEventSearch,
  resolveMetroBySlug,
} from '@gamo/domain';
import { listEvents } from '../../lib/event-list';

export const prerender = false;

const search = parseEventSearch(Astro.url.searchParams);
const { events, unavailable } = await listEvents(Astro, eventSearchFilters(search));
if (unavailable) Astro.response.status = 503;

const metro = resolveMetroBySlug(search.metro);
const title = metro ? `Christian events in ${metro.displayLabel}` : 'Christian events across the U.S.';
const description =
  'Upcoming Christian concerts, worship nights, conferences and gatherings. Free to attend or with tickets, with the details on each page.';
---

<Layout title={title} description={description} noindex={hasEventFilters(search) || search.page > 1}>
  <div class="mx-auto max-w-[1100px] px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
    <PageHeader
      title="Christian events"
      description={unavailable ? undefined : eventCountSummary(events.length, search.metro)}
    />
    <EventFilters search={search} />
    <section id="results" aria-label="Results" class="mt-6">
      {unavailable ? (
        <Notice tone="warning" title="Events can't be loaded right now.">
          Please try again in a moment.
        </Notice>
      ) : (
        <EventResults events={events} search={search} path="/events" />
      )}
    </section>
  </div>
</Layout>
