---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import AudienceSelector from '../../components/shared/AudienceSelector.astro';
import EventFilterGrid from '../../components/events/EventFilterGrid.astro';
import TrustLegend from '../../components/shared/TrustLegend.astro';
import { events } from '../../data/events';
export const prerender = true;
const sorted = [...events].sort((a, b) => a.date.localeCompare(b.date));
---
<Layout title="Discover events" headerTheme="light">
  <PageHeader eyebrow="Event discovery" title="Find a gathering" accent="worth showing up for." lede="Search gospel concerts, worship nights, Bible studies, conferences and family events across the country.">
    <AudienceSelector current="explore" tone="light" />
  </PageHeader>
  <EventFilterGrid events={sorted} />
  <section class="bg-cream px-4 pb-20 sm:px-8"><TrustLegend class="mx-auto max-w-[1320px]" /></section>
</Layout>
