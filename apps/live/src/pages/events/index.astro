---
import Layout from '../../layouts/Layout.astro';
import LiveDiscoveryCard from '../../components/LiveDiscoveryCard.astro';
import Container from '../../components/public/Container.astro';
import Surface from '../../components/public/Surface.astro';
import SectionHeading from '../../components/public/SectionHeading.astro';
import EmptyNotice from '../../components/public/EmptyNotice.astro';
import MetroLinks from '../../components/public/MetroLinks.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { clampDescription } from '@studio-gamo/ui/lib/seo';
import { getRuntimeEnv } from '@gamo/config/runtime-env';
import {
  LiveCatalog,
  GAMO_LIVE_METROS,
  resolveMetroBySlug,
  resolveNearestMetroByCoordinates,
  type LiveEventWithDetails,
} from '@gamo/domain';
import { asSqlDatabase } from '@gamo/platform/db';

export const prerender = false;

const url = Astro.url;
const qParam = (url.searchParams.get('q') || '').trim();
const rawMetroParam = (url.searchParams.get('metro') || '').trim().toLowerCase();
const rawCategoryParam = (url.searchParams.get('category') || '').trim().toLowerCase();
const rawDateParam = (url.searchParams.get('date') || '').trim().toLowerCase();
const rawWeekendParam = (url.searchParams.get('weekend') || '').trim().toLowerCase();
const rawSortParam = (url.searchParams.get('sort') || 'date-asc').trim().toLowerCase();
const venueParam = (url.searchParams.get('venue') || '').trim();
const artistParam = (url.searchParams.get('artist') || '').trim();
const savedParam = (url.searchParams.get('saved') || '').trim();
const latParam = url.searchParams.get('lat');
const lngParam = url.searchParams.get('lng');
const dateFromParam = url.searchParams.get('dateFrom');
const dateToParam = url.searchParams.get('dateTo');

const parsedLat = latParam !== null && latParam !== '' ? Number.parseFloat(latParam) : Number.NaN;
const parsedLng = lngParam !== null && lngParam !== '' ? Number.parseFloat(lngParam) : Number.NaN;
const hasValidCoords = Number.isFinite(parsedLat) && Number.isFinite(parsedLng);

const nearestResolution = hasValidCoords ? resolveNearestMetroByCoordinates(parsedLat, parsedLng) : null;

const effectiveMetroSlug =
  rawMetroParam && rawMetroParam !== 'all'
    ? rawMetroParam
    : rawMetroParam !== 'all' && nearestResolution
      ? nearestResolution.metro.slug
      : '';

const selectedMetro = effectiveMetroSlug ? resolveMetroBySlug(effectiveMetroSlug) : null;
const dropdownMetroValue =
  rawMetroParam === 'all' ? 'all' : selectedMetro ? selectedMetro.slug : 'phoenix-az';

const isWeekendFilter = rawWeekendParam === '1' || rawWeekendParam === 'true' || rawDateParam === 'weekend';

let computedDateFrom: Date | undefined;
let computedDateTo: Date | undefined;

if (dateFromParam) {
  const d = new Date(dateFromParam);
  if (Number.isFinite(d.getTime())) computedDateFrom = d;
}
if (dateToParam) {
  const d = new Date(dateToParam);
  if (Number.isFinite(d.getTime())) computedDateTo = d;
}

if (rawDateParam === '2026') {
  computedDateFrom = new Date('2026-01-01T00:00:00Z');
  computedDateTo = new Date('2026-12-31T23:59:59Z');
} else if (rawDateParam === '2027') {
  computedDateFrom = new Date('2027-01-01T00:00:00Z');
  computedDateTo = new Date('2027-12-31T23:59:59Z');
} else if (rawDateParam === 'month') {
  const anchor = new Date();
  computedDateFrom = anchor;
  computedDateTo = new Date(anchor.getTime() + 45 * 24 * 60 * 60 * 1000);
}

let events: LiveEventWithDetails[] = [];
let metroSummaries: Awaited<ReturnType<LiveCatalog['getMetroSummaries']>> = [];
let dbUnavailable = false;

try {
  const env = await getRuntimeEnv(Astro);
  const liveService = new LiveCatalog(asSqlDatabase(env.LIVE_DB));

  events = await liveService.listDiscoverableEvents({
    q: qParam || undefined,
    metro: effectiveMetroSlug || undefined,
    category: rawCategoryParam && rawCategoryParam !== 'all' ? rawCategoryParam : undefined,
    weekend: isWeekendFilter || undefined,
    venue: venueParam || undefined,
    artist: artistParam || undefined,
    dateFrom: computedDateFrom,
    dateTo: computedDateTo,
    limit: 100,
  });

  metroSummaries = await liveService.getMetroSummaries();
} catch {
  dbUnavailable = true;
}

// Without a city filter, Phoenix (the launch city) comes first, then the rest by the chosen sort.
const orderedEvents = [...events].sort((a, b) => {
  if (!rawMetroParam && !nearestResolution && !qParam) {
    const aPhx = a.metroSlug === 'phoenix-az' ? 0 : 1;
    const bPhx = b.metroSlug === 'phoenix-az' ? 0 : 1;
    if (aPhx !== bPhx) return aPhx - bPhx;
  }
  if (rawSortParam === 'date-desc') {
    return b.startsAt.getTime() - a.startsAt.getTime();
  }
  if (rawSortParam === 'city-asc') {
    return `${a.city}, ${a.state}`.localeCompare(`${b.city}, ${b.state}`);
  }
  if (rawSortParam === 'title-asc') {
    return a.title.localeCompare(b.title);
  }
  return a.startsAt.getTime() - b.startsAt.getTime();
});

const hasActiveFilters = Boolean(
  qParam ||
  effectiveMetroSlug ||
  (rawCategoryParam && rawCategoryParam !== 'all') ||
  isWeekendFilter ||
  rawDateParam ||
  venueParam ||
  artistParam ||
  savedParam === '1',
);

const pageTitle = selectedMetro
  ? `Christian events in ${selectedMetro.displayLabel}`
  : 'Christian events nationwide';
const pageDescription = selectedMetro
  ? clampDescription(
      selectedMetro.introCopy.length < 120
        ? `${selectedMetro.introCopy} Dates, venues and details on Gamo Live.`
        : selectedMetro.introCopy,
    )
  : 'Concerts, worship nights and Christian gatherings in Phoenix, Atlanta, Nashville, Orlando, Los Angeles, Houston and more.';

const headingTitle = selectedMetro ? `Events in ${selectedMetro.displayLabel}` : 'Find an event';
const metroItems = GAMO_LIVE_METROS.map((metro) => {
  const summary = metroSummaries.find((s) => s.slug === metro.slug);
  return { slug: metro.slug, label: metro.displayLabel, count: summary?.publishedEventCount };
});
const weekendHref = `/events?${new URLSearchParams({
  ...(effectiveMetroSlug ? { metro: effectiveMetroSlug } : {}),
  ...(isWeekendFilter ? {} : { weekend: '1' }),
}).toString()}`;
const pillClass =
  'inline-flex min-h-11 items-center gap-1.5 rounded-full border px-4 text-sm font-semibold transition-colors';
const pillOff = 'border-sand bg-white text-ink hover:border-terracotta-soft';
const selectClass =
  'min-h-12 w-full cursor-pointer appearance-none bg-transparent pr-6 text-[15px] font-medium text-ink focus:outline-none';
---

<Layout title={pageTitle} description={pageDescription}>
  <Container as="section" id="discovery-search" class="pb-6 pt-4 sm:pt-5">
    <SectionHeading
      level={1}
      size="page"
      eyebrow={selectedMetro ? selectedMetro.regionLabel : 'Events nationwide'}
      title={headingTitle}
      lede="Concerts, worship nights and gatherings. Filter by city, date and category."
    />

    {/* Filters */}
    <Surface class="mt-6" padding="none">
      <form
        id="events-discovery-form"
        method="get"
        action="/events"
        class="grid grid-cols-1 gap-2.5 p-3 sm:grid-cols-2 sm:p-4 lg:grid-cols-[minmax(240px,1.6fr)_1fr_0.9fr_1fr_auto] lg:items-center"
      >
        <div class="flex items-center gap-3 rounded-2xl border border-sand bg-ivory px-4 transition-colors focus-within:border-terracotta sm:col-span-2 lg:col-span-1">
          <Icon name="search" class="h-5 w-5 shrink-0 text-ink" strokeWidth={2} />
          <label for="events-search-q" class="sr-only">
            Search events, artists or venues
          </label>
          <input
            id="events-search-q"
            type="search"
            name="q"
            value={qParam}
            placeholder="Search events, artists or venues"
            class="min-h-12 w-full bg-transparent text-[15px] text-ink placeholder:text-muted focus:outline-none"
          />
        </div>

        <div class="relative flex items-center gap-2.5 rounded-2xl border border-sand bg-ivory px-4 transition-colors hover:border-line">
          <Icon name="pin" class="pointer-events-none h-5 w-5 shrink-0 text-ink" strokeWidth={1.9} />
          <label for="events-filter-metro" class="sr-only">
            City
          </label>
          <select id="events-filter-metro" name="metro" data-auto-submit-select class={selectClass}>
            {GAMO_LIVE_METROS.map((m) => (
              <option value={m.slug} selected={dropdownMetroValue === m.slug}>
                {m.displayLabel}
              </option>
            ))}
            <option value="all" selected={dropdownMetroValue === 'all'}>
              All cities
            </option>
          </select>
          <Icon
            name="chevron-down"
            class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"
            strokeWidth={2}
          />
        </div>

        <div class="relative flex items-center gap-2.5 rounded-2xl border border-sand bg-ivory px-4 transition-colors hover:border-line">
          <Icon name="calendar" class="pointer-events-none h-5 w-5 shrink-0 text-ink" strokeWidth={1.9} />
          <label for="events-filter-date" class="sr-only">
            Date
          </label>
          <select id="events-filter-date" name="date" data-auto-submit-select class={selectClass}>
            <option value="" selected={!rawDateParam && !isWeekendFilter}>
              Any date
            </option>
            <option value="weekend" selected={rawDateParam === 'weekend' || isWeekendFilter}>
              This weekend
            </option>
            <option value="month" selected={rawDateParam === 'month'}>
              This month
            </option>
            <option value="2026" selected={rawDateParam === '2026'}>
              2026
            </option>
            <option value="2027" selected={rawDateParam === '2027'}>
              2027
            </option>
          </select>
          <Icon
            name="chevron-down"
            class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"
            strokeWidth={2}
          />
        </div>

        <div class="relative flex items-center gap-2.5 rounded-2xl border border-sand bg-ivory px-4 transition-colors hover:border-line">
          <Icon name="music" class="pointer-events-none h-5 w-5 shrink-0 text-ink" strokeWidth={1.9} />
          <label for="events-filter-category" class="sr-only">
            Category
          </label>
          <select id="events-filter-category" name="category" data-auto-submit-select class={selectClass}>
            <option value="" selected={!rawCategoryParam || rawCategoryParam === 'all'}>
              All categories
            </option>
            <option value="concert" selected={rawCategoryParam === 'concert'}>
              Concerts
            </option>
            <option value="worship" selected={rawCategoryParam === 'worship'}>
              Worship nights
            </option>
            <option value="conference" selected={rawCategoryParam === 'conference'}>
              Conferences
            </option>
            <option value="youth" selected={rawCategoryParam === 'youth'}>
              Youth and young adults
            </option>
          </select>
          <Icon
            name="chevron-down"
            class="pointer-events-none absolute right-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"
            strokeWidth={2}
          />
        </div>

        <button
          id="toggle-more-filters-btn"
          type="button"
          aria-expanded={hasActiveFilters ? 'true' : 'false'}
          aria-controls="more-filters-drawer"
          class="inline-flex min-h-12 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-2xl border border-line bg-white px-5 text-[15px] font-semibold text-ink transition-colors hover:bg-cream"
        >
          <Icon name="sliders" class="h-4 w-4" strokeWidth={2} />
          <span>More</span>
        </button>
      </form>

      {/* More filters: location, saved, weekend, cities */}
      <div
        id="more-filters-drawer"
        class:list={['border-t border-sand p-3 sm:p-4', !(hasActiveFilters || nearestResolution) && 'hidden']}
      >
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
          <div class="flex flex-wrap items-center gap-2">
            <button
              id="use-my-location-btn"
              type="button"
              class:list={[pillClass, pillOff, 'cursor-pointer']}
            >
              <Icon name="pin" class="h-4 w-4 text-terracotta-deep" strokeWidth={2} />
              <span id="use-my-location-label">Use my location</span>
            </button>

            <button
              id="saved-events-filter-btn"
              type="button"
              data-saved-active={savedParam === '1' ? 'true' : 'false'}
              class:list={[pillClass, pillOff, 'cursor-pointer']}
            >
              <Icon name="heart" class="h-4 w-4 text-terracotta-deep" strokeWidth={2} />
              <span>Saved</span>
              <span
                id="saved-events-count-badge"
                class="rounded-full bg-sand px-1.5 py-0.5 text-[11px] font-bold"
              >
                0
              </span>
            </button>

            <a
              href={weekendHref}
              class:list={[
                pillClass,
                isWeekendFilter ? 'border-terracotta bg-terracotta text-white' : pillOff,
              ]}
            >
              This weekend
            </a>
          </div>

          {hasActiveFilters && (
            <a
              href="/events"
              class="inline-flex min-h-11 items-center text-sm font-semibold text-terracotta-deep hover:underline"
            >
              Clear filters
            </a>
          )}
        </div>

        <p
          id="location-status-msg"
          class="mt-2 hidden text-sm text-terracotta-deep"
          role="status"
          aria-live="polite"
        ></p>

        {nearestResolution && selectedMetro && (
          <p class="mt-2.5 text-sm text-muted">
            Nearest city: <strong class="text-ink">{selectedMetro.displayLabel}</strong> (about{' '}
            {nearestResolution.distanceKm} km).{' '}
            <a href="/events?metro=all" class="font-semibold text-terracotta-deep underline">
              Show all cities
            </a>
          </p>
        )}

        <div class="mt-3 border-t border-cream pt-3">
          <p class="mb-2 text-xs font-semibold text-muted">City pages</p>
          <MetroLinks
            items={metroItems}
            href={(slug) => `/events/${slug}`}
            label="Cities"
            activeSlug={effectiveMetroSlug || null}
          />
        </div>
      </div>
    </Surface>

    {/* Count and sort */}
    <div class="mb-4 mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <h2 class="text-[20px] font-extrabold tracking-tight text-ink sm:text-[22px]">
          <span id="visible-events-count">{orderedEvents.length}</span>{' '}
          <span id="visible-events-unit">{orderedEvents.length === 1 ? 'event' : 'events'}</span>
        </h2>
        {selectedMetro && (
          <span class="text-sm text-muted">
            in{' '}
            <a
              href={`/events/${selectedMetro.slug}`}
              class="font-semibold text-ink underline hover:text-terracotta-deep"
            >
              {selectedMetro.displayLabel}
            </a>
          </span>
        )}
        {qParam && <span class="text-sm text-muted">matching &ldquo;{qParam}&rdquo;</span>}
        {venueParam && <span class="text-sm text-muted">at {venueParam}</span>}
      </div>

      <div class="flex items-center gap-2.5">
        <label for="events-sort-select" class="text-sm text-muted">
          Sort by
        </label>
        <div class="relative">
          <select
            id="events-sort-select"
            class="min-h-11 cursor-pointer appearance-none rounded-full border border-sand bg-white pl-4 pr-9 text-sm font-medium text-ink focus:border-terracotta focus:outline-none"
          >
            <option value="date-asc" selected={rawSortParam === 'date-asc'}>
              Date, soonest
            </option>
            <option value="date-desc" selected={rawSortParam === 'date-desc'}>
              Date, latest
            </option>
            <option value="city-asc" selected={rawSortParam === 'city-asc'}>
              City
            </option>
            <option value="title-asc" selected={rawSortParam === 'title-asc'}>
              Title
            </option>
          </select>
          <Icon
            name="chevron-down"
            class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"
            strokeWidth={2}
          />
        </div>
      </div>
    </div>

    {/* Saved-only filter with nothing saved (shown by the script) */}
    <div id="saved-events-empty-state" class="my-6 hidden">
      <EmptyNotice
        title="No saved events on this device"
        body="Press the heart on an event to save it in this browser."
      >
        <button
          id="clear-saved-filter-btn"
          type="button"
          class="mt-6 inline-flex min-h-11 w-full cursor-pointer items-center justify-center rounded-full bg-terracotta px-5 text-sm font-semibold text-white hover:bg-terracotta-deep sm:w-auto"
        >
          Show all events
        </button>
      </EmptyNotice>
    </div>

    {dbUnavailable ? (
      <EmptyNotice title="Events could not be loaded" body="Please refresh or try again in a moment." />
    ) : orderedEvents.length > 0 ? (
      <div id="events-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {orderedEvents.map((event, idx) => (
          <LiveDiscoveryCard event={event} index={idx} />
        ))}
      </div>
    ) : (
      <EmptyNotice
        title={hasActiveFilters ? 'No events match these filters' : 'No upcoming events yet'}
        body={
          hasActiveFilters
            ? 'Try fewer filters or another city.'
            : 'Organizers add events as they are approved. Check back soon, or list your own.'
        }
        primary={
          hasActiveFilters
            ? { href: '/events', label: 'Clear filters' }
            : { href: '/organizer', label: 'List an event' }
        }
      >
        <div class="mt-8 border-t border-cream pt-6">
          <p class="mb-3 text-xs font-semibold text-muted">Browse by city</p>
          <MetroLinks
            items={metroItems}
            href={(slug) => `/events/${slug}`}
            label="Cities"
            class="justify-center"
          />
        </div>
      </EmptyNotice>
    )}
  </Container>

  <script>
    (function () {
      const STORAGE_KEY = 'gamo_live_saved_events';
      const METROS = [
        { slug: 'phoenix-az', name: 'Phoenix, AZ', lat: 33.4484, lng: -112.074 },
        { slug: 'atlanta-ga', name: 'Atlanta, GA', lat: 33.749, lng: -84.388 },
        { slug: 'nashville-tn', name: 'Nashville, TN', lat: 36.1627, lng: -86.7816 },
        { slug: 'orlando-fl', name: 'Orlando, FL', lat: 28.5383, lng: -81.3792 },
        { slug: 'los-angeles-ca', name: 'Los Angeles, CA', lat: 34.0522, lng: -118.2437 },
        { slug: 'houston-tx', name: 'Houston, TX', lat: 29.7604, lng: -95.3698 },
        { slug: 'seattle-wa', name: 'Seattle, WA', lat: 47.6062, lng: -122.3321 },
        { slug: 'new-york-ny', name: 'New York, NY', lat: 40.6782, lng: -73.9442 },
        { slug: 'oklahoma-city-ok', name: 'Oklahoma City, OK', lat: 35.4676, lng: -97.5164 },
      ];

      const discoveryForm = document.getElementById('events-discovery-form') as HTMLFormElement | null;
      const autoSubmitSelects = document.querySelectorAll('[data-auto-submit-select]');
      autoSubmitSelects.forEach(function (sel) {
        sel.addEventListener('change', function () {
          if (discoveryForm) discoveryForm.submit();
        });
      });

      const moreFiltersBtn = document.getElementById('toggle-more-filters-btn');
      const moreFiltersDrawer = document.getElementById('more-filters-drawer');
      if (moreFiltersBtn && moreFiltersDrawer) {
        moreFiltersBtn.addEventListener('click', function () {
          const isHidden = moreFiltersDrawer.classList.contains('hidden');
          moreFiltersDrawer.classList.toggle('hidden', !isHidden);
          moreFiltersBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
        });
      }

      const sortSelect = document.getElementById('events-sort-select') as HTMLSelectElement | null;
      const eventsGrid = document.getElementById('events-grid');
      if (sortSelect && eventsGrid) {
        sortSelect.addEventListener('change', function () {
          const mode = sortSelect.value;
          const cards = Array.prototype.slice.call(eventsGrid.querySelectorAll('[data-event-card]'));
          cards.sort(function (a, b) {
            const dateA = a.getAttribute('data-start-date') || '';
            const dateB = b.getAttribute('data-start-date') || '';
            const cityA = a.getAttribute('data-city') || '';
            const cityB = b.getAttribute('data-city') || '';
            const titleA = a.getAttribute('data-title') || '';
            const titleB = b.getAttribute('data-title') || '';
            if (mode === 'date-desc') return dateB.localeCompare(dateA);
            if (mode === 'city-asc') return cityA.localeCompare(cityB);
            if (mode === 'title-asc') return titleA.localeCompare(titleB);
            return dateA.localeCompare(dateB);
          });
          cards.forEach(function (card) {
            eventsGrid.appendChild(card);
          });
        });
      }

      function readSavedSlugs() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return [];
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed : [];
        } catch (e) {
          return [];
        }
      }

      function writeSavedSlugs(slugs: string[]) {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(slugs));
        } catch {
          // Storage unavailable (private mode); favorites stay in-memory only.
        }
      }

      const savedFilterBtn = document.getElementById('saved-events-filter-btn');
      const savedCountBadge = document.getElementById('saved-events-count-badge');
      const savedEmptyState = document.getElementById('saved-events-empty-state');
      const clearSavedBtn = document.getElementById('clear-saved-filter-btn');
      const visibleCountEl = document.getElementById('visible-events-count');
      const visibleUnitEl = document.getElementById('visible-events-unit');
      let savedOnlyActive = savedFilterBtn && savedFilterBtn.getAttribute('data-saved-active') === 'true';

      function syncFavoriteUi() {
        const saved = readSavedSlugs();
        if (savedCountBadge) {
          savedCountBadge.textContent = String(saved.length);
        }

        document.querySelectorAll('[data-favorite-btn]').forEach(function (btn) {
          const slug = btn.getAttribute('data-event-slug');
          const isSaved = Boolean(slug && saved.indexOf(slug) !== -1);
          btn.setAttribute('aria-pressed', isSaved ? 'true' : 'false');
          const svg = btn.querySelector('svg');
          btn.classList.toggle('text-terracotta-deep', isSaved);
          if (svg) svg.setAttribute('fill', isSaved ? 'currentColor' : 'none');
        });

        const cards = document.querySelectorAll('[data-event-card]');
        let visibleCount = 0;
        cards.forEach(function (card) {
          const slug = card.getAttribute('data-event-slug');
          const show = !savedOnlyActive || (slug && saved.indexOf(slug) !== -1);
          card.classList.toggle('hidden', !show);
          if (show) visibleCount++;
        });

        if (visibleCountEl && cards.length > 0) {
          visibleCountEl.textContent = String(visibleCount);
        }
        if (visibleUnitEl && cards.length > 0) {
          visibleUnitEl.textContent = visibleCount === 1 ? 'event' : 'events';
        }

        if (savedFilterBtn) {
          savedFilterBtn.classList.toggle('bg-terracotta', Boolean(savedOnlyActive));
          savedFilterBtn.classList.toggle('text-white', Boolean(savedOnlyActive));
          savedFilterBtn.classList.toggle('border-terracotta', Boolean(savedOnlyActive));
          savedFilterBtn.classList.toggle('bg-white', !savedOnlyActive);
        }

        if (savedEmptyState) {
          savedEmptyState.classList.toggle('hidden', !(savedOnlyActive && visibleCount === 0));
        }
      }

      document.addEventListener('click', function (e) {
        const btn = (e.target as Element | null)?.closest('[data-favorite-btn]');
        if (!btn) return;
        e.preventDefault();
        const slug = btn.getAttribute('data-event-slug');
        if (!slug) return;
        const current = readSavedSlugs();
        const idx = current.indexOf(slug);
        if (idx === -1) {
          current.push(slug);
        } else {
          current.splice(idx, 1);
        }
        writeSavedSlugs(current);
        syncFavoriteUi();
      });

      if (savedFilterBtn) {
        savedFilterBtn.addEventListener('click', function () {
          savedOnlyActive = !savedOnlyActive;
          savedFilterBtn.setAttribute('data-saved-active', savedOnlyActive ? 'true' : 'false');
          syncFavoriteUi();
        });
      }

      if (clearSavedBtn) {
        clearSavedBtn.addEventListener('click', function () {
          savedOnlyActive = false;
          if (savedFilterBtn) savedFilterBtn.setAttribute('data-saved-active', 'false');
          syncFavoriteUi();
        });
      }

      // Opt-in browser geolocation (never prompts on load)
      const locBtn = document.getElementById('use-my-location-btn');
      const locLabel = document.getElementById('use-my-location-label');
      const locStatus = document.getElementById('location-status-msg');

      function nearestMetro(lat: number, lng: number) {
        const toRad = function (d: number) {
          return (d * Math.PI) / 180;
        };
        let best = METROS[0];
        let bestDist = Infinity;
        for (let i = 0; i < METROS.length; i++) {
          const m = METROS[i];
          const dLat = toRad(m.lat - lat);
          const dLng = toRad(m.lng - lng);
          const a =
            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(toRad(lat)) * Math.cos(toRad(m.lat)) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
          const dist = 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
          if (dist < bestDist) {
            bestDist = dist;
            best = m;
          }
        }
        return best;
      }

      if (locBtn) {
        locBtn.addEventListener('click', function () {
          if (!navigator.geolocation) {
            if (locStatus) {
              locStatus.textContent = 'Your browser does not share location. Choose a city instead.';
              locStatus.classList.remove('hidden');
            }
            return;
          }
          if (locLabel) locLabel.textContent = 'Locating';
          navigator.geolocation.getCurrentPosition(
            function (pos) {
              const lat = pos.coords.latitude;
              const lng = pos.coords.longitude;
              const match = nearestMetro(lat, lng);
              if (locStatus) {
                locStatus.textContent = 'Nearest city: ' + match.name + '. Loading events.';
                locStatus.classList.remove('hidden');
              }
              const nextUrl = new URL(window.location.href);
              nextUrl.searchParams.set('metro', match.slug);
              nextUrl.searchParams.set('lat', lat.toFixed(4));
              nextUrl.searchParams.set('lng', lng.toFixed(4));
              window.location.href = nextUrl.toString();
            },
            function () {
              if (locLabel) locLabel.textContent = 'Use my location';
              if (locStatus) {
                locStatus.textContent = 'Location was not shared. Choose a city instead.';
                locStatus.classList.remove('hidden');
              }
            },
            { timeout: 8000, maximumAge: 300000 },
          );
        });
      }

      syncFavoriteUi();
    })();
  </script>
</Layout>
