---
/**
 * A6: a person's registration, reached from the signed link in their confirmation email. Shows the details,
 * the QR code (only when the organizer turned QR on) and lets them cancel. No account.
 */
import Layout from '../../layouts/Layout.astro';
import SplitScreenLayout from '@studio-gamo/ui/components/split/SplitScreenLayout.astro';
import SplitHeading from '@studio-gamo/ui/components/split/SplitHeading.astro';
import SplitNotice from '@studio-gamo/ui/components/split/SplitNotice.astro';
import SplitButton from '@studio-gamo/ui/components/split/SplitButton.astro';
import { requireSameOrigin } from '@gamo/auth';
import {
  RegistrationError,
  canceledEmail,
  cancelRegistration,
  formatLocalEventSchedule,
  getRegistration,
  qrPayload,
  qrSvg,
  sendLiveEmail,
  verifyManageToken,
} from '@gamo/domain';
import { openLive, whenWhere } from '../../lib/registration';

export const prerender = false;

const token = Astro.params.token ?? '';
let notice: string | undefined;
let unavailable = false;
let reg = null as Awaited<ReturnType<typeof getRegistration>>;
let when = '';
let venue = '';
let eventTitle = '';
let qr = '';

try {
  const live = await openLive(Astro);
  const now = Math.floor(Date.now() / 1000);
  const id = await verifyManageToken(live.env, token, now);
  reg = id ? await getRegistration(live.db, id) : null;
  if (!reg) return new Response(null, { status: 404 });
  const event = await live.catalog.getEvent(reg.eventSlug);
  if (event) {
    const details = whenWhere(event, new Date(reg.startsAt * 1000));
    when = formatLocalEventSchedule(null, null, reg.timezone, new Date(reg.startsAt * 1000)).fullLabel;
    venue = details.venueLabel;
    eventTitle = event.title;

    if (Astro.request.method === 'POST') {
      try {
        requireSameOrigin(Astro.request);
      } catch {
        return new Response('Forbidden', { status: 403 });
      }
      const form = await Astro.request.formData();
      if (form.get('action') === 'cancel') {
        try {
          await cancelRegistration(live.db, reg.id, now);
          reg = await getRegistration(live.db, reg.id);
          notice = 'Your registration is canceled and your seats are released.';
          await sendLiveEmail(
            live.env,
            canceledEmail(reg!.email, reg!.name, { ...details, whenLabel: when }),
          ).catch(() => {});
        } catch (error) {
          if (!(error instanceof RegistrationError)) throw error;
          notice = 'This registration is already canceled.';
        }
      }
    }
  }
  if (reg && reg.status === 'confirmed' && reg.checkinCode) qr = qrSvg(qrPayload(reg.checkinCode));
} catch (error) {
  if (error instanceof Response) throw error;
  console.error('[live:manage] failed', (error as Error)?.name);
  unavailable = true;
}

const isNew = Astro.url.searchParams.get('new') === '1';
const past = reg ? reg.startsAt * 1000 <= Date.now() : false;
---

<Layout title="Your registration" chrome={false} noindex>
  <SplitScreenLayout photo="girlGuitar" position="48% 20%" program="Gamo Live" brandHref="/">
    <SplitHeading
      title={
        reg?.status === 'canceled'
          ? 'Registration canceled'
          : isNew
            ? "You're registered"
            : 'Your registration'
      }
      subtext={reg?.status === 'confirmed' ? 'We also emailed you this link. Keep it private.' : undefined}
    />
    {unavailable && (
      <SplitNotice tone="error">This page is temporarily unavailable. Please try again later.</SplitNotice>
    )}
    {notice && <SplitNotice>{notice}</SplitNotice>}
    {reg && (
      <div class="mb-6 rounded-2xl border border-sand bg-white px-5 py-4">
        <p class="text-[18px] font-bold leading-snug text-ink">{eventTitle || reg.eventTitle}</p>
        <p class="mt-2 text-[14px] text-ink">{when}</p>
        <p class="text-[14px] text-muted">{venue}</p>
        <p class="mt-3 text-[14px] text-ink">
          {reg.name} · {reg.partySize} {reg.partySize === 1 ? 'person' : 'people'}
          {reg.checkedInAt ? ' · Checked in' : ''}
        </p>
        {past && reg.status === 'confirmed' && <p class="mt-2 text-[13px] text-muted">Past · Closed</p>}
      </div>
    )}
    {qr && (
      <figure class="mb-6">
        <div
          class="mx-auto h-48 w-48 rounded-2xl border border-sand bg-white p-3"
          aria-hidden="true"
          set:html={qr}
        />
        <figcaption class="mt-2 text-center text-[13px] text-muted">
          Show this at the door. Check-in code:{' '}
          <span class="font-mono font-semibold text-ink">{reg!.checkinCode}</span>
        </figcaption>
      </figure>
    )}
    {reg && reg.status === 'confirmed' && !past && (
      <form method="post">
        <input type="hidden" name="action" value="cancel" />
        <SplitButton label="Cancel my registration" variant="quiet" />
      </form>
    )}
    {reg && (
      <p class="mt-6 text-[14px]">
        <a class="font-semibold text-terracotta underline" href={`/events/${reg.eventSlug}`}>
          View the event
        </a>
      </p>
    )}
  </SplitScreenLayout>
</Layout>
