---
/**
 * Edit an event (organizer). Details, policies and ticket types; once tickets exist the date and venue
 * are changed through "Event changes" so holders are told. Changing public details of an event that still
 * needs review sends it back to review (CLEANUP_LOG D-168).
 */
import Layout from '../../../../layouts/Layout.astro';
import PageHeader from '../../../../components/shared/PageHeader.astro';
import EventForm from '../../../../components/organizer/EventForm.astro';
import { requireSameOrigin } from '@gamo/auth';
import { eventHasOrders, nowSeconds, parseEventForm, updateOrganizerEvent } from '@gamo/domain';
import { organizerEventGate } from '../../../../lib/organizer-event';
import { valuesFromEvent, valuesFromForm } from '../../../../lib/event-form-values';
import { problemFromError, type FormProblem } from '../../../../lib/page-forms';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const gate = await organizerEventGate(Astro, ['edit_content', 'manage_ticketing']);
if (gate instanceof Response) return gate;
const { auth, db, event } = gate;

const loaded = await valuesFromEvent(db, event.id);
let values = loaded?.values ?? {};
const reserved = loaded?.reserved ?? {};
const datesLocked = await eventHasOrders(db, event.id);
let problem: FormProblem | null = null;
let notice: string | null = null;
let status = event.status;

if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
    const form = await Astro.request.formData();
    values = valuesFromForm(form);
    const input = parseEventForm(form);
    const saved = await updateOrganizerEvent(db, {
      eventId: event.id,
      event: { ...input, organizationId: '' },
      actorUserId: auth.user.id,
      now: nowSeconds(),
    });
    status = saved.status;
    notice = saved.movedToReview
      ? 'Saved. Because you changed public details, staff review the event again before it is shown and tickets are sold. Tickets already issued stay valid.'
      : 'Changes saved.';
    const again = await valuesFromEvent(db, event.id);
    if (again) values = again.values;
  } catch (err) {
    problem = problemFromError(err);
    Astro.response.status = problem.status;
  }
} else if (Astro.url.searchParams.get('saved')) {
  notice =
    Astro.url.searchParams.get('saved') === 'approved'
      ? 'Your event is published.'
      : 'Your event was submitted. Staff review your first event before it is published; nothing is sold until then.';
}
---

<Layout title={`Edit — ${event.title}`} noindex>
  <PageHeader
    eyebrow={`Status: ${status.replaceAll('_', ' ')}`}
    title={event.title}
    lede="Edit your event, its ticket types and policies."
    back={{ href: '/workspaces', label: 'Workspace' }}
  >
    <a
      class="inline-flex min-h-11 items-center rounded-full border border-ink px-5 py-2.5 text-sm font-bold text-ink hover:bg-sand"
      href={`/promote/events/${event.id}/orders`}
    >
      Orders and refunds
    </a>
    <a
      class="inline-flex min-h-11 items-center rounded-full border border-ink px-5 py-2.5 text-sm font-bold text-ink hover:bg-sand"
      href={`/promote/events/${event.id}/changes`}
    >
      Event changes
    </a>
  </PageHeader>
  <section class="bg-cream px-4 pb-20 sm:px-8">
    <div class="space-y-6 py-8">
      {notice && (
        <p
          role="status"
          class="mx-auto max-w-3xl rounded-2xl bg-white p-4 font-semibold text-ink ring-1 ring-sand"
        >
          {notice}
        </p>
      )}
      <EventForm
        action={`/promote/events/${event.id}/edit`}
        values={values}
        problem={problem}
        datesLocked={datesLocked}
        reserved={reserved}
        submitLabel="Save changes"
        spareRows={1}
      />
    </div>
  </section>
</Layout>
