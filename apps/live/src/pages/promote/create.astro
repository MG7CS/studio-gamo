---
/**
 * Create an event (organizers). JS-light multi-section form: date and time in the venue's time zone,
 * ticket types, policies. A new organizer's first event goes to staff review; later events publish
 * once the organizer is verified (design §4.4).
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import JourneyPanel from '../../components/shared/JourneyPanel.astro';
import EventForm from '../../components/organizer/EventForm.astro';
import { getDb } from '@gamo/db';
import { resolveAuth, requireSameOrigin } from '@gamo/auth';
import { createOrganizerEvent, getRuntimeEnv, nowSeconds, parseEventForm, ticketingDb } from '@gamo/domain';
import { problemFromError, see, type FormProblem } from '../../lib/page-forms';
import { valuesFromForm } from '../../lib/event-form-values';

export const prerender = false;

const env = (await getRuntimeEnv(Astro)) as Record<string, unknown> &
  Awaited<ReturnType<typeof getRuntimeEnv>>;
const auth = await resolveAuth(Astro.request, getDb(env.DB), {
  secret: env.SESSION_SECRET,
  product: 'live',
  env,
});
if (!auth) return Astro.redirect('/account/signin?next=%2Fpromote%2Fcreate', 303);

Astro.response.headers.set('Cache-Control', 'private, no-store');
const memberships = auth.memberships.filter((m) => ['owner', 'admin'].includes(m.role));
let values: Record<string, string> = {
  category: 'worship',
  admissionType: 'free',
  timezone: 'America/Phoenix',
  'cat.0.name': 'General admission',
  'cat.0.kind': 'general',
  'cat.0.price': '0',
};
let problem: FormProblem | null = null;

if (Astro.request.method === 'POST' && memberships.length) {
  try {
    requireSameOrigin(Astro.request);
    const form = await Astro.request.formData();
    values = valuesFromForm(form);
    const input = parseEventForm(form);
    if (!memberships.some((m) => m.organizationId === input.organizationId)) throw new Error('FORBIDDEN');
    const saved = await createOrganizerEvent(ticketingDb(env), {
      event: input,
      actorUserId: auth.user.id,
      now: nowSeconds(),
    });
    return see(`/promote/events/${saved.eventId}/edit?saved=${saved.status}`);
  } catch (err) {
    problem =
      err instanceof Error && err.message === 'FORBIDDEN'
        ? {
            status: 403,
            message: 'You can only publish for organizations you own or administer.',
            summary: [
              {
                message: 'You can only publish for organizations you own or administer.',
                fieldId: 'organizationId',
              },
            ],
            fields: {},
            remaining: [],
            headers: {},
          }
        : problemFromError(err);
    Astro.response.status = problem.status;
  }
}
---

<Layout title="List an Event" noindex>
  <PageHeader
    eyebrow="Event submission"
    title="Tell us about your gathering."
    lede="Your first event is reviewed by our team before it is published. Later events go live after your organization is verified."
  >
    <a
      href="/workspaces"
      class="inline-flex min-h-11 items-center gap-1.5 rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-ink hover:bg-cream transition-colors"
    >
      Manage submitted events &rarr;
    </a>
  </PageHeader>

  {memberships.length ? (
    <section class="bg-cream px-4 pb-20 sm:px-8">
      <div class="py-8">
        <EventForm
          action="/promote/create"
          values={values}
          problem={problem}
          memberships={memberships}
          submitLabel="Save and submit"
        />
      </div>
    </section>
  ) : (
    <JourneyPanel
      title="Set up your organization first"
      body="An organization connects your submission to the church, ministry or team you represent. Only its owners and administrators can submit events."
      href="/account"
      label="Set up your organization"
    />
  )}
</Layout>
