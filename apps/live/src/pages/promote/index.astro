---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import FaqAccordion from '@studio-gamo/ui/components/FaqAccordion.astro';
import PromoteHero from '../../components/promote/PromoteHero.astro';
import PromoteSteps from '../../components/promote/PromoteSteps.astro';
import PromoteCommitments from '../../components/promote/PromoteCommitments.astro';
import TrustLegend from '../../components/shared/TrustLegend.astro';
export const prerender = true;
const faqs = [
  { q: 'Who can list an event?', a: 'We welcome churches, ministries, and Christian organizers nationwide. Eligibility is based on the event’s Christian purpose, never ethnicity or nationality.' },
  { q: 'Does it cost anything?', a: 'Free events are free to list. Any Gamo administrative allocation on paid tickets is always shown as a separate line item.' },
  { q: 'Can I use my own ticketing?', a: 'Yes — listings can link directly to an external ticket source, clearly labeled for guests.' },
  { q: 'How are listings reviewed?', a: 'Every submitted event is reviewed by our team to verify organizer contact details and gathering information before publishing.' },
];
---
<Layout title="Promote your Christian event" headerTheme="light">
  <PromoteHero />
  <PromoteSteps />
  <PromoteCommitments />
  <section class="bg-ivory px-4 py-16 sm:px-8 lg:py-20">
    <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[1fr_1fr]">
      <TrustLegend compact />
      <div><h2 class="section-subheading mb-6">Questions organizers ask</h2><FaqAccordion items={faqs} /></div>
    </div>
  </section>
  <CtaInvitation eyebrow="Organizer tools" title="Submit your gathering." body="Complete the five-step builder — description, schedule, venue, registration, and review — to share your event with the community." photo="acousticLeaderAlt">
    <ButtonLink href="/promote/create" arrow>Open the event builder</ButtonLink>
    <ButtonLink href="/" variant="secondary">Explore events</ButtonLink>
  </CtaInvitation>
</Layout>
