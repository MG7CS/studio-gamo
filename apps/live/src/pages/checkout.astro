---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-xl mx-auto py-12 px-4">
    <h1 class="text-3xl font-bold mb-8">Checkout</h1>
    <div class="bg-yellow-50 border border-yellow-200 p-4 rounded-lg mb-8">
      <p class="text-sm text-yellow-800">Simulated checkout. Seat reservations use Durable Objects in production.</p>
    </div>
    <form class="space-y-4" action="/ticket">
      <button class="w-full bg-[#1D2323] text-white py-3 rounded-lg font-bold">Pay & Get Ticket</button>
    </form>
  </main>
</Layout>
