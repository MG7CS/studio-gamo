---
import ArtistProfileForm from '../components/organizer/ArtistProfileForm.astro';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/shared/PageHeader.astro';
import JourneyPanel from '../components/shared/JourneyPanel.astro';
import { getDb } from '@gamo/db';
import { resolveAuth } from '@gamo/auth';
import { getRuntimeEnv } from '@gamo/domain';
export const prerender = false;
const env = await getRuntimeEnv(Astro);
const db = getDb(env.DB);
const auth = await resolveAuth(Astro.request, db, {
  secret: env.SESSION_SECRET,
  product: 'live',
  env,
});
if (!auth) return Astro.redirect('/account/signin?next=%2Fworkspaces', 303);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const memberships = auth.memberships.filter((m) => ['owner', 'admin'].includes(m.role));
const orgIds = memberships.map((m) => m.organizationId);
const profiles = orgIds.length
  ? await db.query.organizerProfiles.findMany({
      where: (p, { inArray }) => inArray(p.organizationId, orgIds),
    })
  : [];
const profileIds = profiles.map((p) => p.id);
const listings = profileIds.length
  ? await db.query.events.findMany({
      where: (e, { inArray }) => inArray(e.organizerId, profileIds),
      orderBy: (e, { desc }) => [desc(e.createdAt)],
    })
  : [];
const artists = await db.query.artistProfiles.findMany({ where: (a, { eq }) => eq(a.userId, auth.user.id) });
---

<Layout title="Your workspace">
  <PageHeader
    title={auth.user.displayName ? `Welcome, ${auth.user.displayName}.` : 'Welcome to Gamo Live.'}
    lede="Manage your submitted events, organizations, and artist profiles."
  />
  <JourneyPanel
    title="Submitted events"
    body={
      listings.length
        ? 'Submissions remain private until reviewed by our team.'
        : 'No events have been submitted for your organizations yet.'
    }
    href={memberships.length ? '/promote/create' : '/account'}
    label={memberships.length ? 'List an event' : 'Set up an organization'}
  >
    {listings.length > 0 && (
      <ul class="mt-8 divide-y divide-sand">
        {listings.map((event) => (
          <li class="py-5">
            <h3 class="text-xl font-semibold text-charcoal">{event.title}</h3>
            <p class="mt-1.5 text-sm text-charcoal">
              {event.city}, {event.state} · {event.status.replaceAll('_', ' ')}
            </p>
            <p class="mt-1 text-sm text-ink-soft">
              {event.startsAt.toLocaleString('en-US', { timeZone: event.timezone })} ({event.timezone})
            </p>
          </li>
        ))}
      </ul>
    )}
  </JourneyPanel>
  <JourneyPanel
    title="Artist profiles"
    body={
      artists.length
        ? 'Artist profiles linked to your account.'
        : 'Create an artist profile to manage your presence on Gamo Live.'
    }
  >
    {artists.length > 0 && (
      <ul class="mt-5 divide-y divide-sand">
        {artists.map((artist) => (
          <li class="py-3 font-semibold text-charcoal">{artist.stageName}</li>
        ))}
      </ul>
    )}
  </JourneyPanel>
  {!artists.length && <ArtistProfileForm />}
</Layout>
