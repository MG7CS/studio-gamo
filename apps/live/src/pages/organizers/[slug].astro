---
import Layout from '../../layouts/Layout.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import EventCard from '../../components/shared/EventCard.astro';
import { events, organizers, type Organizer } from '../../data/events';
export const prerender = true;
export function getStaticPaths() {
  return organizers.map((o) => ({ params: { slug: o.slug }, props: { org: o } }));
}
const { org } = Astro.props as { org: Organizer };
const list = events.filter((e) => e.organizer === org.slug);
---
<Layout title={`${org.name} (sample organizer)`} headerTheme="light">
  <header class="bg-cream px-4 pb-12 pt-28 sm:px-8 lg:pt-36">
    <div class="mx-auto grid max-w-[1320px] items-end gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <a href="/" class="text-sm font-medium text-ink-soft hover:text-terracotta">← Explore events</a>
        <div class="mt-6 flex flex-wrap gap-2"><StatusPill kind="sample">Sample organizer</StatusPill><StatusPill kind="info">Not verified — design preview</StatusPill></div>
        <h1 class="display-lg mt-4 text-balance">{org.name}</h1>
        <p class="mt-2 text-lg font-medium text-terracotta">{org.kind} · {org.city}</p>
        <p class="mt-5 max-w-xl text-lg text-ink-soft">{org.bio}</p>
      </div>
      <div class="aspect-[4/3] overflow-hidden rounded-[32px_32px_32px_180px]"><Photo name={org.photo} sizes="(min-width:1024px) 40vw, 100vw" priority class="h-full w-full object-cover" alt="" /></div>
    </div>
  </header>
  <section class="bg-ivory px-4 py-16 sm:px-8">
    <div class="mx-auto max-w-[1320px]">
      <DemoNotice>This organizer is fictional. Verification badges appear only after a real review process, which is not yet running.</DemoNotice>
      <h2 class="section-subheading mt-10">Upcoming sample events</h2>
      <ul class="mt-8 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">{list.map((e) => <li><EventCard event={e} /></li>)}</ul>
    </div>
  </section>
</Layout>
