---
/**
 * LOCAL-ONLY test inbox (CLEANUP_LOG D-154): the plain-text parts of the emails the local outbox
 * "sent" to an address (1 hour). Lets browser tests read the verification code and links without
 * a mail provider. Answers 404 unless ENVIRONMENT=local.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import { getRuntimeEnv, readLocalTestInbox } from '@gamo/domain';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const env = (await getRuntimeEnv(Astro)) as Record<string, unknown> &
  Awaited<ReturnType<typeof getRuntimeEnv>>;
if (env.ENVIRONMENT !== 'local')
  return new Response('Not found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
const email = Astro.url.searchParams.get('email') ?? '';
const messages = email ? ((await readLocalTestInbox(env, email)) ?? []) : [];
---

<Layout title="Local test inbox" noindex>
  <PageHeader
    eyebrow="Local development only"
    title="Test inbox"
    lede="Emails the local outbox simulated. Not a real mailbox."
  />
  <section class="bg-cream px-4 pb-20 sm:px-8">
    <div class="mx-auto max-w-3xl space-y-4 py-8">
      <form method="get" class="flex flex-wrap items-end gap-3">
        <label class="font-semibold text-ink" for="inbox-email">
          Address
          <input
            id="inbox-email"
            name="email"
            type="email"
            value={email}
            class="mt-1 block min-h-11 w-72 max-w-full rounded-xl border border-ink/50 bg-white px-3"
          />
        </label>
        <button type="submit" class="min-h-11 rounded-full bg-terracotta px-5 font-bold text-white">
          Show
        </button>
      </form>
      {email && messages.length === 0 && <p class="text-ink">No messages for this address yet.</p>}
      <ol class="space-y-3">
        {messages.map((m) => (
          <li class="rounded-2xl bg-white p-4 ring-1 ring-sand" data-kind={m.kind}>
            <h2 class="font-bold text-ink">{m.subject}</h2>
            <pre class="mt-2 whitespace-pre-wrap break-words text-sm text-ink">{m.text}</pre>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
