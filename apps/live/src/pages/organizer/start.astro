---
/** First sign-in: create the organization you list events for, in three short screens. Owners can invite others later. */
import Layout from '../../layouts/Layout.astro';
import SplitScreenLayout from '@studio-gamo/ui/components/split/SplitScreenLayout.astro';
import SplitHeading from '@studio-gamo/ui/components/split/SplitHeading.astro';
import SplitNotice from '@studio-gamo/ui/components/split/SplitNotice.astro';
import OrganizationSetupForm from '../../components/organizer/OrganizationSetupForm.astro';
import { requireSameOrigin } from '@gamo/auth';
import type { SetupErrors, SetupStep } from '@gamo/domain';
import { organizerPage } from '../../lib/organizer-session';
import { runOrganizationSetup, type SetupValues } from '../../lib/organizer-setup';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro, { needOrganization: false });
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (ctx?.active) return Astro.redirect('/organizer', 303);

let step: SetupStep = 1;
let values: SetupValues = {
  name: '',
  kind: 'church',
  city: '',
  state: '',
  website: '',
  contactEmail: '',
  description: '',
  terms: false,
};
let errors: SetupErrors = {};
let notice: string | undefined;

if (!ctx) {
  Astro.response.status = 503;
  notice = 'Gamo Live is temporarily unavailable. Please try again later.';
} else if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
  } catch {
    return new Response('Forbidden', { status: 403 });
  }
  const outcome = await runOrganizationSetup({
    db: ctx.live.db,
    organizerId: ctx.organizer.id,
    form: await Astro.request.formData(),
    now: ctx.now,
    secure: Astro.url.protocol === 'https:',
  });
  if (outcome.kind === 'redirect') return outcome.response;
  ({ step, values, errors, notice } = outcome);
}
---

<Layout title="Set up your organization" chrome={false} noindex>
  <SplitScreenLayout photo="concertCrowdWide" position="46% 34%" program="Gamo Live" brandHref="/">
    <SplitHeading
      title="Set up your organization"
      subtext="Events are listed under an organization: your church, ministry, band or group. You can edit this later."
    />
    {notice && <SplitNotice tone="error">{notice}</SplitNotice>}
    {ctx && <OrganizationSetupForm step={step} values={values} errors={errors} />}
    {step === 1 && (
      <>
        <p class="mt-4 text-center text-[14px] text-muted">
          Joining an existing organization? Open the invitation link from your email.
        </p>
        {ctx && (
          <form method="post" action="/account/signout" class="mt-2 text-center text-[14px] text-muted">
            Signed in as <strong class="text-ink">{ctx.organizer.email}</strong>. Not you?
            <button type="submit" class="min-h-11 font-semibold text-terracotta-deep underline">
              Sign out
            </button>
          </form>
        )}
      </>
    )}
  </SplitScreenLayout>
</Layout>
