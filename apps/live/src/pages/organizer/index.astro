---
/** B3: overview of the signed-in organizer's organization. Every number is counted from the database. */
import OrganizerLayout from '../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../components/organizer/PageTitle.astro';
import StatCard from '../../components/organizer/StatCard.astro';
import ScheduleCalendar from '../../components/organizer/ScheduleCalendar.astro';
import ScheduleDay from '../../components/organizer/ScheduleDay.astro';
import CheckInNowCard from '../../components/organizer/CheckInNowCard.astro';
import OrganizationSummaryCard from '../../components/organizer/OrganizationSummaryCard.astro';
import EventsShortcutCard from '../../components/organizer/EventsShortcutCard.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import SplitNotice from '@studio-gamo/ui/components/split/SplitNotice.astro';
import {
  countWaitingEvents,
  listOrganizationSchedule,
  organizationCounts,
  organizationScheduleView,
} from '@gamo/domain';
import { organizerPage } from '../../lib/organizer-session';
import { ORGANIZER_STAT_LINKS } from '../../lib/organizer-stats';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro);
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx || !ctx.active) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { organizer, memberships, active } = ctx;
const counts = await organizationCounts(ctx.live.db, active.organizationId, ctx.now);
const waiting = countWaitingEvents(counts.eventsByStatus);
const schedule = organizationScheduleView({
  dates: await listOrganizationSchedule(ctx.live.db, active.organizationId),
  now: ctx.now,
  params: Astro.url.searchParams,
  anchor: '#schedule',
});
---

<OrganizerLayout
  title="Overview"
  current="overview"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
    <PageTitle
      title={`Welcome, ${organizer.displayName?.split(' ')[0] || 'organizer'}`}
      subtext={`Here is where ${active.name} stands on Gamo Live.`}
    />
    {active.status === 'active' && (
      <Button href="/organizer/events/new" class="mt-1">
        Create event
      </Button>
    )}
  </div>
  {active.status === 'suspended' && (
    <SplitNotice tone="error">
      This organization is suspended, so its events are hidden. Write to hello@gamostudio.org to ask why and
      what to do next.
    </SplitNotice>
  )}
  <CheckInNowCard open={schedule.openNow} />
  <div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard
      label="Published events"
      tone="terracotta"
      icon="check"
      value={counts.eventsByStatus.published ?? 0}
      link={ORGANIZER_STAT_LINKS.published}
    />
    <StatCard
      label="Waiting for Gamo"
      tone="amber"
      icon="clock"
      value={waiting}
      hint="In review or needing changes"
      link={ORGANIZER_STAT_LINKS.waiting}
    />
    <StatCard
      label="Upcoming dates"
      tone="plum"
      icon="calendar"
      value={counts.upcomingOccurrences}
      link={ORGANIZER_STAT_LINKS.upcoming}
    />
    <StatCard
      label="People registered"
      tone="green"
      icon="users"
      value={counts.confirmedRegistrations}
      hint="Confirmed, across all events"
      link={ORGANIZER_STAT_LINKS.registered}
    />
  </div>
  <div class="mt-3 grid items-start gap-3 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
    <ScheduleCalendar view={schedule} canCreate={active.status === 'active'} />
    <div class="space-y-3">
      <ScheduleDay view={schedule} />
      <OrganizationSummaryCard name={active.name} role={active.role} verified={active.verified} />
      <EventsShortcutCard
        hasEvents={(counts.eventsByStatus.published ?? 0) + waiting > 0}
        canCreate={active.status === 'active'}
      />
    </div>
  </div>
</OrganizerLayout>
