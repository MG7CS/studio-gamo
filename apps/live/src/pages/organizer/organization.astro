---
/**
 * The organization: who it is, its profile (read view, owners edit in place), and its members and invitations. Owners
 * edit; members read. Verification is set only by Gamo and is shown here, never editable.
 */
import OrganizerLayout from '../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../components/organizer/PageTitle.astro';
import OrganizationHeader from '../../components/organizer/OrganizationHeader.astro';
import OrganizationProfile from '../../components/organizer/OrganizationProfile.astro';
import MembersPanel from '../../components/organizer/MembersPanel.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import { requireSameOrigin } from '@gamo/auth';
import { getOrganization, listInvitations, listMembers, type SetupErrors } from '@gamo/domain';
import { organizerPage } from '../../lib/organizer-session';
import { runOrganizationAction } from '../../lib/organization-page';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro);
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx || !ctx.active) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { live, organizer, memberships, active, now } = ctx;
const isOwner = active.role === 'owner';
const orgId = active.organizationId;

let notice: { tone: 'info' | 'error'; text: string } | undefined;
let profileErrors: SetupErrors = {};
let inviteError: string | undefined;
let formValues: Record<string, string> | undefined;
let editing = isOwner && Astro.url.searchParams.get('edit') === '1';

if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
  } catch {
    return new Response('Forbidden', { status: 403 });
  }
  const result = await runOrganizationAction({
    live,
    organizer,
    active,
    form: await Astro.request.formData(),
    origin: Astro.url.origin,
    now,
  });
  if (result.redirect) return Astro.redirect(result.redirect, 303);
  ({ notice, inviteError, profileErrors = {}, profileValues: formValues } = result);
  editing = Boolean(result.editing);
}

const organization = await getOrganization(live.db, orgId);
if (!organization) return new Response(null, { status: 404 });
const members = await listMembers(live.db, orgId);
const invitations = isOwner ? await listInvitations(live.db, orgId, now) : [];
const values: Record<string, string> = formValues ?? {
  name: organization.name,
  kind: organization.kind,
  city: organization.city ?? '',
  state: organization.state ?? '',
  website: organization.website ?? '',
  contactEmail: organization.contactEmail ?? '',
  description: organization.description ?? '',
};
---

<OrganizerLayout
  title="Organization"
  current="organization"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <PageTitle title="Organization" subtext="Who you are on Gamo Live, and who can manage your events." />
  {notice && (
    <Notice tone={notice.tone === 'error' ? 'danger' : 'success'} class="mb-3">
      {notice.text}
    </Notice>
  )}
  <div class="grid items-start gap-3 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
    <div class="space-y-3">
      <OrganizationHeader organization={organization} role={active.role} />
      <OrganizationProfile
        organization={organization}
        isOwner={isOwner}
        editing={editing}
        values={values}
        errors={profileErrors}
      />
    </div>
    <MembersPanel
      members={members}
      invitations={invitations}
      isOwner={isOwner}
      selfId={organizer.id}
      suspended={organization.status === 'suspended'}
      firstEventApproved={organization.firstEventApproved}
      inviteError={inviteError}
    />
  </div>
</OrganizerLayout>
