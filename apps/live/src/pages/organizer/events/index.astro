---
/** B4: all of the organization's events, filterable by status and searchable. */
import OrganizerLayout from '../../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../../components/organizer/PageTitle.astro';
import Panel from '../../../components/organizer/Panel.astro';
import EventStatusPill from '../../../components/organizer/EventStatusPill.astro';
import { EVENT_STATUS_LABELS, listOrganizerEvents, organizationCounts } from '@gamo/domain';
import { organizerPage } from '../../../lib/organizer-session';
import { whenLabel } from '../../../lib/organizer-format';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro);
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx || !ctx.active) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { organizer, memberships, active, live, now } = ctx;
const status = Astro.url.searchParams.get('status') ?? '';
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const [events, counts] = await Promise.all([
  listOrganizerEvents(live.db, active.organizationId, { status, q }, now),
  organizationCounts(live.db, active.organizationId, now),
]);
const total = Object.values(counts.eventsByStatus).reduce((a, b) => a + b, 0);
const filters = ['', ...Object.keys(EVENT_STATUS_LABELS).filter((s) => (counts.eventsByStatus[s] ?? 0) > 0)];
const href = (s: string) =>
  `/organizer/events${s || q ? `?${new URLSearchParams({ ...(s ? { status: s } : {}), ...(q ? { q } : {}) })}` : ''}`;
---

<OrganizerLayout
  title="Events"
  current="events"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <PageTitle title="Events" subtext={`Everything ${active.name} has listed on Gamo Live.`} />
    {active.status === 'active' && (
      <a
        href="/organizer/events/new"
        class="inline-flex min-h-12 items-center rounded-full bg-terracotta px-6 text-[15px] font-semibold text-white hover:bg-terracotta-deep"
      >
        Create event
      </a>
    )}
  </div>
  <Panel id="list">
    <form method="get" class="flex flex-wrap items-center gap-3" role="search">
      {status && <input type="hidden" name="status" value={status} />}
      <label for="q" class="sr-only">
        Search your events
      </label>
      <input
        id="q"
        name="q"
        type="search"
        value={q}
        placeholder="Search by title or venue"
        class="min-h-11 min-w-[220px] flex-1 rounded-full border border-ink/30 bg-white px-5 text-[15px] text-ink focus:border-terracotta focus:outline-none focus:ring-2 focus:ring-terracotta/20"
      />
      <button
        type="submit"
        class="min-h-11 rounded-full border border-ink/30 bg-white px-5 text-[14px] font-semibold text-ink hover:bg-sand"
      >
        Search
      </button>
    </form>
    {total > 0 && (
      <nav aria-label="Filter by status" class="mt-4 flex flex-wrap gap-2">
        {filters.map((s) => (
          <a
            href={href(s)}
            aria-current={status === s ? 'page' : undefined}
            class:list={[
              'inline-flex min-h-11 items-center rounded-full px-4 text-[14px] font-semibold',
              status === s ? 'bg-ink text-white' : 'bg-sand text-ink hover:bg-tan',
            ]}
          >
            {s ? EVENT_STATUS_LABELS[s] : 'All'}
            {s ? ` (${counts.eventsByStatus[s]})` : ` (${total})`}
          </a>
        ))}
      </nav>
    )}
    {events.length === 0 ? (
      <p class="mt-6 text-[15px] leading-relaxed text-ink">
        {total === 0
          ? 'You have not created an event yet. Create your first one to list it on Gamo Live.'
          : 'No events match that search or filter.'}
      </p>
    ) : (
      <ul class="mt-6 divide-y divide-sand">
        {events.map((e) => {
          const shown = e.nextStartsAt ?? e.firstStartsAt;
          return (
            <li class="py-4">
              <a
                href={`/organizer/events/${e.id}`}
                class="flex flex-wrap items-center justify-between gap-3 rounded-2xl p-2 hover:bg-sand/50"
              >
                <span class="min-w-0">
                  <span class="block truncate text-[17px] font-bold text-ink">{e.title}</span>
                  <span class="block text-[14px] text-muted">
                    {shown ? whenLabel(shown, e.timezone) : 'No date'}
                    {e.occurrenceCount > 1 ? ` · ${e.occurrenceCount} dates` : ''} · {e.venueName}, {e.city}
                  </span>
                  {e.admission === 'free_registration' && (
                    <span class="block text-[13px] text-muted">
                      {e.peopleRegistered} {e.peopleRegistered === 1 ? 'person' : 'people'} registered
                    </span>
                  )}
                </span>
                <EventStatusPill status={e.status} />
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </Panel>
</OrganizerLayout>
