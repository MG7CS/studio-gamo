---
/** B4: all of the organization's events, filterable by status and searchable. */
import OrganizerLayout from '../../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../../components/organizer/PageTitle.astro';
import Toolbar from '@studio-gamo/ui/components/ui/Toolbar.astro';
import EventRow from '../../../components/organizer/EventRow.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import {
  EVENT_FILTER_LABELS,
  EVENT_STATUS_LABELS,
  WAITING_FILTER,
  countWaitingEvents,
  listOrganizerEvents,
  organizationCounts,
} from '@gamo/domain';
import { organizerPage } from '../../../lib/organizer-session';
import { whenLabel } from '../../../lib/organizer-format';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro);
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx || !ctx.active) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { organizer, memberships, active, live, now } = ctx;
const status = Astro.url.searchParams.get('status') ?? '';
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const [events, counts] = await Promise.all([
  listOrganizerEvents(live.db, active.organizationId, { status, q }, now),
  organizationCounts(live.db, active.organizationId, now),
]);
const total = Object.values(counts.eventsByStatus).reduce((a, b) => a + b, 0);
const waitingCount = countWaitingEvents(counts.eventsByStatus);
const filters = [
  '',
  ...(waitingCount > 0 ? [WAITING_FILTER] : []),
  ...Object.keys(EVENT_STATUS_LABELS).filter((s) => (counts.eventsByStatus[s] ?? 0) > 0),
];
const countFor = (s: string) => (s === WAITING_FILTER ? waitingCount : counts.eventsByStatus[s]);
const href = (s: string) =>
  `/organizer/events${s || q ? `?${new URLSearchParams({ ...(s ? { status: s } : {}), ...(q ? { q } : {}) })}` : ''}`;
const chips =
  total > 0
    ? filters.map((s) => ({
        label: s ? EVENT_FILTER_LABELS[s] : 'All',
        href: href(s),
        active: status === s,
        count: s ? countFor(s) : total,
      }))
    : [];
---

<OrganizerLayout
  title="Events"
  current="events"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <PageTitle title="Events" subtext={`Everything ${active.name} has listed on Gamo Live.`} />
    {active.status === 'active' && <Button href="/organizer/events/new">Create event</Button>}
  </div>
  <div class="space-y-3">
    <Toolbar
      search={{
        label: 'Search your events',
        value: q,
        placeholder: 'Search by title or venue',
        keep: { status },
      }}
      groups={[{ label: 'Filter by status', items: chips }]}
    />
    {events.length === 0 ? (
      <EmptyState
        title={total === 0 ? 'No events yet' : 'No events match'}
        text={
          total === 0
            ? 'Create your first event to list it on Gamo Live.'
            : 'Nothing matches that search or filter. Clear it to see everything.'
        }
      >
        {total === 0 && active.status === 'active' && (
          <Button href="/organizer/events/new">Create event</Button>
        )}
      </EmptyState>
    ) : (
      <ul class="space-y-2">
        {events.map((e) => (
          <li>
            <EventRow
              id={e.id}
              title={e.title}
              whenText={
                (e.nextStartsAt ?? e.firstStartsAt)
                  ? whenLabel((e.nextStartsAt ?? e.firstStartsAt)!, e.timezone)
                  : 'No date'
              }
              place={`${e.venueName}, ${e.city}`}
              dates={e.occurrenceCount}
              status={e.status}
              registered={e.admission === 'free_registration' ? e.peopleRegistered : null}
            />
          </li>
        ))}
      </ul>
    )}
  </div>
</OrganizerLayout>
