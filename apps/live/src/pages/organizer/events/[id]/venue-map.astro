---
/**
 * Organizer: venue blueprint upload, section editor (click-to-draw island, numeric alternative and a
 * plain points field) and a buyer preview of the section picker (design §5.6).
 */
import OrganizerPageShell from '../../../../components/organizer/OrganizerPageShell.astro';
import OrganizerNotice from '../../../../components/organizer/OrganizerNotice.astro';
import VenueMapUpload from '../../../../components/organizer/VenueMapUpload.astro';
import SectionForm from '../../../../components/organizer/SectionForm.astro';
import SectionShapeEditor from '../../../../components/organizer/SectionShapeEditor.astro';
import SectionPicker from '../../../../components/venue/SectionPicker.astro';
import { allRows } from '@gamo/domain/security';
import {
  activeVenueMap,
  getSectionAvailability,
  listSections,
  parsePoints,
  saveSection,
  uploadVenueMap,
} from '@gamo/domain/scanner';
import type { R2BucketLike } from '@studio-gamo/integrations';
import {
  nowSeconds,
  parseMoney,
  readPostedForm,
  resolveOrganizerEvent,
} from '../../../../lib/organizer-pages';

export const prerender = false;

const eventId = Astro.params.id ?? '';
const resolved = await resolveOrganizerEvent(Astro, eventId, 'manage_ticketing');
let notice: string | null = null;
let uploadError: string | null = null;
let sectionError: { formId: string; field: string; message: string } | null = null;

if (!resolved.ok) Astro.response.status = resolved.status;
else if (Astro.request.method === 'POST') {
  const { ctx } = resolved;
  const isUpload = (Astro.request.headers.get('content-type') ?? '').startsWith('multipart/form-data');
  const form = await readPostedForm(
    Astro.request,
    isUpload ? { multipartMaxBytes: 5 * 1024 * 1024 + 64 * 1024 } : {},
  );
  if (!form.ok) {
    if (isUpload)
      uploadError = form.message.includes('too large')
        ? 'Blueprint images can be at most 5 MB (SVG 1 MB).'
        : form.message;
    else notice = form.message;
    Astro.response.status = 400;
  } else if (form.body.get('action') === 'upload') {
    const file = form.body.form?.get('file');
    const bucket = ctx.env.MEDIA_BUCKET as R2BucketLike | undefined;
    if (!bucket || typeof bucket.put !== 'function') {
      uploadError = 'File storage is not available right now. Try again later.';
      Astro.response.status = 503;
    } else if (!(file instanceof File) || file.size === 0) {
      uploadError = 'Choose a blueprint file to upload.';
      Astro.response.status = 400;
    } else {
      const result = await uploadVenueMap(ctx.db, bucket, {
        eventId,
        bytes: new Uint8Array(await file.arrayBuffer()),
        altText: form.body.get('alt') ?? '',
        now: nowSeconds(),
      });
      if (result.ok)
        notice = result.removed.length
          ? `Blueprint uploaded. Removed from the SVG for safety: ${result.removed.join(', ')}.`
          : 'Blueprint uploaded.';
      else {
        uploadError = result.message;
        Astro.response.status = 400;
      }
    }
  } else if (form.body.get('action') === 'save_section') {
    const id = form.body.get('section_id') || null;
    const formId = id ? `section-form-${id}` : 'section-form-new';
    const points = parsePoints(form.body.get('points') ?? '');
    const price = parseMoney(form.body.get('price'));
    if (points === null)
      sectionError = {
        formId,
        field: 'points',
        message: 'Write the shape as x,y pairs separated by spaces, for example 10,10 200,10 200,150.',
      };
    else if (Number.isNaN(price))
      sectionError = { formId, field: 'price', message: 'Enter a price such as 40.00, or leave it empty.' };
    else {
      const saved = await saveSection(ctx.db, {
        eventId,
        id,
        code: form.body.get('code') ?? '',
        name: form.body.get('name') ?? '',
        categoryId: form.body.get('category') ?? '',
        priceCents: price,
        capacity: Number(form.body.get('capacity') ?? ''),
        zoneCode: form.body.get('zone'),
        gateLabel: form.body.get('gate'),
        accessible: form.body.get('accessible') === '1',
        companionSeats: form.body.get('companion') === '1',
        status:
          (['active', 'hidden', 'closed'] as const).find((s) => s === form.body.get('status')) ?? 'active',
        points,
        now: nowSeconds(),
      });
      if (saved.ok) notice = id ? 'Section saved.' : 'Section added.';
      else sectionError = { formId, ...saved };
    }
    if (sectionError) Astro.response.status = 400;
  }
}

const ctx = resolved.ok ? resolved.ctx : null;
const map = ctx ? await activeVenueMap(ctx.db, eventId) : null;
const sections = ctx ? await listSections(ctx.db, eventId) : [];
const categories = ctx
  ? await allRows<{ id: string; name: string }>(ctx.db, {
      sql: 'SELECT id, name FROM ticket_tiers WHERE event_id = ?1 ORDER BY sort_order, name',
      params: [eventId],
    })
  : [];
const availability = ctx ? await getSectionAvailability(ctx.db, eventId) : null;
const formIds: Record<string, string> = Object.fromEntries([
  ...sections.map((s) => [s.id, `section-form-${s.id}`]),
  ['new', 'section-form-new'],
]);
const previewId = Astro.url.searchParams.get('sectionId');
const previewChoice = availability?.sections.find((s) => s.id === previewId) ?? null;
const errFor = (formId: string) =>
  sectionError?.formId === formId ? { field: sectionError.field, message: sectionError.message } : null;
---

<OrganizerPageShell
  title="Venue map"
  eventId={eventId}
  eventTitle={ctx?.event.title}
  current="venue-map"
  lede="Upload the floor plan, draw sections and set each section's price, capacity and zone."
  denied={resolved.ok ? null : resolved.message}
>
  {notice && (
    <OrganizerNotice kind={(Astro.response.status ?? 200) >= 400 ? 'error' : 'success'}>
      {notice}
    </OrganizerNotice>
  )}
  {ctx && <VenueMapUpload hasMap={Boolean(map)} error={uploadError} />}
  {ctx && map && <SectionShapeEditor map={map} sections={sections} formIds={formIds} />}
  {ctx && (
    <section aria-labelledby="sections" class="space-y-3">
      <h2 id="sections" class="text-xl font-black tracking-tight text-ink uppercase">
        Sections
      </h2>
      {categories.length === 0 ? (
        <OrganizerNotice kind="info">
          Add ticket categories to the event first; every section belongs to one.
        </OrganizerNotice>
      ) : (
        <div class="grid gap-4 lg:grid-cols-2">
          {sections.map((s) => (
            <SectionForm
              section={s}
              categories={categories}
              formId={formIds[s.id]!}
              error={errFor(formIds[s.id]!)}
              map={map}
            />
          ))}
          <SectionForm
            categories={categories}
            formId="section-form-new"
            error={errFor('section-form-new')}
            map={map}
          />
        </div>
      )}
    </section>
  )}
  {ctx && availability && availability.sections.length > 0 && (
    <section
      aria-labelledby="buyer-preview"
      class="space-y-3 rounded-[24px] bg-ivory p-5 ring-1 ring-sand sm:p-7"
    >
      <h2 id="buyer-preview" class="text-xl font-black tracking-tight text-ink uppercase">
        Buyer preview
      </h2>
      <p class="text-sm text-muted">
        This is how buyers choose a section at checkout. Nothing is reserved here.
      </p>
      {previewChoice && (
        <OrganizerNotice kind="success" title="Preview">
          A buyer choosing this would get: {previewChoice.label}.
        </OrganizerNotice>
      )}
      <form method="get" class="space-y-4">
        <SectionPicker
          availability={availability}
          selectedId={previewChoice?.id ?? null}
          idPrefix="preview"
          legend="Choose a section (preview)"
        />
        <button
          type="submit"
          class="min-h-11 rounded-full bg-ink px-5 text-sm font-semibold text-cream hover:bg-terracotta-deep"
        >
          Preview choice
        </button>
      </form>
    </section>
  )}
</OrganizerPageShell>
