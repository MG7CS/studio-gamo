---
/**
 * B6: one event: its status, Gamo's note, dates with registration counts, and the actions that apply
 * (edit, send for review, view public page, registrations, cancel).
 */
import OrganizerLayout from '../../../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../../../components/organizer/PageTitle.astro';
import Panel from '@studio-gamo/ui/components/ui/Panel.astro';
import EventStatusPill from '../../../../components/organizer/EventStatusPill.astro';
import SplitNotice from '@studio-gamo/ui/components/split/SplitNotice.astro';
import SplitButton from '@studio-gamo/ui/components/split/SplitButton.astro';
import { requireSameOrigin } from '@gamo/auth';
import { ADMISSIONS, eventDatesView, eventPermissions, getOrganizerEvent } from '@gamo/domain';
import { runEventPageAction } from '../../../../lib/event-page';
import EventDates from '../../../../components/organizer/EventDates.astro';
import EventActionBar from '../../../../components/organizer/EventActionBar.astro';
import { organizerPage } from '../../../../lib/organizer-session';
import { STATUS_AFTER_SAVE } from '../../../../lib/event-editor';
import Breadcrumbs from '@studio-gamo/ui/components/ui/Breadcrumbs.astro';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro);
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx || !ctx.active) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { organizer, memberships, active, live, now } = ctx;
const id = Astro.params.id ?? '';
let event = await getOrganizerEvent(live.db, active.organizationId, id, now);
if (!event) return new Response(null, { status: 404 });

let notice: { tone: 'info' | 'error'; text: string } | null = null;
const saved = Astro.url.searchParams.get('saved');
if (saved && STATUS_AFTER_SAVE[saved]) notice = { tone: 'info', text: STATUS_AFTER_SAVE[saved] };

if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
  } catch {
    return new Response('Forbidden', { status: 403 });
  }
  const result = await runEventPageAction({
    live,
    active,
    event,
    eventId: id,
    form: await Astro.request.formData(),
    now,
  });
  if (result.redirect) return Astro.redirect(result.redirect, 303);
  if (result.notice) notice = result.notice;
  event = (await getOrganizerEvent(live.db, active.organizationId, id, now)) ?? event;
}

const v = event.values;
const tz = v.timezone;
const { canSubmit, canEdit, canCancel, canDelete } = eventPermissions(
  event.status,
  active.status === 'active',
);
// The dates calendar: the view (month or week, a picker, the chosen day) comes from the address, and only real values are used.
const dates = eventDatesView({ event, timeZone: tz, now, params: Astro.url.searchParams });
const totalPeople = event.occurrences.reduce((a, o) => a + o.confirmedPeople, 0);
const admissionLabel = ADMISSIONS.find((a) => a.value === event.admission)?.label ?? event.admission;
const decisionLabel: Record<string, string> = {
  approved: 'Approved',
  changes_requested: 'Changes requested',
  rejected: 'Rejected',
};
---

<OrganizerLayout
  title={v.title}
  current="events"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <Breadcrumbs class="-mt-1" items={[{ label: 'Events', href: '/organizer/events' }, { label: v.title }]} />
  <div class="flex flex-wrap items-start justify-between gap-4">
    <PageTitle title={v.title} subtext={`${v.venueName}, ${v.city}, ${v.state}`} />
    <EventStatusPill status={event.status} />
  </div>
  {notice && !event.changeWaiting && <SplitNotice tone={notice.tone}>{notice.text}</SplitNotice>}
  {event.changeWaiting && (
    <SplitNotice tone="info">
      <strong>Your change is waiting for Gamo’s review.</strong>
      <span class="mt-1 block">
        The public page keeps showing the previous date, place and tickets until it is approved. Other edits
        are already live.
      </span>
    </SplitNotice>
  )}
  {event.decision && event.decision.decision !== 'verified' && (
    <SplitNotice tone={event.decision.decision === 'approved' ? 'info' : 'error'}>
      <strong>Gamo’s decision: {decisionLabel[event.decision.decision] ?? event.decision.decision}</strong>
      {event.decision.note ? <span class="block mt-1">{event.decision.note}</span> : null}
    </SplitNotice>
  )}
  <EventActionBar
    eventId={id}
    slug={event.slug}
    canEdit={canEdit}
    published={event.status === 'published'}
    registrations={event.admission === 'free_registration'}
    people={totalPeople}
    canCancel={canCancel}
    canDelete={canDelete}
  />
  {canSubmit && (
    <Panel
      id="submit"
      title="Ready to send?"
      description="Submitting follows your organization’s review rule."
    >
      <form method="post" class="max-w-xs">
        <input type="hidden" name="action" value="submit" />
        <SplitButton label="Submit event" />
      </form>
    </Panel>
  )}
  <dl class="mt-3 flex flex-wrap gap-x-8 gap-y-2 rounded-2xl bg-white px-4 py-3 text-[13px] shadow-[0_1px_2px_rgba(24,24,27,0.05)]">
    <div class="flex gap-2">
      <dt class="text-muted">Admission</dt>
      <dd class="font-semibold text-ink">{admissionLabel}</dd>
    </div>
    {event.capacity != null && (
      <div class="flex gap-2">
        <dt class="text-muted">Seats</dt>
        <dd class="font-semibold text-ink">{event.capacity}</dd>
      </div>
    )}
    <div class="flex gap-2">
      <dt class="text-muted">QR check-in</dt>
      <dd class="font-semibold text-ink">{event.qrCheckin ? 'On' : 'Off'}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-muted">Time zone</dt>
      <dd class="font-semibold text-ink">{tz}</dd>
    </div>
  </dl>
  <EventDates
    event={event}
    model={dates.model}
    selectedIds={dates.selectedIds}
    selectedLabel={dates.chosenLabel}
    timeZone={tz}
    now={now}
    canCancelDates={
      event.status === 'published' && event.occurrences.length > 1 && active.status === 'active'
    }
  />
</OrganizerLayout>
