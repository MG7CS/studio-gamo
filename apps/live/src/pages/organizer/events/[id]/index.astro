---
/** Organizer event dashboard: totals, sales by category and section, attendance (design §5, Agent C). */
import OrganizerPageShell from '../../../../components/organizer/OrganizerPageShell.astro';
import StatTile from '../../../../components/organizer/StatTile.astro';
import SalesTable from '../../../../components/organizer/SalesTable.astro';
import AttendanceSection from '../../../../components/organizer/AttendanceSection.astro';
import { eventDateText, nowSeconds, resolveOrganizerEvent } from '../../../../lib/organizer-pages';
import { attendanceSummary, formatMinorUnits, salesSummary } from '@gamo/domain/scanner';

export const prerender = false;

const eventId = Astro.params.id ?? '';
const resolved = await resolveOrganizerEvent(Astro, eventId, 'manage_ticketing');
if (!resolved.ok) Astro.response.status = resolved.status;
const ctx = resolved.ok ? resolved.ctx : null;
const sales = ctx ? await salesSummary(ctx.db, eventId) : null;
const attendance = ctx ? await attendanceSummary(ctx.db, eventId, nowSeconds()) : null;
const money = (cents: number) => formatMinorUnits(cents, sales?.totals.currency ?? 'usd');
---

<OrganizerPageShell
  title="Event overview"
  eventId={eventId}
  eventTitle={ctx?.event.title}
  current="overview"
  lede={ctx ? `${eventDateText(ctx.event)}${ctx.event.cancelledAt ? ' · Cancelled' : ''}` : undefined}
  denied={resolved.ok ? null : resolved.message}
>
  {ctx && sales && attendance && (
    <>
      <section aria-labelledby="totals" class="space-y-3">
        <h2 id="totals" class="text-xl font-black tracking-tight text-ink uppercase">
          Sales
        </h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <StatTile label="Orders" value={sales.totals.orders} />
          <StatTile label="Tickets" value={sales.totals.tickets} />
          {ctx.canSeePersonalData && <StatTile label="Gross" value={money(sales.totals.grossCents)} />}
          {ctx.canSeePersonalData && (
            <StatTile
              label="After refunds"
              value={money(sales.totals.netCents)}
              hint={`${money(sales.totals.refundedCents)} refunded`}
            />
          )}
        </div>
        <SalesTable
          caption="By ticket category"
          firstColumn="Category"
          rows={sales.categories}
          showGross={ctx.canSeePersonalData}
        />
        {sales.sections.length > 0 && (
          <SalesTable
            caption="By section"
            firstColumn="Section"
            rows={sales.sections}
            showGross={ctx.canSeePersonalData}
          />
        )}
        {!ctx.canSeePersonalData && (
          <p class="text-sm text-muted">
            Money totals and purchaser emails are shown to the event owner only.
          </p>
        )}
      </section>
      <AttendanceSection
        attendance={attendance}
        exportHref={`/organizer/events/${encodeURIComponent(eventId)}/export?kind=attendance`}
      />
    </>
  )}
</OrganizerPageShell>
