---
/**
 * B6: one event: its status, Gamo's note, dates with registration counts, and the actions that apply
 * (edit, send for review, view public page, registrations, cancel).
 */
import OrganizerLayout from '../../../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../../../components/organizer/PageTitle.astro';
import Panel from '../../../../components/organizer/Panel.astro';
import EventStatusPill from '../../../../components/organizer/EventStatusPill.astro';
import SplitNotice from '@studio-gamo/ui/components/split/SplitNotice.astro';
import SplitField from '@studio-gamo/ui/components/split/SplitField.astro';
import SplitButton from '@studio-gamo/ui/components/split/SplitButton.astro';
import ConfirmAction from '@studio-gamo/ui/components/ui/ConfirmAction.astro';
import { requireSameOrigin } from '@gamo/auth';
import {
  ADMISSIONS,
  OrganizerError,
  eventCalendarView,
  deleteUnpublishedEvent,
  getOrganizerEvent,
  submitEvent,
} from '@gamo/domain';
import { cancelDateAndNotify, cancelEventAndNotify } from '../../../../lib/organizer-events';
import EventDates from '../../../../components/organizer/EventDates.astro';
import { organizerPage } from '../../../../lib/organizer-session';
import { STATUS_AFTER_SAVE } from '../../../../lib/event-editor';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro);
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx || !ctx.active) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { organizer, memberships, active, live, now } = ctx;
const id = Astro.params.id ?? '';
let event = await getOrganizerEvent(live.db, active.organizationId, id, now);
if (!event) return new Response(null, { status: 404 });

let notice: { tone: 'info' | 'error'; text: string } | null = null;
const saved = Astro.url.searchParams.get('saved');
if (saved && STATUS_AFTER_SAVE[saved]) notice = { tone: 'info', text: STATUS_AFTER_SAVE[saved] };

if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
  } catch {
    return new Response('Forbidden', { status: 403 });
  }
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  try {
    if (action === 'submit') {
      const status = await submitEvent(live.db, { organizationId: active.organizationId, eventId: id, now });
      notice = { tone: 'info', text: STATUS_AFTER_SAVE[status] ?? 'Saved.' };
    } else if (action === 'delete') {
      await deleteUnpublishedEvent(live.db, { organizationId: active.organizationId, eventId: id });
      return Astro.redirect('/organizer/events?deleted=1', 303);
    } else if (action === 'cancel_date') {
      notice = await cancelDateAndNotify({
        live,
        organizationId: active.organizationId,
        organizationName: active.name,
        eventId: id,
        occurrenceId: String(form.get('occurrence') ?? ''),
        eventTitle: event.values.title,
        timezone: event.values.timezone,
        message: String(form.get('message') ?? '').slice(0, 1000),
        now,
      });
    } else if (action === 'cancel') {
      if (form.get('confirm') !== 'yes') {
        notice = { tone: 'error', text: 'Tick the box to confirm that you want to cancel this event.' };
      } else {
        notice = await cancelEventAndNotify({
          live,
          organizationId: active.organizationId,
          organizationName: active.name,
          eventId: id,
          eventTitle: event.values.title,
          timezone: event.values.timezone,
          message: String(form.get('message') ?? '').slice(0, 1000),
          now,
        });
      }
    }
  } catch (error) {
    if (!(error instanceof OrganizerError)) throw error;
    notice = {
      tone: 'error',
      text:
        error.code === 'suspended'
          ? 'This organization is suspended.'
          : error.code === 'status_locked'
            ? 'That is not possible for this event right now. Events need a date that has not passed to be submitted.'
            : 'That could not be done.',
    };
  }
  event = (await getOrganizerEvent(live.db, active.organizationId, id, now)) ?? event;
}

const v = event.values;
const tz = v.timezone;
const canSubmit =
  ['draft', 'changes_requested', 'rejected'].includes(event.status) && active.status === 'active';
const canEdit =
  ['draft', 'pending_review', 'changes_requested', 'rejected', 'published'].includes(event.status) &&
  active.status === 'active';
const canCancel = event.status === 'published' && active.status === 'active';
const canDelete =
  ['draft', 'pending_review', 'changes_requested', 'rejected'].includes(event.status) &&
  active.status === 'active';
// The dates calendar: the month and the chosen day come from the address, and only real ones are used.
const calendar = eventCalendarView({
  occurrences: event.occurrences,
  timeZone: tz,
  now,
  monthParam: Astro.url.searchParams.get('month'),
  dateParam: Astro.url.searchParams.get('date'),
  href: ({ month, date }) => `?month=${month}${date ? `&date=${date}` : ''}#dates`,
});
const totalPeople = event.occurrences.reduce((a, o) => a + o.confirmedPeople, 0);
const admissionLabel = ADMISSIONS.find((a) => a.value === event.admission)?.label ?? event.admission;
const decisionLabel: Record<string, string> = {
  approved: 'Approved',
  changes_requested: 'Changes requested',
  rejected: 'Rejected',
};
---

<OrganizerLayout
  title={v.title}
  current="events"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <PageTitle title={v.title} subtext={`${v.venueName}, ${v.city}, ${v.state}`} />
    <EventStatusPill status={event.status} />
  </div>
  {notice && !event.changeWaiting && <SplitNotice tone={notice.tone}>{notice.text}</SplitNotice>}
  {event.changeWaiting && (
    <SplitNotice tone="info">
      <strong>Your change is waiting for Gamo’s review.</strong>
      <span class="mt-1 block">
        The public page keeps showing the previous date, place and tickets until it is approved. Other edits
        are already live.
      </span>
    </SplitNotice>
  )}
  {event.decision && event.decision.decision !== 'verified' && (
    <SplitNotice tone={event.decision.decision === 'approved' ? 'info' : 'error'}>
      <strong>Gamo’s decision: {decisionLabel[event.decision.decision] ?? event.decision.decision}</strong>
      {event.decision.note ? <span class="block mt-1">{event.decision.note}</span> : null}
    </SplitNotice>
  )}
  <div class="mb-4 flex flex-wrap gap-3">
    {canEdit && (
      <a
        href={`/organizer/events/${id}/edit`}
        class="inline-flex min-h-11 items-center rounded-full border border-ink/30 bg-white px-5 text-[14px] font-semibold text-ink hover:bg-sand"
      >
        Edit event
      </a>
    )}
    {event.status === 'published' && (
      <a
        href={`/events/${event.slug}`}
        class="inline-flex min-h-11 items-center rounded-full border border-ink/30 bg-white px-5 text-[14px] font-semibold text-ink hover:bg-sand"
      >
        View public page
      </a>
    )}
    {event.admission === 'free_registration' && (
      <a
        href={`/organizer/events/${id}/registrations`}
        class="inline-flex min-h-11 items-center rounded-full border border-ink/30 bg-white px-5 text-[14px] font-semibold text-ink hover:bg-sand"
      >
        Registrations ({totalPeople})
      </a>
    )}
  </div>
  {canSubmit && (
    <Panel
      id="submit"
      title="Ready to send?"
      description="Submitting follows your organization’s review rule."
    >
      <form method="post" class="max-w-xs">
        <input type="hidden" name="action" value="submit" />
        <SplitButton label="Submit event" />
      </form>
    </Panel>
  )}
  <div class="mt-4 grid items-start gap-4 lg:grid-cols-2">
    <Panel id="details" title="Details">
      <dl class="space-y-3 text-[15px]">
        <div class="flex justify-between gap-4">
          <dt class="text-muted">Admission</dt>
          <dd class="text-right font-semibold text-ink">{admissionLabel}</dd>
        </div>
        {event.capacity != null && (
          <div class="flex justify-between gap-4">
            <dt class="text-muted">Seats</dt>
            <dd class="font-semibold text-ink">{event.capacity}</dd>
          </div>
        )}
        <div class="flex justify-between gap-4">
          <dt class="text-muted">QR check-in</dt>
          <dd class="font-semibold text-ink">{event.qrCheckin ? 'On' : 'Off'}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted">Time zone</dt>
          <dd class="font-semibold text-ink">{tz}</dd>
        </div>
      </dl>
    </Panel>
    <EventDates
      event={event}
      view={calendar}
      timeZone={tz}
      now={now}
      canCancelDates={
        event.status === 'published' && event.occurrences.length > 1 && active.status === 'active'
      }
    />
  </div>
  {canCancel && (
    <Panel id="cancel" title="Cancel this event" class="mt-4">
      <ConfirmAction
        summaryLabel="Cancel this event…"
        confirmLabel="Yes, cancel the event"
        actionValue="cancel"
        class="max-w-xl"
      >
        <p>
          {totalPeople > 0
            ? `This cancels every date and ${totalPeople} confirmed ${totalPeople === 1 ? 'person' : 'people'} will be emailed. `
            : 'No one has registered yet. '}
          This cannot be undone.
        </p>
        <Fragment slot="fields">
          <input type="hidden" name="confirm" value="yes" />
          {totalPeople > 0 && (
            <SplitField
              id="message"
              name="message"
              label="Message to registrants (optional)"
              as="textarea"
              rows={3}
              maxlength={1000}
            />
          )}
        </Fragment>
      </ConfirmAction>
    </Panel>
  )}
  {canDelete && (
    <Panel id="delete" title="Delete this event" class="mt-4">
      <ConfirmAction
        summaryLabel="Delete this event…"
        confirmLabel="Yes, delete it"
        actionValue="delete"
        class="max-w-xl"
      >
        <p>It was never published, so nobody is registered. Deleting removes it for good.</p>
      </ConfirmAction>
    </Panel>
  )}
</OrganizerLayout>
