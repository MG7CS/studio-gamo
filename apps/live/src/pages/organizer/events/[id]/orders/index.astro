---
/**
 * O3: a paid event's orders (docs/LIVE_SCREENS.md §I.3): the toolbar card (search name, email or reference; filters by
 * status, ticket type, channel and payment method, each chip count equal to the list it opens), the summary cards
 * (each a link to its list), one card per order, and the CSV of the list as filtered.
 */
import OrganizerLayout from '../../../../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../../../../components/organizer/PageTitle.astro';
import EventTabs from '../../../../../components/organizer/EventTabs.astro';
import StatCard from '../../../../../components/organizer/StatCard.astro';
import OrderCard from '../../../../../components/organizer/paid/OrderCard.astro';
import Breadcrumbs from '@studio-gamo/ui/components/ui/Breadcrumbs.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import Toolbar from '@studio-gamo/ui/components/ui/Toolbar.astro';
import { listTicketTypes } from '@gamo/domain';
import { eventTabCounts, paidEventPage } from '../../../../../lib/event-page';
import { ordersPageView } from '../../../../../lib/orders-page';

export const prerender = false;

const ctx = await paidEventPage(Astro);
if (ctx instanceof Response) return ctx;
const { organizer, memberships, active, live, now, event, eventId: id } = ctx;
const types = await listTicketTypes(live.db, active.organizationId, id);
const view = await ordersPageView(live.db, {
  organizationId: active.organizationId,
  eventId: id,
  types,
  params: Astro.url.searchParams,
});
const tabCounts = await eventTabCounts(live.db, {
  organizationId: active.organizationId,
  eventId: id,
  admission: event.admission,
  now,
});
const q = view.query;
const keep = {
  status: q.status ?? undefined,
  type: q.ticketTypeId ?? undefined,
  channel: q.channel ?? undefined,
  method: q.method ?? undefined,
};
const tz = event.values.timezone;
---

<OrganizerLayout
  title={`Orders · ${event.values.title}`}
  current="events"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <Breadcrumbs
    class="-mt-1"
    items={[
      { label: 'Events', href: '/organizer/events' },
      { label: event.values.title, href: `/organizer/events/${id}` },
      { label: 'Orders' },
    ]}
  />
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
    <PageTitle title="Orders" subtext={event.values.title} />
    <div class="mt-1 flex flex-wrap gap-2">
      <Button href={`/organizer/events/${id}/sales`} variant="secondary">
        Sales summary
      </Button>
      <Button href={view.csvHref}>Download orders (CSV)</Button>
    </div>
  </div>
  <EventTabs eventId={id} admission={event.admission} current="orders" counts={tabCounts} class="mb-3" />
  <div class="space-y-3">
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {view.summary.map((s, i) => (
        <StatCard
          label={s.label}
          value={s.value}
          link={{ href: s.href, opens: s.opens }}
          tone={(['terracotta', 'green', 'plum', 'amber'] as const)[i]}
          icon={(['calendar', 'check', 'clock', 'users'] as const)[i]}
        />
      ))}
    </div>
    <Toolbar
      search={{
        label: 'Search name, email or reference',
        value: q.q,
        placeholder: 'GL-ABCD-1234',
        keep,
      }}
      groups={view.groups}
    />
    {view.rows.length === 0 ? (
      <EmptyState
        title={view.filtered ? 'No orders match' : 'No orders yet'}
        text={
          view.filtered
            ? 'Nothing matches that search or those filters. Clear them to see every order.'
            : 'Orders appear here as people buy tickets. Try the buyer journey yourself with Preview checkout.'
        }
      >
        {view.filtered ? (
          <Button href={`/organizer/events/${id}/orders`} variant="secondary">
            Show every order
          </Button>
        ) : (
          <Button href={`/organizer/events/${id}/preview-checkout`} variant="secondary">
            Preview checkout
          </Button>
        )}
      </EmptyState>
    ) : (
      <ul class="space-y-2">
        {view.rows.map((o) => (
          <li>
            <OrderCard order={o} href={`/organizer/events/${id}/orders/${o.id}`} timeZone={tz} />
          </li>
        ))}
      </ul>
    )}
  </div>
</OrganizerLayout>
