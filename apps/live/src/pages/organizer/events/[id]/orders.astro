---
/**
 * Orders and refunds (read-only). Refund actions belong to the refunds flow (Agent B); this page
 * links there once it exists (REFUNDS_ACTION_PATH below — swapped in at merge).
 */
import OrganizerPageShell from '../../../../components/organizer/OrganizerPageShell.astro';
import OrdersTable from '../../../../components/organizer/OrdersTable.astro';
import OrganizerNotice from '../../../../components/organizer/OrganizerNotice.astro';
import { resolveOrganizerEvent } from '../../../../lib/organizer-pages';
import { listOrders } from '@gamo/domain/scanner';

export const prerender = false;

/** TODO(agent-b merge): path of the organizer refund action for an order, e.g. `/organizer/orders/<id>/refund`. */
const REFUNDS_ACTION_PATH: ((orderId: string) => string) | null = null;

const eventId = Astro.params.id ?? '';
const resolved = await resolveOrganizerEvent(Astro, eventId, 'manage_ticketing');
if (!resolved.ok) Astro.response.status = resolved.status;
const ctx = resolved.ok ? resolved.ctx : null;
const pageNo = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const PER_PAGE = 50;
const orders = ctx
  ? await listOrders(ctx.db, eventId, {
      unmask: ctx.canSeePersonalData,
      limit: PER_PAGE,
      offset: (pageNo - 1) * PER_PAGE,
    })
  : null;
const refunds = ctx
  ? await listOrders(ctx.db, eventId, { unmask: ctx.canSeePersonalData, refundsOnly: true, limit: 200 })
  : null;
const base = `/organizer/events/${encodeURIComponent(eventId)}/orders`;
---

<OrganizerPageShell
  title="Orders and refunds"
  eventId={eventId}
  eventTitle={ctx?.event.title}
  current="orders"
  denied={resolved.ok ? null : resolved.message}
>
  {ctx && orders && refunds && (
    <>
      {!ctx.canSeePersonalData && (
        <OrganizerNotice kind="info">
          Purchaser names and emails are shortened. The event owner sees them in full.
        </OrganizerNotice>
      )}
      <OrdersTable
        caption={`Orders (${orders.total})`}
        orders={orders.orders}
        timeZone={ctx.event.timeZone}
        empty="No orders yet."
      />
      {orders.total > PER_PAGE && (
        <nav aria-label="Order pages" class="flex gap-2">
          {pageNo > 1 && (
            <a
              class="inline-flex min-h-11 items-center rounded-full px-4 font-semibold ring-1 ring-ink/40"
              href={`${base}?page=${pageNo - 1}`}
            >
              Newer
            </a>
          )}
          {pageNo * PER_PAGE < orders.total && (
            <a
              class="inline-flex min-h-11 items-center rounded-full px-4 font-semibold ring-1 ring-ink/40"
              href={`${base}?page=${pageNo + 1}`}
            >
              Older
            </a>
          )}
        </nav>
      )}
      <OrdersTable
        caption="Refunds"
        orders={refunds.orders}
        timeZone={ctx.event.timeZone}
        showRefunds
        empty="No refunds."
      />
      <p class="text-sm text-muted">
        {REFUNDS_ACTION_PATH
          ? 'Open an order to refund some or all of its tickets.'
          : 'Refunds are issued from the order’s refund page, which is being added. Until then, contact the Gamo team to refund an order.'}
      </p>
    </>
  )}
</OrganizerPageShell>
