---
/** Organizer: create, list and end door-scanner links (design T-09). */
import OrganizerPageShell from '../../../../components/organizer/OrganizerPageShell.astro';
import OrganizerNotice from '../../../../components/organizer/OrganizerNotice.astro';
import ScannerSessionForm from '../../../../components/organizer/ScannerSessionForm.astro';
import ScannerSessionCreated from '../../../../components/organizer/ScannerSessionCreated.astro';
import ScannerSessionList from '../../../../components/organizer/ScannerSessionList.astro';
import { nowSeconds, readPostedForm, resolveOrganizerEvent } from '../../../../lib/organizer-pages';
import {
  createScannerSession,
  eventZoneCodes,
  formatVenueTime,
  listScannerSessions,
  revokeScannerSession,
  ScannerSessionError,
  type CreatedScannerSession,
} from '@gamo/domain/scanner';
import { SecretNotConfiguredError } from '@gamo/domain/security';

export const prerender = false;

const eventId = Astro.params.id ?? '';
const resolved = await resolveOrganizerEvent(Astro, eventId, 'manage_ticketing');
let created: (CreatedScannerSession & { url: string }) | null = null;
let error: string | null = null;
let notice: string | null = null;
let values: { label?: string; directions?: string } = {};

if (!resolved.ok) Astro.response.status = resolved.status;
else if (Astro.request.method === 'POST') {
  const { ctx } = resolved;
  const form = await readPostedForm(Astro.request);
  if (!form.ok) error = form.message;
  else {
    const action = form.body.get('action');
    try {
      if (action === 'create') {
        values = { label: form.body.get('label') ?? '', directions: form.body.get('directions') ?? 'both' };
        const directions = values.directions as 'in' | 'out' | 'both';
        const session = await createScannerSession(ctx.db, ctx.env as Record<string, unknown>, {
          eventId: ctx.event.id,
          label: values.label ?? '',
          allowedDirections: ['in', 'out', 'both'].includes(directions) ? directions : 'both',
          allowedZones: form.body.getAll('zones'),
          canOverride: form.body.get('can_override') === '1',
          createdByUserId: ctx.auth.user.id,
          now: nowSeconds(),
        });
        created = { ...session, url: new URL(session.path, Astro.url.origin).href };
        values = {};
      } else if (action === 'revoke') {
        const ok = await revokeScannerSession(ctx.db, {
          eventId: ctx.event.id,
          sessionId: form.body.get('session_id') ?? '',
          now: nowSeconds(),
        });
        notice = ok
          ? 'The scanner was ended. Devices using it stop working on their next scan.'
          : 'That scanner had already ended.';
      } else error = 'Reload the page and try again.';
    } catch (err) {
      if (err instanceof ScannerSessionError) error = err.message;
      else if (err instanceof SecretNotConfiguredError) {
        Astro.response.status = 503;
        error =
          'Door scanning is not configured yet (SCANNER_SESSION_SECRET). Ask the Gamo team to finish setup.';
      } else throw err;
    }
    if (error && Astro.response.status === 200) Astro.response.status = 400;
  }
}

const ctx = resolved.ok ? resolved.ctx : null;
const sessions = ctx ? await listScannerSessions(ctx.db, ctx.event.id, nowSeconds()) : [];
const zones = ctx ? await eventZoneCodes(ctx.db, ctx.event.id) : [];
---

<OrganizerPageShell
  title="Door scanners"
  eventId={eventId}
  eventTitle={ctx?.event.title}
  current="scanners"
  lede="One link and PIN per entrance. Door staff need no account."
  denied={resolved.ok ? null : resolved.message}
>
  {notice && <OrganizerNotice kind="success">{notice}</OrganizerNotice>}
  {error && !values.label && <OrganizerNotice kind="error">{error}</OrganizerNotice>}
  {created && ctx && (
    <ScannerSessionCreated
      label={created.label}
      url={created.url}
      pin={created.pin}
      expiresText={formatVenueTime(created.expiresAt, ctx.event.timeZone, true)}
    />
  )}
  {ctx && (
    <ScannerSessionForm zones={zones} error={values.label !== undefined ? error : null} values={values} />
  )}
  {ctx && <ScannerSessionList sessions={sessions} timeZone={ctx.event.timeZone} />}
  {ctx && (
    <p class="text-sm text-muted">
      Scanning yourself? Open{' '}
      <a
        class="font-semibold text-terracotta-deep underline"
        href={`/scan/${encodeURIComponent(ctx.event.id)}`}
      >
        the scanner
      </a>{' '}
      with your account — no PIN needed.
    </p>
  )}
</OrganizerPageShell>
