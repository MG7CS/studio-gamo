---
/** B5: edit an event. Edits to a published event follow the review rule; dates lock once people register. */
import OrganizerLayout from '../../../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../../../components/organizer/PageTitle.astro';
import EventEditor from '../../../../components/organizer/EventEditor.astro';
import Breadcrumbs from '@studio-gamo/ui/components/ui/Breadcrumbs.astro';
import SplitNotice from '@studio-gamo/ui/components/split/SplitNotice.astro';
import { requireSameOrigin } from '@gamo/auth';
import { siteOrigin } from '@studio-gamo/ui/lib/sites';
import { getOrganizerEvent, reviewRuleFor } from '@gamo/domain';
import { organizerPage } from '../../../../lib/organizer-session';
import { paidEditorView, readEventForm, readTicketingForm, saveFromForm } from '../../../../lib/event-editor';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro);
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx || !ctx.active) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { organizer, memberships, active, live, now } = ctx;
const id = Astro.params.id ?? '';
let event = await getOrganizerEvent(live.db, active.organizationId, id, now);
if (!event) return new Response(null, { status: 404 });
const editable =
  ['draft', 'pending_review', 'changes_requested', 'rejected', 'published'].includes(event.status) &&
  active.status === 'active';
let values = event.values;
const paid = await paidEditorView(live.db, live.env, {
  organizationId: active.organizationId,
  eventId: id,
  now,
});
let ticketing = paid.ticketing;
let errors: Record<string, string> = {};
let notice: string | undefined;

if (Astro.request.method === 'POST' && editable) {
  try {
    requireSameOrigin(Astro.request);
  } catch {
    return new Response('Forbidden', { status: 403 });
  }
  const form = await Astro.request.formData();
  values = readEventForm(form);
  ticketing = readTicketingForm(form);
  const outcome = await saveFromForm(live.db, {
    organizationId: active.organizationId,
    eventId: id,
    form,
    now,
    notify: { env: live.env, origin: siteOrigin('live') },
  });
  if (outcome.kind === 'saved') {
    const told = outcome.holders ? `&holders=${outcome.holders.notEmailed > 0 ? 'some' : 'all'}` : '';
    return Astro.redirect(`/organizer/events/${id}?saved=${outcome.status}${told}`, 303);
  }
  errors = outcome.errors;
  notice = outcome.notice;
  event = (await getOrganizerEvent(live.db, active.organizationId, id, now)) ?? event;
}
const rule = await reviewRuleFor(live.db, active.organizationId);
---

<OrganizerLayout
  title={`Edit ${event.values.title}`}
  current="events"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <Breadcrumbs
    class="-mt-1"
    items={[
      { label: 'Events', href: '/organizer/events' },
      { label: event.values.title, href: `/organizer/events/${id}` },
      { label: 'Edit' },
    ]}
  />
  <PageTitle title="Edit event" subtext={event.values.title} />
  {!editable && <SplitNotice>This event can no longer be edited.</SplitNotice>}
  {event.status === 'published' && rule !== 'none' && (
    <SplitNotice>
      Saving changes to a published event sends it back for review, and it stays hidden until Gamo approves
      it.
    </SplitNotice>
  )}
  {notice && <SplitNotice tone="error">{notice}</SplitNotice>}
  {Object.keys(errors).length > 0 && (
    <SplitNotice tone="error">
      {Object.keys(errors).length === 1
        ? `Please fix the highlighted field: ${Object.values(errors)[0]}`
        : `Please fix the ${Object.keys(errors).length} highlighted fields.`}
    </SplitNotice>
  )}
  <EventEditor
    values={values}
    errors={errors}
    locked={event.registrationsLocked}
    rule={rule}
    published={event.status === 'published'}
    readOnly={!editable}
    ticketing={ticketing}
    paid={paid}
  />
</OrganizerLayout>
