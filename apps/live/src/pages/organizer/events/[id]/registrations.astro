---
/** B7: who registered. Search, filter by date, download the list, cancel a registration (each in its own card). */
import OrganizerLayout from '../../../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../../../components/organizer/PageTitle.astro';
import RegistrationsToolbar from '../../../../components/organizer/RegistrationsToolbar.astro';
import RegistrationRow from '../../../../components/organizer/RegistrationRow.astro';
import EventTabs from '../../../../components/organizer/EventTabs.astro';
import { eventTabCounts } from '../../../../lib/event-page';
import Breadcrumbs from '@studio-gamo/ui/components/ui/Breadcrumbs.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import Stat from '@studio-gamo/ui/components/ui/Stat.astro';
import { requireSameOrigin } from '@gamo/auth';
import { getOrganizerEvent, listEventRegistrations } from '@gamo/domain';
import { organizerPage } from '../../../../lib/organizer-session';
import { whenLabel } from '../../../../lib/organizer-format';
import { cancelRegistrationAction, type RegistrationsNotice } from '../../../../lib/registrations-page';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro);
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx || !ctx.active) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { organizer, memberships, active, live, now } = ctx;
const id = Astro.params.id ?? '';
const event = await getOrganizerEvent(live.db, active.organizationId, id, now);
if (!event) return new Response(null, { status: 404 });
const tz = event.values.timezone;
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const occurrenceId = Astro.url.searchParams.get('occurrence') ?? '';
let notice: RegistrationsNotice | null = null;

if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
  } catch {
    return new Response('Forbidden', { status: 403 });
  }
  const form = await Astro.request.formData();
  if (form.get('action') === 'cancel')
    notice = await cancelRegistrationAction({
      live,
      organizationId: active.organizationId,
      registrationId: String(form.get('registration') ?? ''),
      timeZone: tz,
      now,
    });
}

const rows = await listEventRegistrations(live.db, active.organizationId, id, {
  occurrenceId: occurrenceId || undefined,
  q,
  now,
});
const confirmed = rows.filter((r) => r.status === 'confirmed');
const people = confirmed.reduce((a, r) => a + r.partySize, 0);
const checkedIn = confirmed.filter((r) => r.checkedInAt).reduce((a, r) => a + r.partySize, 0);
const csvQuery = new URLSearchParams({
  ...(occurrenceId ? { occurrence: occurrenceId } : {}),
  ...(q ? { q } : {}),
}).toString();
const filtered = Boolean(q || occurrenceId);
const tabCounts = await eventTabCounts(live.db, {
  organizationId: active.organizationId,
  eventId: id,
  admission: event.admission,
  now,
});
---

<OrganizerLayout
  title="Registrations"
  current="events"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <Breadcrumbs
    class="-mt-1"
    items={[
      { label: 'Events', href: '/organizer/events' },
      { label: event.values.title, href: `/organizer/events/${id}` },
      { label: 'Registrations' },
    ]}
  />
  <PageTitle title="Registrations" subtext={event.values.title} />
  <EventTabs
    eventId={id}
    admission={event.admission}
    current="registrations"
    counts={tabCounts}
    class="mb-3"
  />
  {notice && (
    <Notice tone={notice.tone} class="mb-3">
      {notice.text}
    </Notice>
  )}
  {event.admission !== 'free_registration' && (
    <Notice class="mb-3">This event does not take registrations on Gamo Live.</Notice>
  )}
  <div class="space-y-3">
    <RegistrationsToolbar
      eventId={id}
      q={q}
      occurrenceId={occurrenceId}
      dates={event.occurrences.map((o) => ({ id: o.id, label: whenLabel(o.startsAt, tz) }))}
      csvQuery={csvQuery}
    />
    <div class="grid gap-3 sm:grid-cols-3">
      <Stat label={filtered ? 'Matching registrations' : 'Registrations'} value={rows.length} />
      <Stat label="People confirmed" value={people} />
      <Stat label="People checked in" value={checkedIn} />
    </div>
    {rows.length === 0 ? (
      <EmptyState
        title={filtered ? 'No registrations match' : 'No registrations yet'}
        text={
          filtered
            ? 'Nothing matches that search or date. Clear it to see everyone.'
            : 'When people register for this event they appear here.'
        }
      >
        {filtered ? (
          <Button href={`/organizer/events/${id}/registrations`} variant="secondary">
            Show everyone
          </Button>
        ) : (
          <Button href={`/organizer/events/${id}`} variant="secondary">
            Back to the event
          </Button>
        )}
      </EmptyState>
    ) : (
      <ul class="space-y-2">
        {rows.map((r) => (
          <li>
            <RegistrationRow
              id={r.id}
              name={r.name}
              email={r.email}
              whenText={whenLabel(r.startsAt, tz)}
              partySize={r.partySize}
              status={r.status}
              checkedInAt={r.checkedInAt}
            />
          </li>
        ))}
      </ul>
    )}
  </div>
</OrganizerLayout>
