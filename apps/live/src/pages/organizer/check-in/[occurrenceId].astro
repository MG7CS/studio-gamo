---
/**
 * B8 moved: check-in is now the door screen's Check in mode (docs/LIVE_SCREENS.md §I.3 O7). Old links and open tabs
 * land there; a POST (a scan from a tab opened before the move) is re-sent to the door screen with its body (307).
 */
export const prerender = false;

const target = `/organizer/door/${encodeURIComponent(Astro.params.occurrenceId ?? '')}`;
if (Astro.request.method === 'POST') return Astro.redirect(target, 307);
return Astro.redirect(`${target}?mode=checkin`, 303);
---
