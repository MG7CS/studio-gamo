---
/** B10: who is signed in, which organizations they belong to, and sign out. */
import OrganizerLayout from '../../components/organizer/OrganizerLayout.astro';
import PageTitle from '../../components/organizer/PageTitle.astro';
import Panel from '../../components/organizer/Panel.astro';
import { ORGANIZATION_KIND_LABELS } from '@gamo/domain';
import { organizerPage } from '../../lib/organizer-session';

export const prerender = false;

let ctx;
try {
  ctx = await organizerPage(Astro, { needOrganization: false });
} catch {
  ctx = null;
}
if (ctx instanceof Response) return ctx;
if (!ctx) return new Response('Gamo Live is temporarily unavailable.', { status: 503 });
const { organizer, memberships, active } = ctx;
---

<OrganizerLayout
  title="Account"
  current="account"
  organizer={organizer}
  memberships={memberships}
  active={active}
>
  <PageTitle title="Account" subtext="Your sign-in and the organizations you belong to." />
  <div class="grid gap-4 lg:grid-cols-2">
    <Panel id="you" title="You" description="Your name and email come from your sign-in.">
      <dl class="space-y-3 text-[15px]">
        <div class="flex justify-between gap-4">
          <dt class="text-muted">Name</dt>
          <dd class="text-right font-semibold text-ink">{organizer.displayName ?? 'Not set'}</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-muted">Email</dt>
          <dd class="break-all text-right font-semibold text-ink">{organizer.email}</dd>
        </div>
      </dl>
      <form method="post" action="/account/signout" class="mt-6">
        <button
          type="submit"
          class="min-h-11 rounded-full border border-ink/30 bg-white px-6 text-[15px] font-semibold text-ink hover:bg-sand"
        >
          Sign out
        </button>
      </form>
    </Panel>
    <Panel id="organizations" title="Your organizations">
      {memberships.length === 0 ? (
        <p class="text-[15px] text-ink">
          You are not part of an organization yet.{' '}
          <a class="font-semibold text-terracotta-deep underline" href="/organizer/start">
            Set one up
          </a>
          , or open an invitation link from your email.
        </p>
      ) : (
        <ul class="divide-y divide-sand">
          {memberships.map((m) => (
            <li class="flex items-center justify-between gap-4 py-3 text-[15px]">
              <span class="min-w-0">
                <span class="block truncate font-semibold text-ink">{m.name}</span>
                <span class="text-[13px] text-muted">
                  {ORGANIZATION_KIND_LABELS[m.kind]} · {m.verified ? 'Verified' : 'Not yet verified'}
                  {m.status === 'suspended' ? ' · Suspended' : ''}
                </span>
              </span>
              <span class="shrink-0 rounded-full bg-sand px-3 py-1 text-[12px] font-semibold text-ink">
                {m.role === 'owner' ? 'Owner' : 'Member'}
              </span>
            </li>
          ))}
        </ul>
      )}
    </Panel>
  </div>
</OrganizerLayout>
