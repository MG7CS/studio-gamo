---
import Layout from '../../layouts/Layout.astro';
import DirectoryShell from '../../components/directory/DirectoryShell.astro';
import LiveDiscoveryCard from '../../components/LiveDiscoveryCard.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import { readCatalog } from '../../lib/public-catalog';

export const prerender = false;

const slug = (Astro.params.slug ?? '').trim();
const result = await readCatalog(Astro, (catalog) => catalog.getArtistBySlug(slug));

if (result.ok && !result.data) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
if (!result.ok) Astro.response.status = 503;
const artist = result.ok ? result.data : null;
const count = artist?.upcomingEvents.length ?? 0;
---

<Layout
  title={artist ? artist.stageName : 'Artist'}
  description={artist ? `Upcoming dates for ${artist.stageName} on Gamo Live.` : undefined}
  bodyClass="bg-ivory text-ink"
  noindex={!artist}
>
  {artist ? (
    <DirectoryShell
      title={artist.stageName}
      description={`${count} upcoming ${count === 1 ? 'event' : 'events'}`}
      breadcrumbs={[{ label: 'Artists', href: '/artists' }, { label: artist.stageName }]}
    >
      {count === 0 ? (
        <EmptyState title="No upcoming events." text="Dates appear here once they are published.">
          <Button href="/events" variant="secondary">
            Browse events
          </Button>
        </EmptyState>
      ) : (
        <ul class="grid gap-4 md:grid-cols-2">
          {artist.upcomingEvents.map((event) => (
            <LiveDiscoveryCard event={event} />
          ))}
        </ul>
      )}
    </DirectoryShell>
  ) : (
    <DirectoryShell
      title="Artist"
      breadcrumbs={[{ label: 'Artists', href: '/artists' }, { label: 'Artist' }]}
    >
      <Notice tone="warning" title="This artist is unavailable right now">
        Please try again in a moment.
      </Notice>
    </DirectoryShell>
  )}
</Layout>
