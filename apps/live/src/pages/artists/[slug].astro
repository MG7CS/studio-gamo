---
import Layout from '../../layouts/Layout.astro';
import LiveDiscoveryCard from '../../components/LiveDiscoveryCard.astro';
import Container from '../../components/public/Container.astro';
import Surface from '../../components/public/Surface.astro';
import SectionHeading from '../../components/public/SectionHeading.astro';
import EmptyNotice from '../../components/public/EmptyNotice.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import { LiveCatalog, asSqlDatabase, getRuntimeEnv, type LiveEventWithDetails } from '@gamo/domain';

export const prerender = false;

function toArtistSlug(name: string): string {
  return name
    .toLowerCase()
    .trim()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-');
}

const rawSlug = (Astro.params.slug || '').trim().toLowerCase();

interface PublicArtistProfile {
  slug: string;
  stageName: string;
  roleLabel: string;
  genre: string | null;
  bio: string | null;
  upcomingEvents: LiveEventWithDetails[];
}

let artist: PublicArtistProfile | null = null;
let unavailable = false;

try {
  const env = await getRuntimeEnv(Astro);
  const liveService = new LiveCatalog(asSqlDatabase(env.LIVE_DB));

  const [publishedEvents, verifiedProfiles] = await Promise.all([
    liveService.listDiscoverableEvents({ limit: 200 }),
    liveService.listArtists(),
  ]);

  const artistMap = new Map<string, PublicArtistProfile>();

  for (const prof of verifiedProfiles) {
    const normKey = prof.stageName.trim().toLowerCase();
    artistMap.set(normKey, {
      slug: toArtistSlug(prof.stageName),
      stageName: prof.stageName.trim(),
      roleLabel: 'Performer',
      genre: null,
      bio: null, // listArtists() does not expose a bio
      upcomingEvents: [],
    });
  }

  for (const evt of publishedEvents) {
    for (const perf of evt.performers || []) {
      const name = perf.displayName.trim();
      if (!name) continue;
      const normKey = name.toLowerCase();
      const existing = artistMap.get(normKey);
      if (existing) {
        if (!existing.upcomingEvents.some((e) => e.id === evt.id)) {
          existing.upcomingEvents.push(evt);
        }
      } else {
        artistMap.set(normKey, {
          slug: toArtistSlug(name),
          stageName: name,
          roleLabel:
            perf.roleLabel === 'headliner'
              ? 'Headliner'
              : perf.roleLabel === 'featured'
                ? 'Featured artist'
                : 'Touring artist',
          genre: evt.category === 'worship' ? 'Worship' : 'Christian and gospel',
          bio: null,
          upcomingEvents: [evt],
        });
      }
    }
  }

  for (const entry of artistMap.values()) {
    if (entry.slug === rawSlug || entry.stageName.toLowerCase() === rawSlug) {
      artist = entry;
      break;
    }
  }
} catch {
  unavailable = true;
}

if (!artist && !unavailable) {
  return Astro.redirect(`/artists?q=${encodeURIComponent(rawSlug)}`, 303);
}

if (unavailable) {
  Astro.response.status = 503;
}
---

<Layout
  title={artist ? `${artist.stageName} · Dates and profile` : 'Artist profile'}
  description={
    artist
      ? `Upcoming Christian concerts and worship nights with ${artist.stageName} on Gamo Live.`
      : 'Artist profiles and upcoming Christian concert dates on Gamo Live.'
  }
  noindex={!artist}
>
  {artist ? (
    <Container as="section" class="pb-6 pt-4 sm:pt-5">
      <a
        href="/artists"
        class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-muted hover:text-terracotta-deep"
      >
        <Icon name="arrow-left" class="h-4 w-4" strokeWidth={2} />
        All artists
      </a>

      <SectionHeading
        class="mt-2"
        level={1}
        size="page"
        eyebrow={artist.genre || artist.roleLabel}
        title={artist.stageName}
        lede={artist.bio || undefined}
      >
        <ButtonLink
          slot="actions"
          href={inquiryUrl('Artist or agent interest')}
          variant="secondary"
          class="w-full sm:w-auto"
        >
          Artists and agents: contact us
        </ButtonLink>
      </SectionHeading>

      <Surface class="mt-6">
        <SectionHeading size="compact" title={`Upcoming dates (${artist.upcomingEvents.length})`}>
          <a
            slot="actions"
            href="/events"
            class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-terracotta-deep hover:underline"
          >
            All events
            <Icon name="arrow" class="h-4 w-4" strokeWidth={2} />
          </a>
        </SectionHeading>

        {artist.upcomingEvents.length > 0 ? (
          <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {artist.upcomingEvents.map((evt, idx) => (
              <LiveDiscoveryCard event={evt} index={idx} />
            ))}
          </div>
        ) : (
          <EmptyNotice
            class="mt-5"
            title={`No upcoming dates for ${artist.stageName}`}
            body="Dates appear here when an organizer lists an event with this artist."
            primary={{ href: '/events', label: 'All events' }}
          />
        )}
      </Surface>
    </Container>
  ) : (
    <Container as="section" class="pb-10 pt-6">
      <div class="mx-auto max-w-2xl">
        <h1 class="sr-only">Artist profile temporarily unavailable</h1>
        <EmptyNotice
          title="Artist profile temporarily unavailable"
          body="Please try again in a moment."
          primary={{ href: '/artists', label: 'All artists' }}
        />
      </div>
    </Container>
  )}
</Layout>
