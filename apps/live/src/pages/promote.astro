---
import Layout from '../layouts/Layout.astro';
import PromoteHero from '../components/promote/PromoteHero.astro';
import PromoteSteps from '../components/promote/PromoteSteps.astro';
import PromoteTrust from '../components/promote/PromoteTrust.astro';

// Not prerendered: the shared layout reads the request (the canonical link and social tags come from the
// per-request product marker), so a build-time copy would lose them.
export const prerender = false;
---

<Layout
  title="Promote an event"
  description="List a Christian concert, worship night, conference or church gathering on Gamo Live. Free to list; your first event is reviewed by Gamo."
  bodyClass="bg-ivory text-ink"
>
  <PromoteHero />
  <PromoteSteps />
  <PromoteTrust />
</Layout>
