---
import Layout from '../layouts/Layout.astro';
import Container from '../components/public/Container.astro';
import Surface from '../components/public/Surface.astro';
import SectionHeading from '../components/public/SectionHeading.astro';
import EmptyNotice from '../components/public/EmptyNotice.astro';
import MetroLinks from '../components/public/MetroLinks.astro';
import VenueCard from '../components/public/VenueCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import {
  LiveCatalog,
  asSqlDatabase,
  getRuntimeEnv,
  GAMO_LIVE_METROS,
  resolveMetroBySlug,
} from '@gamo/domain';

export const prerender = false;

const url = Astro.url;
const metroParam = (url.searchParams.get('metro') || '').trim().toLowerCase();
const activeMetro = metroParam && metroParam !== 'all' ? resolveMetroBySlug(metroParam) : null;

let venues: Awaited<ReturnType<LiveCatalog['listDiscoverableVenues']>> = [];
let unavailable = false;

try {
  const env = await getRuntimeEnv(Astro);
  const liveService = new LiveCatalog(asSqlDatabase(env.LIVE_DB));
  venues = await liveService.listDiscoverableVenues({
    metro: activeMetro ? activeMetro.slug : undefined,
  });
} catch {
  unavailable = true;
}

const pageTitle = activeMetro ? `Venues in ${activeMetro.displayLabel}` : 'Venues and host churches';
const pageDescription = activeMetro
  ? `Arenas, theaters and churches hosting upcoming Christian events in ${activeMetro.displayLabel}.`
  : 'Arenas, theaters and churches hosting upcoming Christian concerts and worship nights.';
const countLine = `${venues.length} ${venues.length === 1 ? 'venue' : 'venues'} with upcoming events`;
const metroItems = GAMO_LIVE_METROS.map((m) => ({ slug: m.slug, label: m.displayLabel }));
---

<Layout title={pageTitle} description={pageDescription}>
  <Container as="section" class="pb-6 pt-4 sm:pt-5">
    <SectionHeading
      level={1}
      size="page"
      eyebrow={activeMetro ? activeMetro.regionLabel : 'Venues nationwide'}
      title={pageTitle}
      lede="Arenas, theaters and churches with upcoming events. Pick a city to narrow the list."
    >
      <ButtonLink slot="actions" href="/events" variant="secondary" arrow class="w-full sm:w-auto">
        All events
      </ButtonLink>
    </SectionHeading>

    <Surface class="mt-6" padding="none">
      <div class="p-3 sm:p-4">
        <MetroLinks
          items={metroItems}
          href={(slug) => `/venues?metro=${slug}`}
          label="Filter venues by city"
          activeSlug={activeMetro?.slug ?? null}
          all={{ href: '/venues', active: !activeMetro }}
        />
      </div>
    </Surface>

    <p class="mb-4 mt-6 text-sm text-muted">{countLine}</p>

    {unavailable ? (
      <EmptyNotice title="Venues could not be loaded" body="Please try again in a moment." />
    ) : venues.length === 0 ? (
      <EmptyNotice
        title={
          activeMetro
            ? `No venues with upcoming events in ${activeMetro.displayLabel}`
            : 'No venues with upcoming events yet'
        }
        body="Venues appear here as soon as an event at them is published."
        primary={
          activeMetro ? { href: '/venues', label: 'All cities' } : { href: '/events', label: 'All events' }
        }
      />
    ) : (
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {venues.map((venue) => (
          <VenueCard venue={venue} showMetro={!activeMetro} />
        ))}
      </div>
    )}
  </Container>
</Layout>
