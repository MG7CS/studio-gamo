---
import Layout from '../layouts/Layout.astro';
import DirectoryShell from '../components/directory/DirectoryShell.astro';
import VenueCard from '../components/venues/VenueCard.astro';
import VenueRegionFilter from '../components/venues/VenueRegionFilter.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import Button from '@studio-gamo/ui/components/ui/Button.astro';
import { filterVenuesByRegion, venueRegionOptions } from '@gamo/domain';
import { readCatalog } from '../lib/public-catalog';

export const prerender = false;

const result = await readCatalog(Astro, (catalog) => catalog.listDiscoverableVenues());
if (!result.ok) Astro.response.status = 503;
const all = result.ok ? result.data : [];
const regions = venueRegionOptions(all);
const { venues, region } = filterVenuesByRegion(all, Astro.url.searchParams.get('city'));
---

<Layout
  title="Venues"
  description="Churches, theaters and halls with upcoming Christian concerts, worship nights and gatherings on Gamo Live."
  bodyClass="bg-ivory text-ink"
>
  <DirectoryShell title="Venues" description="Places with an upcoming event on Gamo Live.">
    {!result.ok ? (
      <Notice tone="warning" title="Venues are unavailable right now">
        Please try again in a moment.
      </Notice>
    ) : all.length === 0 ? (
      <EmptyState
        title="No venues with upcoming events yet."
        text="A venue appears here once it has a published upcoming event."
      >
        <Button href="/promote" variant="secondary">
          Promote an event
        </Button>
      </EmptyState>
    ) : (
      <>
        {regions.length > 1 && <VenueRegionFilter regions={regions} selected={region} />}
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {venues.map((venue) => (
            <VenueCard venue={venue} />
          ))}
        </ul>
      </>
    )}
  </DirectoryShell>
</Layout>
