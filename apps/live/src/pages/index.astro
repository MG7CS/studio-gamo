---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold mb-4">Gamo Live</h1>
    <p class="text-xl text-[#6B6B67] mb-8">Discover and attend powerful worship events in your area.</p>
    <div class="space-y-6">
      <div class="bg-white border border-[#DED6CC] p-6 rounded-xl flex justify-between items-center">
        <div>
          <div class="text-[#B65B35] font-bold text-sm mb-1">NOV 12 • PHOENIX, AZ</div>
          <h2 class="text-2xl font-bold mb-2">Night of Worship (Demo)</h2>
          <p class="text-[#6B6B67]">Grace Community Church</p>
        </div>
        <a href="/events/123" class="bg-[#1D2323] text-white px-6 py-2 rounded-lg font-medium">Get Tickets</a>
      </div>
    </div>
  </main>
</Layout>
