---
import Layout from '../layouts/Layout.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import EventSpotlightHero from '../components/explore/EventSpotlightHero.astro';
import NearbyRail from '../components/explore/NearbyRail.astro';
import BrowsePlaceDate from '../components/explore/BrowsePlaceDate.astro';
import GospelConcerts from '../components/explore/GospelConcerts.astro';
import WorshipAndRecurring from '../components/explore/WorshipAndRecurring.astro';
import ConferencesYouth from '../components/explore/ConferencesYouth.astro';
import FreeAndTicketed from '../components/explore/FreeAndTicketed.astro';
import FeaturedOrganizers from '../components/explore/FeaturedOrganizers.astro';
import TrustLegend from '../components/shared/TrustLegend.astro';
export const prerender = true;
import { events, eventsBy } from '../data/events';

const byDate = [...events].sort((a, b) => a.date.localeCompare(b.date));
const featured = eventsBy((e) => !!e.featured);
---
<Layout title="Explore Christian events nationwide" description="Discover gospel concerts, worship gatherings, Bible studies, conferences and family events — a Gamo Studios design preview.">
  <EventSpotlightHero slides={featured} />
  <div class="bg-cream px-4 pt-8 sm:px-8"><DemoNotice class="mx-auto max-w-[1320px]">All events, organizers and dates on Gamo Live are fictional samples. Nothing is on sale, registered or published.</DemoNotice></div>
  <NearbyRail events={byDate.filter((e) => e.status !== 'canceled').slice(0, 7)} />
  <BrowsePlaceDate />
  <GospelConcerts events={eventsBy((e) => e.category === 'concert')} />
  <WorshipAndRecurring worship={eventsBy((e) => e.category === 'worship')} recurring={eventsBy((e) => !!e.recurring)} />
  <ConferencesYouth conferences={eventsBy((e) => e.category === 'conference')} youth={eventsBy((e) => e.category === 'youth').slice(0, 3)} />
  <FreeAndTicketed free={eventsBy((e) => e.ticketing === 'free').slice(0, 5)} ticketed={eventsBy((e) => e.ticketing !== 'free').slice(0, 5)} />
  <FeaturedOrganizers />
  <section class="bg-cream px-4 pb-4 sm:px-8"><TrustLegend class="mx-auto max-w-[1320px]" /></section>
  <CtaInvitation eyebrow="For churches & ministries" title="Hosting a Christian event?" body="Preview how organizers will submit events, choose free or ticketed registration and manage check-in. Listings would be reviewed before publishing." photo="worshipBand">
    <ButtonLink href="/promote" arrow>Promote an event</ButtonLink>
    <ButtonLink href="/promote/create" variant="secondary">Preview the submission flow</ButtonLink>
  </CtaInvitation>
</Layout>
