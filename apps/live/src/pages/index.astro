---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeaturedEvent from '../components/home/FeaturedEvent.astro';
import UpcomingEvents from '../components/home/UpcomingEvents.astro';
import OrganizerStrip from '../components/home/OrganizerStrip.astro';
import { pickHomeEvents } from '@gamo/domain';
import { readCatalog } from '../lib/public-catalog';

export const prerender = false;

const result = await readCatalog(Astro, (catalog) =>
  catalog.listDiscoverableEvents({ upcomingOnly: true, limit: 100 }),
);
const { featured, upcoming } = pickHomeEvents(result.ok ? result.data : []);
---

<Layout
  title="Christian concerts, worship nights and gatherings"
  description="Find Christian concerts, worship nights, conferences and church gatherings across the U.S. Free to attend, or tickets sold by the organizer."
  bodyClass="bg-ivory text-ink"
>
  <HomeHero />
  <div class="mx-auto flex max-w-[1340px] flex-col gap-12 px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    {featured && <FeaturedEvent event={featured} />}
    {(upcoming.length > 0 || !featured) && <UpcomingEvents events={upcoming} unavailable={!result.ok} />}
    <OrganizerStrip />
  </div>
</Layout>
