---
import Layout from '../layouts/Layout.astro';
import LiveDiscoveryCard from '../components/LiveDiscoveryCard.astro';
import Container from '../components/public/Container.astro';
import Surface from '../components/public/Surface.astro';
import PhotoHero from '../components/public/PhotoHero.astro';
import SectionHeading from '../components/public/SectionHeading.astro';
import EyebrowPill from '../components/public/EyebrowPill.astro';
import EmptyNotice from '../components/public/EmptyNotice.astro';
import OrganizerCta from '../components/public/OrganizerCta.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import {
  LiveCatalog,
  asSqlDatabase,
  getRuntimeEnv,
  GAMO_LIVE_METROS,
  resolveMetroBySlug,
  formatLocalEventSchedule,
  type LiveEventWithDetails,
} from '@gamo/domain';

export const prerender = false;

let allEvents: LiveEventWithDetails[] = [];
let dbUnavailable = false;

try {
  const env = await getRuntimeEnv(Astro);
  const liveService = new LiveCatalog(asSqlDatabase(env.LIVE_DB));
  allEvents = await liveService.listDiscoverableEvents({ limit: 50 });
} catch {
  dbUnavailable = true;
}

const rawMetroParam = Astro.url.searchParams.get('metro');
const rawCategoryParam = (Astro.url.searchParams.get('category') || 'all').toLowerCase();
const rawWeekendParam =
  Astro.url.searchParams.get('weekend') === 'true' || Astro.url.searchParams.get('date') === 'weekend';
const rawQueryParam = (Astro.url.searchParams.get('q') || '').trim();
const rawDateParam = (Astro.url.searchParams.get('date') || 'any').toLowerCase();

const selectedMetroObj =
  rawMetroParam === 'all' ? null : resolveMetroBySlug(rawMetroParam) || resolveMetroBySlug('phoenix-az')!;

const selectedMetroSlug = rawMetroParam === 'all' ? 'all' : selectedMetroObj?.slug || 'phoenix-az';
const selectedMetroLabel =
  selectedMetroSlug === 'all' ? 'All cities' : selectedMetroObj?.displayLabel || 'Phoenix, AZ';

// Events in the chosen city first, then the rest of the country.
const localMetroEvents =
  selectedMetroSlug === 'all' ? allEvents : allEvents.filter((e) => e.metroSlug === selectedMetroSlug);
const otherNationwideEvents =
  selectedMetroSlug === 'all' ? [] : allEvents.filter((e) => e.metroSlug !== selectedMetroSlug);
const orderedEvents = [...localMetroEvents, ...otherNationwideEvents];

const phoenixCount = allEvents.filter((e) => e.metroSlug === 'phoenix-az').length;
const activeMetroCount = selectedMetroSlug === 'all' ? allEvents.length : localMetroEvents.length;

// Featured: an event the admin marked featured (editorial, always labeled), else the next upcoming one.
// With no events the section is not drawn at all.
const upcomingEvents = allEvents.filter((e) => !e.isPast && e.status === 'approved');
const featuredEvent = upcomingEvents.find((e) => e.isFeatured) ?? upcomingEvents[0] ?? null;

const featuredSchedule = featuredEvent
  ? formatLocalEventSchedule(
      featuredEvent.startDateLocal,
      featuredEvent.startTimeLocal,
      featuredEvent.timezone,
      featuredEvent.startsAt,
    )
  : null;
const featuredDateLine = featuredSchedule
  ? `${featuredSchedule.shortDateLabel} · ${featuredSchedule.timeLabel}`
  : '';
const featuredVenueLine = featuredEvent
  ? `${featuredEvent.venueName} · ${featuredEvent.city}, ${featuredEvent.state}`
  : '';
const featuredDetailUrl = featuredEvent ? `/events/${featuredEvent.slug}` : '/events';
// What the main button does depends on how the event admits people.
const featuredCta = !featuredEvent
  ? null
  : featuredEvent.admission === 'external_tickets' && featuredEvent.externalUrl
    ? { label: 'Get tickets', href: featuredEvent.externalUrl, external: true }
    : featuredEvent.registrationOpen
      ? { label: 'Register free', href: `/events/${featuredEvent.slug}/register`, external: false }
      : null;
const featuredNote = !featuredEvent
  ? ''
  : featuredEvent.listingType === 'external_discovery'
    ? `Independent listing${featuredEvent.externalTicketProvider ? ` · Tickets sold by ${featuredEvent.externalTicketProvider}` : ''}`
    : `Organized by ${featuredEvent.organizerName}${featuredEvent.organizerVerified ? ' · Verified by Gamo' : ''}`;

const statusLine =
  selectedMetroSlug === 'all'
    ? `${allEvents.length} ${allEvents.length === 1 ? 'event' : 'events'} nationwide`
    : `${activeMetroCount} in ${selectedMetroLabel} · ${allEvents.length} nationwide`;
---

<Layout
  title="Christian Concerts and Worship Gatherings Nationwide"
  description="Concerts, worship nights and Christian gatherings nationwide. Free listings, free registration and tickets on Gamo Live."
>
  {/* HERO: one photo card with the search inside it */}
  <Container as="section" class="pt-4 sm:pt-5">
    <PhotoHero
      src="/images/optimized/worship-gospel-worship-leader-golden-light-1122w.webp"
      alt="Worship leader singing under warm stage light"
      position="object-[center_22%] sm:object-right"
      priority
    >
      <div class="max-w-2xl">
        <h1 class="text-[38px] font-black uppercase leading-[1.02] tracking-tight text-white sm:text-6xl lg:text-[68px]">
          Gather to
          <br />
          <span class="text-terracotta-soft">worship</span> together.
        </h1>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-white/90 sm:text-xl">
          Concerts, worship nights and gatherings nationwide.
        </p>
      </div>

      <form
        action="/events"
        method="get"
        role="search"
        aria-label="Search events"
        class="mt-7 rounded-3xl border border-white/80 bg-white p-2 text-ink shadow-[0_22px_50px_-12px_rgba(12,9,8,0.65)] sm:mt-9 sm:p-2.5 lg:rounded-full"
      >
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-[1.5fr_1fr_1fr_auto] lg:items-center">
          <div class="flex items-center gap-3 rounded-full border border-sand bg-ivory px-4 lg:border-0 lg:bg-transparent">
            <Icon name="search" class="h-5 w-5 shrink-0 text-muted" strokeWidth={2} />
            <label for="hero-search-q" class="sr-only">
              Search events, artists or venues
            </label>
            <input
              id="hero-search-q"
              name="q"
              type="search"
              value={rawQueryParam}
              placeholder="Search events, artists or venues"
              class="min-h-12 w-full bg-transparent text-[15px] text-ink placeholder:text-muted focus:outline-none"
            />
          </div>

          <div class="flex items-center gap-2.5 rounded-full border border-sand bg-ivory px-4">
            <Icon name="pin" class="h-5 w-5 shrink-0 text-ink" strokeWidth={2} />
            <label for="hero-search-metro" class="sr-only">
              City
            </label>
            <select
              id="hero-search-metro"
              name="metro"
              class="min-h-12 w-full cursor-pointer bg-transparent text-[15px] font-medium text-ink focus:outline-none"
            >
              {GAMO_LIVE_METROS.map((metro) => (
                <option value={metro.slug} selected={selectedMetroSlug === metro.slug}>
                  {metro.displayLabel}
                </option>
              ))}
              <option value="all" selected={selectedMetroSlug === 'all'}>
                All cities
              </option>
            </select>
          </div>

          <div class="flex items-center gap-2.5 rounded-full border border-sand bg-ivory px-4">
            <Icon name="calendar" class="h-5 w-5 shrink-0 text-ink" strokeWidth={1.9} />
            <label for="hero-search-date" class="sr-only">
              Date
            </label>
            <select
              id="hero-search-date"
              name="date"
              class="min-h-12 w-full cursor-pointer bg-transparent text-[15px] font-medium text-ink focus:outline-none"
            >
              <option value="any" selected={rawDateParam === 'any'}>
                Any date
              </option>
              <option value="weekend" selected={rawDateParam === 'weekend'}>
                This weekend
              </option>
              <option value="month" selected={rawDateParam === 'month'}>
                This month
              </option>
              <option value="2026" selected={rawDateParam === '2026'}>
                2026
              </option>
              <option value="2027" selected={rawDateParam === '2027'}>
                2027
              </option>
            </select>
          </div>

          <button
            type="submit"
            class="flex h-12 w-full shrink-0 cursor-pointer items-center justify-center gap-2 rounded-full bg-terracotta text-white shadow-md transition-colors hover:bg-terracotta-deep lg:w-12"
          >
            <span class="text-sm font-semibold lg:sr-only">Search</span>
            <Icon name="arrow" class="h-5 w-5" strokeWidth={2.2} />
          </button>
        </div>
      </form>
    </PhotoHero>
  </Container>

  {/* UPCOMING EVENTS */}
  <Container as="section" id="upcoming-events" class="pt-5">
    <Surface>
      <SectionHeading title="Upcoming events">
        <ButtonLink slot="actions" href="/events" variant="secondary" arrow class="w-full sm:w-auto">
          All events
        </ButtonLink>
      </SectionHeading>
      <p id="discovery-active-status" class="mt-2 text-sm text-muted">
        {statusLine}
      </p>

      {/* Filter chips: category on the left, city scope on the right */}
      <div
        class="mt-5 flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between"
        role="toolbar"
        aria-label="Filter upcoming events"
      >
        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-filter-chip="all"
            aria-pressed={rawCategoryParam === 'all' && !rawWeekendParam ? 'true' : 'false'}
            class="filter-chip inline-flex min-h-11 cursor-pointer items-center rounded-full border border-terracotta bg-terracotta px-4 text-sm font-semibold text-white transition-colors"
          >
            All
          </button>
          <button
            type="button"
            data-filter-chip="weekend"
            aria-pressed={rawWeekendParam ? 'true' : 'false'}
            class="filter-chip inline-flex min-h-11 cursor-pointer items-center rounded-full border border-sand bg-cream px-4 text-sm font-medium text-ink transition-colors hover:border-terracotta-soft"
          >
            This weekend
          </button>
          <button
            type="button"
            data-filter-chip="concert"
            aria-pressed={rawCategoryParam === 'concert' ? 'true' : 'false'}
            class="filter-chip inline-flex min-h-11 cursor-pointer items-center rounded-full border border-sand bg-cream px-4 text-sm font-medium text-ink transition-colors hover:border-terracotta-soft"
          >
            Concerts
          </button>
          <button
            type="button"
            data-filter-chip="worship"
            aria-pressed={rawCategoryParam === 'worship' ? 'true' : 'false'}
            class="filter-chip inline-flex min-h-11 cursor-pointer items-center rounded-full border border-sand bg-cream px-4 text-sm font-medium text-ink transition-colors hover:border-terracotta-soft"
          >
            Worship nights
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-scope-chip={selectedMetroSlug === 'all' ? 'phoenix-az' : selectedMetroSlug}
            data-scope-label={selectedMetroSlug === 'all' ? 'Phoenix, AZ' : selectedMetroLabel}
            aria-pressed={selectedMetroSlug !== 'all' ? 'true' : 'false'}
            class="scope-chip inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-full border border-line bg-sand px-3.5 text-xs font-semibold text-ink transition-colors"
          >
            <Icon name="pin" class="h-3.5 w-3.5 text-terracotta-deep" strokeWidth={2} />
            <span>
              {selectedMetroSlug === 'all'
                ? `Phoenix, AZ (${phoenixCount})`
                : `${selectedMetroLabel} (${activeMetroCount})`}
            </span>
          </button>
          <button
            type="button"
            data-scope-chip="all"
            data-scope-label="All cities"
            aria-pressed={selectedMetroSlug === 'all' ? 'true' : 'false'}
            class="scope-chip inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-full border border-sand bg-cream px-3.5 text-xs font-semibold text-ink transition-colors hover:border-terracotta-soft"
          >
            <span>All cities ({allEvents.length})</span>
          </button>
        </div>
      </div>

      {orderedEvents.length > 0 ? (
        <div
          id="homepage-events-grid"
          data-default-metro={selectedMetroSlug}
          class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
        >
          {orderedEvents.map((event, idx) => {
            const isInitialVisible =
              selectedMetroSlug === 'all' ? idx < 8 : event.metroSlug === selectedMetroSlug;
            return (
              <div
                data-home-card-wrapper
                data-card-metro={event.metroSlug || ''}
                data-card-category={event.category}
                data-card-weekend={
                  event.startDateLocal
                    ? ['5', '6', '0'].includes(
                        String(
                          new Date(
                            Date.UTC(
                              Number(event.startDateLocal.split('-')[0]),
                              Number(event.startDateLocal.split('-')[1]) - 1,
                              Number(event.startDateLocal.split('-')[2]),
                              12,
                              0,
                              0,
                            ),
                          ).getUTCDay(),
                        ),
                      )
                      ? 'true'
                      : 'false'
                    : 'false'
                }
                class={isInitialVisible ? 'flex flex-col' : 'hidden flex-col'}
              >
                <LiveDiscoveryCard event={event} index={idx} />
              </div>
            );
          })}
        </div>
      ) : (
        <EmptyNotice
          class="mt-6"
          title={dbUnavailable ? 'Events could not be loaded' : 'No upcoming events yet'}
          body={
            dbUnavailable
              ? 'Please try again in a moment.'
              : 'Organizers add events as they are approved. Check back soon, or list your own.'
          }
          primary={{ href: '/events', label: 'All events' }}
          secondary={{ href: '/organizer', label: 'List an event' }}
        />
      )}

      {/* Shown by the filter script when a chip combination leaves no cards */}
      <div id="homepage-empty-filter-state" class="mt-6 hidden">
        <EmptyNotice title="No events match that filter here" body="Try all cities, or clear the filter.">
          <button
            type="button"
            id="reset-home-filters-btn"
            class="mt-6 inline-flex min-h-11 w-full cursor-pointer items-center justify-center rounded-full bg-terracotta px-5 text-sm font-semibold text-white hover:bg-terracotta-deep sm:w-auto"
          >
            Show all cities
          </button>
        </EmptyNotice>
      </div>
    </Surface>
  </Container>

  {/* FEATURED OR NEXT UP: photo first on phones, photo on the right on desktop */}
  {featuredEvent && (
    <Container as="section" class="pt-5">
      <Surface tone="dark" padding="none" class="grid grid-cols-1 lg:grid-cols-12 lg:items-stretch">
        <div class="relative aspect-[16/10] w-full lg:order-last lg:col-span-5 lg:aspect-auto lg:min-h-[420px]">
          <img
            src="/images/optimized/worship-acoustic-worship-leader-stage-1122w.webp"
            alt={`Stage atmosphere for ${featuredEvent.title}`}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-[center_20%]"
          />
        </div>

        <div class="p-5 sm:p-10 lg:col-span-7 lg:p-14">
          <EyebrowPill tone="dark">
            {featuredEvent.isFeatured ? 'Featured · editorial pick' : 'Next up'}
          </EyebrowPill>

          <h2 class="mt-4 text-[26px] font-black uppercase leading-[1.06] tracking-tight sm:text-[36px] lg:text-[44px]">
            <span class="block text-white">{featuredEvent.title}</span>
            <span class="mt-1 block text-tan">
              {featuredEvent.city}, {featuredEvent.state}
            </span>
          </h2>

          <ul class="mt-6 space-y-2.5 text-sm text-sand sm:text-base">
            <li class="flex items-center gap-3">
              <Icon name="calendar" class="h-5 w-5 shrink-0 text-tan" strokeWidth={1.9} />
              <span class="font-medium">
                <span class="sr-only">Date: </span>
                {featuredDateLine}
              </span>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="pin" class="h-5 w-5 shrink-0 text-tan" strokeWidth={1.9} />
              <span class="font-medium">
                <span class="sr-only">Venue: </span>
                {featuredVenueLine}
              </span>
            </li>
          </ul>

          <p class="mt-4 text-xs text-tan">{featuredNote}</p>

          <div class="mt-7 flex flex-col gap-2.5 sm:flex-row sm:items-center">
            {featuredCta && (
              <a
                href={featuredCta.href}
                target={featuredCta.external ? '_blank' : undefined}
                rel={featuredCta.external ? 'noopener noreferrer' : undefined}
                class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-terracotta px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-terracotta-deep sm:w-auto"
              >
                {featuredCta.label}
                {featuredCta.external && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            )}
            <ButtonLink href={featuredDetailUrl} variant="ghost-dark" class="w-full sm:w-auto">
              Event details
            </ButtonLink>
          </div>
        </div>
      </Surface>
    </Container>
  )}

  {/* FOR ORGANIZERS */}
  <Container as="section" class="pb-6 pt-5">
    <OrganizerCta
      eyebrow="For churches, ministries and artists"
      title="List your event on Gamo Live."
      body="Free listings and free registration. Every organizer meets Gamo before the Verified badge appears."
      ctaLabel="List an event"
      ctaHref="/organizer"
      secondaryLabel="For artists"
      secondaryHref="/artists"
    />
  </Container>

  {/* Filter chips and saved-event hearts */}
  <script>
    (function () {
      const FAVORITES_KEY = 'gamo_live_saved_events';

      function getSavedSlugs() {
        try {
          const raw = localStorage.getItem(FAVORITES_KEY);
          const parsed = raw ? JSON.parse(raw) : [];
          return Array.isArray(parsed) ? parsed : [];
        } catch (_e) {
          return [];
        }
      }

      function setSavedSlugs(slugs: string[]) {
        try {
          localStorage.setItem(FAVORITES_KEY, JSON.stringify(slugs));
        } catch {
          // Storage unavailable (private mode); favorites stay in-memory only.
        }
      }

      function syncFavoriteButtons() {
        const saved = getSavedSlugs();
        const buttons = document.querySelectorAll('[data-favorite-btn]');
        buttons.forEach(function (btn) {
          const slug = btn.getAttribute('data-event-slug');
          const isSaved = Boolean(slug && saved.indexOf(slug) !== -1);
          btn.setAttribute('aria-pressed', isSaved ? 'true' : 'false');
          const svg = btn.querySelector('svg');
          if (isSaved) {
            btn.classList.add('text-terracotta-deep', 'bg-cream');
            btn.classList.remove('text-muted');
            if (svg) svg.setAttribute('fill', 'currentColor');
          } else {
            btn.classList.remove('text-terracotta-deep', 'bg-cream');
            btn.classList.add('text-muted');
            if (svg) svg.setAttribute('fill', 'none');
          }
        });
      }

      document.querySelectorAll('[data-favorite-btn]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const slug = btn.getAttribute('data-event-slug');
          if (!slug) return;
          const saved = getSavedSlugs();
          const idx = saved.indexOf(slug);
          if (idx === -1) {
            saved.push(slug);
          } else {
            saved.splice(idx, 1);
          }
          setSavedSlugs(saved);
          syncFavoriteButtons();
        });
      });

      syncFavoriteButtons();

      const grid = document.getElementById('homepage-events-grid');
      const cardWrappers = Array.from(document.querySelectorAll('[data-home-card-wrapper]'));
      const filterChips = Array.from(document.querySelectorAll('[data-filter-chip]'));
      const scopeChips = Array.from(document.querySelectorAll('[data-scope-chip]'));
      const statusText = document.getElementById('discovery-active-status');
      const emptyState = document.getElementById('homepage-empty-filter-state');
      const resetBtn = document.getElementById('reset-home-filters-btn');

      const CHIP_ON =
        'filter-chip inline-flex min-h-11 cursor-pointer items-center rounded-full border border-terracotta bg-terracotta px-4 text-sm font-semibold text-white transition-colors';
      const CHIP_OFF =
        'filter-chip inline-flex min-h-11 cursor-pointer items-center rounded-full border border-sand bg-cream px-4 text-sm font-medium text-ink transition-colors hover:border-terracotta-soft';
      const SCOPE_ON =
        'scope-chip inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-full border border-line bg-sand px-3.5 text-xs font-semibold text-ink transition-colors';
      const SCOPE_OFF =
        'scope-chip inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-full border border-sand bg-cream px-3.5 text-xs font-semibold text-ink transition-colors hover:border-terracotta-soft';

      let activeFilter = 'all';
      let activeScope = grid ? grid.getAttribute('data-default-metro') || 'phoenix-az' : 'phoenix-az';

      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('weekend') === 'true' || urlParams.get('date') === 'weekend') {
        activeFilter = 'weekend';
      } else if (urlParams.get('category') === 'concert') {
        activeFilter = 'concert';
      } else if (urlParams.get('category') === 'worship') {
        activeFilter = 'worship';
      }
      const metroParam = urlParams.get('metro');
      if (metroParam) {
        activeScope = metroParam;
      }

      function scopeLabel() {
        const chip = scopeChips.find(function (c) {
          return c.getAttribute('data-scope-chip') === activeScope;
        });
        return chip ? chip.getAttribute('data-scope-label') || activeScope : activeScope;
      }

      function applyChipVisuals() {
        filterChips.forEach(function (chip) {
          const active = chip.getAttribute('data-filter-chip') === activeFilter;
          chip.setAttribute('aria-pressed', active ? 'true' : 'false');
          chip.className = active ? CHIP_ON : CHIP_OFF;
        });
        scopeChips.forEach(function (chip) {
          const val = chip.getAttribute('data-scope-chip');
          const active = val === 'all' ? activeScope === 'all' : activeScope !== 'all';
          chip.setAttribute('aria-pressed', active ? 'true' : 'false');
          chip.className = active ? SCOPE_ON : SCOPE_OFF;
        });
      }

      function applyFiltering(syncUrl: boolean) {
        applyChipVisuals();
        if (!cardWrappers.length) return;

        const matchesFilter = function (wrapper: Element) {
          const cat = wrapper.getAttribute('data-card-category');
          const weekend = wrapper.getAttribute('data-card-weekend') === 'true';
          if (activeFilter === 'weekend') return weekend;
          if (activeFilter === 'concert') return cat === 'concert';
          if (activeFilter === 'worship') return cat === 'worship';
          return true;
        };

        let visibleCount = 0;
        let expandedToNationwide = false;

        const localMatches = cardWrappers.filter(function (w) {
          const metro = w.getAttribute('data-card-metro');
          return (activeScope === 'all' || metro === activeScope) && matchesFilter(w);
        });

        const shouldShowAllScopes =
          activeScope === 'all' || activeFilter === 'worship' || localMatches.length === 0;

        if (shouldShowAllScopes && activeScope !== 'all') {
          expandedToNationwide = true;
        }

        cardWrappers.forEach(function (wrapper) {
          const metro = wrapper.getAttribute('data-card-metro');
          const inScope = shouldShowAllScopes || metro === activeScope;
          const isMatch = inScope && matchesFilter(wrapper);
          if (isMatch) {
            wrapper.classList.remove('hidden');
            wrapper.classList.add('flex');
            visibleCount++;
          } else {
            wrapper.classList.add('hidden');
            wrapper.classList.remove('flex');
          }
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }

        if (statusText) {
          const unit =
            activeFilter === 'worship'
              ? visibleCount === 1
                ? 'worship night'
                : 'worship nights'
              : activeFilter === 'concert'
                ? visibleCount === 1
                  ? 'concert'
                  : 'concerts'
                : activeFilter === 'weekend'
                  ? visibleCount === 1
                    ? 'event this weekend'
                    : 'events this weekend'
                  : visibleCount === 1
                    ? 'event'
                    : 'events';
          statusText.textContent =
            activeScope === 'all' || expandedToNationwide
              ? visibleCount + ' ' + unit + ' nationwide'
              : visibleCount + ' ' + unit + ' in ' + scopeLabel();
        }

        if (syncUrl && window.history && window.history.replaceState) {
          const nextUrl = new URL(window.location.href);
          if (activeFilter === 'all') {
            nextUrl.searchParams.delete('category');
            nextUrl.searchParams.delete('weekend');
          } else if (activeFilter === 'weekend') {
            nextUrl.searchParams.delete('category');
            nextUrl.searchParams.set('weekend', 'true');
          } else {
            nextUrl.searchParams.delete('weekend');
            nextUrl.searchParams.set('category', activeFilter);
          }
          nextUrl.searchParams.set('metro', activeScope);
          window.history.replaceState({}, '', nextUrl.pathname + nextUrl.search);
        }
      }

      filterChips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          activeFilter = chip.getAttribute('data-filter-chip') || 'all';
          applyFiltering(true);
        });
      });

      scopeChips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          activeScope = chip.getAttribute('data-scope-chip') || 'phoenix-az';
          applyFiltering(true);
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          activeFilter = 'all';
          activeScope = 'all';
          applyFiltering(true);
        });
      }

      if (activeFilter !== 'all' || activeScope === 'all') {
        applyFiltering(false);
      }
    })();
  </script>
</Layout>
