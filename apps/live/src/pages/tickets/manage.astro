---
/**
 * My tickets (token-free): the orders a customer session may see. Opened by the 303 from /link after an
 * emailed `customer:all` link (30 min) — the session cookie lasts 2 hours.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import JourneyPanel from '../../components/shared/JourneyPanel.astro';
import {
  getRuntimeEnv,
  listCustomerOrders,
  nowSeconds,
  requestCustomer,
  requestSecurityHeaders,
  ticketingDb,
} from '@gamo/domain';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
requestSecurityHeaders(Astro.locals, { noReferrer: true });

const env = (await getRuntimeEnv(Astro)) as Record<string, unknown> &
  Awaited<ReturnType<typeof getRuntimeEnv>>;
let orders: Awaited<ReturnType<typeof listCustomerOrders>> = [];
let signedIn = false;
let unavailable = false;
try {
  const db = ticketingDb(env);
  const identity = await requestCustomer(db, env, Astro.request, nowSeconds());
  if (identity) {
    signedIn = true;
    orders = await listCustomerOrders(db, identity);
  }
} catch {
  unavailable = true;
  Astro.response.status = 503;
}
const upcoming = orders.filter((o) => o.startsAt * 1000 >= Date.now());
const past = orders.filter((o) => o.startsAt * 1000 < Date.now());
const statusLabel = (s: string) => s.replaceAll('_', ' ');
---

<Layout title="My tickets" noindex>
  <PageHeader
    eyebrow="Your tickets"
    title="My tickets"
    lede="Every order tied to your email address. Open one to save, download or transfer its tickets."
  />
  {unavailable ? (
    <JourneyPanel
      title="Your tickets are temporarily unavailable"
      body="Please try again in a few minutes."
      href="/tickets/find"
      label="Find my tickets"
    />
  ) : !signedIn ? (
    <JourneyPanel
      title="Open your tickets"
      body="Enter your email and we’ll send a link that works for 30 minutes. You don’t need an account."
      href="/tickets/find"
      label="Email me a link"
    />
  ) : orders.length === 0 ? (
    <JourneyPanel
      title="No tickets found"
      body="This link doesn’t cover any orders. Browse events to find your next gathering."
      href="/events"
      label="Browse events"
    />
  ) : (
    <section class="bg-cream px-4 pb-20 sm:px-8">
      <div class="mx-auto max-w-[1100px] space-y-8 py-8">
        {[
          ['Upcoming', upcoming],
          ['Past', past],
        ].map(([title, list]) =>
          (list as typeof orders).length > 0 ? (
            <div>
              <h2 class="text-lg font-black uppercase text-ink">{title as string}</h2>
              <ul class="mt-3 divide-y divide-sand rounded-2xl bg-white ring-1 ring-sand">
                {(list as typeof orders).map((o) => (
                  <li class="flex flex-col gap-2 p-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <p class="font-bold text-ink">{o.eventTitle}</p>
                      <p class="text-sm text-ink">
                        {o.when} · Order {o.reference} · {o.ticketCount} ticket
                        {o.ticketCount === 1 ? '' : 's'} · {statusLabel(o.status)}
                      </p>
                    </div>
                    <a
                      class="inline-flex min-h-11 items-center rounded-full bg-terracotta px-5 py-2.5 text-sm font-bold text-white hover:bg-terracotta-deep"
                      href={`/tickets/orders/${o.orderId}`}
                    >
                      Open tickets<span class="sr-only"> for {o.eventTitle}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null,
        )}
      </div>
    </section>
  )}
</Layout>
