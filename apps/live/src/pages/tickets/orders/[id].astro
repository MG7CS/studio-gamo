---
/**
 * Confirmation and order page (design T-06): "Save your tickets to your phone", each ticket as an image,
 * PDF / PNG downloads, download-all PDF, calendar file, map link, manage link and honest email status.
 * Requires the customer session cookie (from the confirmation, an emailed link, or the Stripe return).
 * Shows a reduced view (own tickets only) to a transfer recipient. No-JS: the page refreshes itself
 * while a payment is being turned into tickets.
 */
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/shared/PageHeader.astro';
import JourneyPanel from '../../../components/shared/JourneyPanel.astro';
import TicketCard from '../../../components/tickets/TicketCard.astro';
import FormErrorSummary from '@studio-gamo/ui/components/forms/FormErrorSummary.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import { requireSameOrigin } from '@gamo/auth';
import {
  formatMoney,
  getOrderView,
  getRuntimeEnv,
  logTicketAccess,
  mapSearchUrl,
  nowSeconds,
  refundAfterChange,
  requestCustomer,
  ticketingDb,
  type OrderView,
} from '@gamo/domain';
import { problemFromError, type FormProblem } from '../../../lib/page-forms';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
// No Referrer-Policy: no-referrer here: a no-referrer page posts `Origin: null`, which the CSRF check rejects.

const env = (await getRuntimeEnv(Astro)) as Record<string, unknown> &
  Awaited<ReturnType<typeof getRuntimeEnv>>;
const orderId = Astro.params.id ?? '';
const now = nowSeconds();
let view: OrderView | null = null;
let unavailable = false;
let problem: FormProblem | null = null;
let notice: string | null = Astro.url.searchParams.get('transferred')
  ? 'Ticket transferred. Its old QR code no longer works and the new holder has been emailed.'
  : null;

try {
  const db = ticketingDb(env);
  const identity = await requestCustomer(db, env, Astro.request, now);
  if (identity && Astro.request.method === 'POST') {
    try {
      requireSameOrigin(Astro.request);
      const form = await Astro.request.formData();
      const result = await refundAfterChange(db, env, {
        orderId,
        ticketIds: form.getAll('ticket').map(String),
        identity,
        origin: Astro.url.origin,
        now,
      });
      notice =
        result.status === 'nothing_to_do'
          ? 'Nothing changed: those tickets were already cancelled.'
          : result.amountCents > 0
            ? 'Your refund is on its way (test mode). Those tickets no longer work.'
            : 'Those tickets are cancelled. Their codes no longer work.';
    } catch (err) {
      problem = problemFromError(err);
      Astro.response.status = problem.status;
    }
  }
  view = await getOrderView(db, { orderId, session: identity, now });
  if (view && view.state === 'issued' && identity) {
    await logTicketAccess(db, {
      tickets: view.tickets
        .filter((t) => t.state === 'valid')
        .map((t) => ({ id: t.id, order_id: orderId, event_id: view!.event.id })),
      action: 'view',
      actorId: identity.customerProfileId,
      now,
    });
  }
} catch (err) {
  problem = problemFromError(err);
  unavailable = problem.status === 503;
  Astro.response.status = problem.status;
}

const waiting = view && (view.state === 'pending_payment' || view.state === 'issuing');
if (view === null && !unavailable && !problem) Astro.response.status = 404;
const map = view
  ? mapSearchUrl([view.event.venue_name, view.event.address, view.event.city, view.event.state])
  : '';
const validTickets = view?.tickets.filter((t) => t.state === 'valid') ?? [];
---

<Layout title="Your tickets" noindex>
  {waiting && <meta slot="head" http-equiv="refresh" content="4" />}
  {view ? (
    <>
      <PageHeader
        eyebrow={view.state === 'issued' ? 'You’re registered' : 'Your order'}
        title={view.event.title}
        lede={`${view.when} · ${view.event.venue_name}, ${view.event.city}. Order ${view.reference}.`}
      />
      <section class="bg-cream px-4 pb-20 sm:px-8">
        <div class="mx-auto max-w-[1100px] space-y-8 py-8">
          {notice && (
            <p role="status" class="rounded-2xl bg-white p-4 font-semibold text-ink ring-1 ring-sand">
              {notice}
            </p>
          )}
          <FormErrorSummary errors={problem?.summary ?? []} />

          {view.eventCancelled && (
            <p
              role="alert"
              class="rounded-2xl border-2 border-terracotta-deep bg-white p-4 font-semibold text-ink"
            >
              This event has been cancelled. These tickets no longer work.
            </p>
          )}

          {view.state === 'pending_payment' && (
            <JourneyPanel
              title="Waiting for your payment"
              body="If you just paid, this page refreshes by itself: payment received — issuing your tickets…"
            />
          )}
          {view.state === 'issuing' && (
            <JourneyPanel
              title="Payment received — issuing your tickets…"
              body="This usually takes a few seconds. The page refreshes by itself."
            />
          )}
          {view.state === 'pending_verification' && (
            <JourneyPanel
              title="Confirm your email to get your tickets"
              body="We emailed a 6-digit code and a button. Your tickets are held for 30 minutes."
              href="/tickets/find"
              label="Resend my link"
            />
          )}
          {view.state === 'expired' && (
            <JourneyPanel
              title="This reservation expired"
              body="The held tickets were released. You can choose tickets again."
              href={`/events/${view.event.slug}/register`}
              label="Choose tickets again"
            />
          )}
          {view.state === 'unfulfillable' && (
            <JourneyPanel
              title="We couldn't issue these tickets"
              body="Your payment was refunded automatically (test mode). Please try the event page again, or contact us if you don't see the refund."
              href={`/events/${view.event.slug}`}
              label="Back to the event"
            />
          )}

          {validTickets.length > 0 && (
            <div class="rounded-3xl bg-ink p-5 text-cream sm:p-7">
              <h2 class="text-xl font-black uppercase">Save your tickets to your phone</h2>
              <p class="mt-2 max-w-2xl">
                Take a screenshot of each ticket or save the image — do it now, in case you have no signal at
                the door. On iPhone, press and hold a ticket to save it.
              </p>
              <ul class="mt-4 flex flex-wrap gap-3">
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full bg-terracotta px-5 py-2.5 font-bold text-white hover:bg-terracotta-deep"
                    href={`/tickets/orders/${orderId}/tickets.pdf`}
                  >
                    Download all tickets (PDF)
                  </a>
                </li>
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-cream px-5 py-2.5 font-bold text-cream hover:bg-white/10"
                    href={`/tickets/orders/${orderId}/event.ics`}
                  >
                    Add to calendar
                  </a>
                </li>
                <li>
                  <a
                    class="inline-flex min-h-11 items-center rounded-full border border-cream px-5 py-2.5 font-bold text-cream hover:bg-white/10"
                    href={map}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    Open the map<span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              </ul>
              <p class="mt-4 text-sm">
                {view.emailStatus === 'sent' || view.emailStatus === 'delivered'
                  ? 'We emailed these tickets to you. Not in your inbox? Check your spam folder.'
                  : view.emailStatus === 'bounced' ||
                      view.emailStatus === 'complained' ||
                      view.emailStatus === 'suppressed'
                    ? 'We couldn’t deliver an email to your address. Download your tickets here now.'
                    : view.emailStatus === 'not_configured' || view.emailStatus === 'failed'
                      ? 'We couldn’t send the email yet. Download your tickets here — they work the same.'
                      : 'We’re emailing these tickets to you. Check your spam folder if they don’t arrive.'}
              </p>
            </div>
          )}

          {view.tickets.length > 0 && (
            <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {view.tickets.map((t, i) => (
                <li>
                  <TicketCard ticket={t} index={i} eventTitle={view!.event.title} />
                </li>
              ))}
            </ul>
          )}

          {view.purchase && view.lines.length > 0 && (
            <section aria-labelledby="summary-title" class="rounded-3xl bg-white p-5 ring-1 ring-sand sm:p-7">
              <h2 id="summary-title" class="text-lg font-black uppercase text-ink">
                Order summary
              </h2>
              <ul class="mt-3 divide-y divide-sand">
                {view.lines.map((l) => (
                  <li class="flex justify-between gap-4 py-2 text-ink">
                    <span>
                      {l.quantity} × {l.name}
                    </span>
                    <span>{l.subtotalCents === 0 ? 'Free' : formatMoney(l.subtotalCents)}</span>
                  </li>
                ))}
              </ul>
              {view.purchase.totalCents > 0 && (
                <p class="mt-3 font-bold text-ink">
                  Total {formatMoney(view.purchase.totalCents)}
                  {view.purchase.amountRefundedCents > 0 &&
                    ` · refunded ${formatMoney(view.purchase.amountRefundedCents)}`}
                  <span class="font-normal text-muted"> (test mode)</span>
                </p>
              )}
            </section>
          )}

          {view.changeRefundOpen && validTickets.length > 0 && (
            <section aria-labelledby="change-title" class="rounded-3xl bg-white p-5 ring-1 ring-sand sm:p-7">
              <h2 id="change-title" class="text-lg font-black uppercase text-ink">
                The date or venue changed
              </h2>
              <p class="mt-2 text-ink">
                Your tickets still work. If you can’t make it, you can cancel them
                {view.purchase && view.purchase.totalCents > 0 ? ' and get a refund' : ''}.
              </p>
              <form method="post" action={`/tickets/orders/${orderId}`} class="mt-4 space-y-3">
                <fieldset>
                  <legend class="font-semibold text-ink">Which tickets?</legend>
                  {validTickets.map((t) => (
                    <label class="flex min-h-11 items-center gap-3">
                      <input type="checkbox" name="ticket" value={t.id} class="h-6 w-6 accent-terracotta" />
                      <span>
                        {t.holderName} — {t.categoryName}
                      </span>
                    </label>
                  ))}
                </fieldset>
                <SubmitButton label="Cancel the selected tickets" variant="secondary" />
              </form>
            </section>
          )}

          <p class="text-sm text-muted">
            Tickets are personal and can’t be resold; the first scan admits. Lost your link?{' '}
            <a class="font-semibold text-terracotta-deep underline" href="/tickets/find">
              Find my tickets
            </a>{' '}
            ·{' '}
            <a class="font-semibold text-terracotta-deep underline" href="/tickets/manage">
              All my orders
            </a>
          </p>
        </div>
      </section>
    </>
  ) : (
    <>
      <PageHeader
        eyebrow="Your tickets"
        title="Open your tickets"
        lede="Use the link in your ticket email, or ask for a new one."
      />
      <JourneyPanel
        title={unavailable ? 'Your tickets are temporarily unavailable' : 'We can’t show this order here'}
        body={
          unavailable
            ? 'Please try again in a few minutes.'
            : 'Your link may have expired, or this order belongs to someone else. Enter your email and we’ll send a fresh link.'
        }
        href="/tickets/find"
        label="Find my tickets"
      />
    </>
  )}
</Layout>
