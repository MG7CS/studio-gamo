---
/**
 * Find my tickets (design §4.2): email → the same answer for every address → a 30-minute link in the
 * inbox that re-sends the same tickets (never new ones). Turnstile, per-IP and per-email limits.
 */
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import EmailField from '@studio-gamo/ui/components/forms/EmailField.astro';
import TurnstileWidget from '@studio-gamo/ui/components/forms/TurnstileWidget.astro';
import FormErrorSummary from '@studio-gamo/ui/components/forms/FormErrorSummary.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import { requireSameOrigin } from '@gamo/auth';
import {
  TICKETING_FORMS,
  getRuntimeEnv,
  guardPublicFormForPage,
  nowSeconds,
  requestTicketRecovery,
  ticketingDb,
} from '@gamo/domain';
import { problemFromError, problemFromGuard, type FormProblem } from '../../lib/page-forms';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const env = (await getRuntimeEnv(Astro)) as Record<string, unknown> &
  Awaited<ReturnType<typeof getRuntimeEnv>>;
let problem: FormProblem | null = null;
let answer: string | null = null;
let email = '';

if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
    const guard = await guardPublicFormForPage(
      { request: Astro.request, env: env as never },
      TICKETING_FORMS.recovery,
    );
    if (!guard.ok) problem = problemFromGuard(guard.error);
    else {
      email = guard.body.get('email') ?? '';
      const r = await requestTicketRecovery(ticketingDb(env), env, {
        email,
        ipHash: guard.ipHash,
        origin: Astro.url.origin,
        now: nowSeconds(),
      });
      answer = r.message;
    }
  } catch (err) {
    problem = problemFromError(err);
  }
  if (problem) {
    Astro.response.status = problem.status;
    for (const [k, v] of Object.entries(problem.headers)) Astro.response.headers.set(k, v);
  }
}
---

<Layout title="Find my tickets" noindex>
  <PageHeader
    eyebrow="Your tickets"
    title="Find your tickets."
    lede="Enter the email address you used. We'll email a link that opens the same tickets — it works for 30 minutes."
  />
  <section class="bg-cream px-4 pb-20 sm:px-8">
    <div class="mx-auto max-w-md rounded-[28px] bg-white p-6 ring-1 ring-sand">
      {answer ? (
        <div role="status" id="recovery-answer">
          <h2 class="text-lg font-black uppercase text-ink">Check your email</h2>
          <p class="mt-2 text-ink">{answer}</p>
          <p class="mt-4 text-sm text-muted">
            Nothing arrived? Wait a few minutes, check spam, then{' '}
            <a class="font-semibold text-terracotta-deep underline" href="/tickets/find">
              try again
            </a>
            .
          </p>
        </div>
      ) : (
        <form method="post" action="/tickets/find" class="space-y-5" novalidate>
          <FormErrorSummary errors={problem?.summary ?? []} />
          <EmailField value={email} error={problem?.fields.email} />
          <TurnstileWidget action="recovery" error={problem?.fields['cf-turnstile-response']} />
          <SubmitButton label="Email me a link" pendingLabel="Sending…" fullWidth />
        </form>
      )}
    </div>
  </section>
</Layout>
