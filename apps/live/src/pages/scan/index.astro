---
/**
 * Scanner home (the PWA start URL). A phone that unlocked a scanner goes straight to its event;
 * anyone else is told how to open a scanner link.
 */
import ScannerLayout from '../../components/scanner/ScannerLayout.astro';
import OrganizerNotice from '../../components/organizer/OrganizerNotice.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { asSqlDatabase } from '@gamo/domain/security';
import { readCookie, readScannerDevice, SCANNER_COOKIE_NAME } from '@gamo/domain/scanner';
import { nowSeconds } from '../../lib/scanner-pages';

export const prerender = false;

const env = await getRuntimeEnv(Astro);
if (env.DB && readCookie(Astro.request, SCANNER_COOKIE_NAME)) {
  try {
    const device = await readScannerDevice(
      asSqlDatabase(env.DB),
      env as Record<string, unknown>,
      Astro.request,
      nowSeconds(),
    );
    if (device) return Astro.redirect(`/scan/${encodeURIComponent(device.eventId)}`, 303);
  } catch {
    // Not configured: fall through to the instructions.
  }
}
---

<ScannerLayout title="Door scanner" heading="Door scanner">
  <OrganizerNotice kind="info" title="Open your scanner link" class="text-ink">
    Open the scanner link the organizer sent you and enter its PIN. Organizers can open the scanner from their
    event’s “Door scanners” page.
  </OrganizerNotice>
</ScannerLayout>
