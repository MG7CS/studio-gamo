---
/**
 * Manual lookup and override (dead phone, damaged print): supervisor scanners and organizers only.
 * Every lookup is written to ticket_access_log; an override needs a reason. No JavaScript needed.
 */
import ScannerLayout from '../../../components/scanner/ScannerLayout.astro';
import ScanResultPanel from '../../../components/scanner/ScanResultPanel.astro';
import LookupResults from '../../../components/scanner/LookupResults.astro';
import OrganizerNotice from '../../../components/organizer/OrganizerNotice.astro';
import { clientIp, hashIp } from '@gamo/domain/security';
import {
  lookupTickets,
  overrideAdmit,
  ScanRequestError,
  type LookupResult,
  type ScanOutcome,
} from '@gamo/domain/scanner';
import { readPostedForm } from '../../../lib/organizer-pages';
import { actorCanSupervise, gateLabel, nowSeconds, resolveScannerPage } from '../../../lib/scanner-pages';

export const prerender = false;

const page = await resolveScannerPage(Astro);
let query = '';
let found: { results: LookupResult[]; truncated: boolean } | null = null;
let outcome: ScanOutcome | null = null;
let error: string | null = null;
const ready = page.state === 'ready' ? page : null;
const allowed = ready ? actorCanSupervise(ready.actor) : false;

if (!ready) Astro.response.status = page.state === 'no_access' ? page.status : 404;
else if (!allowed) Astro.response.status = 403;
else if (Astro.request.method === 'POST') {
  const form = await readPostedForm(Astro.request);
  if (!form.ok) error = form.message;
  else {
    const ip = clientIp(Astro.request);
    let ipHash: string | null = null;
    if (ip) ipHash = await hashIp(ip, ready.env.PII_HASH_SECRET as string | undefined).catch(() => null);
    try {
      if (form.body.get('action') === 'override')
        outcome = await overrideAdmit(ready.db, {
          eventId: ready.event.id,
          ticketId: form.body.get('ticket_id') ?? '',
          reason: form.body.get('reason') ?? '',
          actor: ready.actor,
          ipHash,
          now: nowSeconds(),
        });
      else {
        query = (form.body.get('q') ?? '').trim();
        found = await lookupTickets(ready.db, {
          eventId: ready.event.id,
          query,
          actor: ready.actor,
          ipHash,
          now: nowSeconds(),
        });
      }
    } catch (err) {
      if (!(err instanceof ScanRequestError)) throw err;
      error = err.message;
      Astro.response.status = err.status;
    }
  }
}
const back = ready ? `/scan/${encodeURIComponent(ready.event.id)}` : '/scan';
---

<ScannerLayout
  title="Find a guest"
  eyebrow={ready?.event.title}
  heading="Find a guest"
  gate={ready ? gateLabel(ready.actor) : undefined}
>
  <a href={back} class="inline-flex min-h-11 items-center text-sm font-semibold text-cream underline">
    ← Back to scanning
  </a>
  {!ready ? (
    <OrganizerNotice kind="error" title="Scanner locked" class="text-ink">
      {page.state === 'no_access' ? page.message : 'Not available.'}
    </OrganizerNotice>
  ) : !allowed ? (
    <OrganizerNotice kind="error" title="Supervisors only" class="text-ink">
      Looking up guests needs a supervisor scanner link or the organizer. Ask your supervisor for help.
    </OrganizerNotice>
  ) : (
    <>
      {(outcome || error) && <ScanResultPanel outcome={outcome} error={error} />}
      <form method="post" class="space-y-3 rounded-[20px] bg-white/5 p-4 ring-1 ring-white/15">
        <input type="hidden" name="action" value="lookup" />
        <label for="lookup-q" class="text-sm font-semibold">
          Name, email or order reference
        </label>
        <input
          id="lookup-q"
          name="q"
          type="search"
          required
          minlength="2"
          maxlength="120"
          value={query}
          autocomplete="off"
          class="min-h-12 w-full rounded-xl bg-white px-3 text-base text-ink"
        />
        <p class="text-xs text-cream/75">Every lookup is recorded with your scanner name.</p>
        <button type="submit" class="min-h-12 w-full rounded-full bg-cream font-bold text-ink hover:bg-sand">
          Search
        </button>
      </form>
      {found && <LookupResults results={found.results} truncated={found.truncated} query={query} />}
    </>
  )}
</ScannerLayout>
