---
/**
 * The door scanner (PWA). Camera QR scanning (BarcodeDetector, jsQR fallback), manual code entry,
 * entry/exit mode, live headcount and an offline queue — see scripts/scanner/app.ts. Without
 * JavaScript the manual form posts here and the server answers with the result.
 */
import ScannerLayout from '../../../components/scanner/ScannerLayout.astro';
import ScanResultPanel from '../../../components/scanner/ScanResultPanel.astro';
import ScannerControls from '../../../components/scanner/ScannerControls.astro';
import OrganizerNotice from '../../../components/organizer/OrganizerNotice.astro';
import { requestSecurityHeaders } from '@gamo/domain';
import { SecretNotConfiguredError } from '@gamo/domain/security';
import {
  eventHeadcount,
  scanTicket,
  scannerKeyring,
  ScanRequestError,
  type Headcount,
  type ScanOutcome,
} from '@gamo/domain/scanner';
import { readPostedForm } from '../../../lib/organizer-pages';
import {
  actorCanSupervise,
  allowedDirections,
  gateLabel,
  nowSeconds,
  resolveScannerPage,
} from '../../../lib/scanner-pages';

export const prerender = false;

const page = await resolveScannerPage(Astro);
let outcome: ScanOutcome | null = null;
let error: string | null = null;
let direction: 'in' | 'out' = 'in';
let headcount: Headcount | null = null;

if (page.state === 'ready') {
  requestSecurityHeaders(Astro.locals, { camera: true });
  const allowed = allowedDirections(page.actor);
  direction = allowed === 'out' ? 'out' : 'in';
  if (Astro.request.method === 'POST') {
    const form = await readPostedForm(Astro.request);
    if (!form.ok) error = form.message;
    else {
      const asked = form.body.get('direction') === 'out' ? 'out' : 'in';
      direction = asked;
      try {
        outcome = await scanTicket(page.db, {
          eventId: page.event.id,
          code: form.body.get('code') ?? '',
          direction: asked,
          actor: page.actor,
          keyring: scannerKeyring(page.env as Record<string, unknown>),
          now: nowSeconds(),
        });
      } catch (err) {
        if (err instanceof ScanRequestError) {
          error = err.message;
          Astro.response.status = err.status;
        } else if (err instanceof SecretNotConfiguredError) {
          error = 'Scanning is temporarily unavailable. Use the printed guest list and tell the organizer.';
          Astro.response.status = 503;
        } else throw err;
      }
    }
  }
  headcount = await eventHeadcount(page.db, page.event.id, nowSeconds());
} else {
  Astro.response.status = page.status;
}
const ready = page.state === 'ready' ? page : null;
const scannerData = ready
  ? {
      eventId: ready.event.id,
      allowed: allowedDirections(ready.actor),
      zones: JSON.stringify(ready.actor.kind === 'scanner' ? (ready.actor.device.allowedZones ?? []) : []),
      offline: ready.actor.kind === 'scanner' ? 'yes' : 'no',
      device: ready.actor.kind === 'scanner' ? ready.actor.device.deviceId.slice(5, 13) : 'org',
    }
  : null;
---

<ScannerLayout
  title={ready ? `Scanner — ${ready.event.title}` : 'Door scanner'}
  eyebrow={ready?.event.title ?? (page.state === 'no_access' ? page.eventTitle : undefined)}
  heading="Door scanner"
  gate={ready ? gateLabel(ready.actor) : undefined}
>
  {ready && scannerData ? (
    <div
      class="flex flex-col gap-4"
      data-scanner
      data-event-id={scannerData.eventId}
      data-allowed={scannerData.allowed}
      data-zones={scannerData.zones}
      data-offline={scannerData.offline}
      data-device={scannerData.device}
    >
      <ScanResultPanel outcome={outcome} error={error} />
      <ScannerControls
        allowed={scannerData.allowed}
        direction={direction}
        headcount={headcount}
        canSupervise={actorCanSupervise(ready.actor)}
        eventId={ready.event.id}
      />
    </div>
  ) : (
    page.state === 'no_access' && (
      <OrganizerNotice kind={page.status === 200 ? 'info' : 'error'} title="Scanner locked" class="text-ink">
        {page.message}
      </OrganizerNotice>
    )
  )}
</ScannerLayout>

<script>
  import { startScanner } from '../../../scripts/scanner/app';
  const root = document.querySelector<HTMLElement>('[data-scanner]');
  if (root) startScanner(root);
</script>
