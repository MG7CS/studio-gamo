---
/**
 * Door sales and free issue (supervisor scanners and organizers, when the event policy allows):
 * issue → show the ticket with its QR → optionally admit in the same step. Never card payments.
 */
import ScannerLayout from '../../../components/scanner/ScannerLayout.astro';
import ScanResultPanel from '../../../components/scanner/ScanResultPanel.astro';
import DoorSaleForm from '../../../components/scanner/DoorSaleForm.astro';
import OrganizerNotice from '../../../components/organizer/OrganizerNotice.astro';
import { newPrefixedId, SecretNotConfiguredError } from '@gamo/domain/security';
import {
  DoorSaleError,
  doorSaleOptions,
  formatMinorUnits,
  scannerKeyring,
  sellAtDoor,
  type DoorSaleResult,
} from '@gamo/domain/scanner';
import { parseMoney, readPostedForm } from '../../../lib/organizer-pages';
import { actorCanSupervise, gateLabel, nowSeconds, resolveScannerPage } from '../../../lib/scanner-pages';

export const prerender = false;

const page = await resolveScannerPage(Astro);
const ready = page.state === 'ready' ? page : null;
const allowed = ready ? actorCanSupervise(ready.actor) : false;
let sale: DoorSaleResult | null = null;
let error: string | null = null;

if (!ready) Astro.response.status = page.state === 'no_access' ? page.status : 404;
else if (!allowed) Astro.response.status = 403;
else if (Astro.request.method === 'POST') {
  const form = await readPostedForm(Astro.request);
  if (!form.ok) error = form.message;
  else {
    const method = form.body.get('method') === 'cash_recorded' ? 'cash_recorded' : 'free_issue';
    const amount = parseMoney(form.body.get('amount'));
    try {
      sale = await sellAtDoor(ready.db, ready.env as Record<string, unknown>, {
        eventId: ready.event.id,
        actor: ready.actor,
        categoryId: form.body.get('category') ?? '',
        sectionId: form.body.get('section') || null,
        quantity: Number(form.body.get('quantity') ?? '1'),
        method,
        unitPriceCents: amount === null ? undefined : amount,
        holderName: form.body.get('name') || null,
        holderEmail: form.body.get('email') || null,
        admitNow: form.body.get('admit') === '1',
        idempotencyKey: form.body.get('idempotency_key') ?? '',
        keyring: scannerKeyring(ready.env as Record<string, unknown>),
        now: nowSeconds(),
      });
    } catch (err) {
      if (err instanceof DoorSaleError) {
        error = err.message;
        Astro.response.status = err.code === 'NOT_ALLOWED' ? 403 : 409;
      } else if (err instanceof SecretNotConfiguredError) {
        error = 'Door sales are temporarily unavailable. Write the guest down and tell the organizer.';
        Astro.response.status = 503;
      } else throw err;
    }
  }
}
const options = ready && allowed ? await doorSaleOptions(ready.db, ready.event.id) : [];
const policy = ready?.event.policy;
const methods = policy?.doorSalesEnabled ? policy.doorSalesMethods : [];
const back = ready ? `/scan/${encodeURIComponent(ready.event.id)}` : '/scan';
const toBase64 = (s: string) => btoa(String.fromCharCode(...new TextEncoder().encode(s)));
---

<ScannerLayout
  title="Door sale"
  eyebrow={ready?.event.title}
  heading="Door sale"
  gate={ready ? gateLabel(ready.actor) : undefined}
>
  <a href={back} class="inline-flex min-h-11 items-center text-sm font-semibold text-cream underline">
    ← Back to scanning
  </a>
  {!ready ? (
    <OrganizerNotice kind="error" title="Scanner locked" class="text-ink">
      {page.state === 'no_access' ? page.message : 'Not available.'}
    </OrganizerNotice>
  ) : !allowed ? (
    <OrganizerNotice kind="error" title="Supervisors only" class="text-ink">
      Door sales need a supervisor scanner link or the organizer.
    </OrganizerNotice>
  ) : (
    <>
      {error && (
        <OrganizerNotice kind="error" class="text-ink">
          {error}
        </OrganizerNotice>
      )}
      {sale && (
        <section aria-labelledby="door-issued" class="space-y-3">
          <h2 id="door-issued" class="text-lg font-black uppercase">
            {sale.tickets.length} {sale.tickets.length === 1 ? 'ticket' : 'tickets'} issued ·{' '}
            {sale.orderReference}
          </h2>
          {sale.admissions.map((a) => (
            <ScanResultPanel outcome={a} />
          ))}
          <ul class="grid gap-3 sm:grid-cols-2">
            {sale.tickets.map((t, i) => (
              <li class="rounded-2xl bg-white p-4 text-center text-ink">
                <img
                  src={`data:image/svg+xml;base64,${toBase64(sale!.qrSvgs[i]!)}`}
                  alt={`Ticket QR code for ${t.holderName}, ${t.category}`}
                  width="240"
                  height="240"
                  class="mx-auto h-60 w-60"
                />
                <p class="mt-2 font-bold">{t.holderName}</p>
                <p class="text-sm text-muted">
                  {t.category}
                  {t.section ? ` · ${t.section}` : ''}
                </p>
                <p class="mt-1 font-mono text-xs break-all">{t.payload}</p>
              </li>
            ))}
          </ul>
          <p class="text-sm text-cream/80">
            {sale.emailQueued
              ? 'The ticket was emailed to the guest.'
              : 'Show this screen to the guest or let them photograph the code.'}
          </p>
        </section>
      )}
      {methods.length === 0 ? (
        <OrganizerNotice kind="info" title="Door sales are off" class="text-ink">
          The organizer has not turned on door sales for this event.
        </OrganizerNotice>
      ) : (
        <DoorSaleForm
          options={options.map((o) => ({
            ...o,
            priceText: o.priceCents === 0 ? 'Free' : formatMinorUnits(o.priceCents, o.currency),
          }))}
          methods={methods}
          idempotencyKey={newPrefixedId('door')}
        />
      )}
    </>
  )}
</ScannerLayout>
