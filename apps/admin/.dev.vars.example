# Gamo Admin (apps/admin) — local secrets. Copy to apps/admin/.dev.vars (git-ignored).
# Shared settings (ENVIRONMENT, SESSION_SECRET) come from the root .env.
# Product Clerk accounts never grant admin access; Clerk variables are ignored in this app.
# In preview/production: `wrangler secret put <NAME> --env <preview|production>` from apps/admin.

# REQUIRED in preview/production. Cloudflare Zero Trust Access application in front of admin.
CF_ACCESS_TEAM_NAME=
CF_ACCESS_AUD=

# BREAK-GLASS (emergency) access. Ignored unless ENABLE_BREAK_GLASS_AUTH=true outside local.
# Tokens must be at least 16 characters. Leave empty in normal operation.
ENABLE_BREAK_GLASS_AUTH=
ADMIN_ACCESS_TOKEN=
ADMIN_SECRET_KEY=
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASS=
