# Gamo Admin (apps/admin) — local secrets. Copy to apps/admin/.dev.vars (git-ignored).
# Shared settings (ENVIRONMENT, SESSION_SECRET) come from the root .env.
# In preview/production: `wrangler secret put <NAME> --env <preview|production>` from apps/admin.

# REQUIRED in preview/production. Cloudflare Zero Trust Access application in front of admin.
CF_ACCESS_TEAM_NAME=
CF_ACCESS_AUD=

# RECOMMENDED outside local. One plain address that receives "new submission" staff notices (same value as on web).
INQUIRY_INBOX_EMAIL=

# Invoices (docs/RUNBOOK.md §3b). OPTIONAL. Text on manual (non-Stripe) invoice emails: how to pay Gamo.
INVOICE_PAYMENT_INSTRUCTIONS=
# Stripe Invoicing in TEST mode only (sk_test_… / rk_test_…). A live key makes admin refuse to serve. Unset: invoices are
# sent as manual invoices with INVOICE_PAYMENT_INSTRUCTIONS.
STRIPE_SECRET_KEY=
# Gate for Gamo administrative lines on invoices. Keep false (or unset) until the board approves a fee; musician pay and
# any Gamo allocation are always separate line items.
GAMO_ADMIN_FEE_APPROVED=false

# BREAK-GLASS (emergency) access. Ignored unless ENABLE_BREAK_GLASS_AUTH=true outside local.
# Tokens must be at least 16 characters. Leave empty in normal operation.
ENABLE_BREAK_GLASS_AUTH=
ADMIN_ACCESS_TOKEN=
ADMIN_SECRET_KEY=
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASS=
