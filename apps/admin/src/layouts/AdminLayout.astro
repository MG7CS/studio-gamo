---
/**
 * The only document shell in this app: floating clay panel with the sidebar (desktop) or bottom tab bar
 * (mobile), top bar and the page. Every page, including 404 and 500, renders through it. The middleware has
 * already admitted only the one admin; if the identity is somehow missing, nothing but a refusal is drawn.
 */
import '../styles/clay.css';
import HeadIcons from '@studio-gamo/ui/components/HeadIcons.astro';
import FontPreload from '@studio-gamo/ui/components/FontPreload.astro';
import BottomBar from '../components/BottomBar.astro';
import ClayBlobs from '../components/ClayBlobs.astro';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { getAdminEmail } from '../lib/gate';
import { loadCounts } from '../lib/inbox';
import type { NavKey } from '../lib/nav';

interface Props {
  title: string;
  current?: NavKey | null;
}
const { title, current = null } = Astro.props;
const email = getAdminEmail(Astro.locals);
if (!email) Astro.response.status = 403;
const counts = email ? await loadCounts((await getRuntimeEnv(Astro)).DB) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <HeadIcons />
    <FontPreload />
    <title>{`${title} · Gamo Operations`}</title>
  </head>
  <body class="font-sans text-[15px] leading-6 antialiased" data-admin-shell={email ? 'app' : 'denied'}>
    <ClayBlobs />
    {email ? (
      <>
        <a
          href="#admin-main"
          class="sr-only z-50 rounded-clay-sm bg-clay-700 px-3 py-2 text-white focus:not-sr-only focus:fixed focus:left-3 focus:top-3"
        >
          Skip to content
        </a>
        <div class="mx-auto flex min-h-screen max-w-[1480px] lg:p-6">
          <div class="flex min-h-full w-full rounded-clay-2xl bg-surface/70 shadow-card lg:backdrop-blur">
            <Sidebar current={current} email={email} counts={counts} />
            <div class="min-w-0 flex-1">
              <TopBar email={email} />
              <main id="admin-main" class="px-4 pb-32 pt-6 sm:px-8 lg:pb-12">
                <slot />
              </main>
            </div>
          </div>
        </div>
        <BottomBar current={current} counts={counts} />
      </>
    ) : (
      <main id="admin-main" class="mx-auto max-w-md px-4 py-24 text-center">
        <h1 class="text-2xl font-extrabold">Not allowed</h1>
        <p class="mt-2">This account is not allowed to use the admin.</p>
      </main>
    )}
  </body>
</html>
