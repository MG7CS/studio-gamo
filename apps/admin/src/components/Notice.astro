---
/** A message to the admin. Errors are announced as alerts, the rest as status updates. */
interface Props {
  tone: 'success' | 'error' | 'warning' | 'info';
  title?: string;
  text: string;
}
const { tone, title, text } = Astro.props;
const styles = {
  success: 'bg-mint/50 text-success',
  error: 'bg-danger-fill/30 text-danger',
  warning: 'bg-warning-fill/40 text-warning',
  info: 'bg-clay-50 text-clay-800',
}[tone];
---

<div
  role={tone === 'error' ? 'alert' : 'status'}
  class:list={['mb-5 rounded-clay-md px-4 py-3 text-sm font-medium', styles]}
>
  {tone === 'error' && <span class="sr-only">Error: </span>}
  {title && <strong class="font-extrabold">{title}. </strong>}
  {text}
</div>
