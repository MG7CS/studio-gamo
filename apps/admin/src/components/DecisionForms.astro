---
/**
 * The admin's decision forms for one profile. Each form POSTs to the profile page and carries
 * `expected_status` (the status shown) so a stale tab cannot overwrite a newer decision.
 */
import Button from './Button.astro';
import { field, hint, label } from '../lib/ui';

interface Props {
  status: string;
  actions: string[];
  isChurch: boolean;
  adminName: string;
  errorField?: string | null;
}
const { status, actions, isChurch, adminName, errorField } = Astro.props;
const has = (a: string) => actions.includes(a);
const ZONES = [
  'America/Phoenix',
  'America/Denver',
  'America/Los_Angeles',
  'America/Chicago',
  'America/New_York',
  'Pacific/Honolulu',
  'America/Anchorage',
];
const card = 'space-y-3 rounded-clay-lg bg-surface p-5 shadow-soft';
const simple = ['start_review', 'request_changes', 'reject', 'suspend', 'reinstate'] as const;
const titles = {
  start_review: 'Mark as in review',
  request_changes: 'Request changes',
  reject: 'Reject',
  suspend: 'Suspend',
  reinstate: 'Reinstate for review',
};
const buttons = {
  start_review: 'Start review',
  request_changes: 'Send request',
  reject: 'Reject',
  suspend: 'Suspend',
  reinstate: 'Reinstate',
};
---

<div class="space-y-5">
  {has('schedule_meeting') && (
    <form method="post" class={card}>
      <h3 class="text-[15px] font-bold">
        {isChurch ? 'Schedule the in-person verification meeting' : 'Schedule a meeting (optional)'}
      </h3>
      <input type="hidden" name="action" value="schedule_meeting" />
      <input type="hidden" name="expected_status" value={status} />
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label class={label} for="meeting_at">
            Date and time
          </label>
          <input
            id="meeting_at"
            name="meeting_at"
            type="datetime-local"
            required
            class={field}
            aria-invalid={errorField === 'meeting_at' ? 'true' : undefined}
          />
        </div>
        <div>
          <label class={label} for="meeting_zone">
            Time zone
          </label>
          <select id="meeting_zone" name="meeting_zone" class={field}>
            {ZONES.map((z) => (
              <option value={z} selected={z === 'America/Phoenix'}>
                {z.replace('_', ' ')}
              </option>
            ))}
          </select>
        </div>
      </div>
      <div>
        <label class={label} for="meeting_location">
          Location
        </label>
        <input
          id="meeting_location"
          name="meeting_location"
          required
          maxlength="300"
          class={field}
          aria-invalid={errorField === 'meeting_location' ? 'true' : undefined}
        />
      </div>
      <div>
        <label class={label} for="meeting_staff">
          Who is attending
        </label>
        <input
          id="meeting_staff"
          name="meeting_staff"
          required
          maxlength="120"
          value={adminName}
          class={field}
        />
      </div>
      <div>
        <label class={label} for="schedule_notes">
          Notes (optional)
        </label>
        <textarea id="schedule_notes" name="notes" rows="2" maxlength="2000" class={field}></textarea>
      </div>
      <Button variant="secondary">Schedule meeting</Button>
    </form>
  )}

  {has('verify') && (
    <form method="post" class={card}>
      <h3 class="text-[15px] font-bold">Verify</h3>
      <input type="hidden" name="action" value="verify" />
      <input type="hidden" name="expected_status" value={status} />
      <label class={label} for="verify_notes">
        Verification notes (required)
      </label>
      <textarea
        id="verify_notes"
        name="notes"
        rows="3"
        required
        maxlength="2000"
        class={field}
        aria-invalid={errorField === 'notes' ? 'true' : undefined}
      ></textarea>
      <p class={hint}>
        What you checked and with whom. {isChurch && 'The meeting date on record is attached automatically.'}
      </p>
      <Button>Verify</Button>
    </form>
  )}
  {!has('verify') && isChurch && status === 'submitted' && (
    <p class="text-sm text-body">A church can be verified once the in-person meeting is scheduled.</p>
  )}

  {simple.filter(has).map((a) => (
    <form method="post" class={card}>
      <h3 class="text-[15px] font-bold">{titles[a]}</h3>
      <input type="hidden" name="action" value={a} />
      <input type="hidden" name="expected_status" value={status} />
      {a !== 'start_review' && a !== 'reinstate' && (
        <>
          <label class={label} for={`${a}_notes`}>
            {a === 'request_changes'
              ? 'Message to the provider (required)'
              : 'Reason (required, sent to the provider)'}
          </label>
          <textarea
            id={`${a}_notes`}
            name="notes"
            rows="3"
            required
            maxlength="2000"
            class={field}
          ></textarea>
        </>
      )}
      <Button variant={a === 'reject' || a === 'suspend' ? 'danger' : 'secondary'}>{buttons[a]}</Button>
    </form>
  ))}
  {actions.length === 0 && <p class="text-sm text-body">No decision is possible in this status.</p>}
</div>
