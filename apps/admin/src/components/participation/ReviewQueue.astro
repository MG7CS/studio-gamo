---
import { requireStaff, verifyStaffBoundaryIdentity } from '@gamo/auth';
import { getDb } from '@gamo/db';
import { ParticipationService, getRuntimeEnv } from '@gamo/domain';
const env = await getRuntimeEnv(Astro);
const db = getDb(env.DB);
const auth = await requireStaff(Astro.request, db, env.SESSION_SECRET);
await verifyStaffBoundaryIdentity(db, auth, Astro.locals);
const inquiries = await new ParticipationService(db).list();
---

<section>
  <h1 class="text-3xl font-bold">Participation inquiries</h1>
  <p class="mt-3 max-w-2xl text-ink-soft">
    Review the latest 100 inquiries. Notes are visible to the person who submitted the inquiry. This review
    does not grant program access, approve partnerships or send notifications.
  </p>
  {inquiries.length === 0 ? (
    <p class="mt-8">No participation inquiries have been submitted.</p>
  ) : (
    <ul class="mt-8 divide-y divide-sand">
      {inquiries.map((inquiry) => (
        <li class="py-6">
          <div class="flex flex-wrap justify-between gap-4">
            <h2 class="text-xl font-semibold">
              {inquiry.interest} · {inquiry.name}
            </h2>
            <span>{inquiry.status}</span>
          </div>
          <p class="mt-2 text-sm text-ink-soft">
            {inquiry.kind} · {inquiry.organization || 'No organization supplied'} · {inquiry.id}
          </p>
          <p class="mt-4 whitespace-pre-wrap">{inquiry.message}</p>
          {inquiry.reviewNotes && (
            <p class="mt-4 whitespace-pre-wrap text-sm">
              <strong>Last update: </strong>
              {inquiry.reviewNotes}
            </p>
          )}
          {inquiry.status !== 'closed' && inquiry.userId !== auth.user.id && (
            <form data-review-inquiry={inquiry.id} class="mt-5 max-w-2xl space-y-4">
              <label class="block text-sm font-semibold">
                Update for the participant
                <textarea
                  name="notes"
                  minlength="1"
                  maxlength="2000"
                  required
                  rows="3"
                  class="mt-2 block w-full rounded-xl border border-ink/50 p-3"
                ></textarea>
              </label>
              <label class="block text-sm font-semibold">
                Status
                <select name="status" class="ml-3 rounded-xl border border-ink/50 p-3">
                  <option value="reviewed">Reviewed</option>
                  <option value="closed">Closed</option>
                </select>
              </label>
              <button
                type="submit"
                class="rounded-full bg-terracotta px-5 py-3 font-semibold text-white disabled:opacity-50"
              >
                Save review
              </button>
              <p role="status" aria-live="polite" data-review-result></p>
            </form>
          )}
        </li>
      ))}
    </ul>
  )}
</section>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-review-inquiry]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const button = form.querySelector<HTMLButtonElement>('button')!;
      const result = form.querySelector<HTMLElement>('[data-review-result]')!;
      button.disabled = true;
      result.textContent = 'Saving review…';
      try {
        const fields = new FormData(form);
        const response = await fetch(
          `/api/participation/${encodeURIComponent(form.dataset.reviewInquiry!)}/review`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: fields.get('status'), notes: fields.get('notes') }),
          },
        );
        const body = await response.json();
        if (!response.ok) throw new Error(body.error?.message || 'Review was not saved.');
        location.reload();
      } catch (error) {
        result.textContent = error instanceof Error ? error.message : 'Review was not saved. Please retry.';
        button.disabled = false;
      }
    });
  });
</script>
