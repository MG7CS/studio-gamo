---
/** Phone tab bar: the same four areas as the desktop sidebar. Hidden on desktop. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { SECTIONS, sectionBadge, sectionOf, type NavKey } from '../lib/nav';
import type { QueueCounts } from '../lib/inbox';

interface Props {
  current: NavKey | null;
  counts: QueueCounts | null;
}
const { current, counts } = Astro.props;
const active = sectionOf(current)?.key ?? null;
/** What the screen reader adds after the visible word, in brackets: the full name and the real waiting count. */
const extraName = (section: (typeof SECTIONS)[number]) => {
  const badge = sectionBadge(section, counts);
  const parts = [
    section.shortLabel === section.label ? '' : section.label,
    badge !== null ? `${badge} waiting` : '',
  ];
  const text = parts.filter(Boolean).join(', ');
  return text ? ` (${text})` : '';
};
---

<nav
  aria-label="Admin"
  class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-20 rounded-clay-xl bg-surface/95 p-2 shadow-card backdrop-blur lg:hidden"
>
  <ul class="flex justify-around gap-1">
    {SECTIONS.map((section) => (
      <li class="relative min-w-0 flex-1">
        <a
          href={section.href}
          aria-current={section.key === active ? 'page' : undefined}
          class:list={[
            'flex min-h-14 flex-col items-center justify-center gap-0.5 rounded-clay-md px-0.5 text-xs font-semibold',
            section.key === active ? 'bg-clay-100 text-clay-800 shadow-soft' : 'text-body',
          ]}
        >
          <Icon name={section.icon} class="h-5 w-5" />
          <span class="w-full truncate text-center text-xs font-semibold">
            {section.shortLabel}
            <span class="sr-only">{extraName(section)}</span>
          </span>
        </a>
        {sectionBadge(section, counts) !== null && (
          <span
            class="pointer-events-none absolute right-1.5 top-1 rounded-full bg-clay-700 px-1.5 text-xs font-bold leading-4 text-white"
            aria-hidden="true"
          >
            {sectionBadge(section, counts)}
          </span>
        )}
      </li>
    ))}
  </ul>
</nav>
