---
/** Mobile bottom tab bar (the design's phone layout). Hidden on desktop, where the sidebar is shown. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { TAB_ITEMS, badgeFor, tabKeyFor, type NavKey } from '../lib/nav';
import type { QueueCounts } from '../lib/inbox';

interface Props {
  current: NavKey | null;
  counts: QueueCounts | null;
}
const { current, counts } = Astro.props;
const tab = tabKeyFor(current);
---

<nav
  aria-label="Admin"
  class="fixed inset-x-3 bottom-[max(0.75rem,env(safe-area-inset-bottom))] z-20 rounded-clay-xl bg-surface/95 p-2 shadow-card backdrop-blur lg:hidden"
>
  <ul class="flex justify-around gap-1">
    {TAB_ITEMS.map((item) => (
      <li class="relative min-w-0 flex-1">
        <a
          href={item.href}
          aria-label={`${item.shortLabel === item.label ? item.label : `${item.shortLabel}: ${item.label}`}${badgeFor(item, counts) !== null ? `, ${badgeFor(item, counts)} waiting` : ''}`}
          aria-current={item.key === tab ? 'page' : undefined}
          class:list={[
            'flex min-h-14 flex-col items-center justify-center gap-0.5 rounded-clay-md px-0.5 text-xs font-semibold',
            item.key === tab ? 'bg-clay-100 text-clay-800 shadow-soft' : 'text-body',
          ]}
        >
          <Icon name={item.icon} class="h-5 w-5" />
          <span class="w-full truncate text-center text-xs font-semibold">{item.shortLabel}</span>
        </a>
        {badgeFor(item, counts) !== null && (
          <span
            class="pointer-events-none absolute right-1.5 top-1 rounded-full bg-clay-700 px-1.5 text-xs font-bold leading-4 text-white"
            aria-hidden="true"
          >
            {badgeFor(item, counts)}
          </span>
        )}
      </li>
    ))}
  </ul>
</nav>
