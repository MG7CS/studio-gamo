---
/**
 * The admin as a button that opens a small menu (a native details element; the shared interactions script closes it
 * on an outside press and Escape): who is signed in and the Cloudflare Access sign-out. Rendered once in the sidebar
 * (desktop, opens upward) and once in the phone top bar (opens downward), like the organizer area's menu.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';

interface Props {
  email: string;
  variant: 'sidebar' | 'phone';
}
const { email, variant } = Astro.props;
const initial = email.charAt(0).toUpperCase();
const inSidebar = variant === 'sidebar';
---

<details class="relative" data-menu data-user-menu={variant}>
  <summary
    class:list={[
      'flex min-h-11 cursor-pointer list-none items-center gap-3 rounded-clay-md text-ink transition-colors hover:bg-clay-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay-700 [&::-webkit-details-marker]:hidden',
      inSidebar
        ? 'w-full px-2 group-data-[sidebar=collapsed]/shell:justify-center group-data-[sidebar=collapsed]/shell:px-0'
        : 'w-11 justify-center',
    ]}
  >
    <span
      class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-clay-700 text-sm font-extrabold text-white"
      aria-hidden="true"
    >
      {initial}
    </span>
    <span
      class:list={[
        'min-w-0 flex-1 text-left leading-tight',
        inSidebar ? 'group-data-[sidebar=collapsed]/shell:sr-only' : 'sr-only',
      ]}
    >
      <span class="block truncate text-sm font-semibold text-ink">{email}</span>
      <span class="block text-xs text-muted">Administrator</span>
    </span>
  </summary>
  <div
    class:list={[
      'absolute z-40 w-72 max-w-[calc(100vw-2rem)] rounded-clay-lg bg-surface p-4 shadow-card ring-1 ring-ink/10',
      inSidebar
        ? 'bottom-full left-0 mb-2 w-full min-w-56 group-data-[sidebar=collapsed]/shell:w-64'
        : 'right-0 top-full mt-2',
    ]}
  >
    <p class="text-xs font-semibold uppercase tracking-wider text-muted">Signed in as</p>
    <p class="mt-1 break-all text-sm font-bold text-ink">{email}</p>
    <ul class="mt-3 border-t border-line pt-3">
      <li>
        <a
          href="/cdn-cgi/access/logout"
          class="flex min-h-11 items-center gap-3 rounded-clay-md px-3 text-sm font-semibold text-clay-700 transition-colors hover:bg-clay-50"
        >
          <Icon name="logout" class="h-5 w-5 shrink-0" />
          Sign out
        </a>
      </li>
    </ul>
  </div>
</details>
