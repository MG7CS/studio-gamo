---
/**
 * The roster filters: role, city, status and program. A plain GET form with an explicit Apply button
 * (no change of context on input); "Clear filters" appears when any filter is set.
 *
 * Props
 * - values: RosterFilterValues — the current filters (shown again after applying).
 */
import SelectField from '@studio-gamo/ui/components/forms/SelectField.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';
import { ROSTER_STATUSES } from '@gamo/domain/worship';
import { ROSTER_PROGRAMS, type RosterFilterValues } from '../../lib/worship/filters';
import { PROGRAM_LABEL, ROSTER_LABEL } from '../../lib/worship/labels';

interface Props {
  values: RosterFilterValues;
}

const { values } = Astro.props;
const active = Object.values(values).some(Boolean);
---

<form
  method="get"
  action="/roster"
  aria-label="Filter the roster"
  class="rounded-card border border-border bg-surface-raised p-5"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <TextField
      id="roster-role"
      name="role"
      label="Role"
      value={values.role}
      placeholder="Drums"
      maxlength={60}
    />
    <TextField id="roster-city" name="city" label="City" value={values.city} maxlength={120} />
    <SelectField
      id="roster-status"
      name="status"
      label="Status"
      placeholder="Any status"
      value={values.status}
      options={ROSTER_STATUSES.map((s) => ({ value: s, label: ROSTER_LABEL[s].text }))}
    />
    <SelectField
      id="roster-program"
      name="program"
      label="Program"
      placeholder="Any program"
      value={values.program}
      options={ROSTER_PROGRAMS.map((p) => ({ value: p, label: PROGRAM_LABEL[p] ?? p }))}
    />
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <SubmitButton label="Apply filters" pendingLabel="Filtering…" />
    {active && (
      <a
        href="/roster"
        class="inline-flex min-h-11 items-center text-small font-semibold text-action-strong underline underline-offset-4"
      >
        Clear filters
      </a>
    )}
  </div>
</form>
