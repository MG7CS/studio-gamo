---
/**
 * A roster member's offers, newest first, each linking to its request. The offer link and token are never
 * shown anywhere; only church, date, role, pay and status.
 *
 * Props
 * - offers: MemberOffer[]
 * - timeZone: string — IANA zone for the sent time.
 */
import type { MemberOffer } from '../../lib/worship/queries';
import { formatInstant, formatServiceDate } from '../../lib/worship/format';
import { OFFER_LABEL } from '../../lib/worship/labels';
import { formatCents } from '../../lib/worship/money';
import StatusLabel from './StatusLabel.astro';

interface Props {
  offers: MemberOffer[];
  timeZone: string;
}

const { offers, timeZone } = Astro.props;
---

{offers.length === 0 ? (
  <p class="text-small text-fg-muted">No offers have been sent to this member.</p>
) : (
  <ul class="divide-y divide-border">
    {offers.map((o) => (
      <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3 text-small">
        <div class="min-w-0">
          <a
            href={`/requests/${encodeURIComponent(o.requestId)}`}
            class="inline-flex min-h-11 items-center font-semibold text-action-strong underline underline-offset-4 hover:text-fg"
          >
            {o.churchName}, {formatServiceDate(o.serviceDate)}
          </a>
          <p class="text-fg-muted">
            {o.role} · {formatCents(o.payCents)} · sent {formatInstant(o.sentAt, timeZone)}
          </p>
        </div>
        <StatusLabel label={OFFER_LABEL[o.status]} />
      </li>
    ))}
  </ul>
)}
