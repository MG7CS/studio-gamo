---
/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex -- the scrollable table region must be reachable by keyboard */
/**
 * The request inbox as a captioned table (church, service, program, roles needed, status), earliest
 * service first. The church name links to the request.
 *
 * Props
 * - requests: ServiceRequest[] — one page of requests.
 * - caption: string — what the table lists.
 */
import type { ServiceRequest } from '@gamo/domain/worship';
import { formatService } from '../../lib/worship/format';
import { PROGRAM_LABEL, REQUEST_LABEL } from '../../lib/worship/labels';
import StatusLabel from './StatusLabel.astro';

interface Props {
  requests: ServiceRequest[];
  caption: string;
}

const { requests, caption } = Astro.props;
---

<div
  role="region"
  aria-label={`${caption} (scrollable table)`}
  tabindex="0"
  class="overflow-x-auto rounded-card border border-border bg-surface-raised"
>
  <table class="w-full min-w-176 border-collapse text-left text-small">
    <caption class="px-4 pt-4 pb-2 text-left text-small font-semibold text-fg">{caption}</caption>
    <thead>
      <tr class="border-b border-border text-caption text-fg-muted">
        <th scope="col" class="px-4 py-2 font-semibold">
          Church
        </th>
        <th scope="col" class="px-4 py-2 font-semibold">
          Service
        </th>
        <th scope="col" class="px-4 py-2 font-semibold">
          Program
        </th>
        <th scope="col" class="px-4 py-2 font-semibold">
          Roles needed
        </th>
        <th scope="col" class="px-4 py-2 font-semibold">
          Status
        </th>
      </tr>
    </thead>
    <tbody>
      {requests.map((r) => (
        <tr class="border-b border-border align-top last:border-b-0">
          <th scope="row" class="px-4 py-2 font-semibold">
            <a
              href={`/requests/${encodeURIComponent(r.id)}`}
              class="inline-flex min-h-11 items-center text-action-strong underline underline-offset-4 hover:text-fg"
            >
              {r.churchName}
            </a>
          </th>
          <td class="px-4 py-3 text-fg">{formatService(r.serviceDate, r.startTime)}</td>
          <td class="px-4 py-3 text-fg">{PROGRAM_LABEL[r.program] ?? r.program}</td>
          <td class="px-4 py-3 text-fg">
            {r.rolesNeeded.length > 0 ? r.rolesNeeded.join(', ') : 'Not specified'}
          </td>
          <td class="px-4 py-3">
            <StatusLabel label={REQUEST_LABEL[r.status]} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
