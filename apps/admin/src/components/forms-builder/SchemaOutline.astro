---
/** A read-only outline of a schema (a stored version): sections, questions, type, Required, show-if. */
import type { FormSchema } from '@gamo/domain/forms';
import { flattenQuestions } from '../../lib/forms-builder/schema-edit';
import { describeShowIf } from '../../lib/forms-builder/show-if';
import { BIND_LABELS } from '../../lib/forms-builder/question-form';
import { TYPE_LABELS } from '../../lib/forms-builder/view';
import { HELP } from './ui';
interface Props {
  schema: FormSchema;
  headingLevel?: 3 | 4;
}
const { schema } = Astro.props;
const flat = flattenQuestions(schema);
---

<div class="space-y-6">
  {schema.sections.map((section) => (
    <section aria-label={section.title}>
      <h3 class="text-body-sm font-bold text-fg">{section.title}</h3>
      <ol class="mt-2 space-y-2">
        {flat
          .filter((f) => f.sectionId === section.id)
          .map((f) => (
            <li class="rounded-card border border-border bg-surface-raised p-3">
              <p class={HELP}>
                Question {f.position} · {TYPE_LABELS[f.question.type]}
                {f.question.required ? ' · Required' : ''}
              </p>
              <p class="mt-1 break-words text-body-sm font-semibold text-fg">{f.question.label}</p>
              {f.question.showIf && (
                <p class={`mt-1 break-words ${HELP}`}>{describeShowIf(f.question.showIf, schema)}</p>
              )}
              {f.question.bind && <p class={`mt-1 ${HELP}`}>Fills: {BIND_LABELS[f.question.bind]}</p>}
            </li>
          ))}
      </ol>
    </section>
  ))}
</div>
