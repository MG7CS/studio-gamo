---
/**
 * The forms list: a captioned table (stacked with visible labels on a phone). Status is a chip with words.
 * Archive (close) and Reopen are one small form each; hard delete does not exist.
 */
import type { FormSummary } from '@gamo/domain/forms';
import { KIND_LABELS, PROGRAM_LABELS, formatUtc, statusChip } from '../../lib/forms-builder/view';
import HiddenFields from './HiddenFields.astro';
import StatusChip from './StatusChip.astro';
import { BTN_SMALL, LINK } from './ui';
interface Props {
  forms: FormSummary[];
}
const { forms } = Astro.props;
---

<table class="w-full text-left text-body-sm">
  <caption class="mb-3 text-left text-body-sm text-fg-muted">
    {forms.length}form{forms.length === 1 ? '' : 's'}. Questions are edited in the draft and go public only
    when you publish.
  </caption>
  <thead class="hidden md:table-header-group">
    <tr class="border-b border-border text-fg-muted">
      <th scope="col" class="py-2 pr-4 font-semibold">
        Name
      </th>
      <th scope="col" class="py-2 pr-4 font-semibold">
        Program
      </th>
      <th scope="col" class="py-2 pr-4 font-semibold">
        Status
      </th>
      <th scope="col" class="py-2 pr-4 font-semibold">
        Last edited
      </th>
      <th scope="col" class="py-2 pr-4 font-semibold">
        Submissions
      </th>
      <th scope="col" class="py-2 font-semibold">
        Actions
      </th>
    </tr>
  </thead>
  <tbody class="block md:table-row-group">
    {forms.map((f) => {
      const chip = statusChip(f);
      return (
        <tr class="mb-4 block rounded-card border border-border bg-surface-raised p-4 align-top md:mb-0 md:table-row md:rounded-none md:border-0 md:border-b md:bg-transparent md:p-0">
          <th scope="row" class="block py-1 text-left font-semibold md:table-cell md:py-3 md:pr-4">
            <a href={`/forms/${f.id}/edit`} class={LINK}>
              {f.title}
            </a>
            <span class="block break-words text-small font-normal text-fg-muted">
              {KIND_LABELS[f.kind] ?? f.kind} · {f.slug}
            </span>
          </th>
          <td class="block py-1 md:table-cell md:py-3 md:pr-4">
            <span class="font-semibold md:hidden">Program: </span>
            {PROGRAM_LABELS[f.program] ?? f.program}
          </td>
          <td class="block py-1 md:table-cell md:py-3 md:pr-4">
            <span class="font-semibold md:hidden">Status: </span>
            <StatusChip label={chip.label} tone={chip.tone} />
          </td>
          <td class="block py-1 md:table-cell md:py-3 md:pr-4">
            <span class="font-semibold md:hidden">Last edited: </span>
            {formatUtc(f.updatedAt)}
          </td>
          <td class="block py-1 md:table-cell md:py-3 md:pr-4">
            <span class="font-semibold md:hidden">Submissions: </span>
            <a
              href={`/submissions?formId=${encodeURIComponent(f.id)}`}
              class={LINK}
              aria-label={`${f.submissionCount} submissions for ${f.title}${f.newSubmissionCount > 0 ? `, ${f.newSubmissionCount} new` : ''}`}
            >
              {f.submissionCount}
              {f.newSubmissionCount > 0 ? ` (${f.newSubmissionCount} new)` : ''}
            </a>
          </td>
          <td class="block py-1 md:table-cell md:py-3">
            <div class="flex flex-wrap items-center gap-2">
              <a href={`/forms/${f.id}/edit`} class={BTN_SMALL} aria-label={`Edit: ${f.title}`}>
                Edit
              </a>
              <a href={`/forms/${f.id}/preview`} class={BTN_SMALL} aria-label={`Preview: ${f.title}`}>
                Preview
              </a>
              {f.status === 'published' && (
                <form method="post" action="/forms">
                  <HiddenFields action="form.close" op={false} extra={{ id: f.id }} />
                  <button type="submit" class={BTN_SMALL} aria-label={`Close form: ${f.title}`}>
                    Close
                  </button>
                </form>
              )}
              {f.status === 'closed' && (
                <form method="post" action="/forms">
                  <HiddenFields action="form.reopen" op={false} extra={{ id: f.id }} />
                  <button type="submit" class={BTN_SMALL} aria-label={`Reopen form: ${f.title}`}>
                    Reopen
                  </button>
                </form>
              )}
            </div>
          </td>
        </tr>
      );
    })}
  </tbody>
</table>
