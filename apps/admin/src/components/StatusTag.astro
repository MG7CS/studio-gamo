---
/** A status word on the shared pill. The word carries the meaning; the tint only supports it. */
import Pill from '@studio-gamo/ui/components/ui/Pill.astro';

interface Props {
  status: string;
  label: string;
}
const { status, label } = Astro.props;
const tone =
  status === 'verified'
    ? 'success'
    : status === 'rejected' || status === 'suspended'
      ? 'danger'
      : status === 'changes_requested'
        ? 'warning'
        : 'neutral';
---

<Pill tone={tone}>{label}</Pill>
