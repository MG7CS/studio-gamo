---
/**
 * Events waiting for review: an organizer's first event, or every event of an organizer set to "review every
 * event". Decisions and the organizer switch POST to this page.
 */
import Button from './Button.astro';
import EmptyState from './EmptyState.astro';
import { formatWhen, timeAgo } from '../lib/format';
import { field, hint, label } from '../lib/ui';
import type { PendingEvent } from '../lib/event-review';

interface Props {
  events: PendingEvent[];
}
const { events } = Astro.props;
const reason = (e: PendingEvent) =>
  e.firstEvent
    ? 'First event of this organizer'
    : e.alwaysReview
      ? 'Organizer is set to review every event'
      : 'Waiting for review';
---

{events.length === 0 ? (
  <EmptyState text="No events are waiting for review." />
) : (
  <ul class="space-y-6">
    {events.map((e) => (
      <li id={`event-${e.id}`} class="rounded-clay-lg bg-surface p-6 shadow-soft">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 class="text-xl font-extrabold">{e.title}</h2>
            {e.tagline && <p class="mt-1 text-body">{e.tagline}</p>}
          </div>
          <span class="rounded-full bg-clay-100 px-3 py-1 text-xs font-bold text-clay-800">{reason(e)}</span>
        </div>
        <dl class="mt-4 grid gap-x-8 gap-y-3 text-sm sm:grid-cols-2">
          <div>
            <dt class="font-semibold text-ink">Organizer</dt>
            <dd class="text-body">{e.organizationName}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">When</dt>
            <dd class="text-body">{formatWhen(e.startsAt, e.timezone)}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Where</dt>
            <dd class="text-body">
              {e.venue}, {e.city}, {e.state}
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Category and admission</dt>
            <dd class="text-body">
              {e.category} · {e.admission}
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">Submitted</dt>
            <dd class="text-body">{timeAgo(e.submittedAt)}</dd>
          </div>
        </dl>
        <p class="mt-4 whitespace-pre-wrap rounded-clay-md bg-surface-soft p-4 text-sm text-body shadow-inset">
          {e.description}
        </p>

        <form method="post" class="mt-5 space-y-3">
          <input type="hidden" name="kind" value="decision" />
          <input type="hidden" name="event_id" value={e.id} />
          <label class={label} for={`notes-${e.id}`}>
            Note (kept with the decision; required to reject or ask for changes)
          </label>
          <textarea id={`notes-${e.id}`} name="notes" rows="2" maxlength="2000" class={field}></textarea>
          <p class={hint}>
            The organizer is not emailed about events yet, so tell them directly if they need to act.
          </p>
          <div class="flex flex-wrap gap-3">
            <Button name="decision" value="approved">
              Approve
            </Button>
            <Button variant="secondary" name="decision" value="revision_requested">
              Ask for changes
            </Button>
            <Button variant="danger" name="decision" value="rejected">
              Reject
            </Button>
          </div>
        </form>

        <form method="post" class="mt-4">
          <input type="hidden" name="kind" value="organizer" />
          <input type="hidden" name="organizer_id" value={e.organizerId} />
          <input type="hidden" name="always_review" value={e.alwaysReview ? 'off' : 'on'} />
          <button class="inline-flex min-h-11 items-center text-sm font-semibold text-clay-700 underline underline-offset-4">
            {e.alwaysReview
              ? 'Stop reviewing every event of this organizer'
              : 'Review every event of this organizer'}
          </button>
        </form>
      </li>
    ))}
  </ul>
)}
