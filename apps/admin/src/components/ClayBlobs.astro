---
/** Soft decorative clay shapes behind the shell. CSS only, hidden from assistive technology. */
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <div class="absolute -left-24 top-24 h-72 w-72 rounded-[62%_38%_55%_45%/48%_58%_42%_52%] bg-clay-300/60 blur-[2px]"></div>
  <div class="absolute -right-16 top-1/3 h-56 w-56 rounded-[45%_55%_40%_60%/55%_45%_60%_40%] bg-mint/60"></div>
  <div class="absolute bottom-10 left-1/3 h-40 w-40 rounded-full bg-peach/50"></div>
</div>
