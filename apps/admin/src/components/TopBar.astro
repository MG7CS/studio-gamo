---
/** Phone top bar: the brand and the admin's menu. On desktop the sidebar carries both, so this bar is not shown. */
import Logo from '@studio-gamo/ui/components/Logo.astro';
import UserMenu from './UserMenu.astro';

interface Props {
  email: string;
}
const { email } = Astro.props;
---

<header class="flex items-center justify-between gap-4 px-4 pt-4 sm:px-6 lg:hidden">
  <a href="/" class="flex min-h-11 items-center gap-2 text-ink">
    <Logo width={120} height={22} />
    <span class="text-xs font-semibold uppercase tracking-widest text-muted">Admin</span>
  </a>
  <UserMenu email={email} variant="phone" />
</header>
