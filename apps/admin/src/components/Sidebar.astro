---
/** Desktop sidebar: brand, navigation with the active item raised, and the admin with the Access sign-out. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import BrandMark from './BrandMark.astro';
import { NAV_ITEMS, badgeFor, type NavKey } from '../lib/nav';
import type { QueueCounts } from '../lib/inbox';

interface Props {
  current: NavKey | null;
  counts: QueueCounts | null;
  email: string;
}
const { current, email, counts } = Astro.props;
---

<aside class="hidden w-72 shrink-0 flex-col gap-8 p-6 lg:flex">
  <a href="/" class="flex items-center gap-3 rounded-clay-md">
    <BrandMark />
    <span class="leading-tight">
      <span class="block text-lg font-extrabold text-ink">Gamo</span>
      <span class="block text-xs font-semibold uppercase tracking-widest text-muted">Operations</span>
    </span>
  </a>
  <nav aria-label="Admin" class="flex-1">
    <ul class="space-y-2">
      {NAV_ITEMS.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.key === current ? 'page' : undefined}
            class:list={[
              'flex min-h-12 items-center gap-3 rounded-clay-md px-4 text-sm font-semibold transition-shadow',
              item.key === current
                ? 'bg-clay-100 text-clay-800 shadow-soft'
                : 'text-body hover:bg-surface-soft hover:shadow-soft',
            ]}
          >
            <Icon name={item.icon} class="h-5 w-5" />
            <span class="flex-1">{item.label}</span>
            {badgeFor(item, counts) !== null && (
              <span
                class="rounded-full bg-clay-700 px-2.5 py-0.5 text-xs font-bold text-white"
                aria-label={`${badgeFor(item, counts)} waiting`}
              >
                {badgeFor(item, counts)}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="rounded-clay-lg bg-surface-soft p-4 shadow-inset">
    <p class="text-xs font-semibold uppercase tracking-wider text-muted">Signed in as</p>
    <p class="mt-1 break-all text-sm font-semibold text-ink">{email}</p>
    <a
      href="/cdn-cgi/access/logout"
      class="mt-3 flex min-h-11 items-center gap-2 rounded-clay-sm text-sm font-semibold text-clay-700 underline-offset-4 hover:underline"
    >
      <Icon name="logout" class="h-5 w-5" />
      Sign out
    </a>
  </div>
</aside>
