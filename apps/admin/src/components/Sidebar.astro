---
/**
 * Desktop sidebar: the Gamo Studios logo with an Admin label, navigation with the active item raised, and the
 * admin's menu (who is signed in, the Access sign-out) at the bottom. It collapses to an icon rail
 * (`body[data-sidebar=collapsed]`, set by the shared sidebar script): labels stay in the page for screen readers and show as tooltips, badges become small
 * corner counts, and the logo becomes the official Gamo symbol (no other mark is used).
 *
 * Tailwind only generates classes it can read literally, so the collapsed variants are spelled out in full.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import Logo from '@studio-gamo/ui/components/Logo.astro';
import UserMenu from './UserMenu.astro';
import { SECTIONS, sectionBadge, sectionOf, type NavKey } from '../lib/nav';
import type { QueueCounts } from '../lib/inbox';

interface Props {
  current: NavKey | null;
  email: string;
  counts: QueueCounts | null;
}
const { current, email, counts } = Astro.props;
const active = sectionOf(current)?.key ?? null;
---

<aside
  id="admin-sidebar"
  class="hidden w-[272px] shrink-0 flex-col gap-4 bg-surface p-4 shadow-soft group-data-[sidebar=collapsed]/shell:w-20 group-data-[sidebar=collapsed]/shell:px-3 lg:sticky lg:top-0 lg:z-30 lg:flex lg:h-screen"
>
  <a
    href="/"
    class="block rounded-clay-md text-ink group-data-[sidebar=collapsed]/shell:mx-auto"
    title="Gamo Studios Admin"
  >
    <span class="block group-data-[sidebar=collapsed]/shell:hidden">
      <Logo width={168} height={31} />
      <span class="mt-2 block text-xs font-semibold uppercase tracking-widest text-muted">Admin</span>
    </span>
    {/* The collapsed rail shows the mark in the brand orange (the favicon turns cream in a dark browser theme). */}
    <svg
      class="hidden h-9 w-9 text-clay-700 group-data-[sidebar=collapsed]/shell:block"
      viewBox="0 0 28 28"
      fill="none"
      aria-hidden="true"
    >
      <rect x="2" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.8" />
      <rect x="7.2" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.92" />
      <rect x="12.4" y="2.5" width="3.2" height="23" rx="1.6" fill="currentColor" />
      <rect x="17.6" y="6" width="3.2" height="16" rx="1.6" fill="currentColor" opacity="0.92" />
      <rect x="22.8" y="10" width="3.2" height="8" rx="1.6" fill="currentColor" opacity="0.8" />
    </svg>
    <span class="hidden group-data-[sidebar=collapsed]/shell:block group-data-[sidebar=collapsed]/shell:sr-only">
      Gamo Studios Admin home
    </span>
  </a>
  <button
    type="button"
    hidden
    data-sidebar-toggle
    data-sidebar-key="admin-sidebar"
    aria-controls="admin-sidebar"
    aria-expanded="true"
    class="hidden min-h-11 w-full items-center gap-3 rounded-clay-md px-4 text-sm font-semibold text-body hover:bg-surface-soft hover:shadow-soft group-data-[sidebar=collapsed]/shell:justify-center group-data-[sidebar=collapsed]/shell:px-0 lg:flex"
  >
    <Icon name="menu" class="h-5 w-5 shrink-0" />
    <span data-sidebar-label class="group-data-[sidebar=collapsed]/shell:sr-only">
      Collapse menu
    </span>
  </button>
  <nav aria-label="Admin" class="-mx-3 -my-2 min-h-0 flex-1 overflow-y-auto px-3 py-2">
    <ul class="space-y-1.5">
      {SECTIONS.map((section) => {
        const badge = sectionBadge(section, counts);
        return (
          <li>
            <a
              href={section.href}
              title={section.label}
              aria-current={section.key === active ? 'page' : undefined}
              class:list={[
                'relative flex min-h-11 items-center gap-2.5 rounded-clay-md px-3 text-[13px] font-semibold transition-shadow group-data-[sidebar=collapsed]/shell:justify-center group-data-[sidebar=collapsed]/shell:px-0',
                section.key === active
                  ? 'bg-clay-100 text-clay-800 shadow-soft'
                  : 'text-body hover:bg-surface-soft hover:shadow-soft',
              ]}
            >
              <Icon name={section.icon} class="h-5 w-5 shrink-0" />
              <span class="flex-1 group-data-[sidebar=collapsed]/shell:sr-only">{section.label}</span>
              {badge !== null && (
                <span class="rounded-full bg-clay-700 px-2.5 py-0.5 text-xs font-bold text-white group-data-[sidebar=collapsed]/shell:absolute group-data-[sidebar=collapsed]/shell:right-1 group-data-[sidebar=collapsed]/shell:top-1 group-data-[sidebar=collapsed]/shell:px-1.5 group-data-[sidebar=collapsed]/shell:text-[10px] group-data-[sidebar=collapsed]/shell:leading-4">
                  {badge}
                  <span class="sr-only"> waiting</span>
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
  <div class="border-t border-line pt-3">
    <UserMenu email={email} variant="sidebar" />
  </div>
</aside>
