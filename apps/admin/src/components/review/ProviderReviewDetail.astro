---
/** One provider profile for staff: what the provider entered, the decision forms and the history. */
import ReviewActionForms from './ReviewActionForms.astro';
import type { ProviderDetailView } from '../../lib/review-pages';

interface Props {
  view: ProviderDetailView;
  staffName: string;
  errorField?: string | null;
}
const { view, staffName, errorField } = Astro.props;
const when = (s: number, zone = 'America/Phoenix') =>
  new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: zone, timeZoneName: 'short' }).format(
    new Date(s * 1000),
  );
---

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]">
  <div class="space-y-6">
    <section class="rounded-2xl border border-sand bg-white p-5" aria-labelledby="provider-facts">
      <h2 id="provider-facts" class="text-lg font-semibold text-charcoal">{view.profile.displayName}</h2>
      <p class="mt-1 text-sm text-ink-soft">
        {view.roleLabel} · status <strong class="text-charcoal">{view.statusLabel}</strong> · from {view.profile.productOrigin}
        {view.profile.publishedAt ? ' · published' : ' · not public'}
      </p>
      <p class="mt-1 text-sm text-ink-soft">Contact: {view.personEmail ?? 'erased or unavailable'}</p>
      <dl class="mt-4 divide-y divide-sand">
        {
          view.fields.map((f) => (
            <div class="grid gap-1 py-2.5 sm:grid-cols-[12rem_minmax(0,1fr)]">
              <dt class="text-sm font-semibold text-charcoal">{f.label}</dt>
              <dd class="break-words text-sm text-charcoal">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
    <section class="rounded-2xl border border-sand bg-white p-5" aria-labelledby="provider-history">
      <h2 id="provider-history" class="text-lg font-semibold text-charcoal">History</h2>
      {
        view.history.length === 0 ? (
          <p class="mt-2 text-sm text-ink-soft">No decisions yet.</p>
        ) : (
          <ol class="mt-3 space-y-3">
            {view.history.map((h) => (
              <li class="text-sm text-charcoal">
                <strong>{h.action.replace(/_/g, ' ')}</strong> ({h.fromStatus ?? '—'} → {h.toStatus ?? '—'}) ·{' '}
                {when(h.createdAt)} {h.staffName ? `· ${h.staffName}` : ''}
                {h.meetingAt && <span class="block text-ink-soft">Meeting: {when(h.meetingAt)}{h.meetingLocation ? `, ${h.meetingLocation}` : ''}</span>}
                {h.notes && <span class="block text-ink-soft">{h.notes}</span>}
              </li>
            ))}
          </ol>
        )
      }
    </section>
  </div>
  <section aria-labelledby="provider-actions">
    <h2 id="provider-actions" class="mb-3 text-lg font-semibold text-charcoal">Decide</h2>
    <ReviewActionForms
      id={view.profile.id}
      status={view.profile.status}
      actions={view.actions}
      isChurch={view.profile.role === 'church'}
      staffName={staffName}
      errorField={errorField}
    />
  </section>
</div>
