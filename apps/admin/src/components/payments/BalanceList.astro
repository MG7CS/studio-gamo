---
/**
 * Mode B: what Gamo owes each organization from the ticket money it collected, what can be paid out now (events whose
 * dates have all passed, less payouts already prepared), and a form to prepare a payout. Preparing sends nothing.
 */
import Button from '../Button.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import NoteField from '../NoteField.astro';
import { formatCents } from '@gamo/domain';
import { field, hint, label } from '../../lib/ui';
import type { BalanceRow } from '../../lib/payments-admin';

interface Props {
  rows: BalanceRow[];
}
const { rows } = Astro.props;
---

{rows.length === 0 ? (
  <EmptyState
    title="Gamo holds no money for any organization."
    text="In Mode B, Gamo collects the ticket money and owes it to the organization; balances appear here."
  />
) : (
  <ul class="space-y-3">
    {rows.map((b) => (
      <li class="rounded-clay-lg bg-surface p-5 shadow-soft">
        <h2 class="text-[15px] font-bold text-ink">
          <a
            class="underline underline-offset-4"
            href={`/organizations/${encodeURIComponent(b.organizationId)}#payments`}
          >
            {b.name}
          </a>
        </h2>
        <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-4">
          <div>
            <dt class="text-[12px] font-semibold text-muted">Owed</dt>
            <dd class="font-bold text-ink">{formatCents(b.owedCents)}</dd>
          </div>
          <div>
            <dt class="text-[12px] font-semibold text-muted">From events still ahead</dt>
            <dd class="font-bold text-ink">{formatCents(b.availability.notYetPayableCents)}</dd>
          </div>
          <div>
            <dt class="text-[12px] font-semibold text-muted">Payouts not sent yet</dt>
            <dd class="font-bold text-ink">{formatCents(b.pendingPayoutCents)}</dd>
          </div>
          <div>
            <dt class="text-[12px] font-semibold text-muted">Available to pay out</dt>
            <dd class="font-bold text-ink">{formatCents(b.availability.availableCents)}</dd>
          </div>
        </dl>
        {b.availability.availableCents > 0 ? (
          <form method="post" class="mt-4 space-y-3">
            <input type="hidden" name="action" value="prepare_payout" />
            <input type="hidden" name="organization_id" value={b.organizationId} />
            <div class="max-w-xs">
              <label class={label} for={`amount-${b.organizationId}`}>
                Amount in dollars (optional)
              </label>
              <input
                id={`amount-${b.organizationId}`}
                name="amount"
                inputmode="decimal"
                maxlength="12"
                class={field}
                aria-describedby={`amount-${b.organizationId}-hint`}
              />
              <p id={`amount-${b.organizationId}-hint`} class={hint}>
                Empty pays out everything available: {formatCents(b.availability.availableCents)}.
              </p>
            </div>
            <NoteField
              id={`prepare-${b.organizationId}`}
              name="reason"
              label="Reason (required, kept with the payout)"
              required
              maxlength={500}
            />
            <Button variant="secondary">Prepare payout</Button>
          </form>
        ) : (
          <p class="mt-3 text-[13px] text-body">
            Nothing to pay out now: money is paid out once every date of its events has passed.
          </p>
        )}
      </li>
    ))}
  </ul>
)}
