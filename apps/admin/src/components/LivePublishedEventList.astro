---
/**
 * Organizer events that are live or hidden, so Gamo can pull one down (a note is required and goes to the
 * organization's owners) or put it back. Decisions POST to /events.
 */
import Button from './Button.astro';
import EmptyState from './EmptyState.astro';
import StatusTag from './StatusTag.astro';
import { formatWhen } from '../lib/format';
import { field, hint, label } from '../lib/ui';
import type { AdminPublishedEvent } from '@gamo/domain';

interface Props {
  events: AdminPublishedEvent[];
}
const { events } = Astro.props;
---

{events.length === 0 ? (
  <EmptyState text="No organizer events are published yet." />
) : (
  <ul class="space-y-3">
    {events.map((e) => (
      <li class="rounded-clay-lg bg-surface p-5 shadow-soft">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="text-base font-extrabold">{e.title}</h3>
            <p class="mt-1 text-sm text-body">
              <a class="underline underline-offset-4" href={`/organizations/${e.organizationId}`}>
                {e.organizationName}
              </a>{' '}
              · {e.city}, {e.state}
              {e.firstStartsAt ? ` · ${formatWhen(e.firstStartsAt, e.timezone)}` : ''}
            </p>
          </div>
          <StatusTag
            status={e.status === 'hidden' ? 'suspended' : 'verified'}
            label={e.status === 'hidden' ? 'Hidden' : 'Public'}
          />
        </div>
        <form method="post" class="mt-4 space-y-3">
          <input type="hidden" name="event_id" value={e.id} />
          {e.status === 'published' && (
            <>
              <label class={label} for={`hide-note-${e.id}`}>
                Why you are hiding it (sent to the organizers)
              </label>
              <textarea
                id={`hide-note-${e.id}`}
                name="notes"
                rows="2"
                maxlength="2000"
                required
                class={field}
              ></textarea>
              <p class={hint}>
                Hiding removes it from every public page. Existing registrations are not changed.
              </p>
              <Button variant="danger" name="action" value="hide">
                Hide event
              </Button>
            </>
          )}
          {e.status === 'hidden' && (
            <Button variant="secondary" name="action" value="restore">
              Restore event
            </Button>
          )}
        </form>
      </li>
    ))}
  </ul>
)}
