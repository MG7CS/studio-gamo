---
/** A review queue: status and role filters, then the profiles (oldest first), each linking to its page. */
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import Toolbar from '@studio-gamo/ui/components/ui/Toolbar.astro';
import StatusTag from './StatusTag.astro';
import { QUEUE_LIMIT, type QueueView } from '../lib/review-data';
import { timeAgo } from '../lib/format';

interface Props {
  basePath: string;
  /** Where a row links: `/churches` or `/providers` (the profile id is appended). */
  itemBase: string;
  queue: QueueView;
  roles?: { value: string; label: string }[];
  emptyText: string;
}
const { basePath, itemBase, queue, roles = [], emptyText } = Astro.props;
const { filter, filters, items, roleFilter, truncated } = queue;
const filterLabels: Record<string, string> = {
  open: 'Waiting for you',
  changes_requested: 'Changes requested',
  verified: 'Verified',
  rejected: 'Rejected',
  suspended: 'Suspended',
  draft: 'Drafts',
};
const href = (status: string, role?: string | null) => {
  const p = new URLSearchParams({ status });
  if (role) p.set('role', role);
  return `${basePath}?${p}`;
};
---

<Toolbar
  variant="clay"
  class="mb-5"
  groups={[
    {
      label: 'Filter by status',
      items: filters.map((f) => ({
        label: filterLabels[f] ?? f,
        href: href(f, roleFilter),
        active: f === filter,
      })),
    },
    {
      label: 'Filter by role',
      items:
        roles.length > 1
          ? [{ value: '', label: 'All roles' }, ...roles].map((r) => ({
              label: r.label,
              href: href(filter, r.value || null),
              active: (roleFilter ?? '') === r.value,
            }))
          : [],
    },
  ]}
/>
{items.length === 0 ? (
  <EmptyState title={emptyText} />
) : (
  <>
    <ul class="space-y-3">
      {items.map((item) => (
        <li>
          <a
            href={`${itemBase}/${encodeURIComponent(item.id)}`}
            class="flex flex-wrap items-center justify-between gap-3 rounded-clay-lg bg-surface p-5 shadow-soft transition-shadow hover:shadow-card"
          >
            <span class="min-w-0">
              <span class="block truncate font-bold text-ink">{item.displayName}</span>
              <span class="block text-sm text-muted">
                {item.roleLabel} · from {item.productOrigin} · updated {timeAgo(item.updatedAt)}
              </span>
            </span>
            <StatusTag status={item.status} label={item.statusLabel} />
          </a>
        </li>
      ))}
    </ul>
    {truncated && (
      <p class="mt-4 text-sm text-muted">Showing the first {QUEUE_LIMIT}. Older entries are not listed.</p>
    )}
  </>
)}
