---
/**
 * What staff can do with an invoice in its current status. Each action posts to its API route and comes
 * back with a notice. Destructive or irreversible steps (mark paid, void) sit behind a disclosure with an
 * explicit confirm button, so nothing happens on a single click.
 *
 *   draft: Send (says whether Stripe test mode or manual instructions will be used), Void
 *   open:  Send the email again, Mark paid, Void
 *   paid / void: nothing (payouts are in the payouts block)
 *
 * Props
 * - invoice: Invoice; stripeTest: boolean — a Stripe test key is configured (shows the test-mode note).
 */
import { PAYMENT_METHODS, type Invoice } from '@gamo/domain/invoices';
import SelectField from '@studio-gamo/ui/components/forms/SelectField.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';
import { formatUsd } from '../../lib/invoices/money';
import { PAYMENT_METHOD_LABEL, invoiceActions, sendModeNote } from '../../lib/invoices/view';
import InvoicePanel from './InvoicePanel.astro';

interface Props {
  invoice: Invoice;
  stripeTest: boolean;
}

const { invoice, stripeTest } = Astro.props;
const can = invoiceActions(invoice.status);
const base = `/api/invoices/${encodeURIComponent(invoice.id)}`;
const note = sendModeNote(stripeTest);
const methods = PAYMENT_METHODS.map((m) => ({ value: m, label: PAYMENT_METHOD_LABEL[m] }));
const summary =
  'inline-flex min-h-11 cursor-pointer items-center rounded-pill border border-fg-muted bg-surface-raised px-5 text-base font-semibold text-fg hover:bg-surface-inset';
---

{(can.send || can.resend || can.markPaid || can.void) && (
  <InvoicePanel id="actions" title="Actions">
    <div class="space-y-6">
      {can.send && (
        <div>
          <p class="max-w-prose text-small text-fg" data-send-note={note.mode}>
            {note.text}
          </p>
          <form method="post" action={`${base}/send`} class="mt-3">
            <SubmitButton label="Send invoice" pendingLabel="Sending…" />
          </form>
        </div>
      )}
      {can.resend && (
        <div>
          <p class="max-w-prose text-small text-fg">
            This invoice is open. If the customer did not get the email, send it again; a delivered email is
            never sent twice.
            {stripeTest && ' Stripe is in test mode: no real charges.'}
          </p>
          <form method="post" action={`${base}/send`} class="mt-3">
            <SubmitButton label="Send the email again" pendingLabel="Sending…" variant="secondary" />
          </form>
        </div>
      )}
      {can.markPaid && (
        <details class="rounded-card border border-border p-4">
          <summary class={summary}>Mark paid</summary>
          <form method="post" action={`${base}/mark-paid`} class="mt-4 grid gap-4 sm:grid-cols-2">
            <p class="max-w-prose text-small text-fg sm:col-span-2">
              Confirm that {formatUsd(invoice.totalCents)} was received. The receipt is emailed to{' '}
              {invoice.billToEmail}.
            </p>
            <SelectField
              id="paid-method"
              name="method"
              label="How it was paid"
              options={methods}
              placeholder="Choose a method"
              required
            />
            <TextField
              id="paid-reference"
              name="reference"
              label="Reference (optional)"
              hint="A check number or transfer reference."
              maxlength={200}
              autocomplete="off"
            />
            <div class="sm:col-span-2">
              <SubmitButton label={`Confirm: mark ${invoice.number} paid`} pendingLabel="Saving…" />
            </div>
          </form>
        </details>
      )}
      {can.void && (
        <details class="rounded-card border border-border p-4">
          <summary class={summary}>Void invoice</summary>
          <form method="post" action={`${base}/void`} class="mt-4">
            <p class="max-w-prose text-small text-fg">
              Voiding cancels {invoice.number}
              {invoice.stripeInvoiceId ? ' and its Stripe test invoice' : ''}. It cannot be undone, and a void
              invoice cannot be paid.
            </p>
            <button
              type="submit"
              class="mt-3 inline-flex min-h-11 items-center justify-center rounded-pill border-2 border-danger bg-surface-raised px-7 py-2.5 text-base font-semibold text-danger hover:bg-surface-inset"
            >
              {`Confirm: void ${invoice.number}`}
            </button>
          </form>
        </details>
      )}
    </div>
  </InvoicePanel>
)}
