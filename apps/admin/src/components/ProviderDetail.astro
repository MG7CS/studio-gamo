---
/** One profile: what the provider entered, the decision history, and the decision forms. */
import DecisionForms from './DecisionForms.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import StatusTag from './StatusTag.astro';
import type { ProviderDetailView } from '../lib/review-data';
import { formatWhen } from '../lib/format';

interface Props {
  view: ProviderDetailView;
  adminName: string;
  errorField?: string | null;
}
const { view, adminName, errorField } = Astro.props;
const when = formatWhen;
const card = 'rounded-clay-lg bg-surface p-6 shadow-soft';
---

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]">
  <div class="space-y-6">
    <section class={card} aria-labelledby="profile-facts">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 id="profile-facts" class="text-[16px] font-bold">
          {view.profile.displayName}
        </h2>
        <StatusTag status={view.profile.status} label={view.statusLabel} />
      </div>
      <p class="mt-1 text-sm text-muted">
        {view.roleLabel} · from {view.profile.productOrigin} ·{' '}
        {view.profile.publishedAt ? 'published' : 'not public'}
      </p>
      <p class="mt-1 text-sm text-body">Contact: {view.personEmail ?? 'erased or unavailable'}</p>
      <dl class="mt-4 divide-y divide-line">
        {view.fields.map((f) => (
          <div class="grid gap-1 py-3 sm:grid-cols-[12rem_minmax(0,1fr)]">
            <dt class="text-sm font-semibold text-ink">{f.label}</dt>
            <dd class="break-words text-sm text-body">{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>
    <section class={card} aria-labelledby="profile-history">
      <h2 id="profile-history" class="text-[16px] font-bold">
        History
      </h2>
      <div class="mt-3">
        {view.history.length === 0 ? (
          <EmptyState title="No decisions yet." />
        ) : (
          <ol class="space-y-4">
            {view.history.map((h) => (
              <li class="text-sm text-body">
                <strong class="text-ink">{h.action.replace(/_/g, ' ')}</strong> ({h.fromStatus ?? '—'} →{' '}
                {h.toStatus ?? '—'}) · {when(h.createdAt)}
                {h.staffName ? ` · ${h.staffName}` : ''}
                {h.meetingAt && (
                  <span class="block text-muted">
                    Meeting: {when(h.meetingAt)}
                    {h.meetingLocation ? `, ${h.meetingLocation}` : ''}
                  </span>
                )}
                {h.notes && <span class="block text-muted">{h.notes}</span>}
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  </div>
  <section aria-labelledby="profile-decide">
    <h2 id="profile-decide" class="mb-3 text-[16px] font-bold">
      Decide
    </h2>
    <DecisionForms
      status={view.profile.status}
      actions={view.actions}
      isChurch={view.profile.role === 'church'}
      adminName={adminName}
      errorField={errorField}
    />
  </section>
</div>
