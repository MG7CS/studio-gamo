  aria-hidden="true"
>
  <svg viewBox="-15 -4 184 184" class="h-6 w-6 fill-white">
    <rect x="0" y="54" width="22" height="68" rx="11"></rect>
    <rect x="33" y="25" width="22" height="126" rx="11"></rect>
    <rect x="66" y="0" width="22" height="176" rx="11"></rect>
    <rect x="99" y="25" width="22" height="126" rx="11"></rect>
    <rect x="132" y="54" width="22" height="68" rx="11"></rect>
  </svg>
</span>
