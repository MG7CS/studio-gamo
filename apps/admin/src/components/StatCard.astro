---
/**
 * One real count. `tone` only tints the icon chip; the number and the words carry the meaning. With an
 * `href` the whole card is a link to the queue.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import type { IconName } from '@studio-gamo/ui/lib/icons';

interface Props {
  label: string;
  value: number;
  icon: IconName;
  tone: 'terracotta' | 'sand' | 'tan' | 'ink';
  href?: string;
}
const { label, value, icon, tone, href } = Astro.props;
const chip = {
  terracotta: 'bg-terracotta-soft/25 text-terracotta-deep',
  sand: 'bg-sand text-ink',
  tan: 'bg-tan/50 text-terracotta-deep',
  ink: 'bg-ink/10 text-ink',
}[tone];
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'block rounded-clay-lg bg-surface p-4 shadow-soft sm:p-5',
    href && 'transition-shadow hover:shadow-card',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <p class="text-sm font-semibold leading-snug text-body">{label}</p>
    <span
      class:list={['grid h-9 w-9 shrink-0 place-items-center rounded-full sm:h-10 sm:w-10', chip]}
      aria-hidden="true"
    >
      <Icon name={icon} class="h-5 w-5" />
    </span>
  </div>
  <p class="mt-3 text-4xl font-extrabold tracking-tight text-ink">{value}</p>
  <p class="mt-1 text-sm text-muted">waiting for you</p>
</Tag>
