---
/**
 * One real count. `tone` only tints the icon chip; the number and the words carry the meaning. With an
 * `href` the whole card is a link to the queue.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import type { IconName } from '@studio-gamo/ui/lib/icons';

interface Props {
  label: string;
  value: number;
  icon: IconName;
  tone: 'terracotta' | 'sand' | 'tan' | 'ink';
  href?: string;
}
const { label, value, icon, tone, href } = Astro.props;
const chip = {
  terracotta: 'bg-terracotta-soft/25 text-terracotta-deep',
  sand: 'bg-sand text-ink',
  tan: 'bg-tan/50 text-terracotta-deep',
  ink: 'bg-ink/10 text-ink',
}[tone];
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'block rounded-clay-lg bg-surface p-4 shadow-soft',
    href && 'transition-shadow hover:shadow-card',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <p class="text-[13px] font-semibold leading-snug text-body">{label}</p>
    <span class:list={['grid h-8 w-8 shrink-0 place-items-center rounded-full', chip]} aria-hidden="true">
      <Icon name={icon} class="h-[18px] w-[18px]" />
    </span>
  </div>
  <p class="mt-1 text-[28px] font-black leading-none tracking-tight text-ink">{value}</p>
  <p class="mt-1.5 text-[12px] text-muted">waiting for you</p>
  {href && <span class="sr-only">. Opens the list.</span>}
</Tag>
