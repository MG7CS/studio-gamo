---
/**
 * Overview: everything waiting for the admin (counts and the longest-waiting items) and every event and listing on a
 * calendar, all from real queries. No trends or history, because none is recorded.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import ScheduleCalendar from '../components/ScheduleCalendar.astro';
import ScheduleDay from '../components/ScheduleDay.astro';
import StartingSoonCard from '../components/StartingSoonCard.astro';
import StatCard from '../components/StatCard.astro';
import WaitingList from '../components/WaitingList.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { loadInbox, waitingTotal } from '../lib/inbox';
import { loadAdminSchedule } from '../lib/schedule';

const env = await getRuntimeEnv(Astro);
const inbox = await loadInbox(env);
const schedule = inbox?.liveAvailable ? await loadAdminSchedule(env, 'all', Astro.url) : null;
const total = inbox ? waitingTotal(inbox.counts) : 0;
const summary = !inbox
  ? undefined
  : total === 0
    ? 'Nothing is waiting for you.'
    : `${total} ${total === 1 ? 'item is' : 'items are'} waiting for you.`;
---

<AdminLayout title="Overview" current="overview">
  <PageHeader title="Overview" description={summary} />
  {!inbox && (
    <Notice tone="danger" title="Counts unavailable" class="mb-5">
      The database could not be read, so nothing is shown instead of guessing. Try again in a moment.
    </Notice>
  )}
  {inbox && !inbox.liveAvailable && (
    <Notice tone="warning" title="Gamo Live unavailable" class="mb-5">
      Gamo Live's database could not be read, so its queues are left out instead of showing zeros.
    </Notice>
  )}
  {inbox && (
    <div class="space-y-6">
      <div class="grid grid-cols-2 gap-3 lg:grid-cols-3 xl:grid-cols-5">
        <StatCard
          label="Participation requests"
          value={inbox.counts.participation}
          icon="mail"
          tone="terracotta"
          href="/participation"
        />
        <StatCard
          label="Church verifications"
          value={inbox.counts.churches}
          icon="church"
          tone="sand"
          href="/churches"
        />
        <StatCard
          label="Provider reviews"
          value={inbox.counts.providers}
          icon="verified"
          tone="tan"
          href="/providers"
        />
        {inbox.liveAvailable && (
          <>
            <StatCard
              label="Events to review"
              value={inbox.counts.events}
              icon="ticket"
              tone="ink"
              href="/events"
            />
            <StatCard
              label="Verification meetings to schedule"
              value={inbox.counts.verifications}
              icon="calendar"
              tone="terracotta"
              href="/organizations?filter=to_schedule"
            />
            <StatCard
              label="Meetings held, to decide"
              value={inbox.counts.meetingsToDecide}
              icon="building"
              tone="tan"
              href="/organizations?filter=to_decide"
            />
            <StatCard
              label="Catalog to approve"
              value={inbox.counts.catalog}
              icon="list"
              tone="sand"
              href="/catalog"
            />
            <StatCard
              label="Refund requests (Gamo sold)"
              value={inbox.counts.refundRequests}
              icon="wallet"
              tone="ink"
              href="/payments?tab=refunds"
            />
            <StatCard
              label="Open disputes"
              value={inbox.counts.disputes}
              icon="alert"
              tone="terracotta"
              href="/payments?tab=disputes"
            />
          </>
        )}
      </div>
      {inbox.liveAvailable && !schedule && (
        <Notice tone="danger" title="Calendar unavailable">
          Gamo Live’s dates could not be read, so no calendar is drawn instead of an empty one.
        </Notice>
      )}
      {schedule && (
        <div class="grid items-start gap-3 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
          <ScheduleCalendar
            view={schedule}
            title="Events, listings and meetings"
            empty="Organizer events, catalog listings and verification meetings appear here once they have dates."
          />
          <div class="space-y-3">
            <StartingSoonCard view={schedule} />
            <ScheduleDay view={schedule} />
          </div>
        </div>
      )}
      <WaitingList items={inbox.oldest} />
    </div>
  )}
</AdminLayout>
