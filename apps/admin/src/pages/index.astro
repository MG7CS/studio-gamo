---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex bg-gray-50">
    <!-- Sidebar -->
    <aside class="w-64 bg-[#1D2323] text-[#F4EDE3] flex flex-col hidden md:flex">
      <div class="p-6 border-b border-gray-800">
        <div class="font-bold text-xl tracking-tight">GAMO STUDIOS</div>
        <div class="text-sm text-gray-400 mt-1">Admin Operations</div>
      </div>
      <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-1">
        <a href="/" class="block px-4 py-2 bg-[#B65B35] rounded-lg text-white font-medium">Dashboard</a>
        <a href="#users" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Users & Roles</a>
        <a href="#worship" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Worship Dispatch</a>
        <a href="#academy" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Academy Classes</a>
        <a href="#live" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Live Events</a>
        <a href="#production" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Production Inquiries</a>
        <a href="/legal" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Legal & Terms</a>
        <a href="#audit" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Audit Logs</a>
      </nav>
      <div class="p-4 border-t border-gray-800">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-gray-600 rounded-full"></div>
          <div>
            <div class="text-sm font-medium">System Admin</div>
            <div class="text-xs text-gray-400">admin@gamostudios.com</div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col">
      <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-6 md:hidden">
         <div class="font-bold text-lg text-[#1D2323]">GAMO Admin</div>
         <button class="text-gray-500 hover:text-gray-800">Menu</button>
      </header>

      <div class="p-6 md:p-10 flex-1 overflow-y-auto">
        <div class="flex justify-between items-center mb-8">
          <h1 class="text-3xl font-bold text-[#1D2323]">Operations Dashboard</h1>
          <button class="bg-white border border-gray-300 text-[#1D2323] px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50 transition-colors shadow-sm">
            Export Report
          </button>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
            <div class="text-gray-500 text-sm font-medium mb-1">Active Worship Gigs</div>
            <div class="text-3xl font-bold text-[#1D2323]">12</div>
            <div class="text-sm text-green-600 mt-2 font-medium">+3 this week</div>
          </div>
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
            <div class="text-gray-500 text-sm font-medium mb-1">Pending Auditions</div>
            <div class="text-3xl font-bold text-[#1D2323]">8</div>
            <div class="text-sm text-gray-500 mt-2 font-medium">Needs review</div>
          </div>
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
            <div class="text-gray-500 text-sm font-medium mb-1">Live Ticket Sales</div>
            <div class="text-3xl font-bold text-[#1D2323]">1,450</div>
            <div class="text-sm text-green-600 mt-2 font-medium">+120 today</div>
          </div>
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
            <div class="text-gray-500 text-sm font-medium mb-1">Production Leads</div>
            <div class="text-3xl font-bold text-[#1D2323]">5</div>
            <div class="text-sm text-gray-500 mt-2 font-medium">Unread inquiries</div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Recent Activity Log -->
          <div class="lg:col-span-2 bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center">
              <h2 class="text-lg font-bold text-[#1D2323]">System Audit Log</h2>
              <a href="#audit" class="text-sm text-[#B65B35] font-medium hover:underline">View All</a>
            </div>
            <div class="divide-y divide-gray-50">
              <div class="p-4 flex gap-4 hover:bg-gray-50 transition-colors">
                <div class="mt-1 w-2 h-2 rounded-full bg-blue-500 flex-shrink-0"></div>
                <div>
                  <div class="text-sm text-[#1D2323]"><span class="font-bold">System</span> dispatched <span class="font-bold">Alex M.</span> as Standby to <span class="font-bold">Grace Church</span>.</div>
                  <div class="text-xs text-gray-500 mt-1">10 minutes ago • Worship</div>
                </div>
              </div>
              <div class="p-4 flex gap-4 hover:bg-gray-50 transition-colors">
                <div class="mt-1 w-2 h-2 rounded-full bg-green-500 flex-shrink-0"></div>
                <div>
                  <div class="text-sm text-[#1D2323]"><span class="font-bold">Admin (Sarah)</span> approved audition for <span class="font-bold">David L.</span> (Drums).</div>
                  <div class="text-xs text-gray-500 mt-1">1 hour ago • Worship</div>
                </div>
              </div>
              <div class="p-4 flex gap-4 hover:bg-gray-50 transition-colors">
                <div class="mt-1 w-2 h-2 rounded-full bg-purple-500 flex-shrink-0"></div>
                <div>
                  <div class="text-sm text-[#1D2323]"><span class="font-bold">New Ticket Batch</span> generated for <span class="font-bold">Worship Nights Vol 2</span>.</div>
                  <div class="text-xs text-gray-500 mt-1">3 hours ago • Live</div>
                </div>
              </div>
              <div class="p-4 flex gap-4 hover:bg-gray-50 transition-colors">
                <div class="mt-1 w-2 h-2 rounded-full bg-orange-500 flex-shrink-0"></div>
                <div>
                  <div class="text-sm text-[#1D2323]"><span class="font-bold">New Lead</span> submitted for <span class="font-bold">Studio Recording</span> by <span class="font-bold">Riverside Youth</span>.</div>
                  <div class="text-xs text-gray-500 mt-1">5 hours ago • Production</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
            <h2 class="text-lg font-bold text-[#1D2323] mb-4">Quick Actions</h2>
            <div class="space-y-3">
              <button class="w-full text-left p-3 rounded-lg border border-gray-200 hover:border-[#B65B35] hover:bg-[#F4EDE3] transition-colors group flex items-center justify-between">
                <span class="text-sm font-medium text-[#1D2323]">Manual Dispatch Override</span>
                <span class="text-gray-400 group-hover:text-[#B65B35]">→</span>
              </button>
              <button class="w-full text-left p-3 rounded-lg border border-gray-200 hover:border-[#B65B35] hover:bg-[#F4EDE3] transition-colors group flex items-center justify-between">
                <span class="text-sm font-medium text-[#1D2323]">Create New User Role</span>
                <span class="text-gray-400 group-hover:text-[#B65B35]">→</span>
              </button>
              <button class="w-full text-left p-3 rounded-lg border border-gray-200 hover:border-[#B65B35] hover:bg-[#F4EDE3] transition-colors group flex items-center justify-between">
                <span class="text-sm font-medium text-[#1D2323]">Refund Ticket Order</span>
                <span class="text-gray-400 group-hover:text-[#B65B35]">→</span>
              </button>
              <button class="w-full text-left p-3 rounded-lg border border-gray-200 hover:border-[#B65B35] hover:bg-[#F4EDE3] transition-colors group flex items-center justify-between">
                <span class="text-sm font-medium text-[#1D2323]">Manage Legal Docs</span>
                <span class="text-gray-400 group-hover:text-[#B65B35]">→</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
