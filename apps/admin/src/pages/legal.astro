---
import '../app.css';
import DashboardShell from '@studio-gamo/ui/components/dashboard/DashboardShell.astro';
import DashPageHeader from '@studio-gamo/ui/components/dashboard/DashPageHeader.astro';
import Panel from '@studio-gamo/ui/components/dashboard/Panel.astro';
import InlineNotice from '@studio-gamo/ui/components/dashboard/InlineNotice.astro';
import { adminWorkspace } from '../data/workspace';
---

<DashboardShell workspace={adminWorkspace} current="nonprofit/governance" title="Legal documents (drafts)">
  <DashPageHeader
    workspace={adminWorkspace}
    title="Legal Document Management"
    description="Sample document inventory. All policies and agreements are drafts pending counsel review; nothing here has been published or adopted."
    path="/legal"
  />

  <div class="space-y-6">
    <InlineNotice
      tone="warning"
      title="Drafts pending counsel review"
      body="The documents below represent governance drafts for the proposed nonprofit transition. None are finalized or legally operative."
    />

    <Panel title="Draft policy & agreement register">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-[14px]">
          <caption class="sr-only">Draft legal documents</caption>
          <thead>
            <tr class="border-b border-sand text-[12px] font-semibold uppercase tracking-[0.06em] text-ink-soft">
              <th scope="col" class="py-3 px-4">Document Name</th>
              <th scope="col" class="py-3 px-4">Status</th>
              <th scope="col" class="py-3 px-4">Last Updated</th>
              <th scope="col" class="py-3 px-4">Program Area</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-sand/60">
            <tr class="hover:bg-ivory">
              <th scope="row" class="py-3 px-4 font-semibold">Musician Contractor Agreement</th>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-900 ring-1 ring-amber-200">Draft — pending review</span></td>
              <td class="py-3 px-4 text-ink-soft">Oct 10, 2026</td>
              <td class="py-3 px-4">Gamo Worship</td>
            </tr>
            <tr class="hover:bg-ivory">
              <th scope="row" class="py-3 px-4 font-semibold">Church Service Agreement</th>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-900 ring-1 ring-amber-200">Draft</span></td>
              <td class="py-3 px-4 text-ink-soft">Oct 11, 2026</td>
              <td class="py-3 px-4">Church Partnerships</td>
            </tr>
            <tr class="hover:bg-ivory">
              <th scope="row" class="py-3 px-4 font-semibold">Event Ticket Terms of Sale</th>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-900 ring-1 ring-amber-200">Draft — pending review</span></td>
              <td class="py-3 px-4 text-ink-soft">Sep 28, 2026</td>
              <td class="py-3 px-4">Gamo Live</td>
            </tr>
            <tr class="hover:bg-ivory">
              <th scope="row" class="py-3 px-4 font-semibold">Academy Waiver of Liability</th>
              <td class="py-3 px-4"><span class="inline-flex rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-900 ring-1 ring-amber-200">Draft — pending review</span></td>
              <td class="py-3 px-4 text-ink-soft">Sep 15, 2026</td>
              <td class="py-3 px-4">Gamo Academy</td>
            </tr>
          </tbody>
        </table>
      </div>
    </Panel>
  </div>
</DashboardShell>
