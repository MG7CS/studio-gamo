---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="min-h-screen flex bg-gray-50">
    <!-- Sidebar -->
    <aside class="w-64 bg-[#1D2323] text-[#F4EDE3] flex flex-col hidden md:flex">
      <div class="p-6 border-b border-gray-800">
        <div class="font-bold text-xl tracking-tight">GAMO STUDIOS</div>
        <div class="text-sm text-gray-400 mt-1">Admin Operations</div>
      </div>
      <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-1">
        <a href="/" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Dashboard</a>
        <a href="#users" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Users & Roles</a>
        <a href="#worship" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Worship Dispatch</a>
        <a href="#academy" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Academy Classes</a>
        <a href="#live" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Live Events</a>
        <a href="#production" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Production Inquiries</a>
        <a href="/legal" class="block px-4 py-2 bg-[#B65B35] rounded-lg text-white font-medium">Legal & Terms</a>
        <a href="#audit" class="block px-4 py-2 hover:bg-gray-800 rounded-lg text-gray-300 font-medium transition-colors">Audit Logs</a>
      </nav>
    </aside>

    <main class="flex-1 flex flex-col">
      <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-6 md:hidden">
         <div class="font-bold text-lg text-[#1D2323]">GAMO Admin</div>
      </header>

      <div class="p-6 md:p-10 flex-1 overflow-y-auto">
        <div class="flex justify-between items-center mb-8">
          <h1 class="text-3xl font-bold text-[#1D2323]">Legal Document Management</h1>
          <button class="bg-[#1D2323] text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-black transition-colors shadow-sm">
            Create New Document
          </button>
        </div>

        <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
          <table class="w-full text-left">
            <thead class="bg-gray-50 border-b border-gray-100 text-sm text-gray-500 font-medium">
              <tr>
                <th class="py-4 px-6">Document Name</th>
                <th class="py-4 px-6">Status</th>
                <th class="py-4 px-6">Last Updated</th>
                <th class="py-4 px-6">Required For</th>
                <th class="py-4 px-6 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 text-sm">
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="py-4 px-6 font-medium text-[#1D2323]">Musician Contractor Agreement</td>
                <td class="py-4 px-6"><span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">Published</span></td>
                <td class="py-4 px-6 text-gray-500">Oct 10, 2026</td>
                <td class="py-4 px-6 text-gray-500">Worship Collection</td>
                <td class="py-4 px-6 text-right text-[#B65B35] font-medium cursor-pointer">Edit</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="py-4 px-6 font-medium text-[#1D2323]">Church Service Level Agreement</td>
                <td class="py-4 px-6"><span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-bold">Draft</span></td>
                <td class="py-4 px-6 text-gray-500">Oct 11, 2026</td>
                <td class="py-4 px-6 text-gray-500">Church Registration</td>
                <td class="py-4 px-6 text-right text-[#B65B35] font-medium cursor-pointer">Edit</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="py-4 px-6 font-medium text-[#1D2323]">Event Ticket Terms of Sale</td>
                <td class="py-4 px-6"><span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">Published</span></td>
                <td class="py-4 px-6 text-gray-500">Sep 28, 2026</td>
                <td class="py-4 px-6 text-gray-500">Live Checkout</td>
                <td class="py-4 px-6 text-right text-[#B65B35] font-medium cursor-pointer">Edit</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="py-4 px-6 font-medium text-[#1D2323]">Academy Waiver of Liability</td>
                <td class="py-4 px-6"><span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">Published</span></td>
                <td class="py-4 px-6 text-gray-500">Sep 15, 2026</td>
                <td class="py-4 px-6 text-gray-500">Clinic Registration</td>
                <td class="py-4 px-6 text-right text-[#B65B35] font-medium cursor-pointer">Edit</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</Layout>
