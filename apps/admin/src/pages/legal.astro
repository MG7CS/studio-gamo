---
/**
 * Legal document registry. Read-only: it never writes to the database (terms_documents rows are created when
 * the first acceptance is recorded). A text change needs a new version in packages/domain/src/terms/registry.ts.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import LegalRegistry from '../components/LegalRegistry.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { loadAcceptanceCounts, registrySummary } from '../lib/legal-data';

const env = await getRuntimeEnv(Astro);
const counts = await loadAcceptanceCounts(env.DB);
const summary = registrySummary(counts);
const needsReview = summary.reviewed < summary.documents;
---

<AdminLayout title="Legal" current="legal">
  <PageHeader
    title="Legal"
    description="The terms people accept across Gamo Studios: versions, review status and how many acceptances are recorded."
  />
  {needsReview && (
    <Notice tone="warning" title="Not finalized" class="mb-5">
      Documents that require legal review are drafts shown on gamostudio.org/legal as “not yet in effect”.
      None is a finalized legal agreement until qualified counsel has reviewed it and the owner has approved
      it.
    </Notice>
  )}
  {counts === null && (
    <Notice tone="danger" title="Acceptance counts unavailable" class="mb-5">
      The database could not be read, so counts are not shown.
    </Notice>
  )}
  <LegalRegistry summary={summary} />
</AdminLayout>
