---
/**
 * Admin legal & governance document registry (/legal).
 * Tracks versioned legal drafts, counsel review gates, and publication locks.
 */
import '../app.css';
import DashboardShell from '@studio-gamo/ui/components/dashboard/DashboardShell.astro';
import DashPageHeader from '@studio-gamo/ui/components/dashboard/DashPageHeader.astro';
import DashBlocks from '@studio-gamo/ui/components/dashboard/DashBlocks.astro';
import { b, type DashBlock } from '@studio-gamo/ui/lib/dashboard';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import { adminWorkspace } from '../data/workspace';

const blocks: DashBlock[] = [
  {
    type: 'notice',
    tone: 'warning',
    title: 'Drafts pending legal counsel approval — Do not publish as finalized',
    body: 'Every legal and governance document below is a working draft prepared for review by qualified legal counsel and the founder/board. None of these documents constitute finalized legal agreements until formally adopted.',
  },
  {
    type: 'stats',
    span: 3,
    items: [
      {
        label: 'Tracked legal documents',
        value: '8',
        delta: 'v0.1 – v0.3 drafts',
        deltaTone: 'neutral',
        icon: 'file',
      },
      {
        label: 'Mandatory child-safety gate',
        value: 'Enforced',
        delta: 'Required before Academy launch',
        deltaTone: 'up',
        icon: 'shield',
      },
      {
        label: 'Public legal disclosure',
        value: 'Draft-labeled',
        delta: 'gamostudio.org/legal',
        deltaTone: 'up',
        icon: 'check',
      },
      {
        label: 'Counsel sign-off gate',
        value: 'Pending owner',
        delta: 'Tracked in checklist',
        deltaTone: 'neutral',
        icon: 'lock',
      },
    ],
  },
  {
    type: 'table',
    span: 3,
    title: 'Legal & governance document control registry',
    filter: true,
    filterKey: 'status',
    filterOptions: ['Counsel review', 'Board review', 'Draft prepared'],
    exportable: true,
    exportFilename: 'gamo-legal-document-registry',
    rowAction: { label: 'Control doc', dialog: 'legal-doc-dialog', icon: 'sliders' },
    columns: [
      { key: 'title', label: 'Document title', primary: true },
      { key: 'scope', label: 'Program / Scope' },
      { key: 'version', label: 'Version' },
      { key: 'gate', label: 'Release gate dependency' },
      { key: 'status', label: 'Review status' },
    ],
    rows: [
      {
        title: 'Terms of Service',
        scope: 'All Gamo Studios sites & workspaces',
        version: 'v0.2-draft',
        gate: 'Public account & workspace launch',
        status: b('Counsel review', 'pending'),
      },
      {
        title: 'Privacy Policy & Minor Data Redaction Standard',
        scope: 'All sites · Strict minor protection',
        version: 'v0.2-draft',
        gate: 'All user & family data collection',
        status: b('Counsel review', 'pending'),
      },
      {
        title: 'Child-Safety & Adult Safeguarding Policy',
        scope: 'Gamo Academy (instructors, hosts & families)',
        version: 'v0.3-draft',
        gate: 'Mandatory before any youth class begins',
        status: b('Board review', 'info'),
      },
      {
        title: 'Musician Placement & Independent Contractor Agreement',
        scope: 'Gamo Worship (100% pass-through stipend terms)',
        version: 'v0.2-draft',
        gate: 'Live church placement disbursements',
        status: b('Counsel review', 'pending'),
      },
      {
        title: 'Church & Ministry Collaboration Agreement',
        scope: 'Gamo Worship, Gamo Academy & Gamo Production',
        version: 'v0.1-draft',
        gate: 'Formal host & church collaboration onboarding',
        status: b('Draft prepared', 'proposal'),
      },
      {
        title: 'Gamo Live Organizer, Ticketing & Refund Policy',
        scope: 'Gamo Live (events, holds, cancellations & refunds)',
        version: 'v0.3-draft',
        gate: 'Paid ticket checkout gate (/api/checkout/session)',
        status: b('Counsel review', 'pending'),
      },
      {
        title: 'Artist Booking & Agent Representation Mandate Terms',
        scope: 'Gamo Live (offers, counteroffers & agent authority)',
        version: 'v0.2-draft',
        gate: 'Artist booking deposit & escrow gate',
        status: b('Counsel review', 'pending'),
      },
      {
        title: 'Governance Charter & Conflict-of-Interest Policy',
        scope: 'Gamo Studios Organization & Board',
        version: 'v0.2-draft',
        gate: 'Final entity incorporation & tax filing',
        status: b('Board review', 'info'),
      },
    ],
  },
  {
    type: 'dialog',
    id: 'legal-doc-dialog',
    title: 'Update legal document review state',
    body: 'Record a version control or legal counsel review update. Documents remain draft-labeled until formal owner and counsel sign-off.',
    fields: [
      { name: 'subject', label: 'Document', type: 'text', value: 'Terms of Service', required: true },
      {
        name: 'reviewState',
        label: 'Updated review status',
        type: 'select',
        options: [
          'Maintain draft lock — awaiting legal counsel sign-off',
          'Advance to founder & board review',
          'Record counsel redline revision note',
        ],
        required: true,
      },
      { name: 'notes', label: 'Counsel / governance notes', type: 'textarea', required: true },
    ],
    confirmLabel: 'Record document update',
    successText: 'Legal document control note recorded in the governance log.',
  },
];
---

<DashboardShell workspace={adminWorkspace} current="legal" title="Legal & governance documents">
  <DashPageHeader
    workspace={adminWorkspace}
    title="Legal & Governance Document Registry"
    description="Versioned legal drafts, safeguarding policies, and counsel review gates across Gamo Studios."
    path="/legal"
    actions={[
      { label: 'Export registry (CSV)', exportReport: 'csv', icon: 'download', variant: 'primary' },
      {
        label: 'View public legal page',
        href: siteUrl('web', '/legal'),
        icon: 'external',
        variant: 'secondary',
      },
    ]}
  />
  <DashBlocks blocks={blocks} idPrefix="admin-legal" />
</DashboardShell>
