---
/**
 * Admin legal document registry (/legal). Reads the terms registry (`TERMS_DOCUMENTS`, the versions people
 * are asked to accept), makes sure every current version has its `terms_documents` row
 * (`syncTermsDocuments`, idempotent) and shows acceptance counts from D1. Without a database the registry
 * still renders and the counts say "Unavailable".
 */
import '../app.css';
import DashboardShell from '@studio-gamo/ui/components/dashboard/DashboardShell.astro';
import DashPageHeader from '@studio-gamo/ui/components/dashboard/DashPageHeader.astro';
import DashBlocks from '@studio-gamo/ui/components/dashboard/DashBlocks.astro';
import { b, type DashBlock } from '@studio-gamo/ui/lib/dashboard';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import { getRuntimeEnv } from '@gamo/domain';
import { TERMS_DOCUMENTS, syncTermsDocuments } from '@gamo/domain/terms';
import { allRows, asSqlDatabase } from '@gamo/domain/security';
import { adminWorkspace } from '../data/workspace';

/** Acceptances per `slug@version`, or null when D1 is not available. */
let counts: Map<string, number> | null = null;
try {
  const env = await getRuntimeEnv(Astro);
  if (env.DB) {
    const db = asSqlDatabase(env.DB);
    await syncTermsDocuments(db, Math.floor(Date.now() / 1000));
    const rows = await allRows<{ slug: string; version: string; total: number }>(db, {
      sql: 'SELECT document_slug AS slug, document_version AS version, COUNT(*) AS total FROM terms_acceptances GROUP BY document_slug, document_version',
      params: [],
    });
    counts = new Map(rows.map((r) => [`${r.slug}@${r.version}`, Number(r.total)]));
  }
} catch (error) {
  console.warn(`[admin-legal] acceptance counts unavailable: ${(error as Error)?.name ?? 'Error'}`);
  counts = null;
}

const countFor = (slug: string, version: string) =>
  counts ? String(counts.get(`${slug}@${version}`) ?? 0) : 'Unavailable';
const totalAcceptances = counts ? [...counts.values()].reduce((sum, n) => sum + n, 0) : null;

const blocks: DashBlock[] = [
  {
    type: 'notice',
    tone: 'warning',
    title: 'DRAFT — requires legal review. Do not publish as finalized.',
    body: 'Every document below is a working draft shown on gamostudio.org/legal with a draft banner and "Not yet in effect". None is a finalized legal agreement until reviewed by qualified counsel and approved by the owner. A text change needs a new version in packages/domain/src/terms/registry.ts.',
  },
  {
    type: 'stats',
    span: 3,
    items: [
      {
        label: 'Documents in the registry',
        value: String(TERMS_DOCUMENTS.length),
        delta: 'All drafts',
        deltaTone: 'neutral',
        icon: 'file',
      },
      {
        label: 'Current version',
        value: TERMS_DOCUMENTS[0]?.version ?? '—',
        delta: 'Re-acceptance on version change',
        deltaTone: 'neutral',
        icon: 'check',
      },
      {
        label: 'Recorded acceptances',
        value: totalAcceptances === null ? 'Unavailable' : String(totalAcceptances),
        delta: totalAcceptances === null ? 'Database not available' : 'All versions',
        deltaTone: 'neutral',
        icon: 'shield',
      },
      {
        label: 'Legal review',
        value: 'Pending',
        delta: 'Owner action',
        deltaTone: 'neutral',
        icon: 'lock',
      },
    ],
  },
  {
    type: 'table',
    span: 3,
    title: 'Terms registry',
    exportable: true,
    exportFilename: 'gamo-terms-registry',
    columns: [
      { key: 'title', label: 'Document', primary: true },
      { key: 'slug', label: 'Slug' },
      { key: 'version', label: 'Version' },
      { key: 'status', label: 'Status' },
      { key: 'accepted', label: 'Acceptances (this version)' },
    ],
    rows: TERMS_DOCUMENTS.map((doc) => ({
      title: doc.title,
      slug: doc.slug,
      version: doc.version,
      status: b('Draft · requires legal review', 'pending'),
      accepted: countFor(doc.slug, doc.version),
    })),
  },
  {
    type: 'list',
    span: 3,
    title: 'Public pages',
    items: TERMS_DOCUMENTS.map((doc) => ({
      title: doc.title,
      meta: siteUrl('web', doc.path),
      body: doc.summary,
      href: siteUrl('web', doc.path),
      icon: 'external',
    })),
  },
];
---

<DashboardShell workspace={adminWorkspace} current="legal" title="Legal documents">
  <DashPageHeader
    workspace={adminWorkspace}
    title="Legal Document Registry"
    description="Draft terms people accept across Gamo Studios: versions, review status and acceptance counts."
    path="/legal"
    actions={[
      { label: 'Export registry (CSV)', exportReport: 'csv', icon: 'download', variant: 'primary' },
      {
        label: 'View public legal page',
        href: siteUrl('web', '/legal'),
        icon: 'external',
        variant: 'secondary',
      },
    ]}
  />
  <DashBlocks blocks={blocks} idPrefix="admin-legal" />
</DashboardShell>
