---
/** Gamo Live organizations: those whose verification waits for the admin first, with search and filters. */
import AdminLayout from '../../layouts/AdminLayout.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import OrganizationList from '../../components/OrganizationList.astro';
import Toolbar from '@studio-gamo/ui/components/ui/Toolbar.astro';
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import VerificationQueueList from '../../components/verification/VerificationQueueList.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { ORGANIZATION_FILTERS, loadOrganizationList, organizationFilterFrom } from '../../lib/live-admin';

const env = await getRuntimeEnv(Astro);
const filter = organizationFilterFrom(Astro.url);
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
const list = await loadOrganizationList(env, filter, q);
---

<AdminLayout title="Organizations" current="organizations">
  <PageHeader
    title="Organizations"
    description="Organizations ask to be verified; you meet them (video call or in person), then verify or decline. Verification is decided only here; payment or partnership never changes it."
  />
  <Toolbar
    variant="clay"
    class="mb-4"
    search={{ label: 'Search by name', value: q, keep: { filter } }}
    groups={[
      {
        label: 'Filter organizations',
        items: ORGANIZATION_FILTERS.map(([key, text]) => ({
          label: text,
          href: `/organizations?filter=${key}${q ? `&q=${encodeURIComponent(q)}` : ''}`,
          active: filter === key,
        })),
      },
    ]}
  />
  {list === null ? (
    <Notice tone="danger" title="Organizations unavailable" class="mb-5">
      Gamo Live’s database could not be read, so nothing is shown instead of guessing.
    </Notice>
  ) : list.kind === 'queue' ? (
    <VerificationQueueList rows={list.rows} />
  ) : (
    <OrganizationList organizations={list.rows} />
  )}
</AdminLayout>
