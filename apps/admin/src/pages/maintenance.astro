---
/** Gamo Live cleanup: the admin-run retention job. Nothing is deleted unless the admin runs it and says so. */
import AdminLayout from '../layouts/AdminLayout.astro';
import ConfirmAction from '@studio-gamo/ui/components/ui/ConfirmAction.astro';
import Panel from '@studio-gamo/ui/components/ui/Panel.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { handleCleanupForm, outcomeFrom } from '../lib/live-admin';

const env = await getRuntimeEnv(Astro);
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const outcome = await handleCleanupForm(Astro.request, env);
  if (outcome.ok) return Astro.redirect(outcome.location, 303);
  error = outcome.message;
  Astro.response.status = outcome.status;
}
const outcome = outcomeFrom(Astro.url);
---

<AdminLayout title="Cleanup" current="maintenance">
  <PageHeader
    title="Cleanup"
    description="Removes what Gamo Live no longer needs. It runs only when you press the button, and it reports what it removed."
  />
  {outcome && (
    <Notice tone="success" class="mb-5">
      {outcome}
    </Notice>
  )}
  {error && (
    <Notice tone="danger" class="mb-5">
      {error}
    </Notice>
  )}
  <Panel variant="clay" title="What it does">
    <ul class="list-disc space-y-1 pl-5 text-sm text-body">
      <li>
        Deletes registrants’ names, emails and check-in codes 90 days after an event’s last date. The totals
        (people registered, people checked in) stay on each date.
      </li>
      <li>Releases seats held by registrations that were never confirmed.</li>
      <li>Deletes expired email codes, sign-in sessions and invitations older than 30 days.</li>
      <li>Clears finished rate-limit counters.</li>
    </ul>
    <div class="mt-6">
      <ConfirmAction summaryLabel="Run cleanup…" confirmLabel="Delete old data now" actionValue="cleanup">
        Registrant data older than 90 days is deleted for good. The totals stay. It cannot be undone.
        <input slot="fields" type="hidden" name="confirm" value="yes" />
      </ConfirmAction>
    </div>
  </Panel>
</AdminLayout>
