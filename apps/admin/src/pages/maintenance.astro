---
/** Gamo Live cleanup: the admin-run retention job. Nothing is deleted unless the admin runs it and says so. */
import AdminLayout from '../layouts/AdminLayout.astro';
import Button from '../components/Button.astro';
import LiveTabs from '../components/LiveTabs.astro';
import Notice from '../components/Notice.astro';
import PageHeader from '../components/PageHeader.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { loadCounts } from '../lib/inbox';
import { handleCleanupForm, outcomeFrom } from '../lib/live-admin';

const env = await getRuntimeEnv(Astro);
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const outcome = await handleCleanupForm(Astro.request, env);
  if (outcome.ok) return Astro.redirect(outcome.location, 303);
  error = outcome.message;
  Astro.response.status = outcome.status;
}
const counts = await loadCounts(env);
const outcome = outcomeFrom(Astro.url);
---

<AdminLayout title="Cleanup" current="maintenance">
  <PageHeader
    title="Cleanup"
    description="Removes what Gamo Live no longer needs. It runs only when you press the button, and it reports what it removed."
  />
  <LiveTabs current="maintenance" counts={counts} />
  {outcome && <Notice tone="success" text={outcome} />}
  {error && <Notice tone="error" text={error} />}
  <section class="rounded-clay-lg bg-surface p-6 shadow-soft">
    <h2 class="text-xl font-extrabold">What it does</h2>
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-body">
      <li>
        Deletes registrants’ names, emails and check-in codes 90 days after an event’s last date. The totals
        (people registered, people checked in) stay on each date.
      </li>
      <li>Releases seats held by registrations that were never confirmed.</li>
      <li>Deletes expired email codes, sign-in sessions and invitations older than 30 days.</li>
      <li>Clears finished rate-limit counters.</li>
    </ul>
    <form method="post" class="mt-6 space-y-4">
      <label class="flex min-h-11 items-start gap-3 text-sm text-ink">
        <input type="checkbox" name="confirm" value="yes" class="mt-0.5 h-5 w-5 shrink-0" />
        <span>I understand that registrant data older than 90 days is deleted for good.</span>
      </label>
      <Button variant="danger">Run cleanup</Button>
    </form>
  </section>
</AdminLayout>
