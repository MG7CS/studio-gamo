---
/** One Gamo Live order across organizations (docs/LIVE_SCREENS.md C7). POST refunds it when Gamo sold it (Mode B). */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Breadcrumbs from '@studio-gamo/ui/components/ui/Breadcrumbs.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import OrderHistoryCard from '../../../components/payments/order/OrderHistoryCard.astro';
import OrderReceiptCard from '../../../components/payments/order/OrderReceiptCard.astro';
import OrderRefundCard from '../../../components/payments/order/OrderRefundCard.astro';
import OrderSummaryCard from '../../../components/payments/order/OrderSummaryCard.astro';
import OrderTicketsCard from '../../../components/payments/order/OrderTicketsCard.astro';
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import PaymentsConfigNotice from '../../../components/payments/PaymentsConfigNotice.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { paymentsConfig } from '../../../lib/live-settings';
import { handleAdminOrderForm, loadAdminOrderPage, paymentsOutcomeFrom } from '../../../lib/payments-admin';

const env = await getRuntimeEnv(Astro);
const id = Astro.params.id ?? '';
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const outcome = await handleAdminOrderForm(Astro.request, env, id);
  if (outcome.ok) return Astro.redirect(outcome.location, 303);
  error = outcome.message;
  Astro.response.status = outcome.status;
}
const view = await loadAdminOrderPage(env, id);
if (view === 'not_found') return new Response(null, { status: 404 });
const config = paymentsConfig(env);
const outcome = paymentsOutcomeFrom(Astro.url);
const title = view ? `Order ${view.order.reference}` : 'Order';
---

<AdminLayout title={title} current="payments">
  <PageHeader
    title={title}
    description="Every line paid, the tickets, and the history. Gamo refunds only orders it sold (Mode B)."
  >
    <Breadcrumbs slot="breadcrumbs" items={[{ label: 'Payments', href: '/payments' }, { label: title }]} />
  </PageHeader>
  <PaymentsConfigNotice config={config} class="mb-5" />
  {outcome && (
    <Notice tone="success" class="mb-5">
      {outcome}
    </Notice>
  )}
  {error && (
    <Notice tone="danger" class="mb-5">
      {error}
    </Notice>
  )}
  {view ? (
    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
      <div class="space-y-6">
        <OrderSummaryCard order={view.order} />
        <OrderTicketsCard detail={view.detail} timeZone={view.order.timezone} />
        <OrderHistoryCard detail={view.detail} />
      </div>
      <div class="space-y-6">
        <OrderReceiptCard receipt={view.receipt} />
        <OrderRefundCard view={view} configured={config.configured} />
      </div>
    </div>
  ) : (
    <Notice tone="danger" title="Order unavailable">
      Gamo Live’s database could not be read, so nothing is shown instead of guessing.
    </Notice>
  )}
</AdminLayout>
