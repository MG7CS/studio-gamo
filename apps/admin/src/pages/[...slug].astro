---
/**
 * Gamo Studios staff workspace route (`apps/admin`).
 * Navigation comes from the typed admin workspace definition; operational data is served by the
 * staff APIs under /api (events review, participation review, staff provisioning).
 */
import '../app.css';
import WorkspaceScreen from '@studio-gamo/ui/components/dashboard/WorkspaceScreen.astro';
import { adminWorkspace } from '../data/workspace';
---

<WorkspaceScreen workspace={adminWorkspace} slug={Astro.params.slug} />
