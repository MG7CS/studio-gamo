---
/** First-event review. GET lists events waiting for review; POST applies a decision or the organizer switch. */
import AdminLayout from '../layouts/AdminLayout.astro';
import EventReviewList from '../components/EventReviewList.astro';
import Notice from '../components/Notice.astro';
import PageHeader from '../components/PageHeader.astro';
import { getRuntimeEnv } from '@gamo/domain';
import { getAdminEmail } from '../lib/gate';
import { handleEventForm, loadPendingEvents, outcomeFrom } from '../lib/event-review';

const env = await getRuntimeEnv(Astro);
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const outcome = await handleEventForm(Astro.request, env, getAdminEmail(Astro.locals) ?? '');
  if (outcome.ok) return Astro.redirect(outcome.location, 303);
  error = outcome.message;
  Astro.response.status = outcome.status;
}
const events = await loadPendingEvents(env.DB);
const outcome = outcomeFrom(Astro.url);
---

<AdminLayout title="First-event review" current="events">
  <PageHeader
    title="First-event review"
    description="Every organizer's first event is reviewed before it is published. Later events publish directly unless “review every event” is on for that organizer."
  />
  {outcome && <Notice tone="success" text={outcome} />}
  {error && <Notice tone="error" text={error} />}
  <EventReviewList events={events} />
</AdminLayout>
