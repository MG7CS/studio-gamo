---
/** Gamo Live event review. GET lists events waiting for review; POST applies a decision. */
import AdminLayout from '../layouts/AdminLayout.astro';
import LiveEventReviewList from '../components/LiveEventReviewList.astro';
import LivePublishedEventList from '../components/LivePublishedEventList.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import Toolbar from '@studio-gamo/ui/components/ui/Toolbar.astro';
import { getRuntimeEnv, listPendingEvents, listPublishedOrganizerEvents } from '@gamo/domain';
import { asSqlDatabase } from '@gamo/domain/security';
import { handleEventForm, loadPaidReviewDetails, outcomeFrom } from '../lib/live-admin';

const env = await getRuntimeEnv(Astro);
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const outcome = await handleEventForm(Astro.request, env);
  if (outcome.ok) return Astro.redirect(outcome.location, 303);
  error = outcome.message;
  Astro.response.status = outcome.status;
}
let events = null as Awaited<ReturnType<typeof listPendingEvents>> | null;
let published = null as Awaited<ReturnType<typeof listPublishedOrganizerEvents>> | null;
let paid = new Map() as Awaited<ReturnType<typeof loadPaidReviewDetails>>;
try {
  const db = asSqlDatabase(env.LIVE_DB);
  events = await listPendingEvents(db);
  published = await listPublishedOrganizerEvents(db);
  paid = await loadPaidReviewDetails(db, events);
} catch (e) {
  console.error(`[admin] live events unavailable: ${e instanceof Error ? e.name : 'unknown'}`);
}
const outcome = outcomeFrom(Astro.url);
const view = Astro.url.searchParams.get('view') === 'published' ? 'published' : 'waiting';
---

<AdminLayout title="Event review" current="events">
  <PageHeader
    title="Event review"
    description="Every organization’s first event, and its first paid event, is reviewed before it is published. A paid event is approved only for a verified organization. Later events publish directly unless “review every event” is on for that organization. Events that send people to another site for tickets are always reviewed."
  />
  {outcome && (
    <Notice tone="success" class="mb-5">
      {outcome}
    </Notice>
  )}
  {error && (
    <Notice tone="danger" class="mb-5">
      {error}
    </Notice>
  )}
  {events ? (
    <>
      <Toolbar
        variant="clay"
        class="mb-5"
        groups={[
          {
            label: 'Show',
            items: [
              {
                label: 'Waiting for review',
                href: '/events',
                active: view === 'waiting',
                count: events.length > 0 ? events.length : undefined,
              },
              {
                label: 'Published and hidden',
                href: '/events?view=published',
                active: view === 'published',
                count: published && published.length > 0 ? published.length : undefined,
              },
            ],
          },
        ]}
      />
      {view === 'waiting' ? (
        <LiveEventReviewList events={events} paid={paid} />
      ) : (
        published && <LivePublishedEventList events={published} />
      )}
    </>
  ) : (
    <Notice tone="danger" title="Events unavailable" class="mb-5">
      Gamo Live’s database could not be read, so nothing is shown instead of guessing.
    </Notice>
  )}
</AdminLayout>
