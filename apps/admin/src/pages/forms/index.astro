---
/**
 * Forms list (staff). One row per form with its status, counts and actions. Closing and reopening a form are
 * browser form posts to this page (post-redirect-get); a refusal re-renders here with its message.
 */
import AdminLayout from '../../components/AdminLayout.astro';
import FormsTable from '../../components/forms-builder/FormsTable.astro';
import OutcomeNotice from '../../components/forms-builder/OutcomeNotice.astro';
import { BTN_PRIMARY, HELP } from '../../components/forms-builder/ui';
import { FormsService, missingDefaultSeeds, seedDefaultForms } from '@gamo/domain/forms';
import { adminPage, type AdminContext } from '../../lib/admin-page';
import { noticeFrom } from '../../lib/flash';
import { handleBuilderPost } from '../../lib/forms-builder/page';
import HiddenFields from '../../components/forms-builder/HiddenFields.astro';
import { FORM_NOTICES } from '../../lib/forms-builder/notices';

export const prerender = false;

let admin: AdminContext;
try {
  admin = await adminPage(Astro);
} catch (error) {
  if (error instanceof Response) return error;
  throw error;
}

const posted = await handleBuilderPost(admin, Astro.request, null, [
  'form.close',
  'form.reopen',
  'forms.seed_defaults',
]);
if (posted?.response) return posted.response;
if (posted?.failed) Astro.response.status = posted.failed.status;

let forms = await new FormsService(admin.db).listForms();
if (forms.length === 0 && Astro.request.method === 'GET') {
  // First visit: publish the default forms (Worship and Production apply and request, contact, partner
  // interest) once, so the public pages exist. Staff edit them here; a second visitor racing this is harmless.
  try {
    await seedDefaultForms(admin.db, Math.floor(Date.now() / 1000));
  } catch {
    console.warn('[admin.forms] seeding the default forms did not finish');
  }
  forms = await new FormsService(admin.db).listForms();
}
const missingDefaults = missingDefaultSeeds(forms.map((f) => f.slug));
const notice = noticeFrom(Astro.url, FORM_NOTICES);
---

<AdminLayout
  title="Forms"
  current="forms"
  notice={notice}
  description="Edit the questions people answer on the public forms. Changes go public only when you publish."
>
  <a slot="actions" href="/forms/new" class={BTN_PRIMARY}>
    New form
  </a>
  {posted?.failed && <OutcomeNotice failed={posted.failed} />}
  {missingDefaults.length > 0 && forms.length > 0 && (
    <form method="post" action="/forms" class="mb-4 flex flex-wrap items-center gap-3">
      <HiddenFields action="forms.seed_defaults" op={false} />
      <p class={`${HELP} max-w-prose`}>
        These default forms can be added and published: {missingDefaults.map((s) => s.title).join(', ')}.
      </p>
      <button type="submit" class={BTN_PRIMARY}>
        Add the new default forms
      </button>
    </form>
  )}
  {forms.length === 0 ? (
    <p class={HELP}>There are no forms yet. Create the first one with New form.</p>
  ) : (
    <FormsTable forms={forms} />
  )}
</AdminLayout>
