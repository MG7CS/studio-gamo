---
/** First-event review (design §4.4) over AdminService.getPendingReviewEvents / reviewEvent. */
import '../../app.css';
import DashboardShell from '@studio-gamo/ui/components/dashboard/DashboardShell.astro';
import DashPageHeader from '@studio-gamo/ui/components/dashboard/DashPageHeader.astro';
import { adminWorkspace } from '../../data/workspace';
import EventReviewList from '../../components/review/EventReviewList.astro';
import StaffSignInNotice from '../../components/review/StaffSignInNotice.astro';
import ReviewOutcome from '../../components/review/ReviewOutcome.astro';
import { loadPendingEvents, outcomeFrom, staffContext } from '../../lib/review-pages';

const staff = await staffContext(Astro);
const events = staff ? await loadPendingEvents(staff.env) : null;
if (!staff) Astro.response.status = 401;
---

<DashboardShell workspace={adminWorkspace} current="review/events" title="First-event review">
  <DashPageHeader
    workspace={adminWorkspace}
    title="First-event review"
    description="Every organizer's first event is reviewed by staff; later events publish directly unless “review every event” is on."
    path="/review/events"
  />
  <ReviewOutcome outcome={outcomeFrom(Astro.url)} />
  {events ? <EventReviewList events={events} /> : <StaffSignInNotice />}
</DashboardShell>
