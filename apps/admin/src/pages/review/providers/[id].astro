---
/** One provider or church profile: details, history and the staff decision forms. */
import '../../../app.css';
import DashboardShell from '@studio-gamo/ui/components/dashboard/DashboardShell.astro';
import DashPageHeader from '@studio-gamo/ui/components/dashboard/DashPageHeader.astro';
import { adminWorkspace } from '../../../data/workspace';
import ProviderReviewDetail from '../../../components/review/ProviderReviewDetail.astro';
import StaffSignInNotice from '../../../components/review/StaffSignInNotice.astro';
import ReviewOutcome from '../../../components/review/ReviewOutcome.astro';
import { loadProviderDetail, outcomeFrom, staffContext } from '../../../lib/review-pages';

const staff = await staffContext(Astro);
const view = staff ? await loadProviderDetail(staff.env, String(Astro.params.id ?? '')) : null;
if (!staff) Astro.response.status = 401;
else if (!view) Astro.response.status = 404;
const isChurch = view?.profile.role === 'church';
const back = isChurch ? '/review/churches' : '/review/providers';
const staffName = staff ? staff.auth.user.displayName?.trim() || staff.auth.user.email : '';
---

<DashboardShell
  workspace={adminWorkspace}
  current={isChurch ? 'review/churches' : 'review/providers'}
  title="Review profile"
>
  <DashPageHeader
    workspace={adminWorkspace}
    title={view ? `Review: ${view.profile.displayName}` : 'Review profile'}
    description={isChurch ? 'In-person church verification.' : 'Provider review.'}
    path={back}
  />
  <ReviewOutcome outcome={outcomeFrom(Astro.url)} />
  {!staff && <StaffSignInNotice />}
  {staff && !view && (
    <p class="rounded-2xl border border-sand bg-white p-6 text-sm">
      That profile does not exist.{' '}
      <a href={back} class="font-semibold underline">
        Back to the queue
      </a>
    </p>
  )}
  {staff && view && (
    <ProviderReviewDetail
      view={view}
      staffName={staffName}
      errorField={Astro.url.searchParams.get('field')}
    />
  )}
  <a href={back} class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-charcoal underline">
    Back to the queue
  </a>
</DashboardShell>
