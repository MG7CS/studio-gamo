---
import '../app.css';
import DashboardShell from '@studio-gamo/ui/components/dashboard/DashboardShell.astro';
import DashPageHeader from '@studio-gamo/ui/components/dashboard/DashPageHeader.astro';
import Panel from '@studio-gamo/ui/components/dashboard/Panel.astro';
import InlineNotice from '@studio-gamo/ui/components/dashboard/InlineNotice.astro';
import { getDb } from '@gamo/db';
import { getRuntimeEnv } from '@gamo/domain';
import { adminWorkspace } from '../data/workspace';
import { getAdminCredentialStatus } from '../lib/admin-password-auth';

export const prerender = false;

const url = new URL(Astro.request.url);
const welcome = url.searchParams.get('welcome') === '1';
const updated = url.searchParams.get('updated') === '1';
const errorMsg = url.searchParams.get('error');

const locals = Astro.locals;
const adminSession = locals?.adminAuthSession;
const staffEmail = locals?.staffEmail || adminSession?.user?.email || 'unknown staff account';

let mustChangePassword = welcome;
let lastUpdatedLabel = 'Temporary password active';

try {
  const runtimeEnv = await getRuntimeEnv(Astro);
  if (runtimeEnv?.DB && adminSession?.user?.id) {
    const db = getDb(runtimeEnv.DB);
    const credStatus = await getAdminCredentialStatus(db, adminSession.user.id);
    if (credStatus) {
      mustChangePassword = credStatus.mustChangePassword;
      if (!credStatus.mustChangePassword && credStatus.updatedAt) {
        lastUpdatedLabel = `Updated ${credStatus.updatedAt.toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        })}`;
      }
    }
  }
} catch {
  // Ignore lookup fallback in static/demo mode
}
---

<DashboardShell workspace={adminWorkspace} current="security" title="Password & security">
  <DashPageHeader
    workspace={adminWorkspace}
    title="Password & Security"
    description="Manage your Gamo Studios Operations Gateway administrator password and active session."
    path="/security"
  />

  <div class="space-y-6 max-w-2xl">
    {updated && (
      <InlineNotice
        tone="success"
        title="Administrator password updated"
        body="Your new password is now active for signing in to admin.gamostudio.org."
      />
    )}

    {errorMsg && <InlineNotice tone="error" title="Unable to update password" body={errorMsg} />}

    {mustChangePassword && !updated && (
      <InlineNotice
        tone="warning"
        title="Temporary password active — please set a new password"
        body="You signed in with a temporary password. Enter your current temporary password and choose a new password below."
      />
    )}

    <Panel
      title="Change administrator password"
      description={`Signed in as ${staffEmail} · ${lastUpdatedLabel}`}
    >
      <form method="POST" action="/__admin_auth/password" class="space-y-4">
        <div>
          <label
            for="sec-email"
            class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.04em] text-ink-soft"
          >
            Administrator Email
          </label>
          <input
            id="sec-email"
            type="email"
            value={staffEmail}
            readonly
            class="h-11 w-full rounded-xl border border-ink/50 bg-cream/60 px-3.5 text-[14px] font-medium text-charcoal/80"
          />
        </div>

        <div>
          <label
            for="sec-current-password"
            class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.04em] text-charcoal"
          >
            Current Password
          </label>
          <input
            id="sec-current-password"
            name="currentPassword"
            type="password"
            required
            autocomplete="current-password"
            placeholder={mustChangePassword ? 'Enter your temporary password' : 'Enter your current password'}
            class="h-11 w-full rounded-xl border border-ink/50 bg-white px-3.5 text-[14px] text-charcoal focus:border-terracotta focus:outline-none"
          />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label
              for="sec-new-password"
              class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.04em] text-charcoal"
            >
              New Password
            </label>
            <input
              id="sec-new-password"
              name="newPassword"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              class="h-11 w-full rounded-xl border border-ink/50 bg-white px-3.5 text-[14px] text-charcoal focus:border-terracotta focus:outline-none"
            />
          </div>

          <div>
            <label
              for="sec-confirm-password"
              class="mb-1.5 block text-[12px] font-semibold uppercase tracking-[0.04em] text-charcoal"
            >
              Confirm New Password
            </label>
            <input
              id="sec-confirm-password"
              name="confirmPassword"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="Repeat new password"
              class="h-11 w-full rounded-xl border border-ink/50 bg-white px-3.5 text-[14px] text-charcoal focus:border-terracotta focus:outline-none"
            />
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <button
            type="submit"
            class="inline-flex h-11 items-center justify-center rounded-full bg-terracotta px-6 text-[13px] font-semibold text-white transition hover:bg-terracotta-dark"
          >
            Update admin password
          </button>

          <a
            href="/__admin_auth/logout"
            class="inline-flex h-11 items-center justify-center rounded-full border border-sand bg-white px-5 text-[13px] font-semibold text-charcoal transition hover:bg-cream"
          >
            Sign out of Operations Gateway
          </a>
        </div>
      </form>
    </Panel>
  </div>
</DashboardShell>
