---
/**
 * Password & security (/security): the staff member's gateway password. The form posts to the middleware
 * (/__admin_auth/password), which answers with a redirect back here (`?updated=1` or `?error=<message>`).
 */
import AdminLayout from '../components/AdminLayout.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import InlineNotice from '@studio-gamo/ui/components/dashboard/InlineNotice.astro';
import Panel from '@studio-gamo/ui/components/dashboard/Panel.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';
import { getDb } from '@gamo/db';
import { adminPage, type AdminContext } from '../lib/admin-page';
import { getAdminCredentialStatus } from '../lib/admin-password-auth';
import type { Notice } from '../lib/flash';

export const prerender = false;

let admin: AdminContext;
try {
  admin = await adminPage(Astro);
} catch (error) {
  if (error instanceof Response) return error;
  throw error;
}

/** The refusals the password change can redirect with; any other `?error=` text is never shown. */
const KNOWN_ERRORS = new Set([
  'New password and confirmation do not match.',
  'Please enter your current password.',
  'New password must be at least 8 characters long.',
  'New password must be 128 characters or fewer.',
  'Admin password credential record not found.',
  'Your current password is incorrect.',
]);

const url = new URL(Astro.request.url);
const updated = url.searchParams.get('updated') === '1';
const errorParam = url.searchParams.get('error');
const notice: Notice | null = updated
  ? {
      kind: 'ok',
      text: 'Administrator password updated. Your new password is now active for signing in to admin.gamostudio.org.',
    }
  : errorParam
    ? {
        kind: 'error',
        text: KNOWN_ERRORS.has(errorParam) ? errorParam : 'The password could not be updated.',
      }
    : null;

const staffEmail = Astro.locals.staffEmail || admin.staff.email;
let mustChangePassword = url.searchParams.get('welcome') === '1';
let lastUpdatedLabel = 'Temporary password active';
try {
  const credStatus = await getAdminCredentialStatus(getDb(admin.env.DB), admin.auth.user.id);
  if (credStatus) {
    mustChangePassword = credStatus.mustChangePassword;
    if (!credStatus.mustChangePassword && credStatus.updatedAt) {
      lastUpdatedLabel = `Updated ${credStatus.updatedAt.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      })}`;
    }
  }
} catch {
  // The status line is informational; the form works without it.
}
---

<AdminLayout
  title="Password & Security"
  current="security"
  notice={notice}
  description="Manage your Gamo Studios Operations Gateway administrator password and active session."
>
  <div class="max-w-narrow space-y-6">
    {mustChangePassword && !updated && (
      <InlineNotice
        tone="warning"
        title="Temporary password active — please set a new password"
        body="You signed in with a temporary password. Enter your current temporary password and choose a new password below."
      />
    )}

    <Panel
      title="Change administrator password"
      description={`Signed in as ${staffEmail} · ${lastUpdatedLabel}`}
    >
      <form method="POST" action="/__admin_auth/password" class="space-y-4">
        <TextField
          id="sec-email"
          name="email"
          type="email"
          label="Administrator Email"
          value={staffEmail}
          readonly
        />
        <TextField
          id="sec-current-password"
          name="currentPassword"
          type="password"
          label="Current Password"
          required
          autocomplete="current-password"
          placeholder={mustChangePassword ? 'Enter your temporary password' : 'Enter your current password'}
        />
        <div class="grid gap-4 sm:grid-cols-2">
          <TextField
            id="sec-new-password"
            name="newPassword"
            type="password"
            label="New Password"
            required
            minlength={8}
            autocomplete="new-password"
            hint="At least 8 characters."
          />
          <TextField
            id="sec-confirm-password"
            name="confirmPassword"
            type="password"
            label="Confirm New Password"
            required
            minlength={8}
            autocomplete="new-password"
          />
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <SubmitButton label="Update admin password" pendingLabel="Updating…" />
          <ButtonLink href="/__admin_auth/logout" variant="secondary">
            Sign out of Operations Gateway
          </ButtonLink>
        </div>
      </form>
    </Panel>
  </div>
</AdminLayout>
