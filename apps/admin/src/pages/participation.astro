---
/** Participation requests. GET lists inquiries; POST saves the admin's reply. */
import AdminLayout from '../layouts/AdminLayout.astro';
import EmptyState from '@studio-gamo/ui/components/ui/EmptyState.astro';
import InquiryCard from '../components/InquiryCard.astro';
import Notice from '@studio-gamo/ui/components/ui/Notice.astro';
import Toolbar from '@studio-gamo/ui/components/ui/Toolbar.astro';
import PageHeader from '@studio-gamo/ui/components/ui/PageHeader.astro';
import { getRuntimeEnv } from '@gamo/domain';
import {
  INQUIRY_FILTERS,
  INQUIRY_FILTER_LABELS,
  INQUIRY_LIMIT,
  handleReply,
  inquiryFilterFrom,
  loadInquiries,
  outcomeFrom,
} from '../lib/participation';

const env = await getRuntimeEnv(Astro);
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const outcome = await handleReply(Astro.request, env);
  if (outcome.ok) return Astro.redirect(outcome.location, 303);
  error = outcome.message;
  Astro.response.status = outcome.status;
}
const filter = inquiryFilterFrom(Astro.url);
const { items, truncated } = await loadInquiries(env.DB, filter);
const outcome = outcomeFrom(Astro.url);
---

<AdminLayout title="Participation requests" current="participation">
  <PageHeader
    title="Participation requests"
    description="What people sent through the public sites. Your reply is visible to the person who sent it. Replying does not grant program access, approve a partnership or send a notification."
  />
  {outcome && (
    <Notice tone="success" class="mb-5">
      {outcome}
    </Notice>
  )}
  {error && (
    <Notice tone="danger" class="mb-5">
      {error}
    </Notice>
  )}
  <Toolbar
    variant="clay"
    class="mb-5"
    groups={[
      {
        label: 'Filter by status',
        items: INQUIRY_FILTERS.map((f) => ({
          label: INQUIRY_FILTER_LABELS[f],
          href: `/participation?status=${f}`,
          active: f === filter,
        })),
      },
    ]}
  />
  {items.length === 0 ? (
    <EmptyState
      title={
        filter === 'pending'
          ? 'No participation requests are waiting for you.'
          : 'No participation requests in this state.'
      }
    />
  ) : (
    <ul class="space-y-5">
      {items.map((inquiry) => (
        <InquiryCard inquiry={inquiry} />
      ))}
    </ul>
  )}
  {truncated && (
    <p class="mt-4 text-sm text-muted">Showing {INQUIRY_LIMIT}. Older requests are not listed.</p>
  )}
</AdminLayout>
