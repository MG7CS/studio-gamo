---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-4xl mx-auto py-12 px-4 grid md:grid-cols-2 gap-12">
    <div>
      <div class="text-sm text-[#6B6B67] mb-2 font-semibold tracking-wide uppercase">Step 3 of 3</div>
      <h1 class="text-3xl font-bold mb-8 text-[#1D2323]">Checkout</h1>
      
      <div class="bg-[#F4EDE3] border border-[#DED6CC] p-6 rounded-xl mb-8">
        <h3 class="font-bold text-lg mb-4">Demo Payment Environment</h3>
        <p class="text-sm text-[#6B6B67] mb-4">
          This is a simulated checkout using Stripe Test Mode. No real charges will be made.
        </p>
        <form method="POST" action="/hire/success">
          <button type="submit" class="w-full bg-[#B65B35] text-white px-8 py-3 rounded-lg font-bold hover:bg-[#8F432A] transition-colors">
            Simulate Payment & Book
          </button>
        </form>
      </div>
    </div>

    <div>
      <div class="border border-[#DED6CC] rounded-xl p-6 bg-white sticky top-6">
        <h2 class="text-xl font-bold mb-6">Booking Summary</h2>
        <div class="space-y-4 mb-6">
          <div class="flex justify-between">
            <span class="text-[#6B6B67]">Plan</span>
            <span class="font-medium">Spot Fill</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#6B6B67]">Instrument</span>
            <span class="font-medium">Acoustic Guitar</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#6B6B67]">Coverage</span>
            <span class="font-medium">Primary + Standby</span>
          </div>
        </div>
        <div class="border-t border-[#DED6CC] pt-4 flex justify-between items-center">
          <span class="font-bold text-[#1D2323]">Total</span>
          <span class="text-2xl font-bold text-[#1D2323]">$350.00</span>
        </div>
      </div>
    </div>
  </main>
</Layout>
