---
import Layout from '../../layouts/Layout.astro';
import FlowShell from '../../components/flow/FlowShell.astro';
import ProposalBreakdown from '../../components/flow/ProposalBreakdown.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { hireSteps } from '../../data/worship';
const details = [
  ['Church', 'Riverside Fellowship'], ['Roles', 'Keys & piano, Bass'], ['Style', 'Contemporary worship'],
  ['First service', 'Sun · Nov 1 · 8:00 AM call'], ['Repeats', 'Every week'], ['Standby', 'Requested, where available'], ['Set list', '4 songs · keys provided'],
];
---
<Layout title="Request summary | Gamo Worship">
  <FlowShell eyebrow="For churches · Summary" title="Request" accent="summary." lede="A Gamo Worship coordinator will review your service request and propose vetted musicians before any engagement is confirmed." steps={hireSteps} current={3} wide>
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="rounded-[2rem] border border-sand bg-white p-6 sm:p-8 lg:col-span-7">
        <div class="flex items-center justify-between"><h2 class="text-lg font-semibold">Service details</h2><StatusPill kind="verified">Ready for review</StatusPill></div>
        <dl class="mt-6 divide-y divide-sand">
          {details.map(([k, v]) => <div class="flex flex-col gap-1 py-3 sm:flex-row sm:justify-between"><dt class="text-sm text-ink-soft">{k}</dt><dd class="font-medium sm:text-right">{v}</dd></div>)}
        </dl>
      </div>
      <ProposalBreakdown class="lg:col-span-5" />
    </div>
    <div class="mt-10 flex flex-wrap gap-3">
      <ButtonLink href="/church/roster" arrow>View service roster</ButtonLink>
      <ButtonLink href="/hire/schedule" variant="secondary">Edit schedule</ButtonLink>
    </div>
  </FlowShell>
</Layout>
