---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-2xl mx-auto py-12 px-4">
    <div class="text-sm text-[#6B6B67] mb-2 font-semibold tracking-wide uppercase">Step 2 of 3</div>
    <h1 class="text-3xl font-bold mb-8 text-[#1D2323]">Repertoire & Charts</h1>
    
    <div class="bg-yellow-50 border border-yellow-200 p-4 rounded-lg mb-8">
      <p class="text-sm font-medium text-yellow-800">Security Notice</p>
      <p class="text-sm text-yellow-700">Please provide links to unlisted resources (e.g., Planning Center Services, unlisted Google Drive folders). Do not upload copyrighted PDFs directly unless explicitly authorized.</p>
    </div>

    <form method="POST" action="/api/hire/repertoire" class="space-y-6">
      <div>
        <label class="block text-sm font-medium mb-2 text-[#1D2323]">Planning Center Services URL (Optional)</label>
        <input type="url" name="pcoUrl" placeholder="https://services.planningcenteronline.com/..." class="w-full border border-[#DED6CC] p-3 rounded-lg focus:ring-2 focus:ring-[#B65B35] outline-none" />
      </div>

      <div>
        <label class="block text-sm font-medium mb-2 text-[#1D2323]">Setlist / Notes</label>
        <textarea name="notes" rows="4" placeholder="List the songs for this service, preferred keys, or any specific instructions for the musician..." class="w-full border border-[#DED6CC] p-3 rounded-lg focus:ring-2 focus:ring-[#B65B35] outline-none"></textarea>
      </div>

      <div class="pt-6 flex justify-between">
        <a href="/hire/gig-details" class="px-6 py-3 text-[#6B6B67] font-medium hover:text-[#1D2323]">Back</a>
        <a href="/hire/checkout" class="bg-[#1D2323] text-[#F4EDE3] px-8 py-3 rounded-lg font-medium hover:bg-black transition-colors">Continue to Checkout</a>
      </div>
    </form>
  </main>
</Layout>
