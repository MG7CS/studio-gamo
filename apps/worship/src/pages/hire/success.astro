---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-2xl mx-auto py-24 px-4 text-center">
    <div class="w-16 h-16 bg-[#26865B] text-white rounded-full flex items-center justify-center mx-auto mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="text-4xl font-bold mb-4 text-[#1D2323]">Booking Confirmed</h1>
    <p class="text-xl text-[#6B6B67] mb-8">
      Your request has been received. Our team is reviewing the details and will assign a primary musician and a standby understudy shortly.
    </p>
    <a href="/" class="bg-[#1D2323] text-[#F4EDE3] px-8 py-3 rounded-lg font-medium hover:bg-black transition-colors inline-block">
      Return to Dashboard
    </a>
  </main>
</Layout>
