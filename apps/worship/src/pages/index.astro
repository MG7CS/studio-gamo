---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import AudienceSection from '../components/home/AudienceSection.astro';
import InstrumentsSection from '../components/home/InstrumentsSection.astro';
import RequestSection from '../components/home/RequestSection.astro';
import AuditionSection from '../components/home/AuditionSection.astro';
import CoverageSection from '../components/home/CoverageSection.astro';
import SchedulingSection from '../components/home/SchedulingSection.astro';
import JoinSection from '../components/home/JoinSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---
<Layout title="Stronger Worship Starts Together" description="Gamo Worship is a developing program connecting churches with prepared, vetted worship musicians.">
  <HeroSection />
  <AudienceSection />
  <InstrumentsSection />
  <RequestSection />
  <AuditionSection />
  <CoverageSection />
  <SchedulingSection />
  <JoinSection />
  <FaqSection />
  <CtaInvitation eyebrow="Take part" title="Help shape Gamo Worship." body="Churches and musicians can explore the preview today. When the program opens, we will begin with a small group and grow carefully." photo="chapelSpring">
    <ButtonLink href="/hire" arrow>Preview a church request</ButtonLink>
    <ButtonLink href="/apply" variant="secondary">Preview the musician application</ButtonLink>
  </CtaInvitation>
</Layout>
