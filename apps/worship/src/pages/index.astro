---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="min-h-screen flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4">Gamo Studios Worship</h1>
      <p class="mb-8">Reliable musicians for every service.</p>
      <div class="flex gap-4 justify-center">
        <a href="/hire" class="bg-[#B65B35] text-white px-6 py-2 rounded">Hire a Musician</a>
        <a href="/apply" class="border border-[#B65B35] text-[#B65B35] px-6 py-2 rounded">Join the Collection</a>
      </div>
    </div>
  </main>
</Layout>
