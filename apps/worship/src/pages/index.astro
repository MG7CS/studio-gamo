---
import { providerSignupUrl } from '@studio-gamo/ui/lib/sites';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import AudienceSection from '../components/home/AudienceSection.astro';
import InstrumentsSection from '../components/home/InstrumentsSection.astro';
import RequestSection from '../components/home/RequestSection.astro';
import AuditionSection from '../components/home/AuditionSection.astro';
import CoverageSection from '../components/home/CoverageSection.astro';
import SchedulingSection from '../components/home/SchedulingSection.astro';
import JoinSection from '../components/home/JoinSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<Layout
  title="Stronger Worship Starts Together"
  description="Gamo Worship is a developing program helping churches find prepared, vetted musicians and helping musicians serve with dependable scheduling and fair pay."
>
  <HeroSection />
  <AudienceSection />
  <InstrumentsSection />
  <RequestSection />
  <AuditionSection />
  <CoverageSection />
  <SchedulingSection />
  <JoinSection />
  <FaqSection />
  <CtaInvitation
    eyebrow="Take part"
    title="Strengthen worship together."
    body="Churches can request prepared musicians, and instrumentalists or vocalists can apply to join our reviewed network."
    photo="chapelSpring"
  >
    <ButtonLink href={providerSignupUrl('worship', 'church')} arrow>
      Request musicians
    </ButtonLink>
    <ButtonLink href={providerSignupUrl('worship', 'musician')} variant="secondary">
      Apply as a musician
    </ButtonLink>
  </CtaInvitation>
</Layout>
