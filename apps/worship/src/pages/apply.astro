---
import Layout from '../layouts/Layout.astro';
import FormPlaceholder from '../components/forms/FormPlaceholder.astro';
import { auditionSteps } from '../data/worship';
---

<Layout
  title="Apply as a Musician"
  description="Christian instrumentalists and vocalists can apply to serve local churches through Gamo Worship."
>
  <FormPlaceholder
    eyebrow="Gamo Worship · musicians"
    title="Apply as a musician"
    intro="Tell us about your instruments, styles and experience serving in worship. Our team reviews every application."
    email="hello@gamostudio.org"
    steps={auditionSteps}
  />
</Layout>
