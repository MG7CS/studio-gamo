---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-2xl mx-auto py-12 px-4">
    <div class="text-sm text-gray-500 mb-2">Step 1 of 4</div>
    <h1 class="text-3xl font-bold mb-6">Identity Verification</h1>
    <div class="bg-yellow-50 border border-yellow-200 p-4 rounded-lg mb-6">
      <p class="text-sm font-medium text-yellow-800">Sandbox Environment</p>
      <p class="text-sm text-yellow-700">In production, this step uses a qualified verification provider. For this demo, clicking "Verify" will simulate a successful identity check.</p>
    </div>
    <form method="POST" action="/api/apply/identity" class="space-y-4">
      <div>
        <label class="block text-sm font-medium mb-1">Legal Full Name</label>
        <input type="text" name="name" required class="w-full border p-2 rounded" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Email</label>
        <input type="email" name="email" required class="w-full border p-2 rounded" />
      </div>
      <button type="submit" class="bg-[#B65B35] text-white px-6 py-2 rounded">Simulate Verification & Continue</button>
    </form>
  </main>
</Layout>
