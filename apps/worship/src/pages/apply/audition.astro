---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-2xl mx-auto py-12 px-4">
    <div class="text-sm text-[#6B6B67] mb-2 font-semibold uppercase">Step 4 of 4</div>
    <h1 class="text-3xl font-bold mb-6 text-[#1D2323]">Audition Submission</h1>
    <div class="bg-gray-100 p-4 rounded-lg mb-6">
      <p class="text-sm text-gray-700">Please provide an unlisted YouTube or Google Drive link showcasing a recent live worship performance.</p>
    </div>
    <form method="POST" action="/apply/status" class="space-y-6">
      <div>
        <label class="block text-sm font-bold mb-2">Performance Link URL</label>
        <input type="url" name="audition_url" class="w-full border p-3 rounded-lg" placeholder="https://youtube.com/..." required />
      </div>
      <button type="submit" class="bg-[#B65B35] text-white px-6 py-3 rounded-lg font-bold w-full">Submit Application</button>
    </form>
  </main>
</Layout>
