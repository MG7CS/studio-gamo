---
import Layout from '../../layouts/Layout.astro';
import FlowShell from '../../components/flow/FlowShell.astro';
import DemoForm from '../../components/flow/DemoForm.astro';
import FormField from '@studio-gamo/ui/components/FormField.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { applySteps } from '../../data/worship';
const tips = ['Record in a quiet room with your instrument clearly audible', 'One worship song plus one piece of your choosing', 'Phone recordings are welcome — clarity matters more than polish'];
---
<Layout title="Audition submission">
  <FlowShell eyebrow="Step 3 · Audition" title="Let us hear" accent="how you serve." lede="Share two short recordings by link. A coordinator listens for musicianship, preparation and sensitivity to a congregation." steps={applySteps} current={2} photo="gospelVocalists">
    <ul class="mb-8 grid gap-3 sm:grid-cols-3">
      {tips.map((t) => <li class="flex gap-3 rounded-2xl border border-sand bg-white p-4 text-sm text-ink-soft"><Icon name="video" class="h-5 w-5 shrink-0 text-terracotta" />{t}</li>)}
    </ul>
    <DemoForm next="/apply/status" back="/apply/profile" submitLabel="Preview submission">
      <FormField label="Recording 1 — worship song (link)" name="rec1" type="url" placeholder="https://" hint="Unlisted video or audio link. Nothing is uploaded in this preview." />
      <FormField label="Recording 2 — your choice (link)" name="rec2" type="url" placeholder="https://" />
      <FormField label="Two references (pastor, worship leader or music director)" name="refs" type="textarea" hint="References are only contacted after you consent, once the program opens." />
    </DemoForm>
  </FlowShell>
</Layout>
