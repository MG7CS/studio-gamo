---
import Layout from '../../layouts/Layout.astro';
import FlowShell from '../../components/flow/FlowShell.astro';
import StatusTimeline from '../../components/flow/StatusTimeline.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { applySteps } from '../../data/worship';
const items = [
  { label: 'Application received', note: 'Oct 14', state: 'done' as const },
  { label: 'Instrument & style profile', note: 'Keys & piano · Contemporary, Gospel', state: 'done' as const },
  { label: 'Audition recordings reviewed', note: 'A coordinator is listening', state: 'current' as const },
  { label: 'Conversation with a coordinator', note: 'Scheduled after review', state: 'upcoming' as const },
  { label: 'Approval decision', note: 'Approved musicians can view opportunities', state: 'upcoming' as const },
];
---
<Layout title="Application status">
  <FlowShell eyebrow="Step 4 · Status" title="Your application," accent="step by step." steps={applySteps} current={3} photo="youngPianist">
    <div class="rounded-[2rem] border border-sand bg-white p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div><p class="text-sm text-ink-soft">Applicant</p><p class="text-lg font-semibold">Ana R.</p></div>
        <div class="flex gap-2"><StatusPill kind="pending">In review</StatusPill></div>
      </div>
      <StatusTimeline items={items} class="mt-8" />
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonLink href="/opportunities" arrow>Browse opportunity board</ButtonLink>
      <ButtonLink href="/" variant="secondary">Back to Gamo Worship</ButtonLink>
    </div>
  </FlowShell>
</Layout>
