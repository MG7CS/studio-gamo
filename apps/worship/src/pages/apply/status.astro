---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-2xl mx-auto py-24 px-4 text-center">
    <h1 class="text-3xl font-bold mb-4">Application Submitted!</h1>
    <p class="text-xl text-gray-600 mb-8">Your application is currently under review by the Gamo Studios staff.</p>
    <div class="inline-block border border-yellow-300 bg-yellow-50 text-yellow-800 px-4 py-2 rounded-full font-medium">Status: Pending Review</div>
  </main>
</Layout>
