---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-2xl mx-auto py-12 px-4">
    <h1 class="text-3xl font-bold mb-6">Musician Application</h1>
    <ol class="list-decimal pl-5 space-y-4 mb-8">
      <li>Identity Verification</li>
      <li>Profile & Experience</li>
      <li>Travel & Availability</li>
      <li>Audition Submission</li>
    </ol>
    <a href="/apply/identity" class="bg-[#B65B35] text-white px-6 py-2 rounded inline-block">Start Application</a>
  </main>
</Layout>
