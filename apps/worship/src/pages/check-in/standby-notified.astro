---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-xl mx-auto py-24 px-4 text-center">
    <div class="w-16 h-16 bg-[#B65B35] text-white rounded-full flex items-center justify-center mx-auto mb-6 text-2xl">!</div>
    <h1 class="text-3xl font-bold mb-4">Standby Dispatched</h1>
    <p class="text-gray-500 mb-6">The primary musician failed to check in. The standby understudy has been notified and their response is pending.</p>
    
    <div class="bg-gray-50 p-6 rounded-lg text-left">
      <h3 class="font-bold text-sm uppercase tracking-wide mb-2">Simulated Email Sent</h3>
      <p class="text-sm font-mono text-gray-700">To: jane@example.com (Standby)<br/>Subject: URGENT: Dispatch Activated for Grace Community</p>
    </div>
  </main>
</Layout>
