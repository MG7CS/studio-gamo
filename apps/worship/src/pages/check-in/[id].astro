---
import Layout from '../../layouts/Layout.astro';
import FlowShell from '../../components/flow/FlowShell.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---
<Layout title="Arrival check-in preview"><FlowShell eyebrow="Sample coordination screen" title="Arrival check-in preview" lede="A future check-in screen would let an assigned musician record arrival. This design phase does not record attendance, start dispatch or notify anybody." notice="Design preview only. No attendance, notification or dispatch action takes place." wide><div class="flex flex-wrap gap-3"><ButtonLink href="/church/roster">View sample roster</ButtonLink><ButtonLink href="/check-in/success" variant="secondary">Preview arrival state</ButtonLink><ButtonLink href="/check-in/standby-notified" variant="secondary">Preview standby state</ButtonLink></div></FlowShell></Layout>
