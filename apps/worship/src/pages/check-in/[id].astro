---
import Layout from '../../layouts/Layout.astro';
import FlowShell from '../../components/flow/FlowShell.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<Layout title="Arrival check-in | Gamo Worship">
  <FlowShell
    eyebrow="Service coordination"
    title="Arrival check-in"
    lede="Assigned musicians confirm arrival at the church ahead of call time so worship leaders and coordinators have real-time peace of mind."
    wide
  >
    <div class="flex flex-wrap gap-3">
      <ButtonLink href="/church/roster">View service roster</ButtonLink>
      <ButtonLink href="/check-in/success" variant="secondary">
        Confirm arrival
      </ButtonLink>
      <ButtonLink href="/check-in/standby-notified" variant="secondary">
        Request standby support
      </ButtonLink>
    </div>
  </FlowShell>
</Layout>
