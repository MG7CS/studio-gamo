---
import Layout from '../../layouts/Layout.astro';
import FlowShell from '../../components/flow/FlowShell.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<Layout title="Arrival Check-In">
  <FlowShell
    eyebrow="Service coordination"
    title="Arrival check-in"
    lede="Online check-in is not available yet. When you arrive, confirm your arrival with the worship coordinator on site. If you cannot make your call time, contact the coordinator directly as early as possible."
    wide
  >
    <div class="flex flex-wrap gap-3">
      <ButtonLink href="/musician">Back to your workspace</ButtonLink>
    </div>
  </FlowShell>
</Layout>
