---
import Layout from '../../../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-xl mx-auto py-24 px-4 text-center">
    <h1 class="text-3xl font-bold mb-2">Sunday Check-In</h1>
    <p class="text-gray-500 mb-8">Grace Community (Demo) - 7:00 AM</p>

    <div class="bg-white border border-gray-200 rounded-xl p-8 mb-8 shadow-sm">
      <div class="w-20 h-20 bg-gray-100 rounded-full mx-auto mb-4 flex items-center justify-center text-3xl">🎸</div>
      <h2 class="text-xl font-bold">John Doe (Primary)</h2>
      <p class="text-sm text-green-600 font-medium mb-6">On time for check-in</p>

      <form method="POST" action="/api/check-in/confirm">
        <input type="hidden" name="assignmentId" value="123" />
        <button type="submit" class="w-full bg-[#B65B35] text-white py-4 rounded-xl font-bold text-lg hover:bg-[#8F432A] shadow-md transition-transform hover:scale-[1.02]">
          Confirm Arrival
        </button>
      </form>
    </div>

    <div class="border-t border-gray-200 pt-8">
      <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wide mb-4">Simulate Failure</h3>
      <form method="POST" action="/api/check-in/fail">
        <input type="hidden" name="assignmentId" value="123" />
        <button type="submit" class="w-full bg-red-50 text-red-700 border border-red-200 py-3 rounded-lg font-bold hover:bg-red-100">
          Simulate No-Show (Trigger Dispatch)
        </button>
      </form>
    </div>
  </main>
</Layout>
