---
/**
 * Instruments Gamo Worship is recruiting musicians for. Public and account-free: every card links to
 * the main-site musician application. No churches, dates, towns or pay amounts are shown.
 */
import { APPLY_HREF } from '../site.config';
import { musicianRoles } from '../data/worship';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
---

<p class="max-w-2xl text-fg-muted">Musician pay is always shown on its own line, with no deduction.</p>
<FeatureGrid as="ul" max={3} class="mt-8">
  {musicianRoles.map((r) => (
    <Card as="li" padding="md">
      <Icon name={r.icon} class="h-6 w-6 text-action" />
      <h2 class="mt-5 text-section-title font-semibold">{r.instrument}</h2>
      <p class="mt-3 text-body-sm text-fg-muted">{r.involves}</p>
      <div class="mt-auto pt-6">
        <ButtonLink href={APPLY_HREF} variant="secondary">
          Apply as a musician
        </ButtonLink>
      </div>
    </Card>
  ))}
</FeatureGrid>
