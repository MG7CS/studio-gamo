---
import { providerSignupUrl } from '@studio-gamo/ui/lib/sites';
import { opportunities, formatUsd } from '../../data/worship';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import SectionPanel from '../home/SectionPanel.astro';
const roles = [...new Set(opportunities.map((o) => o.role))];
---

<div data-opportunity-board>
  <SectionPanel>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <label class="block w-full text-sm font-semibold sm:max-w-xs">
        Filter by instrument
        <select
          data-role
          class="mt-2 block min-h-11 w-full rounded-full border border-charcoal/30 bg-white px-4 py-2.5 text-base font-normal"
        >
          <option value="">All instruments</option>
          {roles.map((role) => (
            <option>{role}</option>
          ))}
        </select>
      </label>
      <p class="text-sm text-ink-soft" aria-live="polite">
        <span data-count>{opportunities.length}</span> sample opportunities. Fictional examples of how
        listings will look.
      </p>
    </div>
  </SectionPanel>
  <div class="px-4 py-2.5 sm:px-6 sm:py-3">
    <div class="mx-auto grid max-w-[1320px] gap-4 sm:grid-cols-2 xl:grid-cols-3">
      {opportunities.map((o) => (
        <article
          data-opportunity
          data-role={o.role}
          class="flex flex-col rounded-[28px] bg-white p-5 shadow-[0_18px_50px_-30px_rgba(24,24,27,0.25)] ring-1 ring-sand sm:p-6"
        >
          <div class="flex flex-wrap gap-2">
            <StatusPill kind="sample">Sample · Open role</StatusPill>
            {o.standby && <StatusPill>Standby</StatusPill>}
          </div>
          <h2 class="mt-4 text-xl font-semibold text-charcoal">{o.role}</h2>
          <p class="mt-1 font-medium">{o.church}</p>
          <p class="text-sm text-ink-soft">{o.city}</p>
          <p class="mt-4 text-sm">{o.date}</p>
          <p class="mt-1 text-sm text-ink-soft">
            {o.style}
            {o.recurring && ' · Recurring'}
          </p>
          <p class="mt-4 text-lg font-semibold">
            {formatUsd(o.payCents)}{' '}
            <span class="text-xs font-normal text-ink-soft">proposed musician pay</span>
          </p>
          <p class="mt-1 text-xs text-ink-soft">Musician pay is its own line item, with no deduction.</p>
          <ButtonLink href={providerSignupUrl('worship', 'musician')} variant="secondary" class="mt-5 w-full">
            Apply as a musician
          </ButtonLink>
        </article>
      ))}
    </div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-opportunity-board]').forEach((root) => {
    const select = root.querySelector<HTMLSelectElement>('select[data-role]')!;
    select.addEventListener('change', () => {
      let count = 0;
      root.querySelectorAll<HTMLElement>('[data-opportunity]').forEach((card) => {
        card.hidden = Boolean(select.value && card.dataset.role !== select.value);
        if (!card.hidden) count++;
      });
      root.querySelector('[data-count]')!.textContent = String(count);
    });
  });
</script>
