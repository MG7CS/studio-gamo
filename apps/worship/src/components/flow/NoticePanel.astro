---
/** Simple centered confirmation / notice panel used by end-of-flow and legacy preview pages. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import type { IconName } from '@studio-gamo/ui/components/Icon.astro';
interface Props { eyebrow?: string; title: string; body: string; icon?: IconName; notice?: string }
const { eyebrow, title, body, icon = 'check', notice } = Astro.props;
---
<section class="bg-cream px-5 pt-32 pb-24 sm:px-8 lg:pt-40">
  <div class="mx-auto max-w-2xl rounded-[2.5rem] border border-sand bg-white p-8 text-center shadow-float sm:p-12">
    <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-cream text-terracotta"><Icon name={icon} class="h-6 w-6" /></span>
    {eyebrow && <p class="eyebrow mt-6 text-terracotta">{eyebrow}</p>}
    <h1 class="section-heading mt-3 text-charcoal">{title}</h1>
    <p class="mx-auto mt-4 max-w-lg text-ink-soft">{body}</p>
    {notice && <DemoNotice class="mt-6 text-left">{notice}</DemoNotice>}
    <div class="mt-8 flex flex-col gap-4 text-left"><slot /></div>
    <div class="mt-8 flex flex-wrap justify-center gap-3"><slot name="actions" /></div>
  </div>
</section>
