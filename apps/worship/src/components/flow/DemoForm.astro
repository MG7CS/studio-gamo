---
/**
 * Demo form: never posts anywhere. On submit, local JS navigates to the next prototype step.
 * Without JS, a separate preview link moves forward without submitting data.
 */
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
interface Props { next: string; back?: string; submitLabel?: string; class?: string }
const { next, back, submitLabel = 'Continue', class: className } = Astro.props;
---
<form data-demo-form data-next={next} class:list={['space-y-6', className]} onsubmit="return false">
  <slot />
  <div class="flex flex-wrap items-center gap-3 border-t border-sand pt-6">
    <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-terracotta px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-terracotta-dark">{submitLabel} →</button>
    {back && <ButtonLink href={back} variant="secondary">Back</ButtonLink>}
  </div>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('form[data-demo-form]').forEach((f) => {
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!f.reportValidity()) return;
      const next = f.dataset.next;
      if (next) window.location.assign(next);
    });
  });
</script>
