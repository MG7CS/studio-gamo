---
/** Checkbox chip group for instrument / style selection in demo forms. */
interface Props { legend: string; name: string; options: string[]; checked?: string[] }
const { legend, name, options, checked = [] } = Astro.props;
---
<fieldset>
  <legend class="text-sm font-semibold text-charcoal">{legend}</legend>
  <div class="mt-3 flex flex-wrap gap-2">
    {options.map((o) => (
      <label class="cursor-pointer">
        <input type="checkbox" name={name} value={o} checked={checked.includes(o)} class="peer sr-only" />
        <span class="inline-block rounded-full border border-sand bg-white px-4 py-2 text-sm text-charcoal transition-colors peer-checked:border-terracotta peer-checked:bg-terracotta peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-terracotta peer-focus-visible:ring-offset-2">{o}</span>
      </label>
    ))}
  </div>
</fieldset>
