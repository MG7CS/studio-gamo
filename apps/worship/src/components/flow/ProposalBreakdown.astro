---
/** Proposed contribution illustration: musician pay and Gamo allocation as separate lines. */
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { formatUsd } from '../../data/worship';
interface Props { class?: string }
const { class: className } = Astro.props;
const lines = [
  { label: 'Keys — musician pay', cents: 15000 },
  { label: 'Bass — musician pay', cents: 12500 },
  { label: 'Standby on-call — musician pay', cents: 6000 },
];
const allocation = 2500;
const total = lines.reduce((s, l) => s + l.cents, 0) + allocation;
---
<aside class:list={['rounded-[2rem] bg-ivory p-6 ring-1 ring-sand sm:p-8', className]} aria-labelledby="proposal-title">
  <div class="flex items-center justify-between gap-2"><h2 id="proposal-title" class="text-lg font-semibold">Illustrative contribution</h2><StatusPill kind="proposal">Proposal</StatusPill></div>
  <p class="mt-2 text-sm text-ink-soft">Per service. Amounts are placeholders awaiting board approval — not a quote.</p>
  <ul class="mt-6 space-y-3 text-sm">
    {lines.map((l) => <li class="flex justify-between gap-4"><span>{l.label}</span><span class="font-semibold tabular-nums">{formatUsd(l.cents)}</span></li>)}
    <li class="flex justify-between gap-4 border-t border-sand pt-3"><span>Gamo administrative allocation <span class="text-ink-soft">(separate)</span></span><span class="font-semibold tabular-nums">{formatUsd(allocation)}</span></li>
    <li class="flex justify-between gap-4 border-t border-charcoal/20 pt-3 text-base"><span class="font-semibold">Illustrative total</span><span class="font-semibold tabular-nums">{formatUsd(total)}</span></li>
  </ul>
  <p class="mt-5 text-xs text-ink-soft">Musician pay is never reduced to fund the allocation. Standby pay applies only where a standby is arranged.</p>
</aside>
