---
/** Page shell for multi-step prototype screens: header, step indicator, content + optional photo aside. */
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import StepIndicator from '@studio-gamo/ui/components/StepIndicator.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';

interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  lede?: string;
  steps?: { label: string; href?: string }[];
  current?: number;
  photo?: PhotoKey;
  notice?: string;
  wide?: boolean;
}
const { eyebrow, title, accent, lede, steps, current = 0, photo, wide = false } = Astro.props;
---

<section class="bg-cream page-intro-space">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    {steps && <StepIndicator steps={steps} current={current} class="mb-8" />}
    <div class:list={['grid gap-8', !wide && photo && 'lg:grid-cols-12']}>
      <div class:list={[!wide && photo && 'lg:col-span-7']}>
        <EditorialHeading
          as="h1"
          size="section"
          eyebrow={eyebrow}
          title={title}
          accent={accent}
          lede={lede}
        />
        <div class="mt-8">
          <slot />
        </div>
      </div>
      {!wide && photo && (
        <aside class="hidden lg:col-span-5 lg:block">
          <div class="sticky top-28 mx-auto aspect-[4/5] w-full max-w-[360px] overflow-hidden mask-arch-sm shadow-float">
            <Photo name={photo} sizes="35vw" />
          </div>
          <slot name="aside" />
        </aside>
      )}
    </div>
  </div>
</section>
