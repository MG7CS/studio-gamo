---
/** Vertical status timeline (done / current / upcoming). */
import Icon from '@studio-gamo/ui/components/Icon.astro';
interface Item { label: string; note?: string; state: 'done' | 'current' | 'upcoming' }
interface Props { items: Item[]; class?: string }
const { items, class: className } = Astro.props;
---
<ol class:list={['relative space-y-6', className]}>
  {items.map((it, i) => (
    <li class="relative flex gap-4">
      {i < items.length - 1 && <span class="absolute left-[15px] top-8 h-[calc(100%-0.5rem)] w-px bg-sand" aria-hidden="true"></span>}
      <span class:list={['relative grid h-8 w-8 shrink-0 place-items-center rounded-full', it.state === 'done' && 'bg-terracotta text-white', it.state === 'current' && 'border-2 border-terracotta bg-cream text-terracotta', it.state === 'upcoming' && 'border border-sand bg-white text-ink-soft']}>
        {it.state === 'done' ? <Icon name="check" class="h-4 w-4" /> : <span class="text-xs font-semibold">{i + 1}</span>}
      </span>
      <div>
        <p class:list={['font-semibold', it.state === 'upcoming' ? 'text-ink-soft' : 'text-charcoal']}>{it.label}{it.state === 'current' && <span class="sr-only"> (current step)</span>}</p>
        {it.note && <p class="text-sm text-ink-soft">{it.note}</p>}
      </div>
    </li>
  ))}
</ol>
