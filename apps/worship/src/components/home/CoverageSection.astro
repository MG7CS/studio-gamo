---
/** Primary and standby coordination: photo with a sample coverage timeline card, then the copy. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import SectionPanel from './SectionPanel.astro';
import MediaSplit from './MediaSplit.astro';
import PanelHeading from './PanelHeading.astro';
const timeline = [
  { t: 'Tue', label: 'Set list and keys shared with primary and standby', done: true },
  { t: 'Thu', label: 'Primary confirms rehearsal attendance', done: true },
  { t: 'Sat', label: 'Standby on call with the same charts', done: true },
  { t: 'Sun 7:30', label: 'Primary checks in at the church', done: false },
];
---

<SectionPanel labelledby="coverage-title">
  <MediaSplit reverse mediaSpan={6}>
    <div slot="media" class="relative">
      <div class="aspect-[4/3] overflow-hidden rounded-[28px]">
        <Photo name="worshipBand" sizes="(min-width:1024px) 45vw, 100vw" position="55% 40%" />
      </div>
      <div
        class="relative -mt-16 ml-auto mr-3 w-[92%] rounded-2xl border border-sand bg-white p-5 shadow-float sm:w-80 lg:absolute lg:-bottom-6 lg:-left-6 lg:mr-0 lg:mt-0"
        data-reveal
      >
        <div class="flex items-center justify-between gap-2">
          <p class="font-semibold">Keys coverage</p>
          <StatusPill kind="sample">Sample · Active</StatusPill>
        </div>
        <ol class="mt-4 space-y-3">
          {timeline.map((s) => (
            <li class="flex gap-3 text-sm">
              <span
                class:list={[
                  'mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full',
                  s.done ? 'bg-terracotta text-white' : 'border border-sand',
                ]}
              >
                {s.done && <Icon name="check" class="h-3 w-3" />}
              </span>
              <span>
                <span class="font-semibold text-charcoal">{s.t}</span> ·{' '}
                <span class="text-ink-soft">{s.label}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <PanelHeading
      id="coverage-title"
      eyebrow="Primary and standby"
      title="A plan for the day"
      accent="nobody expected."
      lede="Illness and emergencies happen. Where local availability allows, a standby musician gets the same preparation, so the service goes on."
    />
    <p class="mt-6 rounded-2xl border border-sand bg-cream p-4 text-sm text-ink-soft">
      Standby support is a goal of the program, not a guarantee. Coverage depends on the musicians available
      in each area.
    </p>
  </MediaSplit>
</SectionPanel>
