---
/** Primary & standby coordination: photo with a Sample coverage timeline preview. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FloatingPreviewCard from '@studio-gamo/ui/components/content/FloatingPreviewCard.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';

const timeline = [
  { t: 'Tue', label: 'Set list & keys shared with primary and standby', done: true },
  { t: 'Thu', label: 'Primary confirms rehearsal attendance', done: true },
  { t: 'Sat', label: 'Standby on call with the same charts', done: true },
  { t: 'Sun 7:30', label: 'Primary checks in at the church', done: false },
];
---

<Section id="coverage-title">
  <Fragment slot="eyebrow">Primary & standby</Fragment>
  <Fragment slot="title">
    A plan for the Sunday <span class="block text-action">nobody expected.</span>
  </Fragment>
  <Fragment slot="intro">
    <p>
      Illness and emergencies happen. Where local availability allows, a standby musician receives the same
      preparation so the congregation can still worship without disruption.
    </p>
    <p class="mt-3 text-small">Standby support depends on the musicians available in each area.</p>
  </Fragment>

  <div class="relative lg:pb-10">
    <div class="lg:w-4/5">
      <Frame
        photo="worshipBand"
        ratio="landscape"
        sizes="grid-tall"
        alt="Worship team with vocalists, guitar, drums and keys leading in a bright sanctuary"
      />
    </div>
    <FloatingPreviewCard
      title="Keys coverage"
      class="relative -mt-16 ms-auto me-4 w-11/12 sm:w-80 lg:absolute lg:end-0 lg:bottom-0 lg:mt-0"
    >
      <ol class="space-y-3">
        {timeline.map((s) => (
          <li class="flex gap-3 text-small">
            <span
              class:list={[
                'mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-pill',
                s.done ? 'bg-action text-on-action' : 'border border-border',
              ]}
            >
              {s.done && <Icon name="check" class="h-3 w-3" />}
            </span>
            <span>
              <span class="font-semibold">{s.t}</span> · <span class="text-fg-muted">{s.label}</span>
            </span>
          </li>
        ))}
      </ol>
    </FloatingPreviewCard>
  </div>
</Section>
