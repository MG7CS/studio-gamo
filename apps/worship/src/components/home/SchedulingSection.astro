---
import { providerSignupUrl } from '@studio-gamo/ui/lib/sites';
/** Scheduling and recurring needs: sample month roster first, then the copy. */
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import SectionPanel from './SectionPanel.astro';
import MediaSplit from './MediaSplit.astro';
import PanelHeading from './PanelHeading.astro';
// Sample month: November 2026 starts on a Sunday.
const days = Array.from({ length: 30 }, (_, i) => i + 1);
const sundays = new Set([1, 8, 15, 22, 29]);
const open = new Set([8]);
const points = [
  'Weekly, bi-weekly or monthly patterns',
  'Seasonal needs such as Easter, Christmas and revivals',
  'One roster view for every confirmed role',
];
---

<SectionPanel labelledby="schedule-title">
  <MediaSplit mediaSpan={6}>
    <div
      slot="media"
      class="mx-auto max-w-lg rounded-[2rem] border border-sand bg-cream p-5 sm:p-7"
      data-reveal
    >
      <div class="flex items-center justify-between gap-2">
        <p class="text-lg font-semibold">November</p>
        <StatusPill kind="sample">Sample · Roster</StatusPill>
      </div>
      <div class="mt-4 grid grid-cols-7 gap-1.5 text-center text-xs text-ink-soft" aria-hidden="true">
        {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((d) => (
          <span class="py-1 font-semibold">{d}</span>
        ))}
        {days.map((d) => (
          <span
            class:list={[
              'grid aspect-square place-items-center rounded-xl text-sm',
              sundays.has(d)
                ? open.has(d)
                  ? 'border-2 border-dashed border-terracotta font-semibold text-terracotta'
                  : 'bg-terracotta font-semibold text-white'
                : 'text-charcoal/70',
            ]}
          >
            {d}
          </span>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap gap-4 text-xs text-ink-soft">
        <span class="flex items-center gap-2">
          <span class="h-3 w-3 rounded bg-terracotta"></span>Musicians confirmed
        </span>
        <span class="flex items-center gap-2">
          <span class="h-3 w-3 rounded border-2 border-dashed border-terracotta"></span>Role still open
        </span>
      </div>
      <p class="sr-only">Sample November roster: four Sundays confirmed, November 8 has an open role.</p>
    </div>
    <PanelHeading
      id="schedule-title"
      eyebrow="Scheduling"
      title="Plan the season,"
      accent="not just the week."
      lede="Describe a recurring need once and see every upcoming date in one roster."
    />
    <ul class="mt-6 space-y-3">
      {points.map((p) => (
        <li class="flex gap-3 text-charcoal">
          <span class="mt-2.5 h-1.5 w-6 shrink-0 rounded-full bg-terracotta"></span>
          {p}
        </li>
      ))}
    </ul>
    <ButtonLink
      href={providerSignupUrl('worship', 'church')}
      variant="secondary"
      class="mt-8 w-full sm:w-auto"
      arrow
    >
      Start a request
    </ButtonLink>
  </MediaSplit>
</SectionPanel>
