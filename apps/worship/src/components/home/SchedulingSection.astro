---
import { REQUEST_HREF } from '../../site.config';
/** Church scheduling & recurring needs: key points beside a month roster showing how recurring needs are planned. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FloatingPreviewCard from '@studio-gamo/ui/components/content/FloatingPreviewCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';

const days = Array.from({ length: 30 }, (_, i) => i + 1);
const leadingBlanks = 6; // the month view starts on a Saturday
const sundays = new Set([2, 9, 16, 23, 30]);
const open = new Set([9]);
const weekdays = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const points = [
  'Weekly, bi-weekly or monthly patterns',
  'Seasonal needs — Easter, Christmas, revivals',
  'One roster view for every confirmed role',
];
---

<Section tone="raised" id="schedule-title">
  <Fragment slot="title">
    Plan the season, <span class="block text-action">not just the week.</span>
  </Fragment>

  <div class="grid items-center gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <ul class="space-y-3">
        {points.map((p) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-6 shrink-0 rounded-pill bg-action" aria-hidden="true"></span>
            {p}
          </li>
        ))}
      </ul>
      <ButtonLink href={REQUEST_HREF} variant="secondary" class="mt-8" arrow>
        Describe your need
      </ButtonLink>
    </div>
    <div class="lg:col-span-7" data-reveal>
      <FloatingPreviewCard title="Monthly service roster" class="mx-auto w-full max-w-lg">
        <div class="grid grid-cols-7 gap-1.5 text-center text-caption text-fg-muted" aria-hidden="true">
          {weekdays.map((d) => (
            <span class="py-1 font-semibold">{d}</span>
          ))}
          {Array.from({ length: leadingBlanks }, () => (
            <span />
          ))}
          {days.map((d) => (
            <span
              class:list={[
                'grid aspect-square place-items-center rounded-xl text-small',
                sundays.has(d)
                  ? open.has(d)
                    ? 'border-2 border-dashed border-action font-semibold text-action-strong'
                    : 'bg-action font-semibold text-on-action'
                  : 'text-fg-muted',
              ]}
            >
              {d}
            </span>
          ))}
        </div>
        <div class="flex flex-wrap gap-4 text-caption text-fg-muted" aria-hidden="true">
          <span class="flex items-center gap-2">
            <span class="h-3 w-3 rounded bg-action"></span>Musicians confirmed
          </span>
          <span class="flex items-center gap-2">
            <span class="h-3 w-3 rounded border-2 border-dashed border-action"></span>Role still open
          </span>
        </div>
        <p class="sr-only">
          Month view: four Sundays with musicians confirmed and one Sunday with a role still open.
        </p>
      </FloatingPreviewCard>
    </div>
  </div>
</Section>
