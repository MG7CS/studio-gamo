---
/** Audition and preparation process on a dark panel: photo pair first, then heading and steps. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ProcessSteps from './ProcessSteps.astro';
import SectionPanel from './SectionPanel.astro';
import MediaSplit from './MediaSplit.astro';
import PanelHeading from './PanelHeading.astro';
import { auditionSteps } from '../../data/worship';
---

<SectionPanel tone="night" labelledby="audition-title">
  <MediaSplit reverse mediaSpan={6}>
    <div slot="media" class="grid grid-cols-2 gap-3 sm:gap-4">
      <div class="aspect-[4/5] overflow-hidden rounded-[28px]">
        <Photo name="gospelVocalists" sizes="(min-width:1024px) 24vw, 45vw" />
      </div>
      <div class="mt-8 aspect-[4/5] overflow-hidden rounded-[28px]">
        <Photo name="acousticLeaderAlt" sizes="(min-width:1024px) 24vw, 45vw" />
      </div>
    </div>
    <PanelHeading
      id="audition-title"
      tone="dark"
      eyebrow="Audition and preparation"
      title="Prepared before"
      accent="they arrive."
      lede="Every musician goes through the same process. Payment, sponsorship or partnership never shortcuts it."
    />
  </MediaSplit>
  <div class="mt-10">
    <ProcessSteps steps={auditionSteps} tone="dark" />
  </div>
</SectionPanel>
