---
/** Audition & preparation process on a dark stage-lit surface. */
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ProcessSteps from './ProcessSteps.astro';
import { auditionSteps } from '../../data/worship';
---
<section class="relative overflow-hidden bg-night py-20 text-cream lg:py-28" data-surface="dark" aria-labelledby="audition-title">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid items-end gap-10 lg:grid-cols-12">
      <EditorialHeading id="audition-title" tone="dark" eyebrow="Audition & preparation" title="Prepared before" accent="they ever arrive." lede="Every musician goes through the same proposed process. Payment, sponsorship or partnership never shortcuts it." class="lg:col-span-6" />
      <div class="grid grid-cols-2 gap-4 lg:col-span-6">
        <div class="aspect-[4/5] overflow-hidden mask-leaf"><Photo name="gospelVocalists" sizes="(min-width:1024px) 22vw, 45vw" /></div>
        <div class="mt-12 aspect-[4/5] overflow-hidden mask-arch-sm"><Photo name="acousticLeaderAlt" sizes="(min-width:1024px) 22vw, 45vw" /></div>
      </div>
    </div>
    <div class="mt-16"><ProcessSteps steps={auditionSteps} tone="dark" /></div>
  </div>
</section>
