---
/** Audition & preparation process on a dark band: aligned steps beside a sculptural photo pair. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import NumberedSteps from '@studio-gamo/ui/components/content/NumberedSteps.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import { auditionSteps } from '../../data/worship';
---

<Section tone="dark" id="audition-title" class="overflow-hidden">
  <Fragment slot="eyebrow">Audition & preparation</Fragment>
  <Fragment slot="title">
    Prepared before <span class="block text-action">they ever arrive.</span>
  </Fragment>
  <p slot="intro">
    Every musician goes through the same review. Payment, sponsorship or partnership never shortcuts it.
  </p>

  <div class="grid items-center gap-12 lg:grid-cols-12">
    <NumberedSteps items={auditionSteps} class="lg:col-span-7" />
    <div class="grid grid-cols-2 gap-4 lg:col-span-5">
      <div class="aspect-portrait overflow-hidden mask-leaf">
        <Photo name="gospelVocalists" sizes="(min-width:1024px) 20vw, 45vw" />
      </div>
      <div class="mt-12 aspect-portrait overflow-hidden mask-arch-sm">
        <Photo name="acousticLeaderAlt" sizes="(min-width:1024px) 20vw, 45vw" />
      </div>
    </div>
  </div>
</Section>
