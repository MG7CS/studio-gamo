---
/** Instruments & musician categories: typographic list beside a pair of photos. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import PhotoGrid from '@studio-gamo/ui/components/media/PhotoGrid.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { instruments, styles } from '../../data/worship';
---

<Section id="instruments-title" title="The whole team, not just a player.">
  <div class="grid items-center gap-14 lg:grid-cols-12">
    <div class="order-2 lg:order-1 lg:col-span-5">
      <PhotoGrid
        layout="pair"
        photos={[
          { photo: 'acousticLeader', alt: 'Worship leader singing and playing acoustic guitar on stage' },
          {
            photo: 'soundEngineer',
            alt: 'Sound engineer wearing headphones at a digital mixing console during worship',
          },
        ]}
      />
    </div>
    <div class="order-1 lg:order-2 lg:col-span-7">
      <ul class="border-t border-border" data-reveal>
        {instruments.map((i) => (
          <li class="flex items-center gap-5 border-b border-border py-4">
            <Icon name={i.icon} class="h-6 w-6 shrink-0 text-action" />
            <span class="text-xl font-semibold tracking-tight sm:text-2xl">{i.name}</span>
            <span class="ms-auto hidden text-end text-small text-fg-muted md:block">{i.roles}</span>
          </li>
        ))}
      </ul>
      <h3 class="mt-8 text-small font-semibold tracking-eyebrow text-fg-muted uppercase">
        Styles of worship
      </h3>
      <ul class="mt-3 flex flex-wrap gap-2">
        {styles.map((s) => (
          <li class="rounded-button border border-border bg-surface-raised px-4 py-2 text-small">{s}</li>
        ))}
      </ul>
    </div>
  </div>
</Section>
