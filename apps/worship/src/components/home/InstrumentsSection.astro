---
/** Instruments and styles: photo pair, then the typographic instrument list. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { instruments, styles } from '../../data/worship';
import SectionPanel from './SectionPanel.astro';
import MediaSplit from './MediaSplit.astro';
import PanelHeading from './PanelHeading.astro';
---

<SectionPanel labelledby="instruments-title">
  <MediaSplit>
    <div slot="media" class="relative pb-8 pr-6 sm:pr-10">
      <div class="aspect-[4/5] overflow-hidden rounded-[28px]">
        <Photo name="acousticLeader" sizes="(min-width:1024px) 36vw, 90vw" />
      </div>
      <div class="absolute bottom-0 right-0 aspect-square w-2/5 overflow-hidden rounded-full border-8 border-white">
        <Photo name="soundEngineer" sizes="(min-width:1024px) 16vw, 40vw" />
      </div>
    </div>
    <PanelHeading
      id="instruments-title"
      eyebrow="Instruments and styles"
      title="The whole team,"
      accent="not just a player."
      lede="Musicians apply by instrument and by the styles they know well. Churches and groups request exactly the support their service or event needs."
    />
    <ul class="mt-8 border-t border-sand" data-reveal>
      {instruments.map((i) => (
        <li class="flex items-center gap-4 border-b border-sand py-3.5">
          <Icon name={i.icon} class="h-6 w-6 shrink-0 text-terracotta" />
          <div class="min-w-0 sm:flex sm:flex-1 sm:items-baseline sm:justify-between sm:gap-4">
            <span class="block text-lg font-semibold tracking-tight text-charcoal sm:text-xl">{i.name}</span>
            <span class="block text-sm text-ink-soft sm:text-right">{i.roles}</span>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-ink-soft">Styles of worship</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {styles.map((s) => (
        <li class="rounded-full border border-sand bg-cream px-3.5 py-1.5 text-sm text-charcoal">{s}</li>
      ))}
    </ul>
  </MediaSplit>
</SectionPanel>
