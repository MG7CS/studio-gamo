---
/** Instruments & musician categories: typographic list beside a sculptural photo pair. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { instruments, styles } from '../../data/worship';
---

<Section id="instruments-title" title="The whole team, not just a player.">
  <Fragment slot="eyebrow">Instruments & categories</Fragment>
  <p slot="intro">
    Musicians apply by instrument and by the styles of worship they know well, so churches can request exactly
    the support their service needs.
  </p>

  <div class="grid items-center gap-14 lg:grid-cols-12">
    <div class="relative order-2 lg:order-1 lg:col-span-5">
      <div class="aspect-portrait w-4/5 overflow-hidden mask-arch-sm">
        <Photo name="acousticLeader" sizes="(min-width:1024px) 32vw, 80vw" />
      </div>
      <div class="absolute -bottom-6 end-0 aspect-square w-2/5 overflow-hidden rounded-pill border-8 border-surface">
        <Photo name="soundEngineer" sizes="(min-width:1024px) 16vw, 40vw" />
      </div>
    </div>
    <div class="order-1 lg:order-2 lg:col-span-7">
      <ul class="border-t border-border" data-reveal>
        {instruments.map((i) => (
          <li class="flex items-center gap-5 border-b border-border py-4">
            <Icon name={i.icon} class="h-6 w-6 shrink-0 text-action" />
            <span class="text-xl font-semibold tracking-tight sm:text-2xl">{i.name}</span>
            <span class="ms-auto hidden text-end text-small text-fg-muted md:block">{i.roles}</span>
          </li>
        ))}
      </ul>
      <h3 class="mt-8 text-small font-semibold tracking-eyebrow text-fg-muted uppercase">
        Styles of worship
      </h3>
      <ul class="mt-3 flex flex-wrap gap-2">
        {styles.map((s) => (
          <li class="rounded-pill border border-border bg-surface-raised px-4 py-2 text-small">{s}</li>
        ))}
      </ul>
    </div>
  </div>
</Section>
