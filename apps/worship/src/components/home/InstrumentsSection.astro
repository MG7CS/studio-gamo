---
/** Instruments & musician categories: typographic list beside a sculptural photo pair. */
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { instruments, styles } from '../../data/worship';
---
<section class="bg-cream section-space" aria-labelledby="instruments-title">
  <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-12">
    <div class="relative order-2 lg:order-1 lg:col-span-5">
      <div class="aspect-[4/5] w-4/5 overflow-hidden mask-arch-sm">
        <Photo name="acousticLeader" sizes="(min-width:1024px) 32vw, 80vw" />
      </div>
      <div class="absolute -bottom-6 right-0 aspect-square w-2/5 overflow-hidden rounded-full border-8 border-cream">
        <Photo name="soundEngineer" sizes="(min-width:1024px) 16vw, 40vw" />
      </div>
    </div>
    <div class="order-1 lg:order-2 lg:col-span-7">
      <EditorialHeading id="instruments-title" eyebrow="Instruments & categories" title="The whole team, not just a player." lede="Musicians apply by instrument and by the styles of worship they know well, so churches can request exactly the support their service needs." />
      <ul class="mt-10 border-t border-sand" data-reveal>
        {instruments.map((i) => (
          <li class="group flex items-center gap-5 border-b border-sand py-4">
            <Icon name={i.icon} class="h-6 w-6 shrink-0 text-terracotta" />
            <span class="text-xl font-semibold tracking-tight text-charcoal sm:text-2xl">{i.name}</span>
            <span class="ml-auto hidden text-right text-sm text-ink-soft md:block">{i.roles}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-sm font-semibold uppercase tracking-wider text-ink-soft">Styles of worship</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {styles.map((s) => <li class="rounded-full border border-sand bg-white px-4 py-2 text-sm text-charcoal">{s}</li>)}
      </ul>
    </div>
  </div>
</section>
