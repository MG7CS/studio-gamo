---
/** FAQ panel. */
import FaqAccordion from '@gamo/site/components/FaqAccordion.astro';
import SectionPanel from './SectionPanel.astro';
import PanelHeading from './PanelHeading.astro';
import { faqs } from '../../data/worship';
---

<SectionPanel labelledby="faq-title">
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
    <PanelHeading
      id="faq-title"
      eyebrow="Questions"
      title="Honest answers"
      accent="while we build."
      class="lg:col-span-4"
    />
    <FaqAccordion items={faqs} class="lg:col-span-8" />
  </div>
</SectionPanel>
