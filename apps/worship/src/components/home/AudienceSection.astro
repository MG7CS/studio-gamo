---
import { providerSignupUrl } from '@studio-gamo/ui/lib/sites';
/** Who the program serves: photo, heading, then a switch between churches and groups, and musicians. */
import AudienceSwitch from '@studio-gamo/ui/components/AudienceSwitch.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import type { IconName } from '@studio-gamo/ui/components/Icon.astro';
import SectionPanel from './SectionPanel.astro';
import MediaSplit from './MediaSplit.astro';
import PanelHeading from './PanelHeading.astro';

const churches: [IconName, string, string][] = [
  ['calendar', 'Scheduling', 'One date or a recurring pattern, on any day of the week.'],
  ['users', 'Thoughtful matching', 'Instrument, style and location considered together.'],
  ['clock', 'Availability', 'See who is proposed and confirmed ahead of time.'],
  ['book', 'Rehearsal info', 'Set lists, keys and call times in one place.'],
  ['repeat', 'Standby support', 'A prepared backup where local availability allows.'],
];
const musicians: [IconName, string, string][] = [
  ['music', 'Application', 'Tell us your instruments, styles and experience.'],
  ['mic', 'Audition', 'Share two recordings and meet with Gamo.'],
  ['check', 'Approval', 'Join a reviewed collection of prepared musicians.'],
  ['calendar', 'Opportunities', 'Choose the services and events that fit your calendar.'],
  ['heart', 'Fair pay', 'Your pay is its own line item and is never reduced.'],
];
const panels = [
  ['churches', churches, providerSignupUrl('worship', 'church'), 'Start a request'],
  ['musicians', musicians, providerSignupUrl('worship', 'musician'), 'Begin an application'],
] as const;
---

<SectionPanel labelledby="intro-title">
  <MediaSplit align="start">
    <div slot="media" class="aspect-[4/3] overflow-hidden rounded-[28px] lg:aspect-[4/5]">
      <Photo name="sanctuaryCongregation" sizes="(min-width:1024px) 40vw, 100vw" />
    </div>
    <PanelHeading
      id="intro-title"
      eyebrow="Who it serves"
      title="One service,"
      accent="two sides."
      lede="Churches and other groups need prepared musicians. Musicians want to serve well and be paid fairly. Gamo Worship supports both."
    />
    <AudienceSwitch
      id="audience"
      label="Choose your perspective"
      class="mt-8"
      options={[
        { id: 'churches', label: 'Churches and groups' },
        { id: 'musicians', label: 'Musicians' },
      ]}
    >
      {panels.map(([slot, items, href, cta]) => (
        <div slot={slot}>
          <ul class="divide-y divide-sand rounded-2xl border border-sand bg-cream">
            {items.map(([icon, t, b]) => (
              <li class="flex gap-4 p-4">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-white text-terracotta">
                  <Icon name={icon} class="h-5 w-5" />
                </span>
                <div>
                  <p class="font-semibold text-charcoal">{t}</p>
                  <p class="text-sm text-ink-soft">{b}</p>
                </div>
              </li>
            ))}
          </ul>
          <ButtonLink href={href} class="mt-5 w-full sm:w-auto" arrow>
            {cta}
          </ButtonLink>
        </div>
      ))}
    </AudienceSwitch>
  </MediaSplit>
</SectionPanel>
