---
import { APPLY_HREF, REQUEST_HREF } from '../../site.config';
/** Intro + audience switch between churches and musicians. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import AudienceSwitch from '@studio-gamo/ui/components/AudienceSwitch.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import type { IconName } from '@studio-gamo/ui/components/Icon.astro';

type Item = [IconName, string, string];
const churches: Item[] = [
  ['calendar', 'Scheduling', 'Request a single service or a recurring Sunday pattern.'],
  ['users', 'Thoughtful matching', 'Instrument, style and location considered together.'],
  ['clock', 'Availability', 'See who is matched and confirmed before the week begins.'],
  ['book', 'Rehearsal info', 'Set lists, keys and call times shared in one place.'],
  ['repeat', 'Standby support', 'A prepared backup where local availability allows.'],
];
const musicians: Item[] = [
  ['music', 'Application', 'Tell us your instruments, styles and experience.'],
  ['mic', 'Audition', 'Share recordings and meet a coordinator.'],
  ['check', 'Approval', 'Join a collection known for preparation and character.'],
  ['calendar', 'Opportunities', 'Choose services that fit your calendar.'],
  ['heart', 'Fair compensation', 'Your pay is always its own line — never reduced.'],
];
const panels: { slot: string; items: Item[]; href: string; cta: string }[] = [
  { slot: 'churches', items: churches, href: REQUEST_HREF, cta: 'Start a church request' },
  { slot: 'musicians', items: musicians, href: APPLY_HREF, cta: 'Begin an application' },
];
---

<Section tone="raised" id="intro-title">
  <Fragment slot="title">Musicians We Trust</Fragment>

  <div class="grid gap-12 lg:grid-cols-12">
    <div class="hidden lg:col-span-5 lg:block">
      <Frame
        photo="sanctuaryCongregation"
        ratio="landscape"
        sizes="half"
        alt="Congregation worshipping together in a sunlit sanctuary"
        data-reveal
      />
    </div>
    <div class="lg:col-span-7" data-reveal>
      <AudienceSwitch
        id="audience"
        label="Choose your perspective"
        options={[
          { id: 'churches', label: 'For churches' },
          { id: 'musicians', label: 'For musicians' },
        ]}
      >
        {panels.map(({ slot, items, href, cta }) => (
          <div slot={slot}>
            <ul class="mt-6 divide-y divide-border rounded-card border border-border bg-surface">
              {items.map(([icon, t, b]) => (
                <li class="flex gap-4 p-5">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-pill bg-surface-raised text-action">
                    <Icon name={icon} class="h-5 w-5" />
                  </span>
                  <div>
                    <p class="font-semibold">{t}</p>
                    <p class="text-small text-fg-muted">{b}</p>
                  </div>
                </li>
              ))}
            </ul>
            <ButtonLink href={href} class="mt-6" arrow>
              {cta}
            </ButtonLink>
          </div>
        ))}
      </AudienceSwitch>
    </div>
  </div>
</Section>
