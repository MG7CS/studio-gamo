---
/** How churches request musicians: four aligned steps (shared NumberedSteps). */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import NumberedSteps from '@studio-gamo/ui/components/content/NumberedSteps.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { requestSteps } from '../../data/worship';
---

<Section tone="raised" id="request-title">
  <Fragment slot="eyebrow">For churches</Fragment>
  <Fragment slot="title">
    Requesting musicians, <span class="block text-action">in four calm steps.</span>
  </Fragment>
  <ButtonLink slot="actions" href="/request" variant="secondary" arrow>
    Start a request
  </ButtonLink>

  <NumberedSteps items={requestSteps} />
</Section>
