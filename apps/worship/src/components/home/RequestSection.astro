---
import { providerSignupUrl } from '@studio-gamo/ui/lib/sites';
/** How churches and groups request musicians. */
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import ProcessSteps from './ProcessSteps.astro';
import SectionPanel from './SectionPanel.astro';
import PanelHeading from './PanelHeading.astro';
import { requestSteps } from '../../data/worship';
---

<SectionPanel labelledby="request-title">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <PanelHeading
      id="request-title"
      eyebrow="For churches and groups"
      title="Request musicians"
      accent="made simple."
      lede="For a service, a concert, an event or almost any occasion, on any day."
    />
    <ButtonLink
      href={providerSignupUrl('worship', 'church')}
      variant="secondary"
      class="w-full sm:w-auto"
      arrow
    >
      Start a request
    </ButtonLink>
  </div>
  <div class="mt-8">
    <ProcessSteps steps={requestSteps} />
  </div>
</SectionPanel>
