---
/** Worship landing hero: editorial headline left, curved photo composition + sample match card right. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
---
<section class="relative flex min-h-[100dvh] flex-col justify-center overflow-hidden bg-cream page-intro-space" aria-labelledby="hero-title">
  <div class="mx-auto grid w-full max-w-7xl items-center gap-10 px-5 sm:px-8 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-6">
      <p class="eyebrow text-terracotta">Gamo Worship · a developing program</p>
      <h1 id="hero-title" class="display-xl worship-hero-title mt-4 text-balance text-charcoal">Stronger Worship <span class="block text-terracotta">Starts Together.</span></h1>
      <p class="mt-5 max-w-xl text-base lg:text-lg leading-relaxed text-ink-soft">
        We are building a trusted way for churches to find prepared, vetted musicians — and for musicians to serve congregations with excellence, dependable scheduling and fair pay.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <ButtonLink href="/hire" size="lg" arrow>Request musicians</ButtonLink>
        <ButtonLink href="/apply" size="lg" variant="secondary">Apply as a musician</ButtonLink>
      </div>
    </div>

    <div class="order-first lg:order-none relative lg:col-span-6">
      <div class="relative ml-auto grid max-w-[500px] grid-cols-5 gap-3 sm:gap-4">
        <div class="col-span-3 row-span-2 aspect-[3/4] overflow-hidden mask-arch shadow-float">
          <Photo name="worshipLeaderGolden" priority sizes="(min-width:1024px) 30vw, 60vw" />
        </div>
        <div class="col-span-2 aspect-square self-end overflow-hidden mask-leaf-alt">
          <Photo name="worshipBand" sizes="(min-width:1024px) 18vw, 38vw" />
        </div>
        <div class="col-span-2 aspect-[4/5] overflow-hidden rounded-[2rem] rounded-br-[6rem]">
          <Photo name="churchModernDay" sizes="(min-width:1024px) 18vw, 38vw" />
        </div>
      </div>

      <aside class="relative z-10 -mt-14 ml-2 w-[min(19rem,88%)] rounded-3xl border border-sand bg-white/95 p-5 shadow-float sm:absolute sm:bottom-8 sm:left-0 sm:mt-0 lg:-left-4" aria-label="Musician match overview">
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Sunday match</p>
          <StatusPill kind="verified">Confirmed</StatusPill>
        </div>
        <p class="mt-3 font-semibold text-charcoal">Riverside Fellowship</p>
        <p class="text-sm text-ink-soft">Sun · 8:00 AM call · Contemporary</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li class="flex items-center gap-2"><Icon name="piano" class="h-4 w-4 text-terracotta" /> Keys — <span class="font-medium">Ana R.</span><span class="ml-auto text-xs text-emerald-700">Primary</span></li>
          <li class="flex items-center gap-2"><Icon name="repeat" class="h-4 w-4 text-terracotta" /> Standby — <span class="font-medium">David K.</span><span class="ml-auto text-xs text-ink-soft">Set list shared</span></li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) { .worship-hero-title { font-size: clamp(3rem, 4.4vw, 4rem); } }
</style>
