---
import { APPLY_HREF, REQUEST_HREF } from '../../site.config';
/** Worship landing hero: only the content (heading, buttons, photos); the layout is the shared PhotoTrioHero. */
import PhotoTrioHero from '@studio-gamo/ui/components/content/PhotoTrioHero.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<PhotoTrioHero
  id="worship-hero-title"
  title="Stronger Worship"
  accent="Starts Together."
  photos={[
    {
      photo: 'worshipLeaderGolden',
      alt: 'Gospel worship leader singing with eyes closed in warm golden light',
      priority: true,
    },
    {
      photo: 'worshipBand',
      alt: 'Worship team with guitar, drums and keys leading in a bright sanctuary',
    },
    { photo: 'churchModernDay', alt: 'Modern church building with a cross on a sunny day' },
  ]}
>
  <Fragment slot="actions">
    <ButtonLink href={REQUEST_HREF} size="lg" arrow>
      Request musicians
    </ButtonLink>
    <ButtonLink href={APPLY_HREF} size="lg" variant="secondary">
      Apply as a musician
    </ButtonLink>
  </Fragment>
</PhotoTrioHero>
