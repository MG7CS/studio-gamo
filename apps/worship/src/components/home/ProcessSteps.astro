---
/** Numbered process steps as compact aligned cards: one column on phones, four on desktop. */
import type { Step } from '../../data/worship';
interface Props {
  steps: Step[];
  tone?: 'light' | 'dark';
}
const { steps, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
  {steps.map((s, i) => (
    <li
      class:list={['rounded-2xl p-5', dark ? 'bg-white/5 ring-1 ring-white/10' : 'bg-cream ring-1 ring-sand']}
    >
      <span
        class:list={['block text-3xl font-semibold tracking-tighter', dark ? 'text-gold' : 'text-terracotta']}
      >
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3 class:list={['mt-3 text-base font-semibold', dark ? 'text-cream' : 'text-charcoal']}>{s.title}</h3>
      <p class:list={['mt-1.5 text-sm leading-relaxed', dark ? 'text-cream/75' : 'text-ink-soft']}>
        {s.body}
      </p>
    </li>
  ))}
</ol>
