# Gamo Worship (apps/worship) — local secrets. Copy to apps/worship/.dev.vars (git-ignored).
# Shared settings (ENVIRONMENT, SESSION_SECRET, RESEND_API_KEY, local-only flags) come from the root .env.
# In preview/production: `wrangler secret put <NAME> --env <preview|production>` from apps/worship.

# OPTIONAL. Clerk sign-in for this product only. When unset, sign-in uses Gamo's own email
# verification codes (D1 sessions). Use this product's own Clerk application — never Gamo Live's
# keys (the app refuses to start auth with them). Unsuffixed names are mapped to *_WORSHIP locally.
CLERK_APP_ID_WORSHIP=
PUBLIC_CLERK_PUBLISHABLE_KEY_WORSHIP=
CLERK_SECRET_KEY_WORSHIP=
# OPTIONAL. Networkless JWT verification key (PEM) and issuer; derived from the publishable key when unset.
CLERK_JWT_KEY_WORSHIP=
CLERK_ISSUER_WORSHIP=
# OPTIONAL. Comma-separated allowed origins for Clerk tokens; defaults to this app's local/preview/production origins.
CLERK_AUTHORIZED_PARTIES_WORSHIP=
