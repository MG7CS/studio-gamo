# Gamo Worship (apps/worship) — Application Local Environment Template (.env.example)
# Copy to apps/worship/.env (or apps/worship/.dev.vars) after provisioning Gamo Worship's dedicated Clerk application.
# NEVER reuse Gamo Live (app_3KlWyOBL2xL2YzhJuvgk8QdrWIt) credentials here.

# Standard Clerk SDK variable names (automatically mapped to *_WORSHIP by @gamo/config/env-loader)
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_WORSHIP_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_WORSHIP_SECRET"

# Product-scoped Clerk metadata & optional explicit suffixed overrides
PUBLIC_CLERK_KEYLESS_DISABLED="true"
CLERK_KEYLESS_DISABLED="true"
CLERK_APP_ID_WORSHIP="pending_clerk_app_gamo_worship"
PUBLIC_CLERK_PUBLISHABLE_KEY_WORSHIP="pk_test_YOUR_WORSHIP_KEY"
CLERK_SECRET_KEY_WORSHIP="sk_test_YOUR_WORSHIP_SECRET"
CLERK_JWT_KEY_WORSHIP=""
CLERK_ISSUER_WORSHIP=""
CLERK_AUTHORIZED_PARTIES_WORSHIP="http://127.0.0.1:4322,http://localhost:4322,https://worship.gamostudio.org"
