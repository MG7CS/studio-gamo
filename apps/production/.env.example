# Gamo Production (apps/production) — Application Local Environment Template (.env.example)
# Copy to apps/production/.env (or apps/production/.dev.vars) after provisioning Gamo Production's dedicated Clerk application.
# NEVER reuse Gamo Live (app_3KlWyOBL2xL2YzhJuvgk8QdrWIt) credentials here.

# Standard Clerk SDK variable names (automatically mapped to *_PRODUCTION by @gamo/config/env-loader)
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_PRODUCTION_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_PRODUCTION_SECRET"

# Product-scoped Clerk metadata & optional explicit suffixed overrides
PUBLIC_CLERK_KEYLESS_DISABLED="true"
CLERK_KEYLESS_DISABLED="true"
CLERK_APP_ID_PRODUCTION="pending_clerk_app_gamo_production"
PUBLIC_CLERK_PUBLISHABLE_KEY_PRODUCTION="pk_test_YOUR_PRODUCTION_KEY"
CLERK_SECRET_KEY_PRODUCTION="sk_test_YOUR_PRODUCTION_SECRET"
CLERK_JWT_KEY_PRODUCTION=""
CLERK_ISSUER_PRODUCTION=""
CLERK_AUTHORIZED_PARTIES_PRODUCTION="http://127.0.0.1:4325,http://localhost:4325,https://production.gamostudio.org"
