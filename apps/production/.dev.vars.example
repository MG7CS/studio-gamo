# Gamo Production (apps/production) — Local Worker Secrets Example (.dev.vars.example)
# Copy to apps/production/.dev.vars after provisioning the dedicated Gamo Production Clerk application.
# NEVER reuse Gamo Live (app_3KlWyOBL2xL2YzhJuvgk8QdrWIt) credentials here.
# Shared local settings (ENVIRONMENT, SESSION_SECRET, RESEND_API_KEY, etc.) are inherited from root .dev.vars / .env.

# Clerk — Gamo Production Dedicated Application (Pending Founder Provisioning)
PUBLIC_CLERK_KEYLESS_DISABLED="true"
CLERK_KEYLESS_DISABLED="true"
CLERK_APP_ID_PRODUCTION="pending_clerk_app_gamo_production"
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_PRODUCTION_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_PRODUCTION_SECRET"
CLERK_JWT_KEY_PRODUCTION=""
CLERK_ISSUER_PRODUCTION=""
CLERK_AUTHORIZED_PARTIES_PRODUCTION="http://127.0.0.1:4325,http://localhost:4325,https://production.gamostudio.org"
