---
/**
 * One support area on the landing page: the shared SplitHero (as a section) with a photo,
 * an optional floating `preview` (a FloatingPreviewCard recipe) and the area's copy. Tone and side vary per
 * area so consecutive rows do not repeat.
 */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import { photos } from '@studio-gamo/ui/lib/images';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import type { SupportArea } from '../../data/production';

interface Props {
  area: SupportArea;
  /** Puts the photo on the start side in wide containers. */
  reverse?: boolean;
  tone?: 'default' | 'raised' | 'dark';
}
const { area, reverse = false, tone = 'default' } = Astro.props;
const dark = tone === 'dark';
const id = `area-${area.slug}`;
---

<SplitHero
  as="section"
  spacing="section"
  mediaSide={reverse ? 'start' : 'end'}
  tone={dark ? 'dark' : 'default'}
  class={tone === 'raised' ? 'bg-surface-raised' : undefined}
>
  <h2 id={id} class="section-heading text-balance text-fg">
    {area.title}
  </h2>
  <ul class="mt-3 grid w-full gap-3 sm:grid-cols-2">
    {area.covers.map((c) => (
      <li class="flex items-start gap-3 border-t border-border pt-3 text-small text-fg">
        <Icon name="check" class="mt-0.5 size-4 shrink-0 text-action" strokeWidth={2} />
        {c}
      </li>
    ))}
  </ul>
  <ButtonLink href={`/services/${area.slug}`} variant={dark ? 'ghost-dark' : 'secondary'} arrow class="mt-3">
    Explore {area.title.toLowerCase()}
  </ButtonLink>
  <div slot="media" class="relative">
    <Frame
      photo={area.photo}
      ratio={photos[area.photo].ratios.includes('landscape') ? 'landscape' : 'square'}
      sizes="half"
      alt={photos[area.photo].alt}
    />
    {Astro.slots.has('preview') && (
      <div
        class:list={[
          'relative -mt-16 px-4 sm:absolute sm:-bottom-10 sm:mt-0 sm:px-0',
          reverse ? 'sm:-start-4' : 'sm:-end-4',
        ]}
      >
        <slot name="preview" />
      </div>
    )}
  </div>
</SplitHero>
