---
/**
 * One support area on the landing page: the shared SplitHero (as a section) with a sculptural photo,
 * an optional floating `preview` (a FloatingPreviewCard recipe) and the area's copy. Tone, side and
 * photo shape vary per area so consecutive rows do not repeat.
 */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import type { SupportArea } from '../../data/production';

type Shape = 'rounded' | 'leaf' | 'leaf-alt' | 'arch';
interface Props {
  area: SupportArea;
  index: number;
  /** Puts the photo on the start side in wide containers. */
  reverse?: boolean;
  tone?: 'default' | 'raised' | 'dark';
  shape?: Shape;
}
const { area, index, reverse = false, tone = 'default', shape = 'rounded' } = Astro.props;
const dark = tone === 'dark';
const shapeClass: Record<Shape, string> = {
  rounded: 'rounded-hero',
  leaf: 'mask-leaf',
  'leaf-alt': 'mask-leaf-alt',
  arch: 'mask-arch',
};
const id = `area-${area.slug}`;
---

<SplitHero
  as="section"
  spacing="section"
  mediaSide={reverse ? 'start' : 'end'}
  tone={dark ? 'dark' : 'default'}
  class={tone === 'raised' ? 'bg-surface-raised' : undefined}
>
  <p class="eyebrow flex items-center gap-2 text-action-strong">
    <Icon name={area.icon} class="size-4" /> 0{index} · Support area
  </p>
  <h2 id={id} class="section-heading text-balance text-fg">
    {area.title}
  </h2>
  <p class="text-lg leading-relaxed text-fg-muted">{area.summary}</p>
  <ul class="mt-3 grid w-full gap-3 sm:grid-cols-2">
    {area.covers.map((c) => (
      <li class="flex items-start gap-3 border-t border-border pt-3 text-small text-fg">
        <Icon name="check" class="mt-0.5 size-4 shrink-0 text-action" strokeWidth={2} />
        {c}
      </li>
    ))}
  </ul>
  <ButtonLink href={`/services/${area.slug}`} variant={dark ? 'ghost-dark' : 'secondary'} arrow class="mt-3">
    Explore {area.title.toLowerCase()}
  </ButtonLink>
  <div slot="media" class="relative">
    <div class:list={['aspect-landscape overflow-hidden bg-surface-inset shadow-float', shapeClass[shape]]}>
      <Photo
        name={area.photo}
        position={area.photoPosition}
        sizes="(min-width:1024px) 45vw, 100vw"
        class="h-full w-full object-cover"
      />
    </div>
    {Astro.slots.has('preview') && (
      <div
        class:list={[
          'relative -mt-16 px-4 sm:absolute sm:-bottom-10 sm:mt-0 sm:px-0',
          reverse ? 'sm:-start-4' : 'sm:-end-4',
        ]}
      >
        <slot name="preview" />
      </div>
    )}
  </div>
</SplitHero>
