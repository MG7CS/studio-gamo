---
/**
 * One support area on the homepage: photo (with an optional small UI mock in the `preview` slot),
 * then heading, summary, what it covers and a link to the detail page.
 */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import SectionPanel from './SectionPanel.astro';
import SectionHeader from './SectionHeader.astro';
import SplitMedia from './SplitMedia.astro';
import PhotoFrame from './PhotoFrame.astro';
import Actions from './Actions.astro';
import type { SupportArea } from '../../data/production';

interface Props {
  area: SupportArea;
  reverse?: boolean;
  tone?: 'white' | 'soft' | 'dark';
}
const { area, reverse = false, tone = 'white' } = Astro.props;
const dark = tone === 'dark';
const id = `area-${area.slug}`;
---

<SectionPanel tone={tone} labelledby={id}>
  <SplitMedia reverse={reverse}>
    <div slot="media" class="relative">
      <PhotoFrame name={area.photo} position={area.photoPosition} />
      <div class:list={['absolute bottom-5 hidden sm:block', reverse ? 'right-5' : 'left-5']}>
        <slot name="preview" />
      </div>
    </div>
    <SectionHeader
      id={id}
      eyebrow="Support area"
      title={area.title}
      lede={area.summary}
      tone={dark ? 'dark' : 'light'}
    />
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {area.covers.map((c) => (
        <li
          class:list={[
            'flex items-start gap-3 rounded-2xl p-4 text-sm leading-snug',
            dark
              ? 'bg-white/5 text-cream/90 ring-1 ring-white/10'
              : 'bg-cream text-charcoal ring-1 ring-sand',
          ]}
        >
          <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-terracotta" strokeWidth={2} />
          {c}
        </li>
      ))}
    </ul>
    <Actions class="mt-7">
      <ButtonLink href={`/services/${area.slug}`} variant={dark ? 'ghost-dark' : 'secondary'} arrow>
        Explore {area.title.toLowerCase()}
      </ButtonLink>
    </Actions>
  </SplitMedia>
</SectionPanel>
