---
/** Technical education & volunteer training: photo collage beside the training tracks. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import PhotoGrid from '@studio-gamo/ui/components/media/PhotoGrid.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { trainingTracks } from '../../data/production';
interface Props {
  /** Show the "See training opportunities" link (hidden on the training page itself). */
  showLink?: boolean;
}
const { showLink = true } = Astro.props;
---

<Section>
  <Fragment slot="title">
    Train the volunteers. <span class="text-action">Strengthen the team.</span>
  </Fragment>
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <PhotoGrid
        layout="pair"
        photos={[
          { photo: 'techVideoCamera', decorative: true },
          { photo: 'techAudio', decorative: true },
        ]}
      />
    </div>
    <div class="lg:col-span-7">
      <h3 class="text-small font-semibold text-fg">Training tracks we are preparing</h3>
      <ol class="mt-4 divide-y divide-border border-y border-border">
        {trainingTracks.map((t) => (
          <li class="flex flex-wrap items-start gap-x-6 gap-y-3 py-6">
            <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-surface text-action-strong">
              <Icon name={t.icon} />
            </span>
            <div class="min-w-0 flex-1 basis-56">
              <h4 class="text-lg font-semibold text-fg">{t.title}</h4>
              <p class="mt-1 text-small text-fg-muted">{t.topics.join(' · ')}</p>
            </div>
            <p class="text-small text-fg-muted sm:text-end">
              {t.level}
              <br />
              {t.format}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
  {showLink && (
    <ButtonLink href="/training" arrow class="mt-10">
      See training opportunities
    </ButtonLink>
  )}
</Section>
