---
/** Volunteer training: photo, statement and the proposed tracks. Classes are taught through Gamo Academy. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import SectionPanel from './SectionPanel.astro';
import SectionHeader from './SectionHeader.astro';
import SplitMedia from './SplitMedia.astro';
import PhotoFrame from './PhotoFrame.astro';
import Actions from './Actions.astro';
import { trainingTracks } from '../../data/production';
---

<SectionPanel labelledby="training-title">
  <SplitMedia reverse>
    <PhotoFrame slot="media" name="guitarMentor" />
    <SectionHeader
      id="training-title"
      eyebrow="Training"
      title="Train the volunteers."
      lede="Proposed hands-on paths so no church depends on one technical volunteer. Classes are taught through Gamo Academy."
    />
    <Actions class="mt-7">
      <ButtonLink href={siteUrl('academy', '/#production-training')} variant="secondary" arrow>
        Training at Gamo Academy
      </ButtonLink>
    </Actions>
  </SplitMedia>
  <ol class="mt-10 grid gap-4 md:grid-cols-2">
    {trainingTracks.map((t) => (
      <li class="flex gap-4 rounded-2xl bg-cream p-5 ring-1 ring-sand">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-white text-terracotta ring-1 ring-sand">
          <Icon name={t.icon} />
        </span>
        <div class="min-w-0">
          <h3 class="text-base font-semibold text-charcoal">{t.title}</h3>
          <p class="mt-1 text-sm text-ink-soft">{t.topics.join(' · ')}</p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <StatusPill kind="proposal" size="sm">
              {t.format}
            </StatusPill>
            <span class="text-xs font-medium text-ink-soft">{t.level}</span>
          </div>
        </div>
      </li>
    ))}
  </ol>
</SectionPanel>
