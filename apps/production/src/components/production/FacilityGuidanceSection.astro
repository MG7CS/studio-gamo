---
/** Equipment and facility guidance: photo and the keep, repair, replace or wait choices. */
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import SectionPanel from './SectionPanel.astro';
import SectionHeader from './SectionHeader.astro';
import SplitMedia from './SplitMedia.astro';
import PhotoFrame from './PhotoFrame.astro';
import Actions from './Actions.astro';
const choices = [
  { k: 'Keep', v: 'Working well. Document and maintain it.' },
  { k: 'Repair', v: 'Worth fixing before you think about replacing it.' },
  { k: 'Replace', v: 'Failing or unsafe. Plan a fitting replacement.' },
  { k: 'Wait', v: 'Nice to have. Revisit when the budget allows.' },
];
---

<SectionPanel labelledby="facility-title">
  <SplitMedia reverse>
    <PhotoFrame slot="media" name="churchModernDay" />
    <SectionHeader
      id="facility-title"
      eyebrow="Equipment and facilities"
      title="Steward first. Then buy."
      lede="Independent guidance with no vendor ties. Decide what to keep, repair, replace or wait on."
    />
    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      {choices.map((c, i) => (
        <div
          class:list={['rounded-2xl p-5', i === 1 ? 'bg-charcoal text-cream' : 'bg-cream ring-1 ring-sand']}
        >
          <dt class:list={['text-lg font-semibold', i === 1 ? 'text-gold' : 'text-terracotta']}>{c.k}</dt>
          <dd class:list={['mt-1 text-sm', i === 1 ? 'text-cream/80' : 'text-ink-soft']}>{c.v}</dd>
        </div>
      ))}
    </dl>
    <Actions class="mt-7">
      <ButtonLink href="/services/facility-guidance" variant="secondary" arrow>
        Facility guidance details
      </ButtonLink>
    </Actions>
  </SplitMedia>
</SectionPanel>
