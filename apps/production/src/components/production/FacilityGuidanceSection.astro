---
/** Equipment & facility guidance: stewardship decision cards beside a sculptural church photo. */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
const choices = [
  { k: 'Keep', v: 'Working well — document and maintain it.' },
  { k: 'Repair', v: 'Worth fixing before considering replacement.' },
  { k: 'Replace', v: 'Failing or unsafe — plan a fitting replacement.' },
  { k: 'Wait', v: 'Nice to have — revisit when the budget allows.' },
];
---

<SplitHero as="section" spacing="section" mediaSide="start">
  <p class="eyebrow text-action-strong">07 · Equipment & facility guidance</p>
  <h2 class="section-heading text-balance text-fg">Steward what you have before buying what you don’t.</h2>
  <p class="text-lg text-fg-muted">
    Independent guidance with no vendor ties — helping churches decide what to keep, repair, replace or wait
    on.
  </p>
  <FeatureGrid as="ul" min="sm" max={2} class="mt-4 w-full">
    {choices.map((c, i) => (
      <Card as="li" tone={i === 1 ? 'dark' : 'raised'}>
        <h3 class="text-2xl font-semibold text-action">{c.k}</h3>
        <p class="mt-2 text-small text-fg-muted">{c.v}</p>
      </Card>
    ))}
  </FeatureGrid>
  <ButtonLink href="/services/facility-guidance" variant="secondary" arrow class="mt-2">
    Facility guidance details
  </ButtonLink>
  <div slot="media" class="mask-leaf aspect-portrait overflow-hidden">
    <Photo name="churchModernDay" sizes="(min-width:1024px) 45vw, 100vw" class="h-full w-full object-cover" />
  </div>
</SplitHero>
