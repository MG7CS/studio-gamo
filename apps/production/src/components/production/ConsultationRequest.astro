---
/**
 * Consultation request card. Requests go through the Gamo Studios inquiry form, where staff
 * review them; this card only explains what to include and links there.
 */
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { inquiryUrl, providerSignupUrl } from '@studio-gamo/ui/lib/sites';
import Actions from './Actions.astro';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const helpful = [
  'Your church or ministry and city',
  'The area you need help with: audio, livestream, lighting or training',
  'Weekly attendance and the number of technical volunteers',
  'Your current setup and what your team hopes to improve',
];
---

<div class:list={['rounded-[1.75rem] bg-cream p-6 ring-1 ring-sand sm:p-8', className]}>
  <h3 id="consult-request-title" class="text-lg font-semibold text-charcoal">
    Consultation request
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-ink-soft">
    Requests go through the Gamo Studios inquiry form. Our team reviews each one and follows up. It helps to
    include:
  </p>
  <ul class="mt-5 space-y-3 text-sm text-charcoal">
    {helpful.map((item) => (
      <li class="flex gap-3">
        <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-terracotta" />
        <span>{item}</span>
      </li>
    ))}
  </ul>
  <Actions class="mt-7">
    <ButtonLink href={inquiryUrl('Production consultation')} arrow>
      Request a consultation
    </ButtonLink>
  </Actions>
  <p class="mt-5 text-sm text-charcoal">
    Are you a sound, video or livestream technician?{' '}
    <a
      href={providerSignupUrl('production', 'technician')}
      class="inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline underline-offset-4"
    >
      Join the technician team
    </a>
  </p>
</div>
