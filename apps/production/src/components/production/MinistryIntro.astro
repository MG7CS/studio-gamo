---
/** Introduction to technical ministry support: photo, statement and three principles. */
import SectionPanel from './SectionPanel.astro';
import SectionHeader from './SectionHeader.astro';
import SplitMedia from './SplitMedia.astro';
import PhotoFrame from './PhotoFrame.astro';
const principles = [
  {
    k: 'Serve the room',
    v: 'Technology should help people pray, sing and hear the Word. Never distract from it.',
  },
  { k: 'Build people', v: 'Strong volunteer teams matter more than expensive gear.' },
  { k: 'Steward well', v: 'Independent guidance that respects every church budget.' },
];
---

<SectionPanel labelledby="intro-title">
  <SplitMedia reverse>
    <PhotoFrame slot="media" name="sanctuaryCongregation" />
    <SectionHeader
      id="intro-title"
      eyebrow="Why it matters"
      title="The quiet work behind worship."
      lede="Behind every clear sermon is a volunteer who arrived early. Gamo Production is being designed to help those teams with guidance, planning and training."
    />
  </SplitMedia>
  <dl class="mt-10 grid gap-4 md:grid-cols-3">
    {principles.map((p, i) => (
      <div class="rounded-2xl bg-cream p-5 ring-1 ring-sand">
        <dt class="flex items-baseline gap-3 text-base font-semibold text-charcoal">
          <span class="text-xs text-terracotta">0{i + 1}</span>
          {p.k}
        </dt>
        <dd class="mt-2 text-sm leading-relaxed text-ink-soft">{p.v}</dd>
      </div>
    ))}
  </dl>
</SectionPanel>
