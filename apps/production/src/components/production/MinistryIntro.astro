---
/** Introduction to technical ministry support: statement, photo and three principles. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
const principles = [
  {
    k: 'Serve the room',
    v: 'Technology should help people pray, sing and hear the Word — never distract from it.',
  },
  { k: 'Build people', v: 'Strong volunteer teams matter more than expensive equipment.' },
  { k: 'Steward well', v: 'Independent guidance that respects every congregation’s budget.' },
];
---

<Section tone="raised">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 class="section-heading mt-4 text-balance text-fg">
        The quiet work that helps a whole church worship.
      </h2>
      <p class="mt-6 max-w-prose text-lg leading-relaxed text-fg-muted">
        Behind every clear sermon and steady livestream is a volunteer who arrived early. Gamo Production
        comes alongside those teams with practical guidance, training and planning support.
      </p>
    </div>
    <div class="hidden lg:col-span-5 lg:block">
      <Frame
        photo="sanctuaryCongregation"
        ratio="landscape"
        sizes="third"
        alt="Congregation worshipping together in a sunlit sanctuary"
      />
    </div>
  </div>
  <FeatureGrid as="ol" min="md" max={3} gap="lg" class="mt-12 border-t border-border pt-10">
    {principles.map((p, i) => (
      <li>
        <h3 class="flex items-baseline gap-3 text-xl font-semibold text-fg">
          <span class="text-small text-action-strong" aria-hidden="true">
            0{i + 1}
          </span>
          {p.k}
        </h3>
        <p class="mt-3 text-fg-muted">{p.v}</p>
      </li>
    ))}
  </FeatureGrid>
</Section>
