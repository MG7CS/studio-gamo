---
/** Lighting cue-stack preview (illustrative product UI) in the shared FloatingPreviewCard. */
import FloatingPreviewCard from '@studio-gamo/ui/components/content/FloatingPreviewCard.astro';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const cues = [
  { n: '1', label: 'Walk-in · warm wash', on: false },
  { n: '2', label: 'Worship · front light 70%', on: true },
  { n: '3', label: 'Sermon · pulpit focus', on: false },
];
---

<FloatingPreviewCard
  title="Service cues"
  badge={false}
  as="figure"
  class:list={['w-full max-w-xs', className]}
>
  <ul class="space-y-2 text-small">
    {cues.map((c) => (
      <li
        class:list={[
          'flex items-center gap-3 rounded-xl px-3 py-2',
          c.on ? 'bg-action text-on-action' : 'bg-surface text-fg-muted',
        ]}
      >
        <span class="font-mono text-caption">Q{c.n}</span>
        {c.label}
      </li>
    ))}
  </ul>
</FloatingPreviewCard>
