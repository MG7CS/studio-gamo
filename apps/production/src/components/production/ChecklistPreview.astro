---
/** Pre-service stream checklist preview (illustrative product UI) in the shared FloatingPreviewCard. */
import FloatingPreviewCard from '@studio-gamo/ui/components/content/FloatingPreviewCard.astro';
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
const items = [
  'Stream audio mix checked',
  'Cameras framed & white-balanced',
  'Encoder bitrate stable',
  'Lyrics & lower-thirds loaded',
];
---

<FloatingPreviewCard title="Pre-service stream checklist" tone={tone} as="figure" class={className}>
  <ol class="space-y-2.5 text-small">
    {items.map((item, i) => {
      const done = i < items.length - 1;
      return (
        <li class="flex items-center gap-3">
          <span
            class:list={[
              'grid size-6 shrink-0 place-items-center rounded-pill text-caption font-semibold',
              done ? 'bg-action text-on-action' : 'ring-1 ring-border',
            ]}
          >
            {i + 1}
          </span>
          <span class="text-fg-muted">{item}</span>
          {done && <span class="sr-only">(done)</span>}
        </li>
      );
    })}
  </ol>
</FloatingPreviewCard>
