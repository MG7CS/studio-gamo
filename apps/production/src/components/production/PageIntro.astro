---
/**
 * Inner-page opener: the same rounded card as the home hero. With a photo the picture comes
 * first on phones and sits on the right on desktop; without one the card holds the words only.
 */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';
import SectionHeader from './SectionHeader.astro';
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  lede: string;
  photo?: PhotoKey;
  crumb?: { label: string; href: string };
}
const { eyebrow, title, accent, lede, photo, crumb } = Astro.props;
---

<section class="px-4 pt-24 pb-2 sm:px-6 sm:pt-28 sm:pb-3 lg:px-8">
  <div
    class:list={[
      'mx-auto grid max-w-[1320px] overflow-hidden rounded-[2rem] bg-white ring-1 ring-sand',
      photo && 'lg:grid-cols-2',
    ]}
  >
    {photo && (
      <div class="relative aspect-[16/10] lg:order-2 lg:aspect-auto lg:min-h-[460px]">
        <Photo
          name={photo}
          priority
          sizes="(min-width:1024px) 660px, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    )}
    <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-14">
      {crumb && (
        <a
          href={crumb.href}
          class="mb-4 inline-flex min-h-11 items-center self-start text-sm font-medium text-ink-soft underline-offset-4 hover:text-charcoal hover:underline"
        >
          ← {crumb.label}
        </a>
      )}
      <SectionHeader as="h1" size="display" eyebrow={eyebrow} title={title} accent={accent} lede={lede}>
        <slot />
      </SectionHeader>
    </div>
  </div>
</section>
