---
import { REQUEST_HREF } from '../../site.config';
/** Production landing hero: only the content (heading, buttons, photos); the layout is the shared PhotoTrioHero. */
import PhotoTrioHero from '@studio-gamo/ui/components/content/PhotoTrioHero.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<PhotoTrioHero
  id="production-hero-title"
  measure="narrow"
  title="Better Tools."
  accent="Stronger Worship."
  photos={[
    { photo: 'techAudio', alt: 'Sound engineer at a large live mixing console', priority: true },
    { photo: 'techVideoCamera', alt: 'Camcorder filming a church service' },
    { photo: 'techLighting', alt: 'Stage lighting fixtures on a rig' },
  ]}
>
  <Fragment slot="actions">
    <ButtonLink href={REQUEST_HREF} size="lg" arrow>
      Start a needs assessment
    </ButtonLink>
    <ButtonLink href="/services" size="lg" variant="secondary">
      Explore support areas
    </ButtonLink>
  </Fragment>
</PhotoTrioHero>
