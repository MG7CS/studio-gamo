---
import { REQUEST_HREF } from '../../site.config';
/**
 * Production landing hero: the shared SplitHero with the page's <h1> beside an engineer
 * photo and a floating mixer-strip preview.
 */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import MixerStripPreview from './MixerStripPreview.astro';
---

<SplitHero>
  <p class="eyebrow text-action-strong">Gamo Production · Technical ministry</p>
  <h1 class="display-lg text-balance text-fg">
    Better Tools.
    <br />
    <span class="text-action">Stronger Worship.</span>
  </h1>
  <p class="max-w-prose text-lg leading-relaxed text-fg-muted">
    Gamo Production helps churches grow in worship audio, video, lighting and livestreaming — and equips the
    volunteers who serve behind the board every Sunday.
  </p>
  <div class="mt-1 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <ButtonLink href={REQUEST_HREF} arrow>
      Start a needs assessment
    </ButtonLink>
    <ButtonLink href="/services" variant="secondary">
      Explore support areas
    </ButtonLink>
  </div>
  <div slot="media" class="relative pb-10">
    <div class="ms-auto w-full max-w-md">
      <Frame
        photo="soundEngineer"
        ratio="portrait"
        priority
        sizes="half"
        alt="Sound engineer wearing headphones at a digital mixing console during worship"
      />
    </div>
    <MixerStripPreview class="absolute bottom-0 start-2 w-56 md:-start-4" />
  </div>
</SplitHero>
