---
/** Production hero: one rounded card, photo first on phones and on the right on desktop. */
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import EyebrowPill from './EyebrowPill.astro';
import Actions from './Actions.astro';
import MixerStripPreview from './MixerStripPreview.astro';
---

<section class="px-4 pt-24 pb-2 sm:px-6 sm:pt-28 sm:pb-3 lg:px-8" aria-labelledby="prod-hero-title">
  <div class="mx-auto grid max-w-[1320px] overflow-hidden rounded-[2rem] bg-white ring-1 ring-sand lg:grid-cols-2">
    <div class="relative aspect-[4/3] lg:order-2 lg:aspect-auto lg:min-h-[560px]">
      <Photo
        name="soundEngineer"
        priority
        sizes="(min-width:1024px) 660px, 100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <MixerStripPreview class="absolute bottom-5 left-5 hidden w-52 sm:block" />
    </div>
    <div class="flex flex-col justify-center p-6 sm:p-10 lg:p-14">
      <EyebrowPill>Gamo Production · Technical ministry</EyebrowPill>
      <h1 id="prod-hero-title" class="display-xl production-hero-title mt-4 text-charcoal">
        Clear Sound.
        <span class="block text-terracotta">Focused Worship.</span>
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft md:text-lg">
        A proposed program for church sound, video, lighting and livestream teams. Practical help for the
        volunteers behind the board.
      </p>
      <Actions class="mt-7">
        <ButtonLink href={inquiryUrl('Production consultation')} arrow>
          Start a needs assessment
        </ButtonLink>
        <ButtonLink href="/services" variant="secondary">
          See support areas
        </ButtonLink>
      </Actions>
      <StatusPill kind="proposal" class="mt-6 self-start">
        Proposed program
      </StatusPill>
    </div>
  </div>
</section>
