---
/**
 * Consultation interest form (design phase). Never posts: submission navigates
 * to the local confirmation preview with no form data in the URL.
 */
import FormField from '@studio-gamo/ui/components/FormField.astro';
import { supportAreas } from '../../data/production';
interface Props {
  compact?: boolean;
  class?: string;
}
const { compact = false, class: className } = Astro.props;
---

<form
  class:list={['rounded-[2rem] border border-sand bg-white p-6 shadow-float md:p-10', className]}
  data-demo-form
  aria-labelledby="consult-form-title"
  onsubmit="return false"
>
  <h3 id="consult-form-title" class="text-2xl font-semibold text-charcoal">
    Consultation request
  </h3>
  <p class="mt-2 text-sm text-ink-soft">
    Share a few details about your church and technical ministry goals.
  </p>
  <div class="mt-6 grid gap-5 md:grid-cols-2">
    <FormField label="Your name" name="name" autocomplete="name" required />
    <FormField label="Email" name="email" type="email" autocomplete="email" required />
    <FormField label="Church or ministry" name="church" autocomplete="organization" required />
    <FormField label="City & state" name="city" />
    <FormField
      label="Primary area of interest"
      name="area"
      type="select"
      options={supportAreas.map((a) => a.title)}
      class="md:col-span-2"
      required
    />
    {!compact && (
      <FormField
        label="Approximate weekly attendance"
        name="size"
        type="select"
        options={['Under 75', '75–200', '200–500', '500+']}
      />
    )}
    {!compact && (
      <FormField
        label="Technical volunteers"
        name="volunteers"
        type="select"
        options={['None yet', '1–3', '4–10', 'More than 10']}
      />
    )}
    <FormField
      label="What would help most?"
      name="message"
      type="textarea"
      rows={compact ? 3 : 5}
      placeholder="Describe your current setup and what your team is hoping to improve."
      class="md:col-span-2"
    />
  </div>
  <button
    type="submit"
    hidden
    data-preview-submit
    class="mt-8 inline-flex w-full items-center justify-center rounded-full bg-terracotta px-7 py-4 font-medium text-white transition-colors hover:bg-terracotta-dark sm:w-auto"
  >
    Request consultation
  </button>
  <noscript>
    <p class="mt-6 text-sm text-ink-soft">JavaScript is required to submit this consultation form.</p>
  </noscript>
</form>
<script>
  // Prevent any field values from being placed in the URL; go to the preview page only.
  document.querySelectorAll<HTMLFormElement>('form[data-demo-form]').forEach((f) => {
    f.querySelector<HTMLButtonElement>('[data-preview-submit]')!.hidden = false;
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      window.location.href = '/consultation/confirmation';
    });
  });
</script>
