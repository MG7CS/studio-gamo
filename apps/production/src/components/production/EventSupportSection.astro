---
import TitleCase from '@studio-gamo/ui/components/TitleCase.astro';
/** Event production support: dark SplitHero with the advance-planning timeline beside a worship-night photo. */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
const phases = [
  {
    when: '8 weeks out',
    what: 'Vision & scope',
    detail: 'Clarify the gathering, room and expected attendance.',
  },
  {
    when: '4 weeks out',
    what: 'Stage plot & input list',
    detail: 'Map instruments, microphones and staffing needs.',
  },
  { when: 'Event week', what: 'Rehearsal & run-of-show', detail: 'Time changeovers and confirm every cue.' },
  { when: 'After', what: 'Debrief', detail: 'Capture lessons for the next event.' },
];
---

<SplitHero as="section" spacing="section" tone="dark">
  <h2 class="section-heading text-balance text-fg">
    <TitleCase>Christmas, Easter and worship nights — planned calmly.</TitleCase>
  </h2>
  <ol class="mt-4 border-s border-border ps-6">
    {phases.map((p) => (
      <li class="relative pb-8 last:pb-0">
        <span
          class="absolute -start-7.5 top-1 size-3 rounded-pill bg-action ring-4 ring-surface"
          aria-hidden="true"
        />
        <p class="text-caption font-semibold tracking-eyebrow uppercase text-action-strong">{p.when}</p>
        <h3 class="mt-1 text-lg font-semibold">{p.what}</h3>
        <p class="mt-1 text-small text-fg-muted">{p.detail}</p>
      </li>
    ))}
  </ol>
  <ButtonLink href="/services/event-support" variant="ghost-dark" arrow class="mt-2">
    Event support details
  </ButtonLink>
  <div slot="media">
    <Frame photo="techLighting" ratio="portrait" sizes="half" alt="Stage lighting fixtures on a rig" />
  </div>
</SplitHero>
