---
/** Event production support: dark panel with the photo and a four-step advance plan. */
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import SectionPanel from './SectionPanel.astro';
import SectionHeader from './SectionHeader.astro';
import SplitMedia from './SplitMedia.astro';
import PhotoFrame from './PhotoFrame.astro';
import Actions from './Actions.astro';
const phases = [
  {
    when: '8 weeks out',
    what: 'Vision and scope',
    detail: 'Clarify the gathering, the room and expected attendance.',
  },
  {
    when: '4 weeks out',
    what: 'Stage plot and input list',
    detail: 'Map instruments, microphones and staffing needs.',
  },
  {
    when: 'Event week',
    what: 'Rehearsal and run-of-show',
    detail: 'Time changeovers and confirm every cue.',
  },
  { when: 'After', what: 'Debrief', detail: 'Capture lessons for the next event.' },
];
---

<SectionPanel tone="dark" labelledby="events-title">
  <SplitMedia>
    <PhotoFrame slot="media" name="worshipNight" />
    <SectionHeader
      id="events-title"
      tone="dark"
      eyebrow="Event support"
      title="Big services, planned calmly."
      lede="Planning help for Christmas, Easter, worship nights and conferences, so the team is ready long before the doors open."
    />
    <ol class="mt-8 border-l border-white/20 pl-6">
      {phases.map((p) => (
        <li class="relative pb-6 last:pb-0">
          <span class="absolute -left-[31px] top-1 h-3 w-3 rounded-full bg-terracotta ring-4 ring-night"></span>
          <p class="text-xs font-semibold uppercase tracking-wider text-gold">{p.when}</p>
          <h3 class="mt-1 text-base font-semibold">{p.what}</h3>
          <p class="mt-1 text-sm text-cream/70">{p.detail}</p>
        </li>
      ))}
    </ol>
    <Actions class="mt-8">
      <ButtonLink href="/services/event-support" variant="ghost-dark" arrow>
        Event support details
      </ButtonLink>
    </Actions>
  </SplitMedia>
</SectionPanel>
