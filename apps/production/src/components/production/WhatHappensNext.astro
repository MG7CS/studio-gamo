---
/**
 * "What happens next" steps under a form placeholder page, aligned with the shared FormComingSoon
 * column (prose width, content-box) so both read as one column.
 */
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import NumberedSteps, { type Step } from '@studio-gamo/ui/components/content/NumberedSteps.astro';
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<section class="pb-20 text-fg" aria-labelledby="next-steps-title">
  <Container width="prose" class="box-content">
    <h2 id="next-steps-title" class="section-subheading text-balance">
      What happens next
    </h2>
    <NumberedSteps items={steps} class="mt-8" />
  </Container>
</section>
