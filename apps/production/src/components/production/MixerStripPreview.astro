---
/**
 * Mixer channel-strip preview (illustrative product UI over photography). The frame is the shared
 * FloatingPreviewCard (without a badge); the channel levels are data-driven, so each bar's
 * height stays an inline percentage.
 */
import FloatingPreviewCard from '@studio-gamo/ui/components/content/FloatingPreviewCard.astro';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const channels = [
  { name: 'Lead Vox', level: 78 },
  { name: 'Keys', level: 58 },
  { name: 'Ac Gtr', level: 64 },
  { name: 'Pastor', level: 84 },
];
---

<FloatingPreviewCard title="Worship mix" badge={false} as="figure" class={className}>
  <div class="grid grid-cols-4 gap-3" aria-hidden="true">
    {channels.map((c) => (
      <div class="flex flex-col items-center gap-2">
        <div class="relative h-24 w-2 rounded-pill bg-surface-inset">
          <div class="absolute bottom-0 w-2 rounded-pill bg-action" style={`height:${c.level}%`} />
        </div>
        <span class="text-center text-caption font-medium">{c.name}</span>
      </div>
    ))}
  </div>
</FloatingPreviewCard>
