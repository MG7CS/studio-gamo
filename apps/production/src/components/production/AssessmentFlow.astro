---
/**
 * Church needs assessment — multi-step, local-only navigation.
 * All steps render server-side (works without JS: all visible); JS shows one step at a time.
 * Nothing is saved or sent.
 */
import FormField from '@studio-gamo/ui/components/FormField.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { assessmentSteps, supportAreas } from '../../data/production';
const chip = 'flex cursor-pointer items-center gap-3 rounded-2xl border border-sand bg-white px-4 py-3 text-sm font-medium text-charcoal has-[:checked]:border-terracotta has-[:checked]:bg-terracotta/5';
---
<section class="bg-ivory py-12 md:py-20" aria-label="Needs assessment">
  <div class="mx-auto max-w-4xl px-5 md:px-8">
    <ol class="flex gap-2 overflow-x-auto pb-2" aria-label="Assessment progress" data-progress>
      {assessmentSteps.map((s, i) => (
        <li class="flex shrink-0 items-center gap-2 rounded-full bg-white px-3 py-2 text-xs font-medium text-ink-soft ring-1 ring-sand data-[state=current]:bg-charcoal data-[state=current]:text-cream data-[state=done]:text-terracotta" data-state={i === 0 ? 'current' : 'todo'}>
          <span class="grid h-5 w-5 place-items-center rounded-full bg-cream text-[10px] text-charcoal">{i + 1}</span>{s.label}
        </li>
      ))}
    </ol>
    <form class="mt-6 rounded-[2rem] border border-sand bg-white p-6 shadow-float md:p-10" data-assessment onsubmit="return false">
      <fieldset data-step="0" class="space-y-5">
        <legend class="section-subheading text-charcoal">Tell us about your church</legend>
        <div class="grid gap-5 md:grid-cols-2">
          <FormField label="Church or ministry name" name="church" required />
          <FormField label="City & state" name="city" required />
          <FormField label="Weekly attendance" name="size" type="select" options={['Under 75', '75–200', '200–500', '500+']} />
          <FormField label="Services each week" name="services" type="select" options={['1', '2', '3 or more']} />
        </div>
      </fieldset>
      <fieldset data-step="1" class="space-y-5">
        <legend class="section-subheading text-charcoal">What is in place today?</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          {['Sound system & mixer', 'Livestream cameras', 'Stage lighting', 'Projection / screens', 'Recording setup', 'Not sure what we have'].map((o) => (
            <label class={chip}><input type="checkbox" name="setup" value={o} class="accent-terracotta" />{o}</label>
          ))}
        </div>
        <FormField label="Anything frustrating about your current setup?" name="frustrations" type="textarea" rows={3} />
      </fieldset>
      <fieldset data-step="2" class="space-y-5">
        <legend class="section-subheading text-charcoal">Which areas matter most?</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          {supportAreas.map((a) => (
            <label class={chip}><input type="checkbox" name="priority" value={a.slug} class="accent-terracotta" /><Icon name={a.icon} class="h-4 w-4 text-terracotta" />{a.title}</label>
          ))}
        </div>
      </fieldset>
      <fieldset data-step="3" class="space-y-5">
        <legend class="section-subheading text-charcoal">Your team & timing</legend>
        <div class="grid gap-5 md:grid-cols-2">
          <FormField label="Technical volunteers" name="volunteers" type="select" options={['None yet', '1–3', '4–10', 'More than 10']} />
          <FormField label="Timeline" name="timeline" type="select" options={['Exploring', 'Next 3 months', 'Before a specific event']} />
        </div>
      </fieldset>
      <fieldset data-step="4" class="space-y-4">
        <legend class="section-subheading text-charcoal">Review</legend>
        <p class="text-ink-soft">Review your assessment summary below. Use Back to make changes, or continue to request a follow-up consultation with our technical ministry team.</p>
        <dl data-review class="space-y-4 rounded-2xl bg-cream p-5"></dl>
        <noscript><p class="text-sm text-ink-soft">JavaScript enables the step-by-step review. You can still review and edit every answer above.</p></noscript>
        <a href="/consultation" class="inline-flex items-center gap-2 font-medium text-terracotta underline-offset-4 hover:underline">Continue to consultation request <Icon name="arrow" class="h-4 w-4" /></a>
      </fieldset>
      <div class="mt-10 flex items-center justify-between gap-4 border-t border-sand pt-6" data-nav hidden>
        <button type="button" data-prev class="inline-flex items-center gap-2 rounded-full border border-sand px-5 py-3 text-sm font-medium text-charcoal disabled:opacity-40"><Icon name="arrow-left" class="h-4 w-4" />Back</button>
        <p class="text-sm text-ink-soft" aria-live="polite" data-status></p>
        <button type="button" data-next class="inline-flex items-center gap-2 rounded-full bg-terracotta px-5 py-3 text-sm font-medium text-white disabled:opacity-40">Next<Icon name="arrow" class="h-4 w-4" /></button>
      </div>
    </form>
  </div>
</section>
<script>
  import { supportAreas } from '../../data/production';
  const form = document.querySelector<HTMLFormElement>('[data-assessment]');
  if (form) {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const pills = [...document.querySelectorAll<HTMLElement>('[data-progress] li')];
    const nav = form.querySelector<HTMLElement>('[data-nav]')!;
    const prev = form.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    let i = 0;
    const show = (focus = false) => {
      steps.forEach((s, n) => (s.hidden = n !== i));
      pills.forEach((p, n) => {
        p.dataset.state = n === i ? 'current' : n < i ? 'done' : 'todo';
        if (n === i) p.setAttribute('aria-current', 'step'); else p.removeAttribute('aria-current');
      });
      prev.disabled = i === 0;
      next.hidden = i === steps.length - 1;
      status.textContent = `Step ${i + 1} of ${steps.length}`;
      if (i === steps.length - 1) {
        const review = form.querySelector<HTMLElement>('[data-review]')!;
        review.replaceChildren();
        const answers = new FormData(form);
        const groups: [string, string][] = [['Church or ministry', 'church'], ['City & state', 'city'], ['Weekly attendance', 'size'], ['Services each week', 'services'], ['Current setup', 'setup'], ['Current challenges', 'frustrations'], ['Priorities', 'priority'], ['Technical volunteers', 'volunteers'], ['Timeline', 'timeline']];
        groups.forEach(([label, key]) => {
          const row = document.createElement('div');
          const term = document.createElement('dt');
          const detail = document.createElement('dd');
          term.className = 'text-sm font-semibold text-charcoal';
          detail.className = 'mt-1 break-words text-sm text-ink-soft';
          term.textContent = label;
          detail.textContent = answers.getAll(key).map((v) => key === 'priority' ? supportAreas.find((a) => a.slug === v)?.title ?? String(v) : String(v)).filter(Boolean).join(', ') || 'Not specified';
          row.append(term, detail);
          review.append(row);
        });
      }
      if (focus) {
        const legend = steps[i].querySelector<HTMLElement>('legend');
        legend?.setAttribute('tabindex', '-1');
        legend?.focus();
      }
    };
    nav.hidden = false;
    prev.addEventListener('click', () => { i = Math.max(0, i - 1); show(true); });
    next.addEventListener('click', () => {
      const controls = [...steps[i].querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')];
      if (controls.some((control) => !control.reportValidity())) return;
      i = Math.min(steps.length - 1, i + 1); show(true);
    });
    show();
  }
</script>
