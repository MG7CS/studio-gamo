---
/** Services overview: one compact card per support area, picture first. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import SectionPanel from './SectionPanel.astro';
import { supportAreas } from '../../data/production';
---

<SectionPanel label="Support areas">
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {supportAreas.map((a, i) => (
      <li>
        <a
          href={`/services/${a.slug}`}
          class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] bg-cream ring-1 ring-sand transition-colors hover:bg-white"
        >
          <div class="aspect-[16/10] overflow-hidden bg-sand">
            <Photo
              name={a.photo}
              position={a.photoPosition}
              sizes="(min-width:1024px) 400px, (min-width:640px) 50vw, 100vw"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <p class="text-xs font-semibold text-terracotta">0{i + 1}</p>
            <h2 class="mt-1 text-lg font-semibold text-charcoal">{a.title}</h2>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{a.short}</p>
            <span class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-terracotta-deep">
              View details <Icon name="arrow" class="h-4 w-4" />
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</SectionPanel>
