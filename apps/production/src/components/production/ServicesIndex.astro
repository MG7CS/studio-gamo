---
/** Support-area index: one MediaCard per area in the shared FeatureGrid. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import MediaCard from '@studio-gamo/ui/components/content/MediaCard.astro';
import { supportAreas } from '../../data/production';
---

<Section tone="raised">
  <FeatureGrid as="ul" min="md" max={3} gap="lg">
    {supportAreas.map((a, i) => (
      <MediaCard
        as="li"
        href={`/services/${a.slug}`}
        title={a.title}
        headingLevel="h2"
        image={{
          name: a.photo,
          sizes: '(min-width:1024px) 30vw, (min-width:640px) 50vw, 100vw',
          position: a.photoPosition,
        }}
      >
        <p slot="eyebrow" class="eyebrow text-action-strong">
          {String(i + 1).padStart(2, '0')}
        </p>
        {a.short}
      </MediaCard>
    ))}
  </FeatureGrid>
</Section>
