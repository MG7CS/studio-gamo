---
/** Support-area index: one MediaCard per area in the shared FeatureGrid. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import MediaCardGrid from '@studio-gamo/ui/components/content/MediaCardGrid.astro';
import { supportAreas } from '../../data/production';
---

<Section tone="raised">
  <MediaCardGrid
    min="md"
    max={3}
    gap="lg"
    headingLevel="h2"
    items={supportAreas.map((a) => ({
      href: `/services/${a.slug}`,
      title: a.title,
      image: { name: a.photo, sizes: 'third' },
    }))}
  />
</Section>
