---
/** Consultation interest: photo, short invitation and the request card. */
import SectionPanel from './SectionPanel.astro';
import SectionHeader from './SectionHeader.astro';
import SplitMedia from './SplitMedia.astro';
import PhotoFrame from './PhotoFrame.astro';
import ConsultationRequest from './ConsultationRequest.astro';
---

<SectionPanel id="consultation" labelledby="consult-title">
  <SplitMedia align="start">
    <div slot="media">
      <PhotoFrame name="chapelSpring" />
      <SectionHeader
        id="consult-title"
        eyebrow="Consultation"
        title="Tell us what you are facing."
        lede="Share your goals, technical challenges or training needs. Our team follows up to plan next steps."
        class="mt-8"
      />
    </div>
    <ConsultationRequest />
  </SplitMedia>
</SectionPanel>
