---
import TitleCase from '@studio-gamo/ui/components/TitleCase.astro';
/** Consultation band on the landing page: invitation copy beside the consultation request card. */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import ConsultationRequest from './ConsultationRequest.astro';
---

<SplitHero as="section" spacing="section">
  <h2 class="section-heading text-balance text-fg">
    <TitleCase>Tell us what your team is facing.</TitleCase>
  </h2>
  <div class="mt-5 hidden w-full max-w-sm lg:block">
    <Frame
      photo="chapelSpring"
      ratio="square"
      sizes="third"
      alt="White chapel with a steeple surrounded by spring trees"
    />
  </div>
  <ConsultationRequest slot="media" />
</SplitHero>
