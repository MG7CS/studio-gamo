---
/** Section 9 — consultation interest band on the homepage. */
import ConsultationForm from './ConsultationForm.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
---
<section id="consultation" class="bg-ivory section-space" aria-labelledby="consult-title" data-reveal>
  <div class="mx-auto grid max-w-7xl gap-12 px-5 md:px-8 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow text-terracotta">09 · Consultation interest</p>
      <h2 id="consult-title" class="section-heading mt-4 text-charcoal">Tell us what your team is facing.</h2>
      <p class="mt-5 text-lg text-ink-soft">When Gamo Production launches, interest like this will help shape which churches and needs are served first. For now it is a design preview.</p>
      <div class="mask-pebble mt-10 hidden aspect-square max-w-sm overflow-hidden lg:block">
        <Photo name="chapelSpring" sizes="(min-width:1024px) 28vw, 0px" class="h-full w-full object-cover" />
      </div>
    </div>
    <div class="lg:col-span-7"><ConsultationForm compact /></div>
  </div>
</section>
