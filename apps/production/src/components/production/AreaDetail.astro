---
/** Detail body for one support area: what it covers, questions to think through, skills to build. */
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import SectionPanel from './SectionPanel.astro';
import SectionHeader from './SectionHeader.astro';
import Actions from './Actions.astro';
import ChecklistPreview from './ChecklistPreview.astro';
import type { SupportArea } from '../../data/production';
interface Props {
  area: SupportArea;
}
const { area } = Astro.props;
---

<SectionPanel labelledby="covers-title">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-7">
      <SectionHeader id="covers-title" eyebrow="What it covers" title="Where support begins." size="sub" />
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {area.covers.map((c) => (
          <li class="flex items-start gap-3 rounded-2xl bg-cream p-4 ring-1 ring-sand">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-white text-terracotta ring-1 ring-sand">
              <Icon name={area.icon} class="h-4 w-4" />
            </span>
            <span class="text-sm font-medium leading-snug text-charcoal">{c}</span>
          </li>
        ))}
      </ul>
      <SectionHeader eyebrow="Before we talk" title="Questions to consider first." size="sub" class="mt-12" />
      <ol class="mt-5 divide-y divide-sand border-y border-sand">
        {area.questions.map((q, i) => (
          <li class="flex gap-4 py-4 text-base text-ink-soft">
            <span class="font-semibold text-terracotta">{i + 1}.</span>
            {q}
          </li>
        ))}
      </ol>
    </div>
    <aside class="lg:col-span-5">
      <div class="space-y-4 lg:sticky lg:top-28">
        <ChecklistPreview title="Volunteer skills to build" items={area.volunteerSkills} badge="Skills" />
        <div class="rounded-[1.75rem] bg-charcoal p-6 text-cream" data-surface="dark">
          <p class="text-base font-semibold">Thinking about {area.title.toLowerCase()}?</p>
          <p class="mt-2 text-sm text-cream/75">
            A needs assessment walks through your setup, priorities and team.
          </p>
          <Actions class="mt-5">
            <ButtonLink href={inquiryUrl('Production consultation')} arrow>
              Start assessment
            </ButtonLink>
          </Actions>
        </div>
      </div>
    </aside>
  </div>
</SectionPanel>
