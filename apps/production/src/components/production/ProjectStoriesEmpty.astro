---
/** Honest empty state for project stories: no real projects exist yet, so none are shown. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import SectionPanel from './SectionPanel.astro';
import SectionHeader from './SectionHeader.astro';
---

<SectionPanel tone="soft" labelledby="stories-title">
  <div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
    <SectionHeader
      id="stories-title"
      eyebrow="Project stories"
      title="Stories, once they happen."
      lede="Gamo Production has not completed any church projects yet. We will not show invented case studies or results."
    />
    <div class="rounded-[1.75rem] border-2 border-dashed border-sand bg-white p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-cream text-terracotta ring-1 ring-sand">
          <Icon name="book" />
        </span>
        <div>
          <p class="text-base font-semibold text-charcoal">
            Project stories will appear here once real work is documented.
          </p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            Each story is shared with the church's permission and describes what was actually done: the needs,
            the training and what volunteers learned.
          </p>
          <StatusPill kind="info" class="mt-4">
            No projects documented yet
          </StatusPill>
        </div>
      </div>
    </div>
  </div>
</SectionPanel>
