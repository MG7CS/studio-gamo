---
/** Section 8 — honest empty state for project stories (no real projects exist yet). */
import Icon from '@studio-gamo/ui/components/Icon.astro';
---

<section class="bg-cream section-space" aria-labelledby="stories-title" data-reveal>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <p class="eyebrow text-terracotta">08 · Project stories</p>
        <h2 id="stories-title" class="section-heading mt-4 text-charcoal">
          Stories will be told honestly — once they happen.
        </h2>
        <p class="mt-5 text-lg text-ink-soft">
          Gamo Production has not completed any church projects yet. We will not show invented case studies or
          before-and-after results.
        </p>
      </div>
      <div class="lg:col-span-7">
        <div class="relative rounded-[2.5rem] border-2 border-dashed border-sand bg-ivory p-8 md:p-12">
          <div class="flex items-start gap-4">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white text-terracotta shadow-float">
              <Icon name="book" />
            </span>
            <div>
              <p class="text-xl font-semibold text-charcoal">
                Project stories will appear here once real work is documented.
              </p>
              <p class="mt-3 text-ink-soft">
                Each story will be shared only with the church’s permission and will describe what was
                actually done — the needs, the training and what volunteers learned.
              </p>
            </div>
          </div>
          <div class="mt-8 grid gap-3 sm:grid-cols-3" aria-hidden="true">
            {[0, 1, 2].map(() => (
              <div class="h-24 rounded-2xl bg-white/70 ring-1 ring-sand"></div>
            ))}
          </div>
          <p class="mt-4 text-xs font-medium uppercase tracking-wider text-ink-soft">
            Empty state · no projects documented
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
