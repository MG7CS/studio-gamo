---
import TitleCase from '@studio-gamo/ui/components/TitleCase.astro';
/** Honest empty state for project stories (no real projects exist yet). */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
---

<Section>
  <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-5">
      <h2 class="section-heading mt-4 text-balance text-fg">
        <TitleCase>Stories will be told honestly — once they happen.</TitleCase>
      </h2>
      <p class="mt-5 text-lg text-fg-muted">
        Gamo Production has not completed any church projects yet. We will not show invented case studies or
        before-and-after results.
      </p>
    </div>
    <div class="lg:col-span-7">
      <div class="flex items-start gap-4 rounded-hero border-2 border-dashed border-border bg-surface-raised p-8 md:p-12">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-surface text-action-strong shadow-raised">
          <Icon name="book" />
        </span>
        <div>
          <p class="text-xl font-semibold text-fg">
            Project stories will appear here once real work is documented.
          </p>
          <p class="mt-3 text-fg-muted">
            Each story will be shared only with the church’s permission and will describe what was actually
            done — the needs, the training and what volunteers learned.
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>
