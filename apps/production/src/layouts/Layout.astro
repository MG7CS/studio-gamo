import '../app.css';
import ProgramLayout, {
  type Props as ProgramLayoutProps,
} from '@studio-gamo/ui/components/ProgramLayout.astro';

type Props = Omit<ProgramLayoutProps, 'program'>;
---

<ProgramLayout program="production" {...Astro.props}>
  <slot name="head" slot="head" />
  <slot />
</ProgramLayout>
