---
/** Gamo Production layout: shared document shell + app stylesheet. Pages pass a page title. */
import '../app.css';
import BaseLayout from '@studio-gamo/ui/components/BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  headerTheme?: 'light' | 'dark';
  bodyClass?: string;
  chrome?: boolean;
}
const { title, description, headerTheme = 'dark', bodyClass = 'bg-cream text-charcoal', chrome = true } = Astro.props;
---
<BaseLayout title={title ? `${title} | Gamo Production` : 'Gamo Production | Gamo Studios'} description={description} current="production" headerTheme={headerTheme} bodyClass={bodyClass} chrome={chrome}>
  <slot />
</BaseLayout>
