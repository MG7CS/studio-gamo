---
import Layout from '../layouts/Layout.astro';
import FormComingSoon from '@studio-gamo/ui/components/forms/FormComingSoon.astro';
---

<Layout
  title="Request a Consultation"
  description="Churches can request a Gamo Production consultation for worship audio, video, lighting, livestreaming and volunteer training."
>
  <FormComingSoon
    eyebrow="Gamo Production · churches"
    title="Request a consultation"
    intro="Tell us about your church, your current setup and what your technical team hopes to improve. Our team reviews every request and follows up."
    email="hello@gamostudio.org"
  />
</Layout>
