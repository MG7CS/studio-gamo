---
import Layout from '../layouts/Layout.astro';
import ProductionHero from '../components/production/ProductionHero.astro';
import MinistryIntro from '../components/production/MinistryIntro.astro';
import SupportAreaFeature from '../components/production/SupportAreaFeature.astro';
import MixerStripPreview from '../components/production/MixerStripPreview.astro';
import ChecklistPreview from '../components/production/ChecklistPreview.astro';
import CueStackPreview from '../components/production/CueStackPreview.astro';
import TrainingSection from '../components/production/TrainingSection.astro';
import EventSupportSection from '../components/production/EventSupportSection.astro';
import FacilityGuidanceSection from '../components/production/FacilityGuidanceSection.astro';
import ProjectStoriesEmpty from '../components/production/ProjectStoriesEmpty.astro';
import ConsultationSection from '../components/production/ConsultationSection.astro';
import { getArea } from '../data/production';
const audio = getArea('audio')!;
const stream = getArea('livestream-video')!;
const lighting = getArea('lighting-media')!;
---

<Layout
  title="Technical Ministry Support"
  description="A proposed Gamo Production program helping churches with worship audio, video, lighting and livestreaming, and the volunteers behind the board."
  headerTheme="light"
>
  <ProductionHero />
  <MinistryIntro />
  <SupportAreaFeature area={{ ...audio, photo: 'worshipBand' }}>
    <MixerStripPreview slot="preview" class="w-56" />
  </SupportAreaFeature>
  <SupportAreaFeature area={stream} reverse tone="dark">
    <ChecklistPreview slot="preview" tone="dark" class="w-64 bg-night/90 backdrop-blur" />
  </SupportAreaFeature>
  <SupportAreaFeature area={lighting}>
    <CueStackPreview slot="preview" class="w-64" />
  </SupportAreaFeature>
  <TrainingSection />
  <EventSupportSection />
  <FacilityGuidanceSection />
  <ProjectStoriesEmpty />
  <ConsultationSection />
</Layout>
