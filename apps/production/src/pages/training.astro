---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/production/PageIntro.astro';
import TrainingSection from '../components/production/TrainingSection.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
---

<Layout
  title="Training Opportunities"
  description="Proposed hands-on training paths in sound, livestream, lighting and team leadership so no church depends on a single technical volunteer."
  headerTheme="light"
>
  <PageIntro
    eyebrow="Training opportunities"
    title="Equip every"
    accent="volunteer who serves."
    lede="Hands-on training paths for sound, livestream, lighting and team leadership."
    photo="guitarMentor"
  >
    <StatusPill kind="proposal" class="mt-6">
      Volunteer training tracks
    </StatusPill>
  </PageIntro>
  <TrainingSection />
  <CtaInvitation
    eyebrow="Interested in training?"
    title="Let us know what your team needs."
    body="Share your church's training goals through a consultation request."
    photo="worshipBand"
  >
    <ButtonLink href="/consultation" arrow>
      Share training interest
    </ButtonLink>
  </CtaInvitation>
</Layout>
