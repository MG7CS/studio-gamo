---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/production/PageIntro.astro';
import TrainingSection from '../components/production/TrainingSection.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from "@studio-gamo/ui/components/ButtonLink.astro";
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
---
<Layout title="Training Opportunities" description="Proposed volunteer technical training paths for church sound, livestream, lighting and team leaders." headerTheme="light">
  <PageIntro eyebrow="Training opportunities" title="Equip every" accent="volunteer who serves." lede="Proposed hands-on training paths for sound, livestream, lighting and team leadership. No sessions are scheduled yet; formats and any contributions are proposals." photo="guitarMentor">
    <StatusPill kind="proposal" class="mt-6">No sessions scheduled yet</StatusPill>
  </PageIntro>
  <TrainingSection />
  <CtaInvitation eyebrow="Interested in training?" title="Let us know what your team needs." body="Share interest through the consultation preview. Nothing is sent during the design phase." photo="worshipBand">
    <ButtonLink href="/consultation" arrow>Share training interest</ButtonLink>
  </CtaInvitation>
</Layout>
