---
import { REQUEST_HREF } from '../site.config';
import Layout from '../layouts/Layout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import TrainingSection from '../components/production/TrainingSection.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<Layout
  title="Training Opportunities"
  description="Hands-on training paths in sound, livestream, lighting and team leadership so no church depends on a single technical volunteer."
  headerTheme="light"
>
  <PageHero>
    <Fragment slot="title">
      Equip every <span class="text-action">volunteer who serves.</span>
    </Fragment>
    <p slot="intro">Hands-on training paths for sound, livestream, lighting and team leadership.</p>
    <div slot="media">
      <Frame
        photo="guitarMentor"
        ratio="landscape"
        priority
        sizes="half"
        alt="Guitar instructor guiding a young student through a chord"
      />
    </div>
  </PageHero>
  <TrainingSection showLink={false} />
  <CtaInvitation
    title="Let us know what your team needs."
    body="Share your church's training goals through a consultation request."
    photo="worshipBand"
  >
    <ButtonLink href={REQUEST_HREF} arrow>
      Share training interest
    </ButtonLink>
  </CtaInvitation>
</Layout>
