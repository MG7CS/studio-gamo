---
import { REQUEST_HREF } from '../../site.config';
import Layout from '../../layouts/Layout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import ServicesIndex from '../../components/production/ServicesIndex.astro';
import FaqAccordion from '@studio-gamo/ui/components/FaqAccordion.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { productionFaq } from '../../data/production';
---

<Layout
  title="Support Areas"
  description="Seven ways Gamo Production supports churches: audio, livestream and video, lighting, training, event support, software and facility guidance."
  headerTheme="light"
>
  <PageHero>
    <Fragment slot="title">
      Seven ways to support <span class="text-action">church ministry.</span>
    </Fragment>
  </PageHero>
  <ServicesIndex />
  <Section title="Questions" width="narrow">
    <FaqAccordion items={productionFaq} />
  </Section>
  <CtaInvitation title="Start with a needs assessment." photo="techSlides">
    <ButtonLink href={REQUEST_HREF} arrow>
      Request a consultation
    </ButtonLink>
  </CtaInvitation>
</Layout>
