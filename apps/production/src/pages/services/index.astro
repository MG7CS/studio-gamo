---
import { REQUEST_HREF } from '../../site.config';
import Layout from '../../layouts/Layout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import ServicesIndex from '../../components/production/ServicesIndex.astro';
import FaqAccordion from '@studio-gamo/ui/components/FaqAccordion.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { productionFaq } from '../../data/production';
---

<Layout
  title="Support Areas"
  description="Six ways Gamo Production supports technical ministry: audio, livestream and video, lighting, training, event support and facility guidance."
  headerTheme="light"
>
  <PageHero eyebrow="Service overview">
    <Fragment slot="title">
      Six ways to support <span class="text-action">technical ministry.</span>
    </Fragment>
    <p slot="intro">
      Support for churches and their volunteer teams, designed around people first and equipment second.
    </p>
  </PageHero>
  <ServicesIndex />
  <Section title="Questions" width="narrow">
    <FaqAccordion items={productionFaq} />
  </Section>
  <CtaInvitation
    eyebrow="Not sure where to begin?"
    title="Start with a needs assessment."
    body="A short walk-through of your church, current setup, priorities and volunteer team."
    photo="sanctuaryCongregation"
  >
    <ButtonLink href={REQUEST_HREF} arrow>
      Request a consultation
    </ButtonLink>
  </CtaInvitation>
</Layout>
