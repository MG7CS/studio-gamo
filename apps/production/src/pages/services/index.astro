---
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/production/PageIntro.astro';
import ServicesIndex from '../../components/production/ServicesIndex.astro';
import SectionPanel from '../../components/production/SectionPanel.astro';
import SectionHeader from '../../components/production/SectionHeader.astro';
import ClosingInvite from '../../components/production/ClosingInvite.astro';
import FaqAccordion from '@gamo/site/components/FaqAccordion.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { productionFaq } from '../../data/production';
---

<Layout
  title="Support Areas"
  description="How Gamo Production proposes to support technical ministry: audio, livestream and video, lighting, training, event support and facility guidance."
  headerTheme="light"
>
  <PageIntro
    eyebrow="Support areas"
    title="Support for"
    accent="technical ministry."
    lede="Proposed support for churches and their volunteer teams. People first, equipment second."
    photo="churchGoldenHour"
  />
  <ServicesIndex />
  <SectionPanel labelledby="faq-title">
    <SectionHeader id="faq-title" eyebrow="Questions" title="Good to know." size="sub" />
    <FaqAccordion items={productionFaq} class="mt-6" />
  </SectionPanel>
  <ClosingInvite
    eyebrow="Not sure where to begin?"
    title="Start with a needs assessment."
    body="A short walk-through of your church, current setup, priorities and volunteer team."
    photo="sanctuaryCongregation"
  >
    <ButtonLink href={inquiryUrl('Production consultation')} arrow>
      Start assessment
    </ButtonLink>
  </ClosingInvite>
</Layout>
