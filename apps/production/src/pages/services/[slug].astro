---
import { clampDescription } from '@studio-gamo/ui/lib/seo';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/production/PageIntro.astro';
import AreaDetail from '../../components/production/AreaDetail.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { supportAreas, type SupportArea } from '../../data/production';

// Rendered on demand (not prerendered) so the page gets the same security and cache headers
// as every other HTML response; unknown slugs render the branded 404 page.
const found = supportAreas.find((item) => item.slug === Astro.params.slug);
if (!found) return Astro.rewrite('/404');
const area: SupportArea = found;
---

<Layout title={area.title} description={clampDescription(area.summary)} headerTheme="light">
  <PageIntro
    eyebrow="Technical support category"
    title={area.title}
    lede={area.summary}
    photo={area.photo}
    crumb={{ label: 'All support areas', href: '/services' }}
  >
    <StatusPill kind="proposal" class="mt-6">
      Technical ministry support
    </StatusPill>
  </PageIntro>
  <AreaDetail area={area} />
</Layout>
