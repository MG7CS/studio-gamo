---
import Layout from '../../layouts/Layout.astro';
import GamoAuthExperience from '@studio-gamo/ui/components/auth/GamoAuthExperience.astro';
import { termsConsentDocuments } from '@studio-gamo/ui/lib/terms-links';
import { signupScreenOptions } from '@gamo/domain';

const options = signupScreenOptions('production');
---

<Layout
  title="Create Your Gamo Production Account"
  description="Create a verified Gamo Production account to request technical assessments, sound, livestream, and training support."
  chrome={false}
>
  <GamoAuthExperience
    mode="signup"
    program="Gamo Production"
    signupRoles={options.roles}
    selectedRole={Astro.url.searchParams.get('role')}
    termsDocuments={termsConsentDocuments(options.terms)}
  />
</Layout>
