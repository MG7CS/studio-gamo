---
/** Demo-only client filters for the lesson list. Filters operate on data-* attributes of LessonCard. */
import { instruments } from '../../data/instruments';
const groups = [
  { name: 'instrument', label: 'Instrument', options: instruments.map((i) => [i.slug, i.short] as const) },
  {
    name: 'ages',
    label: 'Age group',
    options: (['Kids', 'Teens', 'Adults'] as const).map((a) => [a, a] as const),
  },
  {
    name: 'level',
    label: 'Level',
    options: (['Beginner', 'Developing', 'Advancing'] as const).map((a) => [a, a] as const),
  },
  {
    name: 'format',
    label: 'Format',
    options: (['Private', 'Group', 'Church-hosted'] as const).map((a) => [a, a] as const),
  },
];
---

<form
  id="lesson-filters"
  class="rounded-[28px] bg-white p-5 ring-1 ring-sand sm:p-6"
  aria-label="Filter lessons"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {groups.map((g) => (
      <label class="block text-sm font-semibold">
        {g.label}
        <select
          name={g.name}
          class="mt-2 block w-full rounded-2xl border border-sand bg-cream/40 px-4 py-3 text-base font-normal"
        >
          <option value="">Any</option>
          {g.options.map(([v, l]) => (
            <option value={v}>{l}</option>
          ))}
        </select>
      </label>
    ))}
  </div>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm">
    <p aria-live="polite">
      <span id="lesson-count">0</span> lessons shown
    </p>
    <button
      type="reset"
      class="inline-flex min-h-11 items-center font-semibold text-terracotta underline-offset-4 hover:underline"
    >
      Clear filters
    </button>
  </div>
</form>
<p
  id="lesson-empty"
  hidden
  class="mt-6 rounded-[28px] border border-dashed border-sand p-8 text-center text-ink-soft"
>
  No lessons match these filters yet. Try clearing one.
</p>

<script>
  const form = document.getElementById('lesson-filters') as HTMLFormElement | null;
  const apply = () => {
    if (!form) return;
    const data = new FormData(form);
    const cards = document.querySelectorAll<HTMLElement>('[data-lesson]');
    let shown = 0;
    cards.forEach((c) => {
      const ok =
        (['instrument', 'level', 'format'] as const).every(
          (k) => !data.get(k) || c.dataset[k] === data.get(k),
        ) &&
        (!data.get('ages') || (c.dataset.ages ?? '').split(',').includes(String(data.get('ages'))));
      c.hidden = !ok;
      if (ok) shown++;
    });
    document.getElementById('lesson-count')!.textContent = String(shown);
    document.getElementById('lesson-empty')!.hidden = shown > 0;
  };
  form?.addEventListener('change', apply);
  form?.addEventListener('reset', () => setTimeout(apply));
  form?.addEventListener('submit', (e) => e.preventDefault());
  apply();
</script>
