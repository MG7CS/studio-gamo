---
/**
 * Client filters for the lesson list (SelectField per facet). They act on the data-* attributes of
 * LessonCard. `values` presets the selects (e.g. from `/lessons?ages=Kids`); the page renders the
 * non-matching cards hidden so the list is right before the script runs.
 */
import SelectField from '@studio-gamo/ui/components/forms/SelectField.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import { LESSON_FILTERS, type LessonFilterValues } from '../../lib/lesson-filters';

interface Props {
  values?: LessonFilterValues;
  shown: number;
}
const { values = {}, shown } = Astro.props;
---

<Card padding="sm">
  <form id="lesson-filters" aria-label="Filter lessons">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {LESSON_FILTERS.map((f) => (
        <SelectField
          id={`filter-${f.name}`}
          name={f.name}
          label={f.label}
          options={f.options}
          placeholder="Any"
          value={values[f.name]}
        />
      ))}
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-small">
      <p aria-live="polite">
        <span id="lesson-count">{shown}</span> lessons shown
      </p>
      <button
        type="reset"
        class="inline-flex min-h-11 items-center font-semibold text-action-strong underline-offset-4 hover:underline"
      >
        Clear filters
      </button>
    </div>
  </form>
</Card>
<p
  id="lesson-empty"
  hidden={shown > 0}
  class="mt-6 rounded-card border border-dashed border-border p-8 text-center text-fg-muted"
>
  No lessons match these filters yet. Try clearing one.
</p>

<script>
  const form = document.getElementById('lesson-filters') as HTMLFormElement | null;
  const apply = () => {
    if (!form) return;
    const data = new FormData(form);
    const cards = document.querySelectorAll<HTMLElement>('[data-lesson]');
    let shown = 0;
    cards.forEach((c) => {
      const ok =
        (['instrument', 'level', 'format'] as const).every(
          (k) => !data.get(k) || c.dataset[k] === data.get(k),
        ) &&
        (!data.get('ages') || (c.dataset.ages ?? '').split(',').includes(String(data.get('ages'))));
      c.hidden = !ok;
      if (ok) shown++;
    });
    document.getElementById('lesson-count')!.textContent = String(shown);
    document.getElementById('lesson-empty')!.hidden = shown > 0;
  };
  form?.addEventListener('change', apply);
  // A reset clears the selects to their defaults (the URL preset); clear them to "Any" instead.
  form?.addEventListener('reset', (e) => {
    e.preventDefault();
    form.querySelectorAll('select').forEach((s) => (s.value = ''));
    apply();
  });
  form?.addEventListener('submit', (e) => e.preventDefault());
  apply();
</script>
