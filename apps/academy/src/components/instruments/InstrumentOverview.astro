---
/** Instrument landing body: first-steps list beside a "Who It Suits" panel (headings typed in title case). */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import NumberedSteps from '@studio-gamo/ui/components/content/NumberedSteps.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import type { Instrument } from '../../data/instruments';
interface Props {
  instrument: Instrument;
}
const { instrument: i } = Astro.props;
const suits = [i.ages, 'Complete beginners welcome', 'Private or group formats', 'Online or in person'];
---

<Section tone="raised" data-reveal>
  <div class="grid gap-6 lg:grid-cols-5">
    <Card padding="lg" class="lg:col-span-3">
      <h2 class="section-subheading">What You'll Learn First</h2>
      <NumberedSteps items={i.firstSteps.map((title) => ({ title }))} class="mt-8" />
    </Card>
    <Card tone="inset" padding="lg" class="lg:col-span-2">
      <h2 class="section-subheading">Who It Suits</h2>
      <ul class="mt-4 space-y-3">
        {suits.map((t) => (
          <li class="flex items-center gap-2">
            <Icon name="check" class="size-4 text-action-strong" />
            {t}
          </li>
        ))}
      </ul>
    </Card>
  </div>
</Section>
