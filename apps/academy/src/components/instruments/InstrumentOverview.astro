---
/** Instrument page body: first-lessons list beside a tinted "who it suits" panel. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import Panel from '../shared/Panel.astro';
import SectionIntro from '../shared/SectionIntro.astro';
import type { Instrument } from '../../data/instruments';
interface Props {
  instrument: Instrument;
}
const { instrument: i } = Astro.props;
const suits = [i.ages, 'Complete beginners welcome', 'Private or group lessons', 'Online or in person'];
---

<section class="px-4 pb-16 sm:px-8 lg:pb-20" data-reveal>
  <div class="mx-auto grid max-w-[1320px] gap-4 lg:grid-cols-[1.2fr_0.8fr]">
    <Panel>
      <SectionIntro eyebrow="First lessons" title="What you learn first" size="sub" />
      <ol class="mt-6 divide-y divide-sand">
        {i.firstSteps.map((s, n) => (
          <li class="flex items-center gap-4 py-4">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-cream text-sm font-bold text-terracotta-dark">
              {n + 1}
            </span>
            <span class="font-semibold sm:text-lg">{s}</span>
          </li>
        ))}
      </ol>
    </Panel>
    <Panel tone={i.tint === 'bg-sand' ? 'sand' : 'ivory'} class="relative overflow-hidden">
      <span
        aria-hidden="true"
        data-glyph={i.short}
        class="absolute -bottom-8 -right-3 text-[7rem] font-black leading-none tracking-tighter text-white/60 after:content-[attr(data-glyph)]"
      ></span>
      <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-terracotta">
        <Icon name={i.icon} class="h-6 w-6" />
      </span>
      <h2 class="academy-title-sub mt-5">Who it suits</h2>
      <ul class="relative mt-4 space-y-2.5">
        {suits.map((t) => (
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-4 w-4 shrink-0 text-terracotta" />
            {t}
          </li>
        ))}
      </ul>
    </Panel>
  </div>
</section>
