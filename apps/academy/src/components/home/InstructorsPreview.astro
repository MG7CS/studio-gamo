---
/** Section 4: music instructors — example profiles described by role, aligned in one grid. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import InstructorCard from '../shared/InstructorCard.astro';
import { instructors } from '../../data/instructors';
---

<Section id="instructors" data-reveal>
  <Fragment slot="title">
    Teachers who care <span class="block text-action">how you grow.</span>
  </Fragment>
  <FeatureGrid as="ul" min="sm" max={4}>
    {instructors.map((t) => (
      <InstructorCard instructor={t} as="li" />
    ))}
  </FeatureGrid>
</Section>
