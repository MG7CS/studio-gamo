---
/** Section 4: sample instructor profiles with initials avatars, in an aligned grid. */
import SectionIntro from '../shared/SectionIntro.astro';
import InstructorCard from '../shared/InstructorCard.astro';
import { instructors } from '../../data/instructors';
---

<section class="px-4 section-space sm:px-8" data-reveal>
  <div class="mx-auto max-w-[1320px]">
    <SectionIntro
      eyebrow="Instructors"
      title="Teachers who care"
      accent="how you grow."
      lede="Every instructor applies, does a teaching interview and passes a background review before teaching."
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {instructors.map((t) => (
        <InstructorCard instructor={t} />
      ))}
    </div>
  </div>
</section>
