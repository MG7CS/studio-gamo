---
/** Section 9: FAQ with sticky heading column. */
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import FaqAccordion from '@studio-gamo/ui/components/FaqAccordion.astro';
import { faqs } from '../../data/registration';
---
<section class="bg-ivory px-4 section-space sm:px-8" data-reveal>
  <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <EditorialHeading eyebrow="Questions from families" title="Good to know" accent="before you start." />
    </div>
    <FaqAccordion items={faqs} />
  </div>
</section>
