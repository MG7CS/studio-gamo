---
/** Section 8: FAQ in one white panel, heading above the list on phones and beside it on desktop. */
import FaqAccordion from '@gamo/site/components/FaqAccordion.astro';
import Panel from '../shared/Panel.astro';
import SectionIntro from '../shared/SectionIntro.astro';
import { faqs } from '../../data/faqs';
---

<section class="px-4 section-space sm:px-8" data-reveal>
  <Panel class="mx-auto max-w-[1320px]">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <SectionIntro eyebrow="Questions" title="Good to know" accent="before you start." />
      </div>
      <FaqAccordion items={faqs} />
    </div>
  </Panel>
</section>
