---
/** Section 8: family-friendly registration journey with a rich, high-contrast household sign-up preview card. */
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { registrationSteps } from '../../data/registration';

const learners = [
  {
    initial: 'A',
    name: 'Ava Tesfaye',
    ageGroup: 'Child · Age 9',
    instrument: 'Piano & Keys',
    level: 'Complete beginner',
    schedule: 'In-person · Sat mornings',
  },
  {
    initial: 'J',
    name: 'Jonah Tesfaye',
    ageGroup: 'Teen · Age 14',
    instrument: 'Drums & Rhythm',
    level: 'Developing',
    schedule: 'Church-hosted · Tue afternoons',
  },
];
---

<section class="bg-cream px-4 section-space sm:px-8" data-reveal>
  <div class="mx-auto grid max-w-[1320px] items-start gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-14">
    <div>
      <EditorialHeading
        eyebrow="Family-friendly registration"
        title="Signing up should"
        accent="feel easy."
        lede="Parents can register one or more children under a single family profile — or adults can sign up for themselves — in five clear, guided steps."
      />

      <div class="mt-6 flex flex-wrap gap-2">
        {['One family profile', 'Register multiple siblings at once', 'Beginner-friendly matching'].map(
          (pill) => (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-ivory px-3.5 py-1.5 text-xs font-semibold text-charcoal ring-1 ring-sand">
              <Icon name="check" class="h-3.5 w-3.5 text-terracotta" />
              {pill}
            </span>
          ),
        )}
      </div>

      <ol class="mt-8 space-y-3">
        {registrationSteps.map((s, i) => {
          const isHighlighted = i === 1;
          return (
            <li
              class:list={[
                'flex items-center justify-between gap-4 rounded-2xl p-4 transition-colors',
                isHighlighted
                  ? 'bg-white shadow-sm ring-2 ring-terracotta/45'
                  : 'bg-ivory/90 ring-1 ring-sand',
              ]}
            >
              <div class="flex items-center gap-3.5">
                <span
                  class:list={[
                    'grid h-9 w-9 shrink-0 place-items-center rounded-full text-sm font-bold',
                    isHighlighted ? 'bg-terracotta text-white' : 'bg-cream text-terracotta ring-1 ring-sand',
                  ]}
                >
                  {i + 1}
                </span>
                <div>
                  <p class="font-bold text-charcoal">{s.label}</p>
                  <p class="text-sm text-ink-soft">{s.hint}</p>
                </div>
              </div>
              {isHighlighted && (
                <span class="hidden shrink-0 rounded-full bg-cream px-3 py-1 text-xs font-semibold text-terracotta sm:inline-flex">
                  Shown on right →
                </span>
              )}
            </li>
          );
        })}
      </ol>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <ButtonLink href="/register" arrow>
          Start family registration
        </ButtonLink>
        <ButtonLink href="/instruments" variant="secondary">
          Explore instruments
        </ButtonLink>
      </div>
    </div>

    <div class="mx-auto w-full max-w-xl rounded-[40px] bg-[#EFE2D3] p-4 shadow-[0_24px_60px_-28px_rgba(29,35,35,0.2)] ring-1 ring-sand sm:p-6">
      <div
        class="rounded-[30px] bg-white p-6 text-charcoal shadow-float ring-1 ring-sand/80 sm:p-8"
        aria-label="Family registration step overview"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="inline-flex h-6 items-center rounded-full bg-cream px-3 text-xs font-bold uppercase tracking-wider text-terracotta">
              Step 2 of 5
            </span>
            <span class="text-xs font-semibold text-ink-soft">Learners &amp; Instruments</span>
          </div>
          <StatusPill kind="verified">Family profile</StatusPill>
        </div>

        <div class="mt-3 grid grid-cols-5 gap-1.5" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((step) => (
            <span class:list={['h-1.5 rounded-full', step <= 1 ? 'bg-terracotta' : 'bg-cream']} />
          ))}
        </div>

        <div class="mt-5 flex items-center justify-between gap-3 rounded-2xl bg-ivory px-4 py-3 ring-1 ring-sand">
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-soft">
              Step 1 completed · Household contact
            </p>
            <p class="truncate text-sm font-bold text-charcoal">
              Hannah Tesfaye · <span class="font-normal text-ink-soft">hannah@example.org</span>
            </p>
          </div>
          <span class="shrink-0 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-charcoal ring-1 ring-sand">
            Saved
          </span>
        </div>

        <div class="mt-6">
          <h3 class="text-xl font-bold tracking-tight text-charcoal sm:text-2xl">Who is learning music?</h3>
          <p class="mt-1 text-sm text-ink-soft">
            Add one or more children — or yourself — and pick the instrument each person wants to learn.
          </p>
        </div>

        <div class="mt-5 space-y-3.5">
          {learners.map((l) => (
            <div class="rounded-2xl border border-sand bg-ivory/60 p-4 transition-colors hover:bg-ivory">
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-terracotta text-sm font-bold text-white">
                    {l.initial}
                  </span>
                  <div>
                    <div class="flex flex-wrap items-center gap-2">
                      <p class="text-base font-bold text-charcoal">{l.name}</p>
                      <span class="rounded-full bg-white px-2.5 py-0.5 text-xs font-semibold text-ink-soft ring-1 ring-sand">
                        {l.ageGroup}
                      </span>
                    </div>
                    <p class="mt-0.5 text-xs font-medium text-ink-soft">{l.schedule}</p>
                  </div>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-terracotta ring-1 ring-sand">
                  <Icon name="check" class="h-3.5 w-3.5" /> Added
                </span>
              </div>

              <div class="mt-3 flex flex-wrap gap-2 border-t border-sand/80 pt-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1 text-xs font-semibold text-charcoal ring-1 ring-sand">
                  <Icon name="music" class="h-3.5 w-3.5 text-terracotta" />
                  {l.instrument}
                </span>
                <span class="inline-flex items-center rounded-full bg-white px-3 py-1 text-xs font-medium text-ink-soft ring-1 ring-sand">
                  Level: {l.level}
                </span>
              </div>
            </div>
          ))}

          <a
            href="/register"
            class="flex items-center justify-between gap-3 rounded-2xl border border-dashed border-terracotta/45 bg-cream/55 px-4 py-3.5 text-sm font-semibold text-charcoal transition-colors hover:bg-cream"
          >
            <span class="inline-flex items-center gap-2.5">
              <span class="grid h-7 w-7 place-items-center rounded-full bg-white text-terracotta ring-1 ring-sand">
                <Icon name="plus" class="h-4 w-4" />
              </span>
              Add another child or adult learner
            </span>
            <span class="text-xs font-medium text-ink-soft">Siblings &amp; parents welcome</span>
          </a>
        </div>

        <div class="mt-6 flex flex-col gap-3 border-t border-sand pt-5 sm:flex-row sm:items-center sm:justify-between">
          <span class="text-xs font-medium text-ink-soft">Takes ~2 minutes · No payment required</span>
          <a
            href="/register"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-terracotta px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-terracotta-dark"
          >
            Continue to schedule
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
