---
/**
 * Section 8: how registration really works — one short form per student, an emailed receipt and a
 * private link to view, update or cancel; no account. NumberedSteps beside a sketch of the form.
 */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import NumberedSteps from '@studio-gamo/ui/components/content/NumberedSteps.astro';
import FloatingPreviewCard from '@studio-gamo/ui/components/content/FloatingPreviewCard.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';

/** What the form asks about the student, described by field (no fictional person). */
const learner = {
  name: "Student's first name",
  ageGroup: 'Age group',
  instrument: 'Instrument',
  schedule: 'The lesson you chose: format and schedule',
};
const steps = [
  { title: 'Choose a Lesson', body: 'Pick the instrument, format and schedule that fit your student.' },
  {
    title: 'Fill in One Form',
    body: 'One short form per student, by a parent or guardian, or by an adult learner for themselves.',
  },
  { title: 'Check Your Email', body: 'A receipt arrives with a private link to your registration.' },
  { title: 'View, Update or Cancel', body: 'Use the private link at any time. No account or password.' },
];
---

<Section data-reveal>
  <div class="grid items-start gap-12 lg:grid-cols-2 lg:items-center lg:gap-14">
    <div>
      <EditorialHeading title="Signing Up Should" accent="Feel Easy." />
      <NumberedSteps items={steps} tone="inset" class="mt-8" />
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <ButtonLink href="/instruments" arrow>
          Choose an instrument
        </ButtonLink>
      </div>
    </div>

    <div class="mx-auto w-full max-w-xl rounded-hero bg-surface-inset p-4 shadow-float sm:p-6">
      <FloatingPreviewCard as="figure" title="Registration form · one student" class="p-6 sm:p-8">
        <div class="rounded-2xl border border-border bg-surface px-4 py-3">
          <p class="text-caption font-semibold tracking-wider text-fg-muted uppercase">
            Parent or guardian contact
          </p>
          <p class="text-small font-bold">
            Name · <span class="font-normal text-fg-muted">email for the receipt</span>
          </p>
        </div>

        <div>
          <p class="text-xl font-bold tracking-tight sm:text-2xl">Who is learning music?</p>
          <p class="mt-1 text-small text-fg-muted">
            One student per form. Registering a brother or sister? Send a second form.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-surface p-4">
          <div class="flex items-center gap-3">
            <span
              class="grid size-10 shrink-0 place-items-center rounded-full bg-action text-small font-bold text-on-action"
              aria-hidden="true"
            >
              <Icon name="user" class="size-5" />
            </span>
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-base font-bold">{learner.name}</p>
                <Badge size="sm" wrap>
                  {learner.ageGroup}
                </Badge>
              </div>
              <p class="mt-0.5 text-caption font-medium text-fg-muted">{learner.schedule}</p>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-2 border-t border-border pt-3">
            <Badge size="sm" wrap>
              {learner.instrument}
            </Badge>
          </div>
        </div>

        <p class="flex items-start gap-2 rounded-2xl border border-border bg-surface px-4 py-3 text-small">
          <Icon name="check" class="mt-0.5 size-4 shrink-0 text-action-strong" />
          <span>
            <span class="font-semibold">Receipt emailed</span>
            <span class="text-fg-muted"> with a private link to view, update or cancel.</span>
          </span>
        </p>

        <figcaption class="border-t border-border pt-5 text-caption font-medium text-fg-muted">
          No account needed
        </figcaption>
      </FloatingPreviewCard>
    </div>
  </div>
</Section>
