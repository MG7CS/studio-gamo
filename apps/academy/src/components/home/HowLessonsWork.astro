---
/** Section 5: how lessons work — portrait photo beside the heading and NumberedSteps on a dark band. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import NumberedSteps from '@studio-gamo/ui/components/content/NumberedSteps.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
const steps = [
  { title: 'Choose an Instrument', body: 'Explore instruments and first lessons to find what excites you.' },
  {
    title: 'Meet Your Instructor',
    body: 'A short introductory call to talk about goals, schedule and experience.',
  },
  {
    title: 'Learn Week by Week',
    body: 'Regular lessons with a simple practice plan and notes for families.',
  },
  {
    title: 'Celebrate Progress',
    body: 'Milestones, friendly recitals and, when ready, playing with others.',
  },
];
---

<Section tone="dark" data-reveal>
  <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
    <div>
      <Frame
        photo="youngPianist"
        ratio="portrait"
        sizes="half"
        alt="Young pianist smiling while playing a keyboard in a bright classroom"
      />
    </div>
    <div>
      <EditorialHeading tone="dark" title="Simple Steps," accent="Steady Progress." />
      <NumberedSteps items={steps} tone="raised" class="mt-10" />
    </div>
  </div>
</Section>
