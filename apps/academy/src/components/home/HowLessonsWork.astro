---
/** Section 5: how lessons work. Dark panel, photo first on phones, numbered steps. */
import Panel from '../shared/Panel.astro';
import MediaText from '../shared/MediaText.astro';
import SectionIntro from '../shared/SectionIntro.astro';
const steps = [
  { t: 'Choose an instrument', d: 'Explore instruments and see what first lessons cover.' },
  { t: 'Meet your instructor', d: 'A short call about goals, schedule and experience.' },
  { t: 'Learn week by week', d: 'Regular lessons with a simple practice plan and notes for families.' },
  { t: 'Celebrate progress', d: 'Milestones, friendly recitals and playing with others.' },
];
---

<section class="px-4 section-space sm:px-8" data-reveal>
  <Panel tone="dark" class="mx-auto max-w-[1320px]">
    <MediaText photo="youngPianist" photoPosition="50% 35%" reverse split="text">
      <SectionIntro
        tone="dark"
        eyebrow="How lessons work"
        title="Simple steps,"
        accent="steady progress."
        lede="A clear rhythm, so students and parents always know what comes next."
      />
      <ol class="mt-6 grid gap-3">
        {steps.map((s, i) => (
          <li class="flex items-start gap-4 rounded-2xl bg-white/5 p-4 ring-1 ring-white/10">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-terracotta text-sm font-bold text-white">
              {i + 1}
            </span>
            <div class="min-w-0">
              <h3 class="font-bold leading-snug">{s.t}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-cream/70">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </MediaText>
  </Panel>
</section>
