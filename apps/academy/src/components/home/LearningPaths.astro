---
/**
 * Section 2: learning by age & experience — one photo card per learner group, each linking to the lesson
 * list pre-filtered for that age group.
 */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import MediaCardGrid from '@studio-gamo/ui/components/content/MediaCardGrid.astro';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';
import type { Age } from '../../data/lessons';

const groups: {
  age: Age;
  label: string;
  photo: PhotoKey;
  title: string;
  points: string[];
}[] = [
  {
    age: 'Kids',
    label: 'Kids (6–12)',
    photo: 'youngPianist',
    title: 'Playful, Patient First Steps',
    points: ['30-minute lessons', 'Games for rhythm and reading', 'Progress notes for families'],
  },
  {
    age: 'Teens',
    label: 'Teens (13–17)',
    photo: 'girlGuitar',
    title: 'Real Songs, Real Confidence',
    points: ['Songs they choose', 'Group sessions with peers', 'Technique that lasts'],
  },
  {
    age: 'Adults',
    label: 'Adults',
    photo: 'guitarMentor',
    title: 'It is Never Too Late to Start',
    points: ['Evening and online options', 'Beginner-friendly pacing', 'Goals you set'],
  },
];
---

<Section id="ages" tone="raised" align="center" data-reveal>
  <Fragment slot="title">
    Lessons for Every <span class="text-action">Age &amp; Stage</span>
  </Fragment>
  <MediaCardGrid
    max={3}
    items={groups.map((g) => ({
      href: `/lessons?ages=${g.age}`,
      title: g.title,
      image: { name: g.photo, alt: '' },
      meta: `${g.label} · ${g.points.join(' · ')}`,
    }))}
  />
</Section>
