---
/** Section 2: learning by age. Audience tabs above the heading; each panel is photo first, then text. */
import AudienceSwitch from '@studio-gamo/ui/components/AudienceSwitch.astro';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';
import Panel from '../shared/Panel.astro';
import MediaText from '../shared/MediaText.astro';
import SectionIntro from '../shared/SectionIntro.astro';

const groups: {
  id: string;
  label: string;
  photo: PhotoKey;
  title: string;
  body: string;
  points: string[];
}[] = [
  {
    id: 'kids',
    label: 'Kids (6 to 12)',
    photo: 'youngPianist',
    title: 'Playful first steps',
    body: 'Short lessons, lots of encouragement and a practice plan parents can follow at home.',
    points: ['30-minute lessons', 'Games for rhythm and reading', 'Progress notes for families'],
  },
  {
    id: 'teens',
    label: 'Teens (13 to 17)',
    photo: 'girlGuitar',
    title: 'Real songs, real confidence',
    body: 'Teens learn the music they want to play, with chances to play together in small groups.',
    points: ['Songs they choose', 'Group sessions with peers', 'Technique that lasts'],
  },
  {
    id: 'adults',
    label: 'Adults',
    photo: 'guitarMentor',
    title: 'It is never too late',
    body: 'First time or returning after years away, lessons fit around work and family life.',
    points: ['Evening and online options', 'Beginner-friendly pacing', 'Goals you set'],
  },
];
---

<section class="px-4 section-space sm:px-8" data-reveal>
  <div class="mx-auto max-w-[1320px]">
    <AudienceSwitch
      id="ages"
      label="Choose a learner group"
      align="center"
      options={groups.map(({ id, label }) => ({ id, label }))}
    >
      <SectionIntro slot="heading" align="center" title="Lessons for every" accent="age and stage." />
      {groups.map((g) => (
        <Panel slot={g.id}>
          <MediaText photo={g.photo} reverse>
            <p class="inline-flex items-center rounded-full bg-cream px-3 py-1 text-xs font-semibold text-terracotta-dark ring-1 ring-sand">
              {g.label}
            </p>
            <h3 class="academy-title-sub mt-3 text-charcoal">{g.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">{g.body}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {g.points.map((p) => (
                <li class="rounded-full bg-ivory px-3.5 py-1.5 text-sm font-medium text-charcoal ring-1 ring-sand">
                  {p}
                </li>
              ))}
            </ul>
          </MediaText>
        </Panel>
      ))}
    </AudienceSwitch>
  </div>
</section>
