---
/**
 * Section 2: learning by age & experience — one photo card per learner group, each linking to the lesson
 * list pre-filtered for that age group.
 */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import MediaCard from '@studio-gamo/ui/components/content/MediaCard.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import type { PhotoKey } from '@studio-gamo/ui/lib/images';
import type { Age } from '../../data/lessons';

const groups: {
  age: Age;
  label: string;
  photo: PhotoKey;
  title: string;
  body: string;
  points: string[];
}[] = [
  {
    age: 'Kids',
    label: 'Kids (6–12)',
    photo: 'youngPianist',
    title: 'Playful, patient first steps',
    body: 'Short lessons, lots of encouragement and practice plans that parents can follow at home.',
    points: ['30-minute lessons', 'Games for rhythm and reading', 'Progress notes for families'],
  },
  {
    age: 'Teens',
    label: 'Teens (13–17)',
    photo: 'girlGuitar',
    title: 'Real songs, real confidence',
    body: 'Teens learn the music they actually want to play, with chances to play together in small groups.',
    points: ['Songs they choose', 'Group sessions with peers', 'Technique that lasts'],
  },
  {
    age: 'Adults',
    label: 'Adults',
    photo: 'guitarMentor',
    title: 'It is never too late to start',
    body: 'Whether you are a first-timer or returning after years away, lessons fit around work and family life.',
    points: ['Evening and online options', 'Beginner-friendly pacing', 'Goals you set'],
  },
];
---

<Section id="ages" tone="raised" align="center" data-reveal>
  <Fragment slot="title">
    Lessons for Every <span class="text-action">Age &amp; Stage</span>
  </Fragment>
  <FeatureGrid as="ul" max={3}>
    {groups.map((g) => (
      <MediaCard
        as="li"
        href={`/lessons?ages=${g.age}`}
        title={g.title}
        image={{ name: g.photo, alt: '', sizes: '(min-width:1024px) 30vw, 100vw' }}
      >
        <Badge slot="eyebrow" tone="accent">
          {g.label}
        </Badge>
        <p>{g.body}</p>
        <ul slot="meta" class="flex flex-wrap gap-2">
          {g.points.map((p) => (
            <li>
              <Badge size="sm">{p}</Badge>
            </li>
          ))}
        </ul>
      </MediaCard>
    ))}
  </FeatureGrid>
</Section>
