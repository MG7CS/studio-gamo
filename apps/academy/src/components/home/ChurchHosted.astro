---
import { siteUrl } from '@studio-gamo/ui/lib/sites';
/** Section 7: church-hosted lessons — uses shared EditorialFeatureCard in reversed layout. */
import EditorialFeatureCard, {
  type EditorialFeaturePoint,
} from '@studio-gamo/ui/components/EditorialFeatureCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';

const roles: EditorialFeaturePoint[] = [
  {
    icon: 'church',
    title: 'A Church Provides',
    body: 'A welcoming room, a schedule window and an invitation to its neighborhood.',
  },
  {
    icon: 'shield',
    title: 'Gamo Academy Provides',
    body: 'Reviewed instructors, curriculum and family communication.',
  },
  {
    icon: 'users',
    title: 'Students Receive',
    body: 'Quality lessons close to home, open to the wider community.',
  },
];
---

<EditorialFeatureCard
  title="Lessons Close"
  accent="to Home."
  points={roles}
  photo="churchModernDay"
  photoRatio="square"
  tone="ivory"
  reverse={true}
>
  <ButtonLink href={siteUrl('web', '/academy/host')} arrow>
    Apply to host lessons
  </ButtonLink>
</EditorialFeatureCard>
