---
/** Section 3: private & group instruction — one square photo (the 3:2 source crops least) in a wide column beside two format cards. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
const formats = [
  {
    icon: 'users' as const,
    name: 'Private lessons',
    items: ['30, 45 or 60 minutes', 'In person or online', 'Personal practice plan'],
  },
  {
    icon: 'music' as const,
    name: 'Group classes',
    items: [
      '3–8 students per class',
      'Weekly sessions',
      'Play together early',
      'Great for siblings & friends',
    ],
  },
];
---

<Section data-reveal>
  <div class="grid items-center gap-12 lg:grid-cols-12">
    <div class="w-full lg:col-span-7">
      <Frame
        photo="guitarMentor"
        ratio="square"
        sizes="half"
        alt="Guitar instructor guiding a young student through a chord"
        caption="Private or group — you choose"
      />
    </div>
    <div class="lg:col-span-5">
      <EditorialHeading title="One-on-one focus" accent="or the joy of a group." />
      <FeatureGrid as="ul" min="lg" max={2} class="mt-10">
        {formats.map((f) => (
          <Card as="li" padding="lg">
            <div class="flex items-center gap-4">
              <span class="grid size-12 place-items-center rounded-2xl bg-surface-inset text-action-strong">
                <Icon name={f.icon} class="size-6" />
              </span>
              <h3 class="text-2xl font-bold tracking-tight">{f.name}</h3>
            </div>
            <ul class="mt-4 grid gap-2 text-small">
              {f.items.map((i) => (
                <li class="flex items-center gap-2">
                  <Icon name="check" class="size-4 text-action-strong" />
                  {i}
                </li>
              ))}
            </ul>
          </Card>
        ))}
      </FeatureGrid>
    </div>
  </div>
</Section>
