---
/** Section 3: private and group lessons. Photo first on phones, two compact format cards. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import Panel from '../shared/Panel.astro';
import MediaText from '../shared/MediaText.astro';
import SectionIntro from '../shared/SectionIntro.astro';
const formats = [
  {
    icon: 'users' as const,
    name: 'Private lessons',
    text: 'One student, one instructor. Your pace, your goals, your favorite music.',
    items: ['30, 45 or 60 minutes', 'In person or online', 'Personal practice plan'],
  },
  {
    icon: 'music' as const,
    name: 'Group classes',
    text: 'Learn with three to eight others. Social, encouraging and a lower proposed cost per student.',
    items: ['Weekly sessions', 'Play together early', 'Good for siblings and friends'],
  },
];
---

<section class="px-4 section-space sm:px-8" data-reveal>
  <Panel class="mx-auto max-w-[1320px]">
    <MediaText photo="guitarMentor" photoPosition="40% 50%" reverse split="text">
      <SectionIntro
        eyebrow="How you learn"
        title="One-on-one"
        accent="or in a group."
        lede="Both formats use the same instructors and the same step-by-step approach."
      />
      <div class="mt-6 grid gap-3">
        {formats.map((f) => (
          <article class="rounded-2xl bg-ivory p-5 ring-1 ring-sand">
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-cream text-terracotta">
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <h3 class="text-lg font-bold tracking-tight">{f.name}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft sm:text-base">{f.text}</p>
            <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-sm">
              {f.items.map((i) => (
                <li class="flex items-center gap-1.5">
                  <Icon name="check" class="h-4 w-4 text-terracotta" />
                  {i}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </MediaText>
  </Panel>
</section>
