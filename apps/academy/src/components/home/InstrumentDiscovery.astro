---
/** Section 1: instrument discovery: the instruments as flat rows, and the planned ones in one plain line. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import LinkRows from '@studio-gamo/ui/components/content/LinkRows.astro';
import { instruments, plannedInstruments } from '../../data/instruments';
---

<Section id="instruments" data-reveal>
  <Fragment slot="title">
    Every musician starts <span class="block text-action">with one song.</span>
  </Fragment>
  <LinkRows
    items={instruments.map((i) => ({
      href: `/instruments/${i.slug}`,
      title: i.name,
      meta: i.ages,
    }))}
  />
  <p class="mt-6 text-small text-fg-muted">More planned: {plannedInstruments.join(' · ')}</p>
</Section>
