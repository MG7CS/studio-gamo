---
/** Section 1: instrument discovery — instrument cards in a FeatureGrid (no empty cell), planned instruments. */
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import InstrumentCard from '../shared/InstrumentCard.astro';
import { instruments, plannedInstruments } from '../../data/instruments';
---

<Section id="instruments" data-reveal>
  <Fragment slot="eyebrow">Discover your instrument</Fragment>
  <Fragment slot="title">
    Every musician starts <span class="block text-action">with one song.</span>
  </Fragment>
  <p slot="intro">
    Not sure where to begin? Explore each instrument, see what first lessons look like and pick the one that
    excites you.
  </p>
  <ButtonLink slot="actions" href="/instruments" variant="secondary" arrow>
    All instruments
  </ButtonLink>
  <FeatureGrid as="ul" max={3}>
    {instruments.map((i) => (
      <InstrumentCard instrument={i} />
    ))}
  </FeatureGrid>
  <div class="mt-6 flex flex-wrap items-center gap-2 rounded-card border border-dashed border-border p-5">
    <span class="me-2 text-small font-semibold">More planned:</span>
    <ul class="flex flex-wrap gap-2">
      {plannedInstruments.map((p) => (
        <li>
          <Badge>{p}</Badge>
        </li>
      ))}
    </ul>
  </div>
</Section>
