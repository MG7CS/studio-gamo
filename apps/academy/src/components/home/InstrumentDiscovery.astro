---
/** Section 1: instrument discovery. Bento grid on desktop, single column on phones. */
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import SectionIntro from '../shared/SectionIntro.astro';
import InstrumentCard from '../shared/InstrumentCard.astro';
import { instruments, plannedInstruments } from '../../data/instruments';
const spans = [
  'lg:col-span-5 lg:row-span-2',
  'lg:col-span-4',
  'lg:col-span-3',
  'lg:col-span-3',
  'lg:col-span-4',
  'sm:col-span-2 lg:col-span-12',
];
---

<section id="instruments" class="px-4 section-space sm:px-8" data-reveal>
  <div class="mx-auto max-w-[1320px]">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <SectionIntro
        eyebrow="Instruments"
        title="Every musician starts"
        accent="with one song."
        lede="See what first lessons cover and pick the instrument that excites you."
      />
      <ButtonLink href="/instruments" variant="secondary" class="w-full shrink-0 sm:w-auto" arrow>
        All instruments
      </ButtonLink>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-12">
      {instruments.map((i, idx) => (
        <InstrumentCard instrument={i} class:list={[spans[idx], idx === 0 && 'lg:min-h-[620px]']} />
      ))}
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-2 rounded-[24px] bg-white p-5 ring-1 ring-sand">
      <span class="mr-1 text-sm font-semibold">Coming as instructors join:</span>
      {plannedInstruments.map((p) => (
        <span class="rounded-full bg-cream px-3 py-1.5 text-sm text-ink-soft ring-1 ring-sand">{p}</span>
      ))}
    </div>
    <div
      id="production-training"
      class="mt-4 flex scroll-mt-28 flex-col gap-4 rounded-[24px] bg-white p-5 ring-1 ring-sand sm:flex-row sm:items-center sm:justify-between sm:p-6"
    >
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-base font-semibold text-charcoal">Production training</h3>
          <StatusPill kind="proposal" size="sm">
            Planned
          </StatusPill>
        </div>
        <p class="mt-1 text-sm text-ink-soft">
          Sound, livestream and lighting classes for church media teams and volunteers.
        </p>
      </div>
      <ButtonLink href={inquiryUrl('Lesson interest')} variant="secondary" class="w-full shrink-0 sm:w-auto">
        Ask about production training
      </ButtonLink>
    </div>
  </div>
</section>
