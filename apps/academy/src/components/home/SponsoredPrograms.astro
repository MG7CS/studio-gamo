---
/**
 * Section 6: lessons sponsored through partner organizations and churches. The wording stays general because the
 * arrangement depends on each partner's offer (docs/DECISIONS.md, "Sponsorship wording"): no who-qualifies, no
 * amounts, no counts.
 */
import EditorialFeatureCard, {
  type EditorialFeaturePoint,
} from '@studio-gamo/ui/components/EditorialFeatureCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';

const points: EditorialFeaturePoint[] = [
  {
    icon: 'church',
    title: 'Church Partners',
    body: 'Churches can sponsor lessons for their community.',
  },
  {
    icon: 'users',
    title: 'Partner Organizations',
    body: 'Community organizations can sponsor lessons with us.',
  },
  {
    icon: 'clock',
    title: 'Shaped with Each Partner',
    body: 'Details are shared when they are confirmed.',
  },
];
---

<EditorialFeatureCard
  title="Lessons Sponsored by"
  accent="Partners and Churches."
  points={points}
  photo="boyGuitar"
  tone="sand"
>
  <ButtonLink href={siteUrl('web', '/partners/interest')} arrow>
    Partner with us
  </ButtonLink>
</EditorialFeatureCard>
