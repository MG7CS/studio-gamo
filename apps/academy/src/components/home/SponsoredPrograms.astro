---
/** Section 6: sponsored & scholarship-supported programs, worded as ideas (could, would). */
import EditorialFeatureCard, {
  type EditorialFeaturePoint,
} from '@studio-gamo/ui/components/EditorialFeatureCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';

const ideas: EditorialFeaturePoint[] = [
  {
    icon: 'heart',
    title: 'Need-Based Tuition Support',
    body: 'Reduced or no-cost lessons for families who need it.',
  },
  {
    icon: 'church',
    title: 'Church-Sponsored Cohorts',
    body: 'Groups a congregation could underwrite for its community.',
  },
  {
    icon: 'school',
    title: 'Instrument Lending',
    body: 'Instruments on loan for students without one at home.',
  },
];
---

<EditorialFeatureCard
  title="Lessons for Every"
  accent="Family's Budget."
  points={ideas}
  photo="boyGuitar"
  photoRatio="portrait"
  tone="sand"
  mediaFirstStacked
>
  <ButtonLink href="/sponsored" arrow>
    Explore sponsored programs
  </ButtonLink>
</EditorialFeatureCard>
