---
/** Section 6: sponsored classes, clearly marked as a proposal. Photo first on phones. */
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Panel from '../shared/Panel.astro';
import MediaText from '../shared/MediaText.astro';
import SectionIntro from '../shared/SectionIntro.astro';
import PointList, { type Point } from '../shared/PointList.astro';
import Actions from '../shared/Actions.astro';

const ideas: Point[] = [
  {
    icon: 'heart',
    title: 'Need-based support',
    body: 'Proposed reduced-cost or free lessons for families who need it.',
  },
  {
    icon: 'church',
    title: 'Sponsored classes',
    body: 'A church or any organization can sponsor a class. Fully sponsored classes are free to the learner.',
  },
  {
    icon: 'school',
    title: 'Instrument lending',
    body: 'An idea under review for students without an instrument at home.',
  },
];
---

<section class="px-4 section-space sm:px-8" data-reveal>
  <Panel tone="sand" class="mx-auto max-w-[1320px]">
    <MediaText photo="boyGuitar" photoPosition="50% 30%">
      <StatusPill kind="proposal">Proposal</StatusPill>
      <SectionIntro
        class="mt-4"
        title="Lessons should not depend"
        accent="on a family's budget."
        lede="Churches and other organizations can sponsor classes so cost never stands in the way."
      />
      <PointList points={ideas} class="mt-6" />
      <Actions class="mt-6">
        <ButtonLink href="/sponsored" arrow>
          Sponsored programs
        </ButtonLink>
      </Actions>
    </MediaText>
  </Panel>
</section>
