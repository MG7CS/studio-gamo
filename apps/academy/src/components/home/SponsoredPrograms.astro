---
/** Section 6: sponsored & scholarship-supported programs — clearly marked as planned. */
import EditorialFeatureCard, { type EditorialFeaturePoint } from '@studio-gamo/ui/components/EditorialFeatureCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';

const ideas: EditorialFeaturePoint[] = [
  { icon: 'heart', title: 'Need-based tuition support', body: 'Proposed reduced or no-cost lessons for families who need it.' },
  { icon: 'church', title: 'Church-sponsored cohorts', body: 'Proposed groups a congregation could underwrite for its community.' },
  { icon: 'school', title: 'Instrument lending', body: 'An idea under review for students without an instrument at home.' },
];
---
<EditorialFeatureCard
  pillText="Sponsored & scholarship pathways"
  pillKind="proposal"
  title="Music lessons should not depend on"
  accent="a family's budget."
  body="Gamo Academy coordinates sponsored and scholarship-supported lessons alongside church partners and community supporters so every student has room to learn."
  points={ideas}
  photo="boyGuitar"
  photoPosition="50% 30%"
  caption="Scholarship & church-sponsored cohort pathways"
  tone="sand"
>
  <ButtonLink href="/sponsored" arrow>Explore sponsored programs</ButtonLink>
</EditorialFeatureCard>
