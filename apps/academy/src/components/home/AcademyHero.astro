---
/**
 * Academy landing hero: SplitHero with the approved headline (the page's <h1>), the masked photo cluster
 * with a Sample next-lesson preview, and the quick instrument picker below.
 */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import FloatingPreviewCard from '@studio-gamo/ui/components/content/FloatingPreviewCard.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { instruments } from '../../data/instruments';
---

<header class="page-intro-space relative overflow-hidden">
  <SplitHero as="div" spacing="none">
    <p class="eyebrow text-action-strong">Gamo Academy · For kids, teens &amp; adults</p>
    <h1 class="display-xl text-balance">
      Learn to Play the <span class="text-action">Instrument You Love.</span>
    </h1>
    <p class="max-w-xl text-base leading-relaxed text-fg-muted lg:text-lg">
      Friendly, patient music lessons for students and families — private or in small groups, online or close
      to home, including planned church-hosted and sponsored programs.
    </p>
    <div class="flex flex-wrap gap-3">
      <ButtonLink href="/instruments" size="lg" arrow>
        Choose an instrument
      </ButtonLink>
      <ButtonLink href="/lessons" size="lg" variant="secondary">
        Browse lessons
      </ButtonLink>
    </div>

    <div slot="media" class="academy-hero-photos relative mx-auto w-full max-w-xl">
      <div aria-hidden="true" class="absolute -end-32 top-24 size-140 rounded-full bg-surface-raised"></div>
      <div class="mask-arch absolute start-1/7 top-0 h-3/4 w-4/7 overflow-hidden shadow-float sm:h-7/8">
        <Photo
          name="boyGuitar"
          priority
          sizes="(min-width:1024px) 30vw, 60vw"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="mask-leaf absolute end-0 top-1/16 h-2/5 w-1/3 overflow-hidden shadow-float">
        <Photo name="girlGuitar" sizes="(min-width:1024px) 16vw, 34vw" class="h-full w-full object-cover" />
      </div>
      <div class="mask-pebble absolute end-1/24 bottom-2/7 h-5/12 w-3/8 overflow-hidden border-4 border-surface shadow-float sm:bottom-0">
        <Photo name="youngPianist" sizes="(min-width:1024px) 16vw, 36vw" class="h-full w-full object-cover" />
      </div>
      <FloatingPreviewCard
        title="Next lesson"
        class="absolute start-0 bottom-0 w-56 gap-2 p-4 shadow-float sm:bottom-1/16 sm:w-64"
      >
        <p class="font-bold">Guitar · Week 3</p>
        <p class="flex items-center gap-1.5 text-small text-fg-muted">
          <Icon name="clock" class="size-4" /> Saturday · 30 min
        </p>
        <div class="h-1.5 overflow-hidden rounded-pill bg-surface-inset" aria-hidden="true">
          <div class="h-full w-2/5 rounded-pill bg-action"></div>
        </div>
      </FloatingPreviewCard>
    </div>
  </SplitHero>

  <Container class="relative mt-7">
    <nav aria-label="Pick an instrument">
      <p class="mb-3 text-small font-semibold text-fg-muted">What would you like to play?</p>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {instruments.map((i) => (
          <li>
            <a
              href={`/instruments/${i.slug}`}
              class="group flex items-center gap-3 rounded-2xl border border-border bg-surface-raised p-3 transition hover:shadow-float"
            >
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-surface-inset text-action-strong transition group-hover:bg-action group-hover:text-on-action">
                <Icon name={i.icon} class="size-5" />
              </span>
              <span class="text-small leading-tight font-semibold">{i.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</header>

<style>
  .academy-hero-photos {
    height: clamp(22rem, 64vw, 28rem);
  }
  @media (min-width: 1024px) {
    .academy-hero-photos {
      height: clamp(24rem, 33vw, 29rem);
    }
  }
</style>
