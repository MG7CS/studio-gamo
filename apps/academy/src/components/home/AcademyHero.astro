---
/** Academy landing hero: exact approved headline, friendly masked photo cluster and quick instrument picker. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { instruments } from '../../data/instruments';
---
<section class="relative overflow-hidden px-4 pb-16 pt-28 sm:px-8 lg:pb-20 lg:pt-32">
  <div aria-hidden="true" class="absolute -right-32 top-24 h-[560px] w-[560px] rounded-full bg-ivory"></div>
  <div class="relative mx-auto grid max-w-[1320px] items-center gap-12 lg:grid-cols-[1fr_1.05fr]">
    <div>
      <p class="eyebrow text-terracotta">Gamo Academy · For kids, teens &amp; adults</p>
      <h1 class="display-xl mt-5 text-balance">Learn to Play the <span class="text-terracotta">Instrument You Love.</span></h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
        Friendly, patient music lessons for students and families — private or in small groups, online or close to home, including planned church-hosted and sponsored programs.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink href="/instruments" size="lg" arrow>Choose an instrument</ButtonLink>
        <ButtonLink href="/lessons" size="lg" variant="secondary">Browse sample lessons</ButtonLink>
      </div>
    </div>

    <div class="relative mx-auto h-[470px] w-full max-w-[600px] sm:h-[540px]">
      <div class="mask-arch absolute left-[14%] top-0 h-[74%] w-[56%] overflow-hidden shadow-float sm:h-[88%]">
        <Photo name="boyGuitar" priority sizes="(min-width:1024px) 30vw, 60vw" class="h-full w-full object-cover" />
      </div>
      <div class="mask-leaf absolute right-0 top-[6%] h-[40%] w-[34%] overflow-hidden shadow-float">
        <Photo name="girlGuitar" sizes="(min-width:1024px) 16vw, 34vw" class="h-full w-full object-cover" />
      </div>
      <div class="mask-pebble absolute bottom-[28%] right-[4%] h-[42%] w-[36%] overflow-hidden border-4 border-cream shadow-float sm:bottom-0">
        <Photo name="youngPianist" sizes="(min-width:1024px) 16vw, 36vw" class="h-full w-full object-cover" />
      </div>
      <div class="absolute bottom-0 left-0 w-[210px] rounded-3xl bg-white p-4 shadow-float sm:bottom-[6%] sm:w-[240px]">
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-ink-soft">Sample · Next lesson</p>
        <p class="mt-2 font-bold">Guitar · Week 3</p>
        <p class="mt-1 flex items-center gap-1.5 text-sm text-ink-soft"><Icon name="clock" class="h-4 w-4" /> Saturday · 30 min</p>
        <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-cream"><div class="h-full w-[38%] rounded-full bg-terracotta"></div></div>
      </div>
    </div>
  </div>

  <nav aria-label="Pick an instrument" class="relative mx-auto mt-12 max-w-[1320px]">
    <p class="mb-4 text-sm font-semibold text-ink-soft">What would you like to play?</p>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {instruments.map((i) => (
        <li>
          <a href={`/instruments/${i.slug}`} class="group flex items-center gap-3 rounded-2xl bg-white/80 p-3 ring-1 ring-sand transition hover:bg-white hover:shadow-float">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-cream text-terracotta transition group-hover:bg-terracotta group-hover:text-white"><Icon name={i.icon} class="h-5 w-5" /></span>
            <span class="text-sm font-semibold leading-tight">{i.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>
