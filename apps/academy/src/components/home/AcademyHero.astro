---
/**
 * Academy landing hero: SplitHero with the approved headline (the page's <h1>), the photo cluster (shared PhotoGrid trio)
 * (no widget over the photos, no row of tiles below).
 */
import SplitHero from '@studio-gamo/ui/components/content/SplitHero.astro';
import PhotoGrid from '@studio-gamo/ui/components/media/PhotoGrid.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---

<header class="page-intro-space relative overflow-hidden">
  <SplitHero as="div" spacing="none" mediaWidth="wide">
    <h1 class="display-xl text-balance">
      Learn to Play the <span class="text-action">Instrument You Love.</span>
    </h1>
    <p class="max-w-xl text-base leading-relaxed text-fg-muted lg:text-lg">
      Friendly, patient music lessons for students and families — private or in small groups, online or close
      to home, including planned church-hosted and sponsored programs.
    </p>
    <div class="flex flex-wrap gap-3">
      <ButtonLink href="/instruments" size="lg" arrow>
        Choose an instrument
      </ButtonLink>
      <ButtonLink href="/lessons" size="lg" variant="secondary">
        Browse lessons
      </ButtonLink>
    </div>

    <div slot="media" class="relative w-full">
      <PhotoGrid
        layout="trio"
        photos={[
          {
            photo: 'boyGuitar',
            alt: 'Smiling boy learning to play acoustic guitar in a sunlit room',
            priority: true,
          },
          { photo: 'girlGuitar', alt: 'Young girl practicing acoustic guitar beside a music stand' },
          {
            photo: 'youngPianist',
            alt: 'Young pianist smiling while playing a keyboard in a bright classroom',
          },
        ]}
      />
    </div>
  </SplitHero>
</header>
