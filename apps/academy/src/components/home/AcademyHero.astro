---
/** Academy landing hero: exact approved headline in one rounded panel, photo first on phones, then an instrument picker. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Panel from '../shared/Panel.astro';
import MediaText from '../shared/MediaText.astro';
import Actions from '../shared/Actions.astro';
import { instruments } from '../../data/instruments';
---

<section class="px-4 page-intro-space sm:px-8">
  <Panel tone="ivory" class="mx-auto max-w-[1320px]">
    <MediaText photo="boyGuitar" photoPosition="50% 30%" priority aspect="tall" split="text">
      <p class="inline-flex items-center rounded-full bg-cream px-3 py-1 text-xs font-semibold text-terracotta-dark ring-1 ring-sand">
        Gamo Academy · All ages
      </p>
      <h1 class="academy-title-hero mt-4 text-balance">
        Learn to Play the <span class="text-terracotta">Instrument You Love.</span>
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
        Patient music lessons for kids, teens and adults. Private or in a small group, online or close to
        home.
      </p>
      <Actions class="mt-6">
        <ButtonLink href="/instruments" size="lg" arrow>
          Choose an instrument
        </ButtonLink>
        <ButtonLink href="/lessons" size="lg" variant="secondary">
          Browse lessons
        </ButtonLink>
      </Actions>
    </MediaText>
  </Panel>

  <nav aria-label="Pick an instrument" class="mx-auto mt-6 max-w-[1320px]">
    <p class="mb-3 text-sm font-semibold text-ink-soft">What would you like to play?</p>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {instruments.map((i) => (
        <li>
          <a
            href={`/instruments/${i.slug}`}
            class="group flex min-h-16 items-center gap-3 rounded-2xl bg-white p-3 ring-1 ring-sand transition hover:shadow-float"
          >
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-cream text-terracotta transition group-hover:bg-terracotta group-hover:text-white">
              <Icon name={i.icon} class="h-5 w-5" />
            </span>
            <span class="text-sm font-semibold leading-tight">{i.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>
