---
/** Sample student dashboard widgets: upcoming lessons, practice streak, instructor notes. */
import Icon from '@studio-gamo/ui/components/Icon.astro';
const upcoming = [
  { d: 'Sat', n: '18', t: 'First Piano Steps · Week 4', m: '10:00 AM · Online' },
  { d: 'Sat', n: '25', t: 'First Piano Steps · Week 5', m: '10:00 AM · Online' },
];
const week = [20, 15, 0, 25, 10, 30, 0];
const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const notes = ['Great progress on the C-major scale — try it hands together this week.', 'Practise "Ode to Joy" slowly, 3 times a day.'];
---
<div class="grid gap-4 lg:grid-cols-3">
  <section class="rounded-[28px] bg-white p-6 ring-1 ring-sand lg:col-span-2" aria-labelledby="up-h">
    <h2 id="up-h" class="text-lg font-bold">Upcoming lessons</h2>
    <ul class="mt-4 space-y-3">
      {upcoming.map((u) => (
        <li class="flex items-center gap-4 rounded-2xl bg-cream/60 p-4">
          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-white text-center leading-none"><span class="text-[10px] font-semibold uppercase text-ink-soft">{u.d}<br /><span class="text-xl font-bold text-charcoal">{u.n}</span></span></span>
          <div class="flex-1"><p class="font-semibold">{u.t}</p><p class="text-sm text-ink-soft">{u.m}</p></div>
          <span class="hidden rounded-full bg-white px-3 py-1 text-xs font-semibold ring-1 ring-sand sm:inline">Sample</span>
        </li>
      ))}
    </ul>
  </section>
  <section class="rounded-[28px] bg-charcoal p-6 text-cream" data-surface="dark" aria-labelledby="pr-h">
    <h2 id="pr-h" class="text-lg font-bold">Practice this week</h2>
    <p class="mt-1 text-sm text-cream/70">100 minutes · goal 120 (sample)</p>
    <div class="mt-6 flex h-32 items-end gap-2" role="img" aria-label="Sample practice minutes by day">
      {week.map((m, i) => <div class="flex flex-1 flex-col items-center gap-2"><span class="w-full rounded-t-lg bg-terracotta" style={`height:${Math.max(m * 3, 4)}px`}></span><span class="text-xs text-cream/60">{days[i]}</span></div>)}
    </div>
  </section>
  <section class="rounded-[28px] bg-ivory p-6 ring-1 ring-sand lg:col-span-2" aria-labelledby="no-h">
    <h2 id="no-h" class="text-lg font-bold">Notes from your instructor</h2>
    <ul class="mt-4 space-y-3">{notes.map((n) => <li class="flex gap-3 rounded-2xl bg-white p-4"><Icon name="book" class="h-5 w-5 shrink-0 text-terracotta" /><p>{n}</p></li>)}</ul>
  </section>
  <section class="rounded-[28px] bg-white p-6 ring-1 ring-sand" aria-labelledby="ms-h">
    <h2 id="ms-h" class="text-lg font-bold">Milestones</h2>
    <ul class="mt-4 space-y-3 text-sm">
      {[['Found middle C', true], ['First song, hands separate', true], ['First song, hands together', false], ['Friendly recital', false]].map(([t, ok]) => (
        <li class="flex items-center gap-3"><span class:list={['grid h-6 w-6 place-items-center rounded-full', ok ? 'bg-terracotta text-white' : 'bg-cream text-ink-soft']}><Icon name={ok ? 'check' : 'star'} class="h-3.5 w-3.5" /></span>{t}</li>
      ))}
    </ul>
  </section>
</div>
