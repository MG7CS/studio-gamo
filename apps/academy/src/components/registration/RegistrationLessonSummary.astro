---
/** The lesson a family is registering for: sample label, schedule, location, ages and tuition (a proposal). */
import Card from '@studio-gamo/ui/components/content/Card.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import { formatTuition, type Lesson } from '../../data/lessons';

interface Props {
  lesson: Lesson;
  class?: string;
}
const { lesson, class: className } = Astro.props;
const facts: [string, string][] = [
  ['Schedule', `${lesson.schedule} · ${lesson.length}`],
  ['Location', lesson.location],
  ['Ages', lesson.ages.join(', ')],
];
const dtClass = 'text-caption font-semibold tracking-wide text-fg-muted uppercase';
---

<Card as="section" aria-labelledby="lesson-summary-title" class={className}>
  {lesson.sample && (
    <Badge tone="sample" class="self-start">
      Sample lesson
    </Badge>
  )}
  <h2 id="lesson-summary-title" class="mt-4 text-xl font-bold">
    {lesson.title}
  </h2>
  <p class="mt-1 text-small text-fg-muted">
    {lesson.instrument} · {lesson.level} · {lesson.format}
  </p>
  <dl class="mt-5 space-y-3">
    {facts.map(([k, v]) => (
      <div>
        <dt class={dtClass}>{k}</dt>
        <dd class="mt-0.5 font-semibold">{v}</dd>
      </div>
    ))}
    <div>
      <dt class={dtClass}>Tuition</dt>
      <dd class="mt-0.5 flex flex-wrap items-center gap-2 font-semibold">
        {formatTuition(lesson.proposedTuitionCents)}
        <Badge tone="proposal" size="sm" />
      </dd>
    </div>
  </dl>
  <p class="mt-5 text-small text-fg-muted">
    Instructor compensation and any administrative allocation are always shown on separate lines before
    enrollment is confirmed. Reserving a spot is free.
  </p>
  {lesson.sample && (
    <p class="mt-3 text-small font-semibold text-action-strong">
      Sample lesson — registration is a demonstration in this preview.
    </p>
  )}
</Card>
