---
/** The lesson a family is registering for: sample label, schedule, location, ages and proposed tuition. */
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import { formatTuition, type Lesson } from '../../data/lessons';

interface Props {
  lesson: Lesson;
  class?: string;
}
const { lesson, class: className } = Astro.props;
const facts: [string, string][] = [
  ['Schedule', `${lesson.schedule} · ${lesson.length}`],
  ['Location', lesson.location],
  ['Ages', lesson.ages.join(', ')],
  ['Proposed tuition', formatTuition(lesson.proposedTuitionCents)],
];
---

<section
  aria-labelledby="lesson-summary-title"
  class:list={['rounded-[28px] bg-white p-6 ring-1 ring-sand sm:p-7', className]}
>
  {lesson.sample && <StatusPill kind="sample">Sample lesson</StatusPill>}
  <h2 id="lesson-summary-title" class="mt-4 text-xl font-bold">
    {lesson.title}
  </h2>
  <p class="mt-1 text-sm text-muted">
    {lesson.instrument} · {lesson.level} · {lesson.format}
  </p>
  <dl class="mt-5 space-y-3">
    {facts.map(([k, v]) => (
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-muted">{k}</dt>
        <dd class="mt-0.5 font-semibold">{v}</dd>
      </div>
    ))}
  </dl>
  <p class="mt-5 text-sm text-muted">
    Instructor compensation and any administrative allocation are always shown on separate lines before
    enrollment is confirmed. Reserving a spot is free.
  </p>
  {lesson.sample && (
    <p class="mt-3 text-sm font-semibold text-terracotta-deep">
      Sample lesson — registration is a demonstration in this preview.
    </p>
  )}
</section>
