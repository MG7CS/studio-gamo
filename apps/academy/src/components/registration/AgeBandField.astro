---
/** The student's age group (no birth dates are collected). Native select with a visible label. */
import { AGE_BAND_LABELS } from '@gamo/domain';
import { STUDENT_AGE_BANDS } from '@gamo/domain/types';

interface Props {
  value?: string;
  error?: string;
}
const { value = '', error } = Astro.props;
const id = 'student-age-band';
---

<div class="gamo-field">
  <label for={id} class="block text-[15px] font-semibold text-ink">
    Age group
    <span class="font-normal text-muted">
      <span aria-hidden="true">*</span>
      <span class="sr-only">(required)</span>
    </span>
  </label>
  <p id={`${id}-hint`} class="mt-1 text-sm text-muted">
    We ask for an age group only, never a birth date.
  </p>
  <select
    id={id}
    name="student_age_band"
    required
    aria-describedby={`${id}-hint ${id}-error`}
    aria-invalid={error ? 'true' : undefined}
    class:list={[
      'mt-2 block min-h-11 w-full rounded-xl border bg-white px-4 py-2.5 text-base text-ink',
      'focus:outline-none focus-visible:ring-2 focus-visible:ring-terracotta focus-visible:ring-offset-2',
      error ? 'border-2 border-terracotta-deep' : 'border-ink/50',
    ]}
  >
    <option value="" selected={!value}>
      Choose an age group
    </option>
    {STUDENT_AGE_BANDS.map((band) => (
      <option value={band} selected={value === band}>
        {AGE_BAND_LABELS[band]}
      </option>
    ))}
  </select>
  <p id={`${id}-error`} class="mt-1.5 text-sm font-semibold text-terracotta-deep" hidden={!error}>
    <span class="sr-only">Error: </span>
    {error}
  </p>
</div>
