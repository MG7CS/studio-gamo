---
/** Parent or guardian screen: the guardian's name (required by the server when the student is under 18). */
import Fieldset from '@studio-gamo/ui/components/forms/Fieldset.astro';
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';

interface Props {
  values: Record<string, string>;
  errors: Record<string, string>;
}
const { values, errors } = Astro.props;
---

<Fieldset
  id="guardian-section"
  legend="Parent or guardian"
  variant="section"
  hint="If the student is under 18, a parent or guardian fills in this part and the next one."
>
  <TextField
    id="guardian-name"
    name="guardian_name"
    label="Parent or guardian's full name"
    hint="Required when the student is under 18."
    autocomplete="name"
    maxlength={120}
    value={values.guardian_name}
    error={errors.guardian_name}
  />
</Fieldset>
