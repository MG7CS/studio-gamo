---
/**
 * One registration on the manage page: its facts plus the actions the family can take themselves —
 * update the contact phone, cancel (any time before the first lesson; a paid registration becomes a
 * refund request for staff) and billing (not available yet). Every action is a plain POST form.
 */
import type { AcademyRegistration } from '@gamo/domain';
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import RegistrationDetails from './RegistrationDetails.astro';

interface Props {
  registration: AcademyRegistration;
  lessonTitle: string;
  phoneError?: string;
}
const { registration: r, lessonTitle, phoneError } = Astro.props;
const active = r.status !== 'cancelled';
const phoneId = `phone-${r.id}`;
---

<article data-registration={r.reference}>
  <RegistrationDetails registration={r} lessonTitle={lessonTitle}>
    {active && (
      <div class="mt-6 grid gap-6 border-t border-sand pt-6 md:grid-cols-2">
        <form method="post" class="space-y-3">
          <input type="hidden" name="intent" value="phone" />
          <input type="hidden" name="registration_id" value={r.id} />
          <TextField
            id={phoneId}
            name="phone"
            type="tel"
            label="Contact phone"
            autocomplete="tel"
            inputmode="tel"
            maxlength={24}
            value={r.guardianPhone ?? ''}
            error={phoneError}
          />
          <SubmitButton label="Save phone" variant="secondary" pendingLabel="Saving…" />
        </form>
        <form method="post" class="space-y-3">
          <input type="hidden" name="intent" value="cancel" />
          <input type="hidden" name="registration_id" value={r.id} />
          <p class="text-[15px] font-semibold">Cancel this registration</p>
          <p class="text-sm text-muted">
            {r.status === 'paid'
              ? 'You can cancel any time before the first lesson. Because it was paid, our team will arrange the refund and email you.'
              : 'You can cancel any time before the first lesson. Nothing has been charged.'}
          </p>
          <SubmitButton label="Cancel registration" variant="secondary" pendingLabel="Cancelling…" />
        </form>
      </div>
    )}
    <div class="mt-6 rounded-2xl bg-ivory p-4 text-sm ring-1 ring-sand">
      <p class="font-semibold">Manage billing</p>
      <p class="mt-1 text-muted">
        Billing management is not available yet: there is no recurring billing for lessons. Questions about a
        payment? Write to{' '}
        <a href="mailto:hello@gamostudio.org" class="font-semibold text-terracotta-deep underline">
          hello@gamostudio.org
        </a>
        .
      </p>
    </div>
  </RegistrationDetails>
</article>
