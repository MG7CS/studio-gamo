---
/**
 * Part 3: consents. Enrollment Terms and Privacy Policy always; Guardian Consent and Child-Safety Consent
 * for a student under 18 (the server decides from the age group, so those two boxes are not `required`).
 * Marketing is separate, optional and never pre-ticked. Every box has a 44 px label row.
 */
import Fieldset from '@studio-gamo/ui/components/forms/Fieldset.astro';
import Checkbox from '@studio-gamo/ui/components/forms/Checkbox.astro';
import TermsConsent from '@studio-gamo/ui/components/forms/TermsConsent.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import type { TermsConsentDocument } from '@studio-gamo/ui/lib/terms-links';

interface Props {
  documents: {
    base: TermsConsentDocument[];
    guardian: TermsConsentDocument[];
    safety: TermsConsentDocument[];
  };
  errors: Record<string, string>;
}
const { documents, errors } = Astro.props;
---

<Fieldset
  id="agreements-section"
  legend="Agreements"
  variant="section"
  hint="These documents are drafts that still require legal review."
>
  <TermsConsent
    id="terms-accept"
    name="terms_accept"
    documents={documents.base}
    error={errors.terms_accept}
  />
  <Card tone="inset" padding="sm">
    <Fieldset id="under-18-consents" legend="For a student under 18 (parent or guardian)">
      <TermsConsent
        id="guardian-consent"
        name="guardian_consent"
        required={false}
        documents={documents.guardian}
        error={errors.guardian_consent}
      />
      <TermsConsent
        id="child-safety-consent"
        name="child_safety_consent"
        required={false}
        documents={documents.safety}
        error={errors.child_safety_consent}
      />
    </Fieldset>
  </Card>
  <Checkbox
    id="marketing-opt-in"
    name="marketing_opt_in"
    label="Send me occasional news about Gamo Academy lessons and programs"
    hint="Optional. You can unsubscribe at any time."
  />
</Fieldset>
