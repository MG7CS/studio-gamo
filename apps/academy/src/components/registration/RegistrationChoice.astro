---
/**
 * The two ways to finish: "Reserve my spot" (free, works everywhere) or "Pay now" (Stripe Checkout test mode,
 * shown only while the test path is open). Both are plain submit buttons with `name="choice"`.
 */
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';

interface Props {
  payAvailable: boolean;
  amountLabel?: string | null;
}
const { payAvailable, amountLabel } = Astro.props;
---

<div class="space-y-3">
  <div class="flex flex-col gap-3 sm:flex-row">
    <SubmitButton name="choice" value="reserve" label="Reserve my spot" pendingLabel="Reserving…" />
    {payAvailable && amountLabel && (
      <SubmitButton
        name="choice"
        value="pay"
        variant="secondary"
        label={`Pay ${amountLabel} now (test mode)`}
        pendingLabel="Opening checkout…"
      />
    )}
  </div>
  <p class="text-sm text-muted">
    Reserving is free and nothing is charged.
    {payAvailable
      ? ' "Pay now" uses Stripe in test mode: no real card is charged.'
      : ' Online payment is not available yet.'}
  </p>
</div>
