---
/** Part 1 of the form: the student's first name and age group. */
import TextField from '@studio-gamo/ui/components/forms/TextField.astro';
import AgeBandField from './AgeBandField.astro';

interface Props {
  values: Record<string, string>;
  errors: Record<string, string>;
}
const { values, errors } = Astro.props;
---

<fieldset class="space-y-5">
  <legend class="text-lg font-bold">Student</legend>
  <TextField
    id="student-first-name"
    name="student_first_name"
    label="Student's first name"
    hint="First name only."
    autocomplete="off"
    maxlength={80}
    required
    value={values.student_first_name}
    error={errors.student_first_name}
  />
  <AgeBandField value={values.student_age_band} error={errors.student_age_band} />
</fieldset>
