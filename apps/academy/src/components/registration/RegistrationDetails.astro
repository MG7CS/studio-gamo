---
/** Read-only facts of one registration (receipt and manage pages). No email address is shown. */
import type { AcademyRegistration } from '@gamo/domain';
import { AGE_BAND_LABELS } from '@gamo/domain';
import { STATUS_LABELS, formatAmount } from '../../lib/registration';

interface Props {
  registration: AcademyRegistration;
  lessonTitle: string;
  headingLevel?: 'h2' | 'h3';
}
const { registration: r, lessonTitle, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const facts: [string, string][] = [
  ['Reference', r.reference],
  ['Status', STATUS_LABELS[r.status] ?? r.status],
  ['Student', `${r.studentFirstName} (${AGE_BAND_LABELS[r.studentAgeBand]})`],
  ['Location', r.location],
  ...(r.scheduleText ? ([['Schedule', r.scheduleText]] as [string, string][]) : []),
  ...(r.guardianName ? ([['Parent or guardian', r.guardianName]] as [string, string][]) : []),
  ...(r.amountCents > 0 ? ([['Amount', formatAmount(r.amountCents, r.currency)]] as [string, string][]) : []),
];
---

<section class="rounded-[28px] bg-white p-6 ring-1 ring-sand sm:p-7">
  <Heading class="text-xl font-bold">{lessonTitle}</Heading>
  <dl class="mt-4 grid gap-3 sm:grid-cols-2">
    {facts.map(([k, v]) => (
      <div class="min-w-0">
        <dt class="text-xs font-semibold uppercase tracking-wide text-muted">{k}</dt>
        <dd class="mt-0.5 break-words font-semibold" data-registration-fact={k.toLowerCase()}>
          {v}
        </dd>
      </div>
    ))}
  </dl>
  <slot />
</section>
