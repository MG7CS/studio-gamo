---
/**
 * Local multi-step demo form. Each step is a named slot `step-0`, `step-1`… .
 * Nothing is submitted: the final button reveals a confirmation that states nothing was sent.
 * Without JS all steps remain visible.
 */
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
interface Props { id: string; steps: string[]; doneTitle: string; doneBody: string }
const { id, steps, doneTitle, doneBody } = Astro.props;
const panels = await Promise.all(steps.map((_, i) => Astro.slots.render(`step-${i}`)));
---
<div class="demo-stepper rounded-[32px] bg-white p-6 ring-1 ring-sand sm:p-10" data-stepper id={id}>
  <ol class="mb-8 flex gap-2" aria-label="Progress">
    {steps.map((s, i) => (
      <li class="flex-1" data-dot={i}>
        <span class="block h-1.5 rounded-full bg-cream transition-colors" data-bar></span>
        <span class="mt-2 hidden text-xs font-semibold text-ink-soft sm:block">{i + 1}. {s}</span>
      </li>
    ))}
  </ol>
  <form novalidate onsubmit="return false">
    {panels.map((html, i) => (
      <fieldset data-step={i} class="space-y-5">
        <legend class="mb-5 text-2xl font-bold tracking-tight"><span class="text-terracotta">Step {i + 1} of {steps.length}.</span> {steps[i]}</legend>
        <Fragment set:html={html} />
      </fieldset>
    ))}
    <div data-done hidden class="py-6 text-center" tabindex="-1">
      <p class="eyebrow text-terracotta">Submitted</p>
      <h2 class="section-subheading mt-3">{doneTitle}</h2>
      <p class="mx-auto mt-3 max-w-lg text-ink-soft">{doneBody}</p>
    </div>
    <div class="mt-8 flex items-center justify-between gap-3 border-t border-sand pt-6" data-nav>
      <button type="button" data-back class="rounded-full border border-charcoal/20 px-5 py-3 text-sm font-semibold disabled:opacity-40">Back</button>
      <button type="button" data-next class="rounded-full bg-terracotta px-6 py-3 text-sm font-semibold text-white hover:bg-terracotta-dark">Next</button>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const bars = [...root.querySelectorAll<HTMLElement>('[data-bar]')];
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    let cur = 0;
    const render = () => {
      steps.forEach((s, i) => (s.hidden = i !== cur));
      bars.forEach((b, i) => b.classList.toggle('bg-terracotta', i <= cur));
      back.disabled = cur === 0;
      next.textContent = cur === steps.length - 1 ? 'Submit' : 'Next';
    };
    next.addEventListener('click', () => {
      const controls = steps[cur].querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea');
      for (const control of controls) { if (!control.reportValidity()) return; }
      if (cur < steps.length - 1) { cur++; render(); steps[cur].querySelector<HTMLElement>('input,select,textarea')?.focus(); return; }
      steps.forEach((s) => (s.hidden = true));
      root.querySelector<HTMLElement>('[data-nav]')!.hidden = true;
      done.hidden = false; done.focus();
    });
    back.addEventListener('click', () => { if (cur > 0) { cur--; render(); } });
    render();
  });
</script>
