---
/** Instrument discovery card: photo card when a matching photo exists, otherwise a typographic/icon treatment. */
import Photo from '@studio-gamo/ui/components/Photo.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import type { Instrument } from '../../data/instruments';
interface Props { instrument: Instrument; size?: 'sm' | 'lg'; class?: string }
const { instrument: i, size = 'lg', class: className } = Astro.props;
const tall = size === 'lg' ? 'min-h-[280px] sm:min-h-[300px]' : 'min-h-[220px]';
---
<a href={`/instruments/${i.slug}`} class:list={['group relative flex flex-col justify-end overflow-hidden rounded-[28px] ring-1 ring-sand transition-transform duration-300 hover:-translate-y-1', tall, i.photo ? 'bg-charcoal text-white' : `${i.tint} text-charcoal`, className]}>
  {i.photo ? (
    <>
      <Photo name={i.photo} sizes="(min-width:1024px) 30vw, (min-width:640px) 50vw, 100vw" position={i.photoPosition} alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-charcoal/85 to-transparent" aria-hidden="true"></div>
    </>
  ) : (
    <div aria-hidden="true" class="absolute inset-0 overflow-hidden">
      <span class="absolute -right-6 -top-8 select-none text-[9rem] font-black leading-none tracking-tighter text-white/55">{i.short}</span>
      <span class="absolute right-6 top-24 grid h-20 w-20 place-items-center rounded-full bg-white/70 text-terracotta shadow-float">
        <Icon name={i.icon} class="h-9 w-9" />
      </span>
    </div>
  )}
  <div class="relative p-6">
    <p class:list={['text-xs font-semibold uppercase tracking-[0.16em]', i.photo ? 'text-gold' : 'text-terracotta']}>{i.ages}</p>
    <h3 class="mt-2 text-2xl font-bold tracking-tight">{i.name}</h3>
    {size === 'lg' && <p class:list={['mt-2 max-w-xs text-sm leading-relaxed', i.photo ? 'text-white/80' : 'text-ink-soft']}>{i.blurb}</p>}
    <span class:list={['mt-4 inline-flex items-center gap-2 text-sm font-semibold', i.photo ? 'text-white' : 'text-charcoal']}>
      Explore {i.short.toLowerCase()} <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
