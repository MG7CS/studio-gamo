---
/**
 * Instrument card recipe. With a genuinely matching photo it is a MediaCard (the photo is a Frame; text on
 * its scrim, readable on bright photos); without one it is a LinkCard with the instrument's icon, never a bare
 * typographic "ghost" word. The whole card is one link to the instrument page.
 */
import MediaCard from '@studio-gamo/ui/components/content/MediaCard.astro';
import LinkCard from '@studio-gamo/ui/components/content/LinkCard.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import type { Instrument } from '../../data/instruments';

interface Props {
  instrument: Instrument;
  headingLevel?: 'h2' | 'h3' | 'h4';
  as?: 'div' | 'article' | 'li';
  class?: string;
}
const { instrument: i, headingLevel = 'h3', as = 'li', class: className } = Astro.props;
const href = `/instruments/${i.slug}`;
---

{i.photo ? (
  <MediaCard
    as={as}
    href={href}
    title={i.name}
    headingLevel={headingLevel}
    variant="overlay"
    image={{ name: i.photo, alt: '' }}
    class={className}
  >
    <Badge slot="on-media" tone="neutral">
      {i.ages}
    </Badge>
    <p>{i.blurb}</p>
    <span slot="meta" class="inline-flex items-center gap-2 font-semibold">
      Explore {i.short.toLowerCase()}
      <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
    </span>
  </MediaCard>
) : (
  <LinkCard as={as} href={href} title={i.name} headingLevel={headingLevel} tone="inset" class={className}>
    <p class="mb-2 text-small font-semibold text-fg-muted">{i.ages}</p>
    <p>{i.blurb}</p>
    <Fragment slot="meta">Explore {i.short.toLowerCase()}</Fragment>
  </LinkCard>
)}
