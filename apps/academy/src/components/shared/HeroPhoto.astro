---
/**
 * Photo for the shared PageHero `media` slot on Academy interior pages: one shared Frame (rounded
 * rectangle, catalog focal point) and the page's priority image.
 *
 * Usage:
 *   <HeroPhoto slot="media" photo="instrumentPianoKeyboard" />
 *   <HeroPhoto slot="media" photo="instrumentMusicTheory" alt="Open music book on a piano desk" ratio="portrait" />
 */
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import { photos, type PhotoKey } from '@studio-gamo/ui/lib/images';

interface Props {
  photo: PhotoKey;
  /** Omit for the catalog description. */
  alt?: string;
  ratio?: 'landscape' | 'portrait' | 'square';
}
const { photo, alt, ratio } = Astro.props;
// Landscape unless the photo is tall-only; a frame ratio the photo does not allow throws at render.
const shape = ratio ?? (photos[photo].ratios.includes('landscape') ? 'landscape' : 'square');
---

<Frame photo={photo} ratio={shape} sizes="half" alt={alt ?? photos[photo].alt} priority />
