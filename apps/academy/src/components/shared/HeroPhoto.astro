---
/**
 * Photo for the shared PageHero `media` slot on Academy interior pages: one shared Frame (rounded
 * rectangle, catalog focal point) and the page's priority image.
 *
 * Usage:
 *   <HeroPhoto slot="media" photo="youngPianist" />
 *   <HeroPhoto slot="media" photo="guitarMentor" alt="Guitar instructor with a student" ratio="portrait" />
 */
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import { photos, type PhotoKey } from '@studio-gamo/ui/lib/images';

interface Props {
  photo: PhotoKey;
  /** Omit for the catalog description. */
  alt?: string;
  ratio?: 'landscape' | 'portrait' | 'square';
}
const { photo, alt, ratio = 'landscape' } = Astro.props;
---

<Frame photo={photo} ratio={ratio} sizes="half" alt={alt ?? photos[photo].alt} priority />
