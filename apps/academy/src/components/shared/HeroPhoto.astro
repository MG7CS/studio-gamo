---
/**
 * Photo for the shared PageHero `media` slot on Academy interior pages: one shared Frame (rounded rectangle, catalog
 * focal point, and the page's priority image). The frame shape follows the photo's own shape (the Frame default), and
 * the alt text is the catalog description unless one is passed.
 *
 * Usage:
 *   <HeroPhoto slot="media" photo="youngPianist" />
 */
import Frame from '@studio-gamo/ui/components/media/Frame.astro';
import { photos, type PhotoKey } from '@studio-gamo/ui/lib/images';

interface Props {
  photo: PhotoKey;
  /** Omit for the catalog description. */
  alt?: string;
}
const { photo, alt } = Astro.props;
---

<Frame photo={photo} sizes="half" alt={alt ?? photos[photo].alt} priority />
