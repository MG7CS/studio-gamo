---
/**
 * Interior page hero: one rounded panel with breadcrumb, pill eyebrow, title and lede.
 * With a photo, the photo comes first on phones and sits on the right on desktop.
 */
import type { PhotoKey } from '@studio-gamo/ui/lib/images';
import Panel from './Panel.astro';
import MediaText from './MediaText.astro';
import SectionIntro from './SectionIntro.astro';
import Breadcrumb from './Breadcrumb.astro';
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  lede: string;
  photo?: PhotoKey;
  photoPosition?: string;
  crumbs?: { label: string; href: string }[];
}
const { eyebrow, title, accent, lede, photo, photoPosition, crumbs = [] } = Astro.props;
---

<section class="px-4 page-intro-space sm:px-8">
  <Panel tone="ivory" class="mx-auto max-w-[1320px]">
    {photo ? (
      <MediaText photo={photo} photoPosition={photoPosition} priority split="text" aspect="tall">
        <Breadcrumb crumbs={crumbs} class="mb-5" />
        <SectionIntro as="h1" size="page" eyebrow={eyebrow} title={title} accent={accent} lede={lede}>
          <slot />
        </SectionIntro>
      </MediaText>
    ) : (
      <div>
        <Breadcrumb crumbs={crumbs} class="mb-5" />
        <SectionIntro as="h1" size="page" eyebrow={eyebrow} title={title} accent={accent} lede={lede}>
          <slot />
        </SectionIntro>
      </div>
    )}
  </Panel>
</section>
