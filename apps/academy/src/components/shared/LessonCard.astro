---
/**
 * Sample lesson card recipe (LinkCard: the title link covers the whole card, ≥ 44 px target).
 * The wrapper carries the data-* attributes the /lessons filters read; pass `hidden` to render it
 * filtered out (e.g. a filter preset from the URL).
 */
import LinkCard from '@studio-gamo/ui/components/content/LinkCard.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import { formatTuition, type Lesson } from '../../data/lessons';
import { instructorBySlug } from '../../data/instructors';

interface Props {
  lesson: Lesson;
  /** Heading level for the lesson title, following the page outline. Default h3. */
  headingLevel?: 'h2' | 'h3' | 'h4';
  as?: 'li' | 'div';
  hidden?: boolean;
}
const { lesson: l, headingLevel = 'h3', as: Tag = 'li', hidden = false } = Astro.props;
const t = instructorBySlug(l.instructorSlug);
const facts: [string, string][] = [
  ['Schedule', l.schedule],
  ['Ages', l.ages.join(', ')],
  ['Instructor', t?.name ?? ''],
];
---

<Tag
  data-lesson
  data-instrument={l.instrumentSlug}
  data-level={l.level}
  data-format={l.format}
  data-ages={l.ages.join(',')}
  hidden={hidden}
  class="flex"
>
  <LinkCard href={`/lessons/${l.slug}`} title={l.title} headingLevel={headingLevel} class="w-full">
    <Fragment slot="eyebrow">
      {l.sample && <Badge tone="sample">Sample lesson</Badge>}
      <Badge>{l.format}</Badge>
      <Badge>{l.level}</Badge>
    </Fragment>
    <p>{l.summary}</p>
    <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-border pt-4">
      {facts.map(([k, v]) => (
        <div>
          <dt class="text-caption">{k}</dt>
          <dd class="font-medium text-fg">{v}</dd>
        </div>
      ))}
      <div>
        <dt class="text-caption">Tuition</dt>
        <dd class="flex flex-wrap items-center gap-2 font-medium text-fg">
          {formatTuition(l.proposedTuitionCents)}
          <Badge tone="proposal" size="sm" />
        </dd>
      </div>
    </dl>
    <Fragment slot="meta">{l.instrument}</Fragment>
  </LinkCard>
</Tag>
