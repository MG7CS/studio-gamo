---
/** Sample instructor card with initials avatar (no photos of real or fictional faces). */
import Icon from '@studio-gamo/ui/components/Icon.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import type { Instructor } from '../../data/instructors';
interface Props {
  instructor: Instructor;
  class?: string;
}
const { instructor: t, class: className } = Astro.props;
---

<a
  href={`/instructors/${t.slug}`}
  class:list={[
    'group flex h-full flex-col rounded-[28px] bg-white p-6 ring-1 ring-sand transition-shadow hover:shadow-float',
    className,
  ]}
>
  <div class="flex items-center justify-between">
    <span
      aria-hidden="true"
      class:list={[
        'grid h-16 w-16 place-items-center rounded-[22px_22px_22px_6px] text-xl font-bold',
        t.tone,
      ]}
    >
      {t.initials}
    </span>
    <StatusPill kind="verified">Instructor</StatusPill>
  </div>
  <h3 class="mt-5 text-xl font-bold tracking-tight">{t.name}</h3>
  <p class="mt-1 text-sm font-medium text-terracotta">{t.instruments.join(' · ')}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{t.bio}</p>
  <ul class="mt-4 flex flex-wrap gap-2 text-xs font-medium text-charcoal/80">
    <li class="rounded-full bg-cream px-3 py-1">{t.teaches}</li>
    {t.formats.map((f) => (
      <li class="rounded-full bg-cream px-3 py-1">{f}</li>
    ))}
  </ul>
  <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold">
    View profile <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </span>
</a>
