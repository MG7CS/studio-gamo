---
/** Instructor card recipe (LinkCard), titled by role. No photos of faces and no decorative avatar. */
import LinkCard from '@studio-gamo/ui/components/content/LinkCard.astro';
import { joinAgeGroups } from '@gamo/config/academy-levels';
import { instructorFormatLabels, type Instructor } from '../../data/instructors';

interface Props {
  instructor: Instructor;
  headingLevel?: 'h2' | 'h3' | 'h4';
  as?: 'div' | 'article' | 'li';
  class?: string;
}
const { instructor: t, headingLevel = 'h3', as = 'article', class: className } = Astro.props;
---

<LinkCard
  as={as}
  href={`/instructors/${t.slug}`}
  title={t.name}
  headingLevel={headingLevel}
  class={className}
>
  <p class="font-medium text-action-strong">{t.instruments.join(' · ')}</p>
  <p class="mt-3">{t.bio}</p>
  <p class="mt-4 text-small text-fg-muted">
    {[joinAgeGroups(t.ageGroups), ...instructorFormatLabels(t)].join(' · ')}
  </p>
  <Fragment slot="meta">View profile</Fragment>
</LinkCard>
