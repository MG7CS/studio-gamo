---
/** Sample instructor card recipe (LinkCard). No photos of real or fictional faces and no decorative avatar. */
import LinkCard from '@studio-gamo/ui/components/content/LinkCard.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import type { Instructor } from '../../data/instructors';

interface Props {
  instructor: Instructor;
  headingLevel?: 'h2' | 'h3' | 'h4';
  as?: 'div' | 'article' | 'li';
  class?: string;
}
const { instructor: t, headingLevel = 'h3', as = 'article', class: className } = Astro.props;
---

<LinkCard
  as={as}
  href={`/instructors/${t.slug}`}
  title={t.name}
  headingLevel={headingLevel}
  class={className}
>
  <Badge tone="sample" class="mb-3">
    Sample instructor
  </Badge>
  <p class="font-medium text-action-strong">{t.instruments.join(' · ')}</p>
  <p class="mt-3">{t.bio}</p>
  <p class="mt-4 text-small text-fg-muted">{[t.teaches, ...t.formats].join(' · ')}</p>
  <Fragment slot="meta">View profile</Fragment>
</LinkCard>
