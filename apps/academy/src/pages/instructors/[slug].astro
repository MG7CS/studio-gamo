---
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import { clampDescription } from '@studio-gamo/ui/lib/seo';
import Layout from '../../layouts/Layout.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import NumberedSteps from '@studio-gamo/ui/components/content/NumberedSteps.astro';
import LessonCard from '../../components/shared/LessonCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { instructors, type Instructor } from '../../data/instructors';
import { lessons } from '../../data/lessons';

// Rendered on demand (not prerendered) so the page gets the same security and cache headers
// as every other HTML response; unknown slugs render the branded 404 page.
const found = instructors.find((item) => item.slug === Astro.params.slug);
if (!found) return Astro.rewrite('/404');
const t: Instructor = found;
const taught = lessons.filter((l) => l.instructorSlug === t.slug);
const details = [
  ['users', t.teaches],
  ['video', t.formats.join(', ')],
] as const;
---

<Layout
  title={t.name}
  description={clampDescription(`Gamo Academy ${t.name.toLowerCase()} profile: ${t.teaches}. ${t.bio}`)}
>
  <Container class="page-intro-space" data-heading-case="as-written">
    <div class="grid gap-10 lg:grid-cols-3">
      <Card as="aside" padding="lg" class="lg:sticky lg:top-28 lg:self-start">
        <span
          aria-hidden="true"
          class:list={['grid size-28 place-items-center rounded-hero rounded-bl-lg', t.tone]}
        >
          <Icon name={t.icon} class="size-12" />
        </span>
        <h1 class="mt-6 text-3xl font-bold tracking-tight">{t.name}</h1>
        <p class="mt-1 font-medium text-action-strong">{t.instruments.join(' · ')}</p>
        <ul class="mt-6 space-y-3 text-small">
          {details.map(([icon, text]) => (
            <li class="flex items-center gap-2">
              <Icon name={icon} class="size-4 text-action-strong" />
              {text}
            </li>
          ))}
        </ul>
        <ButtonLink href={siteUrl('academy', '/lessons')} class="mt-8 w-full justify-center" arrow>
          Find a lesson
        </ButtonLink>
      </Card>
      <div class="min-w-0 lg:col-span-2">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-x-2 text-small text-fg-muted">
            <li class="flex items-center gap-x-2">
              <a
                href="/"
                class="inline-flex min-h-11 items-center underline-offset-4 hover:text-fg hover:underline"
              >
                Academy
              </a>
              <span aria-hidden="true">/</span>
            </li>
            <li class="flex items-center gap-x-2">
              <a
                href="/lessons"
                class="inline-flex min-h-11 items-center underline-offset-4 hover:text-fg hover:underline"
              >
                Lessons
              </a>
              <span aria-hidden="true">/</span>
            </li>
            <li>
              <span class="inline-flex min-h-11 items-center font-semibold text-fg" aria-current="page">
                {t.name}
              </span>
            </li>
          </ol>
        </nav>
        <h2 class="section-heading mt-4 text-balance">{t.bio}</h2>
        <h3 class="section-subheading mt-12">Teaching Approach</h3>
        <NumberedSteps
          items={t.approach.map((title) => ({ title }))}
          headingLevel="h4"
          tone="inset"
          class="mt-6"
        />
        <h3 class="section-subheading mt-12">Available Lessons</h3>
        <FeatureGrid as="ul" max={2} class="mt-6">
          {taught.map((l) => (
            <LessonCard lesson={l} headingLevel="h4" />
          ))}
        </FeatureGrid>
      </div>
    </div>
  </Container>
</Layout>
