---
import { clampDescription } from '@studio-gamo/ui/lib/seo';
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import Layout from '../../layouts/Layout.astro';
import Panel from '../../components/shared/Panel.astro';
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import SectionIntro from '../../components/shared/SectionIntro.astro';
import LessonCard from '../../components/shared/LessonCard.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { instructors, type Instructor } from '../../data/instructors';
import { lessons } from '../../data/lessons';

// Rendered on demand (not prerendered) so the page gets the same security and cache headers
// as every other HTML response; unknown slugs render the branded 404 page.
const found = instructors.find((item) => item.slug === Astro.params.slug);
if (!found) return Astro.rewrite('/404');
const t: Instructor = found;
const taught = lessons.filter((l) => l.instructorSlug === t.slug);
const details = [
  ['pin', t.city],
  ['users', t.teaches],
  ['video', t.formats.join(', ')],
] as const;
---

<Layout
  title={t.name}
  description={clampDescription(`Sample Gamo Academy instructor profile: ${t.name}, ${t.teaches}. ${t.bio}`)}
>
  <section class="px-4 page-intro-space sm:px-8">
    <div class="mx-auto max-w-[1320px]">
      <Breadcrumb
        class="mb-5"
        crumbs={[
          { label: 'Lessons', href: '/lessons' },
          { label: t.name, href: `/instructors/${t.slug}` },
        ]}
      />
      <div class="grid gap-4 lg:grid-cols-[320px_minmax(0,1fr)]">
        <Panel as="aside" pad="md" class="lg:sticky lg:top-32 lg:self-start">
          <span
            aria-hidden="true"
            class:list={['grid h-24 w-24 place-items-center rounded-[36px] text-3xl font-bold', t.tone]}
          >
            {t.initials}
          </span>
          <div class="mt-4">
            <StatusPill kind="sample">Sample instructor</StatusPill>
          </div>
          <h1 class="academy-title-page mt-3">{t.name}</h1>
          <p class="mt-1 font-medium text-terracotta">{t.instruments.join(' · ')}</p>
          <ul class="mt-5 space-y-2 text-sm">
            {details.map(([icon, text]) => (
              <li class="flex items-center gap-2">
                <Icon name={icon} class="h-4 w-4 shrink-0 text-terracotta" />
                {text}
              </li>
            ))}
          </ul>
          <ButtonLink href={inquiryUrl('Lesson interest')} class="mt-6 w-full" arrow>
            Ask about lessons
          </ButtonLink>
        </Panel>
        <div class="grid gap-4">
          <Panel>
            <SectionIntro eyebrow="About" title={t.bio} size="sub" />
          </Panel>
          <Panel>
            <SectionIntro eyebrow="Approach" title="How lessons go" size="sub" />
            <ol class="mt-5 grid gap-3 sm:grid-cols-3">
              {t.approach.map((a, i) => (
                <li class="rounded-2xl bg-ivory p-4 ring-1 ring-sand">
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-cream text-sm font-bold text-terracotta-dark">
                    {i + 1}
                  </span>
                  <p class="mt-3 font-semibold leading-snug">{a}</p>
                </li>
              ))}
            </ol>
          </Panel>
          {taught.length > 0 && (
            <div>
              <SectionIntro eyebrow="Lessons" title={`Lessons with ${t.name.split(' ')[0]}`} size="sub" />
              <div class="mt-5 grid gap-4 md:grid-cols-2">
                {taught.map((l) => (
                  <LessonCard lesson={l} />
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>
