---
import Layout from '../layouts/Layout.astro';
import DashboardOverview from '../components/dashboard/DashboardOverview.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
---
<Layout title="Student dashboard (sample)" description="Sample Gamo Academy student dashboard for design review.">
  <section class="px-4 pb-20 pt-28 sm:px-8 lg:pt-36">
    <div class="mx-auto max-w-[1320px]">
      <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
        <div>
          <p class="eyebrow text-terracotta">Student dashboard · sample</p>
          <h1 class="display-lg mt-3">Welcome back, <span class="text-terracotta">Ava.</span></h1>
          <p class="mt-3 text-lg text-ink-soft">Piano · Beginner · with Maya Thompson (sample instructor)</p>
        </div>
        <ButtonLink href="/lessons" variant="secondary" arrow>Explore more lessons</ButtonLink>
      </div>
      <DemoNotice class="my-8" title="Sample dashboard">Ava is a fictional student. Accounts and sign-in are not available yet.</DemoNotice>
      <DashboardOverview />
    </div>
  </section>
</Layout>
