---
import Layout from '../layouts/Layout.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import ClosingCta from '../components/shared/ClosingCta.astro';
import AcademyHero from '../components/home/AcademyHero.astro';
import InstrumentDiscovery from '../components/home/InstrumentDiscovery.astro';
import LearningPaths from '../components/home/LearningPaths.astro';
import InstructionFormats from '../components/home/InstructionFormats.astro';
import InstructorsPreview from '../components/home/InstructorsPreview.astro';
import HowLessonsWork from '../components/home/HowLessonsWork.astro';
import SponsoredPrograms from '../components/home/SponsoredPrograms.astro';
import ChurchHosted from '../components/home/ChurchHosted.astro';
import AcademyFaq from '../components/home/AcademyFaq.astro';
---

<Layout description="Patient music lessons for kids, teens and adults: private or small group, online or close to home, with church-hosted and sponsored classes proposed.">
  <AcademyHero />
  <InstrumentDiscovery />
  <LearningPaths />
  <InstructionFormats />
  <InstructorsPreview />
  <HowLessonsWork />
  <SponsoredPrograms />
  <ChurchHosted />
  <AcademyFaq />
  <ClosingCta
    eyebrow="Start here"
    title="Your first song"
    accent="is closer than you think."
    body="Pick an instrument, meet an instructor and start learning."
    photo="girlGuitar"
  >
    <ButtonLink href="/instruments" size="lg" arrow>
      Choose an instrument
    </ButtonLink>
    <ButtonLink href="/lessons" size="lg" variant="secondary">
      Browse lessons
    </ButtonLink>
  </ClosingCta>
</Layout>
