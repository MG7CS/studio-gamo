---
import Layout from '../layouts/Layout.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import AcademyHero from '../components/home/AcademyHero.astro';
import InstrumentDiscovery from '../components/home/InstrumentDiscovery.astro';
import LearningPaths from '../components/home/LearningPaths.astro';
import InstructionFormats from '../components/home/InstructionFormats.astro';
import InstructorsPreview from '../components/home/InstructorsPreview.astro';
import HowLessonsWork from '../components/home/HowLessonsWork.astro';
import SponsoredPrograms from '../components/home/SponsoredPrograms.astro';
import ChurchHosted from '../components/home/ChurchHosted.astro';
import FamilyJourney from '../components/home/FamilyJourney.astro';
import AcademyFaq from '../components/home/AcademyFaq.astro';
---
<Layout description="Gamo Academy: friendly music lessons for children, teens and adults — piano, guitar, bass, drums and vocals. A proposed nonprofit program of Gamo Studios.">
  <AcademyHero />
  <InstrumentDiscovery />
  <LearningPaths />
  <InstructionFormats />
  <InstructorsPreview />
  <HowLessonsWork />
  <SponsoredPrograms />
  <ChurchHosted />
  <FamilyJourney />
  <AcademyFaq />
  <CtaInvitation eyebrow="Start your music journey" title="Your first song is closer than you think." body="Explore instruments, meet our instructors and register your family in five guided steps." photo="girlGuitar">
    <ButtonLink href="/instruments" size="lg" arrow>Choose an instrument</ButtonLink>
    <ButtonLink href="/register" size="lg" variant="secondary">Register now</ButtonLink>
  </CtaInvitation>
</Layout>
