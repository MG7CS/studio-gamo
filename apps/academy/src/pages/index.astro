---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold mb-4">Gamo Academy</h1>
    <p class="text-xl text-[#6B6B67] mb-8">Elevating worship through world-class instruction.</p>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="bg-white border border-[#DED6CC] p-6 rounded-xl">
        <h2 class="text-2xl font-bold mb-2">Private Lessons</h2>
        <p class="text-[#6B6B67] mb-4">One-on-one instruction with our vetted roster of professional musicians.</p>
        <a href="/lessons" class="text-[#B65B35] font-bold hover:underline">Browse Instructors &rarr;</a>
      </div>
      <div class="bg-white border border-[#DED6CC] p-6 rounded-xl">
        <h2 class="text-2xl font-bold mb-2">Church Clinics</h2>
        <p class="text-[#6B6B67] mb-4">Host an intensive workshop at your facility for your whole team.</p>
        <a href="/clinics" class="text-[#B65B35] font-bold hover:underline">Learn More &rarr;</a>
      </div>
    </div>
  </main>
</Layout>
