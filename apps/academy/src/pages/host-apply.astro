---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-2xl mx-auto py-12 px-4">
    <h1 class="text-3xl font-bold mb-8">Host an Academy Clinic</h1>
    <form class="space-y-6">
      <div>
        <label class="block text-sm font-bold mb-2">Church Name</label>
        <input type="text" class="w-full border p-3 rounded-lg" />
      </div>
      <button class="bg-[#B65B35] text-white px-6 py-3 rounded-lg font-bold">Submit Application</button>
    </form>
  </main>
</Layout>
