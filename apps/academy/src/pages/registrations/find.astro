---
/**
 * Find a registration (recovery): email → same-origin, per-IP limit, Turnstile, per-email limit → when the
 * address has registrations, an email with a 30-minute `customer:all` link. The answer is always the same
 * 303 to `?sent=1` ("If we have registrations for that address…"), so the page never reveals whether an
 * address is known.
 */
import { requireSameOrigin } from '@gamo/auth';
import {
  getRuntimeEnv,
  guardPublicFormForPage,
  REGISTRATION_RECOVERY_MESSAGE,
  sendRegistrationRecovery,
  TURNSTILE_RESPONSE_FIELD,
} from '@gamo/domain';
import { isPlausibleEmail, normalizeEmail } from '@gamo/domain/security';
import { siteOrigin } from '@studio-gamo/ui/lib/sites';
import EmailField from '@studio-gamo/ui/components/forms/EmailField.astro';
import FormErrorSummary from '@studio-gamo/ui/components/forms/FormErrorSummary.astro';
import SubmitButton from '@studio-gamo/ui/components/forms/SubmitButton.astro';
import TurnstileWidget from '@studio-gamo/ui/components/forms/TurnstileWidget.astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import RegistrationNotice from '../../components/registration/RegistrationNotice.astro';
import { nowSeconds, registrationDb } from '../../lib/registration';

export const prerender = false;

const env = Astro.locals.runtimeEnv ?? (await getRuntimeEnv(Astro));
const sent = Astro.url.searchParams.get('sent') === '1';
let email = '';
let emailError: string | undefined;
let turnstileError: string | undefined;
let summary: { message: string; fieldId?: string }[] = [];

if (Astro.request.method === 'POST') {
  try {
    requireSameOrigin(Astro.request);
    const guard = await guardPublicFormForPage(
      { request: Astro.request, env, locals: Astro.locals },
      {
        route: 'academy.registrations.find',
        turnstileAction: 'registrations_find',
        limits: {
          perIp: { limit: 10, windowSeconds: 10 * 60 },
          perEmail: { limit: 3, windowSeconds: 60 * 60 },
        },
      },
    );
    if (!guard.ok) {
      Astro.response.status = guard.error.status;
      for (const [k, v] of Object.entries(guard.error.headers)) Astro.response.headers.set(k, v);
      if (guard.error.field === TURNSTILE_RESPONSE_FIELD) turnstileError = guard.error.message;
      summary = [{ message: guard.error.message, fieldId: guard.error.fieldId }];
      email = '';
    } else {
      email = guard.body.get('email') ?? '';
      if (!isPlausibleEmail(normalizeEmail(email))) {
        Astro.response.status = 400;
        emailError = 'Enter the email address you registered with, in the format name@example.com.';
        summary = [{ message: emailError, fieldId: 'email' }];
      } else {
        try {
          await sendRegistrationRecovery(registrationDb(env), env, {
            email,
            origin: siteOrigin('academy'),
            now: nowSeconds(),
            ipHash: guard.ipHash,
          });
        } catch (err) {
          // Same answer either way (no enumeration); the failure is logged by name only.
          console.error(`[academy.registrations.find] ${(err as Error)?.name ?? 'Error'}`);
        }
        return Astro.redirect('/registrations/find?sent=1', 303);
      }
    }
  } catch (err) {
    console.error(`[academy.registrations.find] ${(err as Error)?.name ?? 'Error'}`);
    Astro.response.status = 503;
    summary = [{ message: 'This form is temporarily unavailable. Please try again later.' }];
  }
}
---

<Layout
  title="Find your registration"
  description="Get a link to view, update or cancel a Gamo Academy registration."
  noindex
>
  <PageHero
    eyebrow="Gamo Academy · Registration"
    title="Find your registration"
    lede="Enter the email address you registered with. We'll email you a private link to your registrations."
  />
  <section class="px-4 pb-16 sm:px-8 lg:pb-24">
    <div class="mx-auto max-w-xl space-y-6">
      {sent && (
        <RegistrationNotice tone="success" title="Check your email">
          <p>{REGISTRATION_RECOVERY_MESSAGE}</p>
          <p>Can't find it? Check your spam folder, or try again in a few minutes.</p>
        </RegistrationNotice>
      )}
      <form method="post" class="space-y-5 rounded-[28px] bg-white p-5 ring-1 ring-sand sm:p-8">
        <FormErrorSummary errors={summary} />
        <EmailField label="Email address" value={email} error={emailError} />
        <TurnstileWidget action="registrations_find" error={turnstileError} />
        <SubmitButton label="Email me a link" pendingLabel="Sending…" />
      </form>
    </div>
  </section>
</Layout>
