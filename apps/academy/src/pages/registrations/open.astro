---
/**
 * Opens an emailed registration link (`?t=<token>`): consumes one use, starts a 2-hour customer session
 * (HttpOnly cookie) and answers 303 to the token-free manage page, so the token leaves the address bar at
 * once. Every failure shows one message with a way to ask for a new link.
 */
import { getRuntimeEnv, openCustomerLink } from '@gamo/domain';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import RegistrationNotice from '../../components/registration/RegistrationNotice.astro';
import { nowSeconds, registrationDb } from '../../lib/registration';

export const prerender = false;

const env = Astro.locals.runtimeEnv ?? (await getRuntimeEnv(Astro));
let message = 'This link has expired or is no longer valid — request a new one.';
try {
  const token = Astro.url.searchParams.get('t') ?? '';
  if (token) {
    const opened = await openCustomerLink(registrationDb(env), env as never, {
      token,
      now: nowSeconds(),
      https: Astro.url.protocol === 'https:',
    });
    if (opened.ok)
      return new Response(null, {
        status: 303,
        headers: {
          Location: '/registrations/manage',
          'Set-Cookie': opened.cookie,
          'Cache-Control': 'no-store',
        },
      });
    message = opened.message;
  }
} catch (err) {
  console.error(`[academy.registrations.open] ${(err as Error)?.name ?? 'Error'}`);
  Astro.response.status = 503;
  message = 'Registration links are temporarily unavailable. Please try again in a few minutes.';
}
if (Astro.response.status === 200) Astro.response.status = 400;
---

<Layout title="Open your registration" description="Open a Gamo Academy registration link." noindex>
  <meta slot="head" name="referrer" content="no-referrer" />
  <PageHero
    eyebrow="Gamo Academy · Registration"
    title="Open your registration"
    lede="Registration links are personal and expire for your safety."
  />
  <section class="px-4 pb-16 sm:px-8 lg:pb-24">
    <div class="mx-auto max-w-3xl space-y-6">
      <RegistrationNotice tone="problem" title="We couldn't open this link">
        <p>{message}</p>
        <p>
          <a
            href="/registrations/find"
            class="inline-flex min-h-11 items-center font-semibold text-terracotta-deep underline underline-offset-4"
          >
            Email me a new link
          </a>
        </p>
      </RegistrationNotice>
    </div>
  </section>
</Layout>
