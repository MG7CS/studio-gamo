---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <main class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-3xl font-bold mb-8">Instructors</h1>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white border border-[#DED6CC] p-4 rounded-xl text-center">
        <div class="w-24 h-24 bg-gray-200 rounded-full mx-auto mb-4"></div>
        <h3 class="font-bold">John Doe</h3>
        <p class="text-sm text-gray-500 mb-4">Acoustic & Electric Guitar</p>
        <a href="#" class="block bg-[#1D2323] text-white py-2 rounded-lg text-sm font-medium">Book Lesson</a>
      </div>
    </div>
  </main>
</Layout>
