---
import Layout from '../../layouts/Layout.astro';
import GamoAuthExperience from '@studio-gamo/ui/components/auth/GamoAuthExperience.astro';
import { termsConsentDocuments } from '@studio-gamo/ui/lib/terms-links';
import { signupScreenOptions } from '@gamo/domain';

const options = signupScreenOptions('academy');
---

<Layout
  title="Create Your Gamo Academy Account"
  description="Create a verified Gamo Academy account to explore music lessons and family enrollment."
  chrome={false}
>
  <GamoAuthExperience
    mode="signup"
    program="Gamo Academy"
    signupRoles={options.roles}
    selectedRole={Astro.url.searchParams.get('role')}
    termsDocuments={termsConsentDocuments(options.terms)}
  />
</Layout>
