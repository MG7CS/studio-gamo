---
import Layout from '../../layouts/Layout.astro';
import AccountHub from '@studio-gamo/ui/components/account/AccountHub.astro';
import AccountIdentityPanels from '@studio-gamo/ui/components/account/AccountIdentityPanels.astro';
import { siteUrl } from '@studio-gamo/ui/lib/sites';
import { loadAccountExtras } from '@gamo/domain';

const extras = await loadAccountExtras(Astro.locals, Astro.url, (product, path) => siteUrl(product, path));
---

<Layout title="Your Account">
  <AccountHub program="Gamo Academy">
    {extras && <AccountIdentityPanels program="Gamo Academy" extras={extras} />}
  </AccountHub>
</Layout>
