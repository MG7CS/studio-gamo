---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import Panel from '../../components/shared/Panel.astro';
import InstrumentCard from '../../components/shared/InstrumentCard.astro';
import ClosingCta from '../../components/shared/ClosingCta.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { instruments, plannedInstruments } from '../../data/instruments';
---

<Layout
  title="Browse Instruments"
  description="Explore piano, guitar, bass, drums and vocals at Gamo Academy. Each instrument page shows who it suits, what first lessons cover and the lessons available."
>
  <PageHero
    eyebrow="Instruments"
    title="Find the sound"
    accent="that moves you."
    lede="Each instrument page shows who it suits, what first lessons cover and the lessons you can join."
    photo="youngPianist"
    crumbs={[{ label: 'Instruments', href: '/instruments' }]}
  />
  <section class="px-4 pb-16 sm:px-8 lg:pb-24">
    <div class="mx-auto grid max-w-[1320px] gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {instruments.map((i) => (
        <InstrumentCard instrument={i} />
      ))}
    </div>
    <Panel pad="md" class="mx-auto mt-4 max-w-[1320px]">
      <h2 class="academy-title-sub">More to come</h2>
      <p class="mt-2 text-ink-soft">We add these as instructors for them join.</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {plannedInstruments.map((p) => (
          <li class="rounded-full bg-cream px-3.5 py-1.5 text-sm ring-1 ring-sand">{p}</li>
        ))}
      </ul>
    </Panel>
  </section>
  <ClosingCta
    eyebrow="Still deciding?"
    title="Find a lesson"
    accent="that fits."
    body="Browse lessons by instrument, age, level and format."
    photo="guitarMentor"
  >
    <ButtonLink href="/lessons" size="lg" arrow>
      Browse lessons
    </ButtonLink>
  </ClosingCta>
</Layout>
