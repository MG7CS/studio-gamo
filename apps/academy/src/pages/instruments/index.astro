---
import Layout from '../../layouts/Layout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import LinkRows from '@studio-gamo/ui/components/content/LinkRows.astro';
import HeroPhoto from '../../components/shared/HeroPhoto.astro';
import { instruments, plannedInstruments } from '../../data/instruments';
---

<Layout
  title="Browse Instruments"
  description="Explore piano, guitar, bass and drums at Gamo Academy. Each instrument page shows who it suits, what first lessons cover and how to register."
>
  <PageHero breadcrumbs={[{ label: 'Academy', href: '/' }, { label: 'Instruments' }]}>
    <Fragment slot="title">
      Find the Sound <span class="block text-action">That Moves You.</span>
    </Fragment>
    <HeroPhoto slot="media" photo="youngPianist" />
  </PageHero>
  <Section spacing="none" class="pb-16 lg:pb-24">
    <LinkRows
      headingLevel="h2"
      items={instruments.map((i) => ({
        href: `/instruments/${i.slug}`,
        title: i.name,
        meta: i.ages,
        action: { href: `/register/${i.slug}`, label: 'Register' },
      }))}
    />
    <p class="mt-6 text-small text-fg-muted">We plan to add: {plannedInstruments.join(' · ')}</p>
  </Section>
</Layout>
