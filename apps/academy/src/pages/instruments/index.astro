---
import Layout from '../../layouts/Layout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import Badge from '@studio-gamo/ui/components/content/Badge.astro';
import HeroPhoto from '../../components/shared/HeroPhoto.astro';
import InstrumentCard from '../../components/shared/InstrumentCard.astro';
import CtaInvitation from '@studio-gamo/ui/components/CtaInvitation.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { instruments, plannedInstruments } from '../../data/instruments';
---

<Layout
  title="Browse Instruments"
  description="Explore piano, guitar, bass, drums and vocals at Gamo Academy. Each instrument page shows who it suits, what first lessons cover and available lessons."
>
  <PageHero breadcrumbs={[{ label: 'Academy', href: '/' }, { label: 'Instruments' }]}>
    <Fragment slot="title">
      Find the sound <span class="block text-action">that moves you.</span>
    </Fragment>
    <p slot="intro">
      Each instrument page shows who it suits, what first lessons cover and available lessons you can explore.
    </p>
    <HeroPhoto slot="media" photo="youngPianist" />
  </PageHero>
  <Container class="pb-16 lg:pb-24">
    <FeatureGrid as="ul" max={3}>
      {instruments.map((i) => (
        <InstrumentCard instrument={i} headingLevel="h2" />
      ))}
    </FeatureGrid>
    <Card tone="inset" padding="lg" class="mt-10">
      <h2 class="section-subheading">Additional instruments</h2>
      <p class="mt-2 text-fg-muted">
        These instruments are added as specialized instructors join local cohorts.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {plannedInstruments.map((p) => (
          <li>
            <Badge>{p}</Badge>
          </li>
        ))}
      </ul>
    </Card>
  </Container>
  <CtaInvitation
    title="Find a lesson path that fits."
    body="Browse lessons by age, level and format to see how learning looks for you or your family."
    photo="guitarMentor"
  >
    <ButtonLink href="/lessons" size="lg" arrow>
      Browse lessons
    </ButtonLink>
  </CtaInvitation>
</Layout>
