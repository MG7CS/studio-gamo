---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import InstrumentOverview from '../../components/instruments/InstrumentOverview.astro';
import SectionIntro from '../../components/shared/SectionIntro.astro';
import Actions from '../../components/shared/Actions.astro';
import LessonCard from '../../components/shared/LessonCard.astro';
import InstructorCard from '../../components/shared/InstructorCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import { instruments, type Instrument } from '../../data/instruments';
import { lessons } from '../../data/lessons';
import { instructors } from '../../data/instructors';

// Rendered on demand (not prerendered) so the page gets the same security and cache headers
// as every other HTML response; unknown slugs render the branded 404 page.
const found = instruments.find((item) => item.slug === Astro.params.slug);
if (!found) return Astro.rewrite('/404');
const instrument: Instrument = found;
const related = lessons.filter((l) => l.instrumentSlug === instrument.slug);
const teachers = instructors.filter((t) => t.instrumentSlugs.includes(instrument.slug));
const short = instrument.short.toLowerCase();
---

<Layout
  title={instrument.name}
  description={`${instrument.name} lessons at Gamo Academy. ${instrument.blurb} ${instrument.ages}.`}
>
  <PageHero
    eyebrow={instrument.ages}
    title={instrument.name}
    lede={instrument.blurb}
    photo={instrument.photo}
    crumbs={[
      { label: 'Instruments', href: '/instruments' },
      { label: instrument.short, href: `/instruments/${instrument.slug}` },
    ]}
  >
    <Actions class="mt-6">
      <ButtonLink href="/lessons" size="lg" arrow>
        Find {short} lessons
      </ButtonLink>
      <ButtonLink href="/instruments" size="lg" variant="secondary">
        All instruments
      </ButtonLink>
    </Actions>
  </PageHero>
  <InstrumentOverview instrument={instrument} />
  {related.length > 0 && (
    <section class="px-4 pb-16 sm:px-8 lg:pb-20">
      <div class="mx-auto max-w-[1320px]">
        <SectionIntro eyebrow="Lessons" title={`Ways to learn ${short}`} size="sub" />
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {related.map((l) => (
            <LessonCard lesson={l} />
          ))}
        </div>
      </div>
    </section>
  )}
  {teachers.length > 0 && (
    <section class="px-4 pb-16 sm:px-8 lg:pb-24">
      <div class="mx-auto max-w-[1320px]">
        <SectionIntro eyebrow="Instructors" title={`Who teaches ${short}`} size="sub" />
        <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {teachers.map((t) => (
            <InstructorCard instructor={t} />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
