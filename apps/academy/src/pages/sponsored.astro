---
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/shared/PageHero.astro';
import FaqAccordion from '@studio-gamo/ui/components/FaqAccordion.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
const principles = [
  ['heart', 'Need first', 'Support would be guided by family need, never by ability to pay.'],
  ['shield', 'Dignity & privacy', 'Family financial information would be handled privately and minimally.'],
  [
    'users',
    'Fair to instructors',
    'Instructors would be paid fully for sponsored lessons, shown as a separate line item.',
  ],
  ['book', 'Open to all', 'Not limited to church members, worship teams or any background.'],
] as const;
const qa = [
  {
    q: 'How do families request tuition support?',
    a: 'Families can note scholarship or sponsored cohort interest when registering, and our team reviews requests confidentially based on family need.',
  },
  {
    q: 'How can a church or supporter underwrite a cohort?',
    a: 'Churches and community partners can inquire about hosting or underwriting a learning cohort.',
  },
  {
    q: 'Do sponsored students have different instructors?',
    a: 'No. Sponsored students learn with the same instructors and curriculum as every other student.',
  },
];
---

<Layout
  title="Sponsored & scholarship programs"
  description="Gamo Academy coordinates sponsored and scholarship-supported lessons with community partners, guided by family need and never by ability to pay."
>
  <PageHero
    eyebrow="Sponsored programs"
    title="Music for every family,"
    accent="whatever the budget."
    lede="Gamo Academy coordinates sponsored and scholarship-supported lessons alongside community partners so cost never stands in the way of learning."
    photo="boyGuitar"
    mask="mask-arch"
    crumbs={[{ label: 'Sponsored programs', href: '/sponsored' }]}
  >
    <div class="mt-6">
      <StatusPill kind="proposal">Sponsored &amp; scholarship pathways</StatusPill>
    </div>
  </PageHero>
  <section class="bg-ivory px-4 py-16 sm:px-8 lg:py-24">
    <div class="mx-auto max-w-[1320px]">
      <EditorialHeading eyebrow="Guiding principles" title="How support is" accent="meant to work." />
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {principles.map(([icon, t, d], i) => (
          <li
            class:list={[
              'flex gap-5 rounded-[28px] bg-white p-7 ring-1 ring-sand',
              i % 2 && 'sm:translate-y-6',
            ]}
          >
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-cream text-terracotta">
              <Icon name={icon} class="h-6 w-6" />
            </span>
            <div>
              <h3 class="text-xl font-bold">{t}</h3>
              <p class="mt-1 text-ink-soft">{d}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="px-4 py-16 sm:px-8 lg:py-24">
    <div class="mx-auto grid max-w-[1320px] gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <EditorialHeading eyebrow="Questions" title="How sponsored learning works" />
        <div class="mt-6 flex flex-wrap gap-3">
          <ButtonLink href={inquiryUrl('Church-hosted lessons')} variant="secondary" arrow>
            Apply to host lessons
          </ButtonLink>
        </div>
      </div>
      <FaqAccordion items={qa} />
    </div>
  </section>
</Layout>
