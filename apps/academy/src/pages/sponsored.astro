---
import { providerSignupUrl } from '@studio-gamo/ui/lib/sites';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/shared/PageHero.astro';
import Panel from '../components/shared/Panel.astro';
import SectionIntro from '../components/shared/SectionIntro.astro';
import PointList, { type Point } from '../components/shared/PointList.astro';
import Actions from '../components/shared/Actions.astro';
import FaqAccordion from '@gamo/site/components/FaqAccordion.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
const principles: Point[] = [
  { icon: 'heart', title: 'Need first', body: 'Support follows family need, never ability to pay.' },
  {
    icon: 'shield',
    title: 'Privacy',
    body: 'Family financial details are handled privately and kept minimal.',
  },
  {
    icon: 'users',
    title: 'Fair to instructors',
    body: 'Instructors are paid in full for sponsored lessons, shown as a separate line item.',
  },
  {
    icon: 'book',
    title: 'Open to all',
    body: 'Not limited to church members, worship teams or any background.',
  },
];
const qa = [
  {
    q: 'How does a family ask for support?',
    a: 'Mention it when you write to us about a lesson. Our team reviews each request privately, based on family need.',
  },
  {
    q: 'How can a church or organization sponsor a class?',
    a: 'Any church or organization can sponsor a class or a cohort. Write to us and we will talk it through on a call.',
  },
  {
    q: 'Do sponsored students get different instructors?',
    a: 'No. Sponsored students learn with the same instructors and curriculum as everyone else.',
  },
];
---

<Layout
  title="Sponsored Classes"
  description="Churches and other organizations can sponsor Gamo Academy classes. Fully sponsored classes are free to the learner, and support follows family need, never ability to pay."
>
  <PageHero
    eyebrow="Sponsored classes"
    title="Music for every family,"
    accent="whatever the budget."
    lede="Churches and other organizations can sponsor classes. Fully sponsored classes are free to the learner."
    photo="boyGuitar"
    crumbs={[{ label: 'Sponsored classes', href: '/sponsored' }]}
  >
    <div class="mt-5">
      <StatusPill kind="proposal">Proposal</StatusPill>
    </div>
  </PageHero>
  <section class="px-4 section-space sm:px-8">
    <Panel class="mx-auto max-w-[1320px]">
      <SectionIntro eyebrow="Principles" title="How support" accent="is meant to work." />
      <PointList points={principles} columns={2} class="mt-8 [&>li]:bg-ivory" />
    </Panel>
  </section>
  <section class="px-4 pb-16 sm:px-8 lg:pb-24">
    <Panel class="mx-auto max-w-[1320px]">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12">
        <div>
          <SectionIntro eyebrow="Questions" title="Sponsored learning" accent="in practice." />
          <Actions class="mt-6">
            <ButtonLink href={providerSignupUrl('academy', 'church')} variant="secondary" arrow>
              Apply to host lessons
            </ButtonLink>
          </Actions>
        </div>
        <FaqAccordion items={qa} />
      </div>
    </Panel>
  </section>
</Layout>
