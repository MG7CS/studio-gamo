---
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import Layout from '../layouts/Layout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Section from '@studio-gamo/ui/components/layout/Section.astro';
import HeroPhoto from '../components/shared/HeroPhoto.astro';
import FaqAccordion from '@studio-gamo/ui/components/FaqAccordion.astro';
import EditorialHeading from '@studio-gamo/ui/components/EditorialHeading.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
const principles = [
  ['Need First', 'Support would be guided by family need, never by ability to pay.'],
  ['Dignity & Privacy', 'Family financial information would be handled privately and minimally.'],
  [
    'Fair to Instructors',
    'Instructors would be paid fully for sponsored lessons, shown as a separate line item.',
  ],
  ['Open to All', 'Not limited to church members, worship teams or any background.'],
] as const;
const qa = [
  {
    q: 'How do families request tuition support?',
    a: 'Families can note scholarship or sponsored cohort interest when registering, and our team reviews requests confidentially based on family need.',
  },
  {
    q: 'How can a church or supporter underwrite a cohort?',
    a: 'Churches and community partners can inquire about hosting or underwriting a learning cohort.',
  },
  {
    q: 'Do sponsored students have different instructors?',
    a: 'No. Sponsored students learn with the same instructors and curriculum as every other student.',
  },
];
---

<Layout
  title="Sponsored & Scholarship Programs"
  description="Gamo Academy is preparing sponsored and scholarship-supported lessons with churches and community supporters, guided by family need and never by ability to pay."
>
  <div data-heading-case="as-written">
    <PageHero
      mediaFirstStacked
      breadcrumbs={[{ label: 'Academy', href: '/' }, { label: 'Sponsored programs' }]}
    >
      <Fragment slot="title">
        Music for Every Family, <span class="block text-action">Whatever the Budget.</span>
      </Fragment>
      <HeroPhoto slot="media" photo="boyGuitar" />
    </PageHero>
    <Section tone="raised">
      <Fragment slot="title">
        How Support is <span class="block text-action">Meant to Work.</span>
      </Fragment>
      <ul class="grid gap-x-12 border-b border-border md:grid-cols-2">
        {principles.map(([t, d]) => (
          <li class="border-t border-border py-6">
            <h3 class="text-xl font-semibold tracking-tight">{t}</h3>
            <p class="mt-1 text-fg-muted">{d}</p>
          </li>
        ))}
      </ul>
    </Section>
    <Section>
      <div class="grid gap-10 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <EditorialHeading title="How Sponsored Learning Works" />
          <div class="mt-6 flex flex-wrap gap-3">
            <ButtonLink href={inquiryUrl('Church-hosted lessons')} variant="secondary" arrow>
              Apply to host lessons
            </ButtonLink>
          </div>
        </div>
        <FaqAccordion items={qa} class="lg:col-span-3" />
      </div>
    </Section>
  </div>
</Layout>
