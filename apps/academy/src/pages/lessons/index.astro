---
import Layout from '../../layouts/Layout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import FeatureGrid from '@studio-gamo/ui/components/content/FeatureGrid.astro';
import LessonFilters from '../../components/lessons/LessonFilters.astro';
import LessonCard from '../../components/shared/LessonCard.astro';
import { lessons } from '../../data/lessons';
import { lessonFiltersFromUrl, lessonMatches } from '../../lib/lesson-filters';

const filters = lessonFiltersFromUrl(Astro.url.searchParams);
const shown = lessons.filter((l) => lessonMatches(l, filters)).length;
---

<Layout
  title="Discover Lessons"
  description="Browse Gamo Academy lessons and filter by instrument, age, level and format to find music lessons that fit your family's week."
>
  <PageHero eyebrow="Lesson discovery" breadcrumbs={[{ label: 'Academy', href: '/' }, { label: 'Lessons' }]}>
    <Fragment slot="title">
      Find a lesson <span class="block text-action">that fits your week.</span>
    </Fragment>
    <p slot="intro">Filter lessons by instrument, age, level and format.</p>
  </PageHero>
  <Container class="pb-16 lg:pb-24">
    <LessonFilters values={filters} shown={shown} />
    <FeatureGrid as="ul" max={3} class="mt-8">
      {lessons.map((l) => (
        <LessonCard lesson={l} headingLevel="h2" hidden={!lessonMatches(l, filters)} />
      ))}
    </FeatureGrid>
  </Container>
</Layout>
