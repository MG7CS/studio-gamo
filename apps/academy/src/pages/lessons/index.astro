---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import LessonFilters from '../../components/lessons/LessonFilters.astro';
import LessonCard from '../../components/shared/LessonCard.astro';
import DemoNotice from '@studio-gamo/ui/components/DemoNotice.astro';
import { lessons } from '../../data/lessons';
---
<Layout title="Discover lessons" description="Browse sample Gamo Academy lessons by instrument, age, level and format.">
  <PageHero eyebrow="Lesson discovery" title="Find a lesson" accent="that fits your week." lede="Filter sample lessons by instrument, age, level and format. Listings and tuition shown are proposals for design review." crumbs={[{ label: 'Lessons', href: '/lessons' }]}>
    <DemoNotice class="mt-6 max-w-2xl">All lessons, instructors and tuition amounts are samples. Nothing can be booked or paid yet.</DemoNotice>
  </PageHero>
  <section class="px-4 pb-16 sm:px-8 lg:pb-24">
    <div class="mx-auto max-w-[1320px]">
      <LessonFilters />
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {lessons.map((l) => <LessonCard lesson={l} />)}
      </div>
    </div>
  </section>
</Layout>
