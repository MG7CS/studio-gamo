---
import TitleCase from '@studio-gamo/ui/components/TitleCase.astro';
import { clampDescription } from '@studio-gamo/ui/lib/seo';
import Layout from '../../layouts/Layout.astro';
import PageHero from '@studio-gamo/ui/components/content/PageHero.astro';
import Container from '@studio-gamo/ui/components/layout/Container.astro';
import Card from '@studio-gamo/ui/components/content/Card.astro';
import HeroPhoto from '../../components/shared/HeroPhoto.astro';
import InstructorCard from '../../components/shared/InstructorCard.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { lessons, type Lesson } from '../../data/lessons';
import { instructorBySlug } from '../../data/instructors';
import { instrumentBySlug } from '../../data/instruments';

// Rendered on demand (not prerendered) so the page gets the same security and cache headers
// as every other HTML response; unknown slugs render the branded 404 page.
const found = lessons.find((item) => item.slug === Astro.params.slug);
if (!found) return Astro.rewrite('/404');
const l: Lesson = found;
const t = instructorBySlug(l.instructorSlug)!;
const inst = instrumentBySlug(l.instrumentSlug);
const facts = [
  ['calendar', 'Schedule', l.schedule],
  ['clock', 'Length', l.length],
  ['pin', 'Location', l.location],
  ['users', 'Ages', l.ages.join(', ')],
] as const;
---

<Layout
  title={l.title}
  description={clampDescription(`${l.title} (${l.format}, ${l.schedule}): ${l.summary}`)}
>
  <PageHero
    title={l.title}
    breadcrumbs={[
      { label: 'Academy', href: '/' },
      { label: 'Lessons', href: '/lessons' },
      { label: l.title },
    ]}
  >
    <Fragment slot="intro">
      <p>{l.summary}</p>
    </Fragment>
    <HeroPhoto slot="media" photo={inst?.photo ?? 'guitarMentor'} />
  </PageHero>
  <Container class="pb-16 lg:pb-24">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="space-y-8 lg:col-span-2">
        <dl class="grid gap-3 sm:grid-cols-2">
          {facts.map(([icon, k, v]) => (
            <Card padding="sm">
              <dt class="flex items-center gap-2 text-caption text-fg-muted">
                <Icon name={icon} class="size-5 text-action-strong" />
                {k}
              </dt>
              <dd class="mt-1 font-semibold">{v}</dd>
            </Card>
          ))}
        </dl>
        <Card tone="inset" padding="lg">
          <h2 class="section-subheading">
            <TitleCase>What Students Will Learn</TitleCase>
          </h2>
          <ul class="mt-5 space-y-3">
            {l.outcomes.map((o) => (
              <li class="flex items-center gap-3">
                <Icon name="check" class="size-5 text-action-strong" />
                {o}
              </li>
            ))}
          </ul>
        </Card>
        <div>
          <h2 class="mb-4 text-xl font-bold">Your Instructor</h2>
          <div class="max-w-sm">
            <InstructorCard instructor={t} />
          </div>
        </div>
      </div>
      <Card as="aside" padding="lg" class="shadow-float lg:sticky lg:top-32 lg:self-start">
        <h2 class="text-xl font-bold">Tuition</h2>
        <p class="mt-2 text-small text-fg-muted">
          Tuition is shown before enrollment is confirmed, with instructor compensation and any administrative
          allocation on separate lines.
        </p>
        <ButtonLink href={`/register/${l.slug}`} class="mt-6 w-full justify-center" arrow>
          Register for this lesson
        </ButtonLink>
        <p class="mt-3 text-small text-fg-muted">No account needed. Reserving a spot is free.</p>
        {l.sample && (
          <p class="mt-3 text-small font-semibold text-action-strong">
            This lesson is an example of what we plan to offer.
          </p>
        )}
      </Card>
    </div>
  </Container>
</Layout>
