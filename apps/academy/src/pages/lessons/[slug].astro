---
import { clampDescription } from '@studio-gamo/ui/lib/seo';
import { inquiryUrl } from '@studio-gamo/ui/lib/sites';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import Panel from '../../components/shared/Panel.astro';
import InstructorCard from '../../components/shared/InstructorCard.astro';
import StatusPill from '@studio-gamo/ui/components/StatusPill.astro';
import ButtonLink from '@studio-gamo/ui/components/ButtonLink.astro';
import Icon from '@studio-gamo/ui/components/Icon.astro';
import { lessons, formatTuition, type Lesson } from '../../data/lessons';
import { instructorBySlug } from '../../data/instructors';
import { instrumentBySlug } from '../../data/instruments';

// Rendered on demand (not prerendered) so the page gets the same security and cache headers
// as every other HTML response; unknown slugs render the branded 404 page.
const found = lessons.find((item) => item.slug === Astro.params.slug);
if (!found) return Astro.rewrite('/404');
const l: Lesson = found;
const t = instructorBySlug(l.instructorSlug);
const inst = instrumentBySlug(l.instrumentSlug);
const facts = [
  ['calendar', 'Schedule', l.schedule],
  ['clock', 'Length', l.length],
  ['pin', 'Location', l.location],
  ['users', 'Ages', l.ages.join(', ')],
] as const;
---

<Layout
  title={l.title}
  description={clampDescription(`${l.title} (${l.format}, ${l.schedule}): ${l.summary}`)}
>
  <PageHero
    eyebrow={`${l.instrument} · ${l.level} · ${l.format}`}
    title={l.title}
    lede={l.summary}
    photo={inst?.photo ?? 'guitarMentor'}
    crumbs={[
      { label: 'Lessons', href: '/lessons' },
      { label: l.title, href: `/lessons/${l.slug}` },
    ]}
  >
    <div class="mt-5">
      <StatusPill kind="sample">Sample lesson</StatusPill>
    </div>
  </PageHero>
  <section class="px-4 pb-16 sm:px-8 lg:pb-24">
    <div class="mx-auto grid max-w-[1320px] gap-4 lg:grid-cols-[1.3fr_0.7fr]">
      <div class="grid gap-4">
        <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          {facts.map(([icon, k, v]) => (
            <div class="rounded-2xl bg-white p-4 ring-1 ring-sand">
              <dt class="flex items-center gap-1.5 text-xs text-ink-soft">
                <Icon name={icon} class="h-4 w-4 text-terracotta" />
                {k}
              </dt>
              <dd class="mt-1 text-sm font-semibold sm:text-base">{v}</dd>
            </div>
          ))}
        </dl>
        <Panel>
          <h2 class="academy-title-sub">What you will learn</h2>
          <ul class="mt-4 space-y-2.5">
            {l.outcomes.map((o) => (
              <li class="flex items-start gap-3">
                <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-terracotta" />
                {o}
              </li>
            ))}
          </ul>
        </Panel>
        {t && (
          <div>
            <h2 class="academy-title-sub mb-4">Your instructor</h2>
            <div class="max-w-sm">
              <InstructorCard instructor={t} />
            </div>
          </div>
        )}
      </div>
      <Panel as="aside" pad="md" class="shadow-float lg:sticky lg:top-32 lg:self-start">
        <p class="text-sm text-ink-soft">Proposed tuition</p>
        <p class="mt-1 text-2xl font-bold">{formatTuition(l.proposedTuitionCents)}</p>
        <p class="mt-2 text-sm text-ink-soft">
          Instructor pay and any Gamo allocation are shown as separate lines before you enroll.
        </p>
        <ButtonLink href={inquiryUrl('Lesson interest')} class="mt-5 w-full" arrow>
          Ask about this lesson
        </ButtonLink>
        <p class="mt-3 text-sm text-ink-soft">
          Lesson sign-up is being rebuilt. Write to us and we reply by email.
        </p>
      </Panel>
    </div>
  </section>
</Layout>
