# Gamo Academy (apps/academy) — Application Local Environment Template (.env.example)
# Copy to apps/academy/.env (or apps/academy/.dev.vars) after provisioning Gamo Academy's dedicated Clerk application.
# NEVER reuse Gamo Live (app_3KlWyOBL2xL2YzhJuvgk8QdrWIt) credentials here.

# Standard Clerk SDK variable names (automatically mapped to *_ACADEMY by @gamo/config/env-loader)
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_ACADEMY_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_ACADEMY_SECRET"

# Product-scoped Clerk metadata & optional explicit suffixed overrides
PUBLIC_CLERK_KEYLESS_DISABLED="true"
CLERK_KEYLESS_DISABLED="true"
CLERK_APP_ID_ACADEMY="pending_clerk_app_gamo_academy"
PUBLIC_CLERK_PUBLISHABLE_KEY_ACADEMY="pk_test_YOUR_ACADEMY_KEY"
CLERK_SECRET_KEY_ACADEMY="sk_test_YOUR_ACADEMY_SECRET"
CLERK_JWT_KEY_ACADEMY=""
CLERK_ISSUER_ACADEMY=""
CLERK_AUTHORIZED_PARTIES_ACADEMY="http://127.0.0.1:4323,http://localhost:4323,https://academy.gamostudio.org"
