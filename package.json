{
  "name": "studio-gamo",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --filter apps-web dev",
    "dev:all": "pnpm --parallel --filter \"./apps/**\" run dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 WRANGLER_LOG_PATH=/tmp/wrangler-logs XDG_CONFIG_HOME=/tmp/xdg-config pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm typecheck:apps && pnpm typecheck:packages",
    "typecheck:apps": "ASTRO_TELEMETRY_DISABLED=1 pnpm --filter \"./apps/**\" --workspace-concurrency=1 exec astro check --minimumFailingSeverity warning",
    "typecheck:packages": "for p in api-contracts auth config db domain integrations; do tsc --noEmit -p packages/$p || exit 1; done && tsc --noEmit -p scripts",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test 'packages/**/*.test.ts' 'scripts/**/*.test.ts' scripts/image-policy.test.mjs",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm api:check && pnpm build",
    "test:web": "node scripts/verify-public-ui.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:report": "node scripts/optimize-images.mjs --report",
    "api:lint": "redocly lint openapi/root.yaml",
    "api:bundle": "node scripts/api/generate.mjs",
    "api:types": "node scripts/api/generate.mjs",
    "api:docs": "node scripts/api/docs.mjs",
    "api:check": "pnpm api:lint && node scripts/api/generate.mjs --check && node scripts/api/check.mjs && pnpm api:test",
    "api:test": "tsx --test scripts/api/contract.test.ts",
    "api:compatibility": "node scripts/api/compatibility.mjs",
    "live:publisher:provision": "tsx scripts/live/editorial-cli.ts provision",
    "live:events:import": "tsx scripts/live/editorial-cli.ts import",
    "live:events:publish": "tsx scripts/live/editorial-cli.ts publish"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.5",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@redocly/cli": "^2.62.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "knip": "6.41.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "wrangler": "^4.149.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.28.5"
  }
}
